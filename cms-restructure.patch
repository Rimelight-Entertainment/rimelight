+          <Field label="Plural name"><input class={inputClass} value={resolveLabel(def().labelPlural)} onInput={(e) => patch({ labelPlural: e.currentTarget.value })} /></Field>
+          <Field label="Slug" hint="Stored on every entry; changing it later orphans existing entries.">
