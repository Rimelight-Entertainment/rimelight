@@ -0,0 +1,82 @@
+import { For, Show, type Component } from "solid-js";
+import { resolveLabel } from "../../core/collections/define";
+import { useDashboard } from "../context";
+import { Button, PageHeader, StatusBadge, relativeTime, useLoader, Loading } from "../ui";
+
+export const Overview: Component = () => {
+  const { api, collections, href, user } = useDashboard();
+  const stats = useLoader(() => api.stats());
+  const recent = useLoader(() => api.entries.list({ orderBy: "updated", limit: 12 }));
+
+  const count = (slug: string) => {
+    const s = stats.data()?.byCollection[slug] ?? {};
+    return Object.values(s).reduce((a, b) => a + b, 0);
+  };
+
+  return (
+    <div>
+      <PageHeader title={`Welcome${user()?.name ? `, ${user()!.name}` : ""}`} description="Everything in your site, in one place." />
+      <div class="flex flex-col gap-8 p-6">
+        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
+          <Stat label="Entries" value={stats.data()?.totalEntries} icon="i-lucide-files" />
+          <Stat label="Awaiting review" value={stats.data()?.pendingReviews} icon="i-lucide-check-check" href={href("/reviews")} />
+          <Stat label="Scheduled" value={stats.data()?.scheduled} icon="i-lucide-calendar-clock" />
+          <Stat label="Collections" value={collections().length} icon="i-lucide-database" href={href("/schemas")} />
+        </div>
+
+        <section>
+          <h2 class="mb-3 text-sm font-semibold text-highlighted">Collections</h2>
+          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
+            <For each={collections()}>
+              {(c) => (
+                <a href={href(`/c/${c.slug}`)} class="group flex items-start gap-3 rounded-xl border border-default p-4 transition-colors hover:border-primary-500/50 hover:bg-elevated">
+                  <span class={`${c.icon ?? "i-lucide-box"} mt-0.5 size-5 text-primary-500`} />
+                  <div class="min-w-0 flex-1">
+                    <div class="flex items-center justify-between">
+                      <span class="font-medium text-highlighted">{resolveLabel(c.labelPlural ?? c.label)}</span>
+                      <span class="text-xs text-muted">{count(c.slug)}</span>
+                    </div>
+                    <Show when={c.description}>
+                      <p class="mt-1 line-clamp-2 text-xs text-muted">{resolveLabel(c.description)}</p>
+                    </Show>
+                  </div>
+                </a>
+              )}
+            </For>
+          </div>
+        </section>
+
+        <section>
+          <h2 class="mb-3 text-sm font-semibold text-highlighted">Recently edited</h2>
+          <Loading when={recent.loading() && !recent.data()}>
+            <div class="divide-y divide-default overflow-hidden rounded-xl border border-default">
+              <For each={recent.data()?.entries ?? []}>
+                {(e) => (
+                  <a href={href(`/e/${e.id}`)} class="flex items-center gap-3 px-4 py-2.5 hover:bg-elevated">
+                    <span class="min-w-0 flex-1 truncate text-sm text-highlighted">{e.excerptTitle}</span>
+                    <span class="hidden text-xs text-muted sm:inline">{e.collection}</span>
+                    <StatusBadge status={e.status} changed={e.hasUnpublishedChanges} />
+                    <span class="w-20 text-right text-xs text-muted">{relativeTime(e.updatedAt ?? e.createdAt)}</span>
+                  </a>
+                )}
+              </For>
+            </div>
+          </Loading>
+        </section>
+        <Show when={!collections().length}>
+          <Button href={href("/schemas")} icon="i-lucide-plus" variant="primary">Create a collection</Button>
+        </Show>
+      </div>
+    </div>
+  );
+};
+
+const Stat: Component<{ label: string; value: number | undefined; icon: string; href?: string }> = (props) => (
+  <a href={props.href} class={`flex flex-col gap-2 rounded-xl border border-default p-4 ${props.href ? "hover:bg-elevated" : "pointer-events-none"}`}>
+    <span class="flex items-center justify-between text-xs font-medium text-muted">
+      {props.label}
+      <span class={`${props.icon} size-4`} />
+    </span>
+    <span class="text-2xl font-semibold text-highlighted">{props.value ?? "–"}</span>
+  </a>
+);
diff --git a/packages/cms/src/dashboard/views/Reviews.tsx b/packages/cms/src/dashboard/views/Reviews.tsx
new file mode 100644
index 0000000..e4b9f05
--- /dev/null
+++ b/packages/cms/src/dashboard/views/Reviews.tsx
@@ -0,0 +1,94 @@
+import { For, Show, createSignal, type Component } from "solid-js";
+import { resolveLabel } from "../../core/collections/define";
+import { useDashboard } from "../context";
+import { Button, Empty, Loading, Modal, PageHeader, StatusBadge, relativeTime, useLoader } from "../ui";
+
+/** The review queue: pending/approved versions with approve, reject, diff and publish. */
+export const Reviews: Component = () => {
+  const { api, href, toast } = useDashboard();
+  const queue = useLoader(() => api.versions.reviews());
+  const [diff, setDiff] = createSignal<any>(null);
+  const [comments, setComments] = createSignal<{ versionId: string; list: any[] } | null>(null);
+  const [draft, setDraft] = createSignal("");
+
+  const act = async (fn: () => Promise<unknown>, msg: string) => {
+    try {
+      await fn();
+      toast(msg, "success");
+      void queue.reload();
+    } catch (err) {
+      toast((err as Error).message, "error");
+    }
+  };
+
+  return (
+    <div>
+      <PageHeader icon="i-lucide-check-check" title="Reviews" description="Changes waiting for approval before they can be published." />
+      <div class="p-6">
+        <Loading when={queue.loading() && !queue.data()}>
+          <Show when={queue.data()?.versions.length} fallback={<Empty icon="i-lucide-check-circle" title="All caught up" description="Nothing is waiting for review." />}>
+            <div class="flex flex-col gap-3">
+              <For each={queue.data()!.versions}>
+                {(v) => (
+                  <div class="flex flex-wrap items-center gap-3 rounded-xl border border-default p-4">
+                    <div class="min-w-0 flex-1">
+                      <a href={href(`/e/${v.pageId}`)} class="font-medium text-highlighted hover:underline">{resolveLabel(v.title) || v.slug}</a>
+                      <div class="text-xs text-muted">
+                        v{v.versionNumber} · {v.type} · by {v.createdBy} · {relativeTime(v.createdAt)} · {v.approvedBy.length} approval(s)
+                      </div>
+                      <Show when={v.changeSummary}><p class="mt-1 text-sm text-toned">{v.changeSummary}</p></Show>
+                    </div>
+                    <StatusBadge status={v.status} />
+                    <Button variant="ghost" icon="i-lucide-git-compare" onClick={async () => setDiff((await api.entries.diff(v.pageId, undefined, String(v.versionNumber))).diff)}>Diff</Button>
+                    <Button variant="ghost" icon="i-lucide-message-square" onClick={async () => setComments({ versionId: v.id, list: (await api.versions.comments(v.id)).comments })}>Comments</Button>
+                    <Show when={v.status === "pending"}>
+                      <Button variant="ghost" onClick={() => void act(() => api.versions.reject(v.id, prompt("Reason (optional)") ?? undefined), "Rejected")}>Reject</Button>
+                      <Button variant="primary" icon="i-lucide-check" onClick={() => void act(() => api.versions.approve(v.id), "Approved")}>Approve</Button>
+                    </Show>
+                    <Show when={v.status === "approved"}>
+                      <Button variant="primary" icon="i-lucide-upload" onClick={() => void act(() => api.entries.publish(v.pageId, { versionId: v.id }), "Published")}>Publish</Button>
+                    </Show>
+                  </div>
+                )}
+              </For>
+            </div>
+          </Show>
+        </Loading>
+      </div>
+      <Modal open={!!diff()} title="Changes vs. live" onClose={() => setDiff(null)} wide>
+        <Show when={diff()}>
+          <For each={diff().blocks.filter((b: any) => b.status !== "unchanged")} fallback={<p class="text-sm text-muted">No block changes.</p>}>
+            {(b: any) => <div class="text-xs"><b class="capitalize">{b.status}</b> {b.type}</div>}
+          </For>
+        </Show>
+      </Modal>
+      <Modal
+        open={!!comments()}
+        title="Comments"
+        onClose={() => setComments(null)}
+        footer={
+          <div class="flex w-full gap-2">
+            <input class="flex-1 rounded-md border border-default bg-default px-2 py-1 text-sm" value={draft()} onInput={(e) => setDraft(e.currentTarget.value)} placeholder="Write a comment…" />
+            <Button variant="primary" disabled={!draft().trim()} onClick={async () => {
+              const id = comments()!.versionId;
+              await api.versions.comment(id, draft());
+              setDraft("");
+              setComments({ versionId: id, list: (await api.versions.comments(id)).comments });
+            }}>Send</Button>
+          </div>
+        }
+      >
+        <div class="flex flex-col gap-2">
+          <For each={comments()?.list ?? []} fallback={<p class="text-sm text-muted">No comments yet.</p>}>
+            {(c) => (
+              <div class="rounded-lg bg-elevated px-3 py-2 text-sm">
+                <div class="text-xs text-muted">{c.userId} · {relativeTime(c.createdAt)}</div>
+                {c.content}
+              </div>
+            )}
+          </For>
+        </div>
+      </Modal>
+    </div>
+  );
+};
diff --git a/packages/cms/src/dashboard/views/Schemas.tsx b/packages/cms/src/dashboard/views/Schemas.tsx
new file mode 100644
index 0000000..6448f89
--- /dev/null
+++ b/packages/cms/src/dashboard/views/Schemas.tsx
@@ -0,0 +1,258 @@
+import { For, Show, createSignal, type Component } from "solid-js";
+import { resolveLabel } from "../../core/collections/define";
+import type { FieldDefinition, FieldType, ResolvedCollection } from "../../core/collections/types";
+import { useDashboard } from "../context";
+import { inputClass } from "../fields/FieldInput";
+import { Button, Field, Loading, PageHeader, useLoader } from "../ui";
+
+const FIELD_TYPES: FieldType[] = [
+  "text", "textarea", "richtext", "slug", "url", "email", "number", "boolean", "date", "datetime",
+  "select", "multiselect", "tags", "color", "media", "reference", "references", "currency", "json",
+];
+
+const FEATURES: [keyof ResolvedCollection["features"], string, string][] = [
+  ["blocks", "Block editor", "Entries have a Notion-style body. Off = fields only (like a database row)."],
+  ["versioned", "Versions", "Publishing keeps an immutable history."],
+  ["hierarchical", "Nested slugs", "Allow slugs like guides/setup (docs, wikis)."],
+  ["scheduled", "Scheduling", "Publish at a future date."],
+  ["bylines", "Bylines", "Credit authors and contributors."],
+  ["search", "Search", "Index published entries for site search."],
+];
+
+/** Collections list + schema builder (fields, features, workflow). */
+export const Schemas: Component<{ slug?: string }> = (props) => {
+  const { collections, href } = useDashboard();
+  return (
+    <Show when={!props.slug} fallback={<SchemaEditor slug={props.slug!} />}>
+      <div>
+        <PageHeader
+          icon="i-lucide-database"
+          title="Collections"
+          description="Content models. Built-in and cms.config.ts collections can be overridden here; new ones are stored in the database."
+          actions={<Button variant="primary" icon="i-lucide-plus" href={href("/schemas/new")}>New collection</Button>}
+        />
+        <div class="grid grid-cols-1 gap-3 p-6 md:grid-cols-2">
+          <For each={collections()}>
+            {(c) => (
+              <a href={href(`/schemas/${c.slug}`)} class="flex items-start gap-3 rounded-xl border border-default p-4 hover:bg-elevated">
+                <span class={`${c.icon ?? "i-lucide-box"} mt-0.5 size-5 text-primary-500`} />
+                <div class="min-w-0 flex-1">
+                  <div class="flex items-center gap-2">
+                    <span class="font-medium text-highlighted">{resolveLabel(c.label)}</span>
+                    <span class="font-mono text-[11px] text-muted">{c.slug}</span>
+                    <span class="ml-auto rounded bg-elevated px-1.5 py-0.5 text-[10px] uppercase text-muted">{c.source}</span>
+                  </div>
+                  <div class="mt-1 text-xs text-muted">
+                    {Object.keys(c.fields).length} fields · {c.kind}
+                    {c.features.ecommerce ? " · commerce" : ""}
+                    {c.workflow.minApprovals ? ` · ${c.workflow.minApprovals} approval(s)` : ""}
+                  </div>
+                </div>
+              </a>
+            )}
+          </For>
+        </div>
+      </div>
+    </Show>
+  );
+};
+
+interface FieldRow extends FieldDefinition {
+  key: string;
+}
+
+const SchemaEditor: Component<{ slug: string }> = (props) => {
+  const { api, href, navigate, reloadCollections, toast } = useDashboard();
+  const isNew = props.slug === "new";
+  const loaded = useLoader(async () =>
+    isNew
+      ? ({ slug: "", label: "", icon: "i-lucide-box", kind: "document", features: { blocks: true, versioned: true, scheduled: true, search: true, routable: true }, workflow: { minApprovals: 0, allowSelfApproval: true }, fields: {}, groups: {}, source: "database" } as unknown as ResolvedCollection)
+      : (await api.collections.get(props.slug)).collection,
+  );
+  return (
+    <Loading when={!loaded.data()}>
+      <SchemaForm
+        initial={loaded.data()!}
+        isNew={isNew}
+        onSaved={async (slug) => {
+          await reloadCollections();
+          toast("Collection saved", "success");
+          if (isNew) navigate(`/schemas/${slug}`);
+        }}
+        onDeleted={async () => {
+          await reloadCollections();
+          navigate("/schemas");
+        }}
+        back={href("/schemas")}
+        api={api}
+        toast={toast}
+      />
+    </Loading>
+  );
+};
+
+const SchemaForm: Component<{
+  initial: ResolvedCollection;
+  isNew: boolean;
+  back: string;
+  api: ReturnType<typeof useDashboard>["api"];
+  toast: ReturnType<typeof useDashboard>["toast"];
+  onSaved: (slug: string) => Promise<void>;
+  onDeleted: () => Promise<void>;
+}> = (props) => {
+  const [def, setDef] = createSignal<ResolvedCollection>(structuredClone(props.initial));
+  const [fields, setFields] = createSignal<FieldRow[]>(Object.entries(props.initial.fields).map(([key, f]) => ({ key, ...f })));
+  const [busy, setBusy] = createSignal(false);
+  const patch = (p: Partial<ResolvedCollection>) => setDef({ ...def(), ...p });
+  const setFeature = (k: string, v: unknown) => patch({ features: { ...def().features, [k]: v } as any });
+  const updateField = (i: number, p: Partial<FieldRow>) => setFields(fields().map((f, j) => (j === i ? { ...f, ...p } : f)));
+  const moveField = (i: number, d: -1 | 1) => {
+    const list = [...fields()];
+    const [f] = list.splice(i, 1);
+    list.splice(Math.max(0, Math.min(list.length, i + d)), 0, f!);
+    setFields(list);
+  };
+
+  const save = async () => {
+    const keys = fields().map((f) => f.key);
+    if (keys.some((k) => !/^[a-zA-Z][a-zA-Z0-9_]*$/.test(k))) return props.toast("Field keys must be identifiers (letters, numbers, _)", "error");
+    if (new Set(keys).size !== keys.length) return props.toast("Field keys must be unique", "error");
+    const { source: _s, id: _id, ...rest } = def() as any;
+    const body = { ...rest, fields: Object.fromEntries(fields().map(({ key, ...f }) => [key, f])) };
+    setBusy(true);
+    try {
+      const { collection } = props.isNew ? await props.api.collections.create(body) : await props.api.collections.update(def().slug, body);
+      await props.onSaved(collection.slug);
+    } catch (err) {
+      props.toast((err as Error).message, "error");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div>
+      <PageHeader
+        icon={def().icon}
+        title={props.isNew ? "New collection" : resolveLabel(def().label)}
+        description={<a class="text-primary-500" href={props.back}>← All collections</a>}
+        actions={
+          <>
+            <Show when={!props.isNew && def().source === "database"}>
+              <Button variant="ghost" class="text-error-500" onClick={async () => {
+                if (!confirm("Delete this collection definition? Entries are kept.")) return;
+                await props.api.collections.remove(def().slug);
+                await props.onDeleted();
+              }}>Delete</Button>
+            </Show>
+            <Button variant="primary" loading={busy()} onClick={() => void save()}>
+              {def().source === "database" || props.isNew ? "Save" : "Save override"}
+            </Button>
+          </>
+        }
+      />
+      <div class="grid max-w-6xl gap-8 p-6 lg:grid-cols-[1fr_320px]">
+        <section class="flex flex-col gap-3">
+          <h2 class="text-sm font-semibold text-highlighted">Fields</h2>
+          <For each={fields()}>
+            {(f, i) => (
+              <div class="grid grid-cols-12 items-start gap-2 rounded-lg border border-default p-3">
+                <input class={`${inputClass} col-span-3 font-mono text-xs`} placeholder="key" value={f.key} onInput={(e) => updateField(i(), { key: e.currentTarget.value })} />
