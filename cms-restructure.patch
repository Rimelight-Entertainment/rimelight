diff --git a/packages/cms/src/services/collections.ts b/packages/cms/src/services/collections.ts
new file mode 100644
index 0000000..ee6d778
--- /dev/null
+++ b/packages/cms/src/services/collections.ts
@@ -0,0 +1,167 @@
+import { asc, eq, isNull, sql } from "drizzle-orm";
+import type { CmsActor, CmsContext } from "./context";
+import { CmsError, isAdmin, json, notFound, slugify } from "./context";
+import { builtinCollections } from "../core/collections/builtins";
+import { resolveCollection, resolveLabel } from "../core/collections/define";
+import { parseFieldSchema } from "../core/collections/legacy";
+import type { CollectionDefinition, ResolvedCollection } from "../core/collections/types";
+
+/**
+ * Collections are resolved from three sources, highest priority first:
+ * 1. `content_types` rows (created in the dashboard / MCP) — editable
+ * 2. code (`cms.config.ts` collections, then built-ins)
+ * 3. inferred from `pages.type` values that have no definition (legacy content stays reachable)
+ */
+
+function fromRow(row: any): ResolvedCollection {
+  const { groups, fields } = parseFieldSchema(row.fieldSchema);
+  const features = json<Record<string, any>>(row.features, {});
+  const ecom = json<any>(row.ecomSettings, null);
+  const name = json<any>(row.name, row.name);
+  const def: CollectionDefinition = {
+    slug: row.slug,
+    label: name,
+    description: json<any>(row.description, row.description) ?? undefined,
+    icon: row.icon ?? "i-lucide-box",
+    kind: row.mode ?? "document",
+    groups,
+    fields,
+    features: {
+      ...features,
+      ...(ecom?.enabled !== false && ecom ? { ecommerce: { currency: ecom.currencyDefault ?? ecom.currency ?? "USD", ...ecom } } : {}),
+    },
+    workflow: json(row.workflow, {}),
+    initialBlocks: json(row.initialBlocks, []),
+  };
+  return { ...resolveCollection(def, "database"), id: row.id };
+}
+
+function toRow(def: CollectionDefinition) {
+  const label = typeof def.label === "string" ? { en: def.label } : def.label;
+  const description =
+    def.description === undefined
+      ? null
+      : typeof def.description === "string"
+        ? { en: def.description }
+        : def.description;
+  const { ecommerce, ...features } = def.features ?? {};
+  return {
+    slug: def.slug,
+    name: label,
+    description,
+    icon: def.icon ?? "i-lucide-box",
+    mode: def.kind ?? "document",
+    fieldSchema: { groups: def.groups ?? {}, fields: def.fields ?? {} },
+    ecomSettings: ecommerce ? { enabled: true, currencyDefault: ecommerce.currency, ...ecommerce } : null,
+    features,
+    workflow: def.workflow ?? {},
+    initialBlocks: Array.isArray(def.initialBlocks) ? def.initialBlocks : [],
+  };
+}
+
+export async function listCollections(ctx: CmsContext): Promise<ResolvedCollection[]> {
+  const bySlug = new Map<string, ResolvedCollection>();
+  for (const def of builtinCollections) bySlug.set(def.slug, resolveCollection(def, "code"));
+  for (const def of ctx.collections) bySlug.set(def.slug, resolveCollection(def, "code"));
+
+  const rows = await ctx.db.select().from(ctx.t.contentTypes).orderBy(asc(ctx.t.contentTypes.slug));
+  for (const row of rows) bySlug.set(row.slug, fromRow(row));
+
+  // Legacy page types with no definition still need a home in the dashboard.
+  const types = await ctx.db
+    .selectDistinct({ type: ctx.t.pages.type })
+    .from(ctx.t.pages)
+    .where(isNull(ctx.t.pages.deletedAt));
+  for (const { type } of types) {
+    if (type && !bySlug.has(type)) {
+      bySlug.set(type, resolveCollection({ slug: type, label: titleCase(type) }, "inferred"));
+    }
+  }
+  return [...bySlug.values()];
+}
+
+export async function getCollection(ctx: CmsContext, slug: string): Promise<ResolvedCollection> {
+  const rows = await ctx.db
+    .select()
+    .from(ctx.t.contentTypes)
+    .where(eq(ctx.t.contentTypes.slug, slug))
+    .limit(1);
+  if (rows[0]) return fromRow(rows[0]);
+  const code =
+    ctx.collections.find((c) => c.slug === slug) ?? builtinCollections.find((c) => c.slug === slug);
+  if (code) return resolveCollection(code, "code");
+  // Unknown slug: allow it (inferred) only if entries exist with that type.
+  const exists = await ctx.db
+    .select({ n: sql<number>`count(*)` })
+    .from(ctx.t.pages)
+    .where(eq(ctx.t.pages.type, slug));
+  if (Number(exists[0]?.n ?? 0) > 0) {
+    return resolveCollection({ slug, label: titleCase(slug) }, "inferred");
+  }
+  throw notFound(`Collection "${slug}"`);
+}
+
+function assertAdmin(actor: CmsActor) {
+  if (!isAdmin(actor)) throw new CmsError(403, "Only admins can change collection schemas");
+}
+
+export async function createCollection(ctx: CmsContext, actor: CmsActor, def: CollectionDefinition) {
+  assertAdmin(actor);
+  const slug = slugify(def.slug || resolveLabel(def.label)).replace(/\//g, "-");
+  if (!slug) throw new CmsError(422, "Collection slug is required");
+  const existing = await ctx.db
+    .select({ id: ctx.t.contentTypes.id })
+    .from(ctx.t.contentTypes)
+    .where(eq(ctx.t.contentTypes.slug, slug))
+    .limit(1);
+  if (existing[0]) throw new CmsError(409, `Collection "${slug}" already exists`);
+  const [row] = await ctx.db
+    .insert(ctx.t.contentTypes)
+    .values(toRow({ ...def, slug }))
+    .returning();
+  return fromRow(row);
+}
+
+/**
+ * Updates (or, for a code/inferred collection, overrides) a collection. Overriding a code
+ * collection stores a DB copy that then takes precedence; deleting it restores the code version.
+ */
+export async function updateCollection(
+  ctx: CmsContext,
+  actor: CmsActor,
+  slug: string,
+  patch: Partial<CollectionDefinition>,
+) {
+  assertAdmin(actor);
+  const current = await getCollection(ctx, slug);
+  const next: CollectionDefinition = { ...current, ...patch, slug };
+  const values = { ...toRow(next), updatedAt: new Date() };
+  if (current.source === "database") {
+    const [row] = await ctx.db
+      .update(ctx.t.contentTypes)
+      .set(values)
+      .where(eq(ctx.t.contentTypes.slug, slug))
+      .returning();
+    return fromRow(row);
+  }
+  const [row] = await ctx.db.insert(ctx.t.contentTypes).values(values).returning();
+  return fromRow(row);
+}
+
+export async function deleteCollection(ctx: CmsContext, actor: CmsActor, slug: string) {
+  assertAdmin(actor);
+  const rows = await ctx.db
+    .select()
+    .from(ctx.t.contentTypes)
+    .where(eq(ctx.t.contentTypes.slug, slug))
+    .limit(1);
+  if (!rows[0]) throw new CmsError(400, `"${slug}" is defined in code and cannot be deleted here`);
+  if (rows[0].isSystem) throw new CmsError(403, `"${slug}" is a system collection`);
+  // Entries are kept: the collection falls back to its code definition or becomes "inferred".
+  await ctx.db.delete(ctx.t.contentTypes).where(eq(ctx.t.contentTypes.slug, slug));
+  return { success: true };
+}
+
+function titleCase(s: string) {
+  return s.replace(/[-_]+/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
+}
diff --git a/packages/cms/src/services/context.ts b/packages/cms/src/services/context.ts
new file mode 100644
index 0000000..2c34eb8
--- /dev/null
+++ b/packages/cms/src/services/context.ts
@@ -0,0 +1,113 @@
+import type { Dialect, CmsTables } from "../db/index";
+import { tablesFor } from "../db/index";
+import { BlockRegistry } from "../core/blocks/registry";
+import { builtinBlocks } from "../core/blocks/builtins";
+import type { CollectionDefinition } from "../core/collections/types";
+import type { BlockDefinition } from "../core/blocks/registry";
+import type { TaxonomyDefinition } from "../core/types/taxonomies";
+import { hasAnyRole, isAdmin } from "../auth/roles";
+
+/** The authenticated user performing an operation. */
+export interface CmsActor {
+  userId: string;
+  name?: string;
+  roles: string[];
+  permissions: string[];
+}
+
+export const SYSTEM_ACTOR: CmsActor = {
+  userId: "system",
+  name: "System",
+  roles: ["owner"],
+  permissions: ["*"],
+};
+
+/** Everything a service needs. Cheap to build per request. */
+export interface CmsContext {
+  db: any;
+  dialect: Dialect;
+  t: CmsTables;
+  blocks: BlockRegistry;
+  collections: CollectionDefinition[];
+  taxonomies: TaxonomyDefinition[];
+  locales: string[];
+  previewSecret?: string;
+}
+
+export interface CmsContextInput {
+  db: any;
+  dialect: Dialect;
+  blocks?: BlockDefinition<any>[];
+  collections?: CollectionDefinition[];
+  taxonomies?: TaxonomyDefinition[];
+  locales?: string[];
+  previewSecret?: string;
+}
+
+export const DEFAULT_TAXONOMIES: TaxonomyDefinition[] = [
+  { slug: "category", label: "Categories", hierarchical: true },
+  { slug: "tag", label: "Tags", hierarchical: false },
+];
+
+export function createCmsContext(input: CmsContextInput): CmsContext {
+  const registry = new BlockRegistry().register(...builtinBlocks, ...(input.blocks ?? []));
+  const taxonomies = [...DEFAULT_TAXONOMIES];
+  for (const t of input.taxonomies ?? []) {
+    const i = taxonomies.findIndex((x) => x.slug === t.slug);
+    if (i >= 0) taxonomies[i] = t;
+    else taxonomies.push(t);
+  }
+  return {
+    db: input.db,
+    dialect: input.dialect,
+    t: tablesFor(input.dialect),
+    blocks: registry,
+    collections: input.collections ?? [],
+    taxonomies,
+    locales: input.locales ?? ["en"],
+    ...(input.previewSecret ? { previewSecret: input.previewSecret } : {}),
+  };
+}
+
+/** Error with an HTTP status. Routers and MCP translate it into a response. */
+export class CmsError extends Error {
+  constructor(
+    public status: 400 | 401 | 403 | 404 | 409 | 422 | 500,
+    message: string,
+    public details?: unknown,
+  ) {
+    super(message);
+    this.name = "CmsError";
+  }
+}
+
+export const notFound = (what: string) => new CmsError(404, `${what} not found`);
+
+/** JSON columns come back as strings from some drivers (raw D1, neon raw text mode). */
+export function json<T>(value: unknown, fallback: T): T {
+  if (value == null) return fallback;
+  if (typeof value === "string") {
+    try {
+      return JSON.parse(value) as T;
+    } catch {
+      return fallback;
+    }
+  }
+  return value as T;
+}
+
+export { isAdmin, hasAnyRole };
+
+export function requireRole(actor: CmsActor, roles: string[] | undefined, action: string) {
+  if (!hasAnyRole(actor, roles)) throw new CmsError(403, `Not allowed to ${action}`);
+}
+
+export function slugify(input: string): string {
+  return input
+    .toLowerCase()
+    .normalize("NFD")
+    .replace(/[̀-ͯ]/g, "")
+    .replace(/[^a-z0-9/]+/g, "-")
+    .replace(/\/+/g, "/")
+    .replace(/(^[-/]+)|([-/]+$)/g, "");
+}
