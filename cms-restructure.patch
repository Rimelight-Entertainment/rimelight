diff --git a/packages/cms/src/dashboard/CmsDashboard.tsx b/packages/cms/src/dashboard/CmsDashboard.tsx
new file mode 100644
index 0000000..2f075aa
--- /dev/null
+++ b/packages/cms/src/dashboard/CmsDashboard.tsx
@@ -0,0 +1,244 @@
+import { For, Show, createMemo, createSignal, onSettled, type Component, type JSX } from "solid-js";
+import { useLocation, useNavigate } from "@solidjs/router";
+import type { BlockDefinition } from "../core/blocks/registry";
+import type { ResolvedCollection } from "../core/collections/types";
+import { resolveLabel } from "../core/collections/define";
+import type { CmsActor } from "../services/context";
+import { createBlockRegistry } from "../solid/blocks/index";
+import { BlockRegistryContext } from "../solid/BlockRenderer";
+import { createApi } from "./api";
+import { DashboardContext, useDashboard, type DashboardContextValue, type Toast } from "./context";
+import { Overview } from "./views/Overview";
+import { EntriesList } from "./views/EntriesList";
+import { EntryEditor } from "./views/EntryEditor";
+import { MediaLibrary } from "./views/Media";
+import { Taxonomies } from "./views/Taxonomies";
+import { Bylines } from "./views/Bylines";
+import { Templates } from "./views/Templates";
+import { Reviews } from "./views/Reviews";
+import { Schemas } from "./views/Schemas";
+import { Settings } from "./views/Settings";
+
+export interface CmsDashboardProps {
+  /** Admin API base. Default `/api/cms`. */
+  apiBase?: string;
+  /** Custom blocks (normally `config.blocks` from cms.config.ts). */
+  blocks?: BlockDefinition<any>[];
+  locales?: string[];
+}
+
+/** Splits the URL into the dashboard base (".../cms") and the in-dashboard path. */
+function splitPath(pathname: string) {
+  const i = pathname.search(/\/cms(\/|$)/);
+  if (i === -1) return { base: "/cms", rest: "/" };
+  return { base: pathname.slice(0, i + 4), rest: pathname.slice(i + 4) || "/" };
+}
+
+/**
+ * The admin dashboard. Everything renders on the client only: the server and the first client
+ * render both output the same empty frame, so there is nothing to mismatch during hydration.
+ */
+export const CmsDashboard: Component<CmsDashboardProps> = (props) => {
+  const [mounted, setMounted] = createSignal(false);
+  onSettled(() => setMounted(true));
+  return (
+    <div class="rimelight-cms h-dvh w-full overflow-hidden bg-default text-default">
+      <Show when={mounted()} fallback={<div class="h-full w-full" aria-busy="true" />}>
+        <DashboardApp {...props} />
+      </Show>
+    </div>
+  );
+};
+
+const DashboardApp: Component<CmsDashboardProps> = (props) => {
+  const location = useLocation();
+  const routerNavigate = useNavigate();
+  const api = createApi(props.apiBase);
+  const registry = createBlockRegistry(props.blocks ?? []);
+
+  const [user, setUser] = createSignal<CmsActor | null>(null);
+  const [authError, setAuthError] = createSignal<string | null>(null);
+  const [collections, setCollections] = createSignal<ResolvedCollection[]>([]);
+  const [toasts, setToasts] = createSignal<Toast[]>([]);
+  const [navOpen, setNavOpen] = createSignal(false);
+
+  const path = createMemo(() => splitPath(location.pathname));
+
+  const reloadCollections = async () => {
+    const { collections } = await api.collections.list();
+    setCollections(collections);
+  };
+
+  let toastId = 0;
+  const ctx: DashboardContextValue = {
+    api,
+    user,
+    collections,
+    collection: (slug) => collections().find((c) => c.slug === slug),
+    reloadCollections,
+    registry,
+    locales: props.locales ?? ["en"],
+    href: (p) => `${path().base}${p === "/" ? "" : p}`,
+    navigate: (p) => {
+      setNavOpen(false);
+      routerNavigate(`${path().base}${p === "/" ? "" : p}`);
+    },
+    toast: (message, kind = "info") => {
+      const id = ++toastId;
+      setToasts((t) => [...t, { id, kind, message }]);
+      setTimeout(() => setToasts((t) => t.filter((x) => x.id !== id)), kind === "error" ? 7000 : 3500);
+    },
+  };
+
+  onSettled(() => {
+    void (async () => {
+      try {
+        setUser((await api.me()).user);
+        await reloadCollections();
+      } catch (err: any) {
+        setAuthError(err?.status === 401 ? "Sign in to use the CMS." : (err?.message ?? "Failed to load"));
+      }
+    })();
+  });
+
+  const segments = () => path().rest.split("/").filter(Boolean);
+
+  const view = (): JSX.Element => {
+    const [first, second, third] = segments();
+    switch (first) {
+      case undefined:
+        return <Overview />;
+      case "c":
+        return <EntriesList collection={second!} create={third === "new"} />;
+      case "e":
+        return <EntryEditor id={second!} />;
+      case "media":
+        return <MediaLibrary />;
+      case "taxonomies":
+        return <Taxonomies taxonomy={second} />;
+      case "bylines":
+        return <Bylines />;
+      case "templates":
+        return <Templates id={second} />;
+      case "reviews":
+        return <Reviews />;
+      case "schemas":
+        return <Schemas slug={second} />;
+      case "settings":
+        return <Settings />;
+      default:
+        return <NotFound />;
+    }
+  };
+
+  return (
+    <DashboardContext.Provider value={ctx}>
+      <BlockRegistryContext.Provider value={registry}>
+        <Show
+          when={!authError()}
+          fallback={
+            <div class="flex h-full items-center justify-center p-8 text-center">
+              <div class="flex max-w-sm flex-col gap-3">
+                <span class="i-lucide-lock mx-auto size-8 text-muted" />
+                <p class="text-sm text-toned">{authError()}</p>
+              </div>
+            </div>
+          }
+        >
+          <div class="flex h-full">
+            <aside
+              class={`fixed inset-y-0 left-0 z-40 w-64 shrink-0 border-r border-default bg-default transition-transform lg:static lg:translate-x-0 ${navOpen() ? "translate-x-0" : "-translate-x-full"}`}
+            >
+              <Sidebar active={path().rest} />
+            </aside>
+            <Show when={navOpen()}>
+              <button type="button" aria-label="Close menu" class="fixed inset-0 z-30 bg-black/40 lg:hidden" onClick={() => setNavOpen(false)} />
+            </Show>
+            <main class="flex min-w-0 flex-1 flex-col overflow-hidden">
+              <div class="flex h-12 shrink-0 items-center gap-2 border-b border-default px-3 lg:hidden">
+                <button type="button" aria-label="Open menu" class="i-lucide-menu size-5" onClick={() => setNavOpen(true)} />
+                <span class="text-sm font-semibold">Rimelight CMS</span>
+              </div>
+              <div class="min-h-0 flex-1 overflow-y-auto">{view()}</div>
+            </main>
+          </div>
+        </Show>
+        <div class="pointer-events-none fixed bottom-4 right-4 z-50 flex flex-col gap-2">
+          <For each={toasts()}>
+            {(t) => (
+              <div
+                role="status"
+                class={`pointer-events-auto rounded-lg border px-4 py-2.5 text-sm shadow-lg ${
+                  t.kind === "error"
+                    ? "border-error-500/40 bg-error-500/10 text-error-600"
+                    : t.kind === "success"
+                      ? "border-success-500/40 bg-success-500/10 text-success-600"
+                      : "border-default bg-elevated text-highlighted"
+                }`}
+              >
+                {t.message}
+              </div>
+            )}
+          </For>
+        </div>
+      </BlockRegistryContext.Provider>
+    </DashboardContext.Provider>
+  );
+};
+
+const Sidebar: Component<{ active: string }> = (props) => {
+  const { collections, href, user } = useDashboard();
+  const isActive = (p: string) => (p === "/" ? props.active === "/" : props.active === p || props.active.startsWith(`${p}/`));
+
+  const item = (p: string, label: string, icon: string) => (
+    <a
+      href={href(p)}
+      class={`flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm transition-colors ${
+        isActive(p) ? "bg-primary-500/10 font-medium text-primary-500" : "text-toned hover:bg-elevated hover:text-highlighted"
+      }`}
+    >
+      <span class={`${icon} size-4 shrink-0`} />
+      <span class="truncate">{label}</span>
+    </a>
+  );
+  const heading = (label: string) => (
+    <div class="px-2.5 pb-1 pt-4 text-[11px] font-semibold uppercase tracking-wider text-muted">{label}</div>
+  );
+
+  return (
+    <nav class="flex h-full flex-col overflow-y-auto p-3">
+      <div class="flex items-center gap-2 px-2.5 py-2">
+        <span class="i-lucide-layers size-5 text-primary-500" />
+        <span class="font-semibold text-highlighted">Rimelight CMS</span>
+      </div>
+      {item("/", "Overview", "i-lucide-layout-dashboard")}
+      {heading("Content")}
+      <For each={collections()}>
+        {(c) => item(`/c/${c.slug}`, resolveLabel(c.labelPlural ?? c.label), c.icon ?? "i-lucide-box")}
+      </For>
+      {heading("Library")}
+      {item("/media", "Media", "i-lucide-image")}
+      {item("/taxonomies", "Taxonomies", "i-lucide-tags")}
+      {item("/bylines", "Bylines", "i-lucide-users")}
+      {heading("Workflow")}
+      {item("/reviews", "Reviews", "i-lucide-check-check")}
+      {heading("Configure")}
+      {item("/schemas", "Collections", "i-lucide-database")}
+      {item("/templates", "Templates", "i-lucide-layout-template")}
+      {item("/settings", "Settings", "i-lucide-settings")}
+      <div class="mt-auto flex items-center gap-2 border-t border-default px-2.5 pt-3 text-xs text-muted">
+        <span class="i-lucide-circle-user size-4" />
+        <span class="truncate">{user()?.name ?? "…"}</span>
+      </div>
+    </nav>
+  );
+};
+
+const NotFound: Component = () => {
+  const { href } = useDashboard();
+  return (
+    <div class="p-10 text-center text-sm text-muted">
+      Nothing here. <a class="text-primary-500" href={href("/")}>Back to overview</a>
+    </div>
+  );
+};
diff --git a/packages/cms/src/dashboard/api.ts b/packages/cms/src/dashboard/api.ts
new file mode 100644
index 0000000..c3f7dc6
--- /dev/null
+++ b/packages/cms/src/dashboard/api.ts
@@ -0,0 +1,127 @@
+import type { Entry, EntrySummary } from "../services/entries";
+import type { ResolvedCollection } from "../core/collections/types";
+import type { PageTemplate } from "../core/types/templates";
+import type { TaxonomyDefinition, TaxonomyTerm } from "../core/types/taxonomies";
+import type { CmsActor } from "../services/context";
+import type { LockState } from "../services/entries";
+
+export class ApiError extends Error {
+  constructor(public status: number, message: string, public details?: unknown) {
+    super(message);
+  }
+}
+
+/** Thin typed client for the admin API (`/api/cms`). */
+export function createApi(base = "/api/cms") {
+  const call = async <T>(method: string, path: string, body?: unknown): Promise<T> => {
+    const res = await fetch(`${base}${path}`, {
+      method,
+      credentials: "same-origin",
+      headers: body === undefined ? {} : { "Content-Type": "application/json" },
+      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+    });
+    const data = (await res.json().catch(() => ({}))) as any;
+    if (!res.ok) throw new ApiError(res.status, data?.error ?? res.statusText, data?.details);
+    return data as T;
+  };
+  const qs = (params: Record<string, unknown>) => {
+    const s = new URLSearchParams();
+    for (const [k, v] of Object.entries(params)) if (v !== undefined && v !== "" && v !== null) s.set(k, String(v));
+    const str = s.toString();
+    return str ? `?${str}` : "";
+  };
+
+  return {
+    me: () => call<{ user: CmsActor }>("GET", "/me"),
+    stats: () => call<{ totalEntries: number; byCollection: Record<string, Record<string, number>>; pendingReviews: number; scheduled: number }>("GET", "/stats"),
+
+    collections: {
+      list: () => call<{ collections: ResolvedCollection[] }>("GET", "/collections"),
+      get: (slug: string) => call<{ collection: ResolvedCollection }>("GET", `/collections/${slug}`),
+      create: (def: unknown) => call<{ collection: ResolvedCollection }>("POST", "/collections", def),
+      update: (slug: string, def: unknown) => call<{ collection: ResolvedCollection }>("PUT", `/collections/${slug}`, def),
+      remove: (slug: string) => call("DELETE", `/collections/${slug}`),
+    },
+
+    entries: {
+      list: (p: { collection?: string; status?: string; q?: string; slugPrefix?: string; orderBy?: string; limit?: number; offset?: number; deleted?: boolean; content?: boolean; taxonomy?: string; term?: string }) =>
+        call<{ entries: EntrySummary[]; total: number }>("GET", `/entries${qs(p)}`),
+      get: (id: string) => call<{ entry: Entry; lock: LockState }>("GET", `/entries/${id}`),
+      create: (input: unknown) => call<{ entry: Entry }>("POST", "/entries", input),
+      updateMeta: (id: string, patch: unknown) => call<{ entry: Entry }>("PATCH", `/entries/${id}`, patch),
+      remove: (id: string) => call("DELETE", `/entries/${id}`),
+      restore: (id: string) => call<{ entry: Entry }>("POST", `/entries/${id}/restore`),
+      duplicate: (id: string) => call<{ entry: Entry }>("POST", `/entries/${id}/duplicate`),
+      saveDraft: (id: string, content: unknown) => call<{ entry: Entry }>("PUT", `/entries/${id}/draft`, content),
+      discardDraft: (id: string) => call<{ entry: Entry }>("DELETE", `/entries/${id}/draft`),
+      lock: (id: string, force = false) => call<{ lock: LockState }>("POST", `/entries/${id}/lock`, { force }),
+      unlock: (id: string) => call("DELETE", `/entries/${id}/lock`),
+      publish: (id: string, body: { versionId?: string; changeSummary?: string } = {}) => call<{ entry: Entry }>("POST", `/entries/${id}/publish`, body),
+      unpublish: (id: string) => call<{ entry: Entry }>("POST", `/entries/${id}/unpublish`),
+      schedule: (id: string, at: string | null) => call<{ entry: Entry }>("POST", `/entries/${id}/schedule`, { at }),
+      requestReview: (id: string, changeSummary?: string) => call("POST", `/entries/${id}/review`, { changeSummary }),
+      versions: (id: string) => call<{ versions: any[] }>("GET", `/entries/${id}/versions`),
+      diff: (id: string, from?: string, to?: string) => call<{ diff: any }>("GET", `/entries/${id}/diff${qs({ from, to })}`),
+      previewToken: (id: string) => call<{ token: string; expiresAt: number }>("POST", `/entries/${id}/preview-token`),
+      terms: (id: string) => call<{ terms: TaxonomyTerm[] }>("GET", `/entries/${id}/terms`),
+      setTerms: (id: string, taxonomy: string, termIds: string[]) => call<{ terms: TaxonomyTerm[] }>("PUT", `/entries/${id}/terms/${taxonomy}`, { termIds }),
+    },
+
+    versions: {
+      reviews: () => call<{ versions: any[] }>("GET", "/reviews"),
+      get: (id: string) => call<{ version: any }>("GET", `/versions/${id}`),
+      approve: (id: string) => call<{ version: any }>("POST", `/versions/${id}/approve`),
+      reject: (id: string, reason?: string) => call<{ version: any }>("POST", `/versions/${id}/reject`, { reason }),
+      rollback: (id: string) => call<{ entry: Entry }>("POST", `/versions/${id}/rollback`),
+      comments: (id: string) => call<{ comments: any[] }>("GET", `/versions/${id}/comments`),
+      comment: (id: string, content: string, blockId?: string) => call("POST", `/versions/${id}/comments`, { content, blockId }),
+    },
+
+    templates: {
+      list: (collection?: string) => call<{ templates: PageTemplate[] }>("GET", `/templates${qs({ collection })}`),
+      get: (id: string) => call<{ template: PageTemplate }>("GET", `/templates/${id}`),
+      create: (input: unknown) => call<{ template: PageTemplate }>("POST", "/templates", input),
+      update: (id: string, input: unknown) => call<{ template: PageTemplate }>("PUT", `/templates/${id}`, input),
+      remove: (id: string) => call("DELETE", `/templates/${id}`),
+    },
+
+    taxonomies: {
+      list: () => call<{ taxonomies: TaxonomyDefinition[] }>("GET", "/taxonomies"),
+      terms: (taxonomy: string) => call<{ terms: TaxonomyTerm[] }>("GET", `/taxonomies/${taxonomy}/terms`),
+      createTerm: (taxonomy: string, input: unknown) => call<{ term: TaxonomyTerm }>("POST", `/taxonomies/${taxonomy}/terms`, input),
+      updateTerm: (taxonomy: string, id: string, input: unknown) => call<{ term: TaxonomyTerm }>("PUT", `/taxonomies/${taxonomy}/terms/${id}`, input),
+      deleteTerm: (taxonomy: string, id: string) => call("DELETE", `/taxonomies/${taxonomy}/terms/${id}`),
+    },
+
+    bylines: {
+      list: () => call<{ bylines: any[] }>("GET", "/bylines"),
+      create: (input: unknown) => call<{ byline: any }>("POST", "/bylines", input),
+      update: (id: string, input: unknown) => call<{ byline: any }>("PUT", `/bylines/${id}`, input),
+      remove: (id: string) => call("DELETE", `/bylines/${id}`),
+    },
+
+    settings: {
+      get: () => call<{ settings: any }>("GET", "/settings"),
+      update: (input: unknown) => call<{ settings: any }>("PUT", "/settings", input),
+    },
+
+    search: (q: string, collection?: string) => call<{ results: any[] }>("GET", `/search${qs({ q, collection })}`),
+    reindex: () => call<{ indexed: number }>("POST", "/search/reindex"),
+
+    media: {
+      list: (p: { search?: string; type?: string; cursor?: string } = {}) =>
+        call<{ success: boolean; data: { files: any[]; cursor?: string; truncated: boolean } }>("GET", `/media${qs(p)}`),
+      upload: async (file: File) => {
+        const form = new FormData();
+        form.set("file", file);
+        const res = await fetch(`${base}/media`, { method: "POST", body: form, credentials: "same-origin" });
+        const data = (await res.json()) as any;
+        if (!res.ok || !data.success) throw new ApiError(res.status, data.error ?? "Upload failed");
+        return data.data.file as { key: string; url: string; name: string; mimeType: string; size: number };
+      },
+      remove: (key: string) => call("DELETE", `/media${qs({ key })}`),
+    },
+  };
+}
+
+export type CmsApi = ReturnType<typeof createApi>;
