index 0000000..350f355
--- /dev/null
+++ b/packages/cms/src/core/blocks/registry.ts
@@ -0,0 +1,101 @@
+import type { Component } from "solid-js";
+import type { BaseBlock } from "../types/blocks";
+import type { FieldDefinition } from "../collections/types";
+import { createBlockId } from "./tree";
+
+/** Props every block renderer receives. Nested blocks arrive pre-rendered as `children`. */
+export interface BlockRenderProps {
+  block: BaseBlock;
+  locale?: string;
+  sectionDepth?: number;
+  index?: number;
+  components?: Record<string, Component<any>>;
+  children?: any;
+}
+
+/** Props a custom block editor receives inside the block canvas. */
+export interface BlockEditorProps<P = Record<string, any>> {
+  block: BaseBlock & { props: P };
+  /** Shallow-merge into the block's props. */
+  update: (patch: Partial<P>) => void;
+  readOnly: boolean;
+  sectionDepth: number;
+  /** Renders the block's children as an editable nested canvas (for container blocks). */
+  renderChildren: () => any;
+}
+
+export type BlockCategory = "text" | "structure" | "media" | "data" | "embed" | (string & {});
+
+export interface BlockDefinition<P extends Record<string, any> = Record<string, any>> {
+  type: string;
+  label: string;
+  description?: string;
+  icon?: string;
+  category?: BlockCategory;
+  /** Slash-menu search aliases. */
+  keywords?: string[];
+  defaultProps: P;
+  /**
+   * Typed props. Used for validation, the auto-generated inspector, and MCP docs. Same field
+   * vocabulary as collections.
+   */
+  fields?: Record<string, FieldDefinition>;
+  /** Child block types. Omit for leaf blocks; `"*"` allows any root-level block. */
+  children?: string[] | "*";
+  /** Blocks created alongside a new instance (e.g. a Tabs block starts with one TabItem). */
+  initialChildren?: () => BaseBlock[];
+  /** Hidden from the root slash menu (only insertable inside its parent, e.g. TabItem). */
+  nestedOnly?: boolean;
+  /** The text prop edited inline in the canvas (contenteditable). */
+  inlineText?: keyof P & string;
+  render?: Component<BlockRenderProps>;
+  /** Custom canvas editor. Omitted → inline text (if `inlineText`) + auto inspector from `fields`. */
+  editor?: Component<BlockEditorProps<P>>;
+}
+
+export class BlockRegistry {
+  #defs = new Map<string, BlockDefinition>();
+
+  register(...defs: BlockDefinition<any>[]): this {
+    for (const def of defs) this.#defs.set(def.type, def);
+    return this;
+  }
+  get(type: string): BlockDefinition | undefined {
+    return this.#defs.get(type);
+  }
+  has(type: string): boolean {
+    return this.#defs.has(type);
+  }
+  all(): BlockDefinition[] {
+    return [...this.#defs.values()];
+  }
+  /** Block types insertable inside `parentType` (or at the root when null). */
+  allowedChildren(parentType: string | null, rootAllowed?: string[]): BlockDefinition[] {
+    if (!parentType) {
+      return this.all().filter(
+        (d) => !d.nestedOnly && (!rootAllowed || rootAllowed.includes(d.type)),
+      );
+    }
+    const allowed = this.get(parentType)?.children;
+    if (!allowed) return [];
+    if (allowed === "*") return this.allowedChildren(null, rootAllowed);
+    return allowed.map((t) => this.get(t)).filter((d): d is BlockDefinition => !!d);
+  }
+  create(type: string, props?: Record<string, any>): BaseBlock {
+    const def = this.get(type);
+    const block: BaseBlock = {
+      id: createBlockId(),
+      type,
+      props: { ...structuredClone(def?.defaultProps ?? {}), ...props },
+    };
+    if (def?.children) block.children = def.initialChildren?.() ?? [];
+    return block;
+  }
+  clone(): BlockRegistry {
+    return new BlockRegistry().register(...this.all());
+  }
+}
+
+export function defineBlock<P extends Record<string, any>>(def: BlockDefinition<P>): BlockDefinition<P> {
+  return def;
+}
diff --git a/packages/cms/src/core/blocks/tree.ts b/packages/cms/src/core/blocks/tree.ts
new file mode 100644
index 0000000..3de00c0
--- /dev/null
+++ b/packages/cms/src/core/blocks/tree.ts
@@ -0,0 +1,162 @@
+import type { BaseBlock } from "../types/blocks";
+
+/**
+ * Pure, immutable operations on block trees.
+ *
+ * Canonical shape: nested blocks live in `block.children`. Historic content also stored them in
+ * `block.props.children` (and the old editor wrote both). `normalizeBlocks` folds every legacy
+ * shape into the canonical one; everything else in the CMS assumes normalized input.
+ */
+
+export function createBlockId(): string {
+  return crypto.randomUUID();
+}
+
+export function getChildren(block: BaseBlock | null | undefined): BaseBlock[] {
+  if (!block) return [];
+  if (Array.isArray(block.children)) return block.children;
+  const legacy = block.props?.["children"];
+  return Array.isArray(legacy) ? legacy : [];
+}
+
+/**
+ * Returns a canonical copy of a (possibly legacy) block tree:
+ * - `props.children` moved to `children`
+ * - missing ids generated, missing `props` defaulted
+ * - nested duplicates of root blocks removed (an old editor bug duplicated children at root)
+ */
+export function normalizeBlocks(input: unknown): BaseBlock[] {
+  let list: unknown = input;
+  if (typeof list === "string") {
+    try {
+      list = JSON.parse(list);
+    } catch {
+      return [];
+    }
+  }
+  if (!Array.isArray(list)) return [];
+
+  const seen = new Set<string>();
+  const visit = (raw: any): BaseBlock | null => {
+    if (!raw || typeof raw !== "object" || typeof raw.type !== "string") return null;
+    const { children: _legacyChildren, ...props } = (raw.props ?? {}) as Record<string, any>;
+    const id = typeof raw.id === "string" && raw.id && !seen.has(raw.id) ? raw.id : createBlockId();
+    seen.add(id);
+    const block: BaseBlock = { ...raw, id, props };
+    const kids = getChildren(raw).map(visit).filter((b): b is BaseBlock => !!b);
+    if (kids.length > 0 || Array.isArray(raw.children) || Array.isArray(raw.props?.children)) {
+      block.children = kids;
+    } else {
+      delete block.children;
+    }
+    return block;
+  };
+
+  // Collect ids that appear nested so root-level duplicates can be dropped.
+  const nestedIds = new Set<string>();
+  const collect = (blocks: any[]) => {
+    for (const b of blocks) {
+      for (const c of getChildren(b)) {
+        if (c?.id) nestedIds.add(c.id);
+        collect([c]);
+      }
+    }
+  };
+  collect(list as any[]);
+
+  return (list as any[])
+    .filter((b) => !(b?.id && nestedIds.has(b.id)))
+    .map(visit)
+    .filter((b): b is BaseBlock => !!b);
+}
+
+export function* walkBlocks(
+  blocks: BaseBlock[],
+  parent: BaseBlock | null = null,
+  depth = 0,
+): Generator<{ block: BaseBlock; parent: BaseBlock | null; depth: number; index: number }> {
+  for (let index = 0; index < blocks.length; index++) {
+    const block = blocks[index]!;
+    yield { block, parent, depth, index };
+    yield* walkBlocks(getChildren(block), block, depth + 1);
+  }
+}
+
+export function flattenBlocks(blocks: BaseBlock[]): BaseBlock[] {
+  return Array.from(walkBlocks(blocks), (e) => e.block);
+}
+
+export function findBlock(
+  blocks: BaseBlock[],
+  id: string,
+): { block: BaseBlock; parent: BaseBlock | null; index: number; depth: number } | null {
+  for (const entry of walkBlocks(blocks)) if (entry.block.id === id) return entry;
+  return null;
+}
+
+/** Maps over every block (depth-first), rebuilding the tree immutably. */
+export function mapBlocks(
+  blocks: BaseBlock[],
+  fn: (block: BaseBlock) => BaseBlock | null,
+): BaseBlock[] {
+  const out: BaseBlock[] = [];
+  for (const block of blocks) {
+    const mapped = fn(block);
+    if (!mapped) continue;
+    const kids = getChildren(mapped);
+    out.push(kids.length ? { ...mapped, children: mapBlocks(kids, fn) } : mapped);
+  }
+  return out;
+}
+
+export function updateBlock(
+  blocks: BaseBlock[],
+  id: string,
+  patch: (block: BaseBlock) => BaseBlock,
+): BaseBlock[] {
+  return mapBlocks(blocks, (b) => (b.id === id ? patch(b) : b));
+}
+
+export function removeBlock(blocks: BaseBlock[], id: string): BaseBlock[] {
+  return mapBlocks(blocks, (b) => (b.id === id ? null : b));
+}
+
+/** Inserts `block` into `parentId`'s children (or the root when null) at `index`. */
+export function insertBlock(
+  blocks: BaseBlock[],
+  block: BaseBlock,
+  parentId: string | null,
+  index: number,
+): BaseBlock[] {
+  const place = (list: BaseBlock[]) => {
+    const next = [...list];
+    next.splice(Math.max(0, Math.min(index, next.length)), 0, block);
+    return next;
+  };
+  if (!parentId) return place(blocks);
+  return updateBlock(blocks, parentId, (p) => ({ ...p, children: place(getChildren(p)) }));
+}
+
+/** Moves a block to a new parent/index. No-op if the target is inside the moved block. */
+export function moveBlock(
+  blocks: BaseBlock[],
+  id: string,
+  parentId: string | null,
+  index: number,
+): BaseBlock[] {
+  const found = findBlock(blocks, id);
+  if (!found) return blocks;
+  if (parentId && (parentId === id || findBlock(getChildren(found.block), parentId))) return blocks;
+  const without = removeBlock(blocks, id);
+  // Moving down within the same list shifts the target index by one.
+  const sameParent = (found.parent?.id ?? null) === parentId;
+  const adjusted = sameParent && index > found.index ? index - 1 : index;
+  return insertBlock(without, found.block, parentId, adjusted);
+}
+
+/** Deep copy of a block with fresh ids (for duplicate / paste). */
+export function cloneBlock(block: BaseBlock): BaseBlock {
+  const copy = structuredClone(block);
+  for (const { block: b } of walkBlocks([copy])) b.id = createBlockId();
+  return copy;
+}
