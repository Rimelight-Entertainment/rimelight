+import { defineBlock, type BlockDefinition } from "./registry";
+import { createBlockId } from "./tree";
+
+/**
+ * Built-in block definitions (data only). Prop names here are the single source of truth and
+ * match the renderers in `solid/blocks/*` and the typed interfaces in `core/types/blocks.ts`.
+ * Renderers are attached in `solid/blocks/index.ts` so this module stays framework-free.
+ */
+
+const variants = ["info", "success", "warning", "error", "commentary", "ideation", "source"];
+
+export const builtinBlocks: BlockDefinition<any>[] = [
+  defineBlock({
+    type: "ParagraphBlock",
+    label: "Text",
+    description: "Plain text with inline formatting, links and mentions.",
+    icon: "i-lucide-pilcrow",
+    category: "text",
+    keywords: ["paragraph", "p", "text"],
+    defaultProps: { text: [] },
+    inlineText: "text",
+  }),
+  defineBlock({
+    type: "SectionBlock",
+    label: "Section",
+    description: "Heading that groups the blocks below it. Nest sections for H3–H6.",
+    icon: "i-lucide-heading",
+    category: "structure",
+    keywords: ["heading", "h2", "h3", "title"],
+    defaultProps: { title: "" },
+    fields: {
+      title: { type: "text", label: "Heading" },
+      description: { type: "textarea", label: "Subtitle" },
+      mainArticleSlug: { type: "text", label: "Main article slug" },
+    },
+    inlineText: "title",
+    children: "*",
+  }),
+  defineBlock({
+    type: "CalloutBlock",
+    label: "Callout",
+    description: "Highlighted box for notes, warnings and tips.",
+    icon: "i-lucide-info",
+    category: "text",
+    keywords: ["note", "warning", "tip", "admonition"],
+    defaultProps: { variant: "info" },
+    fields: {
+      variant: {
+        type: "select",
+        label: "Variant",
+        options: variants.map((v) => ({ value: v, label: v[0]!.toUpperCase() + v.slice(1) })),
+      },
+      to: { type: "url", label: "Link" },
+    },
+    children: [
+      "ParagraphBlock",
+      "UnorderedListBlock",
+      "OrderedListBlock",
+      "ImageBlock",
+      "CodeBlock",
+      "TableBlock",
+    ],
+    initialChildren: () => [{ id: createBlockId(), type: "ParagraphBlock", props: { text: [] } }],
+  }),
+  defineBlock({
+    type: "UnorderedListBlock",
+    label: "Bulleted list",
+    icon: "i-lucide-list",
+    category: "text",
+    keywords: ["ul", "bullets"],
+    defaultProps: {},
+    children: ["ListItemBlock"],
+    initialChildren: () => [{ id: createBlockId(), type: "ListItemBlock", props: { content: [] } }],
+  }),
+  defineBlock({
+    type: "OrderedListBlock",
+    label: "Numbered list",
+    icon: "i-lucide-list-ordered",
+    category: "text",
+    keywords: ["ol", "numbers"],
+    defaultProps: {},
+    children: ["ListItemBlock"],
+    initialChildren: () => [{ id: createBlockId(), type: "ListItemBlock", props: { content: [] } }],
+  }),
+  defineBlock({
+    type: "ListItemBlock",
+    label: "List item",
+    icon: "i-lucide-dot",
