{
  "extends": "astro/tsconfigs/strictest",
  "include": ["src/**/*", "../../packages/ui/src/**/*", "worker-configuration.d.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["astro/client", "vite/client", "node"],
    "plugins": [{ "name": "@astrojs/ts-plugin" }],
    "paths": {
      "@/*": ["../../packages/ui/src/*", "./src/*"],
      "@rimelight/ui/*": ["../../packages/ui/src/*", "../../packages/ui/*"]
    }
  }
}
