{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    "src/**/*",
    "../../packages/components/src/**/*",
    "../../packages/components/worker-configuration.d.ts",
    "worker-configuration.d.ts"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["astro/client", "vite/client", "node"],
    "plugins": [{ "name": "@astrojs/ts-plugin" }],
    "paths": {
      "@/*": ["../../packages/components/src/*", "./src/*"],
      "@rimelight/components/*": ["../../packages/components/src/*", "../../packages/components/*"]
    }
  }
}
