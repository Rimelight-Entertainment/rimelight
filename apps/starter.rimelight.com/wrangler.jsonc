{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-dot-rimelight-dot-com",
  "main": "./src/fetch.ts",
  "compatibility_date": "2026-08-27",
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "starter.rimelight.com",
      "custom_domain": true
    },
    {
      "pattern": "www.starter.rimelight.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starter-dot-rimelight-dot-com",
      "database_id": "a6610294-e214-4d35-b841-174469da54d2",
      "migrations_dir": "./drizzle",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "starter-dot-rimelight-dot-com",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "starter-dot-rimelight-dot-com_translations",
      "id": "8c09f90741704096bd1dcdf2abadc974",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ChatRoom",
        "class_name": "ChatRoom"
      }
    ]
  },
  "ratelimits": [
    {
      "namespace_id": "1001",
      "name": "MY_RATE_LIMITER",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "migrations": [
    {
      "tag": "v2",
      "new_classes": ["ChatRoom"]
    }
  ],
  "vars": {
    "CONSTRUCTION_MODE": "false",
    "EMAIL_DOMAIN": "rimelight.com",
    "CONTACT_OWNER_EMAIL": "owner@rimelight.com"
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY", "BETTER_AUTH_SECRET"]
  },
  "env": {
    "remote": {
      "r2_buckets": [
        {
          "binding": "BLOB",
          "bucket_name": "starter-dot-rimelight-dot-com",
          "remote": true
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "remote": true
        }
      ]
    }
  }
}
