{
  "name": "starter-dot-rimelight-dot-com",
  "version": "0.0.1",
  "private": true,
  "description": "Rimelight Starter Template",
  "homepage": "https://starter.rimelight.com",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "generate-types": "wrangler types",
    "dev": "vp dev",
    "prebuild": "pnpm -r --parallel --filter \"@rimelight/*\" run --if-present build",
    "build": "vp build",
    "preview": "vp build && wrangler dev",
    "profile": "vp build && wrangler check startup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply starter-dot-rimelight-dot-com --local",
    "db:migrate:remote": "wrangler d1 migrations apply starter-dot-rimelight-dot-com --remote",
    "check": "wrangler types && vp check --fix"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.60.1",
    "@rimelight/auth": "workspace:*",
    "@rimelight/cms": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/security": "workspace:*",
    "@rimelight/seo": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.30",
    "@solidjs/signals": "2.0.0-rc.9",
    "@solidjs/vite-plugin": "3.0.0-next.35",
    "@solidjs/web": "2.0.0-rc.9",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "solid-js": "2.0.0-rc.9",
    "wrangler": "4.140.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.14",
    "@iconify-json/lucide": "1.2.135",
    "@rimelight/config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "filesystem-routing": "0.4.0"
  },
  "engines": {
    "node": ">=26.8.2"
  },
  "packageManager": "pnpm@12.5.1"
}
