{
  "name": "starter-dot-rimelight-dot-com",
  "version": "0.0.1",
  "private": true,
  "description": "Rimelight Starter Template",
  "homepage": "https://starter.rimelight.com",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx",
      "./src/*/index.astro"
    ]
  },
  "scripts": {
    "prepare": "vp config",
    "generate-types": "wrangler types",
    "astro": "astro",
    "dev": "astro dev",
    "prebuild": "pnpm --filter '@rimelight/*' run --if-present build",
    "build": "astro build",
    "preview": "astro preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply starter-dot-rimelight-dot-com --local",
    "db:migrate:remote": "wrangler d1 migrations apply starter-dot-rimelight-dot-com --remote",
    "check": "wrangler types && vp check --fix && astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/solid-js": "7.0.2",
    "@nanostores/i18n": "1.3.3",
    "@rimelight/auth": "workspace:*",
    "@rimelight/cms": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/security": "workspace:*",
    "@rimelight/seo": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "astro": "7.3.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "nanostores": "1.5.3",
    "solid-js": "1.9.15",
    "wrangler": "4.129.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/ts-plugin": "1.10.11",
    "@iconify-json/logos": "1.2.14",
    "@iconify-json/lucide": "1.2.130",
    "@rimelight/config": "workspace:*",
    "@types/node": "26.5.0",
    "drizzle-kit": "0.31.10",
    "takumi-js": "2.13.7",
    "typescript": "6.0.3",
    "unocss": "66.10.0",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "packageManager": "pnpm@12.3.4"
}
