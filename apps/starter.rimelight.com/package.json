{
  "name": "starter-dot-rimelight-dot-com",
  "version": "0.0.0",
  "private": true,
  "description": "Rimelight Starter Template",
  "keywords": [
    "solid",
    "typescript"
  ],
  "homepage": "https://starter.rimelight.com",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "rimelight.com",
    "email": "contact@rimelight.com",
    "url": "https://rimelight.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "generate-types": "cf workers types",
    "check": "cf workers types && rimelight-i18n types --config vite.config.ts && vp check --fix",
    "dev": "vp dev",
    "prebuild": "pnpm -r --filter \"@rimelight/*\" run --if-present build",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "cf deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cf d1 migrations apply starter-dot-rimelight-dot-com --dir ./drizzle --local",
    "db:migrate:remote": "cf d1 migrations apply starter-dot-rimelight-dot-com --dir ./drizzle"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "@rimelight/auth": "workspace:*",
    "@rimelight/cms": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/security": "workspace:*",
    "@rimelight/seo": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "@solidjs/router": "2.0.0-next.44",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@solidjs/web": "2.0.0-rc.23",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "5.0.0-rc.1",
    "solid-js": "2.0.0-rc.23",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.20",
    "@iconify-json/lucide": "1.2.155",
    "@rimelight/config": "workspace:*",
    "cf": "1.0.0-rc.0",
    "drizzle-kit": "1.0.0-rc.5",
    "filesystem-routing": "0.5.0",
    "typescript": "7.1.0-beta",
    "unocss": "66.13.0"
  },
  "packageManager": "pnpm@12.21.0"
}
