{
  "name": "starter-dot-rimelight-dot-com",
  "version": "0.0.1",
  "private": true,
  "description": "Rimelight Starter Template",
  "homepage": "https://starter.rimelight.com",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "generate-types": "wrangler types",
    "astro": "astro",
    "dev": "astro dev",
    "dev:remote": "astro dev --remote",
    "build": "astro build",
    "preview": "astro preview",
    "migrate-docs": "tsx src/scripts/migrate-docs.ts",
    "check": "pnpm audit --audit-level=moderate && vp check --fix && wrangler types && astro sync && astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.1",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/solid-js": "7.0.2",
    "@nanostores/i18n": "1.3.3",
    "@neondatabase/serverless": "1.1.0",
    "@rimelight/auth": "workspace:*",
    "@rimelight/cms": "workspace:*",
    "@rimelight/docs": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/security": "workspace:*",
    "@rimelight/seo": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "astro": "7.2.1",
    "better-auth": "1.6.27",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "nanostores": "1.4.2",
    "solid-js": "1.9.14",
    "wrangler": "4.122.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/ts-plugin": "1.10.10",
    "@e18e/eslint-plugin": "0.8.0",
    "@iconify-json/logos": "1.2.12",
    "@iconify-json/lucide": "1.2.123",
    "@types/node": "26.2.0",
    "@unocss/eslint-plugin": "66.7.5",
    "drizzle-kit": "0.31.10",
    "eslint-plugin-regexp": "3.2.0",
    "takumi-js": "2.7.2",
    "typescript": "6.0.3",
    "unocss": "66.7.5",
    "vite-plus": "0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.7.0"
  }
}
