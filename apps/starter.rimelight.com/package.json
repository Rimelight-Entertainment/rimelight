{
  "name": "starter-dot-rimelight-dot-com",
  "version": "0.0.1",
  "private": true,
  "description": "Rimelight Starter Template",
  "keywords": [
    "solid",
    "typescript"
  ],
  "homepage": "https://starter.rimelight.com",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "generate-types": "cf workers types",
    "dev": "vp dev",
    "prebuild": "pnpm -r --parallel --filter \"@rimelight/*\" run --if-present build",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "vp build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cf d1 migrations apply starter-dot-rimelight-dot-com --dir ./drizzle --local",
    "db:migrate:remote": "cf d1 migrations apply starter-dot-rimelight-dot-com --dir ./drizzle",
    "check": "cf workers types && vp check --fix"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.62.4",
    "@rimelight/auth": "workspace:*",
    "@rimelight/cms": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/security": "workspace:*",
    "@rimelight/seo": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "@solidjs/router": "2.0.0-next.30",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@solidjs/web": "2.0.0-rc.11",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.12",
    "solid-js": "2.0.0-rc.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.15",
    "@iconify-json/lucide": "1.2.138",
    "@rimelight/config": "workspace:*",
    "cf": "1.0.0-beta.11",
    "drizzle-kit": "1.0.0-rc.4",
    "filesystem-routing": "0.4.0",
    "typescript": "7.0.2",
    "unocss": "66.10.5",
    "vite-plus": "1.0.0",
    "wrangler": "4.146.0"
  },
  "packageManager": "pnpm@12.8.1"
}
