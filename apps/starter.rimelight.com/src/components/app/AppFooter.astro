---
import RLAFooter from "@rimelight/ui/components/footer/RLAFooter.astro";
import RLALogo from "@rimelight/ui/components/logo/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import type { ButtonProps } from "@rimelight/ui/components/button/button.ts"
import type { LinkGroupProps } from "@rimelight/ui/components/link-group/link-group.ts";
import RLALinkGroup from "@rimelight/ui/components/link-group/RLALinkGroup.astro";
import RLAThemeSelector from "@rimelight/ui/components/theme-selector/RLAThemeSelector.astro";
import RLALocaleSelector from "@rimelight/ui/components/locale-selector/RLALocaleSelector.astro";
import { t, getRelativeLocaleUrl } from "@rimelight/i18n";

const footerGroups: LinkGroupProps[] = [
  {
    label: t("app_footer.links_resources_label"),
    links: [
      {
        label: t("app_footer.links_resources_branding"),
        href: getRelativeLocaleUrl("/branding")
      }
    ]
  },
  {
    label: t("app_footer.links_legal_label"),
    links: [
      {
        label: t("app_footer.links_legal_privacy-policy"),
        href: getRelativeLocaleUrl("/legal/privacy-policy")
      },
      {
        label: t("app_footer.links_legal_cookie-policy"),
        href: getRelativeLocaleUrl("/legal/cookie-policy")
      },
      {
        label: t("app_footer.links_legal_other-documents"),
        href: getRelativeLocaleUrl("/legal")
      }
    ]
  }
];

const socials: ButtonProps[] = [
  {
    leadingIcon: "i-logos-astro-icon?mask text-white group-hover:text-primary-500",
    href: "https://astro.build/"
  },
  {
    leadingIcon: "i-logos-github-icon?mask text-white group-hover:text-primary-500",
    href: "https://github.com/"
  }
];

const targetLanguages = [
  { code: 'en', label: 'English', href: getRelativeLocaleUrl('en', Astro.url.pathname.replace(/^\/[^/]+/, '') || '/') },
  { code: 'pt', label: "Português", href: getRelativeLocaleUrl('pt', Astro.url.pathname.replace(/^\/[^/]+/, '') || '/') },
];
---

<RLAFooter contain={false} class="rl-dark bg-black z-50">
  <div slot="left" class="flex flex-col gap-xl justify-between items-center lg:items-start">
    <div class="text-center lg:text-left text-white">
      Newsletter Signup
    </div>
    <div class="flex flex-col gap-2xs items-center lg:items-start">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="color"
      />
      <p class="text-sm text-center lg:text-left text-white">Rimelight Starter</p>
      <span class="text-sm text-center lg:text-left text-white">© {new Date().getFullYear()} Rimelight Entertainment</span>
    </div>
  </div>

  <div slot="center" class="flex flex-col md:flex-row gap-xl">
    {footerGroups.map(group => (
      <RLALinkGroup
        {...group}
      />
    ))}
  </div>

  <div slot="right" class="flex flex-col gap-xl justify-between items-center lg:items-end flex-1">
    <div class="flex flex-col gap-sm items-center lg:items-end">
      <RLAThemeSelector />
      <RLALocaleSelector locales={targetLanguages} currentLocale={Astro.currentLocale} />
    </div>

    <div class="flex flex-row flex-wrap gap-sm justify-center lg:justify-end items-center lg:items-end">
      {socials.map((social) => (
        <RLAButton size="xl" color="neutral" variant="ghost" {...social} />
      ))}
    </div>
  </div>
</RLAFooter>

<style is:global>
  footer[data-slot="root"]:not([data-contain="true"]) [data-slot="container"],
  header[data-slot="root"]:not([data-contain="true"]) [data-slot="container"] {
    padding-inline: var(--rla-grid-margin, 1.5rem);
  }
</style>
