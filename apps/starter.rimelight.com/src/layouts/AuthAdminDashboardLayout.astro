---
import DashboardLayout from "#layouts/DashboardLayout.astro";
import RLDashboardGroup from "@rimelight/ui/components/dashboard-group/RLDashboardGroup.tsx";
import RLDashboardSidebar from "@rimelight/ui/components/dashboard-sidebar/RLDashboardSidebar.tsx";
import RLDashboardNavbar from "@rimelight/ui/components/dashboard-navbar/RLDashboardNavbar.tsx";
import RLDashboardPanel from "@rimelight/ui/components/dashboard-panel/RLDashboardPanel.tsx";
import RLDashboardToolbar from "@rimelight/ui/components/dashboard-toolbar/RLDashboardToolbar.tsx";
import RLDashboardSidebarCollapse from "@rimelight/ui/components/dashboard-sidebar-collapse/RLDashboardSidebarCollapse.tsx";
import RLDashboardSidebarToggle from "@rimelight/ui/components/dashboard-sidebar-toggle/RLDashboardSidebarToggle.tsx";
import RLIcon from "@rimelight/ui/components/icon/RLIcon.tsx";

const navItems = [
	{ icon: "i-lucide-layout-dashboard", label: "Overview", href: "/admin", id: "overview" },
	{ icon: "i-lucide-folder", label: "Categories", href: "/admin/categories", id: "categories" },
	{ icon: "i-lucide-tag", label: "Tags", href: "/admin/tags", id: "tags" },
	{ icon: "i-lucide-pen-tool", label: "Bylines", href: "/admin/bylines", id: "bylines" },
	{ icon: "i-lucide-network", label: "Taxonomies", href: "/admin/taxonomies", id: "taxonomies" },
	{ icon: "i-lucide-file-text", label: "CMS Content", href: "/cms", id: "cms" },
];

interface Props {
	title: string;
	description: string;
	activeSection?: string;
	activeNav?: string;
}

const { title, description, activeSection, activeNav } = Astro.props;
const currentActive = activeNav || activeSection || "overview";
---

<DashboardLayout title={title} description={description} noindex={true}>
	<RLDashboardGroup>
		<RLDashboardSidebar side="left" collapsible>
			<Fragment slot="header">
				<div class="flex items-center gap-2.5">
					<div class="size-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary font-bold shrink-0">
						<RLIcon name="i-lucide-shield" class="size-5 text-primary group-data-[collapsed=true]:hidden" data-dashboard-sidebar-logo />
					</div>
					<div class="flex flex-col truncate group-data-[collapsed=true]:hidden" data-dashboard-sidebar-label>
						<span class="font-semibold text-highlighted text-sm leading-none">Identity Admin</span>
						<span class="text-xs text-muted mt-0.5">Cloudflare Access</span>
					</div>
				</div>
				<RLDashboardSidebarCollapse side="left" class="shrink-0 ml-auto group-data-[collapsed=true]:mx-auto" />
			</Fragment>

			<nav class="flex flex-col gap-1 mt-2" data-dashboard-nav-container>
				{navItems.map((item) => (
					<a
						href={item.href}
						data-dashboard-nav
						data-dashboard-section={item.id}
						class={
							"flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition-all group-data-[collapsed=true]:justify-center group-data-[collapsed=true]:px-0 " +
							(item.id === currentActive
								? "bg-primary/10 text-primary font-semibold"
								: "text-muted hover:text-highlighted hover:bg-muted/50")
						}
					>
						<RLIcon name={item.icon} class="size-5 shrink-0" />
						<span class="truncate flex-1 group-data-[collapsed=true]:hidden" data-dashboard-nav-label>{item.label}</span>
					</a>
				))}
			</nav>

			<Fragment slot="footer">
			</Fragment>
		</RLDashboardSidebar>

		<RLDashboardPanel>
			<RLDashboardNavbar slot="header" title={title} icon="i-lucide-shield">
				<Fragment slot="left">
					<div class="flex items-center gap-3">
						<RLDashboardSidebarToggle class="flex lg:hidden size-9 rounded-lg items-center justify-center border border-default hover:bg-muted text-toned hover:text-highlighted transition-colors shrink-0" />
						<RLDashboardSidebarCollapse side="left" class="hidden lg:flex size-9 rounded-lg" />
						<h1 class="text-xl font-semibold text-highlighted truncate" data-dashboard-navbar-title>{title}</h1>
					</div>
				</Fragment>
			</RLDashboardNavbar>

			<div slot="body" class="flex flex-col gap-4 flex-1">
				<RLDashboardToolbar>
					<Fragment slot="left">
						<p class="text-sm text-muted">{description}</p>
					</Fragment>
					<Fragment slot="right">
						<div class="flex items-center gap-2">
							<slot name="actions" />
						</div>
					</Fragment>
				</RLDashboardToolbar>

				<div class="flex-1 overflow-y-auto min-h-0 p-6">
					<slot />
				</div>
			</div>
		</RLDashboardPanel>
	</RLDashboardGroup>
</DashboardLayout>
