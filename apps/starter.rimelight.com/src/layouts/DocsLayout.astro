---
import AppLayout from "./AppLayout.astro";
import RLASidebar from "@rimelight/ui/components/sidebar/RLASidebar.astro";
import RLATableOfContents from "@rimelight/ui/components/table-of-contents/RLATableOfContents.astro";
import RLASurround from "@rimelight/ui/components/surround/RLASurround.astro";
import RLACopyMarkdown from "@rimelight/ui/components/copy-markdown/RLACopyMarkdown.astro";
import RLAShare from "@rimelight/ui/components/share/RLAShare.astro";
import RLABadge from "@rimelight/ui/components/badge/RLABadge.astro";
import RLAContainer from "@rimelight/ui/components/container/RLAContainer.astro";
import RLASelect from "@rimelight/ui/components/select/RLASelect.astro";
import RLAInput from "@rimelight/ui/components/input/RLAInput.astro";
import { getDocsSidebar, getSurroundItems } from "@rimelight/cms";
import type { ResolvedSidebarItem } from "@rimelight/cms";
import docsConfig from "#config/docs.config";
import type { TableOfContentsConfig } from "@rimelight/cms";
import { getLocale } from "@rimelight/i18n";

function normalizeBadge(badge: any) {
  if (!badge) return null
  if (typeof badge === "string") {
    return {
      text: badge,
      color: "primary",
      variant: "soft" as const,
      class: ""
    }
  }

  let color = badge.color || "primary"
  let variant = badge.variant || "soft"

  if (badge.variant) {
    const v = badge.variant.toLowerCase()
    if (v === "tip" || v === "success") {
      color = "success"
      variant = "soft"
    } else if (v === "caution" || v === "warning") {
      color = "warning"
      variant = "soft"
    } else if (v === "error") {
      color = "error"
      variant = "soft"
    } else if (v === "note") {
      color = "primary"
      variant = "soft"
    } else if (v === "default") {
      color = "primary"
      variant = "soft"
    }
  }

  return {
    text: badge.text || "",
    color,
    variant: variant as "solid" | "outline" | "soft",
    class: badge.class || ""
  }
}

interface Props {
  title: string;
  description?: string | undefined;
  headings?: { depth: number; slug: string; text: string }[];
  /** Per-page TOC override (from frontmatter) */
  tableOfContents?: false | TableOfContentsConfig | undefined;
  /** GitHub edit URL for this page (false = hide, string = full URL) */
  editUrl?: string | false | undefined;
  /** Override the prev/next surround navigation */
  prevOverride?: { label: string; href: string } | null | undefined;
  nextOverride?: { label: string; href: string } | null | undefined;
  rawMarkdown?: string | undefined;
  activeVersion?: string | undefined;
  versions?: string[] | undefined;
  includeVersionInUrl?: boolean | undefined;
}

const {
  title,
  description = "",
  headings = [],
  tableOfContents: tocOverride,
  editUrl,
  prevOverride = null,
  nextOverride = null,
  rawMarkdown,
  activeVersion,
  versions = [],
  includeVersionInUrl = false
} = Astro.props;

const locale = getLocale();
const currentPath = Astro.url.pathname;

const { items: sidebarItems, scopes, activeScope } = await getDocsSidebar(
  docsConfig,
  locale,
  currentPath,
  activeVersion,
  includeVersionInUrl
);
const surround = getSurroundItems(sidebarItems, currentPath);
const prev = prevOverride ?? surround.prev;
const next = nextOverride ?? surround.next;

// Resolve TOC config: per-page overrides site default
const globalToc = (docsConfig as import('@rimelight/cms').DocsConfig).tableOfContents ?? { minHeadingLevel: 2, maxHeadingLevel: 3 };
const resolvedToc = tocOverride !== undefined ? tocOverride : globalToc;

// Resolve edit URL: per-page > config base > disabled
const resolvedEditUrl = (() => {
  if (editUrl === false) return null;
  if (typeof editUrl === "string") return editUrl;
  if (docsConfig.editLink?.baseUrl) {
    const cleanPath = currentPath
      .replace(new RegExp(`^/${locale}/docs(/|$)`), "")
      .replace(new RegExp(`^/${locale}/company/docs(/|$)`), "")
      .replace(activeVersion ? new RegExp(`^${activeVersion}(/|$)`) : "", "")
      .replace(/\/$/, "");
    const normalizedSlug = cleanPath ? `${cleanPath}.md` : "index.md";
    const relPath = activeVersion
      ? `${activeVersion}/${locale}/${normalizedSlug}`
      : `${locale}/${normalizedSlug}`;
    return docsConfig.editLink.baseUrl.replace(/\/$/, "") + "/" + relPath;
  }
  return null;
})();

const hasToc = resolvedToc !== false && headings.length > 0;
const tocHeadings = hasToc
  ? headings.filter(h => {
      const cfg = resolvedToc as TableOfContentsConfig;
      return h.depth >= (cfg.minHeadingLevel ?? 2) && h.depth <= (cfg.maxHeadingLevel ?? 3);
    })
  : [];
const getVersionHomeUrl = (v: string) => {
  const isCompany = currentPath.includes("/company/docs");
  return isCompany ? `/${locale}/company/docs/${v}/` : `/${locale}/docs/${v}/`;
};
---

<AppLayout title={title} description={description}>
  <aside class="sr-only" data-ai-agent-directive>
    This page is available in Markdown format. Markdown is recommended for AI and agentic consumption.
    See <a href={`${currentPath.replace(/\/$/, '')}.md`}>{`${currentPath.replace(/\/$/, '')}.md`}</a> for this page, or <a href="/llms.txt">/llms.txt</a> for the full documentation and content index.
  </aside>

  {/*
    ── Sticky mobile bars ─────────────────────────────────────────────────────
    A single sticky container, pinned below the app header.
    Children are hidden at appropriate breakpoints via CSS, so when hidden
    they collapse to zero height — no JS, no stack interference.
    ──────────────────────────────────────────────────────────────────────────
  */}
  <div
    class="sticky z-30 bg-neutral-50/95 backdrop-blur-sm top-[var(--rl-total-header-height,64px)]"
  >
    {/* ── Docs nav bar: scopes + sidebar items — hidden on lg+ ── */}
    <details id="docs-nav-details" class="lg:hidden border-b border-default docs-mobile-bar">
      <summary class="flex items-center justify-between gap-3 px-4 h-10 text-sm font-medium text-highlighted cursor-pointer select-none hover:bg-muted/40 transition-colors list-none">
        <span class="flex items-center gap-2 min-w-0">
          <span class:list={[
            activeScope?.id === "tests" ? "i-lucide-terminal" : "i-lucide-book-open",
            "size-4 text-primary shrink-0"
          ]} />
          <span class="font-semibold shrink-0">{activeScope?.label ?? "Navigation"}</span>
          <span class="text-muted font-normal truncate hidden sm:inline">— {title}</span>
        </span>
        <span class="docs-nav-chevron i-lucide-chevron-down size-4 text-muted shrink-0 transition-transform duration-200" />
      </summary>
      <div class="border-t border-default/50 bg-neutral-50 max-h-[60vh] overflow-y-auto">
        {versions.length > 1 && (
          <div class="flex flex-col gap-1 p-3 border-b border-default/50">
            <span class="text-[10px] text-muted font-bold uppercase tracking-wider px-1 mb-1">Version</span>
            <rla-version-selector class="block w-full">
              <RLASelect
                items={versions.map(v => ({ label: v, value: getVersionHomeUrl(v) }))}
                value={getVersionHomeUrl(activeVersion || "")}
                size="sm"
              />
            </rla-version-selector>
          </div>
        )}
        {/* Filter input */}
        <div class="p-3 border-b border-default/50">
          <RLAInput
            type="text"
            placeholder="Filter navigation..."
            size="sm"
            leadingIcon="i-lucide-search"
            class="docs-sidebar-filter"
            autocomplete="off"
          />
        </div>
        {/* Scopes — vertical */}
        <div class="flex flex-col gap-1 p-3 border-b border-default/50">
          <span class="text-[10px] text-muted font-bold uppercase tracking-wider px-1 mb-1">Scopes</span>
          {scopes.map(scope => {
            const active = scope.active ?? false;
            return (
              <a
                href={scope.href}
                class:list={[
                  "flex items-center gap-2 px-3 py-2 text-xs font-semibold rounded-md transition-all duration-200 no-underline",
                  active
                    ? "bg-primary text-neutral-50 shadow-sm"
                    : "text-highlighted hover:bg-muted hover:text-primary"
                ]}
                data-docs-nav-link
              >
                <span class:list={[
                  scope.id === "overview" ? "i-lucide-book-open" : "i-lucide-terminal",
                  "size-3.5"
                ]} />
                {scope.label}
              </a>
            );
          })}
        </div>
        {/* Nav items — preserve groups */}
        <ul class="flex flex-col gap-0.5 p-3 docs-mobile-nav-list">
          {sidebarItems.map((item: ResolvedSidebarItem) => (
            <li data-nav-item>
              {item.children && item.children.length > 0 ? (
                <div>
                  <span class="block px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-muted mt-2 first:mt-0">
                    {item.label}
                  </span>
                  <ul class="flex flex-col gap-0.5 ml-2">
                    {item.children.map((child: ResolvedSidebarItem) => (
                      <li data-nav-item>
                        <a
                          href={child.href ?? "#"}
                          class:list={[
                            "flex items-center justify-between px-3 py-1.5 text-sm rounded-md transition-colors no-underline",
                            child.active
                              ? "bg-primary/10 text-primary font-medium"
                              : "text-highlighted hover:bg-muted"
                          ]}
                          data-docs-nav-link
                        >
                          <span class="truncate" data-item-text>{child.label}</span>
                          {(() => {
                            const b = normalizeBadge(child.badge);
                            return b && (
                              <RLABadge
                                variant={b.variant}
                                color={b.color}
                                size="xs"
                                class={"select-none " + b.class}
                              >
                                {b.text}
                              </RLABadge>
                            );
                          })()}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : (
                <a
                  href={item.href ?? "#"}
                  class:list={[
                    "flex items-center justify-between px-3 py-1.5 text-sm rounded-md transition-colors no-underline",
                    item.active
                      ? "bg-primary/10 text-primary font-medium"
                      : "text-highlighted hover:bg-muted"
                  ]}
                  data-docs-nav-link
                >
                  <span class="truncate" data-item-text>{item.label}</span>
                  {(() => {
                    const b = normalizeBadge(item.badge);
                    return b && (
                      <RLABadge
                        variant={b.variant}
                        color={b.color}
                        size="xs"
                        class={"select-none " + b.class}
                      >
                        {b.text}
                      </RLABadge>
                    );
                  })()}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </details>

    {/* ── TOC bar — hidden on xl+ ── */}
    {hasToc && (
      <details id="docs-toc-details" class="xl:hidden border-b border-default docs-mobile-bar">
        <summary class="flex items-center justify-between gap-3 px-4 h-10 text-sm font-medium text-highlighted cursor-pointer select-none hover:bg-muted/40 transition-colors list-none">
          <span class="flex items-center gap-2">
            <span class="i-lucide-list size-4 text-primary shrink-0" />
            <span>On this page</span>
          </span>
          <span class="docs-toc-chevron i-lucide-chevron-down size-4 text-muted shrink-0 transition-transform duration-200" />
        </summary>
        <div class="px-4 py-3 max-h-[50vh] overflow-y-auto border-t border-default/50 bg-neutral-50">
          <ul class="flex flex-col gap-0.5">
            {tocHeadings.map(heading => (
              <li class:list={[heading.depth === 3 && "pl-4"]}>
                <a
                  href={`#${heading.slug}`}
                  class:list={[
                    "toc-link block py-1.5 text-sm transition-colors hover:text-primary no-underline",
                    heading.depth === 2 ? "text-highlighted font-medium" : "text-muted"
                  ]}
                  data-toc-bar-link
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    )}
  </div>

  {/* ── Main docs layout ── */}
  <RLAContainer class="py-8 flex flex-col lg:flex-row gap-8 items-start relative min-h-[calc(100vh-200px)]">

    {/* Sidebar column — lg+ only */}
    <div class="docs-sidebar-wrapper hidden lg:block w-[280px] shrink-0 sticky top-[calc(var(--rl-total-header-height,64px)+2rem)] max-h-[calc(100vh-var(--rl-total-header-height,64px)-4rem)] overflow-y-auto border-r border-default pr-0">
      {versions.length > 1 && (
        <div class="mb-4 px-2">
          <label class="block text-[10px] text-muted font-bold uppercase tracking-wider mb-1.5 px-1">Version</label>
          <rla-version-selector class="block w-full">
            <RLASelect
              items={versions.map(v => ({ label: v, value: getVersionHomeUrl(v) }))}
              value={getVersionHomeUrl(activeVersion || "")}
              size="sm"
              ui={{
                root: "!w-full !block",
                trigger: "flex items-center justify-between !w-full bg-neutral-50 border border-default rounded-md px-3 py-1.5 text-sm font-medium text-highlighted",
                content: "!min-w-0 !w-full !bg-default !border-default !text-highlighted",
                item: "!text-highlighted hover:!bg-accented"
              }}
            />
          </rla-version-selector>
        </div>
      )}
      <div class="mb-4 px-2">
        <RLAInput
          type="text"
          placeholder="Filter navigation..."
          size="sm"
          leadingIcon="i-lucide-search"
          class="docs-sidebar-filter"
          autocomplete="off"
        />
      </div>
      <div class="flex flex-col gap-1 mb-4 border-b border-default pb-4 px-2">
        <span class="text-[10px] text-muted font-bold uppercase tracking-wider mb-1.5 px-1">Scopes</span>
        {scopes.map(scope => {
          const active = scope.active ?? false;
          return (
            <a
              href={scope.href}
              class:list={[
                "flex items-center gap-2 px-3 py-2 text-xs font-semibold rounded-md transition-all duration-200 no-underline",
                active
                  ? "bg-primary text-neutral-50 shadow-sm"
                  : "text-highlighted hover:bg-muted hover:text-primary"
              ]}
            >
              <span class:list={[
                scope.id === "overview" ? "i-lucide-book-open" : "i-lucide-terminal",
                "size-4"
              ]} />
              {scope.label}
            </a>
          );
        })}
      </div>
      <RLASidebar items={sidebarItems} collapsible="none" class="docs-nav-sidebar" />
    </div>

    {/* Main content */}
    <main class="docs-content flex-1 min-w-0 w-full py-2">
      <div class="border-b border-default pb-4 mb-6">
        <h1 class="text-3xl font-extrabold text-highlighted tracking-tight">{title}</h1>
        {description && <p class="mt-2 text-base text-muted">{description}</p>}
        <div class="flex gap-2 items-center justify-end my-4">
          {rawMarkdown && <RLACopyMarkdown raw={rawMarkdown} />}
          <RLAShare />
        </div>
      </div>
      <style is:global>
        [data-theme="dark"] .prose{--un-prose-body:var(--un-prose-invert-body);--un-prose-headings:var(--un-prose-invert-headings);--un-prose-lead:var(--un-prose-invert-lead);--un-prose-links:var(--un-prose-invert-links);--un-prose-bold:var(--un-prose-invert-bold);--un-prose-counters:var(--un-prose-invert-counters);--un-prose-bullets:var(--un-prose-invert-bullets);--un-prose-hr:var(--un-prose-invert-hr);--un-prose-quotes:var(--un-prose-invert-quotes);--un-prose-quote-borders:var(--un-prose-invert-quote-borders);--un-prose-captions:var(--un-prose-invert-captions);--un-prose-kbd:var(--un-prose-invert-kbd);--un-prose-kbd-shadows:var(--un-prose-invert-kbd-shadows);--un-prose-code:var(--un-prose-invert-code);--un-prose-pre-code:var(--un-prose-invert-pre-code);--un-prose-pre-bg:var(--un-prose-invert-pre-bg);--un-prose-th-borders:var(--un-prose-invert-th-borders);--un-prose-td-borders:var(--un-prose-invert-td-borders)}
      </style>
      <article class="markdown-content prose max-w-none prose-base">
        <slot />
      </article>
      <RLASurround prev={prev ?? null} next={next ?? null} />

      {/* Edit link */}
      {resolvedEditUrl && (
        <div class="mt-6 pt-4 border-t border-default">
          <a
            href={resolvedEditUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-muted hover:text-primary transition-colors no-underline"
          >
            <span class="i-lucide-pencil size-3" />
            Edit this page on GitHub
          </a>
        </div>
      )}
    </main>

    {/* TOC right column — xl+ only */}
    {hasToc && (
      <div class="hidden xl:block w-[240px] shrink-0 sticky top-[calc(var(--rl-total-header-height,64px)+2rem)] max-h-[calc(100vh-var(--rl-total-header-height,64px)-4rem)] overflow-y-auto pl-4">
        <RLATableOfContents headings={headings} tableOfContents={resolvedToc as any} />
      </div>
    )}

  </RLAContainer>
</AppLayout>

<script>
  function initDocsBars() {
    const pairs = [
      { detailsId: 'docs-nav-details', chevronClass: '.docs-nav-chevron', linkAttr: '[data-docs-nav-link]' },
      { detailsId: 'docs-toc-details', chevronClass: '.docs-toc-chevron', linkAttr: '[data-toc-bar-link]' },
    ];

    for (const { detailsId, chevronClass, linkAttr } of pairs) {
      const details = document.getElementById(detailsId) as HTMLDetailsElement | null;
      if (!details) continue;
      const chevron = details.querySelector(chevronClass) as HTMLElement | null;

      details.addEventListener('toggle', () => {
        if (chevron) {
          if (details.open) {
            chevron.classList.add('rotate-180');
          } else {
            chevron.classList.remove('rotate-180');
          }
        }
      });
      details.querySelectorAll(linkAttr).forEach(link => {
        link.addEventListener('click', () => { details.open = false; });
      });
    }

    // Initialize sidebar search filter
    const filterInputs = document.querySelectorAll('.docs-sidebar-filter input');
    filterInputs.forEach(input => {
      const el = input as HTMLInputElement;
      el.addEventListener('input', () => {
        const query = el.value.toLowerCase().trim();
        const container = el.closest('#docs-nav-details') || el.closest('.docs-sidebar-wrapper');
        if (!container) return;

        // RLASidebar items (desktop / component rendered)
        const sidebar = container.querySelector('.docs-nav-sidebar');
        if (sidebar) {
          const items = sidebar.querySelectorAll('[data-slot="item"]');
          items.forEach(item => {
            if (!query) {
              (item as HTMLElement).style.display = '';
              const details = item.querySelector('details');
              if (details) details.open = details.hasAttribute('data-default-open');
              return;
            }

            const allText = item.textContent?.toLowerCase() || '';
            const matches = allText.includes(query);

            (item as HTMLElement).style.display = matches ? '' : 'none';

            if (matches) {
              const details = item.querySelector('details');
              if (details) details.open = true;
            }
          });
        }

        // Mobile list items (if rendered without RLASidebar component)
        const mobileList = container.querySelector('.docs-mobile-nav-list');
        if (mobileList) {
          const listItems = mobileList.querySelectorAll('[data-nav-item]');
          listItems.forEach(item => {
            if (!query) {
              (item as HTMLElement).style.display = '';
              return;
            }
            const allText = item.textContent?.toLowerCase() || '';
            const matches = allText.includes(query);
            (item as HTMLElement).style.display = matches ? '' : 'none';
          });
        }
      });
    });
  }

  initDocsBars();
  document.addEventListener('astro:after-swap', initDocsBars);

  class RLAVersionSelector extends HTMLElement {
    private onchangeHandler = (event: Event) => {
      const target = event.target as HTMLSelectElement | HTMLInputElement;
      if (!target || !target.value) return;
      // Path A: native <select class="rla-select-native"> — always visible, this is what the user interacts with
      // Path B: hidden input updated by the custom rla-select element
      const isNativeSelect = target.tagName === 'SELECT' && target.classList.contains('rl-select');
      const isHiddenInput = target.hasAttribute('data-select-hidden-input');
      if (isNativeSelect || isHiddenInput) {
        window.location.href = target.value;
      }
    };

    connectedCallback() {
      // Delegate on `this` — change bubbles from both the native <select> and
      // the hidden input, so we catch either render path of RLASelect.
      this.addEventListener('change', this.onchangeHandler);
    }

    disconnectedCallback() {
      this.removeEventListener('change', this.onchangeHandler);
    }
  }
  if (!customElements.get('rla-version-selector')) {
    customElements.define('rla-version-selector', RLAVersionSelector);
  }
</script>

<style is:global>
  /* ── Docs sidebar: flush, full-width, no chrome ── */
  .docs-nav-sidebar {
    width: 100% !important;
    height: auto !important;
    background: transparent !important;
    box-shadow: none !important;
    border: none !important;
  }
  .docs-nav-sidebar [data-slot="header"] { display: none !important; }
  .docs-nav-sidebar [data-slot="footer"] { display: none !important; }
  .docs-nav-sidebar [data-slot="content"] { padding-top: 0 !important; }
</style>
