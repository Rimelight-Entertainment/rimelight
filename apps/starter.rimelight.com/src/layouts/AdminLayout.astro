---
import { createSecurityHead } from "@rimelight/security/head";
import { createSeoHead } from "@rimelight/seo/head";
import { createUiHead } from "@rimelight/ui/head";
import AppHeader from '#components/app/AppHeader.astro';
import RLBanner from "@rimelight/ui/components/banner/RLBanner.tsx";
import RLMain from "@rimelight/ui/components/main/RLMain.tsx";
import AppFooter from '#components/app/AppFooter.astro';
import RLScrollToTop from "@rimelight/ui/components/scroll-to-top/RLScrollToTop.tsx";
import RLShortcuts from "@rimelight/ui/components/shortcuts/RLShortcuts.tsx";
import RLLayoutGrid from "@rimelight/ui/components/layout-grid/RLLayoutGrid.tsx";
import RLToaster from "@rimelight/ui/components/toaster/RLToaster.tsx";
import RLToast from "@rimelight/ui/components/toast/RLToast.tsx";
import RLButton from "@rimelight/ui/components/button/RLButton.tsx";
import { siteConfig } from "virtual:rimelight/seo";
import { Font } from 'astro:assets';
import { currentLocale, t, getRelativeLocaleUrl } from '@rimelight/i18n';

interface AdminLayoutProps {
	title: string;
	description: string;
	noindex?: boolean;
	is404?: boolean;
	robots?: string;
	languageAlternates?: Array<{ hreflang: string; href: string }>;
	ogImageSrc?: string;
	ogImageAlt?: string;
}

const { title, description, noindex = true, is404, robots, languageAlternates, ogImageSrc, ogImageAlt } = Astro.props as AdminLayoutProps;

const activeLocale = currentLocale.get() || 'en';

const localeMap: Record<string, string> = {
	en: 'en_US',
	pt: 'pt_BR',
	es: 'es_ES',
};
const ogLocale = localeMap[activeLocale] || 'en_US';

const hasConsent = Astro.cookies.has("cookie-consent");

const seo = createSeoHead({
  title,
  description,
  config: siteConfig,
  ogLocale,
  rssFeed: { href: '/rss.xml', title: siteConfig.name },
  noindex,
  is404,
  robots,
  languageAlternates,
  ogImage: ogImageSrc ? { src: ogImageSrc, alt: ogImageAlt || '' } : undefined,
  url: Astro.url.href,
  canonical: Astro.url.href
});
const security = createSecurityHead();
const ui = createUiHead();
---

<!doctype html>
<html lang={activeLocale}>
  <head>
    <Fragment set:html={seo.html} />
    <Fragment set:html={security.html} />
    <Fragment set:html={ui.html} />
    <Font cssVariable="--font-sans" preload={true} />
    <Font cssVariable="--font-serif" preload={true} />
    <Font cssVariable="--font-mono" preload={true} />
    <slot name="head" />
  </head>
	<body class="isolate">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-neutral-50 focus:text-highlighted">
			{t("app_layout.skipToContent")}
		</a>

		<div id="dashboard-header-wrapper">
			<RLBanner
				contain={false}
				dismissable
				dismissId="v2-announcement"
				class="bg-primary text-neutral-50 font-medium"
				actions={[
					{ label: "Learn more", href: "/docs", variant: "solid" },
					{ label: "What's new", href: "/changelog", variant: "outline" }
				]}
			>
				New: Rimelight v2 is out
			</RLBanner>
			<AppHeader />
		</div>

		<RLMain id="main-content" class="dashboard-viewport-area flex flex-col min-w-0">
			<slot />
		</RLMain>

		<AppFooter />

		<RLScrollToTop client:idle showProgress={true} />
		<RLShortcuts client:load />
		<RLLayoutGrid />
		<RLToaster client:load />

		{!hasConsent && (
			<div id="cookie-notice-container" class="fixed bottom-4 right-4 left-4 sm:left-auto sm:max-w-md z-50 pointer-events-none transition-all duration-300">
				<RLToast title={t("cookie_notice.title")} dismissable={false} class="pointer-events-auto shadow-2xl border-default bg-neutral-50/95 backdrop-blur-sm">
					<span slot="description">
						{t("cookie_notice.description_prefix")}
						<a href={getRelativeLocaleUrl('/legal/cookie-policy')} class="underline hover:text-primary transition-colors font-medium">{t("cookie_notice.cookie_policy_label")}</a>
						{t("cookie_notice.description_suffix")}
					</span>
					<Fragment slot="actions">
						<RLButton id="cookie-allow" variant="solid" color="success" size="sm">
							{t("cookie_notice.allow_all")}
						</RLButton>
						<RLButton id="cookie-deny" variant="solid" color="error" size="sm">
							{t("cookie_notice.deny_all")}
						</RLButton>
					</Fragment>
				</RLToast>
			</div>
		)}

		<script>
			function initCookieNotice() {
				const container = document.getElementById("cookie-notice-container");
				if (!container) return;

				const allowBtn = container.querySelector("#cookie-allow");
				const denyBtn = container.querySelector("#cookie-deny");

				const setCookieAndDismiss = (consentValue: string) => {
					const maxAge = 365 * 24 * 60 * 60;
					document.cookie = `cookie-consent=${consentValue}; path=/; max-age=${maxAge}; SameSite=Lax`;

					container.classList.add("opacity-0", "translate-y-4");
					container.addEventListener("transitionend", () => {
						container.remove();
					}, { once: true });
				};

				allowBtn?.addEventListener("click", () => setCookieAndDismiss("allowed"));
				denyBtn?.addEventListener("click", () => setCookieAndDismiss("denied"));
			}

			initCookieNotice();
			document.addEventListener("astro:after-swap", initCookieNotice);
		</script>
	</body>
</html>

<style is:global>
	html, body {
		margin: 0;
		padding: 0;
	}

.dashboard-viewport-area {
		box-sizing: border-box;
		padding-top: var(--rl-total-header-height, 4rem) !important;
		margin-top: 0 !important;
		height: 100vh !important;
		min-height: 100vh !important;
		max-height: 100vh !important;
		overflow: hidden;
		transform: translate(0);
	}

html, body {
	margin: 0;
	padding: 0;
	height: 100%;
}
</style>
