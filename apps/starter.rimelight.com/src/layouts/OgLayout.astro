---
import { createSeoHead } from "@rimelight/seo";
import { createSecurityHead } from "@rimelight/security";
import { createUiHead } from "@rimelight/ui";
import { siteConfig } from "virtual:rimelight/seo";
import { Font } from 'astro:assets';

interface OgLayoutProps {
  title: string;
  description: string;
}

const { title, description } = Astro.props as OgLayoutProps;

const seo = createSeoHead({
  title,
  description,
  config: siteConfig,
  noindex: true,
  url: Astro.url.href,
  canonical: Astro.url.href
});
const security = createSecurityHead();
const ui = createUiHead();
---

<!doctype html>
<html lang="en">
  <head>
    <Fragment set:html={seo.html} />
    <Fragment set:html={security.html} />
    <Fragment set:html={ui.html} />
    <Font cssVariable="--font-sans" preload={true} />
    <Font cssVariable="--font-serif" preload={true} />
    <Font cssVariable="--font-mono" preload={true} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
