---
import SecurityHead from "@rimelight/security/components/SecurityHead.astro";
import SEOHead from "@rimelight/seo/components/SEOHead.astro";
import UIHead from "@rimelight/ui/components/head/UIHead.astro";
import { siteConfig } from '#config/site.config';
import { Font } from 'astro:assets';

interface OgLayoutProps {
  title: string;
  description: string;
}

const { title, description } = Astro.props as OgLayoutProps;
---

<!doctype html>
<html lang="en">
  <head>
    <SecurityHead />
    <SEOHead title={title} description={description} config={siteConfig} noindex={true} />
    <UIHead />
    <Font cssVariable="--font-sans" preload={true} />
    <Font cssVariable="--font-serif" preload={true} />
    <Font cssVariable="--font-mono" preload={true} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
