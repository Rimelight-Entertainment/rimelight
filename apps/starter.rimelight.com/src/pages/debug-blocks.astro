---
import { db } from "@/db/index.ts"
import { pages } from "@/db/schema/index.ts"
import { eq, and, isNull } from "drizzle-orm"

const indexPage = await db
  .select()
  .from(pages)
  .where(and(eq(pages.type, "doc"), eq(pages.slug, "index"), isNull(pages.deletedAt)))
  .limit(1)

const page = indexPage[0]
const content = typeof page.content === "string" ? JSON.parse(page.content) : page.content
const blocks = content.blocks || []
const firstBlock = blocks[0]
const firstParagraphText = firstBlock?.props?.text
---

<html>
<head>
  <title>Debug Blocks</title>
</head>
<body>
  <h1>Block Debug</h1>
  <h2>First Block Type: {firstBlock?.type}</h2>
  <h2>First Block Props:</h2>
  <pre>{JSON.stringify(firstBlock?.props, null, 2)}</pre>
  <h2>First Block Text Structure:</h2>
  <pre>{JSON.stringify(firstParagraphText, null, 2)}</pre>
  <h2>First Block Is Array: {Array.isArray(firstParagraphText)}</h2>
  <h2>All Blocks Count: {blocks.length}</h2>
  <h2>All Blocks:</h2>
  <pre>{JSON.stringify(blocks.slice(0, 3), null, 2)}</pre>
</body>
</html>