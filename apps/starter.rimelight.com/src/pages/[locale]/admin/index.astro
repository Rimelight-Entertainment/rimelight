---
import AuthAdminDashboardLayout from "#layouts/AuthAdminDashboardLayout.astro";
import RLCard from "@rimelight/ui/components/card/RLCard.tsx";
import RLBadge from "@rimelight/ui/components/badge/RLBadge.tsx";
import RLButton from "@rimelight/ui/components/button/RLButton.tsx";
import RLIcon from "@rimelight/ui/components/icon/RLIcon.tsx";
import { db } from "#db";
import { pages, bylines, taxonomyTerms as categories, taxonomyTerms as tags } from "#db/schema";
import { count } from "drizzle-orm";

let totalPages = 0;
let totalBylines = 0;
let totalCategories = 0;
let totalTags = 0;

try {
	const [pRes] = await db.select({ count: count() }).from(pages);
	totalPages = pRes?.count ?? 0;
} catch {}

try {
	const [bRes] = await db.select({ count: count() }).from(bylines);
	totalBylines = bRes?.count ?? 0;
} catch {}

try {
	const [cRes] = await db.select({ count: count() }).from(categories);
	totalCategories = cRes?.count ?? 0;
} catch {}

try {
	const [tRes] = await db.select({ count: count() }).from(tags);
	totalTags = tRes?.count ?? 0;
} catch {}
---

<AuthAdminDashboardLayout
	title="Content Administration"
	description="Manage CMS content, author bylines, hierarchical categories, and taxonomies."
	activeSection="overview"
>
	<Fragment slot="actions">
		<a href="/cms/pages/new">
			<RLButton variant="solid" color="primary" leadingIcon="i-lucide-file-plus" size="sm">
				New Page
			</RLButton>
		</a>
		<a href="/cms">
			<RLButton variant="outline" color="neutral" leadingIcon="i-lucide-layout-dashboard" size="sm">
				Open CMS Dashboard
			</RLButton>
		</a>
	</Fragment>

	<div class="flex flex-col gap-6">
		<!-- Top Metrics Grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
			<!-- Total Pages -->
			<RLCard class="p-5 flex flex-col justify-between gap-4 border-default hover:border-primary/40 transition-colors shadow-sm">
				<div class="flex items-center justify-between">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted">Pages</span>
					<div class="p-2 rounded-lg bg-primary/10 text-primary">
						<RLIcon name="i-lucide-file-text" class="size-5" />
					</div>
				</div>
				<div class="flex items-baseline justify-between">
					<span class="text-3xl font-bold text-highlighted">{totalPages}</span>
					<a href="/cms/pages" class="text-xs text-primary hover:underline font-medium">Manage Pages &rarr;</a>
				</div>
			</RLCard>

			<!-- Categories -->
			<RLCard class="p-5 flex flex-col justify-between gap-4 border-default hover:border-success/40 transition-colors shadow-sm">
				<div class="flex items-center justify-between">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted">Categories</span>
					<div class="p-2 rounded-lg bg-success/10 text-success">
						<RLIcon name="i-lucide-folder" class="size-5" />
					</div>
				</div>
				<div class="flex items-baseline justify-between">
					<span class="text-3xl font-bold text-highlighted">{totalCategories}</span>
					<a href="/admin/categories" class="text-xs text-success hover:underline font-medium">Manage Categories &rarr;</a>
				</div>
			</RLCard>

			<!-- Tags -->
			<RLCard class="p-5 flex flex-col justify-between gap-4 border-default hover:border-warning/40 transition-colors shadow-sm">
				<div class="flex items-center justify-between">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted">Tags</span>
					<div class="p-2 rounded-lg bg-warning/10 text-warning">
						<RLIcon name="i-lucide-tag" class="size-5" />
					</div>
				</div>
				<div class="flex items-baseline justify-between">
					<span class="text-3xl font-bold text-highlighted">{totalTags}</span>
					<a href="/admin/tags" class="text-xs text-warning hover:underline font-medium">Manage Tags &rarr;</a>
				</div>
			</RLCard>

			<!-- Bylines -->
			<RLCard class="p-5 flex flex-col justify-between gap-4 border-default hover:border-purple-500/40 transition-colors shadow-sm">
				<div class="flex items-center justify-between">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted">Author Bylines</span>
					<div class="p-2 rounded-lg bg-purple-500/10 text-purple-500">
						<RLIcon name="i-lucide-pen-tool" class="size-5" />
					</div>
				</div>
				<div class="flex items-baseline justify-between">
					<span class="text-3xl font-bold text-highlighted">{totalBylines}</span>
					<a href="/admin/bylines" class="text-xs text-purple-500 hover:underline font-medium">Manage Bylines &rarr;</a>
				</div>
			</RLCard>
		</div>

		<!-- Quick Workflows & System Info Cards -->
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<!-- Quick Actions -->
			<RLCard class="p-6 flex flex-col gap-4 border-default lg:col-span-2 shadow-sm">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-2">
						<RLIcon name="i-lucide-zap" class="size-5 text-primary" />
						<h2 class="text-base font-semibold text-highlighted">CMS Quick Actions</h2>
					</div>
					<span class="text-xs text-muted">Protected by Cloudflare Access</span>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-1">
					<a href="/cms/pages/new" class="group p-4 rounded-xl border border-default/80 bg-muted/20 hover:bg-muted/60 hover:border-primary/30 transition-all">
						<div class="flex items-center gap-3">
							<div class="p-2.5 rounded-lg bg-primary/10 text-primary group-hover:scale-105 transition-transform">
								<RLIcon name="i-lucide-file-plus" class="size-5" />
							</div>
							<div>
								<h3 class="text-sm font-semibold text-highlighted group-hover:text-primary transition-colors">Create Page</h3>
								<p class="text-xs text-muted mt-0.5">Author new content with visual block editor</p>
							</div>
						</div>
					</a>

					<a href="/admin/categories" class="group p-4 rounded-xl border border-default/80 bg-muted/20 hover:bg-muted/60 hover:border-primary/30 transition-all">
						<div class="flex items-center gap-3">
							<div class="p-2.5 rounded-lg bg-emerald-500/10 text-emerald-500 group-hover:scale-105 transition-transform">
								<RLIcon name="i-lucide-folder-tree" class="size-5" />
							</div>
							<div>
								<h3 class="text-sm font-semibold text-highlighted group-hover:text-primary transition-colors">Manage Categories</h3>
								<p class="text-xs text-muted mt-0.5">Organize hierarchical topics and navigation</p>
							</div>
						</div>
					</a>

					<a href="/admin/tags" class="group p-4 rounded-xl border border-default/80 bg-muted/20 hover:bg-muted/60 hover:border-primary/30 transition-all">
						<div class="flex items-center gap-3">
							<div class="p-2.5 rounded-lg bg-amber-500/10 text-amber-500 group-hover:scale-105 transition-transform">
								<RLIcon name="i-lucide-tag" class="size-5" />
							</div>
							<div>
								<h3 class="text-sm font-semibold text-highlighted group-hover:text-primary transition-colors">Content Tags</h3>
								<p class="text-xs text-muted mt-0.5">Manage cross-cutting taxonomies</p>
							</div>
						</div>
					</a>

					<a href="/admin/bylines" class="group p-4 rounded-xl border border-default/80 bg-muted/20 hover:bg-muted/60 hover:border-primary/30 transition-all">
						<div class="flex items-center gap-3">
							<div class="p-2.5 rounded-lg bg-purple-500/10 text-purple-500 group-hover:scale-105 transition-transform">
								<RLIcon name="i-lucide-pen-tool" class="size-5" />
							</div>
							<div>
								<h3 class="text-sm font-semibold text-highlighted group-hover:text-primary transition-colors">Author Bylines</h3>
								<p class="text-xs text-muted mt-0.5">Author attribution & contributor profiles</p>
							</div>
						</div>
					</a>
				</div>
			</RLCard>

			<!-- Security Identity Card -->
			<RLCard class="p-6 flex flex-col gap-4 border-default shadow-sm">
				<div class="flex items-center justify-between">
					<div class="flex items-center gap-2">
						<RLIcon name="i-lucide-shield-check" class="size-5 text-primary" />
						<h2 class="text-base font-semibold text-highlighted">Edge Identity</h2>
					</div>
					<RLBadge variant="subtle" color="success" class="text-xs">
						Active
					</RLBadge>
				</div>
				<div class="flex flex-col gap-3 mt-1 text-sm text-muted">
					<p>
						Authentication and role gating are managed at the edge via Cloudflare Access Zero Trust.
					</p>
					<p>
						Access permissions and user directory are managed directly in your Cloudflare Zero Trust dashboard.
					</p>
					<div class="p-3 rounded-lg bg-muted/30 border border-default/40 flex flex-col gap-1 text-xs">
						<span class="font-medium text-highlighted">Zero Database Auth</span>
						<span class="text-muted">No database user tables or local passwords required.</span>
					</div>
				</div>
			</RLCard>
		</div>
	</div>
</AuthAdminDashboardLayout>



