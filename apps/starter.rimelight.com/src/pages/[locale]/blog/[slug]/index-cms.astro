---
import AppLayout from '@/layouts/AppLayout.astro';
import { siteConfig } from '@/config/site.config';
import PageRenderer from "@rimelight/cms/astro/PageRenderer.astro"
import { auth } from "@/auth/auth"
import { db } from "@/db"
import { pages } from "@/db/schema"
import { eq } from "drizzle-orm"

const slug = Astro.params.slug || ""
const activeLocale = Astro.currentLocale ?? "en"

const session = await auth.api.getSession({ headers: Astro.request.headers })
const currentUser = session?.user

// Fetch from CMS
const page = await db.select().from(pages).where(eq(pages.slug, slug)).limit(1)

if (!page[0]) {
  return Astro.redirect('/404')
}

const content = typeof page[0].content === "string" ? JSON.parse(page[0].content) : page[0].content

const title = typeof page[0].title === 'string' ? page[0].title : page[0].title?.[activeLocale] || page[0].title?.en || page[0].title
const description = content.properties?.description || siteConfig.description
---

<AppLayout title={title} description={description}>
  <article class="prose prose-lg max-w-none">
    {currentUser ? (
      <PageRenderer 
        blocks={content.blocks || []} 
        session={{
          userId: currentUser.id,
          roles: [(currentUser as any).role || "user"],
          permissions: []
        }} 
        locale={activeLocale}
      />
    ) : (
      <PageRenderer 
        blocks={content.blocks || []} 
        locale={activeLocale}
      />
    )}
  </article>
</AppLayout>
