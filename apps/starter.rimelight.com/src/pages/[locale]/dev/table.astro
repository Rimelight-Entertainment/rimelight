---
import AppLayout from "#layouts/AppLayout.astro"
import RLATable from "@rimelight/ui/components/table/RLATable.astro"
import type { TableColumn, TableRow } from "@rimelight/ui/components/table/table"
import { badgeTheme } from "@rimelight/ui/components/badge/badge.theme"
import { checkboxTheme } from "@rimelight/ui/components/checkbox/checkbox.theme"
import { dropdownMenuTheme } from "@rimelight/ui/components/dropdown-menu/dropdown-menu.theme"
import TableShowcase from "../../../components/TableShowcase.tsx"
import {
  SHOWCASE_PAYMENTS_DATA,
  formatShowcaseDate,
  formatShowcaseCurrency,
  type PaymentItem
} from "../../../components/showcase-table-data.ts"

const checkboxClasses = checkboxTheme({ color: "primary", size: "md" })
const dropdownClasses = dropdownMenuTheme({ size: "xs" })

const astroColumns: TableColumn<PaymentItem>[] = [
  {
    id: "select",
    size: 44,
    enableSorting: false,
    enableHiding: false,
    header: () => `<label class="${checkboxClasses.root}" data-slot="root">
      <input type="checkbox" class="${checkboxClasses.input}" data-rla-select-all data-slot="input" />
      <div class="${checkboxClasses.box}" data-slot="box">
        <span class="${checkboxClasses.indicator}" data-slot="indicator">
          <span class="i-lucide-check size-3 text-white"></span>
        </span>
      </div>
    </label>`,
    cell: ({ row }: { row: TableRow<PaymentItem> }) => `<label class="${checkboxClasses.root}" data-slot="root">
      <input type="checkbox" class="${checkboxClasses.input}" data-row-checkbox="${row.id}" data-slot="input" />
      <div class="${checkboxClasses.box}" data-slot="box">
        <span class="${checkboxClasses.indicator}" data-slot="indicator">
          <span class="i-lucide-check size-3 text-white"></span>
        </span>
      </div>
    </label>`
  },
  {
    accessorKey: "id",
    header: "Payment ID",
    size: 140,
    cell: ({ row }: { row: TableRow<PaymentItem> }) => {
      const hasChildren = row.original.children && row.original.children.length > 0
      const chevron = hasChildren
        ? `<button type="button" class="size-5 rounded border border-default flex items-center justify-center text-muted hover:text-highlighted bg-muted/20" data-row-expand="${row.id}">
            <span class="size-3 i-lucide-chevron-right transition-transform"></span>
          </button>`
        : ""
      return `<div class="flex items-center gap-2">
        ${chevron}
        <span class="font-mono text-xs font-bold text-highlighted">${row.getValue("id")}</span>
      </div>`
    }
  },
  {
    accessorKey: "category",
    header: "Category",
    size: 140,
    cell: ({ row }: { row: TableRow<PaymentItem> }) => `<span class="text-xs text-toned font-medium">${row.getValue("category")}</span>`
  },
  {
    accessorKey: "date",
    header: "Date",
    size: 150,
    cell: ({ row }: { row: TableRow<PaymentItem> }) => `<span class="font-mono text-xs text-muted">${formatShowcaseDate(row.getValue("date"))}</span>`
  },
  {
    accessorKey: "email",
    header: "Customer Email",
    size: 220,
    cell: ({ row }: { row: TableRow<PaymentItem> }) => `<span class="text-xs text-toned truncate block max-w-[200px]" title="${row.getValue("email")}">${row.getValue("email")}</span>`
  },
  {
    accessorKey: "status",
    header: "Status",
    size: 110,
    cell: ({ row }: { row: TableRow<PaymentItem> }) => {
      const st = row.getValue("status")
      const color = st === "paid" ? "success" : st === "failed" ? "error" : "neutral"
      const badgeClasses = badgeTheme({
        variant: "subtle",
        color: color as any,
        size: "xs",
        shape: "pill",
        class: "capitalize"
      })
      return `<span class="${badgeClasses.root}" data-slot="root">${st}</span>`
    }
  },
  {
    accessorKey: "amount",
    header: "Amount",
    size: 130,
    meta: {
      class: {
        th: "text-right",
        td: "text-right font-mono font-bold text-highlighted"
      }
    },
    cell: ({ row }: { row: TableRow<PaymentItem> }) => formatShowcaseCurrency(Number(row.getValue("amount"))),
    footer: () => {
      const total = SHOWCASE_PAYMENTS_DATA.reduce((acc, r) => acc + (Number(r.amount) || 0), 0)
      return `<span class="font-mono font-bold text-xs text-highlighted block text-right">Total: ${formatShowcaseCurrency(total)}</span>`
    }
  },
  {
    id: "actions",
    header: "Actions",
    size: 90,
    enableSorting: false,
    enableHiding: false,
    meta: {
      class: {
        th: "text-center",
        td: "text-center"
      }
    },
    cell: ({ row }: { row: TableRow<PaymentItem> }) => `<div class="${dropdownClasses.root}" data-astro-actions="${row.id}">
      <button type="button" class="${dropdownClasses.trigger}" data-astro-action-trigger>
        <span class="i-lucide-ellipsis-vertical size-4"></span>
      </button>
      <div class="fixed hidden z-[9999] min-w-36 rounded-md border border-default bg-elevated p-1 text-highlighted shadow-md flex flex-col gap-0.5 text-xs text-left" data-astro-action-menu>
        <button type="button" class="${dropdownClasses.item}" onclick="alert('Payment ${row.id}: $${row.getValue('amount')}')">
          <span class="${dropdownClasses.itemLeadingIcon} i-lucide-info"></span>
          <span class="${dropdownClasses.itemLabel}">Payment Details</span>
        </button>
        <button type="button" class="${dropdownClasses.item}" data-astro-action-expand="${row.id}">
          <span class="${dropdownClasses.itemLeadingIcon} i-lucide-chevron-down"></span>
          <span class="${dropdownClasses.itemLabel}">Toggle Expand</span>
        </button>
        <div class="${dropdownClasses.separator}"></div>
        <button type="button" class="${dropdownClasses.item} text-destructive hover:bg-destructive/10" onclick="alert('Delete ${row.id}')">
          <span class="${dropdownClasses.itemLeadingIcon} i-lucide-trash text-destructive"></span>
          <span class="${dropdownClasses.itemLabel}">Delete Payment</span>
        </button>
      </div>
    </div>`
  }
]
---

<AppLayout title="Native Table Component Showcase" description="Testing RLATable (Astro SSR) and RLSTable (SolidJS reactive)">
  <main class="container mx-auto px-4 py-10 flex flex-col gap-10">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-highlighted">Table Components Showcase</h1>
      <p class="text-sm text-muted mt-1">
        Testing both native SolidJS (<code class="text-primary font-mono">RLSTable.tsx</code>) and Astro (<code class="text-primary font-mono">RLATable.astro</code>) implementations with zero TanStack dependencies.
      </p>
    </div>

    <!-- Section 1: SolidJS Full-Feature Matrix -->
    <section class="flex flex-col gap-4">
      <div class="flex items-center gap-2">
        <span class="size-2.5 rounded-full bg-emerald-500"></span>
        <h2 class="text-xl font-bold text-highlighted">SolidJS Reactive Table (<code class="text-xs font-mono">RLSTable</code>)</h2>
      </div>
      <p class="text-xs text-muted">
        Includes sorting (shift+click for multi-sort), global live search, column visibility toggling, row selection, expandable sub-row inspector, category grouping, pinned columns, and custom action dropdowns.
      </p>
      
      <TableShowcase client:load />
    </section>

    <!-- Section 2: Astro SSR Native Table (Identical Dataset & Layout) -->
    <section class="flex flex-col gap-4 pt-8 border-t border-default">
      <div class="flex items-center gap-2">
        <span class="size-2.5 rounded-full bg-blue-500"></span>
        <h2 class="text-xl font-bold text-highlighted">Astro SSR Native Table (<code class="text-xs font-mono">RLATable</code>)</h2>
      </div>
      <p class="text-xs text-muted">
        Server-side rendered identical dataset with native custom element (<code class="font-mono">&lt;rla-table&gt;</code>) client enhancement for instant DOM sorting within category groups, live filtering, and column visibility.
      </p>

      <RLATable
        data={SHOWCASE_PAYMENTS_DATA}
        columns={astroColumns}
        striped
        hoverable
        searchable
        showColumnsToggle
        grouping={["category"]}
        columnPinning={{ left: ["select", "id"], right: ["actions"] }}
        pagination={{ pageIndex: 0, pageSize: 6 }}
        getSubRows={(row) => row.children}
      />
    </section>
  </main>
</AppLayout>

<script>
  // Astro Actions Popover interactive script
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement
    const trigger = target.closest<HTMLButtonElement>("[data-astro-action-trigger]")
    const allMenus = document.querySelectorAll<HTMLElement>("[data-astro-action-menu]")

    if (trigger) {
      e.stopPropagation()
      const wrapper = trigger.closest("[data-astro-actions]")
      const rowId = wrapper?.getAttribute("data-astro-actions") || ""
      const menu = wrapper?.querySelector<HTMLElement>("[data-astro-action-menu]")
        || document.querySelector<HTMLElement>(`[data-astro-action-menu][data-menu-for="${rowId}"]`)
      if (!menu) return

      const isHidden = menu.classList.contains("hidden")
      allMenus.forEach((m) => m.classList.add("hidden"))

      if (isHidden) {
        menu.setAttribute("data-menu-for", rowId)
        if (menu.parentElement !== document.body) {
          document.body.appendChild(menu)
        }
        const rect = trigger.getBoundingClientRect()
        menu.style.position = "fixed"
        menu.style.zIndex = "99999"
        menu.style.top = `${rect.bottom + 4}px`
        menu.style.right = `${window.innerWidth - rect.right}px`
        menu.style.left = "auto"
        menu.classList.remove("hidden")
      }
    } else {
      allMenus.forEach((m) => m.classList.add("hidden"))
    }
  })

  // Close menus on scroll/resize
  window.addEventListener("scroll", () => {
    document.querySelectorAll<HTMLElement>("[data-astro-action-menu]").forEach((m) => m.classList.add("hidden"))
  }, true)
  window.addEventListener("resize", () => {
    document.querySelectorAll<HTMLElement>("[data-astro-action-menu]").forEach((m) => m.classList.add("hidden"))
  })

  // Checkbox select all handling for Astro table
  document.addEventListener("change", (e) => {
    const target = e.target as HTMLInputElement
    if (target.matches("[data-rla-select-all]")) {
      const isChecked = target.checked
      document.querySelectorAll<HTMLInputElement>("[data-row-checkbox]").forEach((cb) => {
        cb.checked = isChecked
      })
    }
  })
</script>
