---
import OgLayout from '#layouts/OgLayout.astro';
const title = Astro.url.searchParams.get("title") || "Untitled";
const description = Astro.url.searchParams.get("description") || "";
const isPreview = Astro.url.searchParams.get("preview") === "1";
---

<OgLayout title={title + " — Rimelight"} description={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap"
    rel="stylesheet"
  />
  <style>
    .og-frame { width: 1200px; height: 630px; font-family:'Noto Sans',system-ui,sans-serif; background:linear-gradient(135deg,#0a0a0a 0%,#1a1a2e 100%); color:#e5e5e5; }
    .og-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .og-title { font-size: 52px; }
    .og-desc { font-size: 22px; }
    .og-badge { background:rgba(96,165,250,0.15); border:1px solid rgba(96,165,250,0.3); color:#93c5fd; }
  </style>

  <div class="og-frame flex flex-col p-14 relative overflow-hidden">
    <div class="flex items-center gap-3">
      <img class="h-9 w-auto" src="https://cdn.rimelight.com/logos/logomark_white.svg" alt="" />
      <img class="h-[22px] w-auto" src="https://cdn.rimelight.com/logos/logotype_white.svg" alt="Rimelight" />
    </div>
    <div class="flex-1 flex flex-col justify-center pt-5">
      <div class="w-[60px] h-1 bg-[#60a5fa] rounded mb-4"></div>
      <h1 class="og-title font-bold leading-[1.15] text-white max-w-[950px] og-clamp-2">{title}</h1>
      {description && <p class="og-desc font-normal leading-[1.4] text-[#94a3b8] mt-3 max-w-[800px] og-clamp-2">{description}</p>}
    </div>
    <div class="flex items-center gap-3 mt-auto">
      <span class="og-badge inline-block px-4 py-[6px] rounded-full text-sm font-semibold">Documentation</span>
    </div>
    {isPreview && (
      <>
        <div class="absolute inset-0 border-[6px] border-dashed border-[#ff4444] pointer-events-none"></div>
        <div class="absolute top-3 right-3 bg-[#ff4444] text-white text-sm font-bold px-4 py-[6px] rounded tracking-[0.05em]">PREVIEW</div>
      </>
    )}
  </div>
</OgLayout>
