---
import OgLayout from '#layouts/OgLayout.astro';
const title = Astro.url.searchParams.get("title") || "Untitled";
const description = Astro.url.searchParams.get("description") || "";
const type = Astro.url.searchParams.get("type") || "";
const displayType = type ? type.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ") : "Blog Post";
const date = Astro.url.searchParams.get("date") || "";
const isPreview = Astro.url.searchParams.get("preview") === "1";
---

<OgLayout title={title + " — Rimelight"} description={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap"
    rel="stylesheet"
  />
  <style>
    .og-frame { width: 1200px; height: 630px; }
    .og-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .og-frame { font-family: 'Noto Sans', system-ui, sans-serif; }
    .og-title { font-size: 56px; }
    .og-desc { font-size: 24px; }
    .og-date { font-size: 16px; }
  </style>

  <div class="og-frame flex flex-col p-14 relative overflow-hidden bg-[#0a0a0a] text-[#e5e5e5]">
    <div class="flex items-center gap-3">
      <img class="h-9 w-auto" src="https://cdn.rimelight.com/logos/logomark_white.svg" alt="" />
      <img class="h-[22px] w-auto" src="https://cdn.rimelight.com/logos/logotype_white.svg" alt="Rimelight" />
    </div>
    <div class="flex-1 flex flex-col justify-center pt-6">
      <h1 class="og-title font-bold leading-[1.15] text-white max-w-[950px] og-clamp-2">{title}</h1>
      {description && <p class="og-desc font-normal leading-[1.4] text-[#a0a0a0] mt-4 max-w-[850px] og-clamp-2">{description}</p>}
    </div>
    <div class="flex items-center justify-between mt-auto">
      {displayType && <span class="inline-block px-5 py-2 rounded-full border border-[#333] text-[#e5e5e5] og-date font-semibold">{displayType}</span>}
      {date && <span class="og-date text-[#666]">{date}</span>}
    </div>
    {isPreview && (
      <>
        <div class="absolute inset-0 border-[6px] border-dashed border-[#ff4444] pointer-events-none"></div>
        <div class="absolute top-3 right-3 bg-[#ff4444] text-white og-date font-bold px-4 py-[6px] rounded tracking-[0.05em]">PREVIEW</div>
      </>
    )}
  </div>
</OgLayout>
