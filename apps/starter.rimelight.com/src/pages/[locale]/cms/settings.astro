---
import { auth } from "@/auth/auth"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLAInput from "@rimelight/ui/components/input/RLAInput.astro"
import RLABadge from "@rimelight/ui/components/badge/RLABadge.astro"
import { db } from "@/db"
import { role } from "@/db/schema"
import { isNull, desc } from "drizzle-orm"
import { getSiteSettings } from "@rimelight/cms"

const session = await auth.api.getSession({ headers: Astro.request.headers })

if (!session) {
  return Astro.redirect("/auth/sign-in")
}

const settings = await getSiteSettings(db)

const dbRoles = await db.select().from(role).where(isNull(role.deletedAt)).orderBy(desc(role.createdAt))
const defaultRoles = [
  { name: "admin", displayName: "Administrator", description: "Full system & CMS access", permissions: ["cms:read", "cms:write", "cms:publish", "cms:delete", "templates:create", "templates:edit", "roles:manage"] },
  { name: "editor", displayName: "Editor", description: "Can create and publish pages", permissions: ["cms:read", "cms:write", "cms:publish", "templates:read"] },
  { name: "author", displayName: "Author", description: "Can create and edit drafts", permissions: ["cms:read", "cms:write"] },
  { name: "reviewer", displayName: "Reviewer", description: "Can review & approve versions", permissions: ["cms:read", "cms:approve"] },
  { name: "viewer", displayName: "Viewer", description: "Read-only access", permissions: ["cms:read"] }
]

const rolesList = (dbRoles.length > 0 ? dbRoles : defaultRoles).map((r) =>
  Object.assign({}, r, {
    permissionsList: typeof r.permissions === "string" ? JSON.parse(r.permissions) : (r.permissions || [])
  })
)
---

<CMSDashboardLayout title="Settings" description="CMS Settings" activeSection="settings">
  <Fragment slot="toolbar-right">
    <button
      id="save-settings-btn"
      type="button"
      class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors shadow-sm cursor-pointer disabled:opacity-50"
    >
      <span id="btn-text">Save Settings</span>
    </button>
  </Fragment>

  <form id="settings-form" class="max-w-3xl mx-auto space-y-8 pb-12">
    <!-- General Site Identity -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-semibold text-gray-900">Site Identity & Metadata</h2>
          <p class="text-sm text-gray-500 mt-1">Dynamic database-backed site configuration</p>
        </div>
        <RLABadge variant="soft" color="blue" size="sm">Dynamic DB</RLABadge>
      </div>

      <div class="space-y-4">
        <div>
          <label for="setting-name" class="block text-sm font-medium text-gray-700 mb-1">Site Name</label>
          <input
            id="setting-name"
            name="name"
            type="text"
            value={settings.name}
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
          />
        </div>

        <div>
          <label for="setting-description" class="block text-sm font-medium text-gray-700 mb-1">Site Description</label>
          <textarea
            id="setting-description"
            name="description"
            rows="3"
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
          >{settings.description}</textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="setting-url" class="block text-sm font-medium text-gray-700 mb-1">Site URL</label>
            <input
              id="setting-url"
              name="url"
              type="url"
              value={settings.url}
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            />
          </div>
          <div>
            <label for="setting-author" class="block text-sm font-medium text-gray-700 mb-1">Author / Organization</label>
            <input
              id="setting-author"
              name="author"
              type="text"
              value={settings.author}
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            />
          </div>
        </div>

        <div>
          <label for="setting-email" class="block text-sm font-medium text-gray-700 mb-1">Contact Email</label>
          <input
            id="setting-email"
            name="email"
            type="email"
            value={settings.email}
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
          />
        </div>
      </div>
    </div>

    <!-- Branding & Theme -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold mb-6 text-gray-900">Branding & Assets</h2>
      <div class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="setting-logo-alt" class="block text-sm font-medium text-gray-700 mb-1">Logo Alt Text</label>
            <input
              id="setting-logo-alt"
              name="branding_logo_alt"
              type="text"
              value={settings.branding?.logo?.alt || ""}
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            />
          </div>
          <div>
            <label for="setting-favicon-svg" class="block text-sm font-medium text-gray-700 mb-1">Favicon Path</label>
            <input
              id="setting-favicon-svg"
              name="branding_favicon_svg"
              type="text"
              value={settings.branding?.favicon?.svg || "/favicon.svg"}
              class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="setting-theme-color" class="block text-sm font-medium text-gray-700 mb-1">Theme Color</label>
            <div class="flex items-center gap-2">
              <input
                id="setting-theme-color"
                name="branding_theme_color"
                type="text"
                value={settings.branding?.colors?.themeColor || "#ffffff"}
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm font-mono"
              />
            </div>
          </div>
          <div>
            <label for="setting-bg-color" class="block text-sm font-medium text-gray-700 mb-1">Background Color</label>
            <div class="flex items-center gap-2">
              <input
                id="setting-bg-color"
                name="branding_bg_color"
                type="text"
                value={settings.branding?.colors?.backgroundColor || "#ffffff"}
                class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm font-mono"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SEO Defaults -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-xl font-semibold mb-6 text-gray-900">SEO & Social Sharing</h2>
      <div class="space-y-4">
        <div>
          <label for="setting-title-template" class="block text-sm font-medium text-gray-700 mb-1">Title Template</label>
          <input
            id="setting-title-template"
            name="seo_title_template"
            type="text"
            value={settings.seo?.titleTemplate || "%s | " + settings.name}
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
          />
        </div>

        <div>
          <label for="setting-og-image" class="block text-sm font-medium text-gray-700 mb-1">OpenGraph Image Fallback URL</label>
          <input
            id="setting-og-image"
            name="og_image"
            type="text"
            value={settings.ogImage || settings.seo?.ogImageFallback || ""}
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
          />
        </div>

        <div>
          <label for="setting-max-desc" class="block text-sm font-medium text-gray-700 mb-1">Max Description Length (chars)</label>
          <input
            id="setting-max-desc"
            name="seo_max_description_length"
            type="number"
            value={settings.seo?.maxDescriptionLength || 160}
            class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm"
          />
        </div>
      </div>
    </div>

    <!-- Roles & Permissions Section -->
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-semibold text-gray-900">Roles & Permissions</h2>
          <p class="text-sm text-gray-500 mt-1">Database-backed auth roles and their permissions matrix</p>
        </div>
        <RLABadge variant="soft" color="blue" size="sm">Auth System DB</RLABadge>
      </div>

      <div class="space-y-4">
        {rolesList.map((r) => (
          <div class="p-4 border border-gray-200 rounded-lg space-y-2">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="font-semibold text-gray-900">{r.displayName || r.name}</span>
                <span class="text-xs px-2 py-0.5 bg-gray-100 font-mono text-gray-600 rounded">{r.name}</span>
              </div>
            </div>
            <p class="text-sm text-gray-600">{r.description}</p>
            <div class="flex flex-wrap gap-1.5 pt-1">
              {r.permissionsList.map((perm: string) => (
                <span class="text-xs px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 rounded font-mono">{perm}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </form>

  <script>
    const saveBtn = document.getElementById("save-settings-btn")
    const btnText = document.getElementById("btn-text")

    saveBtn?.addEventListener("click", async () => {
      const name = (document.getElementById("setting-name") as HTMLInputElement)?.value || ""
      const description = (document.getElementById("setting-description") as HTMLTextAreaElement)?.value || ""
      const url = (document.getElementById("setting-url") as HTMLInputElement)?.value || ""
      const author = (document.getElementById("setting-author") as HTMLInputElement)?.value || ""
      const email = (document.getElementById("setting-email") as HTMLInputElement)?.value || ""
      const ogImage = (document.getElementById("setting-og-image") as HTMLInputElement)?.value || ""

      const logoAlt = (document.getElementById("setting-logo-alt") as HTMLInputElement)?.value || ""
      const faviconSvg = (document.getElementById("setting-favicon-svg") as HTMLInputElement)?.value || ""
      const themeColor = (document.getElementById("setting-theme-color") as HTMLInputElement)?.value || ""
      const bgColor = (document.getElementById("setting-bg-color") as HTMLInputElement)?.value || ""

      const titleTemplate = (document.getElementById("setting-title-template") as HTMLInputElement)?.value || ""
      const maxDescLength = parseInt((document.getElementById("setting-max-desc") as HTMLInputElement)?.value || "160", 10)

      const payload = {
        name,
        description,
        url,
        author,
        email,
        ogImage,
        branding: {
          logo: { alt: logoAlt },
          favicon: { svg: faviconSvg },
          colors: {
            themeColor,
            backgroundColor: bgColor
          }
        },
        seo: {
          titleTemplate,
          ogImageFallback: ogImage,
          maxDescriptionLength: maxDescLength
        }
      }

      if (saveBtn) (saveBtn as HTMLButtonElement).disabled = true
      if (btnText) btnText.textContent = "Saving..."

      try {
        const res = await fetch("/api/cms/settings", {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        })

        if (!res.ok) {
          const err = await res.json()
          alert(err.error || "Failed to save settings")
        } else {
          if (btnText) btnText.textContent = "Saved!"
          setTimeout(() => {
            if (btnText) btnText.textContent = "Save Settings"
          }, 2000)
        }
      } catch (err: any) {
        alert(err.message || "Failed to save settings")
      } finally {
        if (saveBtn) (saveBtn as HTMLButtonElement).disabled = false
      }
    })
  </script>
</CMSDashboardLayout>