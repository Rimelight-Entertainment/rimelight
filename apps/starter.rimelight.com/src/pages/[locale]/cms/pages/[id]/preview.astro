---
import { auth } from "@/auth/auth"
import PageRenderer from "@rimelight/cms/astro/PageRenderer.astro"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import { db } from "@/db"
import { pages, pageDrafts } from "@/db/schema"
import { eq } from "drizzle-orm"
import { getRelativeLocaleUrl } from "@rimelight/i18n"
import { verifyPreviewToken } from "@rimelight/cms"

const currentLocale = Astro.currentLocale ?? "en"
const session = await auth.api.getSession({ headers: Astro.request.headers })
const id = Astro.params.id

if (!id) {
  return Astro.redirect(getRelativeLocaleUrl(currentLocale, "/cms/pages"))
}

const token = Astro.url.searchParams.get("token")
const secret = process.env.BETTER_AUTH_SECRET || "rimelight-preview-secret-key"
const isValidToken = token ? await verifyPreviewToken(id, token, secret) : false

// Must be authenticated OR have a valid signed guest preview token
if (!session && !isValidToken) {
  return Astro.redirect(getRelativeLocaleUrl(currentLocale, "/auth/sign-in"))
}

const page = await db.select().from(pages).where(eq(pages.id, id)).limit(1)
if (!page[0]) return Astro.redirect(getRelativeLocaleUrl(currentLocale, "/cms/pages"))

const draft = await db.select().from(pageDrafts).where(eq(pageDrafts.pageId, id)).limit(1)

const parseContent = (c: any) => (typeof c === "string" ? JSON.parse(c) : c)
const content = draft[0]?.content ? parseContent(draft[0].content) : parseContent(page[0].content)
const userSession = session
  ? {
      userId: session.user.id,
      roles: [session.user.role || "user"],
      permissions: []
    }
  : undefined

const titleVal =
  typeof page[0].title === "object" && page[0].title !== null
    ? (page[0].title as Record<string, string>)[currentLocale] || (page[0].title as Record<string, string>).en || ""
    : String(page[0].title || "")
---

{session ? (
  <CMSDashboardLayout title={`Preview: ${titleVal}`} description="Preview CMS page" activeSection="pages">
    <Fragment slot="toolbar-right">
      <div class="flex items-center gap-2">
        <button
          id="share-preview-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-blue-700 bg-blue-50 border border-blue-200 rounded-md hover:bg-blue-100 transition-colors cursor-pointer"
        >
          <span class="i-lucide-share-2 size-3.5"></span>
          <span id="share-btn-text">Share Preview Link</span>
        </button>

        <RLAButton href={getRelativeLocaleUrl(currentLocale, `/cms/pages/${id}/edit`)} variant="outline" color="neutral" size="sm" leadingIcon="i-lucide-arrow-left">
          Back to Editor
        </RLAButton>
      </div>
    </Fragment>

    <div class="max-w-4xl mx-auto space-y-6">
      <div class="bg-blue-50 border border-blue-200 p-4 rounded-lg flex items-center justify-between">
        <p class="text-sm text-blue-800 font-medium">Live Preview Mode — displaying current draft</p>
        <span class="text-xs px-2.5 py-0.5 bg-blue-200 text-blue-900 rounded-full font-mono">Draft</span>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-6">{titleVal}</h1>
        <PageRenderer 
          blocks={content.blocks || []} 
          session={userSession} 
          locale={currentLocale}
          class="prose prose-lg max-w-none"
        />
      </div>
    </div>

    <script is:inline define:vars={{ pageId: id }}>
      const shareBtn = document.getElementById("share-preview-btn")
      const shareText = document.getElementById("share-btn-text")

      shareBtn?.addEventListener("click", async () => {
        if (shareText) shareText.textContent = "Generating..."
        try {
          const res = await fetch(`/api/cms/pages/${pageId}/preview-token`, { method: "POST" })
          if (!res.ok) throw new Error("Failed to generate token")
          const data = await res.json()
          const fullUrl = `${window.location.origin}${data.previewUrl}`
          await navigator.clipboard.writeText(fullUrl)
          if (shareText) shareText.textContent = "Copied to Clipboard!"
          setTimeout(() => {
            if (shareText) shareText.textContent = "Share Preview Link"
          }, 3000)
        } catch (e) {
          alert("Could not generate preview link")
          if (shareText) shareText.textContent = "Share Preview Link"
        }
      })
    </script>
  </CMSDashboardLayout>
) : (
  <div class="bg-neutral-50 text-neutral-900 min-h-screen">
    <div class="sticky top-0 z-50 bg-amber-500 text-white px-4 py-2.5 shadow-md flex items-center justify-between text-sm">
      <div class="flex items-center gap-2">
        <span class="font-bold">🔒 Guest Preview Mode</span>
        <span class="opacity-90">• Viewing unpublished draft via secure signed link</span>
      </div>
      <span class="text-xs bg-amber-600 px-2 py-0.5 rounded font-mono">Expires in 7 days</span>
    </div>

    <main class="max-w-4xl mx-auto px-4 py-12">
      <article class="bg-white rounded-2xl shadow-sm border border-neutral-200 p-8 md:p-12">
        <h1 class="text-4xl font-extrabold text-neutral-900 tracking-tight mb-8">{titleVal}</h1>
        <PageRenderer 
          blocks={content.blocks || []} 
          locale={currentLocale}
          class="prose prose-lg max-w-none"
        />
      </article>
    </main>
  </div>
)}
