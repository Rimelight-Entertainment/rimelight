---
import { auth } from "@/auth/auth"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLABadge from "@rimelight/ui/components/badge/RLABadge.astro"
import { db } from "@/db"
import { pages, pageDrafts } from "@/db/schema"
import { eq } from "drizzle-orm"
import { RimelightEditorLayout } from "@rimelight/cms/client/components/RimelightEditorLayout"
import { RimelightPropertiesPanel } from "@rimelight/cms/client/components/RimelightPropertiesPanel"
import "@rimelight/cms/client/styles/cms-editor.css"

const session = await auth.api.getSession({ headers: Astro.request.headers })
const id = Astro.params.id

if (!session) {
  return Astro.redirect("/auth/sign-in")
}

const page = await db.select().from(pages).where(eq(pages.id, id!)).limit(1)
if (!page[0]) return Astro.redirect('/cms/pages')

const draft = await db.select().from(pageDrafts).where(eq(pageDrafts.pageId, id!)).limit(1)

let rawContent: any = draft[0]?.content || page[0]?.content || {}
if (typeof rawContent === 'string') {
  try { rawContent = JSON.parse(rawContent) } catch {}
}
if (rawContent && rawContent.content) {
  rawContent = rawContent.content
}

const extractedBlocks = Array.isArray(rawContent?.blocks)
  ? rawContent.blocks
  : (Array.isArray(rawContent) ? rawContent : [])

const titleVal = typeof page[0].title === 'object' ? page[0].title.en || '' : page[0].title || ''

const pageType = (page[0] as any).type || 'Default'
const initialProperties = rawContent?.properties || {}
---

<CMSDashboardLayout title={`Edit Page: ${titleVal}`} description="Edit CMS page" activeSection="pages">
  <Fragment slot="toolbar-left">
    <RLAButton id="undo-btn" size="sm" square leadingIcon="i-lucide-undo" />
    <RLAButton id="redo-btn" size="sm" square leadingIcon="i-lucide-redo" />
    <RLAButton id="add-block-btn" size="sm" square leadingIcon="i-lucide-plus" />
  </Fragment>

  <Fragment slot="toolbar-right">
    <RLAButton id="preview-btn" size="sm" square leadingIcon="i-lucide-eye" />
    <RLAButton id="save-btn" size="sm" square leadingIcon="i-lucide-save" />
    <RLABadge id="save-status-indicator" variant="soft" color="emerald" size="xs">
      ● Saved
    </RLABadge>
    <RLAButton id="publish-btn" size="sm" square leadingIcon="i-lucide-upload-cloud" />
    <RLAButton id="more-actions-btn" size="sm" square leadingIcon="i-lucide-more-vertical" />
  </Fragment>

  <div class="cms-editor-with-panel w-full h-[calc(100vh-180px)] min-h-[600px] flex flex-row overflow-hidden">
    <div id="cms-editor-layout" class="cms-editor-main flex-1 min-w-0 flex flex-col overflow-hidden">
      <RimelightEditorLayout client:only="solid" pageId={id} initialBlocks={extractedBlocks} />
    </div>
    <RimelightPropertiesPanel client:only="solid" pageType={pageType} initialProperties={initialProperties} class="flex-none w-72" />
  </div>

  <script>
    import "@rimelight/cms/client/styles/cms-editor.css";

    const getLayout = () => (window as any).cmsEditorLayout || (document.getElementById('cms-editor-layout') as any);

    const updatePreviewIcon = (visible: boolean) => {
      const btn = document.getElementById('preview-btn');
      if (!btn) return;
      const icon = btn.querySelector('.i-lucide-eye, .i-lucide-eye-off');
      if (icon) {
        if (visible) {
          icon.classList.remove('i-lucide-eye');
          icon.classList.add('i-lucide-eye-off');
        } else {
          icon.classList.remove('i-lucide-eye-off');
          icon.classList.add('i-lucide-eye');
        }
      }
    };

    document.getElementById('preview-btn')?.addEventListener('click', () => {
      const isVisible = getLayout()?.togglePreview?.();
      updatePreviewIcon(!!isVisible);
    });

    document.getElementById('undo-btn')?.addEventListener('click', () => {
      getLayout()?.undo?.();
    });

    document.getElementById('redo-btn')?.addEventListener('click', () => {
      getLayout()?.redo?.();
    });

    document.getElementById('add-block-btn')?.addEventListener('click', () => {
      getLayout()?.addBlock?.('ParagraphBlock');
    });

    document.getElementById('save-btn')?.addEventListener('click', () => {
      getLayout()?.saveDraft?.();
    });

    document.addEventListener('status-change', (e: Event) => {
      if (e instanceof CustomEvent && e.detail?.status) {
        const status = e.detail.status;
        const indicator = document.getElementById('save-status-indicator');
        if (indicator) {
          indicator.textContent = status === 'saved' ? '● Saved' : status === 'unsaved' ? '▲ Unsaved' : status === 'saving' ? '↻ Saving...' : '✖ Save Failed';
          indicator.className = `inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold select-none ${
            status === 'saved' ? 'bg-emerald-950/40 text-emerald-400 border border-emerald-800/50' :
            status === 'unsaved' ? 'bg-amber-950/40 text-amber-400 border border-amber-800/50' :
            status === 'saving' ? 'bg-blue-950/40 text-blue-400 border border-blue-800/50' :
            'bg-red-950/40 text-red-400 border border-red-800/50'
          }`;
        }
      }
    });

    document.addEventListener('preview-toggle', (e: Event) => {
      if (e instanceof CustomEvent && typeof e.detail?.visible === 'boolean') {
        updatePreviewIcon(e.detail.visible);
      }
    });

    document.getElementById('cms-properties-panel')?.addEventListener('properties-change', (e: Event) => {
      if (e instanceof CustomEvent && e.detail?.properties) {
        (window as any).cmsPageProperties = e.detail.properties;
      }
    });

    document.getElementById('publish-btn')?.addEventListener('click', async () => {
      const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement | null;
      const layout = getLayout();
      if (!layout) { alert('Editor not loaded'); return; }
      
      const pageId = layout.getAttribute('page-id');
      const blocks = layout.getBlocks ? await layout.getBlocks() : [];
      const content = { blocks, properties: {} };
      
      try {
        if (publishBtn) publishBtn.disabled = true;
        const response = await fetch(`/api/cms/pages/${pageId}/publish`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, changeSummary: 'Published from editor' })
        });
        if (response.ok) {
          try { localStorage.removeItem('cms_draft_backup_' + pageId); } catch {}
          alert('Page published successfully!');
          window.location.href = '/cms/pages';
        } else {
          const errorData = (await response.json().catch(() => ({}))) as { error?: string };
          alert(`Failed to publish page: ${errorData.error || 'Unknown error'}`);
        }
      } catch (error) {
        alert('Error publishing page: Network error');
      } finally {
        if (publishBtn) publishBtn.disabled = false;
      }
    });
  </script>
</CMSDashboardLayout>
