{
  "name": "rimelight-dot-com",
  "version": "0.0.1",
  "private": true,
  "description": "Rimelight Entertainment's Website",
  "keywords": [
    "solid",
    "typescript"
  ],
  "homepage": "https://rimelight.com",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "generate-types": "cf workers types",
    "dev": "vp dev",
    "prebuild": "pnpm -r --parallel --filter \"@rimelight/*\" run --if-present build",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "vp build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "check": "cf workers types && vp check --fix"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@neondatabase/serverless": "1.1.0",
    "@rimelight/auth": "workspace:*",
    "@rimelight/cms": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/security": "workspace:*",
    "@rimelight/seo": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.30",
    "@solidjs/signals": "2.0.0-rc.11",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@solidjs/web": "2.0.0-rc.11",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.10",
    "solid-js": "2.0.0-rc.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.14",
    "@iconify-json/lucide": "1.2.137",
    "@rimelight/config": "workspace:*",
    "@types/node": "26.6.3",
    "cf": "1.0.0-beta.2",
    "drizzle-kit": "0.31.11",
    "filesystem-routing": "0.4.0",
    "typescript": "7.0.2",
    "unocss": "66.10.5",
    "vite-plus": "1.0.0",
    "wrangler": "4.145.0"
  },
  "engines": {
    "node": ">=26.6.0"
  },
  "packageManager": "pnpm@12.8.1"
}
