{
  "name": "rimelight-dot-com",
  "version": "0.0.4",
  "private": true,
  "description": "Rimelight Entertainment's Website",
  "homepage": "https://rimelight.com",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx",
      "./src/*/index.astro"
    ]
  },
  "scripts": {
    "prepare": "vp config",
    "generate-types": "wrangler types",
    "astro": "astro",
    "dev": "astro dev",
    "prebuild": "pnpm -r --parallel --filter \"@rimelight/*\" --filter \"!@rimelight/config\" run --if-present build",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "profile": "astro build && wrangler check startup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "check": "wrangler types && vp check --fix && astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@astrojs/solid-js": "7.0.2",
    "@neondatabase/serverless": "1.1.0",
    "@rimelight/auth": "workspace:*",
    "@rimelight/cms": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/security": "workspace:*",
    "@rimelight/seo": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "astro": "7.3.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.8",
    "solid-js": "1.9.15",
    "wrangler": "4.135.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@iconify-json/logos": "1.2.14",
    "@iconify-json/lucide": "1.2.134",
    "@rimelight/config": "workspace:*",
    "@types/node": "26.6.1",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vite-plus": "0.3.3"
  },
  "engines": {
    "node": ">=26.8.2"
  },
  "packageManager": "pnpm@12.4.2"
}
