{
  "name": "rimelight-dot-com",
  "version": "0.0.0",
  "private": true,
  "description": "Rimelight Entertainment's Website",
  "keywords": [
    "solid",
    "typescript"
  ],
  "homepage": "https://rimelight.com",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "type": "module",
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "generate-types": "cf workers types",
    "dev": "vp dev",
    "prebuild": "pnpm -r --filter \"@rimelight/*\" run --if-present build",
    "build": "vp build",
    "preview": "vp preview",
    "deploy": "cf deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "check": "cf workers types && vp check --fix"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@neondatabase/serverless": "1.2.0",
    "@rimelight/auth": "workspace:*",
    "@rimelight/cms": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/security": "workspace:*",
    "@rimelight/seo": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "@solidjs/router": "2.0.0-next.40",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@solidjs/web": "2.0.0-rc.15",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "5.0.0-rc.1",
    "solid-js": "2.0.0-rc.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*",
    "cf": "1.0.0-beta.18",
    "drizzle-kit": "1.0.0-rc.4",
    "filesystem-routing": "0.4.0",
    "typescript": "7.0.2",
    "unocss": "66.11.0",
    "vite-plus": "1.3.0"
  },
  "packageManager": "pnpm@12.14.0"
}
