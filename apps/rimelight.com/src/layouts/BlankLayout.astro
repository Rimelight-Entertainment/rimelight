---
import { createSeoHead } from "@rimelight/seo";
import { createSecurityHead } from "@rimelight/security";
import { createUiHead } from "@rimelight/ui";
import RLAMain from "@rimelight/ui/components/main/RLAMain.astro";
import { siteConfig } from "virtual:rimelight/seo";
import { Font } from 'astro:assets';

interface BlankLayoutProps {
  title: string;
  description: string;
  favicon?: string;
}

const { title, description, favicon } = Astro.props as BlankLayoutProps;

const seo = createSeoHead({
  title,
  description,
  config: siteConfig,
  favicon,
  url: Astro.url.href,
  canonical: Astro.url.href
});
const security = createSecurityHead();
const ui = createUiHead();
---

<!doctype html>
<html lang="en">
  <head>
    <Fragment set:html={seo.html} />
    <Fragment set:html={security.html} />
    <Fragment set:html={ui.html} />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <RLAMain>
      <slot />
    </RLAMain>
  </body>
</html>
