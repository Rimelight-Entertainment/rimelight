---
import AppLayout from './AppLayout.astro';
import RLADashboardGroup from "@rimelight/ui/components/dashboard-group/RLADashboardGroup.astro";
import RLADashboardSidebar from "@rimelight/ui/components/dashboard-sidebar/RLADashboardSidebar.astro";
import RLADashboardPanel from "@rimelight/ui/components/dashboard-panel/RLADashboardPanel.astro";
import RLADashboardNavbar from "@rimelight/ui/components/dashboard-navbar/RLADashboardNavbar.astro";
import RLADashboardSidebarCollapse from "@rimelight/ui/components/dashboard-sidebar-collapse/RLADashboardSidebarCollapse.astro";
import RLADashboardSidebarToggle from "@rimelight/ui/components/dashboard-sidebar-toggle/RLADashboardSidebarToggle.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Dashboard', description = 'Rimelight Dashboard' } = Astro.props;

const links = [
	{ label: 'Home', icon: 'lucide:home', to: '/dashboard' },
	{ label: 'Inbox', icon: 'lucide:inbox', to: '/dashboard/inbox' },
	{ label: 'Notes', icon: 'lucide:notebook', to: '/dashboard/notes' },
	{ label: 'Projects', icon: 'lucide:square-kanban', to: '/dashboard/projects' }
];

const footerLinks = [
	{ label: 'CMS Content', icon: 'lucide:file-text', to: '/cms' }
];
---

<AppLayout title={title} description={description} noindex={true}>
	<RLADashboardGroup style="padding-top: var(--rl-total-header-height, 0px)">
		<RLADashboardSidebar side="left" collapsible class="h-full border-r border-neutral-200/50 bg-neutral-50">
			<template #header>
				<div class="flex flex-col gap-2 w-full p-4">
					<div class="flex items-center gap-3 p-2">
						<span class="i-lucide-layout-dashboard size-5 shrink-0 text-neutral-600" />
						<span class="text-sm font-semibold text-neutral-900 truncate">Dashboard</span>
					</div>
					<RLADashboardSidebarCollapse side="left" class="shrink-0" />
				</div>
			</template>

			<nav class="flex flex-col gap-1">
				{links.map((item) => (
					<a
						href={item.to}
						class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors text-neutral-600 hover:bg-neutral-100"
					>
						<span class={item.icon.replace('lucide:', 'i-lucide-') + ' size-5 shrink-0'} />
						<span class="truncate">{item.label}</span>
					</a>
				))}
			</nav>

			<template #footer>
				<div class="p-4 border-t border-neutral-200/50 flex flex-col gap-2 shrink-0">
					<nav class="flex flex-col gap-1">
						{footerLinks.map((item) => (
							<a
								href={item.to}
								class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium transition-colors text-neutral-600 hover:bg-neutral-100"
							>
								<span class={item.icon.replace('lucide:', 'i-lucide-') + ' size-5 shrink-0'} />
								<span class="truncate">{item.label}</span>
							</a>
						))}
					</nav>
					<div class="h-[1px] bg-neutral-200 my-2" />
					<div class="flex flex-row gap-2 justify-between items-center">
						<a href="/dashboard/settings">
							<RLAButton color="neutral" variant="soft" class="rounded-xl size-8 p-0" title="Settings">
								<span class="i-lucide-cog size-4"></span>
							</RLAButton>
						</a>
						<a href="/dashboard/help">
							<RLAButton color="neutral" variant="soft" class="rounded-xl size-8 p-0" title="Help">
								<span class="i-lucide-circle-help size-4"></span>
							</RLAButton>
						</a>
						<a href="/dashboard/report-issue">
							<RLAButton color="neutral" variant="soft" class="rounded-xl size-8 p-0" title="Report Issue">
								<span class="i-lucide-bug size-4"></span>
							</RLAButton>
						</a>
					</div>
				</div>
			</template>
		</RLADashboardSidebar>

		<RLADashboardPanel>
			<template #header>
				<RLADashboardNavbar>
					<template #left>
						<RLADashboardSidebarToggle side="left" class="lg:hidden" />
						<h1 class="text-lg font-semibold text-neutral-900">
							{title}
						</h1>
					</template>
				</RLADashboardNavbar>
			</template>

			<div data-slot="body" class="flex-1 flex flex-col min-w-0 overflow-y-auto p-6">
				<slot />
			</div>
		</RLADashboardPanel>
	</RLADashboardGroup>
</AppLayout>