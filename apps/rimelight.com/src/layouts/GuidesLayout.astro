---
import AppLayout from './AppLayout.astro';
import GrandTaleHeader from '#components/franchises/grand-tale/GrandTaleHeader.astro';
import GuidesSidebar from '#components/franchises/grand-tale/GuidesSidebar.astro';

interface Props {
	title?: string;
	description?: string;
	favicon?: string;
}

const { title = 'Guides | Grand Tale', description = 'Grand Tale Guides', favicon = '/grand-tale.ico' } = Astro.props;
---

<AppLayout title={title} description={description} favicon={favicon}>
	<GrandTaleHeader />
	<div class="max-w-7xl mx-auto px-4 py-8 flex flex-col lg:flex-row gap-8">
		<aside class="w-full lg:w-64 shrink-0">
			<GuidesSidebar />
		</aside>
		<main class="flex-1 min-w-0">
			<slot />
		</main>
	</div>
</AppLayout>
