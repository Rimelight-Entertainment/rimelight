---
import AppLayout from './AppLayout.astro';
import StoreSidebar from '#components/store/StoreSidebar.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Store', description = 'Official Rimelight Store' } = Astro.props;
---

<AppLayout title={title} description={description}>
	<div class="bg-white min-h-screen flex flex-col">
		<div class="max-w-7xl mx-auto w-full flex flex-1">
			<aside class="hidden lg:block w-64 shrink-0 border-r border-black bg-white">
				<StoreSidebar />
			</aside>
			<main class="flex-1 min-w-0">
				<slot />
			</main>
		</div>
	</div>
</AppLayout>
