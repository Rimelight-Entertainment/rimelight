---
import DashboardLayout from './DashboardLayout.astro';
import { getRelativeLocaleUrl } from "@rimelight/i18n";
import { auth } from "#auth/auth";

interface Props {
	title?: string;
	activeTab: 'overview' | 'categories' | 'tags' | 'bylines' | 'taxonomies';
}

const { title = 'Admin Panel', activeTab } = Astro.props;

// Auth / permission check
const user = await auth.getSession(Astro.request);
if (!user || !['admin', 'owner'].some(r => (user.roles ?? []).includes(r))) {
	return Astro.redirect(getRelativeLocaleUrl('/dashboard'));
}

const links = [
	{
		label: 'Overview',
		icon: 'i-lucide-layout-dashboard',
		href: getRelativeLocaleUrl('/admin'),
		active: activeTab === 'overview'
	},
	{
		label: 'Categories',
		icon: 'i-lucide-folder',
		href: getRelativeLocaleUrl('/admin/categories'),
		active: activeTab === 'categories'
	},
	{
		label: 'Tags',
		icon: 'i-lucide-tag',
		href: getRelativeLocaleUrl('/admin/tags'),
		active: activeTab === 'tags'
	},
	{
		label: 'Bylines',
		icon: 'i-lucide-pen-tool',
		href: getRelativeLocaleUrl('/admin/bylines'),
		active: activeTab === 'bylines'
	},
	{
		label: 'CMS Dashboard',
		icon: 'i-lucide-file-text',
		href: getRelativeLocaleUrl('/cms'),
		active: false
	}
];
---

<DashboardLayout title={title}>
	<div class="p-6 flex flex-col h-full overflow-y-auto">
		<div class="mb-6 flex flex-col gap-1">
			<h1 class="text-2xl font-bold text-neutral-900 flex items-center gap-2">
				<span class="i-lucide-shield-check text-primary-500" />
				Admin Panel
			</h1>
			<p class="text-sm text-neutral-500">Manage workspace, teams, users, and global settings.</p>
		</div>

		<div class="border-b border-neutral-200 mb-6">
			<nav class="flex gap-4">
				{links.map((link) => (
					<a
						href={link.href}
						class:list={[
							'flex items-center gap-2 px-1 py-3 border-b-2 text-sm font-medium transition-colors',
							link.active
								? 'border-primary-500 text-primary-600'
								: 'border-transparent text-neutral-600 hover:text-neutral-900'
						]}
					>
						<span class:list={[link.icon, 'size-4']} />
						<span>{link.label}</span>
					</a>
				))}
			</nav>
		</div>

		<div class="flex-1">
			<slot />
		</div>
	</div>
</DashboardLayout>
