---
import AppLayout from './AppLayout.astro';
import GrandTaleHeader from '#components/franchises/grand-tale/GrandTaleHeader.astro';
import grandTaleIcon from '#assets/grand-tale.ico';

interface Props {
	title?: string;
	description?: string;
	favicon?: string;
}

const { title = 'Grand Tale', description = 'Grand Tale', favicon = grandTaleIcon } = Astro.props;
---

<AppLayout title={title} description={description} favicon={favicon}>
	<GrandTaleHeader />
	<div class="bg-grand-tale-primary-900 min-h-screen">
		<slot />
	</div>
</AppLayout>
