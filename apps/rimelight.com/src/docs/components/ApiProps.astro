---
import type { ComponentMetaMap, PropMeta } from "@rimelight/docs"
import { filterProps } from "../utils"
import meta from "virtual:rimelight-ui-docs-meta"

interface Props {
  component: string
  hide?: string[]
  show?: string[]
}

const { component, hide = ["class"], show } = Astro.props

const allMeta = meta as unknown as ComponentMetaMap
const compMeta = allMeta[component]

const filterOpts: { hide?: string[]; show?: string[] } = { hide }
if (show !== undefined) filterOpts.show = show
const props = filterProps(compMeta?.props ?? [], filterOpts)
---

{props.length > 0 ? (
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        <th>Required</th>
        <th>Default</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {props.map((prop: PropMeta) => (
        <tr>
          <td><span class="font-mono text-sm">{prop.name}</span></td>
          <td><span class="font-mono text-xs text-neutral-600">{prop.type}</span></td>
          <td>{prop.required ? "Yes" : "No"}</td>
          <td>{prop.default !== undefined ? <span class="font-mono text-xs text-neutral-600">{prop.default}</span> : "—"}</td>
          <td>{prop.description || "—"}</td>
        </tr>
      ))}
    </tbody>
  </table>
) : (
  <p class="text-sm italic text-neutral-500">No props to display.</p>
)}
