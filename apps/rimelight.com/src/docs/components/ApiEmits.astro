---
import type { ComponentMetaMap, EmitMeta } from "@rimelight/cms"
import meta from "virtual:rimelight-ui-docs-meta"

interface Props {
  component: string
}

const { component } = Astro.props

const allMeta = meta as unknown as ComponentMetaMap
const compMeta = allMeta[component]

const emits = compMeta?.emits ?? []
---

{emits.length === 0 ? (
  <p class="text-sm italic text-neutral-500">No events emitted by this component.</p>
) : (
  <div class="overflow-x-auto">
    <table class="w-full text-sm border-collapse">
      <thead>
        <tr class="border-b border-neutral-200">
          <th class="text-left py-2 px-3 font-semibold">Event</th>
          <th class="text-left py-2 px-3 font-semibold">Payload</th>
        </tr>
      </thead>
      <tbody>
        {emits.map((emit: EmitMeta) => (
          <tr class="border-b border-neutral-100">
            <td class="py-2 px-3">
              <span class="font-mono text-sm">
                {emit.name}
              </span>
            </td>
            <td class="py-2 px-3">
              <span class="font-mono text-xs text-neutral-600">
                {emit.type}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
