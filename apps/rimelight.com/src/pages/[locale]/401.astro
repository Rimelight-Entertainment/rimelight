---
import AppLayout from '#layouts/AppLayout.astro';
import { t, getRelativeLocaleUrl } from "@rimelight/i18n";

Astro.response.status = 401;
Astro.response.statusText = "Unauthorized";
---

<AppLayout title="401 - Authentication Required" description="You must be signed in to access this page." minimal={true} noindex={true}>
  <div class="error-container">
    <p class="error-code">401</p>
    <h1 class="error-title">Authentication Required</h1>
    <p class="error-desc">You must be signed in to access this page.</p>
    <a href={getRelativeLocaleUrl('/')} class="error-link">{t("page_error.go-home")}</a>
  </div>
</AppLayout>
