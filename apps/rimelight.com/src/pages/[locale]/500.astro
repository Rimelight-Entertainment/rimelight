---
import AppLayout from '@/layouts/AppLayout.astro';
import { t, getRelativeLocaleUrl } from "@rimelight/i18n";


interface Props {
    error: unknown;
}

const { error } = Astro.props;
if (error) {
  console.error("[500 SSR Error]:", error);
}
---

<AppLayout title={t("page_error.error_server_title")} description={t("page_error.error_server_description")}>
  <div class="error-container">
    <p class="error-code">500</p>
    <h1 class="error-title">{t("page_error.error_server_title")}</h1>
    <p class="error-desc">{error instanceof Error ? error.message : t("page_error.error_unknown_description")}</p>
    <a href={getRelativeLocaleUrl('/')} class="error-link">{t("page_error.go-home")}</a>
  </div>
</AppLayout>
