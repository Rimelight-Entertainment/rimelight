---
import GrandTaleLayout from "#layouts/GrandTaleLayout.astro";
import RLAccordion from "@rimelight/ui/components/accordion/RLAccordion.tsx";
import { t } from "@rimelight/i18n";

const faqItems = [
  { label: "What is Grand Tale?", content: "Grand Tale is a high-fantasy social life-sim RPG hosting sub-games of multiple genres." },
  { label: "When is the game launching?", content: "We are currently running private alpha trials. Full details will be shared on our forums." },
  { label: "What platforms are supported?", content: "PC is our lead platform, with consoles and cloud streaming plans in active development." }
];
---

<GrandTaleLayout title={t("page_grand-tale_about.hero_title")} description={t("page_grand-tale_about.hero_description")}>
  <div class="flex flex-col gap-16 md:gap-24 pb-24 bg-neutral-950 text-white">
    <!-- Hero Section -->
    <section class="flex flex-col items-center justify-center text-center px-4 py-24 md:py-32 gap-6 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-primary-500/10 to-transparent pointer-events-none" />
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight relative z-10">
        {t("page_grand-tale_about.hero_title")}
      </h1>
      <p class="text-xl md:text-2xl text-neutral-400 max-w-3xl relative z-10 leading-relaxed">
        {t("page_grand-tale_about.hero_description")}
      </p>
    </section>

    <!-- Story Section -->
    <section class="max-w-6xl mx-auto px-4 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <h2 class="text-3xl md:text-4xl font-extrabold uppercase tracking-tight">{t("page_grand-tale_about.story_title")}</h2>
          <p class="text-lg text-neutral-400 leading-relaxed">
            {t("page_grand-tale_about.story_description")}
          </p>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 aspect-video rounded-2xl flex items-center justify-center shadow-2xl">
          <span class="i-lucide-book-open text-primary-500/50 text-7xl"></span>
        </div>
      </div>
    </section>

    <!-- Specs Section -->
    <section class="bg-neutral-900/30 border-y border-neutral-900 py-24 w-full">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-extrabold uppercase tracking-tight mb-12 text-center">{t("page_grand-tale_about.specs_title")}</h2>
        <div class="bg-neutral-900 border border-neutral-850 rounded-2xl p-8 space-y-6 shadow-xl max-w-2xl mx-auto">
          <div class="flex justify-between border-b border-neutral-800 pb-4">
            <span class="text-neutral-400 font-medium">OS</span>
            <span class="text-white font-semibold">Windows 10/11 (64-bit)</span>
          </div>
          <div class="flex justify-between border-b border-neutral-800 pb-4">
            <span class="text-neutral-400 font-medium">CPU</span>
            <span class="text-white font-semibold">Intel Core i5-8400 / AMD Ryzen 5 2600</span>
          </div>
          <div class="flex justify-between border-b border-neutral-800 pb-4">
            <span class="text-neutral-400 font-medium">GPU</span>
            <span class="text-white font-semibold">NVIDIA GTX 1060 / AMD RX 580</span>
          </div>
          <div class="flex justify-between pb-2">
            <span class="text-neutral-400 font-medium">DirectX</span>
            <span class="text-white font-semibold">Version 12</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-4xl mx-auto px-4 w-full">
      <h2 class="text-3xl md:text-4xl font-extrabold uppercase tracking-tight mb-12 text-center">{t("page_grand-tale_about.faq_title")}</h2>
      <div class="space-y-6 max-w-2xl mx-auto bg-neutral-900 border border-neutral-850 rounded-2xl p-8 shadow-xl">
        <RLAccordion items={faqItems} class="border-0" />
      </div>
    </section>
  </div>
</GrandTaleLayout>
