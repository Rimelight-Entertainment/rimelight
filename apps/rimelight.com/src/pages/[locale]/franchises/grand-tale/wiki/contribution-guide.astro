---
import WikiLayout from '#layouts/WikiLayout.astro';
import RLButton from "@rimelight/ui/components/button/RLButton.tsx";

const rules = [
	{
		title: 'Accuracy',
		description: 'Ensure all information is verified against in-game data or official developer statements.'
	},
	{
		title: 'Tone',
		description: 'Maintain a neutral, encyclopedic tone. Avoid first-person perspectives unless in a specific tips section.'
	},
	{
		title: 'Formatting',
		description: 'Use standard headers, bold text for key terms, and properly link to other wiki articles.'
	},
	{
		title: 'Media',
		description: 'Only upload high-quality screenshots and ensure they are properly categorized.'
	}
];
---

<WikiLayout title="Contribution Guide | Grand Tale Wiki">
	<div class="space-y-12">
		<section class="space-y-4">
			<div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-bold uppercase tracking-widest">
				Community
			</div>
			<h1 class="text-4xl font-extrabold uppercase tracking-tight text-white leading-none">
				Contributing to <br />
				<span class="text-indigo-400">The Great Library</span>
			</h1>
			<p class="text-lg text-neutral-400 font-light max-w-2xl">
				Help us build the most comprehensive database for Grand Tale. Your knowledge helps other players master the shards and uncover the mysteries of Aethelgard.
			</p>
		</section>

		<hr class="border-neutral-800/30" />

		<section class="space-y-6">
			<h2 class="text-xl font-bold text-white uppercase tracking-tight flex items-center gap-2">
				<span class="i-lucide-scroll text-indigo-400 size-5"></span>
				General Rules
			</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{rules.map((rule) => (
					<div class="p-6 bg-neutral-900/40 border border-neutral-850 space-y-2 rounded-2xl">
						<h3 class="font-bold text-white uppercase tracking-tight text-sm">{rule.title}</h3>
						<p class="text-xs text-neutral-400 leading-relaxed">
							{rule.description}
						</p>
					</div>
				))}
			</div>
		</section>

		<section class="space-y-6">
			<h2 class="text-xl font-bold text-white uppercase tracking-tight flex items-center gap-2">
				<span class="i-lucide-git-pull-request text-indigo-400 size-5"></span>
				How to Submit
			</h2>

			<div class="space-y-4 text-neutral-400 text-sm">
				<p>
					Currently, the wiki is in a semi-closed state. To contribute, you must have a verified Rimelight account with at least 10 hours of playtime in Grand Tale.
				</p>

				<div class="flex flex-col gap-4">
					<div class="flex items-start gap-4 p-4 bg-neutral-900/20 border border-neutral-850 rounded-2xl">
						<div class="flex-none w-8 h-8 rounded-full bg-indigo-500/20 flex items-center justify-center text-indigo-400 font-bold">
							1
						</div>
						<div>
							<p class="text-white font-bold text-sm">Draft your article</p>
							<p class="text-xs text-neutral-500">Use our internal Markdown editor to create your content.</p>
						</div>
					</div>

					<div class="flex items-start gap-4 p-4 bg-neutral-900/20 border border-neutral-850 rounded-2xl">
						<div class="flex-none w-8 h-8 rounded-full bg-indigo-500/20 flex items-center justify-center text-indigo-400 font-bold">
							2
						</div>
						<div>
							<p class="text-white font-bold text-sm">Submit for Review</p>
							<p class="text-xs text-neutral-500">Our Wiki Guardians will review your submission for accuracy and formatting.</p>
						</div>
					</div>

					<div class="flex items-start gap-4 p-4 bg-neutral-900/20 border border-neutral-850 rounded-2xl">
						<div class="flex-none w-8 h-8 rounded-full bg-indigo-500/20 flex items-center justify-center text-indigo-400 font-bold">
							3
						</div>
						<div>
							<p class="text-white font-bold text-sm">Earn Rewards</p>
							<p class="text-xs text-neutral-500">Approved contributions earn you unique badges and in-game Soulstone dust.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="p-8 bg-indigo-950/20 border border-indigo-900/30 text-center space-y-4 rounded-3xl">
			<h3 class="text-lg font-bold text-white">Ready to help?</h3>
			<p class="text-xs text-neutral-400 max-w-lg mx-auto">
				Join the Wiki Development channel in our Discord to coordinate with other contributors.
			</p>
			<RLButton class="bg-indigo-500 hover:bg-indigo-600 text-white font-bold text-xs py-2 px-4 rounded-xl shadow-md flex items-center gap-1.5 mx-auto" label="Join Discord">
				<span class="i-logos-discord-icon size-4"></span>
			</RLButton>
		</section>
	</div>
</WikiLayout>
