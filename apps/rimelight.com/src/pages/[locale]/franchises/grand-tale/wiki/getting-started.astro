---
import WikiLayout from '#layouts/WikiLayout.astro';
import RLButton from "@rimelight/ui/components/button/RLButton.tsx";
import RLCard from "@rimelight/ui/components/card/RLCard.tsx";

const guides = [
	{
		title: "Combat Basics",
		description: "Learn the fundamentals of combat, including weapon types, skill rotations, and defensive mechanics."
	},
	{
		title: "Soul Resonance",
		description: "Understand the core mechanic that powers your abilities and connects you to the world."
	},
	{
		title: "World Navigation",
		description: "Master fast travel, waypoints, and exploration mechanics to traverse the shattered world."
	},
	{
		title: "Character Creation",
		description: "Choose your origin, customize your appearance, and understand starting stats."
	}
];
---

<WikiLayout title="Getting Started | Grand Tale Wiki">
	<div class="space-y-16">
		<section class="space-y-6">
			<div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-bold uppercase tracking-widest rounded-full">
				Getting Started
			</div>
			<h1 class="text-5xl font-black uppercase tracking-tighter text-white leading-none">
				Welcome to <br />
				<span class="text-indigo-400">Grand Tale</span>
			</h1>
			<p class="text-xl text-neutral-300 font-light max-w-2xl leading-relaxed">
				Your comprehensive guide to understanding the world, mechanics, and lore of Grand Tale.
				Start here if you're new to the game.
			</p>
		</section>

		<hr class="border-neutral-800/40" />

		<section class="space-y-8">
			<h2 class="text-2xl font-bold text-white uppercase tracking-tight flex items-center gap-3">
				<span class="i-lucide-book-open text-indigo-400 size-6"></span>
				New Players
			</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{guides.map((guide) => (
					<RLCard class="bg-neutral-900/40 border-neutral-800 rounded-2xl p-6">
						<div slot="header" class="mb-2">
							<h3 class="text-lg font-bold text-white uppercase">{guide.title}</h3>
						</div>
						<p class="text-neutral-400 text-sm leading-relaxed mb-4">
							{guide.description}
						</p>
						<RLButton variant="ghost" color="primary" class="p-0 text-indigo-400 hover:text-indigo-300 font-bold text-xs uppercase" label="Read Guide →" />
					</RLCard>
				))}
			</div>
		</section>

		<section class="space-y-8">
			<h2 class="text-2xl font-bold text-white uppercase tracking-tight flex items-center gap-3">
				<span class="i-lucide-scroll-text text-indigo-400 size-6"></span>
				Lore Seekers
			</h2>

			<div class="space-y-4">
				<p class="text-neutral-300 leading-relaxed">
					Dive into the chronology of the Cataclysm and the rise of the Nine Factions. The world of
					Grand Tale is rich with history, mysteries, and interconnected storylines.
				</p>
				<div class="flex flex-wrap gap-4">
					<RLButton color="primary" variant="outline" label="Timeline of Events" class="rounded-xl px-4 py-2" />
					<RLButton color="primary" variant="outline" label="The Nine Factions" class="rounded-xl px-4 py-2" />
				</div>
			</div>

			<RLCard class="bg-neutral-900/40 border-neutral-800 rounded-2xl p-6">
				<div class="flex flex-col md:flex-row gap-6 items-center">
					<div class="p-4 bg-indigo-500/20 rounded-xl border border-indigo-500/30 shrink-0">
						<span class="i-lucide-info size-8 text-indigo-400"></span>
					</div>
					<div class="space-y-1">
						<h4 class="font-bold text-white uppercase text-base">Alpha Notice</h4>
						<p class="text-sm text-neutral-400 leading-relaxed">
							Many articles are currently being drafted by the development team. If you encounter
							missing information or placeholder images, please report it via the Support portal.
						</p>
					</div>
				</div>
			</RLCard>
		</section>
	</div>
</WikiLayout>
