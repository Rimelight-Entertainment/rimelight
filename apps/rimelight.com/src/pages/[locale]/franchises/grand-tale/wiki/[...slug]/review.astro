---
import WikiLayout from '@/layouts/WikiLayout.astro';
import { BlockRenderer } from "@rimelight/cms/astro";
import { PAGE_MAP as pageDefinitions } from '@/types/pageDefinitions';
import { auth } from "@/auth/auth";

const { slug } = Astro.params;
const lookupSlug = `franchises/grand-tale/wiki/${slug}`;
const versionId = Astro.url.searchParams.get('version') || '';
const sessionData = await auth.api.getSession({ headers: Astro.request.headers });
const user = sessionData?.user;
const isAdmin = (user as { role?: string } | null)?.role === 'owner' || (user as { role?: string } | null)?.role === 'admin';
---

<WikiLayout title="Review Wiki Version | Grand Tale Wiki">
	<BlockRenderer
		client:only
		lookupPath={lookupSlug}
		versionId={versionId}
		pageDefinitions={pageDefinitions}
		baseUrl="/franchises/grand-tale/wiki"
		isAdmin={isAdmin}
	/>
</WikiLayout>
