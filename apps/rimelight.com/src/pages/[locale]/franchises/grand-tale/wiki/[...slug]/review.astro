---
import WikiLayout from '#layouts/WikiLayout.astro';
import PageRenderer from "@rimelight/cms/astro/PageRenderer.astro";
import { db } from "#db"
import { pageVersions } from "#db/schema"
import { eq } from "drizzle-orm"

const activeLocale = Astro.currentLocale ?? "en"

const versionId = Astro.url.searchParams.get('version') || '';

let version = null;
if (versionId) {
  const versionResult = await db
    .select()
    .from(pageVersions)
    .where(eq(pageVersions.id, versionId))
    .limit(1)
  version = versionResult[0]
}

if (!version) {
  return Astro.redirect("/404")
}

const versionContent = typeof version.content === "string" ? JSON.parse(version.content) : version.content || {}

function getLocalizedText(val: unknown, locale: string): string {
  if (typeof val === "object" && val !== null) {
    const record = val as Record<string, string>
    return record[locale] || record.en || ""
  }
  return String(val || "")
}

const title = getLocalizedText(version.title, activeLocale)
const description = getLocalizedText(version.description, activeLocale) || ""
---

<WikiLayout title={`Review Wiki Version | ${title} | Grand Tale`}>
  <article class="prose">
    <div class="text-xs text-muted mb-4">
      <span>Status: {version.status}</span>
      {version.createdAt && <span> | Created: {new Date(version.createdAt).toLocaleDateString(activeLocale)}</span>}
      {version.approvedAt && <span> | Approved: {new Date(version.approvedAt).toLocaleDateString(activeLocale)}</span>}
    </div>
    <h1>{title}</h1>
    {description && <p class="text-muted">{description}</p>}
    <PageRenderer blocks={versionContent.blocks || []} locale={activeLocale} />
  </article>
</WikiLayout>
