---
import AppLayout from "@/layouts/AppLayout.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";

import { t, getRelativeLocaleUrl } from "@rimelight/i18n";
---

<AppLayout title={t("page_about.title")} description={t("page_about.description")}>
  <div class="flex flex-col gap-16 md:gap-24 pb-24 bg-neutral-950 text-white">
    <!-- Hero Section -->
    <section class="flex flex-col items-center justify-center text-center px-4 py-24 md:py-32 gap-6 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-primary-500/10 to-transparent pointer-events-none" />
      <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tight relative z-10">
        {t("page_about.hero_title")}
      </h1>
      <p class="text-xl md:text-2xl text-neutral-400 max-w-3xl relative z-10 leading-relaxed">
        {t("page_about.hero_description")}
      </p>
    </section>

    <!-- Mission Section -->
    <section class="max-w-6xl mx-auto px-4 w-full">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <h2 class="text-3xl md:text-4xl font-extrabold uppercase tracking-tight">{t("page_about.mission_title")}</h2>
          <p class="text-lg text-neutral-400 leading-relaxed">
            {t("page_about.mission_desc")}
          </p>
          <p class="text-lg text-neutral-400 leading-relaxed">
            We operate with a flat structure, high trust, and low bureaucracy so that devs can focus on what they do best: creating incredible experiences.
          </p>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 aspect-video rounded-2xl flex items-center justify-center shadow-2xl">
          <span class="i-lucide-target text-primary-500/50 text-7xl"></span>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="bg-neutral-900/30 border-y border-neutral-900 py-24 w-full">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-extrabold uppercase tracking-tight mb-12 text-center">{t("page_about.values_title")}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl p-8 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <span class="i-lucide-heart text-primary-500 text-2xl"></span>
              <h3 class="font-bold text-xl uppercase">{t("page_about.values_player_title")}</h3>
            </div>
            <p class="text-neutral-400 text-sm leading-relaxed">
              {t("page_about.values_player_desc")}
            </p>
          </div>
          <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl p-8 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <span class="i-lucide-zap text-primary-500 text-2xl"></span>
              <h3 class="font-bold text-xl uppercase">{t("page_about.values_innov_title")}</h3>
            </div>
            <p class="text-neutral-400 text-sm leading-relaxed">
              {t("page_about.values_innov_desc")}
            </p>
          </div>
          <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl p-8 shadow-lg">
            <div class="flex items-center gap-3 mb-4">
              <span class="i-lucide-users text-primary-500 text-2xl"></span>
              <h3 class="font-bold text-xl uppercase">{t("page_about.values_collab_title")}</h3>
            </div>
            <p class="text-neutral-400 text-sm leading-relaxed">
              {t("page_about.values_collab_desc")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Leadership Team -->
    <section class="max-w-6xl mx-auto px-4 w-full">
      <h2 class="text-3xl md:text-4xl font-extrabold uppercase tracking-tight mb-12 text-center">{t("page_about.team_title")}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="flex flex-col items-center text-center space-y-4">
          <div class="w-32 h-32 rounded-full bg-neutral-800 border border-neutral-700 flex items-center justify-center overflow-hidden shadow-lg">
            <span class="i-lucide-user text-neutral-600 text-5xl"></span>
          </div>
          <div>
            <h3 class="font-bold text-xl">Daniel Marchi</h3>
            <p class="text-primary-500 text-sm uppercase font-semibold">Founder & CEO</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-5xl mx-auto px-4 w-full">
      <div class="bg-gradient-to-r from-primary-950/20 to-neutral-900 border border-primary-500/20 rounded-3xl p-12 text-center space-y-6 shadow-2xl">
        <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight">{t("page_about.join_title")}</h2>
        <p class="text-neutral-400 max-w-xl mx-auto leading-relaxed">
          {t("page_about.join_desc")}
        </p>
        <div class="flex justify-center">
          <RLAButton
            label={t("page_about.join_btn")}
            href={getRelativeLocaleUrl("/company/careers")}
            color="primary"
            variant="solid"
            class="px-8 py-3 rounded-lg font-bold transition-all duration-300 transform hover:scale-[1.03]"
          />
        </div>
      </div>
    </section>
  </div>
</AppLayout>
