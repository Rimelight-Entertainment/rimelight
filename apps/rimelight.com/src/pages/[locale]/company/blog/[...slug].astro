---
import AppLayout from "#layouts/AppLayout.astro"
import PageRenderer from "@rimelight/cms/astro/PageRenderer.astro"
import RLADate from "@rimelight/ui/components/date/RLADate.astro"
import { t } from "@rimelight/i18n"
import { db } from "#db"
import { pages } from "#db/schema"
import { eq, and, isNull, sql } from "drizzle-orm"

const activeLocale = Astro.currentLocale ?? "en"

const { slug } = Astro.params
if (!slug) return Astro.redirect("/company/blog")

let pageResult: any[] = []
try {
  pageResult = await db
    .select()
    .from(pages)
    .where(and(sql`${pages.type} = ${"blog"}`, eq(pages.slug, slug), isNull(pages.deletedAt)))
    .limit(1)
} catch (dbErr) {
  console.error("[blog/[...slug].astro] Failed to query page:", dbErr)
}

const page = pageResult[0]

if (!page) {
  return Astro.redirect("/404")
}

const content = typeof page.content === "string" ? JSON.parse(page.content) : page.content || {}

function getLocalizedText(val: unknown, locale: string): string {
  if (typeof val === "object" && val !== null) {
    const record = val as Record<string, string>
    return record[locale] || record.en || ""
  }
  return String(val || "")
}

const title = getLocalizedText(page.title, activeLocale)
const description = getLocalizedText(page.description, activeLocale) || content.properties?.description || ""
const heroImage = content.properties?.heroImage
const pubDate = page.postedAt || page.createdAt
const updatedDate = page.updatedAt
---

<AppLayout title={title} description={description}>
		<article>
			<div class="hero-image">
				{heroImage && <img src={heroImage} alt="" />}
			</div>
			<div class="prose">
				<div class="title">
					<div class="date">
						<RLADate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on">
									{t("blog.lastUpdatedOn")} <RLADate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1>{title}</h1>
					<hr />
				</div>
				<PageRenderer blocks={content.blocks || []} locale={activeLocale} />
			</div>
		</article>
</AppLayout>
