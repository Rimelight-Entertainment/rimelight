---
import DocsLayout from "@/layouts/DocsLayout.astro"
import type { TableOfContentsConfig } from "@rimelight/ui/components/table-of-contents/table-of-contents.ts"
import { getDocsVersions, parseDocsSlug, extractHeadingsFromBlocks } from "@rimelight/cms"
import { db } from "@/db"
import { pages } from "@/db/schema"
import { eq, and, isNull, inArray, sql } from "drizzle-orm"
import meta from "virtual:rimelight-ui-docs-meta"
import { generateThemeCode } from "@/docs/utils"
import ComponentShowcase from "@/components/ComponentShowcase.astro"
import BlockRenderer from "@rimelight/cms/astro/BlockRenderer.astro"

// Build component registry from all UI components
const componentModules: Record<string, any> = import.meta.glob("../../../../../../../packages/ui/src/components/*/RLA*.astro", { eager: true })
const componentRegistry: Record<string, any> = {}
for (const [path, mod] of Object.entries(componentModules)) {
  const fileName = path.split("/").pop()?.replace(".astro", "")
  if (fileName && mod.default) {
    componentRegistry[fileName] = mod.default
  }
}

// Load theme modules for generating combinationClasses
const themeModules: Record<string, any> = import.meta.glob("../../../../../../../packages/ui/src/components/*/*.theme.ts", { eager: true })
const themeRegistry: Record<string, any> = {}
for (const [path, mod] of Object.entries(themeModules)) {
  // Extract component key from path like .../button/button.theme.ts -> "button"
  const match = path.match(/\/([\w-]+)\/\1\.theme\.ts$/)
  if (match?.[1]) {
    // Theme files use named exports (e.g. export const buttonTheme = ...), not default exports
    const themeFn = mod.default || Object.values(mod).find(v => typeof v === 'function')
    if (themeFn) {
      themeRegistry[match[1]] = themeFn
    }
  }
}

function generateCombinationClasses(themeFn: any, propsConfig: Record<string, string[]>, defaultProps: Record<string, any>): Record<string, any> {
  const allKeys = Object.keys(propsConfig)
  const allValues = allKeys.map(k => propsConfig[k] || [])
  const result: Record<string, any> = {}
  let initialThemeClasses: Record<string, string> = {}

  try { initialThemeClasses = themeFn(defaultProps || {}) } catch {}

  function cartesian(arrays: string[][]): string[][] {
    if (arrays.length === 0) return [[]]
    const [first, ...rest] = arrays
    const restProduct = cartesian(rest)
    return (first ?? []).flatMap(val => restProduct.map(combo => [val, ...combo]))
  }

  for (const combo of cartesian(allValues)) {
    const props: Record<string, any> = {}
    allKeys.forEach((k, i) => { props[k] = combo[i] })
    try {
      result[allKeys.map(k => `${k}:${props[k]}`).join('|')] = themeFn(props)
    } catch {}
  }

  return { combinationClasses: result, initialThemeClasses }
}

/** Parse a raw Astro tag like <RLAButton label="Rounded" rounded /> into { tag, props } */
function parseComponentTag(html: string): { tag: string; props: Record<string, any> } | null {
  const trimmed = html.trim()

  const parseTag = (tagHtml: string): { tag: string; props: Record<string, any> } | null => {
    const match = tagHtml.match(/^<(\w+)([\s\S]*?)(\/?)>$/)
    if (!match) return null
    const tag = match[1]!
    const attrsStr = (match[2] || "").trim()
    const props: Record<string, any> = {}

    const attrRegex = /(\w[\w-]*)(?:=(?:"([^"]*)"|{([^}]*)}|'([^']*)'))?/g
    let attrMatch
    while ((attrMatch = attrRegex.exec(attrsStr)) !== null) {
      const key = attrMatch[1]!
      if (attrMatch[2] !== undefined) {
        props[key] = attrMatch[2]
      } else if (attrMatch[3] !== undefined) {
        const val = attrMatch[3]!.trim()
        if (val === "true") props[key] = true
        else if (val === "false") props[key] = false
        else if (/^\d+$/.test(val)) props[key] = Number(val)
        else      props[key] = val!.replace(/^["']|["']$/g, "")
      } else {
        props[key] = true
      }
    }
    return { tag, props }
  }

  // First, try to find a known component tag (RLA*/RLV*/RLS*) — prioritize these over generic HTML wrappers
  const componentMatch = trimmed.match(/<(RLA\w+|RLV\w+|RLS\w+)([\s\S]*?)(\/?)>/)
  if (componentMatch) return parseTag(componentMatch[0]!)

  // Fall back to matching the first tag (could be a div wrapper, etc.)
  return parseTag(trimmed)
}

const activeLocale = Astro.currentLocale ?? "en"
const { slug } = Astro.params

// 1. Discover versions from database
let allDocPages: any[] = []
try {
  allDocPages = await db
    .select({
      slug: pages.slug,
      version: sql<string>`(${pages.content}->'properties'->>'version')`.as('version'),
    })
    .from(pages)
    .where(and(eq(pages.type as any, "doc" as any), isNull(pages.deletedAt)))
} catch {
  // DB query fallback if offline/initializing
}

const versions = getDocsVersions(allDocPages, activeLocale)

const { activeVersion, contentPath, includeVersionInUrl } = parseDocsSlug(slug, versions)

if (includeVersionInUrl && (!slug || !slug.split("/")[0]?.startsWith("v"))) {
  return Astro.redirect(`/${activeLocale}/company/docs/${activeVersion}/${contentPath === "index" ? "" : contentPath}`)
}

// 2. Fetch specific doc page from CMS DB
let dbPage: any = null
const candidateSlugs = [
  `${activeVersion}/${activeLocale}/${contentPath}`,
  activeVersion ? `${activeVersion}/${activeLocale}/${contentPath === "index" ? "" : contentPath}` : undefined,
  slug,
  contentPath === "index" ? (activeVersion ? `${activeVersion}/index` : "index") : (activeVersion ? `${activeVersion}/${contentPath}` : contentPath),
  contentPath
].filter(Boolean) as string[]

try {
  const pageResults = await db
    .select()
    .from(pages)
    .where(and(eq(pages.type as any, "doc" as any), inArray(pages.slug, candidateSlugs), isNull(pages.deletedAt)))

  if (pageResults && pageResults.length > 0) {
    for (const candidate of candidateSlugs) {
      const match = pageResults.find((p: any) => p.slug === candidate)
      if (match) {
        dbPage = match
        break
      }
    }
  }
} catch {
  // continue
}

if (!dbPage) {
  return Astro.redirect("/404")
}

const content = typeof dbPage.content === "string" ? JSON.parse(dbPage.content) : dbPage.content || {}
const dbBlocks = content.blocks || []

// Enrich blocks with metadata
const allMeta = meta as unknown as Record<string, any>
for (const block of dbBlocks) {
  if (block.type === "ApiDocumentationBlock") {
    const compMeta = allMeta[block.props.componentName]
    if (compMeta) {
      block.props.meta = compMeta
      if (compMeta.theme) {
        block.props.themeCode = generateThemeCode(block.props.componentName, compMeta.theme)
      }
    }
  }
}

// Parse preview components for each showcase block (needed for ComponentShowcase rendering)
const showcasePreviewMap = new Map<string, { Component: any; props: Record<string, any>; raw: string }>()
for (const block of dbBlocks) {
  if (block.type === "ComponentShowcaseBlock") {
    const raw = block.props.previewHtml || ""
    const parsed = parseComponentTag(raw)
    if (parsed) {
      const Component = componentRegistry[parsed.tag]
      showcasePreviewMap.set(block.id, { Component, props: parsed.props, raw })
    } else {
      showcasePreviewMap.set(block.id, { Component: null, props: {}, raw })
    }
  }
}

const getLocalizedText = (val: unknown, loc: string): string => {
  if (typeof val === "object" && val !== null) {
    const record = val as Record<string, string>
    return record[loc] || record.en || ""
  }
  return String(val || "")
}

const docTitle = getLocalizedText(dbPage.title, activeLocale) || "Documentation"
const docDescription = getLocalizedText(dbPage.description, activeLocale) || content.properties?.description || ""
const docHeadings = extractHeadingsFromBlocks(dbBlocks)
const docTableOfContents = content.properties?.tableOfContents as TableOfContentsConfig | false | undefined
const docPrev = content.properties?.prev
const docNext = content.properties?.next
const docEditUrl = content.properties?.editUrl

// Pre-compute combinationClasses for each ComponentShowcaseBlock
const showcaseDataMap = new Map<string, { combinationClasses: Record<string, any>; initialThemeClasses: Record<string, string>; themeSlots: string[] }>()
for (const block of dbBlocks) {
  if (block.type === "ComponentShowcaseBlock" && block.props.propsConfig && Object.keys(block.props.propsConfig).length > 0) {
    const compKey = (block.props.componentName || '').replace(/^RL[AV]/, '').replace(/([a-z0-9])([A-Z])/g, '$1-$2').toLowerCase()
    const themeFn = themeRegistry[compKey]
    if (themeFn) {
      try {
        const { combinationClasses, initialThemeClasses } = generateCombinationClasses(themeFn, block.props.propsConfig, block.props.defaultProps || {})
        const themeSlots = Object.keys(initialThemeClasses).filter(k => k !== 'class' && k !== 'className')
        showcaseDataMap.set(block.id, { combinationClasses, initialThemeClasses, themeSlots })
      } catch {}
    }
  }
}
---

<DocsLayout
  title={docTitle}
  description={docDescription}
  headings={docHeadings}
  tableOfContents={docTableOfContents}
  prevOverride={docPrev}
  nextOverride={docNext}
  editUrl={docEditUrl}
  activeVersion={activeVersion}
  versions={versions}
  includeVersionInUrl={includeVersionInUrl}
>
  {/* Render blocks in their original order to preserve document structure */}
  {dbBlocks.map((block: any) => {
    if (block.type === "ComponentShowcaseBlock") {
      const preview = showcasePreviewMap.get(block.id)
      const Component = preview?.Component
      const props = preview?.props || {}
      const raw = preview?.raw || ""

      return (
        <ComponentShowcase
          componentName={block.props.componentName}
          propsConfig={block.props.propsConfig}
          defaultProps={block.props.defaultProps}
          togglingPattern={block.props.togglingPattern}
          playground={block.props.playgroundUrl}
          {...(() => { const d = showcaseDataMap.get(block.id); return d || {}; })()}
        >
          {Component ? (
            <Component {...props} />
          ) : (
            <Fragment set:html={raw} />
          )}

          {block.props.codeExamples?.astro && (
            <Fragment slot="code-astro">
              <pre class="m-0 text-sm font-mono text-muted"><code>{block.props.codeExamples.astro}</code></pre>
            </Fragment>
          )}
          {block.props.codeExamples?.vue && (
            <Fragment slot="code-vue">
              <pre class="m-0 text-sm font-mono text-muted"><code>{block.props.codeExamples.vue}</code></pre>
            </Fragment>
          )}
          {block.props.codeExamples?.solid && (
            <Fragment slot="code-solid">
              <pre class="m-0 text-sm font-mono text-muted"><code>{block.props.codeExamples.solid}</code></pre>
            </Fragment>
          )}
        </ComponentShowcase>
      )
    }

    {/* All other block types go through BlockRenderer */}
    return <BlockRenderer block={block} locale={activeLocale} />
  })}
</DocsLayout>
