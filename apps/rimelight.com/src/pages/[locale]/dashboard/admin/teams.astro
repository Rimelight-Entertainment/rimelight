---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminTeams from '@/components/dashboard/admin/AdminTeams.vue';
import { auth } from "@/auth/auth";

const sessionData = await auth.api.getSession({ headers: Astro.request.headers });
const user = sessionData?.user;

if (!user) {
	return Astro.redirect(`/${Astro.currentLocale ?? 'en'}/auth/sign-in`);
}
---

<AdminLayout activeTab="teams" title="Manage Teams">
	<AdminTeams client:load />
</AdminLayout>
