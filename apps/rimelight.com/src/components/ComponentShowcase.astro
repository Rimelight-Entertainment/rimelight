---
import { RLSelect } from "@rimelight/ui/components/select/RLSelect.tsx";
import { RLButton } from "@rimelight/ui/components/button/RLButton.tsx";
import { RLPopover } from "@rimelight/ui/components/popover/RLPopover.tsx";
import { RLSeparator } from "@rimelight/ui/components/separator/RLSeparator.tsx";

interface Props {
  component?: string;
  componentName?: string;
  slots?: string[];
  props?: Record<string, any>;
  class?: string;
  playground?: string;
  propsConfig?: Record<string, string[]>;
  defaultProps?: Record<string, string>;
  togglingPattern?: "icon" | "select-option" | "tab-segmented" | "pill-toggle";
  theme?: any;
  combinationClasses?: Record<string, any>;
  initialThemeClasses?: Record<string, string>;
  themeSlots?: string[];
}

const {
  class: className,
  playground,
  component,
  componentName,
  propsConfig,
  defaultProps,
  togglingPattern = "tab-segmented",
  combinationClasses: propCombinationClasses,
  initialThemeClasses: propInitialThemeClasses,
  themeSlots: propThemeSlots
} = Astro.props;

let resolvedComponentName = componentName || component || "";
if (!resolvedComponentName) {
  const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
  const lastSegment = pathSegments[pathSegments.length - 1];
  if (lastSegment) {
    resolvedComponentName = 'RL' + lastSegment.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join('');
  }
}
const isDynamic = !!propsConfig;
const propKeys = propsConfig ? Object.keys(propsConfig) : [];

// If select-option pattern is used, we inject the special compare option to each config
let resolvedPropsConfig: Record<string, string[]> = { ...propsConfig };
if (isDynamic && togglingPattern === "select-option") {
  resolvedPropsConfig = {};
  for (const key of propKeys) {
    const configValues = propsConfig?.[key] || [];
    resolvedPropsConfig[key] = [...configValues, "— Compare All —"];
  }
}

let combinationClasses: Record<string, any> = propCombinationClasses || {};
let initialThemeClasses: Record<string, string> = propInitialThemeClasses || {};

// Fallback: derive theme-based combination classes when not provided (e.g. the
// CMS layer didn't precompute them). This keeps the compare view working.
if (
  (!combinationClasses || Object.keys(combinationClasses).length === 0) &&
  propsConfig &&
  Object.keys(propsConfig).length > 0 &&
  resolvedComponentName
) {
  const compKey = resolvedComponentName
    .replace(/^RL[AVS]?/, '')
    .replace(/([a-z0-9])([A-Z])/g, '$1-$2')
    .toLowerCase();

  const themeModules = import.meta.glob(
    '../../../../packages/ui/src/components/*/*.theme.ts',
    { eager: true }
  );
  const themeRegistry: Record<string, any> = {};
  for (const [path, mod] of Object.entries(themeModules)) {
    const m = path.match(/\/([\w-]+)\/\1\.theme\.ts$/);
    if (m?.[1]) {
      const fn = (mod as any).default || Object.values(mod as any).find((v: any) => typeof v === 'function');
      if (fn) themeRegistry[m[1]] = fn;
    }
  }

  const themeFn = themeRegistry[compKey];
  if (themeFn) {
    const allKeys = Object.keys(propsConfig);
    const allValues = allKeys.map((k) => propsConfig[k] || []);
    const result: Record<string, any> = {};
    let init: Record<string, string> = {};
    try {
      init = themeFn(defaultProps || {});
    } catch {}

    const cartesian = (arrays: string[][]): string[][] => {
      if (arrays.length === 0) return [[]];
      const [first, ...rest] = arrays;
      const restProduct = cartesian(rest);
      return (first || []).flatMap((val) => restProduct.map((combo) => [val, ...combo]));
    };

    for (const combo of cartesian(allValues)) {
      const p: Record<string, any> = {};
      allKeys.forEach((k, i) => {
        p[k] = combo[i];
      });
      try {
        result[allKeys.map((k) => `${k}:${p[k]}`).join('|')] = themeFn(p);
      } catch {}
    }

    combinationClasses = result;
    initialThemeClasses = init;
  }
}

const hasAstroCode = Astro.slots.has('code-astro');
const hasSolidCode = Astro.slots.has('code-solid');
const hasCode = hasAstroCode || hasSolidCode;
const defaultCodeLang = hasAstroCode ? 'astro' : 'tsx';
---

<div class={`component-showcase border border-default rounded-xl overflow-visible bg-neutral-50 text-highlighted my-6 ${isDynamic ? "dynamic-showcase" : ""} ${className}`} data-component={resolvedComponentName} data-props={JSON.stringify(propKeys)} data-config={JSON.stringify(propsConfig || {})} data-pattern={togglingPattern} data-combinations={JSON.stringify(combinationClasses)} data-initial-theme={JSON.stringify(initialThemeClasses)} data-theme-slots={JSON.stringify(propThemeSlots || Object.keys(initialThemeClasses).filter(k => k !== 'class' && k !== 'className'))}>
  <!-- Dynamic Props Configuration Area -->
  {isDynamic && (
    <div class="flex flex-wrap items-center gap-6 px-4 py-3 bg-muted/20 border-b border-default justify-between w-full">
      <div class="flex flex-wrap items-center gap-6">
        {propKeys.map((prop) => (
          <div class="flex items-center gap-2 prop-control-group" data-prop={prop}>
            <label class="text-xs font-semibold text-muted uppercase tracking-wider">{prop}:</label>
            <div class="flex items-center gap-1.5">
              <RLSelect
                items={resolvedPropsConfig[prop]}
                value={defaultProps ? defaultProps[prop] : ""}
                name={prop}
                size="sm"
              />
              {togglingPattern === "icon" && propsConfig?.[prop] && propsConfig[prop].length > 1 && (
                <RLButton class="compare-prop-btn" size="sm" variant="ghost" color="neutral" title={`Compare all ${prop}s`} square>
                  <span class="i-lucide-layout-grid size-3.5"></span>
                </RLButton>
              )}
              {togglingPattern === "pill-toggle" && propsConfig?.[prop] && propsConfig[prop].length > 1 && (
                <RLButton class="compare-prop-btn" size="xs" variant="outline" color="neutral" rounded title={`Compare all ${prop}s`}>
                  Compare
                </RLButton>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Segmented Control for Layout Mode -->
      {togglingPattern === "tab-segmented" && (
        <div class="flex items-center gap-1 bg-muted/40 p-0.5 rounded-lg border border-default/40 mode-segmented-control ml-auto">
          <RLButton class="mode-tab active bg-neutral-50 text-highlighted shadow-xs border border-default/40" size="xs" variant="ghost" color="neutral" data-mode="single">Single Preview</RLButton>
          <RLButton class="mode-tab text-muted" size="xs" variant="ghost" color="neutral" data-mode="compare">Compare All</RLButton>
        </div>
      )}
    </div>
  )}

  <!-- Tabs & Actions -->
  <div class="controls-area p-sm border-b border-default flex items-center justify-between gap-md">
      {hasCode && (
        <div class="flex items-center gap-sm">
          {hasAstroCode && (
            <RLButton class="showcase-tab active bg-neutral-50 text-highlighted shadow-sm border border-default" size="sm" variant="ghost" color="neutral" data-lang="astro">Astro</RLButton>
          )}
          {hasSolidCode && (
            <RLButton class={`showcase-tab ${defaultCodeLang === 'tsx' ? 'active bg-neutral-50 text-highlighted shadow-sm border border-default' : ''}`} size="sm" variant="ghost" color="neutral" data-lang="tsx">Solid</RLButton>
          )}
        </div>
      )}

    <div class="flex items-center gap-1.5">
         <RLPopover class="highlight-slots-wrapper" placement="bottom-end" ui={{ content: "right-0 w-80 text-xs flex flex-col gap-3" }}>
            <RLButton slot="trigger" class="highlight-slots" size="sm" variant="ghost" color="neutral" title="Highlight component slots" square>
               <span class="i-lucide-boxes size-4"></span>
            </RLButton>
            <span class="font-semibold text-sm text-highlighted">Slots</span>
            <RLSeparator />
            <div class="slots-list flex flex-col gap-3 max-h-60 overflow-y-auto pr-1">
              <!-- Slots populated by JS -->
            </div>
         </RLPopover>
         <RLButton href={playground || "#"} target={playground ? "_blank" : undefined} rel="noopener noreferrer" class="open-playground" size="sm" variant="ghost" color="neutral" title="Open in Playground" square>
            <span class="i-lucide-flask-conical size-4"></span>
         </RLButton>
    </div>
  </div>

  <!-- Preview Area -->
  <div class="preview-area px-4 py-6 flex items-center justify-center min-h-[120px] border-b border-default relative">
    <div class="absolute top-2 right-4 z-10">
        <div class="text-xs bg-muted text-muted px-2 py-1 rounded border border-default">Preview</div>
    </div>
    <div class="preview-slot-wrapper flex items-center justify-center w-full">
      <slot />
    </div>
  </div>

  <!-- Code Sample -->
  {hasCode && (
    <div class="code-area relative p-4">
      <div class="absolute top-2 right-2 z-10">
        <RLButton icon="i-lucide-copy" class="copy-code" size="sm" variant="ghost" color="neutral" />
      </div>

      {hasAstroCode && (
        <div class="code-block" data-lang="astro">
          <slot name="code-astro" />
        </div>
      )}
      {hasSolidCode && (
        <div class="code-block" data-lang="tsx">
          <slot name="code-solid" />
        </div>
      )}
    </div>
  )}
</div>

<style>
  .component-showcase {
    margin-block: 1.5rem;
    overflow: visible;
  }

  .component-showcase > :first-child {
    border-top-left-radius: 0.75rem;
    border-top-right-radius: 0.75rem;
  }

  .component-showcase > :last-child,
  .component-showcase > :last-child pre,
  .component-showcase > :last-child code {
    border-bottom-left-radius: 0.75rem;
    border-bottom-right-radius: 0.75rem;
  }

  .showcase-tab.active {
    color: var(--rl-primary-500);
  }

  .code-area :global(pre),
  .code-area :global(code) {
    background-color: transparent !important;
    background: transparent !important;
    margin: 0 !important;
    border-radius: 0 !important;
    border-width: 0 !important;
  }

  .code-area :global(pre) {
    padding: 0 !important;
  }

  /* Slot Visualizer */
  .highlight-slots.active {
    background-color: var(--rl-primary-500);
    color: white;
  }
</style>

<script>
  // Slot visualizer: refresh after dynamic content swaps
  function refreshSlotVisualizer(showcase: any) {
    const s = showcase.slotVis;
    if (!s) return;

    const slotsList = showcase.querySelector('.slots-list');
    if (!slotsList) return;

    slotsList.innerHTML = '';

    let themeSlots = JSON.parse(showcase.getAttribute('data-theme-slots') || '[]') as string[];
    const previewWrapper = showcase.querySelector('.preview-slot-wrapper');
    const previewArea = showcase.querySelector('.preview-area');

    if (themeSlots.length === 0 && previewWrapper) {
      const DOMSlots = new Set();
      Array.from(previewWrapper.querySelectorAll('[data-slot]')).forEach((el: any) => {
        DOMSlots.add(el.getAttribute('data-slot'));
      });
      const firstChild = previewWrapper.firstElementChild as HTMLElement;
      if (firstChild) {
        DOMSlots.add(firstChild.getAttribute('data-slot') || 'root');
      }
      themeSlots = Array.from(DOMSlots).filter(Boolean) as string[];
    }

    if (themeSlots.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'text-muted text-center py-4 font-sans';
      empty.textContent = 'No theme slots defined';
      slotsList.appendChild(empty);
      return;
    }

    // Get currently active classes for each slot
    let resolvedSlots: any = {};
    if (showcase.classList.contains('dynamic-showcase')) {
      const propKeys = JSON.parse(showcase.getAttribute('data-props') || '[]') as string[];
      const currentProps: Record<string, string> = {};
      propKeys.forEach((prop: string) => {
        const input = showcase.querySelector(`select[name="${prop}"]`) as HTMLInputElement;
        if (input) currentProps[prop] = input.value;
      });
      const combinationClasses = JSON.parse(showcase.getAttribute('data-combinations') || '{}') as Record<string, any>;
      const keyStr = propKeys.map((k: string) => `${k}:${currentProps[k]}`).join('|');
      resolvedSlots = combinationClasses[keyStr] || {};
    }

    const initialThemeClasses = JSON.parse(showcase.getAttribute('data-initial-theme') || '{}') as Record<string, string>;

    // Determine which slot is the default slot for this component
    let defaultSlotName = '';
    if (themeSlots.includes('default')) {
      defaultSlotName = 'default';
    } else if (themeSlots.includes('content')) {
      defaultSlotName = 'content';
    } else if (themeSlots.includes('label')) {
      defaultSlotName = 'label';
    }

    themeSlots.forEach((slot: string) => {
      let targets: HTMLElement[] = [];
      if (previewWrapper) {
        if (slot === 'root') {
          const roots = Array.from(previewWrapper.querySelectorAll('[data-slot="root"]')) as HTMLElement[];
          if (roots.length > 0) {
            targets = roots;
          } else {
            const children = Array.from(previewWrapper.children) as HTMLElement[];
            const firstChild = children[0];
            if (firstChild && children.length === 1 && (firstChild.classList.contains('flex') || firstChild.classList.contains('grid'))) {
              targets = Array.from(firstChild.children) as HTMLElement[];
            } else {
              targets = children;
            }
          }
        } else {
          const kebabSlot = slot.replace(/([A-Z])/g, "-$1").toLowerCase();
          targets = Array.from(previewWrapper.querySelectorAll(`[data-slot="${slot}"], [data-slot="${kebabSlot}"]`)) as HTMLElement[];

          if (targets.length === 0 && (slot === 'label' || slot === 'content' || slot === 'default')) {
            const roots = Array.from(previewWrapper.querySelectorAll('[data-slot="root"]')) as HTMLElement[];
            const actualRoots = (roots.length > 0 ? roots : Array.from(previewWrapper.children)) as HTMLElement[];

            // Build a list of all other slot names in kebab-case and camelCase to exclude
            const otherSlotsKebab = themeSlots
              .filter((slotName: string) => slotName !== slot)
              .map((slotName: string) => slotName.replace(/([A-Z])/g, "-$1").toLowerCase());
            const otherSlotsSet = new Set(otherSlotsKebab);
            themeSlots.filter((slotName: string) => slotName !== slot).forEach((slotName: string) => otherSlotsSet.add(slotName));

            actualRoots.forEach((rootEl: HTMLElement) => {
              Array.from(rootEl.children).forEach((child: any) => {
                const childSlot = child.getAttribute('data-slot');
                if (!childSlot || childSlot === slot || childSlot === 'default') {
                  const childSlotKebab = childSlot ? childSlot.replace(/([A-Z])/g, "-$1").toLowerCase() : '';
                  if (!otherSlotsSet.has(childSlotKebab) && !otherSlotsSet.has(childSlot || '')) {
                    targets.push(child);
                  }
                }
              });
            });
          }
        }
      }

      const isRendered = targets.length > 0;

      let classes = '';
      if (isRendered) {
        const firstTarget = targets[0];
        if (firstTarget) classes = firstTarget.className;
      } else {
        const camelSlot = slot.replace(/-([a-z])/g, (_, letter) => letter?.toUpperCase() || '');
        classes = resolvedSlots[camelSlot] || resolvedSlots[slot] || initialThemeClasses[camelSlot] || initialThemeClasses[slot] || '';
      }

      classes = classes.split(/\s+/).filter(Boolean).join(' ');

      const item = document.createElement('div');
      item.className = 'slot-item p-2 rounded-lg hover:bg-muted/50 border border-transparent hover:border-default transition-all cursor-pointer text-left';
      item.innerHTML = `
        <div class="flex items-center justify-between gap-2 mb-1">
          <span class="font-mono font-medium text-highlighted text-xs">${slot}${slot === defaultSlotName ? ' <span class="text-[10px] text-muted/80 font-sans font-normal lowercase">(default)</span>' : ''}</span>
          ${isRendered ? '' : '<span class="text-[10px] text-destructive font-sans font-medium px-1.5 py-0.5 bg-destructive/10 rounded-full">not rendered</span>'}
        </div>
        <div class="classes-container font-mono text-[10px] text-muted break-all whitespace-normal line-clamp-2 transition-all">
          ${classes || '(no classes)'}
        </div>
        ${classes ? '<div class="expand-hint text-[9px] text-muted/60 mt-1 select-none font-sans">Click to expand</div>' : ''}
      `;

      if (classes) {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          const container = item.querySelector('.classes-container');
          const hint = item.querySelector('.expand-hint');
          if (container && hint) {
            const isExpanded = container.classList.contains('line-clamp-none');
            if (isExpanded) {
              container.classList.remove('line-clamp-none');
              container.classList.add('line-clamp-2');
              hint.textContent = 'Click to expand';
            } else {
              container.classList.remove('line-clamp-2');
              container.classList.add('line-clamp-none');
              hint.textContent = 'Click to collapse';
            }
          }
        });
      }

      if (isRendered) {
        item.addEventListener('mouseenter', () => {
          if (!previewArea) return;

          if (s.overlays) {
            s.overlays.forEach((o: any) => o.remove());
          }
          s.overlays = [];

          const areaRect = previewArea.getBoundingClientRect();

          targets.forEach((targetEl: HTMLElement) => {
            const rect = targetEl.getBoundingClientRect();
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:absolute;pointer-events:none;z-index:10;transition:all 150ms ease;border:2px dashed #ef4444;border-radius:4px;';
            const label = document.createElement('span');
            label.style.cssText = 'position:absolute;top:-20px;left:-2px;font-size:11px;font-weight:600;background:#ef4444;color:white;padding:1px 6px;border-radius:3px;white-space:nowrap;font-family:monospace;line-height:1.4;';
            label.textContent = slot;
            overlay.appendChild(label);

            overlay.style.top = (rect.top - areaRect.top - 2) + 'px';
            overlay.style.left = (rect.left - areaRect.left - 2) + 'px';
            overlay.style.width = (rect.width + 4) + 'px';
            overlay.style.height = (rect.height + 4) + 'px';

            previewArea.appendChild(overlay);
            s.overlays.push(overlay);
          });
        });

        item.addEventListener('mouseleave', () => {
          if (s.overlays) {
            s.overlays.forEach((o: any) => o.remove());
            s.overlays = null;
          }
        });
      }

      slotsList.appendChild(item);

      // Check if text is actually cropped/clamped, otherwise hide the expand hint
      const container = item.querySelector('.classes-container');
      const hint = item.querySelector('.expand-hint');
      if (container && hint) {
        if (container.scrollHeight <= container.clientHeight) {
          hint.remove();
        }
      }
    });
  }

  // Helper to get static/custom classes of an element (classes not managed by theme defaults)
  function getCustomClasses(element: HTMLElement, initialClassesForSlot: string) {
    if (!element) return [];
    const currentClasses = element.className.split(/\s+/).filter(Boolean);
    const initialSet = new Set(initialClassesForSlot.split(/\s+/).filter(Boolean));
    return currentClasses.filter((c: string) => !initialSet.has(c));
  }

  function initShowcases() {
    document.querySelectorAll('.component-showcase').forEach(showcase => {
      const tabs = showcase.querySelectorAll('.showcase-tab');
      const codeBlocks = showcase.querySelectorAll('.code-block');
      const copyBtn = showcase.querySelector('.copy-code');

      // Tabbing behavior
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const lang = tab.getAttribute('data-lang');

          tabs.forEach(t => {
            t.classList.remove('active', 'bg-neutral-50', 'text-highlighted', 'shadow-sm', 'border', 'border-default');
            t.classList.add('text-muted');
          });

          tab.classList.add('active', 'bg-neutral-50', 'text-highlighted', 'shadow-sm', 'border', 'border-default');
          tab.classList.remove('text-muted');

          codeBlocks.forEach(block => {
            if (block.getAttribute('data-lang') === lang) {
              block.classList.remove('hidden');
            } else {
              block.classList.add('hidden');
            }
          });
        });
      });

      // Initialize code block visibility from active tab
      const activeTab = showcase.querySelector('.showcase-tab.active');
      const activeLang = activeTab?.getAttribute('data-lang');
      if (activeLang) {
        codeBlocks.forEach(block => {
          if (block.getAttribute('data-lang') !== activeLang) {
            block.classList.add('hidden');
          }
        });
      }

      // Copy code behavior
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const visibleCode = showcase.querySelector('.code-block:not(.hidden) code, .code-block:not(.hidden) pre');
          if (visibleCode) {
            navigator.clipboard.writeText(visibleCode.textContent || '');
            const icon = copyBtn.querySelector('span');
            if (icon) {
              icon.className = 'i-lucide-check size-4 text-success-500';
              setTimeout(() => {
                icon.className = 'i-lucide-copy size-4';
              }, 2000);
            }
          }
        });
      }

      // === Slot Visualizer ===
      const highlightBtn = showcase.querySelector('.highlight-slots');
      const popoverWrapper = showcase.querySelector('.highlight-slots-wrapper');
      const popoverContent = popoverWrapper?.querySelector('[data-slot="content"]') || showcase.querySelector('.popover-content');

      const svState: { active: boolean; overlays: HTMLElement[] | null; activate?: () => void; deactivate?: () => void } = {
        active: false,
        overlays: null
      };
      (showcase as any).slotVis = svState;

      function svDeactivate() {
        svState.active = false;
        highlightBtn?.classList.remove('active');
        if (svState.overlays) {
          svState.overlays.forEach((o: HTMLElement) => o.remove());
          svState.overlays = null;
        }
      }

      function svActivate() {
        svState.active = true;
        highlightBtn?.classList.add('active');
        refreshSlotVisualizer(showcase);
      }

      svState.activate = svActivate;
      svState.deactivate = svDeactivate;

      if (popoverContent) {
        popoverContent.addEventListener('toggle', (e: Event) => {
          const te = e as ToggleEvent;
          const isOpen = te.newState === 'open';
          if (isOpen) {
            svActivate();
          } else {
            svDeactivate();
          }
        });
      }
    });

    // Apply pre-resolved theme classes dynamically while preserving custom static classes
    function applyStylesToClone(clone: HTMLElement, originalTemplate: HTMLElement, resolvedSlots: Record<string, string>, initialThemeClasses: Record<string, string>) {
      if (!resolvedSlots) return;

      const elementsToUpdate: { el: HTMLElement; orig: HTMLElement; slot: string }[] = [];
      const rootSlot = clone.getAttribute('data-slot');
      if (rootSlot) {
        elementsToUpdate.push({ el: clone, orig: originalTemplate, slot: rootSlot });
      } else {
        elementsToUpdate.push({ el: clone, orig: originalTemplate, slot: 'root' });
      }

      clone.querySelectorAll('[data-slot]').forEach(el => {
        const slotName = el.getAttribute('data-slot');
        if (slotName) {
          const origEl = originalTemplate.querySelector(`[data-slot="${slotName}"]`) as HTMLElement;
          elementsToUpdate.push({ el: el as HTMLElement, orig: origEl || el, slot: slotName });
        }
      });

      elementsToUpdate.forEach(({ el, orig, slot }) => {
        if (!el) return;
        const camelSlot = slot.replace(/-([a-z])/g, (_, letter) => letter?.toUpperCase() || '');
        const themeClasses = resolvedSlots[camelSlot] || resolvedSlots[slot] || '';
        const initialClasses = initialThemeClasses[camelSlot] || initialThemeClasses[slot] || '';

        const customClasses = getCustomClasses(orig, initialClasses);

        const finalClasses = [...themeClasses.split(/\s+/), ...customClasses]
          .filter(Boolean)
          .join(' ')
          .replace(/\s+/g, ' ')
          .trim();

        el.className = finalClasses;
      });
    }

    // Initialize Dynamic Showcases
    document.querySelectorAll('.dynamic-showcase').forEach(node => {
      const showcase = node as HTMLElement;
      const propKeys = JSON.parse(showcase.getAttribute('data-props') || '[]') as string[];
      const propsConfig = JSON.parse(showcase.getAttribute('data-config') || '{}') as Record<string, string[]>;
      const togglingPattern = showcase.getAttribute('data-pattern') || 'icon';

      const combinationClasses = JSON.parse(showcase.getAttribute('data-combinations') || '{}') as Record<string, Record<string, string>>;
      const initialThemeClasses = JSON.parse(showcase.getAttribute('data-initial-theme') || '{}') as Record<string, string>;

      const previewWrapper = showcase.querySelector('.preview-slot-wrapper');

      const compareButtons = showcase.querySelectorAll('.compare-prop-btn');
      const modeTabs = showcase.querySelectorAll('.mode-tab');

      let comparedProp: string | null = null;

      const originalTemplate = previewWrapper?.firstElementChild?.cloneNode(true) as HTMLElement | undefined;

      function updateComponent() {
        if (!originalTemplate || !previewWrapper) return;

        const currentProps: Record<string, string> = {};

        propKeys.forEach((prop: string) => {
          const input = showcase.querySelector(`select[name="${prop}"]`) as HTMLInputElement | null;
          if (input) {
            currentProps[prop] = input.value;
          }
        });

        if (togglingPattern === "select-option") {
          comparedProp = null;
          propKeys.forEach((prop: string) => {
            if (currentProps[prop] === "— Compare All —") {
              comparedProp = prop;
            }
          });

          propKeys.forEach((prop: string) => {
            const selectWrapper = showcase.querySelector(`.prop-control-group[data-prop="${prop}"] select.rl-select`);
            if (selectWrapper) {
              if (comparedProp && prop !== comparedProp) {
                selectWrapper.setAttribute('disabled', 'true');
                selectWrapper.classList.add('opacity-50', 'pointer-events-none');
              } else {
                selectWrapper.removeAttribute('disabled');
                selectWrapper.classList.remove('opacity-50', 'pointer-events-none');
              }
            }
          });
        }

        const valuesToCompare = comparedProp ? propsConfig[comparedProp] : undefined;
        if (comparedProp && valuesToCompare) {
          previewWrapper.innerHTML = '';
          const grid = document.createElement('div');
          grid.className = "flex flex-wrap gap-4 items-center justify-center w-full";

          valuesToCompare.forEach((val: string) => {
            const clone = originalTemplate.cloneNode(true) as HTMLElement;

            const activeVariants: Record<string, string> = { ...currentProps };
            activeVariants[comparedProp as string] = val;

            const keyStr = propKeys.map((k: string) => `${k}:${activeVariants[k]}`).join('|');
            const resolvedSlots = combinationClasses[keyStr];

            if (resolvedSlots) {
              applyStylesToClone(clone, originalTemplate, resolvedSlots, initialThemeClasses);
            }

            const labelEl = clone.querySelector('[data-slot="label"]') || (clone.getAttribute('data-slot') === 'label' ? clone : null);
            if (labelEl) {
              labelEl.textContent = val;
            }

            grid.appendChild(clone);
          });
          previewWrapper.appendChild(grid);
        } else {
          previewWrapper.innerHTML = '';
          const clone = originalTemplate.cloneNode(true) as HTMLElement;

          const keyStr = propKeys.map((k: string) => `${k}:${currentProps[k]}`).join('|');
          const resolvedSlots = combinationClasses[keyStr];

          if (resolvedSlots) {
            applyStylesToClone(clone, originalTemplate, resolvedSlots, initialThemeClasses);
          }

          previewWrapper.appendChild(clone);
        }

        refreshSlotVisualizer(showcase);
      }

      if (togglingPattern === "icon" || togglingPattern === "pill-toggle") {
        compareButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            const propGroup = btn.closest('.prop-control-group');
            const propName = propGroup?.getAttribute('data-prop');

            if (!propName) return;

            if (comparedProp === propName) {
              comparedProp = null;
              if (togglingPattern === "icon") {
                btn.classList.remove('bg-accented', 'text-highlighted');
              } else {
                btn.classList.remove('bg-primary-500', 'text-white', 'border-primary-500');
                btn.classList.add('text-muted', 'border-default/60');
              }
              showcase.querySelectorAll('.prop-control-group select.rl-select').forEach(sel => {
                sel.removeAttribute('disabled');
                sel.classList.remove('opacity-50', 'pointer-events-none');
              });
            } else {
              comparedProp = propName;
              if (togglingPattern === "icon") {
                compareButtons.forEach(b => b.classList.remove('bg-accented', 'text-highlighted'));
                btn.classList.add('bg-accented', 'text-highlighted');
              } else {
                compareButtons.forEach(b => {
                  b.classList.remove('bg-primary-500', 'text-white', 'border-primary-500');
                  b.classList.add('text-muted', 'border-default/60');
                });
                btn.classList.remove('text-muted', 'border-default/60');
                btn.classList.add('bg-primary-500', 'text-white', 'border-primary-500');
              }

              showcase.querySelectorAll('.prop-control-group').forEach(group => {
                const name = group.getAttribute('data-prop');
                const selectWrapper = group.querySelector('select.rl-select');
                if (name !== comparedProp && selectWrapper) {
                  selectWrapper.setAttribute('disabled', 'true');
                  selectWrapper.classList.add('opacity-50', 'pointer-events-none');
                } else if (selectWrapper) {
                  selectWrapper.removeAttribute('disabled');
                  selectWrapper.classList.remove('opacity-50', 'pointer-events-none');
                }
              });
            }

            updateComponent();
          });
        });
      }

      if (togglingPattern === "tab-segmented") {
        modeTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const mode = tab.getAttribute('data-mode');

            modeTabs.forEach(t => {
              t.classList.remove('active', 'bg-neutral-50', 'text-highlighted', 'shadow-xs', 'border', 'border-default/40');
              t.classList.add('text-muted');
            });

            tab.classList.add('active', 'bg-neutral-50', 'text-highlighted', 'shadow-xs', 'border', 'border-default/40');
            tab.classList.remove('text-muted');

            if (mode === 'compare') {
              comparedProp = propKeys[0] || null;
              showcase.querySelectorAll('.prop-control-group select.rl-select').forEach(sel => {
                sel.setAttribute('disabled', 'true');
                sel.classList.add('opacity-50', 'pointer-events-none');
              });
            } else {
              comparedProp = null;
              showcase.querySelectorAll('.prop-control-group select.rl-select').forEach(sel => {
                sel.removeAttribute('disabled');
                sel.classList.remove('opacity-50', 'pointer-events-none');
              });
            }

            updateComponent();
          });
        });
      }

      showcase.addEventListener('change', updateComponent);
      updateComponent();
    });
  }

  document.addEventListener('astro:page-load', initShowcases);
  initShowcases();
</script>
