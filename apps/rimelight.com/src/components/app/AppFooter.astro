---
import RLAFooter from "@rimelight/ui/components/footer/RLAFooter.astro";
import RLALogo from "@rimelight/ui/components/logo/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import type { ButtonProps } from "@rimelight/ui/components/button/button.ts";
import RLALinkGroup from "@rimelight/ui/components/link-group/RLALinkGroup.astro";
import RLAThemeSelector from "@rimelight/ui/components/theme-selector/RLAThemeSelector.astro";
import RLALocaleSelector from "@rimelight/ui/components/locale-selector/RLALocaleSelector.astro";
import { t, getRelativeLocaleUrl } from "@rimelight/i18n";

const columns = [
  {
    label: t("app_footer.links_resources_label"),
    children: [
      {
        label: t("app_footer.links_resources_branding"),
        to: getRelativeLocaleUrl("/branding")
      }
    ]
  },
  {
    label: t("app_footer.links_legal_label"),
    children: [
      {
        label: t("app_footer.links_legal_terms-of-service"),
        to: getRelativeLocaleUrl("/legal/terms-of-service")
      },
      {
        label: t("app_footer.links_legal_code-of-conduct"),
        to: getRelativeLocaleUrl("/legal/code-of-conduct")
      },
      {
        label: t("app_footer.links_legal_privacy-policy"),
        to: getRelativeLocaleUrl("/legal/privacy-policy")
      },
      {
        label: t("app_footer.links_legal_cookie-policy"),
        to: getRelativeLocaleUrl("/legal/cookie-policy")
      },
      {
        label: t("app_footer.links_legal_shipping-policy"),
        to: getRelativeLocaleUrl("/legal/shipping-policy")
      },
      {
        label: t("app_footer.links_legal_other-documents"),
        to: getRelativeLocaleUrl("/legal")
      }
    ]
  }
];

const socials: ButtonProps[] = [
  {
    leadingIcon: "i-logos-instagram-icon?mask text-white hover:text-primary-500",
    href: "https://www.instagram.com/idantity.me"
  },
  {
    leadingIcon: "i-logos-discord-icon?mask text-white hover:text-primary-500",
    href: "https://discord.com/users/682049695173836979"
  },
  {
    leadingIcon: "i-logos-spotify-icon?mask text-white hover:text-primary-500",
    href: "https://open.spotify.com/user/v5m4qoc9j35ccc6nbzqcookvj?si=d795f9bc1cb34222"
  },
  {
    leadingIcon: "i-logos-github-icon?mask text-white hover:text-primary-500",
    href: "https://www.github.com/idantitydotme"
  },
  {
    leadingIcon: "i-logos-linkedin-icon?mask text-white hover:text-primary-500",
    href: "https://www.linkedin.com/daniel-marchi"
  }
];

const targetLanguages = [
  { code: 'en', label: 'English', href: getRelativeLocaleUrl('en', Astro.url.pathname.replace(/^\/[^/]+/, '') || '/') },
  { code: 'pt', label: "Português", href: getRelativeLocaleUrl('pt', Astro.url.pathname.replace(/^\/[^/]+/, '') || '/') },
];
---

<RLAFooter contain={false} class="rl-dark bg-black z-50">
  <div slot="left" class="flex flex-col items-center gap-xs lg:items-start flex-1">
    <div class="flex flex-col items-center gap-xs lg:items-start mt-auto">
      <RLALogo
        variant="logotype"
        class="h-6 w-auto"
        mode="color"
      />
      <p class="text-sm text-white">Accessing me.</p>
      <span class="text-sm text-white">© {new Date().getFullYear()} idantity.me</span>
    </div>
  </div>
  <div slot="center" class="flex flex-col md:flex-row gap-12">
    {columns.map(column => (
      <RLALinkGroup 
        title={column.label} 
        links={column.children.map(child => ({ label: child.label, href: child.to }))}
        theme="flat"
      />
    ))}
  </div>
  <div slot="right" class="flex flex-col items-center lg:items-end flex-1 justify-between gap-sm">
    <div class="flex flex-col gap-sm items-center lg:items-end">
      <RLAThemeSelector />
      <RLALocaleSelector locales={targetLanguages} currentLocale={Astro.currentLocale} />
    </div>
    <div class="flex flex-row flex-wrap gap-sm justify-center lg:justify-end items-center lg:items-end">
      {socials.map((social) => (
          <RLAButton
              size="xl"
              color="neutral"
              variant="ghost"
              {...social}
          />
      ))}
    </div>
  </div>
</RLAFooter>
