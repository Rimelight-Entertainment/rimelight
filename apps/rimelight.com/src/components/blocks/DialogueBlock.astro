---
import type { BaseBlock } from "@rimelight/cms"

interface Props {
  block: BaseBlock
  locale?: string
}

const { block } = Astro.props
const { character, parenthetical, line } = (block.props || {}) as any
---

<div class="my-3 mx-8 max-w-md">
  <div class="text-sm font-bold text-center text-amber-800">
    {character}
  </div>
  {parenthetical && (
    <div class="text-xs italic text-center text-neutral-600 mt-0.5">
      ({parenthetical})
    </div>
  )}
  <div class="text-sm text-center text-neutral-700 mt-1">{line}</div>
</div>
