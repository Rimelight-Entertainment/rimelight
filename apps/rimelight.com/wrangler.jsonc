{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rimelight-dot-com",
  "main": "./src/fetch.ts",
  "compatibility_date": "2026-08-27",
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "rimelight.com",
      "custom_domain": true
    },
    {
      "pattern": "www.rimelight.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "rimelight-dot-com",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "rimelight-dot-com_translations",
      "id": "e1ae79418e4c4532a9344102bf663861",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "namespace_id": "1001",
      "name": "MY_RATE_LIMITER",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "vars": {
    "CONSTRUCTION_MODE": "true",
    "EMAIL_DOMAIN": "rimelight.com"
  },
  "secrets": {
    "required": [
      "AUTH0_CLIENT_SECRET",
      "AUTH0_SECRET",
      "DATABASE_URL",
      "CONSTRUCTION_PASSPHRASE",
      "TURNSTILE_SITE_KEY",
      "TURNSTILE_SECRET_KEY",
      "GITHUB_TOKEN"
    ]
  }
}
