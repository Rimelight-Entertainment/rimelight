    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.6.0",
    "@types/node": "26.1.1",
    "@unocss/eslint-plugin": "66.7.5",
    "eslint-plugin-regexp": "3.1.1",
    "pkg-pr-new": "0.0.80",
    "vite-plus": "0.2.6"
  },
  "engines": {
    "node": ">=25.2.1"
  },
  "packageManager": "pnpm@12.0.0-alpha.21"
}
