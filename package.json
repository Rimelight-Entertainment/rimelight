{
  "name": "rimelight",
  "version": "0.1.0",
  "private": true,
  "description": "Rimelight Entertainment Monorepository",
  "keywords": [
    "astro",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
