{
  "name": "@rimelight/security",
  "version": "0.0.30",
  "private": false,
  "description": "Rimelight Entertainment's Security Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.mts",
      "import": "./dist/middleware/index.mjs"
    },
    "./construction": {
      "types": "./dist/construction/index.d.mts",
      "import": "./dist/construction/index.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./integration": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./turnstile": {
      "types": "./dist/turnstile.d.mts",
      "import": "./dist/turnstile.mjs"
    },
    "./head": {
      "types": "./dist/head.d.mts",
      "import": "./dist/head.mjs"
    },
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm run build",
    "check": "vp check --fix",
    "test": "vp test"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*"
  },
  "engines": {
    "node": ">=26.8.2"
  },
  "packageManager": "pnpm@12.5.1"
}
