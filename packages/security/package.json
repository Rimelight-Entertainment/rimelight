{
  "name": "@rimelight/security",
  "version": "0.0.39",
  "private": false,
  "description": "Rimelight Entertainment's Security Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#rimelight/security/*": {
      "types": "./node_modules/.rimelight/security/*.d.ts",
      "default": "./node_modules/.rimelight/security/*.js"
    },
    "#rimelight/*/client": {
      "types": "./node_modules/.rimelight/*/client.d.ts",
      "default": "./node_modules/.rimelight/*/client.js"
    },
    "#rimelight/*/server": {
      "types": "./node_modules/.rimelight/*/server.d.ts",
      "default": "./node_modules/.rimelight/*/server.js"
    },
    "#rimelight/*": {
      "types": "./node_modules/.rimelight/*/config.d.ts",
      "default": "./node_modules/.rimelight/*/config.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.mts",
      "import": "./dist/middleware.mjs"
    },
    "./head": {
      "types": "./dist/head.d.mts",
      "import": "./dist/head.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check --fix",
    "test": "vp test",
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*"
  },
  "peerDependencies": {
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.10.1"
}
