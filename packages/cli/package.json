{
  "name": "@rimelight/cli",
  "version": "0.0.24",
  "private": false,
  "description": "Rimelight Entertainment's Command Line Interface",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "bin": {
    "rimelight": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./prompts": {
      "types": "./dist/prompts.d.mts",
      "import": "./dist/prompts.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check --fix",
    "test": "vp test",
    "build": "vp pack",
    "prepack": "vp pack",
    "create": "node ./dist/cli.mjs create"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*"
  },
  "peerDependencies": {
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.11.2"
}
