---
import "@/styles/global.css";
import RLAHead from '@rimelight/ui/components/astro/RLAHead.astro';
import RLAMain from "@rimelight/ui/components/astro/RLAMain.astro";
import RLAThemeSelector from "@rimelight/ui/components/astro/RLAThemeSelector.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Rimelight Starter Test", description = "Replicating starter layout for clean CSP E2E diagnostics" } = Astro.props;

const siteConfig = {
  name: title,
  description: description
};
---

<!doctype html>
<html lang="en">
  <RLAHead title={siteConfig.name} description={siteConfig.description} config={siteConfig as any} ogLocale="en_US" rssFeed={{ href: '/rss.xml', title: siteConfig.name }} />
  <body>
    <RLAMain>
      <slot />
    </RLAMain>
  </body>
</html>
