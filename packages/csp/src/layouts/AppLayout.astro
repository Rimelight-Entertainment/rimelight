---
import "@/styles/global.css";
import RLAHead from '@rimelight/ui/components/astro/RLAHead.astro';
import RLAMain from "@rimelight/ui/components/astro/RLAMain.astro";
import RLAThemeSelector from "@rimelight/ui/components/astro/RLAThemeSelector.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Rimelight Starter Test", description = "Replicating starter layout for clean CSP E2E diagnostics" } = Astro.props;

const siteConfig = {
  name: title,
  description: description
};
---

<!doctype html>
<html lang="en">
  <RLAHead title={siteConfig.name} description={siteConfig.description} config={siteConfig as any} ogLocale="en_US" rssFeed={{ href: '/rss.xml', title: siteConfig.name }}>
    <script is:inline slot="head">
      (function() {
        const orig = document.createElement;
        document.createElement = function(tag, opts) {
          const el = orig.call(document, tag, opts);
          const lowTag = tag.toLowerCase();
          if (lowTag === 'script' || lowTag === 'style') {
            const nonce = document.querySelector('meta[name="csp-nonce"]')?.getAttribute('content') ||
                          Array.from(document.querySelectorAll('script')).find(s => s.nonce)?.nonce ||
                          document.querySelector('script[nonce]')?.nonce ||
                          document.querySelector('style[nonce]')?.nonce;
            if (nonce) {
              el.setAttribute('nonce', nonce);
              el.nonce = nonce;
            }
          }
          return el;
        };
      })();
    </script>
  </RLAHead>
  <body>
    <RLAMain>
      <slot />
    </RLAMain>
  </body>
</html>
