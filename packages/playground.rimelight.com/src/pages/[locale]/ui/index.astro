---

<AppLayout title="Interactive Component Diagnostics" description="Select any component below to run dynamic CSP-safety validations and diagnostic test environments.">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-white mb-2">Interactive Component Diagnostics</h1>
    <p class="text-neutral-400 mb-8 max-w-2xl">Select any component below to run dynamic CSP-safety validations and diagnostic test environments.</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-sm">
      {diagnosticLinks.map(link => (
        <a
          href={link.href}
          class="flex items-center justify-between p-sm rounded-md border border-neutral-800 bg-neutral-900/50 hover:bg-primary-500/10 hover:border-primary-500/50 transition-all duration-200 group text-white text-sm"
        >
          <span>{link.label}</span>
          <span class="i-lucide-arrow-right h-4 w-4 opacity-0 group-hover:opacity-100 transition-opacity text-primary-400" />
        </a>
      ))}
    </div>
  </div>
</AppLayout>
