---
import AppLayout from "@/layouts/AppLayout.astro";
import RLAAccordion from "@rimelight/ui/components/astro/RLAAccordion.astro";
---

<AppLayout title="CSP Test - RLAAccordion">
  <RLAAccordion
    items={[
      {
        label: "Is Rimelight UI free to use?",
        content: "Yes. Rimelight UI is a completely free and open source package under the MIT License (https://opensource.org/license/mit)."
      },
      {
        label: "Can I use Rimelight UI without Astro?",
        content: "For the time being, no. The library is strictly distributed as an Astro integration, but in theory could be modularized enough to be usable as a Vite plugin, and we are open to contributions on this topic."
      },
      {
        label: "Are other front-end frameworks supported?",
        content: "For the time being, no. The library currently only offers Astro and Vue components, but in theory could support other front-end frameworks, and we are open to contributions on this topic."
      },
      {
        label: "Is Rimelight UI customizable?",
        content: "All components can have their styles overridden per slot and per variant, either globally or per instance, but their basic structure is fixed."
      },
      {
        label: "Is Rimelight UI accessible?",
        content: "All components provide automatic ARIA attributes, keyboard navigation, focus management, and screen reader support. We offer an accessible foundation, but overrides and specific use cases might require additional accessibility considerations."
      }
    ]}
  />
</AppLayout>
