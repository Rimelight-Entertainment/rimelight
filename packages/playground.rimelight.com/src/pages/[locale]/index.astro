---
import AppLayout from "@/layouts/AppLayout.astro";
import { siteConfig } from "@/site.config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import { getCollection } from "astro:content";
import RLAPageSection from "@rimelight/ui/components/astro/RLAPageSection.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLAGrid from "@rimelight/ui/components/astro/RLAGrid.astro";
import RLAPost from "@rimelight/ui/components/astro/RLAPost.astro";

const activeLocale = Astro.currentLocale ?? "en";
currentLocale.set(activeLocale);

const messages = useI18n("page_home", {
  "section_hero_title": "Rimelight Starter Template",
  "section_hero_description": "Look around, test, and play with some of our interactive technologies.",
  "section_hero_link_github_label": "View on GitHub",
  "section_hero_link_use-template_label": "Use Template",
  "section_features_title": "One template for all your needs.",
  "section_features_description": "We only maintain a single template including all features. Strip out what you don't need (or hide it to keep the option open) instead of browsing a multitude of options.",
  "section_posts_title": "Latest Posts",
  "section_posts_description": "Read the latest updates to our projects.",
  "section_posts_view_all": "View All Posts",
  "section_cta_title": "Wish to join us?",
  "section_cta_description": "Explore our latest projects and get in touch.",
  "section_cta_start": "Get Started",
  "section_cta_contribute": "Join Us",
});

const latestPosts = (await getCollection("blog"))
  .filter((post) => post.id.startsWith(`${activeLocale}/`))
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroLinks = [
    {
        label: messages["section_hero_link_github_label"],
        href: getRelativeLocaleUrl(activeLocale, "/blog"),
        color: "primary",
        variant: "solid",
    }
];

const ctaLinks = [
    {
        label: messages["section_cta_start"],
        href: getRelativeLocaleUrl(activeLocale, "/blog"),
        color: "primary",
        variant: "solid"
    },
    {
        label: messages["section_cta_contribute"],
        href: getRelativeLocaleUrl(activeLocale, "/"),
        color: "primary",
        variant: "outline",
        trailingIcon: "i-lucide-arrow-right"
    }
];
---


<AppLayout title={siteConfig.name} description={siteConfig.description}>
  <RLAPageSection
    variant="hero"
    reverse={true}
    title={messages["section_hero_title"]}
    description={messages["section_hero_description"]}
    links={heroLinks}
  >
    <RLALogo class="pointer-events-none h-64 w-auto" variant="logomark" />
  </RLAPageSection>

  <RLAPageSection
    title={messages["section_features_title"]}
    description={messages["section_features_description"]}
    links={heroLinks}
  >
    <RLALogo class="pointer-events-none h-64 w-auto" variant="logomark" />
  </RLAPageSection>

  <RLAPageSection
    orientation="vertical"
    title={messages["section_posts_title"]}
    description={messages["section_posts_description"]}
  >
    <div slot="body" class="flex flex-col gap-xl">
      <RLAGrid>
        {
          latestPosts.map((post) => (
            <RLAPost
              variant="ghost"
              image={post.data.heroImage}
              date={post.data.pubDate}
              title={post.data.title}
              description={post.data.description}
              to={getRelativeLocaleUrl(activeLocale, `/blog/${post.id.replace(`${activeLocale}/`, "")}/`)}
            />
          ))
        }
      </RLAGrid>

      {latestPosts.length > 0 && (
        <RLAButton
          label={messages["section_posts_view_all"]}
          href={getRelativeLocaleUrl(activeLocale, "/blog")}
          color="primary"
          variant="link"
          trailingIcon="i-lucide-arrow-right"
        />
      )}
    </div>
  </RLAPageSection>

  <RLAPageSection
    variant="cta"
    ctaVariant="solid"
    title={messages["section_cta_title"]}
    description={messages["section_cta_description"]}
    links={ctaLinks}
  />
</AppLayout>
