---
import BlankLayout from '@/layouts/BlankLayout.astro'
import RLALogo from '@rimelight/ui/components/astro/RLALogo.astro'
import RLACard from "@rimelight/ui/components/astro/RLACard.astro"
import RLAForm from "@rimelight/ui/components/astro/RLAForm.astro"
import RLAFormField from "@rimelight/ui/components/astro/RLAFormField.astro"
import RLAInput from "@rimelight/ui/components/astro/RLAInput.astro"
import RLACheckbox from "@rimelight/ui/components/astro/RLACheckbox.astro"
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro"
import RLALocaleSelector from "@rimelight/ui/components/astro/RLALocaleSelector.astro";
import { useI18n, currentLocale } from 'astro-nanostores-i18n:runtime'

const activeLocale = Astro.currentLocale ?? 'en'
currentLocale.set(activeLocale)

const constructionAuth = (import.meta.env.CONSTRUCTION_AUTH ?? process.env.CONSTRUCTION_AUTH) === "true"

const messages = useI18n('construction', {
  constructionTitle: 'Under Construction',
  constructionHeading: 'THIS WEBSITE IS CURRENTLY IN CONSTRUCTION',
  constructionDescription: 'Please sign in if you have access.',
  constructionSignIn: 'Sign In',
})

const targetLanguages = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
  { code: 'pt', label: 'Português' },
]
---

<BlankLayout title={messages.constructionTitle} description={messages.constructionDescription}>
  <div class="flex min-h-screen flex-col items-center justify-center bg-black px-4 py-12">
    <div class="z-10 w-full max-w-md space-y-8 text-center">
      <div class="flex flex-col items-center gap-4">
        <RLALogo class="h-12 w-auto text-white" variant="logomark" mode="white" />
        <h1 class="m-0 text-3xl font-bold text-white sm:text-4xl">
          {messages.constructionHeading}
        </h1>
        <p class="m-0 text-neutral-400">{messages.constructionDescription}</p>
      </div>

      {constructionAuth ? (
        <RLACard class="bg-black">
          <div class="flex flex-col gap-4">
            <div id="auth-error" class="text-red-500 text-sm hidden"></div>
            <RLAForm id="auth-form">
              <div class="flex flex-col gap-4">
                <RLAFormField name="email" label="E-mail" required ui={{ label: 'text-white', description: 'text-neutral-500' }}>
                  <RLAInput type="email" name="email" placeholder="your@email.com" class="w-full" required />
                </RLAFormField>
                <RLAFormField name="password" label="Password" required ui={{ label: 'text-white', description: 'text-neutral-500' }}>
                  <RLAInput type="password" name="password" placeholder="" class="w-full" required />
                </RLAFormField>
                <RLACheckbox name="rememberMe" label="Remember me" checked ui={{ label: 'text-white' }} />
                <RLAButton type="submit" color="primary" variant="solid" block class="text-white bg-primary-500 hover:bg-primary-600" id="auth-submit">Sign In</RLAButton>
              </div>
            </RLAForm>
          </div>
        </RLACard>
      ) : (
        <p class="text-neutral-400">Please return at a later stage.</p>
      )}

      <div class="flex flex-col items-center gap-2 text-xs text-neutral-500">
        <span>&copy; {new Date().getFullYear()} Rimelight Entertainment</span>
        <RLALocaleSelector locales={targetLanguages} />
      </div>
    </div>
  </div>
</BlankLayout>