{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starter-dot-rimelight-dot-com",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "starter.rimelight.com",
      "custom_domain": true
    },
    {
      "pattern": "www.starter.rimelight.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "starter-dot-rimelight-dot-com"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "starter-dot-rimelight-dot-com_translations",
      "id": "8c09f90741704096bd1dcdf2abadc974"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starter-dot-rimelight-dot-com_db",
      "database_id": "0ddfa4b5-bccb-498f-9adc-a0c24c45d4f1",
      "migrations_dir": "./drizzle"
    }
  ],
  "vars": {
    "CONSTRUCTION_MODE": "false",
    "CONSTRUCTION_AUTH": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ChatRoom",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ]
}
