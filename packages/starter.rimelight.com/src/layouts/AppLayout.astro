---
import RLAHead from "@rimelight/ui/components/head/RLAHead.astro";
import AppHeader from '@/components/app/AppHeader.astro';
import RLABanner from "@rimelight/ui/components/banner/RLABanner.astro"
import RLAMain from "@rimelight/ui/components/main/RLAMain.astro"
import AppFooter from '@/components/app/AppFooter.astro';
import RLAScrollToTop from "@rimelight/ui/components/scroll-to-top/RLAScrollToTop.astro"
import RLAShortcuts from "@rimelight/ui/components/shortcuts/RLAShortcuts.astro"
import RLALayoutGrid from "@rimelight/ui/components/layout-grid/RLALayoutGrid.astro"
import RLAToast from "@rimelight/ui/components/toast/RLAToast.astro"
import RLAToaster from "@rimelight/ui/components/toaster/RLAToaster.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import { siteConfig } from '@/config/site.config';
import { Font } from 'astro:assets';
import { currentLocale, t, getRelativeLocaleUrl } from '@rimelight/i18n';

currentLocale.set(Astro.currentLocale ?? 'en');

interface AppLayoutProps {
	title: string;
	description: string;
	noindex?: boolean;
	is404?: boolean;
	robots?: string;
	languageAlternates?: Array<{ hreflang: string; href: string }>;
	ogImageSrc?: string;
	ogImageAlt?: string;
}

const { title, description, noindex, is404, robots, languageAlternates, ogImageSrc, ogImageAlt } = Astro.props as AppLayoutProps;

const localeMap: Record<string, string> = {
	en: 'en_US',
	pt: 'pt_BR',
	es: 'es_ES',
};
const ogLocale = localeMap[Astro.currentLocale || 'en'] || 'en_US';

const hasConsent = Astro.cookies.has("cookie-consent");
const ogImageUrl = (() => {
	if (ogImageSrc) return new URL(ogImageSrc, Astro.site).toString();
	const params = new URLSearchParams({ title, description });
	return new URL(`/open-graph/page.png?${params.toString()}`, Astro.site).toString();
})();
---

<!doctype html>
<html lang={Astro.currentLocale || 'en'}>
	<RLAHead title={title} description={description} config={siteConfig} ogLocale={ogLocale} rssFeed={{ href: '/rss.xml', title: siteConfig.name }} noindex={noindex} is404={is404} robots={robots} languageAlternates={languageAlternates} ogImage={ogImageSrc ? { src: ogImageSrc, alt: ogImageAlt || '' } : undefined}>
		<slot name="head" slot="head" />
		<Font cssVariable="--font-sans" preload={true} slot="head" />
		<Font cssVariable="--font-serif" preload={true} slot="head" />
		<Font cssVariable="--font-mono" preload={true} slot="head" />
    <meta property="og:image" content={ogImageUrl} />
	</RLAHead>
	<body class="isolate">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-background focus:text-foreground">
			{t("app_layout.skipToContent")}
		</a>
		<RLABanner
			contain={false}
			dismissable
			dismissId="v2-announcement"
			stackIndex={0}
			class="bg-primary text-primary-foreground font-medium"
			actions={[
				{ label: "Learn more", href: "/docs", variant: "solid" },
				{ label: "What's new", href: "/changelog", variant: "outline" }
			]}
		>
			New: Rimelight v2 is out
		</RLABanner>
		<AppHeader stackIndex={1} />
		<RLAMain id="main-content">
			<slot />
		</RLAMain>
		<AppFooter />
		<RLAScrollToTop showProgress={true} />
		<RLAShortcuts />
		<RLALayoutGrid />
		<RLAToaster />

		{!hasConsent && (
			<div id="cookie-notice-container" class="fixed bottom-4 right-4 left-4 sm:left-auto sm:max-w-md z-50 pointer-events-none transition-all duration-300">
				<RLAToast title={t("cookie_notice.title")} dismissable={false} class="pointer-events-auto shadow-2xl border-border bg-background/95 backdrop-blur-sm">
					<span slot="description">
						{t("cookie_notice.description_prefix")}
						<a href={getRelativeLocaleUrl('/legal/cookie-policy')} class="underline hover:text-primary transition-colors font-medium">{t("cookie_notice.cookie_policy_label")}</a>
						{t("cookie_notice.description_suffix")}
					</span>
					<Fragment slot="actions">
						<RLAButton id="cookie-allow" variant="solid" color="success" size="sm">
							{t("cookie_notice.allow_all")}
						</RLAButton>
						<RLAButton id="cookie-deny" variant="solid" color="error" size="sm">
							{t("cookie_notice.deny_all")}
						</RLAButton>
					</Fragment>
				</RLAToast>
			</div>
		)}

		<script>
			function initCookieNotice() {
				const container = document.getElementById("cookie-notice-container");
				if (!container) return;

				const allowBtn = container.querySelector("#cookie-allow");
				const denyBtn = container.querySelector("#cookie-deny");

				const setCookieAndDismiss = (consentValue: string) => {
					// Set cookie for 1 year
					const maxAge = 365 * 24 * 60 * 60;
					document.cookie = `cookie-consent=${consentValue}; path=/; max-age=${maxAge}; SameSite=Lax`;

					// Animate out
					container.classList.add("opacity-0", "translate-y-4");
					container.addEventListener("transitionend", () => {
						container.remove();
					}, { once: true });
				};

				allowBtn?.addEventListener("click", () => setCookieAndDismiss("allowed"));
				denyBtn?.addEventListener("click", () => setCookieAndDismiss("denied"));
			}

			initCookieNotice();
			document.addEventListener("astro:after-swap", initCookieNotice);
		</script>
	</body>
</html>
