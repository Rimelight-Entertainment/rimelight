---
import RLAHead from '@rimelight/ui/components/astro/RLAHead.astro';
import AppHeader from '@/components/app/AppHeader.astro';
import RLAMain from "@rimelight/ui/components/astro/RLAMain.astro"
import AppFooter from '@/components/app/AppFooter.astro';
import RLAScrollToTop from "@rimelight/ui/components/astro/RLAScrollToTop.astro"
import RLAShortcuts from "@rimelight/ui/components/astro/RLAShortcuts.astro"
import { siteConfig } from '@/site.config';
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { currentLocale, useI18n } from '@rimelight/i18n';

currentLocale.set(Astro.currentLocale ?? 'en');

interface AppLayoutProps {
	title: string;
	description: string;
	noindex?: boolean;
	is404?: boolean;
	robots?: string;
	languageAlternates?: Array<{ hreflang: string; href: string }>;
}

const { title, description, noindex, is404, robots, languageAlternates } = Astro.props as AppLayoutProps;

const localeMap: Record<string, string> = {
	en: 'en_US',
	pt: 'pt_BR',
	es: 'es_ES',
};
const ogLocale = localeMap[Astro.currentLocale || 'en'] || 'en_US';

const messages = useI18n(Astro, "app_layout", {
	skipToContent: "Skip to main content"
});
---

<!doctype html>
<html lang={Astro.currentLocale || 'en'}>
	<RLAHead title={title} description={description} config={siteConfig} ogLocale={ogLocale} rssFeed={{ href: '/rss.xml', title: siteConfig.name }} noindex={noindex} is404={is404} robots={robots} languageAlternates={languageAlternates}>
		<slot name="head" slot="head" />
		<Font cssVariable="--font-sans" preload={true} slot="head" />
		<Font cssVariable="--font-serif" preload={true} slot="head" />
		<Font cssVariable="--font-mono" preload={true} slot="head" />
	</RLAHead>
	<body class="isolate">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-background focus:text-foreground">
			{messages.skipToContent}
		</a>
		<AppHeader />
		<RLAMain id="main-content">
			<slot />
		</RLAMain>
		<AppFooter />
		<RLAScrollToTop showProgress={true} />
		<RLAShortcuts />
	</body>
</html>
