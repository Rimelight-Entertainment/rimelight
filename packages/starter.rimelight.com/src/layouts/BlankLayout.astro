---
import RLAHead from '@rimelight/ui/components/astro/RLAHead.astro';
import RLAMain from "@rimelight/ui/components/astro/RLAMain.astro"
import { siteConfig } from '@/site.config';
import '@/styles/global.css';
import { Font } from 'astro:assets';

interface BlankLayoutProps {
  title: string;
  description: string;
  noindex?: boolean;
  is404?: boolean;
  robots?: string;
}

const { title, description, noindex, is404, robots } = Astro.props as BlankLayoutProps;
---

<!doctype html>
<html lang="en">
  <RLAHead title={title} description={description} config={siteConfig} rssFeed={{ href: '/rss.xml', title: siteConfig.name }} noindex={noindex} is404={is404} robots={robots}>
    <slot name="head" slot="head" />
    <Font cssVariable="--font-sans" preload={true} slot="head" />
    <Font cssVariable="--font-serif" preload={true} slot="head" />
    <Font cssVariable="--font-mono" preload={true} slot="head" />
  </RLAHead>
  <body>
    <RLAMain>
      <slot />
    </RLAMain>
  </body>
</html>
