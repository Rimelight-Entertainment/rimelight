---
import RLAFooter from "@rimelight/ui/components/astro/RLAFooter.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import type { ButtonProps, LinkGroupProps } from "@rimelight/ui/types";
import RLALinkGroup from "@rimelight/ui/components/astro/RLALinkGroup.astro";
import RLAThemeSelector from "@rimelight/ui/components/astro/RLAThemeSelector.astro";
import RLALocaleSelector from "@rimelight/ui/components/astro/RLALocaleSelector.astro";
import { useI18n, getRelativeLocaleUrl } from "@rimelight/i18n";

const messages = useI18n(Astro, "app_footer", {
  "links_resources_label": "Resources",
  "links_resources_branding": "Branding",
  "links_legal_label": "Legal",
  "links_legal_privacy-policy": "Privacy Policy",
  "links_legal_other-documents": "Other Documents"
});

const footerGroups: LinkGroupProps[] = [
  {
    label: messages["links_resources_label"],
    links: [
      {
        label: messages["links_resources_branding"],
        href: getRelativeLocaleUrl("/branding")
      }
    ]
  },
  {
    label: messages["links_legal_label"],
    links: [
      {
        label: messages["links_legal_privacy-policy"],
        href: getRelativeLocaleUrl("/legal/privacy-policy")
      },
      {
        label: messages["links_legal_other-documents"],
        href: getRelativeLocaleUrl("/legal")
      }
    ]
  }
];

const socials: ButtonProps[] = [
  {
    leadingIcon: "i-logos-astro-icon?mask text-white group-hover:text-primary-500",
    href: "https://astro.build/"
  },
  {
    leadingIcon: "i-logos-github-icon?mask text-white group-hover:text-primary-500",
    href: "https://github.com/"
  }
];

const targetLanguages = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
  { code: 'pt', label: "Português" }
];
---

<RLAFooter contain={false} class="rl-dark bg-black z-50">
  <div slot="left" class="flex flex-col gap-xl justify-between items-center lg:items-start">
    <div class="text-center lg:text-left">
      Newsletter Signup
    </div>
    <div class="flex flex-col gap-2xs items-center lg:items-start">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="white"
      />
      <p class="text-sm text-center lg:text-left">Rimelight Starter</p>
      <span class="text-sm text-center lg:text-left">© {new Date().getFullYear()} Rimelight Entertainment</span>
    </div>
  </div>

  <div slot="center" class="flex flex-col md:flex-row gap-xl">
    {footerGroups.map(group => (
      <RLALinkGroup
        {...group}
      />
    ))}
  </div>

  <div slot="right" class="flex flex-col gap-xl justify-between items-center lg:items-end">
    <div class="flex flex-col gap-sm items-center lg:items-end">
      <RLAThemeSelector />
      <RLALocaleSelector locales={targetLanguages} />
    </div>

    <div class="flex flex-row flex-wrap gap-sm justify-center lg:justify-end items-center lg:items-end">
      {socials.map((social) => (
        <RLAButton size="xl" color="neutral" variant="ghost" {...social} />
      ))}
    </div>
  </div>
</RLAFooter>
