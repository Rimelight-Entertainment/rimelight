---
import RLAHeader from "@rimelight/ui/components/header/RLAHeader.astro";
import RLALogo from "@rimelight/ui/components/logo/RLALogo.astro";
import RLANavigationMenu from "@rimelight/ui/components/navigation-menu/RLANavigationMenu.astro"
import RLALinkGroup from "@rimelight/ui/components/link-group/RLALinkGroup.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLASlideover from "@rimelight/ui/components/slideover/RLASlideover.astro";
import RLASearch from "@rimelight/ui/components/search/RLASearch.astro";
import RLAImage from "@rimelight/ui/components/image/RLAImage.astro";
import type { NavigationMenuItem } from "@rimelight/ui/components/navigation-menu/navigation-menu.ts"
import type { LinkGroupProps } from "@rimelight/ui/components/link-group/link-group.ts"
import type { ButtonProps } from "@rimelight/ui/components/button/button.ts";
import { useI18n, getRelativeLocaleUrl } from "@rimelight/i18n";

import RLAAvatar from "@rimelight/ui/components/avatar/RLAAvatar.astro";
import RLAPopover from "@rimelight/ui/components/popover/RLAPopover.astro";
import { auth } from "@/auth";

const placeholderImage = "https://cdn.rimelight.com/Images/placeholder.webp";

let session: any = null;
try {
  session = await auth.api.getSession({ headers: Astro.request.headers });
} catch (e) {}

const messages = useI18n("app_header");

const foundationLinkGroup: LinkGroupProps = {
  label: messages["link-groups_center_foundations_label"],
  leadingIcon: "i-lucide-layout",
  links: [
    {
      label: messages["link-groups_center_foundations_links_tokens"],
      href: getRelativeLocaleUrl('/docs/tokens')
    },
    {
      label: messages["link-groups_center_foundations_links_colors"],
      href: getRelativeLocaleUrl('/docs/colors')
    },
    {
      label: messages["link-groups_center_foundations_links_typography"],
      href: getRelativeLocaleUrl('/docs/typography')
    }
  ]
};

const componentsLinkGroup: LinkGroupProps = {
  label: messages["link-groups_center_components_label"],
  leadingIcon: "i-lucide-blocks",
  links: [
    {
      label: messages["link-groups_center_components_links_astro"],
      href: getRelativeLocaleUrl('/docs/astro')
    },
    {
      label: messages["link-groups_center_components_links_vue"],
      href: getRelativeLocaleUrl('/docs/vue')
    },
    {
      label: messages["link-groups_center_components_links_integrations"],
      href: getRelativeLocaleUrl('/docs/integrations')
    }
  ]
};

const resourcesLinkGroup: LinkGroupProps = {
  label: messages["link-groups_right_resources_label"],
  leadingIcon: "i-lucide-library",
  links: [
    {
      label: messages["link-groups_right_resources_links_docs"],
      href: "/docs",
      leadingIcon: "i-lucide-file-text size-4"
    },
    {
      label: messages["link-groups_right_resources_links_github"],
      href: "https://github.com/Rimelight-Entertainment/rimelight",
      leadingIcon: "i-logos-github-icon size-4"
    }
  ]
};

const leftLinks: NavigationMenuItem[] = [
  {
    label: messages["left-links_features_label"],
    to: getRelativeLocaleUrl('/features'),
    slot: "features" as const,
    children: [
      {
        label: messages["link-groups_center_foundations_label"],
        description: messages["link-groups_center_foundations_description"]
      },
      {
        label: messages["link-groups_center_components_label"],
        description: messages["link-groups_center_components_description"]
      },
      {
        label: messages["link-groups_center_integrations_label"],
        description: messages["link-groups_center_integrations_description"]
      }
    ]
  },
  {
    label: messages["left-links_about_label"],
    to: getRelativeLocaleUrl('/about')
  },
  {
    label: messages["left-links_blog_label"],
    to: getRelativeLocaleUrl('/blog')
  },
  {
    label: messages["left-links_docs_label"],
    to: getRelativeLocaleUrl('/docs')
  },
  {
    label: messages["left-links_dashboard_label"],
    to: getRelativeLocaleUrl('/dashboard')
  },
  {
    label: messages["left-links_chat_label"],
    to: getRelativeLocaleUrl('/chat')
  },
  {
    label: "Contact",
    to: getRelativeLocaleUrl('/contact')
  },
];

const actions: ButtonProps[] = [
  {
    color: "neutral",
    variant: "outline",
    href: getRelativeLocaleUrl('/auth/sign-up'),
    label: messages["actions_sign-up"] ?? "Sign Up"
  },
  {
    variant: "solid",
    color: "primary",
    href: getRelativeLocaleUrl('/auth/sign-in'),
    label: messages["actions_sign-in"] ?? "Sign In"
  }
];
const { stackIndex = 1 } = Astro.props;
---

<RLAHeader
  fixed={true}
  stackIndex={stackIndex}
  class="rl-dark scroll-header bg-black left-1/2"
>
  <div slot="left" class="flex items-center gap-md">
    <div class="hidden md:flex flex-row gap-md">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="color"
      />
      <RLANavigationMenu
        items={leftLinks}
        variant="link"
        ui={{
          viewportWrapper: 'top-[var(--rl-total-header-height,64px)] flex justify-center fixed left-0 right-0 z-[150] mt-0 bg-transparent',
          viewport: 'w-full rounded-none border-none shadow-xl mt-0 pointer-events-auto overflow-hidden',
          link: "text-white transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400"
        }}
      >
        <!-- Features Mega Menu -->
        <div slot="features-content" class="flex flex-col lg:flex-row gap-lg bg-[var(--card)] w-full">
          <div class="bg-[var(--card)] flex flex-col lg:flex-row gap-lg p-lg flex-1">
            <RLAImage
              class="h-32 lg:h-full w-full lg:w-auto object-cover lg:max-w-80 shrink-0 rounded"
              src={placeholderImage}
              alt=""
            />

            <div class="flex flex-col gap-sm flex-2">
              <RLALinkGroup {...foundationLinkGroup} ui={{ title: "!text-primary-500" }} />
              <RLALinkGroup {...componentsLinkGroup} ui={{ title: "!text-primary-500" }} />
            </div>
          </div>

          <div class="bg-[var(--accent)] p-lg w-64 shrink-0">
            <RLALinkGroup {...resourcesLinkGroup} ui={{ title: "!text-primary-500" }} />
          </div>
        </div>
      </RLANavigationMenu>
    </div>

    <div class="block md:hidden">
      <RLASlideover side="left" title="Menu">
        <RLAButton
          slot="trigger"
          color="neutral"
          variant="ghost"
          rounded={true}
          leadingIcon="i-lucide-menu"
          class="!text-white"
          aria-label="Open Menu"
        />

        <RLANavigationMenu
          items={leftLinks}
          orientation="vertical"
          variant="link"
          ui={{
            link: "flex justify-start items-center w-full text-left py-2 text-lg transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400"
          }}
        >
          <!-- Features Mega Menu (Mobile/Vertical) -->
          <div slot="features-content" class="flex flex-col lg:flex-row gap-lg bg-[var(--card)] w-full">
            <div class="bg-[var(--card)] flex flex-col lg:flex-row gap-lg p-lg flex-1">
              <RLAImage
                class="h-32 lg:h-full w-full lg:w-auto object-cover lg:max-w-80 shrink-0 rounded mb-2 lg:mb-0"
                src={placeholderImage}
                alt=""
                ui={{
                  trigger: "absolute inset-0 w-full h-full overflow-hidden rounded-lg",
                  triggerImage: "w-full h-full object-cover"
                }}
              />

              <div class="flex flex-col gap-sm flex-2">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-xl gap-y-4">
                  <RLALinkGroup {...foundationLinkGroup} ui={{ title: "!text-primary-500" }} />
                  <RLALinkGroup {...componentsLinkGroup} ui={{ title: "!text-primary-500" }} />
                </div>
              </div>
            </div>

            <div class="bg-[var(--accent)] p-lg w-64 shrink-0">
              <RLALinkGroup {...resourcesLinkGroup} ui={{ title: "!text-primary-500" }} />
            </div>
          </div>
        </RLANavigationMenu>
      </RLASlideover>
    </div>
  </div>

  <div slot="center" class="flex items-center gap-md">
    <div class="block md:hidden">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="color"
      />
    </div>
  </div>

  <div slot="right" class="flex items-center gap-md">
    <RLASearch />
    <RLAButton
      id="rla-shortcuts-btn"
      variant="ghost"
      color="neutral"
      leadingIcon="i-lucide-keyboard"
      aria-label="Keyboard Shortcuts"
    />
    <div class="hidden md:flex flex-row gap-md">
      {session ? (
        <RLAPopover placement="bottom-end" class="relative group/popover">
          <div slot="trigger" class="flex items-center gap-xs cursor-pointer text-white hover:text-primary-400 transition-colors py-1 px-2 rounded-lg">
            <div class="relative">
              <RLAAvatar src={session.user.image} alt={session.user.name} size="sm" />
              <span class={`absolute bottom-0 right-0 block h-2.5 w-2.5 rounded-full ring-2 ring-black ${
                session.user.availability === 'busy' ? 'bg-error-500' :
                session.user.availability === 'invisible' ? 'bg-neutral-500' :
                'bg-success-500'
              }`} />
            </div>
            <span class="hidden md:inline text-sm font-medium">{session.user.name}</span>
          </div>

          <div class="flex flex-col gap-2 min-w-[240px] text-neutral-900 dark:text-neutral-100">
            <div class="flex items-center gap-sm pb-2 border-b border-neutral-200 dark:border-neutral-800">
              <RLAAvatar src={session.user.image} alt={session.user.name} size="md" />
              <div class="flex flex-col">
                <span class="font-semibold text-sm">
                  {session.user.name} <span class="text-xs text-neutral-400 font-mono">#{session.user.tag || '0000'}</span>
                </span>
                <span class="text-xs text-neutral-500 truncate max-w-[150px]">{session.user.status || messages["user_status_placeholder"] || "Set a custom status..."}</span>
              </div>
            </div>

            <div class="flex flex-col gap-0.5">
              <RLAButton
                color="neutral"
                variant="ghost"
                block={true}
                class="!justify-start"
                href={getRelativeLocaleUrl('/dashboard')}
                leadingIcon="i-lucide-layout-dashboard"
                label={messages["user_dropdown_dashboard"] ?? "Dashboard"}
              />
            </div>

            <div class="border-t border-neutral-200 dark:border-neutral-800 my-1"></div>

            <div class="flex flex-col">
              <RLAButton
                color="neutral"
                variant="ghost"
                block={true}
                class="!justify-start text-error-500 hover:text-error-600"
                href={getRelativeLocaleUrl('/auth/sign-out')}
                leadingIcon="i-lucide-log-out"
                label={messages["user_dropdown_sign-out"] ?? "Sign Out"}
              />
            </div>
          </div>
        </RLAPopover>
      ) : (
        actions.map((buttonProps) => (
          <RLAButton {...buttonProps} />
        ))
      )}
    </div>

    <div class="block md:hidden">
      <RLASlideover side="right" title={session ? "Profile" : "Actions"}>
        <RLAButton
          slot="trigger"
          color="neutral"
          variant="ghost"
          rounded={true}
          leadingIcon={session ? "i-lucide-user" : "i-lucide-ellipsis-vertical"}
          class="!text-white"
          aria-label="Open Actions"
        />

        <div class="flex flex-col gap-md">
          {session ? (
            <div class="flex flex-col gap-md text-neutral-900 dark:text-neutral-100">
              <div class="flex items-center gap-sm pb-2 border-b border-neutral-200 dark:border-neutral-800">
                <RLAAvatar src={session.user.image} alt={session.user.name} size="md" />
                <div class="flex flex-col">
                  <span class="font-semibold text-sm">
                    {session.user.name} <span class="text-xs text-neutral-400 font-mono">#{session.user.tag || '0000'}</span>
                  </span>
                  <span class="text-xs text-neutral-500 truncate max-w-[150px]">{session.user.status || messages["user_status_placeholder"] || "Set a custom status..."}</span>
                </div>
              </div>
              <RLAButton
                color="neutral"
                variant="ghost"
                block={true}
                class="!justify-start"
                href={getRelativeLocaleUrl('/dashboard')}
                leadingIcon="i-lucide-layout-dashboard"
                label={messages["user_dropdown_dashboard"] ?? "Dashboard"}
              />
              <div class="border-t border-neutral-200 dark:border-neutral-800 my-1"></div>
              <RLAButton
                color="neutral"
                variant="ghost"
                block={true}
                class="!justify-start text-error-500 hover:text-error-600"
                href={getRelativeLocaleUrl('/auth/sign-out')}
                leadingIcon="i-lucide-log-out"
                label={messages["user_dropdown_sign-out"] ?? "Sign Out"}
              />
            </div>
          ) : (
            actions.map((buttonProps) => (
              <RLAButton {...buttonProps} block={true} />
            ))
          )}
        </div>
      </RLASlideover>
    </div>
  </div>
</RLAHeader>

<style is:global>
  @property --viewport-margin {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  @property --viewport-radius {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  :root {
    --header-margin-y: 12px;
    --header-margin-x: 24px;
  }

  @media (min-width: 640px) {
    :root {
      --header-margin-y: 16px;
      --header-margin-x: 32px;
    }
  }

  @media (min-width: 1024px) {
    :root {
      --header-margin-y: 24px;
      --header-margin-x: 48px;
    }
  }

  @keyframes shrinkHeader {
    from {
      transform: translateX(-50%) translateY(0);
      width: 100%;
      max-width: 100%;
    }
    to {
      transform: translateX(-50%) translateY(var(--header-margin-y));
      width: calc(100% - var(--header-margin-x));
      border-radius: 9999px;
    }
  }

  @keyframes shrinkViewport {
    from {
      --viewport-margin: 0px;
      --viewport-radius: 0px;
      width: 100%;
      max-width: 100%;
    }
    to {
      --viewport-margin: var(--header-margin-y);
      --viewport-radius: 16px;
      width: calc(100% - var(--header-margin-x));
    }
  }

  .scroll-header {
    left: 50%;
    animation: shrinkHeader linear both;
    animation-timeline: scroll(root);
    animation-range: 0 90px;
  }

  /* Starter override: Mega menu transitions on scroll */
  html [data-nav-viewport] {
    margin-top: var(--viewport-margin, 0px) !important;
    border-radius: var(--viewport-radius, 0px) !important;
    animation: shrinkViewport linear both;
    animation-timeline: scroll(root);
    animation-range: 0 90px;
  }

  /* Vertical mega menu content static override */
  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] {
    position: static !important;
    width: 100% !important;
    max-width: 100% !important;
    transform: none !important;
    box-shadow: none !important;
    border: none !important;
    background: transparent !important;
    padding: 8px 0 0 0 !important;
    display: block !important;
  }

  html [data-nav-menu][data-orientation="vertical"] [data-nav-content].hidden {
    display: none !important;
  }

  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] [slot="features-content"] {
    background: transparent !important;
    padding: 0 !important;
    width: 100% !important;
  }

  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] .p-lg,
  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] .p-xl {
    padding: 12px 4px !important;
  }

  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] .w-64 {
    width: 100% !important;
    background: transparent !important;
    padding: 12px 4px !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-header,
    html [data-nav-viewport] {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function setupShortcutsBtn() {
    const btn = document.getElementById("rla-shortcuts-btn");
    btn?.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent("rla-shortcuts:open"));
    });
  }
  setupShortcutsBtn();
  document.addEventListener("astro:after-swap", setupShortcutsBtn);
</script>
