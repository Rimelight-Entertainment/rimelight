---
import AppLayout from '@/layouts/AppLayout.astro'
import { actions, isInputError } from 'astro:actions'
import RLAFormField from '@rimelight/ui/components/astro/RLAFormField.astro'
import RLAInput from '@rimelight/ui/components/astro/RLAInput.astro'
import RLAForm from '@rimelight/ui/components/astro/RLAForm.astro'
import { useI18n } from '@rimelight/i18n'
import { isTurnstileEnabled } from '@/lib/turnstile'

const env = Astro.locals.runtime?.env
const turnstileEnabled = isTurnstileEnabled(env)
const siteKey = env?.TURNSTILE_SITE_KEY

const messages = useI18n(Astro, 'auth', {
  authSignInTitle: 'Sign in',
  authSignInDescription: 'Sign in to your account',
  authSignInNewUserMessage: 'Your account has been created. Please sign in.',
  authSignInEmail: 'E-mail',
  authSignInPassword: 'Password',
  authSignInButton: 'Sign in',
  authSignUpTitle: 'Sign up',
  authSignUpDescription: 'Create a new account',
  authSignUpFirstName: 'First name',
  authSignUpLastName: 'Last name',
  authSignUpEmail: 'E-mail',
  authSignUpPassword: 'Password',
  authSignUpButton: 'Sign up',
  authSignOutTitle: 'Sign out',
  authSignOutDescription: 'Sign out of your account',
  authSignOutConfirmMessage: 'Are you sure you want to sign out?',
  authSignOutButton: 'Sign out'
})

const result = Astro.getActionResult(actions.auth.signUp)

if (result && !result.error) {
  return Astro.redirect(getRelativeLocaleUrl('/auth/sign-in') + '?new')
}

const inputErrors = isInputError(result?.error) ? result.error.fields : {}
---

<AppLayout title={messages.authSignUpTitle} description={messages.authSignUpDescription}>
  {turnstileEnabled && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}
  {
    result?.error && !isInputError(result.error) && (
      <p>{result.error.message}</p>
    )
  }
  <RLAForm method="POST" action={actions.auth.signUp}>
    <RLAFormField label={messages.authSignUpFirstName} error={inputErrors.firstName?.[0]}>
      <RLAInput name="firstName" required />
    </RLAFormField>
    <RLAFormField label={messages.authSignUpLastName} error={inputErrors.lastName?.[0]}>
      <RLAInput name="lastName" required />
    </RLAFormField>
    <RLAFormField label={messages.authSignUpEmail} error={inputErrors.email?.[0]}>
      <RLAInput name="email" required type="email" />
    </RLAFormField>
    <RLAFormField label={messages.authSignUpPassword} error={inputErrors.password?.[0]}>
      <RLAInput name="password" required type="password" />
    </RLAFormField>

    {turnstileEnabled ? (
      <div class="cf-turnstile my-4" data-sitekey={siteKey} data-theme="dark"></div>
    ) : (
      <div class="text-[10px] text-neutral-500 my-4 border border-dashed border-neutral-800 p-2 text-center rounded">
        🛡️ {`[Turnstile Bot Check Mock (Disabled - Keys not configured)]`}
      </div>
    )}

    <button>{messages.authSignUpButton}</button>
  </RLAForm>
</AppLayout>
