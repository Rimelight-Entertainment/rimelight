---
import AppLayout from '@/layouts/AppLayout.astro';
import { useI18n } from '@rimelight/i18n';

const buildTimestamp = new Date().toISOString();

const messages = useI18n(Astro, 'deploy-test', {
  title: 'Deploy Test',
  description: 'Testing deployment pipeline'
});
---

<AppLayout title={messages.title} description={messages.description}>
  <main style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 60vh; padding: 2rem;">
    <h1 style="font-size: 2.5rem; font-weight: bold; color: var(--color-primary-500);">DEPLOY TEST</h1>
    <div style="margin-top: 1rem; padding: 1rem 2rem; background: var(--color-primary-500); color: white; border-radius: 0.5rem; font-size: 1.25rem;">
      Deployed at: {buildTimestamp}
    </div>
    <p style="margin-top: 2rem; font-size: 1rem; opacity: 0.7;">
      If you can see this, the Worker deployment is going through correctly.
    </p>
  </main>
</AppLayout>
