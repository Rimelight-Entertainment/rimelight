---
import AppLayout from "@/layouts/AppLayout.astro";
import { siteConfig } from "@/config/site.config";
import { t, getLocale, getRelativeLocaleUrl } from "@rimelight/i18n";
import { getCollection } from "astro:content";
import RLAPageSection from "@rimelight/ui/components/page-section/RLAPageSection.astro";
import RLALogo from "@rimelight/ui/components/logo/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLAGrid from "@rimelight/ui/components/grid/RLAGrid.astro";
import RLAPost from "@rimelight/ui/components/post/RLAPost.astro";
import RLAImage from "@rimelight/ui/components/image/RLAImage.astro";

const AboutHeroImage = "https://cdn.rimelight.com/Images/placeholder.webp";

const latestPosts = (await getCollection("blog"))
  .filter((post) => post.id.startsWith(`${getLocale()}/`))
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroLinks = [
  {
    label: t("page_home.section_hero_link_github_label"),
    href: getRelativeLocaleUrl("/blog"),
    color: "neutral",
    variant: "outline",
  },
  {
    label: t("page_home.section_hero_link_use-template_label"),
    href: getRelativeLocaleUrl("/blog"),
    color: "primary",
    variant: "solid",
  }
];

const featureLinks = [
  {
    label: "Browse Components",
    href: `https://rimelight.com/${getLocale()}/company/docs/packages/rimelight-ui/components/`,
    color: "primary",
    variant: "solid",
  }
];

const ctaLinks = [
  {
    label: t("page_home.section_cta_start"),
    href: getRelativeLocaleUrl("/blog"),
    color: "primary",
    variant: "solid"
  },
  {
    label: t("page_home.section_cta_contribute"),
    href: getRelativeLocaleUrl("/"),
    color: "primary",
    variant: "outline",
    trailingIcon: "i-lucide-arrow-right"
  }
];
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
  <RLAPageSection
    variant="hero"
    reverse={true}
    title={t("page_home.section_hero_title")}
    description={t("page_home.section_hero_description")}
    links={heroLinks}
  >
    <RLALogo class="pointer-events-none h-64 w-auto" variant="logomark" />
  </RLAPageSection>

  <RLAPageSection
    title={t("page_home.section_features_title")}
    description={t("page_home.section_features_description")}
    orientation="horizontal"
    links={featureLinks}
  >
    <RLAImage src={AboutHeroImage} alt="" ui={{ root: "w-full aspect-video relative block", trigger: "absolute inset-0 w-full h-full block", triggerImage: "absolute inset-0 w-full h-full object-cover rounded-lg" }} />
  </RLAPageSection>

  <RLAPageSection
    orientation="vertical"
    title={t("page_home.section_posts_title")}
    description={t("page_home.section_posts_description")}
  >
    <div slot="body" class="flex flex-col gap-xl">
      <RLAGrid cols={3}>
        {
          latestPosts.map((post) => (
            <RLAPost
              variant="ghost"
              image={post.data.heroImage}
              date={post.data.pubDate}
              title={post.data.title}
              description={post.data.description}
              to={getRelativeLocaleUrl(`/blog/${post.id.replace(`${getLocale()}/`, "")}/`)}
            />
          ))
        }
      </RLAGrid>

      {latestPosts.length > 0 && (
        <RLAButton
          label={t("page_home.section_posts_view_all")}
          href={getRelativeLocaleUrl("/blog")}
          color="primary"
          variant="link"
          trailingIcon="i-lucide-arrow-right"
        />
      )}
    </div>
  </RLAPageSection>

  <RLAPageSection
    variant="cta"
    ctaVariant="solid"
    title={t("page_home.section_cta_title")}
    description={t("page_home.section_cta_description")}
    links={ctaLinks}
  />
</AppLayout>
