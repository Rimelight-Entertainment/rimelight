---
import AuthAdminDashboardLayout from "@/layouts/AuthAdminDashboardLayout.astro";
import RLACard from "@rimelight/ui/components/card/RLACard.astro";
import RLAIcon from "@rimelight/ui/components/icon/RLAIcon.astro";
import RLADropdownMenu from "@rimelight/ui/components/dropdown-menu/RLADropdownMenu.astro";
import RLATable from "@rimelight/ui/components/table/RLATable.astro";
import type { TableColumn } from "@rimelight/ui/components/table/table.ts";
import { db } from "@/db";
import { session, user } from "@/db/schema";
import { eq, desc } from "drizzle-orm";

const activeSessions = await db
	.select({
		id: session.id,
		userId: session.userId,
		userName: user.name,
		userEmail: user.email,
		userRole: user.role,
		ipAddress: session.ipAddress,
		userAgent: session.userAgent,
		expiresAt: session.expiresAt,
		createdAt: session.createdAt
	})
	.from(session)
	.innerJoin(user, eq(session.userId, user.id))
	.orderBy(desc(session.createdAt));

const sessionColumns: TableColumn[] = [
	{ id: "user", accessorKey: "userName", header: "User", enableSorting: true },
	{ id: "ipAddress", accessorKey: "ipAddress", header: "IP Address", enableSorting: true },
	{ id: "userAgent", accessorKey: "userAgent", header: "User Agent / Client", enableSorting: true },
	{ id: "createdAt", accessorKey: "createdAt", header: "Issued Date", enableSorting: true },
	{ id: "expiresAt", accessorKey: "expiresAt", header: "Expires", enableSorting: true },
	{ id: "actions", header: "Actions", enableSorting: false, meta: { class: { th: "text-right", td: "text-right" } } }
];
---

<AuthAdminDashboardLayout
	title="Active Security Sessions"
	description="Monitor active authentication tokens, client IP addresses, and revoke sessions on demand."
	activeSection="sessions"
>
	<div class="flex flex-col gap-6">
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			<RLACard class="p-5 flex flex-col justify-between border-border shadow-sm">
				<div class="flex items-center justify-between">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Total Active Sessions</span>
					<RLAIcon name="i-lucide-key-round" class="size-5 text-primary" />
				</div>
				<span class="text-3xl font-bold text-highlighted mt-2">{activeSessions.length}</span>
			</RLACard>

			<RLACard class="p-5 flex flex-col justify-between border-border shadow-sm">
				<div class="flex items-center justify-between">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Security Audit</span>
					<RLAIcon name="i-lucide-shield-check" class="size-5 text-emerald-500" />
				</div>
				<span class="text-xs font-semibold text-emerald-500 mt-2 flex items-center gap-1">
					<span class="size-2 rounded-full bg-emerald-500"></span>
					Token Expiration Enforced (7 Days)
				</span>
			</RLACard>

			<RLACard class="p-5 flex flex-col justify-between border-border shadow-sm">
				<div class="flex items-center justify-between">
					<span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Cookies</span>
					<RLAIcon name="i-lucide-lock" class="size-5 text-purple-500" />
				</div>
				<span class="text-xs font-medium text-muted-foreground mt-2">
					HttpOnly / Secure SameSite Tokens
				</span>
			</RLACard>
		</div>

		<RLATable
			columns={sessionColumns}
			data={activeSessions}
			searchable
			searchPlaceholder="Filter sessions..."
			showColumnsToggle
			hoverable
			striped
			class="w-full"
		>
			<tbody slot="default" id="sessions-tbody" class="divide-y divide-border/40">
				{activeSessions.map((s) => {
					const actionItems = [
						[
							{ label: "Revoke Session", icon: "i-lucide-power", color: "error", action: "revoke-session" }
						]
					];

					return (
						<tr
							class="session-row hover:bg-muted/20 transition-colors"
							data-session-id={s.id}
							data-user-name={s.userName}
						>
							<td class="p-3.5" data-col-id="user">
								<div class="flex flex-col">
									<span class="font-semibold text-highlighted">{s.userName}</span>
									<span class="text-xs text-muted-foreground font-mono">{s.userEmail}</span>
								</div>
							</td>
							<td class="p-3.5 text-xs font-mono text-foreground" data-col-id="ipAddress">
								{s.ipAddress || "Internal / Unknown"}
							</td>
							<td class="p-3.5 text-xs text-muted-foreground max-w-xs truncate" title={s.userAgent || ""} data-col-id="userAgent">
								{s.userAgent || "Web Browser"}
							</td>
							<td class="p-3.5 text-xs text-muted-foreground whitespace-nowrap" data-col-id="createdAt">
								{new Date(s.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", hour: "2-digit", minute: "2-digit" })}
							</td>
							<td class="p-3.5 text-xs text-muted-foreground whitespace-nowrap" data-col-id="expiresAt">
								{new Date(s.expiresAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
							</td>
							<td class="p-3.5 text-right whitespace-nowrap" data-col-id="actions">
								<RLADropdownMenu
									items={actionItems as any}
									content={{ align: "end" }}
									size="sm"
								/>
							</td>
						</tr>
					);
				})}
			</tbody>
		</RLATable>
	</div>


	<script>
		document.addEventListener("DOMContentLoaded", () => {
			document.getElementById("sessions-tbody")?.addEventListener("click", async (e) => {
				const itemEl = (e.target as HTMLElement).closest("[data-item-action]") as HTMLElement | null;
				if (!itemEl) return;

				const action = itemEl.getAttribute("data-item-action");
				if (action !== "Revoke Session") return;

				const row = itemEl.closest(".session-row") as HTMLTableRowElement | null;
				if (!row) return;

				const sessionId = row.getAttribute("data-session-id");
				const userName = row.getAttribute("data-user-name");

				if (!sessionId) return;
				if (!confirm(`Are you sure you want to terminate active session for ${userName}?`)) return;

				try {
					const res = await fetch(`/api/admin/sessions/${sessionId}`, {
						method: "DELETE"
					});

					if (res.ok) {
						window.location.reload();
					} else {
						const data = (await res.json()) as { error?: string };
						alert(data.error || "Failed to revoke session.");
					}
				} catch {
					alert("Network error revoking session.");
				}
			});
		});
	</script>

</AuthAdminDashboardLayout>
