---
import AppLayout from '@/layouts/AppLayout.astro';
import RLAContainer from "@rimelight/ui/components/container/RLAContainer.astro";
import { db, posts } from '@/db';
import { desc } from 'drizzle-orm';

const allPosts = await db.select().from(posts).orderBy(desc(posts.createdAt));
---

<AppLayout title="CMS - Local Posts List" description="Query and manage database-backed posts locally">
  <RLAContainer class="py-16 posts-admin-container">
    <div class="cms-header">
      <h1>Local CMS D1 Database Posts</h1>
      <p class="subtitle">These posts are fetched dynamically from the local SQLite D1 simulation via Drizzle ORM.</p>
    </div>

    <div class="actions-bar">
      <a href={`/${Astro.currentLocale}/admin/posts/new`} class="btn btn-primary">Create New Post</a>
      <a href={`/${Astro.currentLocale}/admin/upload-test`} class="btn btn-secondary">Go to Upload Test</a>
    </div>

    <div class="posts-list">
      {allPosts.length === 0 ? (
        <div class="empty-state">
          <p>No posts in D1 database yet. Click "Create New Post" above to add one!</p>
        </div>
      ) : (
        <div class="grid">
          {allPosts.map((post) => (
            <div class="post-card">
              <div class="post-card-content">
                {post.coverImage && (
                  <div class="card-cover-preview">
                    <img src={post.coverImage} alt="Cover Preview" />
                  </div>
                )}
                <div class="post-details">
                  <div class="post-meta">
                    <span class="status-badge">{post.status}</span>
                    <span class="date">{post.createdAt.toLocaleDateString()}</span>
                  </div>
                  <h3>{post.title}</h3>
                  <p class="slug">Slug: <code>{post.slug}</code></p>
                  <div class="excerpt">
                    {post.content.substring(0, 150)}...
                  </div>
                  <div class="card-actions">
                    <a href={`/${Astro.currentLocale}/blog/d1/${post.slug}`} class="btn-link text-primary" target="_blank">View Post ↗</a>
                    <a href={`/${Astro.currentLocale}/admin/posts/${post.id}`} class="btn-link text-secondary">Edit Post ✎</a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </RLAContainer>
</AppLayout>

<style>
  .posts-admin-container {
    max-width: 1000px;
    margin: 0 auto;
    font-family: var(--font-sans), sans-serif;
  }

  .cms-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .cms-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #a3a3a3;
    font-size: 1.1rem;
  }

  .actions-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
    background: #171717;
    padding: 1rem 1.5rem;
    border-radius: 8px;
    border: 1px solid #262626;
  }

  .btn {
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: all 0.2s;
  }

  .btn-primary {
    background: #3b82f6;
    color: #fff;
    border: none;
  }

  .btn-primary:hover {
    background: #2563eb;
  }

  .btn-secondary {
    background: #262626;
    color: #e5e5e5;
    border: 1px solid #404040;
  }

  .btn-secondary:hover {
    background: #404040;
    color: #fff;
  }

  .posts-list {
    margin-top: 1rem;
  }

  .empty-state {
    text-align: center;
    background: #171717;
    border: 1px dashed #404040;
    border-radius: 12px;
    padding: 4rem 2rem;
    color: #a3a3a3;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .post-card {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .post-card:hover {
    border-color: #404040;
  }

  .post-card-content {
    display: flex;
  }

  @media (max-width: 640px) {
    .post-card-content {
      flex-direction: column;
    }
  }

  .card-cover-preview {
    width: 200px;
    min-width: 200px;
    border-right: 1px solid #262626;
    overflow: hidden;
    position: relative;
  }

  @media (max-width: 640px) {
    .card-cover-preview {
      width: 100%;
      height: 150px;
      border-right: none;
      border-bottom: 1px solid #262626;
    }
  }

  .card-cover-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-details {
    padding: 1.5rem;
    flex-grow: 1;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
  }

  .status-badge {
    background: #1e3a8a;
    color: #93c5fd;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .date {
    color: #737373;
  }

  .post-card h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.5rem 0;
  }

  .slug {
    font-size: 0.85rem;
    color: #a3a3a3;
    margin: 0 0 1rem 0;
  }

  .slug code {
    background: #0a0a0a;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    color: #f43f5e;
  }

  .excerpt {
    font-size: 0.95rem;
    color: #d4d4d4;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .card-actions {
    display: flex;
    gap: 1.5rem;
  }

  .btn-link {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .btn-link:hover {
    opacity: 0.8;
  }

  .text-primary {
    color: #3b82f6;
  }

  .text-secondary {
    color: #a3a3a3;
  }
</style>
