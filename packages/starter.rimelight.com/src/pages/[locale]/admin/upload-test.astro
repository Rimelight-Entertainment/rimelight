---
import AppLayout from '@/layouts/AppLayout.astro';
import RLAContainer from '@rimelight/ui/components/astro/RLAContainer.astro';
import RLAFileUpload from '@rimelight/ui/components/astro/RLAFileUpload.astro';
---

<AppLayout title="CMS - Local Upload Test" description="Test paste-to-upload and WebP compression locally">
  <RLAContainer class="py-16 upload-test-container">
    <div class="cms-header">
      <h1>Local CMS Media Upload Test</h1>
      <p class="subtitle">Paste an image from your clipboard, drop it, or click to upload. It auto-compresses to WebP.</p>
    </div>

    <div class="workspace-grid">
      <!-- Editor / Paste Zone -->
      <div class="card editor-card">
        <h2>Upload Media</h2>
        <div class="uploader-wrapper">
          <RLAFileUpload id="file-uploader" accept="image/*" title="Drop image here or click to browse" description="Supports PNG, JPG, WebP" />
        </div>
        
        <textarea id="content-area" placeholder="Focus here and paste an image, or use the dropzone above..." class="mt-4"></textarea>
      </div>

      <!-- Preview Zone -->
      <div class="card preview-card">
        <h2>Upload Output</h2>
        <div id="stats-panel" class="stats-panel hidden">
          <h3>Compression Stats</h3>
          <div class="stat-row">
            <span>Original Size:</span>
            <strong id="original-size">-</strong>
          </div>
          <div class="stat-row">
            <span>Compressed Size (WebP):</span>
            <strong id="compressed-size">-</strong>
          </div>
          <div class="stat-row">
            <span>Reduction:</span>
            <strong id="reduction-pct" class="success-text">-</strong>
          </div>
        </div>

        <div id="upload-status" class="upload-status">Ready. Select, drop, or paste an image to start.</div>

        <div id="image-preview-container" class="image-preview-container hidden">
          <h3>Uploaded Asset:</h3>
          <img id="preview-img" src="" alt="Uploaded preview" />
          <div class="url-copy-box">
            <input type="text" id="uploaded-url" readonly />
            <button id="copy-url-btn">Copy Link</button>
          </div>
        </div>
      </div>
    </div>
  </RLAContainer>
</AppLayout>

<script>
  const contentArea = document.getElementById('content-area') as HTMLTextAreaElement;
  const statsPanel = document.getElementById('stats-panel') as HTMLDivElement;
  const originalSizeEl = document.getElementById('original-size') as HTMLElement;
  const compressedSizeEl = document.getElementById('compressed-size') as HTMLElement;
  const reductionPctEl = document.getElementById('reduction-pct') as HTMLElement;
  const uploadStatus = document.getElementById('upload-status') as HTMLDivElement;
  const imagePreviewContainer = document.getElementById('image-preview-container') as HTMLDivElement;
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const uploadedUrl = document.getElementById('uploaded-url') as HTMLInputElement;
  const copyUrlBtn = document.getElementById('copy-url-btn') as HTMLButtonElement;

  function formatBytes(bytes: number) {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  }

  async function compressImage(file: File, maxWidth = 1600, quality = 0.85): Promise<File> {
    if (!file.type.startsWith('image/') || file.type === 'image/gif') {
      return file;
    }

    const bitmap = await createImageBitmap(file);
    const scale = Math.min(1, maxWidth / bitmap.width);
    const width = Math.round(bitmap.width * scale);
    const height = Math.round(bitmap.height * scale);

    const canvas = new OffscreenCanvas(width, height);
    const ctx = canvas.getContext('2d');
    if (!ctx) return file;
    ctx.drawImage(bitmap, 0, 0, width, height);

    const blob = await canvas.convertToBlob({
      type: 'image/webp',
      quality
    });

    return new File([blob], file.name.replace(/\.\w+$/, '.webp'), {
      type: 'image/webp'
    });
  }

  async function uploadImage(file: File) {
    uploadStatus.textContent = 'Uploading to simulated R2...';
    uploadStatus.className = 'upload-status loading';

    const formData = new FormData();
    formData.append('file', file);

    try {
      const response = await fetch('/api/upload', {
        method: 'POST',
        body: formData
      });

      if (!response.ok) {
        throw new Error(await response.text());
      }

      const data = await response.json();
      uploadStatus.textContent = 'Upload complete!';
      uploadStatus.className = 'upload-status success-text';

      const startPos = contentArea.selectionStart;
      const endPos = contentArea.selectionEnd;
      const text = contentArea.value;
      const markdown = `![pasted-image](${data.url})`;
      contentArea.value = text.substring(0, startPos) + markdown + text.substring(endPos, text.length);

      previewImg.src = data.url;
      uploadedUrl.value = window.location.origin + data.url;
      imagePreviewContainer.classList.remove('hidden');
    } catch (err: any) {
      console.error(err);
      uploadStatus.textContent = `Error: ${err.message || 'Upload failed'}`;
      uploadStatus.className = 'upload-status error-text';
    }
  }

  // Handle standard File Input click / Drag & Drop via RLAFileUpload
  const fileInput = document.querySelector('[data-fileUpload-input]') as HTMLInputElement | null;
  fileInput?.addEventListener('change', async () => {
    const files = fileInput.files;
    if (!files || files.length === 0) return;

    const file = files[0];
    uploadStatus.textContent = 'Compressing image...';
    uploadStatus.className = 'upload-status loading';

    const originalSize = file.size;
    const compressed = await compressImage(file);
    const compressedSize = compressed.size;

    originalSizeEl.textContent = formatBytes(originalSize);
    compressedSizeEl.textContent = formatBytes(compressedSize);
    const savedPct = ((originalSize - compressedSize) / originalSize * 100).toFixed(1);
    reductionPctEl.textContent = `${savedPct}% saved`;
    statsPanel.classList.remove('hidden');

    await uploadImage(compressed);
  });

  // Handle clipboard pastes inside contentArea
  contentArea?.addEventListener('paste', async (e: ClipboardEvent) => {
    const items = e.clipboardData?.items;
    if (!items) return;

    for (const item of items) {
      if (item.type.startsWith('image/')) {
        e.preventDefault();

        const file = item.getAsFile();
        if (!file) continue;

        uploadStatus.textContent = 'Compressing image...';
        uploadStatus.className = 'upload-status loading';

        const originalSize = file.size;
        const compressed = await compressImage(file);
        const compressedSize = compressed.size;

        originalSizeEl.textContent = formatBytes(originalSize);
        compressedSizeEl.textContent = formatBytes(compressedSize);
        const savedPct = ((originalSize - compressedSize) / originalSize * 100).toFixed(1);
        reductionPctEl.textContent = `${savedPct}% saved`;
        statsPanel.classList.remove('hidden');

        await uploadImage(compressed);
        return;
      }
    }
  });

  copyUrlBtn.addEventListener('click', () => {
    uploadedUrl.select();
    document.execCommand('copy');
    const prevText = copyUrlBtn.textContent;
    copyUrlBtn.textContent = 'Copied!';
    setTimeout(() => {
      copyUrlBtn.textContent = prevText;
    }, 2000);
  });
</script>

<style>
  .upload-test-container {
    max-width: 1200px;
    margin: 0 auto;
    font-family: var(--font-sans), sans-serif;
  }

  .cms-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .cms-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #a3a3a3;
    font-size: 1.1rem;
    max-width: 700px;
    margin: 0 auto;
  }

  .workspace-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .workspace-grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .card h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #fff;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .uploader-wrapper {
    margin-bottom: 1.5rem;
  }

  textarea {
    width: 100%;
    height: 180px;
    background: #0a0a0a;
    border: 1px solid #404040;
    border-radius: 8px;
    padding: 1rem;
    color: #e5e5e5;
    font-family: var(--font-mono), monospace;
    font-size: 0.95rem;
    resize: none;
    outline: none;
    box-sizing: border-box;
  }

  textarea:focus {
    border-color: #3b82f6;
  }

  .stats-panel {
    background: #262626;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1.5rem;
  }

  .stats-panel h3 {
    margin-top: 0;
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    color: #e5e5e5;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
    color: #a3a3a3;
  }

  .stat-row strong {
    color: #fff;
  }

  .success-text {
    color: #22c55e !important;
  }

  .error-text {
    color: #ef4444 !important;
  }

  .loading {
    color: #eab308 !important;
  }

  .upload-status {
    padding: 1rem;
    background: #0a0a0a;
    border-radius: 8px;
    text-align: center;
    font-size: 0.9rem;
    color: #a3a3a3;
    margin-bottom: 1.5rem;
    border: 1px solid #262626;
  }

  .image-preview-container h3 {
    font-size: 0.95rem;
    color: #e5e5e5;
    margin-bottom: 0.75rem;
  }

  #preview-img {
    max-width: 100%;
    max-height: 250px;
    border-radius: 8px;
    border: 1px solid #404040;
    display: block;
    margin: 0 auto 1rem auto;
    object-fit: contain;
  }

  .url-copy-box {
    display: flex;
    gap: 0.5rem;
  }

  .url-copy-box input {
    flex-grow: 1;
    background: #0a0a0a;
    border: 1px solid #404040;
    border-radius: 6px;
    padding: 0.5rem;
    color: #a3a3a3;
    font-size: 0.85rem;
    outline: none;
  }

  .url-copy-box button {
    background: #3b82f6;
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 0.5rem 1rem;
    font-weight: 500;
    font-size: 0.85rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .url-copy-box button:hover {
    background: #2563eb;
  }

  .hidden {
    display: none !important;
  }
</style>
