---
import { auth } from "@/auth/auth"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLAInput from "@rimelight/ui/components/input/RLAInput.astro"
import RLATextarea from "@rimelight/ui/components/textarea/RLATextarea.astro"
import RLASelect from "@rimelight/ui/components/select/RLASelect.astro"

const session = await auth.api.getSession({ headers: Astro.request.headers })

if (!session) {
  return Astro.redirect("/auth/sign-in")
}
---

<CMSDashboardLayout title="Create Template" description="Create a new CMS template" activeSection="templates" toolbarRight={
  <>
    <a href="/admin/cms/templates" class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">Cancel</a>
    <RLAButton variant="solid" color="primary" type="submit" form="template-form">Create Template</RLAButton>
  </>
}>
  <div class="max-w-3xl mx-auto space-y-6">
    <form id="template-form" class="bg-white p-6 rounded-lg shadow space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Slug</label>
        <RLAInput name="slug" required />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Title</label>
        <RLAInput name="title" required />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
        <RLATextarea name="description" rows="3" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Page Type</label>
        <RLASelect name="pageType" required>
          <option value="blog">Blog Post</option>
          <option value="wiki">Wiki Page</option>
          <option value="doc">Documentation</option>
          <option value="announcement">Announcement</option>
        </RLASelect>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Allowed Roles (comma-separated)</label>
        <RLAInput name="allowedRoles" placeholder="admin, editor" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Initial Blocks (JSON)</label>
        <RLATextarea name="initialBlocks" rows="10" placeholder='[{"id": "...", "type": "ParagraphBlock", "props": {"text": {"en": "..."}}}]' class="font-mono text-sm" />
      </div>
    </form>
  </div>
  <script>
    document.getElementById('template-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target);
      const data = {
        slug: formData.get('slug'),
        title: formData.get('title'),
        description: formData.get('description'),
        pageType: formData.get('pageType'),
        allowedRoles: formData.get('allowedRoles') ? formData.get('allowedRoles').split(',').map(r => r.trim()) : [],
        initialBlocks: JSON.parse(formData.get('initialBlocks') || '[]'),
        approvalRules: { allowSelfApproval: true, minApprovals: 1 },
        defaultProperties: {}
      };

      try {
        const response = await fetch('/api/cms/templates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          window.location.href = '/admin/cms/templates';
        } else {
          const errorData = await response.json().catch(() => ({}));
          alert(`Failed to create template: ${errorData.error || 'Unknown error'}`);
        }
      } catch (error) {
        alert('Error creating template: Network error');
      }
    });
  </script>
</CMSDashboardLayout>
