---
import { auth } from "@/auth/auth"
import DashboardLayout from "@/layouts/DashboardLayout.astro"
import RLADashboardGroup from "@rimelight/ui/components/dashboard-group/RLADashboardGroup.astro"
import RLADashboardSidebar from "@rimelight/ui/components/dashboard-sidebar/RLADashboardSidebar.astro"
import RLADashboardNavbar from "@rimelight/ui/components/dashboard-navbar/RLADashboardNavbar.astro"
import RLADashboardPanel from "@rimelight/ui/components/dashboard-panel/RLADashboardPanel.astro"
import RLADashboardToolbar from "@rimelight/ui/components/dashboard-toolbar/RLADashboardToolbar.astro"
import RLADashboardSidebarCollapse from "@rimelight/ui/components/dashboard-sidebar-collapse/RLADashboardSidebarCollapse.astro"
import RLASearch from "@rimelight/ui/components/search/RLASearch.astro"
import RLAIcon from "@rimelight/ui/components/icon/RLAIcon.astro"
import RLAAvatar from "@rimelight/ui/components/avatar/RLAAvatar.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLABadge from "@rimelight/ui/components/badge/RLABadge.astro"
import { t } from "@rimelight/i18n"
import { db } from "@/db"
import { pageVersions, pages } from "@/db/schema"
import { desc, eq } from "drizzle-orm"

const cmsNavItems = [
  { icon: "i-lucide-home", label: t("cms.nav_dashboard"), href: "/admin/cms", id: "dashboard" },
  { icon: "i-lucide-file-text", label: t("cms.nav_templates"), href: "/admin/cms/templates", id: "templates" },
  { icon: "i-lucide-file", label: t("cms.nav_pages"), href: "/admin/cms/pages", id: "pages" },
  { icon: "i-lucide-git-branch", label: t("cms.nav_versions"), href: "/admin/cms/versions", id: "versions" },
]

const settingsNavItem = { icon: "i-lucide-settings", label: t("cms.nav_settings"), href: "/admin/cms/settings", id: "settings" }

const session = await auth.api.getSession({ headers: Astro.request.headers })

if (!session) {
  return Astro.redirect("/auth/sign-in")
}

// Fetch versions directly from DB
const versionsList = await db
  .select()
  .from(pageVersions)
  .orderBy(desc(pageVersions.createdAt))
  .limit(50)

const versions = await Promise.all(
  versionsList.map(async (version) => {
    const page = await db.select({ title: pages.title, slug: pages.slug }).from(pages).where(eq(pages.id, version.pageId)).limit(1)
    return {
      ...version,
      pageTitle: page[0]?.title || "Unknown Page",
      slug: page[0]?.slug || "",
    }
  })
)
---

<DashboardLayout title="Versions" description="Manage CMS page versions" noindex={true}>
  <RLADashboardGroup>
  <RLADashboardSidebar side="left" collapsible>
    <Fragment slot="header">
      <RLAIcon name="i-lucide-file-stack" class="size-6 text-primary shrink-0" data-dashboard-sidebar-logo />
      <span class="font-semibold text-highlighted truncate flex-1 transition-opacity duration-200" data-dashboard-sidebar-label>{t("cms.sidebar_app_name")}</span>
      <RLADashboardSidebarCollapse side="left" class="shrink-0" />
    </Fragment>

    <nav class="flex flex-col gap-1" data-dashboard-nav-container>
      {cmsNavItems.map((item) => (
        <a
          href={item.href}
          data-dashboard-nav
          data-dashboard-section={item.id}
          class={
            "flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition-colors " +
            (item.id === "versions"
              ? "bg-muted text-highlighted"
              : "text-default hover:text-highlighted hover:bg-muted")
          }
        >
          <RLAIcon name={item.icon} class="size-5 shrink-0" />
          <span class="truncate flex-1" data-dashboard-nav-label>{item.label}</span>
        </a>
      ))}
    </nav>

    <Fragment slot="footer">
      <div class="w-full" data-dashboard-nav-container>
        <a
          href={settingsNavItem.href}
          data-dashboard-nav
          data-dashboard-section={settingsNavItem.id}
          class="flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium text-default hover:text-highlighted hover:bg-muted transition-colors w-full"
        >
          <RLAIcon name={settingsNavItem.icon} class="size-5 shrink-0" />
          <span class="truncate flex-1" data-dashboard-nav-label>{settingsNavItem.label}</span>
        </a>
      </div>
    </Fragment>
  </RLADashboardSidebar>

  <RLADashboardPanel>
    <RLADashboardNavbar slot="header" title="Versions" icon="i-lucide-git-branch">
      <Fragment slot="left">
        <h1 class="text-xl font-semibold text-highlighted" data-dashboard-navbar-title>Versions</h1>
      </Fragment>
      <Fragment slot="right">
        <RLASearch />
        <RLAButton variant="ghost" color="neutral" square leadingIcon="i-lucide-bell" aria-label="Notifications" />
        <RLAAvatar src="https://i.pravatar.cc/40?u=admin" size="sm" class="cursor-pointer" />
      </Fragment>
    </RLADashboardNavbar>

    <div slot="body" class="flex flex-col gap-6">
      <RLADashboardToolbar>
        <Fragment slot="left" />
        <Fragment slot="right">
          <button class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">Create Version</button>
        </Fragment>
      </RLADashboardToolbar>

      <div class="flex-1 overflow-y-auto min-h-0">
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Page</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Version</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Author</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              {versions.map((version: any) => (
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900">{version.pageTitle}</div>
                    <div class="text-sm text-gray-500">{version.slug}</div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    v{version.versionNumber}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    {version.status === 'published' ? (
                      <RLABadge variant="soft" color="green" size="xs">Published</RLABadge>
                    ) : version.status === 'pending' ? (
                      <RLABadge variant="soft" color="yellow" size="xs">Pending Review</RLABadge>
                    ) : (
                      <RLABadge variant="soft" color="red" size="xs">Draft</RLABadge>
                    )}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    {version.authorName}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    {new Date(version.createdAt).toLocaleDateString()}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                    <a href={`/admin/cms/versions/${version.id}`} class="text-blue-600 hover:text-blue-900 mr-3">View</a>
                    <button class="text-red-600 hover:text-red-900">Delete</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </RLADashboardPanel>
</RLADashboardGroup>
</DashboardLayout>

<style is:global>
  /* Hide text label when sidebar is collapsed */
  [data-dashboard-sidebar][data-collapsed="true"] [data-dashboard-sidebar-label] {
    display: none;
  }

  /* Hide the logo icon too — only show the collapse toggle */
  [data-dashboard-sidebar][data-collapsed="true"] [data-dashboard-sidebar-logo] {
    display: none;
  }

  /* Center the collapse button in the header and remove side padding */
  [data-dashboard-sidebar][data-collapsed="true"] [data-slot="header"] {
    justify-content: center;
    gap: 0;
    padding: 0.
  }

  [data-dashboard-sidebar][data-collapsed="true"] [data-dashboard-toggle="collapse"] {
    margin: 0 auto.
  }

  /* Hide nav item text labels when collapsed */
  [data-dashboard-sidebar][data-collapsed="true"] [data-dashboard-nav-label] {
    display: none.
  }

  /* Center nav icons when collapsed */
  [data-dashboard-sidebar][data-collapsed="true"] [data-dashboard-nav] {
    justify-content: center.
    padding-left: 0.
    padding-right: 0.
  }

  /* Center footer slot item when collapsed */
  [data-dashboard-sidebar][data-collapsed="true"] [data-slot="footer"] {
    padding-left: 0.
    padding-right: 0.
  }

  /* Dashboard container fills exactly 100% height of DashboardLayout viewport slot */
  .fixed.inset-0.flex.overflow-hidden {
    position: relative !important.
    inset: auto !important.
    width: 100% !important.
    height: 100% !important.
    min-height: 0 !important.
    display: flex !important.
    overflow: hidden !important.
  }

  [data-dashboard-sidebar] {
    height: 100% !important.
    min-height: 0 !important.
  }

  [data-dashboard-sidebar] > [data-slot="body"] {
    flex: 1 1 0% !important.
    min-height: 0 !important.
    overflow-y: auto !important.
  }

  [data-dashboard-sidebar] > [data-slot="footer"] {
    margin-top: auto !important.
  }

  [data-dashboard-panel] {
    height: 100% !important.
    min-height: 0 !important.
    display: flex !important.
    flex-direction: column !important.
    flex: 1 1 0% !important.
    min-width: 0 !important.
    overflow: hidden !important.
  }

  [data-dashboard-panel] > [data-slot="body"] {
    flex: 1 1 0% !important.
    min-height: 0 !important.
    overflow-y: auto !important.
  }
</style>