---
import { auth } from "@/auth/auth"
import AppHeader from "@/components/app/AppHeader.astro"
import AppFooter from "@/components/app/AppFooter.astro"

const session = await auth.api.getSession({ headers: Astro.request.headers })
const id = Astro.params.id

if (!session) {
  return Astro.redirect("/auth/sign-in")
}

// Fetch page data
const pageResponse = await fetch(`${Astro.site}/api/cms/pages/${id}`, {
  headers: {
    Cookie: Astro.request.headers.get("cookie") || ""
  }
})

if (!pageResponse.ok) {
  const errorText = await pageResponse.text()
  console.error('Page API error:', pageResponse.status, errorText)
  return Astro.redirect('/admin/cms/pages')
}

const { page, draft } = await pageResponse.json()

const content = draft?.content 
  ? (typeof draft.content === 'string' ? JSON.parse(draft.content) : draft.content)
  : (typeof page.content === 'string' ? JSON.parse(page.content) : page.content)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Page | CMS Admin</title>
    <style is:inline>
      @import url("@rimelight/cms/client/styles/cms-editor.css");
    </style>
  </head>
  <body>
    <AppHeader />
    <main class="max-w-7xl mx-auto py-12 px-4">
      <div class="flex gap-8">
        <!-- Sidebar -->
        <aside class="w-64 flex-shrink-0">
          <nav class="space-y-2">
            <a href="/admin/cms" class="block px-4 py-2 rounded bg-gray-200 hover:bg-gray-300">Dashboard</a>
            <a href="/admin/cms/templates" class="block px-4 py-2 rounded bg-gray-200 hover:bg-gray-300">Templates</a>
            <a href="/admin/cms/pages" class="block px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700">Pages</a>
            <a href="/admin/cms/versions" class="block px-4 py-2 rounded bg-gray-200 hover:bg-gray-300">Versions</a>
          </nav>
        </aside>

        <!-- Main Content -->
        <div class="flex-1">
          <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold">Edit: {page.title}</h1>
            <div class="flex gap-2">
              <a href={`/admin/cms/pages/${id}/preview`} class="px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300">Preview</a>
              <button id="publish-btn" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">Publish</button>
            </div>
          </div>

          <!-- Custom Element Editor -->
          <div id="cms-editor-container" class="h-[600px]">
            <rimelight-editor-layout page-id={id} initial-blocks={JSON.stringify(content.blocks || [])}></rimelight-editor-layout>
          </div>
        </div>
      </div>
    </main>
    <AppFooter />

    <script type="module">
      // Load the CMS client library
      import('@rimelight/cms/client/loader').then(({ defineCustomElements }) => {
        defineCustomElements();
        
        // After elements are defined, set up the editor
        const editorLayout = document.querySelector('rimelight-editor-layout');
        if (editorLayout) {
          const initialBlocksAttr = editorLayout.getAttribute('initial-blocks');
          if (initialBlocksAttr) {
            try {
              const initialBlocks = JSON.parse(initialBlocksAttr);
              // The layout component will handle this automatically
            } catch (e) {
              console.error('Failed to parse initial blocks:', e);
            }
          }
        }
      });

      const publishBtn = document.getElementById('publish-btn');
      
      publishBtn.addEventListener('click', async () => {
        const editorLayout = document.querySelector('rimelight-editor-layout');
        if (!editorLayout) {
          alert('Editor not loaded');
          return;
        }

        // Access the internal editor component
        const editorComponent = editorLayout.querySelector('#cms-editor-component');
        if (!editorComponent) {
          alert('Editor component not found');
          return;
        }

        const blocks = editorComponent.getBlocks ? editorComponent.getBlocks() : [];
        const content = { blocks, properties: {} };
        
        try {
          const response = await fetch(`/api/cms/pages/${id}/publish`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              content,
              changeSummary: 'Published from editor'
            })
          });

          if (response.ok) {
            alert('Page published successfully!');
            window.location.href = '/admin/cms/pages';
          } else {
            const errorData = await response.json().catch(() => ({}));
            alert(`Failed to publish page: ${errorData.error || 'Unknown error'}`);
          }
        } catch (error) {
          alert('Error publishing page: Network error');
        }
      });
    </script>
  </body>
</html>
