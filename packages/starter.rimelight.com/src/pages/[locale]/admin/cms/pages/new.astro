---
import { auth } from "@/auth/auth"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLAInput from "@rimelight/ui/components/input/RLAInput.astro"
import RLASelect from "@rimelight/ui/components/select/RLASelect.astro"
import { db } from "@/db"
import { pageTemplates } from "@/db/schema"
import { desc } from "drizzle-orm"

const session = await auth.api.getSession({ headers: Astro.request.headers })

if (!session) {
  return Astro.redirect("/auth/sign-in")
}

const templates = await db
  .select()
  .from(pageTemplates)
  .orderBy(desc(pageTemplates.createdAt))

const templateOptions = [
  { label: "Blank Page", value: "" },
  ...templates.map((t: any) => ({ label: `${t.title} (${t.pageType})`, value: t.id }))
]
---

<CMSDashboardLayout title="Create Page" description="Create a new CMS page" activeSection="pages">
  <Fragment slot="toolbar-right">
    <RLAButton href="/admin/cms/pages" variant="outline" color="neutral" size="sm">
      Cancel
    </RLAButton>
    <RLAButton variant="solid" color="success" size="sm" leadingIcon="i-lucide-plus" type="submit" form="page-form">
      Create & Edit
    </RLAButton>
  </Fragment>

  <div class="max-w-3xl mx-auto space-y-6">
    <form id="page-form" class="bg-white p-6 rounded-lg shadow space-y-6">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Slug</label>
          <RLAInput name="slug" required />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Type</label>
          <RLASelect
            name="type"
            placeholder="Select or create page type..."
            createItem={true}
            items={[
              { label: "Blog Post", value: "blog" },
              { label: "Wiki Page", value: "wiki" },
              { label: "Documentation", value: "doc" },
              { label: "Announcement", value: "announcement" }
            ]}
            required
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Title</label>
        <RLAInput name="title" required />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Template</label>
        <RLASelect
          name="templateId"
          placeholder="Select template..."
          items={templateOptions}
        />
      </div>
    </form>
  </div>

  <style is:inline slot="head">
    @import url("@rimelight/cms/client/styles/cms-editor.css");
  </style>
  <script>
    const form = document.getElementById('page-form') as HTMLFormElement | null;
    
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = {
        slug: formData.get('slug'),
        type: formData.get('type'),
        title: formData.get('title'),
        templateId: formData.get('templateId') || null,
        templateVersion: 1,
        content: {
          blocks: [
            {
              id: crypto.randomUUID(),
              type: 'ParagraphBlock',
              props: { text: { en: 'Start writing your content...' } }
            }
          ],
          properties: {}
        }
      };

      try {
        const response = await fetch('/api/cms/pages', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          const result = await response.json();
          window.location.href = `/admin/cms/pages/${result.page.id}/edit`;
        } else {
          const errorData = await response.json().catch(() => ({}));
          alert(`Failed to create page: ${errorData.error || 'Unknown error'}`);
        }
      } catch (error) {
        alert('Error creating page: Network error');
      }
    });
  </script>
</CMSDashboardLayout>
