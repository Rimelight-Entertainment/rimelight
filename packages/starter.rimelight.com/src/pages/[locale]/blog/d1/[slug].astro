---
import AppLayout from '@/layouts/AppLayout.astro';
import RLAContainer from "@rimelight/ui/components/container/RLAContainer.astro";
import { db, posts } from '@/db';
import { eq } from 'drizzle-orm';

const { slug } = Astro.params;
const post = await db.select().from(posts).where(eq(posts.slug, slug ?? "")).get();

if (!post) {
  return Astro.redirect(`/${Astro.currentLocale}/404`);
}

// Simple custom Markdown to HTML converter (self-contained, zero-dependency)
function renderMarkdown(md: string) {
  return md
    .replace(/^### (.*$)/gm, '<h3>$1</h3>')
    .replace(/^## (.*$)/gm, '<h2>$1</h2>')
    .replace(/^# (.*$)/gm, '<h1>$1</h1>')
    .replace(/!\[(.*?)\]\((.*?)\)/g, "<img src='$2' alt='$1' class='blog-img' />")
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .split('\n\n')
    .map(p => {
      const trimmed = p.trim();
      if (
        trimmed.startsWith('<h') || 
        trimmed.startsWith('<img') || 
        trimmed.startsWith('<ul') || 
        trimmed.startsWith('<ol') || 
        trimmed.startsWith('<li')
      ) {
        return trimmed;
      }
      return `<p>${trimmed.replace(/\n/g, '<br>')}</p>`;
    })
    .join('\n');
}

const htmlContent = renderMarkdown(post.content);
---

<AppLayout title={post.title} description={`Read ${post.title} on our D1 blog`}>
  <RLAContainer class="py-16 post-view-container">
    <article class="blog-post">
      <header class="post-header">
        <div class="post-meta">
          <span class="status">{post.status}</span>
          <span class="dot">•</span>
          <time>{post.createdAt.toLocaleDateString()}</time>
        </div>
        <h1>{post.title}</h1>
        <div class="divider"></div>
      </header>

      {post.coverImage && (
        <div class="cover-image-container">
          <img src={post.coverImage} alt={post.title} class="cover-image" />
        </div>
      )}

      <div class="prose" set:html={htmlContent} />

      <footer class="post-footer">
        <a href={`/${Astro.currentLocale}/admin/posts`} class="back-link">← Back to CMS Dashboard</a>
      </footer>
    </article>
  </RLAContainer>
</AppLayout>

<style is:global>
  .post-view-container {
    max-width: 800px;
    margin: 0 auto;
    font-family: var(--font-sans), sans-serif;
  }

  .blog-post {
    background: #171717;
    border: 1px solid #262626;
    border-radius: 12px;
    padding: 3rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 640px) {
    .blog-post {
      padding: 1.5rem;
    }
  }

  .post-header h1 {
    font-size: 2.75rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    margin: 0.5rem 0 1.5rem 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: #a3a3a3;
  }

  .post-meta .status {
    background: #1e3a8a;
    color: #93c5fd;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .divider {
    height: 1px;
    background: #262626;
    margin-bottom: 2rem;
  }

  .cover-image-container {
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 2.5rem;
    border: 1px solid #262626;
    max-height: 400px;
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prose {
    color: #d4d4d4;
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .prose p {
    margin-bottom: 1.5rem;
  }

  .prose h2 {
    color: #fff;
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    color: #fff;
    font-size: 1.4rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose img.blog-img {
    max-width: 100%;
    border-radius: 8px;
    border: 1px solid #404040;
    margin: 2rem 0;
    display: block;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #262626;
  }

  .back-link {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #2563eb;
  }
</style>
