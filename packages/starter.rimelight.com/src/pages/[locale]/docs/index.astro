---
import { getEntry, render } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import type { TableOfContentsConfig } from "@rimelight/ui/components/TableOfContents.astro";

const activeLocale = Astro.currentLocale ?? "en";
const entry = await getEntry("docs", activeLocale);

if (!entry) {
  return Astro.redirect("/404");
}

const renderFn = render;
const { Content, headings } = await renderFn(entry);
const { title, description, tableOfContents, prev, next, editUrl } = entry.data;
---

<DocsLayout
  title={title}
  description={description}
  headings={headings}
  tableOfContents={tableOfContents as TableOfContentsConfig | false | undefined}
  prevOverride={prev}
  nextOverride={next}
  editUrl={editUrl}
  rawMarkdown={entry.body}
>
  <Content />
</DocsLayout>
