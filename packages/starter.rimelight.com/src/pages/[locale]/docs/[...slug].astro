---
import { getEntry, render } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import type { TableOfContentsConfig } from "@rimelight/ui/components/TableOfContents.astro";

const activeLocale = Astro.currentLocale ?? "en";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect(getRelativeLocaleUrl("/404"));
}

const entry = await getEntry("docs", `${activeLocale}/${slug}`);

if (!entry) {
  return Astro.redirect(getRelativeLocaleUrl("/404"));
}

const { Content, headings } = await render(entry);
const { title, description, tableOfContents, prev, next, editUrl } = entry.data;
---

<DocsLayout
  title={title}
  description={description}
  headings={headings}
  tableOfContents={tableOfContents as TableOfContentsConfig | false | undefined}
  prevOverride={prev}
  nextOverride={next}
  editUrl={editUrl}
  rawMarkdown={entry.body}
>
  <Content />
</DocsLayout>
