---
import { auth } from "@/auth/auth"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLACard from "@rimelight/ui/components/card/RLACard.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import { t } from "@rimelight/i18n"

const session = await auth.api.getSession({ headers: Astro.request.headers })

if (!session) {
  return Astro.redirect("/auth/sign-in")
}
---

<CMSDashboardLayout title="CMS Admin" description="Content Management System administration" activeSection="dashboard">
  <Fragment slot="toolbar-left">
    <RLAButton variant="ghost" color="neutral" size="sm" leadingIcon="i-lucide-calendar">
      Last 30 days
    </RLAButton>
  </Fragment>
  <Fragment slot="toolbar-right">
    <RLAButton variant="outline" color="neutral" size="sm" leadingIcon="i-lucide-download">
      Export Report
    </RLAButton>
    <RLAButton href="/cms/templates/new" variant="solid" color="primary" size="sm" leadingIcon="i-lucide-plus">
      Create Template
    </RLAButton>
  </Fragment>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <RLACard title="Templates" description="Manage page templates">
      <div class="mt-4">
        <RLAButton href="/cms/templates" variant="ghost" color="primary" trailingIcon="i-lucide-arrow-right">
          Manage Templates
        </RLAButton>
      </div>
    </RLACard>
    <RLACard title="Pages" description="Create and edit pages">
      <div class="mt-4">
        <RLAButton href="/cms/pages" variant="ghost" color="primary" trailingIcon="i-lucide-arrow-right">
          Manage Pages
        </RLAButton>
      </div>
    </RLACard>
    <RLACard title="Versions" description="Review and publish versions">
      <div class="mt-4">
        <RLAButton href="/cms/versions" variant="ghost" color="primary" trailingIcon="i-lucide-arrow-right">
          View Versions
        </RLAButton>
      </div>
    </RLACard>
  </div>

  <RLACard title="Quick Actions">
    <div class="flex gap-4 mt-2">
      <RLAButton href="/cms/templates/new" variant="solid" color="primary" leadingIcon="i-lucide-plus">
        Create Template
      </RLAButton>
      <RLAButton href="/cms/pages/new" variant="solid" color="success" leadingIcon="i-lucide-plus">
        Create Page
      </RLAButton>
    </div>
  </RLACard>
</CMSDashboardLayout>
