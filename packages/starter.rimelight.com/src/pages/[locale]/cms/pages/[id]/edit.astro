---
import { auth } from "@/auth/auth"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import { db } from "@/db"
import { pages, pageDrafts } from "@/db/schema"
import { eq } from "drizzle-orm"

const session = await auth.api.getSession({ headers: Astro.request.headers })
const id = Astro.params.id

if (!session) {
  return Astro.redirect("/auth/sign-in")
}

const page = await db.select().from(pages).where(eq(pages.id, id!)).limit(1)
if (!page[0]) return Astro.redirect('/cms/pages')

const draft = await db.select().from(pageDrafts).where(eq(pageDrafts.pageId, id!)).limit(1)

const content = draft[0]?.content 
  ? (typeof draft[0].content === 'string' ? JSON.parse(draft[0].content) : draft[0].content)
  : (typeof page[0].content === 'string' ? JSON.parse(page[0].content) : page[0].content)
---

<CMSDashboardLayout title={`Edit: ${page[0].title}`} description="Edit CMS page" activeSection="pages">
  <Fragment slot="toolbar-right">
    <RLAButton href={`/cms/pages/${id}/preview`} variant="outline" color="neutral" size="sm">
      Preview
    </RLAButton>
    <RLAButton variant="solid" color="success" size="sm" id="publish-btn">
      Publish
    </RLAButton>
  </Fragment>

  <div class="h-full overflow-hidden">
    <rimelight-editor-layout page-id={id} initial-blocks={JSON.stringify(content.blocks || [])}></rimelight-editor-layout>
  </div>

  <style is:inline slot="head">
    @import url("@rimelight/cms/client/styles/cms-editor.css");
  </style>
  <script type="module" define:vars={{ pageId: id }}>
    import('@rimelight/cms/client/loader').then(({ defineCustomElements }) => {
      return defineCustomElements();
    });

    document.getElementById('publish-btn')?.addEventListener('click', async () => {
      const publishBtn = document.getElementById('publish-btn');
      const editorLayout = document.querySelector('rimelight-editor-layout');
      if (!editorLayout) { alert('Editor not loaded'); return; }
      const editorComponent = editorLayout.querySelector('#cms-editor-component');
      if (!editorComponent) { alert('Editor component not found'); return; }
      const blocks = editorComponent.getBlocks ? editorComponent.getBlocks() : [];
      const content = { blocks, properties: {} };
      
      try {
        if (publishBtn) publishBtn.disabled = true;
        const response = await fetch(`/api/cms/pages/${pageId}/publish`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content, changeSummary: 'Published from editor' })
        });
        if (response.ok) {
          alert('Page published successfully!');
          window.location.href = '/cms/pages';
        } else {
          const errorData = await response.json().catch(() => ({}));
          alert(`Failed to publish page: ${errorData.error || 'Unknown error'}`);
        }
      } catch (error) {
        alert('Error publishing page: Network error');
      } finally {
        if (publishBtn) publishBtn.disabled = false;
      }
    });
  </script>
</CMSDashboardLayout>
