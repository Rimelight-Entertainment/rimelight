---
import { auth } from "@/auth/auth"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLABadge from "@rimelight/ui/components/badge/RLABadge.astro"
import { db } from "@/db"
import { pages } from "@/db/schema"
import { desc, isNull } from "drizzle-orm"

const session = await auth.api.getSession({ headers: Astro.request.headers })

if (!session) {
  return Astro.redirect("/auth/sign-in")
}

const pagesList = await db
  .select()
  .from(pages)
  .where(isNull(pages.deletedAt))
  .orderBy(desc(pages.createdAt))

const pagesData = pagesList.map((page) =>
  Object.assign({}, page, {
    content: typeof page.content === "string" ? JSON.parse(page.content) : page.content
  })
)
---

<CMSDashboardLayout title="Pages" description="Manage CMS pages" activeSection="pages">
  <Fragment slot="toolbar-right">
    <RLAButton href="/cms/pages/new" variant="solid" color="success" leadingIcon="i-lucide-plus">
      Create Page
    </RLAButton>
  </Fragment>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Slug</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {pagesData.map((page: any) => {
          const titleVal = typeof page.title === "object" ? page.title?.en || "" : page.title || ""
          return (
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900">{titleVal}</div>
              </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              {page.slug}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <RLABadge variant="soft" color="blue" size="xs">{page.type}</RLABadge>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              {page.publishedVersionId ? (
                <RLABadge variant="soft" color="green" size="xs">Published</RLABadge>
              ) : (
                <RLABadge variant="soft" color="yellow" size="xs">Draft</RLABadge>
              )}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex items-center gap-2">
              <RLAButton href={`/cms/pages/${page.id}/edit`} variant="ghost" color="primary" size="xs">
                Edit
              </RLAButton>
              <RLAButton href={`/cms/pages/${page.id}/preview`} variant="ghost" color="neutral" size="xs">
                Preview
              </RLAButton>
              <RLAButton variant="ghost" color="error" size="xs">
                Delete
              </RLAButton>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</CMSDashboardLayout>
