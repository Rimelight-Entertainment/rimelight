---
import { auth } from "@/auth/auth"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLABadge from "@rimelight/ui/components/badge/RLABadge.astro"
import { db } from "@/db"
import { pageTemplates } from "@/db/schema"
import { desc } from "drizzle-orm"

const session = await auth.api.getSession({ headers: Astro.request.headers })

if (!session) {
  return Astro.redirect("/auth/sign-in")
}

const templates = await db
  .select()
  .from(pageTemplates)
  .orderBy(desc(pageTemplates.createdAt))
---

<CMSDashboardLayout title="Templates" description="Manage CMS templates" activeSection="templates">
  <Fragment slot="toolbar-right">
    <RLAButton href="/cms/templates/new" variant="solid" color="primary" leadingIcon="i-lucide-plus">
      Create Template
    </RLAButton>
  </Fragment>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="w-full">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Version</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        {templates.map((template: any) => (
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm font-medium text-gray-900">{template.title}</div>
              <div class="text-sm text-gray-500">{template.slug}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <RLABadge variant="soft" color="blue" size="xs">{template.pageType}</RLABadge>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              v{template.version}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex items-center gap-2">
              <RLAButton href={`/cms/pages/new?templateId=${template.id}`} variant="ghost" color="success" size="xs">
                Create Page
              </RLAButton>
              <RLAButton href={`/cms/templates/${template.id}/edit`} variant="ghost" color="primary" size="xs">
                Edit
              </RLAButton>
              <RLAButton variant="ghost" color="error" size="xs" class="delete-template-btn" data-id={template.id}>
                Delete
              </RLAButton>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script>
    document.querySelectorAll('.delete-template-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        if (!id) return;

        if (!confirm('Are you sure you want to delete this template?')) return;

        try {
          const res = await fetch(`/api/cms/templates/${id}`, { method: 'DELETE' });
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to delete template');
          }
        } catch {
          alert('Network error deleting template');
        }
      });
    });
  </script>
</CMSDashboardLayout>
