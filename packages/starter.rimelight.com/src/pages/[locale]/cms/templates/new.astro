---
import { auth } from "@/auth/auth"
import CMSDashboardLayout from "@/layouts/CMSDashboardLayout.astro"
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro"
import RLAInput from "@rimelight/ui/components/input/RLAInput.astro"
import RLATextarea from "@rimelight/ui/components/textarea/RLATextarea.astro"
import RLASelect from "@rimelight/ui/components/select/RLASelect.astro"
import { db } from "@/db"
import { role } from "@/db/schema"
import { isNull } from "drizzle-orm"

const session = await auth.api.getSession({ headers: Astro.request.headers })

if (!session) {
  return Astro.redirect("/auth/sign-in")
}

// Fetch DB roles for selection
const dbRoles = await db.select().from(role).where(isNull(role.deletedAt))
const defaultRolesList = [
  { name: "admin", displayName: "Administrator", description: "Full system & CMS access" },
  { name: "editor", displayName: "Editor", description: "Can create and publish pages" },
  { name: "author", displayName: "Author", description: "Can create and edit drafts" },
  { name: "reviewer", displayName: "Reviewer", description: "Can review & approve versions" },
  { name: "viewer", displayName: "Viewer", description: "Read-only access" }
]

const activeRoles = dbRoles.length > 0 ? dbRoles : defaultRolesList
const roleOptions = activeRoles.map((r) => ({
  label: r.displayName || r.name,
  value: r.name,
  description: r.description || ""
}))
---

<CMSDashboardLayout title="Create Template" description="Create a new CMS template" activeSection="templates">
  <Fragment slot="toolbar-right">
    <RLAButton href="/cms/templates" variant="outline" color="neutral" size="sm">
      Cancel
    </RLAButton>
    <RLAButton variant="solid" color="primary" size="sm" type="submit" form="template-form">
      Create Template
    </RLAButton>
  </Fragment>

  <div class="max-w-3xl mx-auto space-y-6">
    <form id="template-form" class="bg-white p-6 rounded-lg shadow space-y-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Slug</label>
        <RLAInput name="slug" required />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Title</label>
        <RLAInput name="title" required />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
        <RLATextarea name="description" rows="3" />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Page Type</label>
        <RLASelect
          name="pageType"
          placeholder="Select or create page type..."
          createItem={true}
          items={[
            { label: "Blog Post", value: "blog" },
            { label: "Wiki Page", value: "wiki" },
            { label: "Documentation", value: "doc" },
            { label: "Announcement", value: "announcement" }
          ]}
          required
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Allowed Roles</label>
        <RLASelect
          name="allowedRoles"
          placeholder="Select allowed roles..."
          multiple={true}
          items={roleOptions}
        />
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Initial Blocks (JSON)</label>
        <RLATextarea name="initialBlocks" rows="10" placeholder='[{"id": "...", "type": "ParagraphBlock", "props": {"text": {"en": "..."}}}]' class="font-mono text-sm" />
      </div>
    </form>
  </div>
  <script>
    document.getElementById('template-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(e.target as HTMLFormElement);
      const allowedRolesRaw = formData.get('allowedRoles') as string;
      const initialBlocksVal = formData.get('initialBlocks') as string;

      let allowedRoles = [];
      if (allowedRolesRaw) {
        try {
          allowedRoles = JSON.parse(allowedRolesRaw);
          if (!Array.isArray(allowedRoles)) allowedRoles = [allowedRolesRaw];
        } catch {
          allowedRoles = allowedRolesRaw.split(',').map(r => r.trim()).filter(Boolean);
        }
      }

      let initialBlocks = [];
      if (initialBlocksVal) {
        try {
          initialBlocks = JSON.parse(initialBlocksVal);
        } catch (err) {
          alert('Invalid JSON in Initial Blocks');
          return;
        }
      }

      const data = {
        slug: formData.get('slug'),
        title: formData.get('title'),
        description: formData.get('description'),
        pageType: formData.get('pageType'),
        allowedRoles,
        initialBlocks,
        approvalRules: { allowSelfApproval: true, minApprovals: 1 },
        defaultProperties: {}
      };

      try {
        const response = await fetch('/api/cms/templates', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          window.location.href = '/cms/templates';
        } else {
          const errorData = await response.json().catch(() => ({}));
          alert(`Failed to create template: ${errorData.error || 'Unknown error'}`);
        }
      } catch (error) {
        alert('Error creating template: Network error');
      }
    });
  </script>
</CMSDashboardLayout>
