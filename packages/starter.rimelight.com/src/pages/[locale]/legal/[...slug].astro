---
import { getEntry, render } from 'astro:content';
import AppLayout from '@/layouts/AppLayout.astro';
import RLADate from "@rimelight/ui/components/date/RLADate.astro";
import RLAContainer from "@rimelight/ui/components/container/RLAContainer.astro";
import { useI18n } from "@rimelight/i18n";

const messages = useI18n(Astro, "legal", {
    lastUpdatedOn: "Last updated on",
});

const activeLocale = Astro.currentLocale ?? "en";

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');
const post = await getEntry('legal', `${activeLocale}/${slug}`);

if (!post) {
	return Astro.redirect('/404');
}

const { Content } = await render(post);
const { title, description, pubDate, updatedDate } = post.data;
---

<AppLayout title={title} description={description}>
	<RLAContainer class="py-16 max-w-3xl">
		<article>
			<div class="prose dark:prose-invert max-w-none">
				<div class="title mb-8">
					<div class="date text-neutral-400 mb-2 text-sm">
						<RLADate date={pubDate} />
						{
							updatedDate && (
								<div class="last-updated-on text-xs text-neutral-500 mt-1">
									{messages.lastUpdatedOn} <RLADate date={updatedDate} />
								</div>
							)
						}
					</div>
					<h1 class="text-4xl font-extrabold text-foreground mb-4">{title}</h1>
					<hr class="border-border" />
				</div>
				<Content />
			</div>
		</article>
	</RLAContainer>
</AppLayout>