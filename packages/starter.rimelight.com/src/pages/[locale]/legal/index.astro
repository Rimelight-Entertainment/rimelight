---
import AppLayout from '@/layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/site.config';
import { useI18nAsync, getRelativeLocaleUrl } from "@rimelight/i18n";
import RLAContainer from '@rimelight/ui/components/astro/RLAContainer.astro';

const activeLocale = Astro.currentLocale ?? "en";

const legalDocs = (await getCollection('legal'))
	.filter((doc) => doc.id.startsWith(`${activeLocale}/`))
	.toSorted(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

const messages = await useI18nAsync(Astro, "legal", {
    title: "Legal",
    heading: "Legal",
    lastUpdated: "Last updated:",
});
---

<AppLayout title={messages.title} description={siteConfig.description}>
	<RLAContainer class="py-16 max-w-3xl">
		<section class="legal-section">
			<h1 class="text-3xl font-extrabold text-white mb-8">{messages.heading}</h1>
			<ul class="legal-list flex flex-col gap-6">
				{legalDocs.map((doc) => (
					<li class="legal-item border-b border-neutral-800 pb-6 last:border-b-0">
						<h3 class="text-xl font-bold text-white mb-2">
							<a class="text-primary-400 hover:text-primary-300 transition-colors" href={getRelativeLocaleUrl(`/legal/${doc.id.replace(`${activeLocale}/`, "")}/`)}>
								{doc.data.title}
							</a>
						</h3>
						<p class="text-neutral-400 mb-2 text-sm">{doc.data.description}</p>
						<span class="date text-xs text-neutral-500">{messages.lastUpdated} {doc.data.pubDate.toLocaleDateString()}</span>
					</li>
				))}
			</ul>
		</section>
	</RLAContainer>
</AppLayout>