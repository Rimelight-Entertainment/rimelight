---
import AppLayout from '@/layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/site.config';
import { useI18nAsync, getRelativeLocaleUrl } from "@rimelight/i18n";

const activeLocale = Astro.currentLocale ?? "en";

const legalDocs = (await getCollection('legal'))
	.filter((doc) => doc.id.startsWith(`${activeLocale}/`))
	.toSorted(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

const messages = await useI18nAsync(Astro, "legal", {
    title: "Legal",
    heading: "Legal",
    lastUpdated: "Last updated:",
});
---

<AppLayout title={messages.title} description={siteConfig.description}>
		<section class="legal-section">
			<h1>{messages.heading}</h1>
			<ul class="legal-list">
				{legalDocs.map((doc) => (
					<li class="legal-item">
						<h3><a href={getRelativeLocaleUrl(`/legal/${doc.id.replace(`${activeLocale}/`, "")}/`)}>{doc.data.title}</a></h3>
						<p>{doc.data.description}</p>
						<span class="date">{messages.lastUpdated} {doc.data.pubDate.toLocaleDateString()}</span>
					</li>
				))}
			</ul>
		</section>
</AppLayout>