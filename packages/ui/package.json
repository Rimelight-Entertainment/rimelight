{
  "name": "@rimelight/ui",
  "version": "0.0.19",
  "private": false,
  "description": "Rimelight Entertainment UI Library.",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "src",
    "worker-configuration.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/integrations/index.ts",
    "./styles/*": "./src/styles/*",
    "./components/*": "./src/components/*",
    "./components/astro/*": "./src/components/astro/*",
    "./components/vue/*": "./src/components/vue/*",
    "./themes": "./src/themes/index.ts",
    "./themes/*": "./src/themes/*",
    "./composables": "./src/composables/index.ts",
    "./composables/*": "./src/composables/*",
    "./config": "./src/config/index.ts",
    "./config/*": "./src/config/*",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*",
    "./integrations": "./src/integrations/index.ts",
    "./integrations/*": "./src/integrations/*",
    "./integrations/vue-entrypoint": "./src/integrations/vue-entrypoint.ts",
    "./plugins": "./src/plugins/index.ts",
    "./plugins/*": "./src/plugins/*",
    "./middleware": "./src/middleware/index.ts",
    "./middleware/*": "./src/middleware/*",
    "./nuxt": "./src/nuxt.ts",
    "./presets": "./src/presets/index.ts",
    "./presets/*": "./src/presets/*",
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:config": "vp config",
    "dev": "astro dev"
  },
  "dependencies": {
    "@astrojs/vue": "6.0.1",
    "@iconify-json/lucide": "^1.2.102",
    "@nuxt/ui": "4.6.1",
    "@tailwindcss/vite": "^4.2.3",
    "@unocss/astro": "^66.6.8",
    "css-variants": "2.3.5",
    "defu": "6.1.6",
    "embla-carousel": "8.6.0",
    "picomatch": "^4.0.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.2.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unplugin-icons": "23.0.1",
    "vite-plugin-virtual": "^0.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/ts-plugin": "1.10.7",
    "@e18e/eslint-plugin": "0.3.0",
    "@types/node": "25.5.2",
    "@types/picomatch": "^4.0.3",
    "@unocss/eslint-plugin": "66.6.8",
    "astro": "6.1.8",
    "eslint-plugin-regexp": "3.1.0",
    "unocss": "66.6.8",
    "vite-plus": "0.1.19"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.5.0",
    "astro": ">=6.0.0",
    "vue": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "defu": "6.1.6",
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}
