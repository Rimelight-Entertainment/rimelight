{
  "name": "@rimelight/ui",
  "version": "0.0.63",
  "private": false,
  "description": "Rimelight Entertainment's UI Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "import": "./dist/preset.mjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.mts",
      "import": "./dist/resolver.mjs"
    },
    "./shortcuts": {
      "types": "./dist/shortcuts.d.mts",
      "import": "./dist/shortcuts.mjs"
    },
    "./stores": {
      "types": "./dist/stores.d.mts",
      "import": "./dist/stores.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    },
    "./icons": {
      "types": "./dist/icons.d.mts",
      "import": "./dist/icons.mjs"
    },
    "./head": {
      "types": "./dist/head.d.mts",
      "import": "./dist/head.mjs"
    },
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm run build",
    "astro": "astro",
    "check": "vp check --fix && astro check",
    "test": "vp test"
  },
  "dependencies": {
    "@unocss/vite": "66.10.5",
    "unocss": "66.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/solid-js": "7.0.2",
    "@rimelight/config": "workspace:*",
    "astro": "7.3.3",
    "solid-js": "1.9.15",
    "vite-plugin-solid": "2.11.14"
  },
  "peerDependencies": {
    "@astrojs/solid-js": ">=7.0.1",
    "astro": ">=7.0.0",
    "solid-js": ">=1.9.13"
  },
  "peerDependenciesMeta": {
    "@astrojs/solid-js": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.8.2"
  },
  "packageManager": "pnpm@12.5.1"
}
