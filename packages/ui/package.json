  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/ui.ts",
    "./components/*": "./src/components/*",
    "./config": "./src/config.ts",
    "./stores/*": "./src/stores/*",
    "./utils/*": "./src/utils/*",
    "./types/*": "./src/types/*",
    "./icons/*": "./src/icons/*",
    "./presets": "./src/presets/index.ts",
    "./presets/*": "./src/presets/*",
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "astro": "astro"
  },
  "dependencies": {
    "@unocss/astro": "66.7.5",
    "css-variants": "2.3.5",
    "nanostores": "1.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/solid-js": "7.0.2",
    "@astrojs/ts-plugin": "1.10.10",
    "@astrojs/vue": "7.0.2",
    "astro": "7.2.0",
    "solid-js": "1.9.14",
    "typescript": "6.0.3",
    "unocss": "66.7.5",
    "vue": "3.5.41"
  },
  "peerDependencies": {
    "@astrojs/solid-js": ">=7.0.1",
    "@astrojs/vue": ">=7.0.1",
    "astro": ">=7.0.0",
    "solid-js": ">=1.9.13",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/solid-js": {
      "optional": true
    },
    "@astrojs/vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.7.0"
  }
