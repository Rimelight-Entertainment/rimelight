{
  "name": "@rimelight/ui",
  "version": "0.0.72",
  "private": false,
  "description": "Rimelight Entertainment's UI Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "solid": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs",
      "default": "./dist/plugin.mjs"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "solid": "./src/components/index.tsx",
      "import": "./src/components/index.tsx",
      "default": "./src/components/index.tsx"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "solid": "./dist/preset.mjs",
      "import": "./dist/preset.mjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.mts",
      "solid": "./dist/resolver.mjs",
      "import": "./dist/resolver.mjs"
    },
    "./shortcuts": {
      "types": "./dist/shortcuts.d.mts",
      "solid": "./dist/shortcuts.mjs",
      "import": "./dist/shortcuts.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "solid": "./dist/types.mjs",
      "import": "./dist/types.mjs"
    },
    "./icons": {
      "types": "./dist/icons.d.mts",
      "solid": "./dist/icons.mjs",
      "import": "./dist/icons.mjs"
    },
    "./head": {
      "types": "./dist/head.d.mts",
      "solid": "./dist/head.mjs",
      "import": "./dist/head.mjs"
    },
    "./fonts": {
      "types": "./dist/fonts.d.mts",
      "solid": "./dist/fonts.mjs",
      "import": "./dist/fonts.mjs"
    },
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm run build",
    "check": "vp check --fix",
    "test": "vp test"
  },
  "dependencies": {
    "@unocss/vite": "66.10.5",
    "unocss": "66.10.5"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@solidjs/web": "2.0.0-rc.11",
    "solid-js": "2.0.0-rc.11"
  },
  "peerDependencies": {
    "solid-js": ">=2.0.0-rc.11",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=26.6.0"
  },
  "packageManager": "pnpm@12.8.1"
}
