{
  "name": "@rimelight/ui",
  "version": "0.0.91",
  "private": false,
  "description": "Rimelight Entertainment's UI Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "solid": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./client": {
      "types": "./src/client.d.ts"
    },
    "./components": {
      "types": "./src/components/index.tsx",
      "solid": "./src/components/index.tsx",
      "import": "./src/components/index.tsx"
    },
    "./preset": {
      "types": "./dist/preset.d.mts",
      "solid": "./dist/preset.mjs",
      "import": "./dist/preset.mjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.mts",
      "solid": "./dist/resolver.mjs",
      "import": "./dist/resolver.mjs"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "solid": "./src/runtime.ts",
      "import": "./src/runtime.ts"
    },
    "./shortcuts": {
      "types": "./src/shortcuts.ts",
      "solid": "./src/shortcuts.ts",
      "import": "./src/shortcuts.ts"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "solid": "./dist/types.mjs",
      "import": "./dist/types.mjs"
    },
    "./icons": {
      "types": "./dist/icons.d.mts",
      "solid": "./dist/icons.mjs",
      "import": "./dist/icons.mjs"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "solid": "./src/theme.ts",
      "import": "./src/theme.ts"
    },
    "./meta": {
      "types": "./src/meta/index.ts",
      "solid": "./src/meta/index.ts",
      "import": "./src/meta/index.ts"
    },
    "./fonts": {
      "types": "./dist/fonts.d.mts",
      "solid": "./dist/fonts.mjs",
      "import": "./dist/fonts.mjs"
    },
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check --fix",
    "test": "vp test",
    "generate:meta": "vpx scripts/generate-meta.ts",
    "build": "vp run generate:meta && vp pack",
    "prepack": "vp run generate:meta && vp pack"
  },
  "dependencies": {
    "@rimelight/i18n": "workspace:*",
    "@unocss/vite": "66.12.0",
    "unocss": "66.12.0"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*",
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/vite-plugin": "3.0.0-next.52",
    "@solidjs/web": "2.0.0-rc.20",
    "happy-dom": "21.0.4",
    "solid-js": "2.0.0-rc.20"
  },
  "peerDependencies": {
    "@solidjs/router": ">=2.0.0-next.42",
    "@solidjs/web": ">=2.0.0-rc.18",
    "solid-js": ">=2.0.0-rc.18",
    "vite-plus": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/router": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.16.1"
}
