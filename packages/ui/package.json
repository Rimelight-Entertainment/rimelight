{
  "name": "@rimelight/ui",
  "version": "0.0.34",
  "private": false,
  "description": "Rimelight Entertainment UI Library.",
  "keywords": [
    "astro",
    "typescript"
  ],
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Daniel Marchi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "src",
    "worker-configuration.d.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/integrations/index.ts",
    "./styles/*": "./src/styles/*",
    "./components/*": "./src/components/*",
    "./components/astro/*": "./src/components/astro/*",
    "./components/vue/*": "./src/components/vue/*",
    "./themes": "./src/themes/index.ts",
    "./themes/*": "./src/themes/*",
    "./composables": "./src/composables/index.ts",
    "./composables/*": "./src/composables/*",
    "./config": "./src/config/index.ts",
    "./config/*": "./src/config/*",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*",
    "./integrations": "./src/integrations/index.ts",
    "./integrations/*": "./src/integrations/*",
    "./docs": "./src/docs/extractAll.ts",
    "./docs/*": "./src/docs/*",
    "./plugins": "./src/plugins/index.ts",
    "./plugins/*": "./src/plugins/*",
    "./middleware": "./src/middleware/index.ts",
    "./middleware/*": "./src/middleware/*",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*",
    "./presets": "./src/presets/index.ts",
    "./presets/*": "./src/presets/*",
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "astro": "astro",
    "docs:meta": "tsx scripts/extract-meta.ts"
  },
  "dependencies": {
    "@astrojs/vue": "6.0.1",
    "@iconify-json/lucide": "1.2.113",
    "@unocss/astro": "^66.7.2",
    "css-variants": "2.3.5",
    "defu": "6.1.7",
    "embla-carousel": "8.6.0",
    "nanostores": "1.3.0",
    "picomatch": "^4.0.4",
    "vite-plugin-virtual": "^0.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/ts-plugin": "1.10.9",
    "@e18e/eslint-plugin": "0.5.1",
    "@types/node": "25.9.3",
    "@types/picomatch": "^4.0.3",
    "@unocss/eslint-plugin": "66.7.2",
    "astro": "6.4.8",
    "eslint-plugin-regexp": "3.1.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "unocss": "66.7.2",
    "vite-plus": "0.2.1"
  },
  "peerDependencies": {
    "astro": ">=6.0.0",
    "vue": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.8.0"
}
