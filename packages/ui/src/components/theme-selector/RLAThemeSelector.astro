---
import type { ThemeSelectorProps } from "./theme-selector"
import { themeSelectorTheme } from "./theme-selector.theme"
import RLAButton from "../button/RLAButton.astro"
import RLAIcon from "../icon/RLAIcon.astro"



const {
  size = "md",
  ...rest
} = Astro.props as ThemeSelectorProps

const classes = themeSelectorTheme(Astro.props);
---

<rla-theme-selector {...rest}>
    <RLAButton
            size={size}
            class:list={["theme-toggle-button", classes.root]}
            variant="ghost"
            square
            aria-label="Toggle theme"
    >
        <RLAIcon name="i-rl-sun" class={classes.sun} />
        <RLAIcon name="i-rl-moon" class={classes.moon} />
    </RLAButton>
</rla-theme-selector>

<style is:global>
    .rla-theme-sun { display: none; }
    [data-theme="dark"] .rla-theme-sun { display: block; }
    .rla-theme-moon { display: block; }
    [data-theme="dark"] .rla-theme-moon { display: none; }
</style>

<script>
    import { defineShortcuts } from "../../shortcuts"

    function applyStoredTheme() {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
        }
    }

    applyStoredTheme();

    function onToggle() {
        const willBeDark = document.documentElement.getAttribute('data-theme') !== 'dark';
        document.documentElement.setAttribute('data-theme', willBeDark ? 'dark' : 'light');
        localStorage.setItem('theme', willBeDark ? 'dark' : 'light');

        document.querySelectorAll('.theme-toggle-button').forEach(btn => {
            btn.setAttribute('data-state', willBeDark ? 'on' : 'off');
            btn.setAttribute('aria-pressed', willBeDark.toString());
        });
    }

    class RLAThemeSelector extends HTMLElement {
        private buttonCleanup: (() => void) | null = null;

        connectedCallback() {
            this.style.display = 'contents';
            const button = this.querySelector('.theme-toggle-button');
            if (!button) return;

            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            button.setAttribute('data-state', isDark ? 'on' : 'off');
            button.setAttribute('aria-pressed', isDark.toString());

            button.addEventListener('click', onToggle);

            const cleanupShortcut = defineShortcuts({
                meta_alt_t: {
                    handler: onToggle,
                    label: "Toggle Theme",
                    description: "Switch between light and dark theme mode",
                    category: "system"
                }
            });

            this.buttonCleanup = () => {
                button.removeEventListener('click', onToggle);
                cleanupShortcut();
            };
        }

        disconnectedCallback() {
            if (this.buttonCleanup) {
                this.buttonCleanup();
                this.buttonCleanup = null;
            }
        }
    }

    if (!customElements.get('rla-theme-selector')) {
        customElements.define('rla-theme-selector', RLAThemeSelector);
    }
</script>
