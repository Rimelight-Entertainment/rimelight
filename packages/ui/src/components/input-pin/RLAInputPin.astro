---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { InputPinProps } from "./input-pin"
import { inputPinTheme } from "./input-pin.theme"


const inputPin = scv(inputPinTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as InputPinProps

const classes = resolveClasses(inputPin, {}, useUi("inputPin", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>