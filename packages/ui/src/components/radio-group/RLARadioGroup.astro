---
import type { RadioGroupProps } from "./radio-group"
import { radioGroupTheme } from "./radio-group.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as RadioGroupProps

const classes = radioGroupTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>