---
import type { ErrorProps } from "./error"
import { errorTheme } from "./error.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ErrorProps

const classes = errorTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>