---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { ErrorProps } from "./error"
import errorThemeDefault, { createErrorTheme } from "./error.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const errorTheme = uiConfig.colors ? createErrorTheme() : errorThemeDefault

const error = scv(errorTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ErrorProps

const classes = resolveClasses(error, {}, useUi("error", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>