---
import type { InputTimeProps } from "./input-time"
import { inputTimeTheme } from "./input-time.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as InputTimeProps

const classes = inputTimeTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>