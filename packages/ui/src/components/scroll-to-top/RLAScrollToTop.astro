---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { ScrollToTopProps } from "./scroll-to-top"
import scrollToTopTheme from "./scroll-to-top.theme"


const scrollToTop = scv(scrollToTopTheme)

const {
  color = "primary",
  progressWidth = 6,
  duration = 0.1,
  threshold = 200,
  showProgress = false,
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ScrollToTopProps

const classes = resolveClasses(scrollToTop, { color, theme }, useUi("scrollToTop", uiProp), className)

---

<rla-scroll-to-top data-threshold={threshold} data-duration={duration} data-color={color} data-progress-width={progressWidth} {...rest}>
  <div
    class:list={["rla-scroll-to-top-inner", "fixed bottom-6 right-6 z-50", classes.root]}
  >
    <button
      type="button"
      class={classes.button}
      aria-label="Scroll to top"
      data-scroll-to-top-button
    >
      <div class={classes.progressBase}>
        <div class="gauge-track"></div>
        {showProgress && (
        <div class="gauge-progress" data-gauge-progress></div>
        )}
        <div class={classes.iconContainer}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class={classes.icon}
          >
            <path d="m5 12 7-7 7 7" />
            <path d="M12 19V5" />
          </svg>
        </div>
      </div>
    </button>
  </div>
</rla-scroll-to-top>

<script>
  import { trackScroll, scrollToTop } from "../../utils/scroll"

  class RLAScrollToTop extends HTMLElement {
    private cleanupScroll: (() => void) | null = null;
    private styleEl: HTMLStyleElement | null = null;

    connectedCallback() {
      this.style.display = 'contents';
      const button = this.querySelector('[data-scroll-to-top-button]');
      const innerElement = this.querySelector('.rla-scroll-to-top-inner') as HTMLElement | null;

      if (!button || !innerElement) return;

      const id = ++RLAScrollToTop.instanceCounter;
      const threshold = Number(this.dataset.threshold) || 200;
      const color = this.dataset.color || 'primary';
      const progressWidth = Number(this.dataset.progressWidth) || 6;
      const gaugeBorderWidth = progressWidth * 0.5;
      const nonce = (document.querySelector('meta[name="csp-nonce"]')?.getAttribute('content') ?? '');

      const getStyleEl = () => {
        if (!this.styleEl) {
          this.styleEl = document.createElement('style');
          if (nonce) this.styleEl.setAttribute('nonce', nonce);
          document.head.appendChild(this.styleEl);
        }
        return this.styleEl;
      };

      innerElement.dataset.rlaInstance = String(id);

      button.addEventListener('click', scrollToTop);

      /**
       * CSS scroll-state(scrollable: top) — Chrome 133+
       *
       * When supported, the body (or nearest scroll-state container) exposes
       * its scrollability to CSS. The .rla-scroll-to-top-inner uses a
       * \`@container\` scroll-state rule to hide itself when the page is already
       * at the top. This eliminates the scroll event listener for show/hide.
       *
       * For browsers that don't support scroll-state() we fall back to the
       * JS trackScroll() approach below.
       */
      const supportsScrollState = CSS.supports('(scroll-state(scrollable: top): 1)') ||
        CSS.supports('selector(@container scroll-state(scrollable: top))');

      if (!supportsScrollState) {
        // JS fallback: show/hide via class toggling
        const unsubscribeVisibility = trackScroll({ threshold }, (state) => {
          if (state.isVisible) {
            innerElement.classList.add('js-visible');
          } else {
            innerElement.classList.remove('js-visible');
          }
        });
        this.cleanupScroll = () => {
          button.removeEventListener('click', scrollToTop);
          unsubscribeVisibility();
          if (this.styleEl) {
            this.styleEl.remove();
            this.styleEl = null;
          }
        };
      }

      // Progress ring always needs JS (conic-gradient % calculation)
      const unsubscribeProgress = trackScroll({ threshold }, (state) => {
        getStyleEl().textContent = `
          .rla-scroll-to-top-inner[data-rla-instance="${id}"] .gauge-track {
            border-width: ${gaugeBorderWidth}px;
            border-color: var(--color-${color}-900);
            background-color: #000;
          }
          .rla-scroll-to-top-inner[data-rla-instance="${id}"] .gauge-progress {
            --gauge-progress: ${state.scrollPercentage};
            --gauge-stroke-width: ${gaugeBorderWidth}px;
            --gauge-color: var(--color-${color}-500);
          }
        `;
      });

      if (!this.cleanupScroll) {
        this.cleanupScroll = () => {
          button.removeEventListener('click', scrollToTop);
          unsubscribeProgress();
          if (this.styleEl) {
            this.styleEl.remove();
            this.styleEl = null;
          }
        };
      }
    }

    disconnectedCallback() {
      if (this.cleanupScroll) {
        this.cleanupScroll();
        this.cleanupScroll = null;
      }
    }

    static instanceCounter = 0;
  }

  if (!customElements.get('rla-scroll-to-top')) {
    customElements.define('rla-scroll-to-top', RLAScrollToTop);
  }
</script>

<style>
  /*
   * CSS scroll-state(scrollable: top) — Chrome 133+
   *
   * This declares the <body> as a scroll-state container so descendant
   * elements can query whether the body is scrollable at the top.
   * When the user is already at the top of the page, the button hides itself.
   */
  :global(body) {
    container-type: scroll-state;
    container-name: rla-page-scroll;
  }

  .rla-scroll-to-top-inner {
    /* Default: hidden (for JS fallback path) */
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-in-out;
  }

  /* JS fallback visibility class */
  .rla-scroll-to-top-inner.js-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /*
   * CSS scroll-state path: show the button whenever the page IS scrollable
   * downward (i.e., user has scrolled past the top). Hide it when already at top.
   */
  @supports (container-type: scroll-state) {
    @container rla-page-scroll scroll-state(not scrollable: top) {
      .rla-scroll-to-top-inner {
        opacity: 1;
        pointer-events: auto;
      }
    }

    @container rla-page-scroll scroll-state(scrollable: top) {
      .rla-scroll-to-top-inner {
        opacity: 0;
        pointer-events: none;
      }
    }
  }

  .progress-circle-base {
    position: relative;
    transform: translateZ(0);
  }

  .gauge-track {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border-style: solid;
  }

  .gauge-progress {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      var(--gauge-color, var(--color-primary-500)) 0deg,
      var(--gauge-color, var(--color-primary-500)) calc(var(--gauge-progress, 0) * 3.6deg),
      transparent calc(var(--gauge-progress, 0) * 3.6deg)
    );
    -webkit-mask: radial-gradient(
      circle closest-side,
      transparent calc(100% - var(--gauge-stroke-width, 6px)),
      #000 calc(100% - var(--gauge-stroke-width, 6px))
    );
    mask: radial-gradient(
      circle closest-side,
      transparent calc(100% - var(--gauge-stroke-width, 6px)),
      #000 calc(100% - var(--gauge-stroke-width, 6px))
    );
  }
</style>
