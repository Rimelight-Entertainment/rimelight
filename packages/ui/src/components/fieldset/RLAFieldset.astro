---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { FieldsetProps } from "./fieldset"
import fieldsetTheme from "./fieldset.theme"


const fieldset = scv(fieldsetTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as FieldsetProps

const classes = resolveClasses(fieldset, {}, useUi("fieldset", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>