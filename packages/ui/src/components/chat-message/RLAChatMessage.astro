---
import type { ChatMessageProps } from "./chat-message"
import { chatMessageTheme } from "./chat-message.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatMessageProps

const classes = chatMessageTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>