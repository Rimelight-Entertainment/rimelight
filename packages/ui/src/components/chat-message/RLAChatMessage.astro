---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { ChatMessageProps } from "./chat-message"
import chatMessageThemeDefault, { createChatMessageTheme } from "./chat-message.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const chatMessageTheme = uiConfig.colors ? createChatMessageTheme() : chatMessageThemeDefault

const chatMessage = scv(chatMessageTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatMessageProps

const classes = resolveClasses(chatMessage, {}, useUi("chatMessage", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>