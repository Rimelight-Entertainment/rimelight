---
import type { HTMLAttributes } from "astro/types"

interface Props extends HTMLAttributes<"time"> {
  date: Date | string | number
  locale?: string
  options?: Intl.DateTimeFormatOptions
}

const {
  date,
  locale = Astro.currentLocale || "en-US",
  options = {
    year: "numeric",
    month: "short",
    day: "numeric",
  },
  ...rest
} = Astro.props

const resolvedDate = date instanceof Date ? date : new Date(date)
const formatted = isNaN(resolvedDate.getTime())
  ? ""
  : resolvedDate.toLocaleDateString(locale, options)
const datetime = isNaN(resolvedDate.getTime()) ? "" : resolvedDate.toISOString()
---

<time datetime={datetime} {...rest}>
  {formatted}
</time>
