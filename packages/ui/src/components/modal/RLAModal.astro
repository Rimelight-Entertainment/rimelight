---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { ModalProps } from "./modal"
import { modalTheme } from "./modal.theme"
import RLAIcon from "../icon/RLAIcon.astro"


const modal = scv(modalTheme)

const {
  open = false,
  triggerLabel,
  closeOnClickOutside = true,
  closeOnEscape = true,
  lockScroll = true,
  title,
  description,
  size = "md",
  ui: uiProp,
  class: className,
  unmountOnHide = true,
  ...rest
} = Astro.props as ModalProps & { size?: "sm" | "md" | "lg" | "xl" }

const classes = resolveClasses(modal, {
  size
}, useUi("modal", uiProp), className)

const modalId = `rla-modal-${Math.random().toString(36).substring(2, 9)}`
---
<div class={classes.root} data-slot="modal-container">
  {triggerLabel ? (
    <button
      class={classes.trigger}
      data-slot="trigger"
      type="button"
      data-dialog-show={modalId}
    >
      {triggerLabel}
    </button>
  ) : (
    <span data-dialog-show={modalId}>
      <slot name="trigger" />
    </span>
  )}

  <dialog
    id={modalId}
    class={classes.content}
    data-slot="content"
    data-lock-scroll={lockScroll ? "true" : "false"}
    data-close-on-escape={closeOnEscape ? "true" : "false"}
    data-close-on-click-outside={closeOnClickOutside ? "true" : "false"}
    data-unmount-on-hide={unmountOnHide ? "true" : "false"}
    {...rest}
  >
    <button
      class={classes.closeButton}
      data-slot="close-button"
      type="button"
      data-dialog-close={modalId}
      aria-label="Close modal"
    >
      <RLAIcon name="close" class="size-4" aria-hidden="true" />
    </button>

    <div class={classes.header} data-slot="header">
      {title && <h3 class={classes.title} data-slot="title">{title}</h3>}
      <slot name="title" />
      
      {description && <p class={classes.description} data-slot="description">{description}</p>}
      <slot name="description" />
    </div>

    <slot />

    <div class={classes.footer} data-slot="footer">
      <slot name="footer" />
    </div>
  </dialog>
</div>

<script>
  /**
   * <dialog> handles natively:
   *  - Focus trap (Tab cycles only inside the dialog)
   *  - Escape key dismissal (fires 'cancel' event)
   *  - Top-layer stacking (no z-index wrestling)
   *  - aria-modal semantics
   *
   * This script only adds:
   *  - Show trigger wiring
   *  - Close button wiring
   *  - Click-outside detection (via backdrop click: e.target === dialog)
   *  - Optional scroll lock on <body>
   *  - Optional Escape suppression (data-close-on-escape="false")
   *  - Optional unmountOnHide (innerHTML save/restore)
   */
  const openDialog = (dialog: HTMLDialogElement) => {
    // Restore content if it was unmounted
    if (dialog.getAttribute('data-unmount-on-hide') === 'true' && (dialog as any).rlaSavedHtml) {
      dialog.innerHTML = (dialog as any).rlaSavedHtml;
      delete (dialog as any).rlaSavedHtml;
    }
    dialog.showModal();
    if (dialog.getAttribute('data-lock-scroll') === 'true') {
      document.body.style.overflow = 'hidden';
    }
  };

  const closeDialog = (dialog: HTMLDialogElement) => {
    dialog.close();
    if (dialog.getAttribute('data-lock-scroll') === 'true') {
      document.body.style.overflow = '';
    }
    if (dialog.getAttribute('data-unmount-on-hide') === 'true') {
      (dialog as any).rlaSavedHtml = dialog.innerHTML;
      dialog.innerHTML = '';
    }
  };

  if (!(window as any).rlaDialogListenerActive) {
    (window as any).rlaDialogListenerActive = true;

    // Show triggers
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // Open
      const showTrigger = target.closest('[data-dialog-show]');
      if (showTrigger) {
        const dialogId = showTrigger.getAttribute('data-dialog-show');
        if (dialogId) {
          const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
          if (dialog) openDialog(dialog);
        }
        return;
      }

      // Close button
      const closeTrigger = target.closest('[data-dialog-close]');
      if (closeTrigger) {
        const dialogId = closeTrigger.getAttribute('data-dialog-close');
        if (dialogId) {
          const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
          if (dialog) closeDialog(dialog);
        }
        return;
      }

      // Click-outside: for <dialog>, e.target IS the dialog element itself when clicking
      // on the backdrop (the dialog's padding area outside its content box).
      if (target.tagName === 'DIALOG' && target.getAttribute('data-close-on-click-outside') === 'true') {
        closeDialog(target as HTMLDialogElement);
      }
    });

    // Escape key — suppress if data-close-on-escape="false", otherwise browser
    // fires 'cancel' naturally which closes the dialog.
    document.addEventListener('cancel', (e) => {
      const dialog = e.target as HTMLDialogElement | null;
      if (!dialog || dialog.tagName !== 'DIALOG') return;

      if (dialog.getAttribute('data-close-on-escape') === 'false') {
        e.preventDefault();
        return;
      }
      // Let the browser close it, then clean up
      if (dialog.getAttribute('data-lock-scroll') === 'true') {
        document.body.style.overflow = '';
      }
      if (dialog.getAttribute('data-unmount-on-hide') === 'true') {
        requestAnimationFrame(() => {
          (dialog as any).rlaSavedHtml = dialog.innerHTML;
          dialog.innerHTML = '';
        });
      }
    });

    // Save initial HTML for dialogs that unmount on hide
    document.querySelectorAll('dialog[data-unmount-on-hide="true"]').forEach(dialog => {
      (dialog as any).rlaSavedHtml = dialog.innerHTML;
    });
  }
</script>
