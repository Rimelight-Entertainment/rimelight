---
import type { SkeletonProps } from "./skeleton"
import { skeletonTheme } from "./skeleton.theme"



const {
  shape = "rounded",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SkeletonProps

const classes = skeletonTheme({
  shape,
  ui: uiProp,
  class: className
})
---
<div class={classes.root} data-slot="root" {...rest} />
