---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { SpeedDialProps } from "./speed-dial"
import speedDialThemeDefault, { createSpeedDialTheme } from "./speed-dial.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const speedDialTheme = uiConfig.colors ? createSpeedDialTheme() : speedDialThemeDefault

const speedDial = scv(speedDialTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SpeedDialProps

const classes = resolveClasses(speedDial, {}, useUi("speedDial", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>