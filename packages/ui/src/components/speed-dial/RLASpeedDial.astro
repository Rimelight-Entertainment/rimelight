---
import type { SpeedDialProps } from "./speed-dial"
import { speedDialTheme } from "./speed-dial.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SpeedDialProps

const classes = speedDialTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>