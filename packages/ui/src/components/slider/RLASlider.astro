---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { SliderProps } from "./slider"
import { sliderTheme } from "./slider.theme"

const slider = scv(sliderTheme)

const {
  value = 0,
  min = 0,
  max = 100,
  step = 1,
  name,
  color = "primary",
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SliderProps

const classes = resolveClasses(slider, {
  color,
  theme
}, useUi("slider", uiProp), className)

const percentage = Math.min(100, Math.max(0, ((value - min) / (max - min)) * 100))
---
<div class={classes.root} data-slot="slider-root" {...rest}>
  <div class={classes.track} data-slot="track">
    <svg class="h-full w-full overflow-visible pointer-events-none">
      <rect class:list={[classes.range, "h-full"]} width={`${percentage}%`} fill="currentColor" rx="2" />
    </svg>
  </div>
  <input
    type="range"
    min={min}
    max={max}
    step={step}
    value={value}
    name={name}
    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
    data-slot="input"
  />
  <svg class="absolute inset-0 h-full w-full overflow-visible pointer-events-none">
    <circle
      cx={`${percentage}%`}
      cy="50%"
      r="8"
      class:list={[classes.thumb, "pointer-events-auto border-none"]}
      data-slot="thumb"
      fill="currentColor"
    />
  </svg>
</div>
