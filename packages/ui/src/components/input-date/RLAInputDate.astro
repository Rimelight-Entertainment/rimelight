---
import type { InputDateProps } from "./input-date"
import { inputDateTheme } from "./input-date.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as InputDateProps

const classes = inputDateTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>