---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { InputDateProps } from "./input-date"
import inputDateThemeDefault, { createInputDateTheme } from "./input-date.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const inputDateTheme = uiConfig.colors ? createInputDateTheme() : inputDateThemeDefault

const inputDate = scv(inputDateTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as InputDateProps

const classes = resolveClasses(inputDate, {}, useUi("inputDate", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>