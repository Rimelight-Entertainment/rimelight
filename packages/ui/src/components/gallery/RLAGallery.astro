---
import type { GalleryProps } from "./gallery"
import { galleryTheme } from "./gallery.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as GalleryProps

const classes = galleryTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>