---
import type { SpinnerProps } from "./spinner"
import { spinnerTheme } from "./spinner.theme"


const {
  size = "md",
  color = "current",
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SpinnerProps

const classes = spinnerTheme({
  size,
  color,
  theme,
  ui: uiProp,
  class: className
})
---
<div class={classes.root} data-slot="root" {...rest} />
