---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { SpinnerProps } from "./spinner"
import { resolveTheme } from "../../utils/resolveTheme"
import spinnerThemeDefault, { createSpinnerTheme } from "./spinner.theme"
const spinnerTheme = resolveTheme(spinnerThemeDefault, createSpinnerTheme)

const spinner = scv(spinnerTheme)

const {
  size = "md",
  color = "current",
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SpinnerProps

const classes = resolveClasses(spinner, {
  size,
  color,
  theme
}, useUi("spinner", uiProp), className)
---
<div class={classes.root} data-slot="root" {...rest} />
