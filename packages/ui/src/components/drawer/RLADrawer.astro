---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { DrawerProps } from "./drawer"
import { resolveTheme } from "../../utils/resolveTheme"
import drawerThemeDefault, { createDrawerTheme } from "./drawer.theme"
const drawerTheme = resolveTheme(drawerThemeDefault, createDrawerTheme)
import RLAIcon from "../icon/RLAIcon.astro"


const drawer = scv(drawerTheme)

const {
  direction = "bottom",
  title,
  description,
  triggerLabel,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DrawerProps

const classes = resolveClasses(drawer, {
  direction
}, useUi("drawer", uiProp), className)

const dialogId = `rla-drawer-${Math.random().toString(36).substring(2, 9)}`
---
<div class={classes.root} data-slot="drawer-container">
  {triggerLabel ? (
    <button
      class={classes.trigger}
      data-slot="trigger"
      type="button"
      data-dialog-show={dialogId}
    >
      {triggerLabel}
    </button>
  ) : (
    <span data-dialog-show={dialogId}>
      <slot name="trigger" />
    </span>
  )}

  <dialog
    id={dialogId}
    class={classes.content}
    data-slot="content"
    data-close-on-click-outside="true"
    {...rest}
  >
    <div class={classes.handle} data-slot="handle" />

    <button
      class={classes.closeButton}
      data-slot="close-button"
      type="button"
      data-dialog-close={dialogId}
      aria-label="Close drawer"
    >
      <RLAIcon name="close" class="size-4" aria-hidden="true" />
    </button>

    <div class={classes.header} data-slot="header">
      {title && <h3 class={classes.title} data-slot="title">{title}</h3>}
      <slot name="title" />
      
      {description && <p class={classes.description} data-slot="description">{description}</p>}
      <slot name="description" />
    </div>

    <slot />

    <div class={classes.footer} data-slot="footer">
      <slot name="footer" />
    </div>
  </dialog>
</div>

<script>
  if (!(window as any).rlaDialogListenerActive) {
    (window as any).rlaDialogListenerActive = true;
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const showTrigger = target.closest('[data-dialog-show]');
      if (showTrigger) {
        const dialogId = showTrigger.getAttribute('data-dialog-show');
        if (dialogId) {
          const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
          if (dialog) {
            if (typeof dialog.showModal === 'function') {
              dialog.showModal();
            } else if (typeof (dialog as any).showmodal === 'function') {
              (dialog as any).showmodal();
            }
          }
        }
      }

      const closeTrigger = target.closest('[data-dialog-close]');
      if (closeTrigger) {
        const dialogId = closeTrigger.getAttribute('data-dialog-close');
        if (dialogId) {
          const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
          dialog?.close();
        }
      }

      if (target.tagName === 'DIALOG' && target.getAttribute('data-close-on-click-outside') === 'true') {
        const rect = target.getBoundingClientRect();
        const isInModal = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInModal) {
          (target as HTMLDialogElement).close();
        }
      }
    });
  }
</script>
