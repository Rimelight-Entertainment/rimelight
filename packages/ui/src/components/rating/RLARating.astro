---
import type { RatingProps } from "./rating"
import { ratingTheme } from "./rating.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as RatingProps

const classes = ratingTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>