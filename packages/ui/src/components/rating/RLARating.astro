---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { RatingProps } from "./rating"
import { ratingTheme } from "./rating.theme"


const rating = scv(ratingTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as RatingProps

const classes = resolveClasses(rating, {}, useUi("rating", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>