---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { CalendarProps } from "./calendar"
import { calendarTheme } from "./calendar.theme"


const calendar = scv(calendarTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as CalendarProps

const classes = resolveClasses(calendar, {}, useUi("calendar", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>