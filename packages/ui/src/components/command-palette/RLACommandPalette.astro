---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { CommandPaletteProps } from "./command-palette"
import commandPaletteTheme from "./command-palette.theme"


const commandPalette = scv(commandPaletteTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as CommandPaletteProps

const classes = resolveClasses(commandPalette, {}, useUi("commandPalette", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>