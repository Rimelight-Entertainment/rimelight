---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { WindowMockupProps } from "./window-mockup"
import windowMockupTheme from "./window-mockup.theme"


const windowMockup = scv(windowMockupTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as WindowMockupProps

const classes = resolveClasses(windowMockup, {}, useUi("windowMockup", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>