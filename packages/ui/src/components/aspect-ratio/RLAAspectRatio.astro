---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { AspectRatioProps } from "./aspect-ratio"
import aspectRatioThemeDefault, { createAspectRatioTheme } from "./aspect-ratio.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const aspectRatioTheme = uiConfig.colors ? createAspectRatioTheme() : aspectRatioThemeDefault

const aspectRatio = scv(aspectRatioTheme)

const {
  ratio = 1,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as AspectRatioProps

const classes = resolveClasses(aspectRatio, {}, useUi("aspectRatio", uiProp), className)
---
<div class:list={[classes.root]} data-slot="root" {...rest}>
  <svg viewBox={`0 0 100 ${(1 / ratio) * 100}`} class="w-full h-auto pointer-events-none block" aria-hidden="true"></svg>
  <div class={classes.content} data-slot="content">
    <slot />
  </div>
</div>
