---
import type { FormProps } from "./form"
import { formTheme } from "./form.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as FormProps

const classes = formTheme({
  ui: uiProp,
  class: className
});
---
<form class={classes.root} data-slot="root" {...rest}>
  <slot />
</form>