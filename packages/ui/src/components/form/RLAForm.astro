---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { FormProps } from "./form"
import formThemeDefault, { createFormTheme } from "./form.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const formTheme = uiConfig.colors ? createFormTheme() : formThemeDefault

const form = scv(formTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as FormProps

const classes = resolveClasses(form, {}, useUi("form", uiProp), className);
---
<form class={classes.root} data-slot="root" {...rest}>
  <slot />
</form>