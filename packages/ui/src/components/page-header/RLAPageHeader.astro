---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { PageHeaderProps } from "./page-header"
import pageHeaderTheme from "./page-header.theme"


const pageHeader = scv(pageHeaderTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PageHeaderProps

const classes = resolveClasses(pageHeader, {}, useUi("pageHeader", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>