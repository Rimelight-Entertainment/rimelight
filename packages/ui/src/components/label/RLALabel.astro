---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { LabelProps } from "./label"
import { resolveTheme } from "../../utils/resolver"
import labelThemeDefault, { createLabelTheme } from "./label.theme"
const labelTheme = resolveTheme(labelThemeDefault, createLabelTheme)


const label = scv(labelTheme)

const {
  for: htmlFor,
  size = "md",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as LabelProps

const classes = resolveClasses(label, {
  size
}, useUi("label", uiProp), className)
---
<label class={classes.root} data-slot="root" for={htmlFor} {...rest}>
  <slot />
</label>
