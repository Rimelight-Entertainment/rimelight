---
import type { LabelProps } from "./label"
import { labelTheme } from "./label.theme"



const {
  for: htmlFor,
  size = "md",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as LabelProps

const classes = labelTheme({
  size,
  ui: uiProp,
  class: className
})
---
<label class={classes.root} data-slot="root" for={htmlFor} {...rest}>
  <slot />
</label>
