---
import type { KbdProps } from "./kbd"
import { kbdTheme } from "./kbd.theme"



const {
  size = "md",
  color = "neutral",
  variant = "outline",
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as KbdProps



const classes = kbdTheme({
  size,
  color: color as "neutral",
  variant: variant as "solid",
  theme: theme as "dark",
  ui: uiProp,
  class: className
})
---
<kbd class={classes.root} data-slot="root" {...rest}>
  <slot />
</kbd>
