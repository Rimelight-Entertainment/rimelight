---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { KbdProps } from "./kbd"
import { resolveTheme } from "../../utils/resolveTheme"
import kbdThemeDefault, { createKbdTheme } from "./kbd.theme"
const kbdTheme = resolveTheme(kbdThemeDefault, createKbdTheme)


const kbd = scv(kbdTheme)

const {
  size = "md",
  color = "neutral",
  variant = "outline",
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as KbdProps & { color?: string; variant?: string; theme?: string }

const classes = resolveClasses(kbd, {
  size,
  color: color as "neutral",
  variant: variant as "solid",
  theme: theme as "dark"
}, useUi("kbd", uiProp), className)
---
<kbd class={classes.root} data-slot="root" {...rest}>
  <slot />
</kbd>
