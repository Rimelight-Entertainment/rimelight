---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { DashboardSearchProps } from "./dashboard-search"
import dashboardSearchThemeDefault, { createDashboardSearchTheme } from "./dashboard-search.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const dashboardSearchTheme = uiConfig.colors ? createDashboardSearchTheme() : dashboardSearchThemeDefault

const dashboardSearch = scv(dashboardSearchTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardSearchProps

const classes = resolveClasses(dashboardSearch, {}, useUi("dashboardSearch", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>