---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { CalloutProps } from "./callout"
import { resolveTheme } from "../../utils/resolver"
import calloutThemeDefault, { createCalloutTheme } from "./callout.theme"
const calloutTheme = resolveTheme(calloutThemeDefault, createCalloutTheme)
import RLAAvatar from "../avatar/RLAAvatar.astro"
import RLAIcon from "../icon/RLAIcon.astro"

const callout = scv(calloutTheme)

const {
  variant = "solid",
  color = "primary",
  title,
  description,
  icon,
  avatar,
  actions,
  close,
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as CalloutProps

const colorToIcon: Record<string, string | undefined> = {
  error: "circleX",
  warning: "alertTriangle",
  info: "info",
  success: "circleCheck",
  primary: undefined,
  secondary: undefined,
  commentary: undefined,
  ideation: undefined,
  source: undefined,
  neutral: undefined
}

const resolvedColor = (variant === "destructive") ? "error" : color
const resolvedVariant = (variant === "solid" || variant === "outline" || variant === "soft" || variant === "subtle") ? variant : "solid"
const resolvedIcon = icon ?? colorToIcon[resolvedColor]
const hasTitleRow = !!(title || Astro.slots.has("title") || Astro.slots.has("header") || avatar || close || Astro.slots.has("close"))

const classes = resolveClasses(callout, {
  variant: resolvedVariant,
  color: resolvedColor as any,
  theme
}, useUi("callout", uiProp), className)
---
<div
  class={classes.root}
  data-slot="root"
  role="alert"
  {...rest}
>
  <slot name="icon">
    {resolvedIcon && (
      <span class={classes.icon} data-slot="icon">
        <RLAIcon name={resolvedIcon} />
      </span>
    )}
  </slot>

  <div class={classes.body} data-slot="body">
    {hasTitleRow && (
      <div class="flex items-center gap-2.5">
        <slot name="avatar" {...{ ui: classes }}>
          {avatar && (
            <RLAAvatar
              {...(typeof avatar === 'string' ? { src: avatar } : avatar)}
              size={classes.avatarSize as any}
              class={classes.avatar}
              data-slot="avatar"
            />
          )}
        </slot>

        {(title || Astro.slots.has("title")) && (
          <h5 class={classes.title} data-slot="title">
            {title}
            <slot name="title" />
          </h5>
        )}

        <slot name="header" />

        <slot name="close">
          {close && (
            <button class={classes.close} data-slot="close">
              <RLAIcon name="close" class="size-4" />
            </button>
          )}
        </slot>
      </div>
    )}

    {(description || Astro.slots.has("default")) && (
      <div class={classes.content} data-slot="content">
        {description}
        <slot />
      </div>
    )}

    {(actions || Astro.slots.has("actions")) && (
      <div class={classes.actions} data-slot="actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</div>
