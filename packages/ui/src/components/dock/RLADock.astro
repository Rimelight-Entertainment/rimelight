---
import type { DockProps } from "./dock"
import { dockTheme } from "./dock.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DockProps

const classes = dockTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>