---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { ProgressProps } from "./progress"
import { resolveTheme } from "../../utils/resolveTheme"
import progressThemeDefault, { createProgressTheme } from "./progress.theme"
const progressTheme = resolveTheme(progressThemeDefault, createProgressTheme)

const progress = scv(progressTheme)

const {
  value = 0,
  max = 100,
  color = "primary",
  size = "md",
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ProgressProps

const classes = resolveClasses(progress, {
  color,
  size,
  theme
}, useUi("progress", uiProp), className)

const percentage = Math.min(100, Math.max(0, (value / max) * 100))
const id = `progress-${Math.random().toString(36).substring(2, 9)}`
---
<div
  class={classes.root}
  data-slot="progress-root"
  role="progressbar"
  aria-valuemin={0}
  aria-valuemax={max}
  aria-valuenow={value}
  {...rest}
>
  <div
    class:list={[classes.indicator, id]}
    data-slot="indicator"
  />
</div>

<style is:inline set:html={`
  .${id} {
    transform: translateX(-${100 - percentage}%) !important;
  }
`} />
