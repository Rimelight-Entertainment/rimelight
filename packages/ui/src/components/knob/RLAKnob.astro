---
import type { KnobProps } from "./knob"
import { knobTheme } from "./knob.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as KnobProps

const classes = knobTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>