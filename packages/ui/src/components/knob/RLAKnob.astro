---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { KnobProps } from "./knob"
import knobTheme from "./knob.theme"


const knob = scv(knobTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as KnobProps

const classes = resolveClasses(knob, {}, useUi("knob", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>