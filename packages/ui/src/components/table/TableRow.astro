---
import type { HTMLAttributes } from "astro/types"
import { cv } from "css-variants"

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>
type Props = HTMLAttributes<"tr"> & VariantProps<typeof tableRow>

export const tableRow = cv({
  base: "border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted"
})

const { class: className, ...rest } = Astro.props
---

<tr role="row" class:list={[tableRow(), className]} {...rest} data-slot="table-row">
  <slot />
</tr>
