---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { ChatPromptSubmitProps } from "./chat-prompt-submit"
import { chatPromptSubmitTheme } from "./chat-prompt-submit.theme"


const chatPromptSubmit = scv(chatPromptSubmitTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatPromptSubmitProps

const classes = resolveClasses(chatPromptSubmit, {}, useUi("chatPromptSubmit", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>