---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { FormFieldProps } from "./form-field"
import formFieldTheme from "./form-field.theme"


const formField = scv(formFieldTheme)

const {
  id = `field-${Math.random().toString(36).substring(2, 9)}`,
  label,
  description,
  error,
  required = false,
  size = "md",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as FormFieldProps & { id?: string }

const classes = resolveClasses(formField, {
  size
}, useUi("formField", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  {label && (
    <label for={id} class={classes.label} data-slot="label">
      {label}
      {required && <span class="text-error-500 ml-0.5" aria-hidden="true">*</span>}
    </label>
  )}
  <slot />
  {description && (
    <p id={`${id}-description`} class={classes.description} data-slot="description">
      {description}
    </p>
  )}
  {error && (
    <p id={`${id}-error`} class={classes.error} data-slot="error" aria-live="assertive">
      {error}
    </p>
  )}
</div>
