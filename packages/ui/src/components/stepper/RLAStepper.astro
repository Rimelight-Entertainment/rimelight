---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { StepperProps } from "./stepper"
import { stepperTheme } from "./stepper.theme"
import RLAIcon from "../icon/RLAIcon.astro"

const stepper = scv(stepperTheme as any)

const {
  items = [],
  value,
  defaultValue,
  modelValue,
  valueKey = "value",
  linear = true,
  disabled = false,
  orientation = "horizontal",
  size = "sm",
  color = "primary",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as StepperProps

const classes = resolveClasses(stepper, {
  orientation,
  size,
  color
}, useUi("stepper", uiProp), className);

const initialActiveValue = value ?? modelValue ?? defaultValue ?? (items.length > 0 ? (items[0]?.[valueKey] ?? items[0]?.value ?? 0) : 0)

const uid = Math.random().toString(36).substring(2, 9)

const activeIndex = items.findIndex((item, idx) => {
  const val = item[valueKey] ?? item.value ?? idx
  return String(val) === String(initialActiveValue)
})
const currentIndex = activeIndex >= 0 ? activeIndex : 0
---
<rla-stepper
  data-stepper-uid={uid}
  data-linear={linear ? "true" : "false"}
  data-disabled={disabled ? "true" : "false"}
  data-current-index={currentIndex}
  {...rest}
>
  <div
    class:list={[classes.root]}
    data-slot="root"
  >
    <div class={classes.header} data-slot="header">
      {items.map((item, index) => {
        const itemValue = item[valueKey] ?? item.value ?? index
        const isCompleted = index < currentIndex
        const isActive = index === currentIndex
        const isDisabled = disabled || item.disabled || (linear && index > currentIndex)
        const state = isCompleted ? "completed" : isActive ? "active" : "inactive"

        return (
          <>
            <div
              class:list={[classes.item, item.class]}
              data-slot="item"
              data-index={index}
              data-value={itemValue}
              data-state={state}
              data-disabled={isDisabled ? "true" : undefined}
            >
              <div class={classes.container} data-slot="container">
                <button
                  type="button"
                  class:list={[
                    classes.trigger,
                    (isActive || isCompleted) && "!bg-primary-600 !border-primary-600 !text-white"
                  ]}
                  data-slot="trigger"
                  disabled={isDisabled}
                  data-step-trigger={index}
                >
                  <span class={classes.indicator} data-slot="indicator">
                    <slot name="indicator" {...({ item, index, state } as any)}>
                      {item.icon ? (
                        <RLAIcon
                          name={item.icon}
                          size="sm"
                          class:list={[
                            classes.icon,
                            (isActive || isCompleted) ? "!text-white" : "text-neutral-400 dark:text-neutral-500"
                          ]}
                          data-slot="icon"
                        />
                      ) : (
                        <span>{index + 1}</span>
                      )}
                    </slot>
                  </span>
                </button>
              </div>

              {(item.title || item.description || Astro.slots.has("title") || Astro.slots.has("description") || Astro.slots.has("wrapper")) && (
                <div class={classes.wrapper} data-slot="wrapper">
                  <slot name="wrapper" {...({ item, index } as any)}>
                    {item.title && (
                      <div class={classes.title} data-slot="title">
                        <slot name="title" {...({ item, index } as any)}>{item.title}</slot>
                      </div>
                    )}
                    {item.description && (
                      <div class={classes.description} data-slot="description">
                        <slot name="description" {...({ item, index } as any)}>{item.description}</slot>
                      </div>
                    )}
                  </slot>
                </div>
              )}
            </div>

            {index < items.length - 1 && (
              <div
                class:list={[
                  classes.separator,
                  "flex-1 h-0.5 mx-2 self-start mt-4 transition-colors",
                  index < currentIndex ? "bg-primary-600 dark:bg-primary-500" : "bg-neutral-200 dark:bg-neutral-800"
                ]}
                data-slot="separator"
                data-separator-index={index}
              />
            )}
          </>
        )
      })}
    </div>

    <div class={classes.content} data-slot="content">
      <slot>
        <slot name="content" {...({ item: items[currentIndex], index: currentIndex } as any)} />
        {items.map((item, index) => {
          const itemValue = item[valueKey] ?? item.value ?? index
          const isActive = index === currentIndex
          const slotName = item.slot

          return (
            <div
              data-stepper-panel={index}
              data-value={itemValue}
              hidden={isActive ? undefined : "until-found"}
              class="w-full"
            >
              {slotName && Astro.slots.has(slotName) ? (
                <slot name={slotName} {...({ item, index } as any)} />
              ) : item.content ? (
                <div>{item.content}</div>
              ) : null}
            </div>
          )
        })}
      </slot>
    </div>
  </div>
</rla-stepper>

<script>
  if (typeof HTMLElement !== 'undefined') {
    class RLAStepper extends HTMLElement {
      private currentIndex: number = 0
      private itemsCount: number = 0
      private isLinear: boolean = true
      private isDisabled: boolean = false

      connectedCallback() {
        this.currentIndex = Number(this.dataset.currentIndex || 0)
        this.isLinear = this.dataset.linear === "true"
        this.isDisabled = this.dataset.disabled === "true"

        const items = this.querySelectorAll('[data-slot="item"]')
        this.itemsCount = items.length

        const triggers = this.querySelectorAll('[data-step-trigger]')
        triggers.forEach(trig => {
          trig.addEventListener('click', () => {
            const index = Number((trig as HTMLElement).dataset.stepTrigger)
            if (!isNaN(index)) {
              this.goTo(index)
            }
          })
        })

        this.updateState()
      }

      public get hasNext(): boolean {
        return this.currentIndex < this.itemsCount - 1
      }

      public get hasPrev(): boolean {
        return this.currentIndex > 0
      }

      public next() {
        if (this.hasNext) {
          this.goTo(this.currentIndex + 1)
        }
      }

      public prev() {
        if (this.hasPrev) {
          this.goTo(this.currentIndex - 1)
        }
      }

      public goTo(index: number) {
        if (this.isDisabled) return
        if (index < 0 || index >= this.itemsCount) return
        if (this.isLinear && index > this.currentIndex + 1) return

        const oldIndex = this.currentIndex
        this.currentIndex = index
        this.dataset.currentIndex = String(index)
        this.updateState()

        const itemEl = this.querySelector(`[data-slot="item"][data-index="${index}"]`) as HTMLElement | null
        const itemVal = itemEl?.dataset.value ?? index

        if (index > oldIndex) {
          this.dispatchEvent(new CustomEvent('next', { detail: { index, value: itemVal } }))
        } else if (index < oldIndex) {
          this.dispatchEvent(new CustomEvent('prev', { detail: { index, value: itemVal } }))
        }
        this.dispatchEvent(new CustomEvent('change', { detail: { index, value: itemVal } }))
      }

      private updateState() {
        const items = this.querySelectorAll('[data-slot="item"]')
        items.forEach((itemNode) => {
          const item = itemNode as HTMLElement
          const idx = Number(item.dataset.index)
          const isCompleted = idx < this.currentIndex
          const isActive = idx === this.currentIndex
          const isDisabled = this.isDisabled || (this.isLinear && idx > this.currentIndex)

          const state = isCompleted ? "completed" : isActive ? "active" : "inactive"
          item.setAttribute('data-state', state)

          if (isDisabled) {
            item.setAttribute('data-disabled', 'true')
          } else {
            item.removeAttribute('data-disabled')
          }

          const trigger = item.querySelector('button[data-step-trigger]') as HTMLButtonElement | null
          if (trigger) {
            trigger.disabled = isDisabled
            if (isActive || isCompleted) {
              trigger.classList.add('!bg-primary-600', '!border-primary-600', '!text-white')
            } else {
              trigger.classList.remove('!bg-primary-600', '!border-primary-600', '!text-white')
            }
          }

          const icon = item.querySelector('[data-slot="icon"]') as HTMLElement | null
          if (icon) {
            if (isActive || isCompleted) {
              icon.classList.add('!text-white')
              icon.classList.remove('text-neutral-400', 'dark:text-neutral-500')
            } else {
              icon.classList.remove('!text-white')
              icon.classList.add('text-neutral-400', 'dark:text-neutral-500')
            }
          }

          const separators = this.querySelectorAll('[data-slot="separator"]')
          separators.forEach((sepNode) => {
            const sep = sepNode as HTMLElement
            const sepIdx = Number(sep.dataset.separatorIndex)
            if (sepIdx < this.currentIndex) {
              sep.classList.add('!bg-primary-600', 'dark:!bg-primary-500')
              sep.classList.remove('bg-neutral-200', 'dark:bg-neutral-800')
            } else {
              sep.classList.remove('!bg-primary-600', 'dark:!bg-primary-500')
              sep.classList.add('bg-neutral-200', 'dark:bg-neutral-800')
            }
          })
        })

        const panels = this.querySelectorAll('[data-stepper-panel]')
        panels.forEach((panelNode) => {
          const panel = panelNode as HTMLElement
          const idx = Number(panel.dataset.stepperPanel)
          if (idx === this.currentIndex) {
            panel.removeAttribute('hidden')
          } else {
            panel.setAttribute('hidden', 'until-found')
          }
        })
      }
    }

    if (!customElements.get('rla-stepper')) {
      customElements.define('rla-stepper', RLAStepper)
    }
  }
</script>

<style>
  @supports not (content-visibility: hidden) {
    [hidden="until-found"] {
      display: none !important;
    }
  }
</style>