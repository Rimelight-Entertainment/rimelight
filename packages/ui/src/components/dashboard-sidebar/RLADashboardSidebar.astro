---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { DashboardSidebarProps } from "./dashboard-sidebar"
import dashboardSidebarThemeDefault, { createDashboardSidebarTheme } from "./dashboard-sidebar.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const dashboardSidebarTheme = uiConfig.colors ? createDashboardSidebarTheme() : dashboardSidebarThemeDefault

const dashboardSidebar = scv(dashboardSidebarTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardSidebarProps

const classes = resolveClasses(dashboardSidebar, {}, useUi("dashboardSidebar", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>