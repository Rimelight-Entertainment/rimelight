---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { DashboardSidebarProps } from "./dashboard-sidebar"
import dashboardSidebarTheme from "./dashboard-sidebar.theme"


const dashboardSidebar = scv(dashboardSidebarTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardSidebarProps

const classes = resolveClasses(dashboardSidebar, {}, useUi("dashboardSidebar", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>