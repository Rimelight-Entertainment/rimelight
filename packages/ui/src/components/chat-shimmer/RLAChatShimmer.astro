---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { ChatShimmerProps } from "./chat-shimmer"
import chatShimmerThemeDefault, { createChatShimmerTheme } from "./chat-shimmer.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const chatShimmerTheme = uiConfig.colors ? createChatShimmerTheme() : chatShimmerThemeDefault

const chatShimmer = scv(chatShimmerTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatShimmerProps

const classes = resolveClasses(chatShimmer, {}, useUi("chatShimmer", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>