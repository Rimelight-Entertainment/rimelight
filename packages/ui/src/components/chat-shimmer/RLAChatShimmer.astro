---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { ChatShimmerProps } from "./chat-shimmer"
import { chatShimmerTheme } from "./chat-shimmer.theme"


const chatShimmer = scv(chatShimmerTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatShimmerProps

const classes = resolveClasses(chatShimmer, {}, useUi("chatShimmer", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>