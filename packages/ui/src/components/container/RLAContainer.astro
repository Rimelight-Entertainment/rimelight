---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { ContainerProps } from "./container"
import { containerTheme } from "./container.theme"


const container = scv(containerTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ContainerProps

const classes = resolveClasses(container, {}, useUi("container", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>