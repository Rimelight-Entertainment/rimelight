---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { DashboardSearchButtonProps } from "./dashboard-search-button"
import dashboardSearchButtonThemeDefault, { createDashboardSearchButtonTheme } from "./dashboard-search-button.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const dashboardSearchButtonTheme = uiConfig.colors ? createDashboardSearchButtonTheme() : dashboardSearchButtonThemeDefault

const dashboardSearchButton = scv(dashboardSearchButtonTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardSearchButtonProps

const classes = resolveClasses(dashboardSearchButton, {}, useUi("dashboardSearchButton", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>