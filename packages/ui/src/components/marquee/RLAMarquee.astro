---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { MarqueeProps } from "./marquee"
import { resolveTheme } from "../../utils/resolveTheme"
import marqueeThemeDefault, { createMarqueeTheme } from "./marquee.theme"
const marqueeTheme = resolveTheme(marqueeThemeDefault, createMarqueeTheme)


const marquee = scv(marqueeTheme)

const {
  direction = "left",
  speed = 40,
  pauseOnHover = true,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as MarqueeProps

const classes = resolveClasses(marquee, {
  direction,
  pauseOnHover
}, useUi("marquee", uiProp), className)

const duration = `${speed}s`
const id = `marquee-${Math.random().toString(36).substring(2, 9)}`
---
<div class={classes.root} data-slot="marquee-root" {...rest}>
  <div class:list={[classes.track, id]} data-slot="track">
    <slot />
  </div>
  <div class:list={[classes.track, id]} data-slot="track" aria-hidden="true">
    <slot />
  </div>
</div>

<style is:inline set:html={`
  .${id} {
    animation-duration: ${duration} !important;
  }
`} />
