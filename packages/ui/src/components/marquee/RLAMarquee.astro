---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { MarqueeProps } from "./marquee"
import { resolveTheme } from "../../utils/resolver"
import marqueeThemeDefault, { createMarqueeTheme } from "./marquee.theme"

const marqueeTheme = resolveTheme(marqueeThemeDefault, createMarqueeTheme)
const marquee = scv(marqueeTheme)

const {
  direction = "left",
  speed = 40,
  pauseOnHover = true,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as MarqueeProps

const classes = resolveClasses(marquee, {
  direction,
  pauseOnHover
}, useUi("marquee", uiProp), className)

const duration = `${speed}s`
const id = `marquee-${Math.random().toString(36).substring(2, 9)}`
---
<div class={classes.root} data-slot="marquee-root" {...rest}>
  <div class:list={[classes.track, id]} data-slot="track">
    <slot />
  </div>
  <div class:list={[classes.track, id]} data-slot="track" aria-hidden="true">
    <slot />
  </div>
</div>

<style is:inline set:html={`
  .${id} {
    animation-duration: ${duration} !important;
  }
`} />

<style>
  .animate-marquee,
  .animate-marquee-left {
    animation: marquee-left 30s linear infinite;
  }
  .animate-marquee-right {
    animation: marquee-right 30s linear infinite;
  }
  .animate-marquee-up {
    animation: marquee-up 30s linear infinite;
  }
  .animate-marquee-down {
    animation: marquee-down 30s linear infinite;
  }

  @keyframes marquee-left {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }
  @keyframes marquee-right {
    from { transform: translateX(-100%); }
    to { transform: translateX(0); }
  }
  @keyframes marquee-up {
    from { transform: translateY(0); }
    to { transform: translateY(-100%); }
  }
  @keyframes marquee-down {
    from { transform: translateY(-100%); }
    to { transform: translateY(0); }
  }
</style>
