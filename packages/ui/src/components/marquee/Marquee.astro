---
import { scv } from "css-variants";

const marqueeVariants = scv({
  slots: ["root", "content"],
  base: {
    root: "relative flex overflow-hidden w-full py-8",
    content: "flex shrink-0 items-center justify-around gap-8 min-w-full",
  },
  variants: {
    variant: {
      static: {
        root: "justify-center",
        content: "animate-none",
      },
      scroll: {
        root: "",
        content: "animate-marquee",
      },
    },
    size: {
      xs: {
        content: "gap-xs",
      },
      sm: {
        content: "gap-sm",
      },
      md: {
        content: "gap-md",
      },
      lg: {
        content: "gap-lg",
      },
      xl: {
        content: "gap-xl",
      },
    },
  },
  defaultVariants: {
    variant: "static",
    size: "md",
  },
});

export interface MarqueeProps extends NonNullable<Parameters<typeof marqueeVariants>[0]> {
  class?: string;
  repeat?: number;
  title?: string;
}
type Props = MarqueeProps;

const { variant, size, class: className, repeat = 2, title } = Astro.props;
const { root, content } = marqueeVariants({ variant, size });
---

<div class:list={[root, className]}>
  <div class="container flex flex-col items-center gap-8">
    {title && (
      <h4 class="text-lg font-medium text-muted-foreground/80">
        {title}
      </h4>
    )}
    <div class="flex w-full items-center justify-around gap-inherit">
      {Array.from({ length: variant === "scroll" ? repeat : 1 }).map(() => (
        <div class={content}>
          <slot />
        </div>
      ))}
    </div>
  </div>
</div>


