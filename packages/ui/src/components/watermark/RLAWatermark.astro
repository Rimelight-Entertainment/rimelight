---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { WatermarkProps } from "./watermark"
import { watermarkTheme } from "./watermark.theme"


const watermark = scv(watermarkTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as WatermarkProps

const classes = resolveClasses(watermark, {}, useUi("watermark", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>