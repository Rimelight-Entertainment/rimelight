---
import type { WatermarkProps } from "./watermark"
import { watermarkTheme } from "./watermark.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as WatermarkProps

const classes = watermarkTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>