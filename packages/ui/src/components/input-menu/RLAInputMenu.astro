---
import type { InputMenuProps } from "./input-menu"
import { inputMenuTheme } from "./input-menu.theme"
import RLAIcon from "../icon/RLAIcon.astro"



const {
  items = [],
  value = "",
  placeholder = "Select item...",
  disabled = false,
  name,
  label,
  size = "md",
  color = "primary",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as InputMenuProps

const classes = inputMenuTheme({
  size,
  ui: uiProp,
  class: className
});

const normalizedItems = items.map(item => {
  if (typeof item === "string") {
    return { label: item, value: item }
  }
  return item
})

const selectedItem = normalizedItems.find(item => item.value === value)
const initialLabel = selectedItem ? selectedItem.label : ""
---
<rla-input-menu {...rest}>
  <div class={classes.root} data-slot="root" data-disabled={disabled ? "" : undefined}>
    {label && <label class={classes.label} data-slot="label">{label}</label>}
    
    <div class="relative w-full" data-inputMenu-wrapper>
      <button
        type="button"
        class={classes.trigger}
        data-slot="trigger"
        disabled={disabled}
        data-inputMenu-trigger
      >
        <span data-inputMenu-value>{initialLabel || placeholder}</span>
        <RLAIcon name="chevronsUpDown" class="opacity-50" />
      </button>

      <div class={classes.content + " hidden"} data-inputMenu-dropdown data-slot="content">
        <input
          type="text"
          class={classes.input}
          placeholder="Search..."
          data-inputMenu-search
        />
        <div class="py-1" data-inputMenu-items>
          {normalizedItems.map(item => (
            <div
              class={classes.item}
              data-slot="item"
              data-value={item.value}
              data-label={item.label}
              data-inputMenu-item
            >
              <span class={classes.itemText}>{item.label}</span>
              <RLAIcon name="check" class={classes.itemIcon + " hidden"} data-check-icon />
            </div>
          ))}
        </div>
      </div>
    </div>
    <input type="hidden" name={name} value={value} data-inputMenu-hidden-input />
  </div>
</rla-input-menu>

<script>
  class RLAInputMenu extends HTMLElement {
    private inputMenuCleanup: (() => void) | null = null;

    connectedCallback() {
      this.style.display = 'contents';
      const wrapper = this.querySelector("[data-inputMenu-wrapper]") as HTMLElement | null;
      if (!wrapper) return;

      const trigger = wrapper.querySelector("[data-inputMenu-trigger]") as HTMLButtonElement;
      const dropdown = wrapper.querySelector("[data-inputMenu-dropdown]") as HTMLDivElement;
      const search = wrapper.querySelector("[data-inputMenu-search]") as HTMLInputElement;
      const items = wrapper.querySelectorAll<HTMLElement>("[data-inputMenu-item]");
      const valueSpan = wrapper.querySelector("[data-inputMenu-value]");
      const hiddenInput = this.querySelector("[data-inputMenu-hidden-input]") as HTMLInputElement;

      if (!trigger || !dropdown) return;

      const onTriggerClick = (e: MouseEvent) => {
        e.stopPropagation();
        dropdown.classList.toggle("hidden");
        if (!dropdown.classList.contains("hidden")) {
          search?.focus();
        }
      };
      trigger.addEventListener("click", onTriggerClick);

      const onSearchInput = (e: Event) => {
        const q = (e.target as HTMLInputElement).value.toLowerCase();
        items.forEach(item => {
          const label = (item as HTMLElement).dataset.label?.toLowerCase() || "";
          if (label.includes(q)) {
            (item as HTMLElement).classList.remove("hidden");
          } else {
            (item as HTMLElement).classList.add("hidden");
          }
        });
      };
      search?.addEventListener("input", onSearchInput);

      const itemCleanups: (() => void)[] = [];
      items.forEach(item => {
        const onItemClick = (e: MouseEvent) => {
          e.stopPropagation();
          const val = (item as HTMLElement).dataset.value || "";
          const label = (item as HTMLElement).dataset.label || "";
          
          if (hiddenInput) hiddenInput.value = val;
          if (valueSpan) valueSpan.textContent = label;
          
          items.forEach(i => i.querySelector("[data-check-icon]")?.classList.add("hidden"));
          item.querySelector("[data-check-icon]")?.classList.remove("hidden");
          
          dropdown.classList.add("hidden");
        };
        item.addEventListener("click", onItemClick);
        itemCleanups.push(() => item.removeEventListener("click", onItemClick));
      });

      const onDocumentClick = () => {
        dropdown.classList.add("hidden");
      };
      document.addEventListener("click", onDocumentClick);

      this.inputMenuCleanup = () => {
        trigger.removeEventListener("click", onTriggerClick);
        search?.removeEventListener("input", onSearchInput);
        itemCleanups.forEach(fn => fn());
        document.removeEventListener("click", onDocumentClick);
      };
    }

    disconnectedCallback() {
      if (this.inputMenuCleanup) {
        this.inputMenuCleanup();
        this.inputMenuCleanup = null;
      }
    }
  }

  if (!customElements.get('rla-input-menu')) {
    customElements.define('rla-input-menu', RLAInputMenu);
  }
</script>
