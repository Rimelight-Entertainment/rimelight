---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { InputTagsProps } from "./input-tags"
import inputTagsTheme from "./input-tags.theme"


const inputTags = scv(inputTagsTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as InputTagsProps

const classes = resolveClasses(inputTags, {}, useUi("inputTags", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>