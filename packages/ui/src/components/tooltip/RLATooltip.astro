---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { TooltipProps } from "./tooltip"
import tooltipTheme from "./tooltip.theme"


const tooltip = scv(tooltipTheme)

const {
  content,
  placement = "top",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as TooltipProps

const classes = resolveClasses(tooltip, {
  placement
}, useUi("tooltip", uiProp), className)

const anchorName = `--rla-tt-${Math.random().toString(36).substring(2, 9)}`
---
<div class={classes.root} data-slot="tooltip-container" data-placement={placement} {...rest}>
  <div
    class={classes.trigger}
    data-slot="trigger"
    tabindex="0"
    style={`anchor-name: ${anchorName}`}
  >
    <slot />
  </div>

  <div
    class={classes.content}
    data-slot="content"
    role="tooltip"
    style={`position-anchor: ${anchorName}`}
  >
    <slot name="content">
      {content}
    </slot>
  </div>
</div>

<style>
  /*
   * CSS Anchor Positioning — progressive enhancement (Chrome 125+).
   *
   * Browsers that don't support anchor-name will ignore this block and
   * fall back to the existing absolute + translate-based placement
   * defined in tooltip.theme.ts. No JavaScript needed in either path.
   */
  @supports (anchor-name: --x) {
    [data-slot="tooltip-container"] [data-slot="content"] {
      /*
       * Switch from the theme's translate-based absolute positioning
       * to anchor-relative positioning so the browser handles overflow
       * and viewport clipping automatically.
       */
      position: absolute;
      position-anchor: inherit; /* resolved from inline style */

      /* Reset theme's translate hacks — anchor() handles the math */
      transform: none !important;
      left: unset;
      right: unset;
      top: unset;
      bottom: unset;
      margin: 0;
    }

    /* top (default) */
    [data-placement="top"] [data-slot="content"] {
      bottom: anchor(top);
      left: anchor(center);
      translate: -50% 0;
      margin-bottom: 0.375rem;
      position-try-fallbacks: --tt-bottom, --tt-right, --tt-left;
    }

    /* bottom */
    [data-placement="bottom"] [data-slot="content"] {
      top: anchor(bottom);
      left: anchor(center);
      translate: -50% 0;
      margin-top: 0.375rem;
      position-try-fallbacks: --tt-top, --tt-right, --tt-left;
    }

    /* left */
    [data-placement="left"] [data-slot="content"] {
      right: anchor(left);
      top: anchor(center);
      translate: 0 -50%;
      margin-right: 0.375rem;
      position-try-fallbacks: --tt-right, --tt-top, --tt-bottom;
    }

    /* right */
    [data-placement="right"] [data-slot="content"] {
      left: anchor(right);
      top: anchor(center);
      translate: 0 -50%;
      margin-left: 0.375rem;
      position-try-fallbacks: --tt-left, --tt-top, --tt-bottom;
    }

    /* Fallback positions the browser tries when the preferred side clips */
    @position-try --tt-top {
      bottom: anchor(top);
      top: auto;
      left: anchor(center);
      translate: -50% 0;
      margin-bottom: 0.375rem;
      margin-top: 0;
    }
    @position-try --tt-bottom {
      top: anchor(bottom);
      bottom: auto;
      left: anchor(center);
      translate: -50% 0;
      margin-top: 0.375rem;
      margin-bottom: 0;
    }
    @position-try --tt-left {
      right: anchor(left);
      left: auto;
      top: anchor(center);
      translate: 0 -50%;
      margin-right: 0.375rem;
      margin-left: 0;
    }
    @position-try --tt-right {
      left: anchor(right);
      right: auto;
      top: anchor(center);
      translate: 0 -50%;
      margin-left: 0.375rem;
      margin-right: 0;
    }
  }
</style>
