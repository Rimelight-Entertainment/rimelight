---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { ScrollAreaProps } from "./scroll-area"
import scrollAreaTheme from "./scroll-area.theme"


const scrollArea = scv(scrollAreaTheme)

const {
  orientation = "vertical",
  scrollHideDelay = 600,
  height,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ScrollAreaProps

const classes = resolveClasses(scrollArea, {
  orientation
}, useUi("scrollArea", uiProp), className)

const heightStyle = height
  ? `height:${typeof height === "number" ? `${height}px` : height}`
  : undefined
---

<div
  class={classes.root}
  data-slot="root"
  data-scroll-area
  data-orientation={orientation}
  data-hide-delay={scrollHideDelay}
  style={heightStyle}
  {...rest}
>
  {/* Scrollable viewport */}
  <div
    class={classes.viewport}
    data-slot="viewport"
    data-scroll-viewport
  >
    <slot />
  </div>

  {/* Vertical scrollbar */}
  {(orientation === "vertical" || orientation === "both") && (
    <div
      class={classes.scrollbar + " opacity-0 transition-opacity"}
      data-slot="scrollbar"
      data-scroll-bar="vertical"
      aria-hidden="true"
    >
      <div class={classes.thumb} data-scroll-thumb="vertical" />
    </div>
  )}

  {/* Horizontal scrollbar */}
  {(orientation === "horizontal" || orientation === "both") && (
    <div
      class={"absolute bottom-0 left-0 right-0 h-2.5 flex-row flex p-0.5 bg-transparent transition-colors duration-150 ease-out hover:bg-muted/10 opacity-0 transition-opacity"}
      data-slot="scrollbar"
      data-scroll-bar="horizontal"
      aria-hidden="true"
    >
      <div class={classes.thumb} data-scroll-thumb="horizontal" />
    </div>
  )}
</div>

<script>
  document.querySelectorAll("[data-scroll-area]").forEach(area => {
    const viewport = area.querySelector("[data-scroll-viewport]") as HTMLElement | null;
    if (!viewport) return;

    const hideDelay = parseInt((area as HTMLElement).dataset.hideDelay ?? "600", 10);

    const vBar = area.querySelector("[data-scroll-bar='vertical']") as HTMLElement | null;
    const hBar = area.querySelector("[data-scroll-bar='horizontal']") as HTMLElement | null;
    const vThumb = area.querySelector("[data-scroll-thumb='vertical']") as HTMLElement | null;
    const hThumb = area.querySelector("[data-scroll-thumb='horizontal']") as HTMLElement | null;

    let hideTimer: ReturnType<typeof setTimeout>;

    const showBars = () => {
      vBar?.classList.replace("opacity-0", "opacity-100");
      hBar?.classList.replace("opacity-0", "opacity-100");
    };

    const hideBars = () => {
      hideTimer = setTimeout(() => {
        vBar?.classList.replace("opacity-100", "opacity-0");
        hBar?.classList.replace("opacity-100", "opacity-0");
      }, hideDelay);
    };

    const updateThumbs = () => {
      if (vThumb) {
        const ratio = viewport.clientHeight / viewport.scrollHeight;
        const thumbH = Math.max(ratio * (vBar?.clientHeight ?? 0), 20);
        const thumbTop = (viewport.scrollTop / viewport.scrollHeight) * (vBar?.clientHeight ?? 0);
        vThumb.style.height = `${thumbH}px`;
        vThumb.style.transform = `translateY(${thumbTop}px)`;
      }
      if (hThumb) {
        const ratio = viewport.clientWidth / viewport.scrollWidth;
        const thumbW = Math.max(ratio * (hBar?.clientWidth ?? 0), 20);
        const thumbLeft = (viewport.scrollLeft / viewport.scrollWidth) * (hBar?.clientWidth ?? 0);
        hThumb.style.width = `${thumbW}px`;
        hThumb.style.transform = `translateX(${thumbLeft}px)`;
      }
    };

    viewport.addEventListener("scroll", () => {
      clearTimeout(hideTimer);
      showBars();
      updateThumbs();
      hideBars();
    });

    // Drag-to-scroll for custom thumbs
    const makeDraggable = (
      thumb: HTMLElement | null,
      scrollProp: "scrollTop" | "scrollLeft",
      clientProp: "clientY" | "clientX",
      sizeProp: "scrollHeight" | "scrollWidth",
      clientSizeProp: "clientHeight" | "clientWidth"
    ) => {
      if (!thumb) return;
      let startPos = 0;
      let startScroll = 0;

      thumb.addEventListener("mousedown", (e) => {
        e.preventDefault();
        startPos = (e as MouseEvent)[clientProp];
        startScroll = viewport[scrollProp];

        const onMove = (ev: MouseEvent) => {
          const delta = ev[clientProp] - startPos;
          const ratio = viewport[sizeProp] / viewport[clientSizeProp];
          viewport[scrollProp] = startScroll + delta * ratio;
        };
        const onUp = () => {
          document.removeEventListener("mousemove", onMove);
          document.removeEventListener("mouseup", onUp);
        };
        document.addEventListener("mousemove", onMove);
        document.addEventListener("mouseup", onUp);
      });
    };

    makeDraggable(vThumb, "scrollTop", "clientY", "scrollHeight", "clientHeight");
    makeDraggable(hThumb, "scrollLeft", "clientX", "scrollWidth", "clientWidth");

    updateThumbs();
  });
</script>
