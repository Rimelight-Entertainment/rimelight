---
import type { InputProps } from "./input"
import { inputTheme } from "./input.theme"



const {
  type = "text",
  value = "",
  placeholder,
  disabled = false,
  readonly = false,
  name,
  required = false,
  error = false,
  leadingIcon,
  trailingIcon,
  ...rest
} = Astro.props as InputProps

const hasLeading = !!leadingIcon || Astro.slots.has("leading")
const hasTrailing = !!trailingIcon || Astro.slots.has("trailing")

const classes = inputTheme({
  ...Astro.props,
  error: !!error
});
---
<div class={classes.root} data-slot="root">
  {(leadingIcon || Astro.slots.has("leading")) && (
    <span class={classes.leading} data-slot="leading">
      {leadingIcon ? <span class={leadingIcon} /> : <slot name="leading" />}
    </span>
  )}
  <input
    type={type}
    class={classes.input}
    value={value}
    placeholder={placeholder}
    disabled={disabled}
    readonly={readonly}
    name={name}
    required={required}
    {...rest}
  />
  {(trailingIcon || Astro.slots.has("trailing")) && (
    <span class={classes.trailing} data-slot="trailing">
      {trailingIcon ? <span class={trailingIcon} /> : <slot name="trailing" />}
    </span>
  )}
</div>
