---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { LinkProps } from "./link"
import linkThemeDefault, { createLinkTheme } from "./link.theme"
import { getUIConfig } from "virtual:rimelight-ui"
import RLAIcon from "../icon/RLAIcon.astro"

const uiConfig = getUIConfig()
const linkTheme = uiConfig.colors ? createLinkTheme() : linkThemeDefault

const link = scv(linkTheme)

const {
  to,
  href,
  external,
  ariaLabel,
  externalIcon,
  target,
  rel,
  trailingIcon,
  noExternalIcon,
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as LinkProps & { noExternalIcon?: boolean; theme?: string }

const linkHref = href || (typeof to === 'string' ? to : undefined);

const isExternal = !!(external || (linkHref && (linkHref.startsWith('http://') || linkHref.startsWith('https://') || linkHref.startsWith('//'))));

const linkTarget = target || (isExternal ? "_blank" : undefined);
const linkRel = rel || (isExternal ? "noopener noreferrer" : undefined);

const showExternalIcon = isExternal && !noExternalIcon && !trailingIcon ? (externalIcon || "externalLink") : trailingIcon;

const classes = resolveClasses(link, { theme }, useUi("link", uiProp), className);
---
<a
  href={linkHref}
  target={linkTarget}
  rel={linkRel}
  aria-label={ariaLabel}
  class={classes.root}
  {...rest}
>
  <slot />
  {showExternalIcon && (
    <RLAIcon name={showExternalIcon} size="sm" class="!-translate-y-[1.5px]" aria-hidden="true" />
  )}
  {isExternal && !ariaLabel && (
    <span class="sr-only"> (opens in a new tab)</span>
  )}
</a>