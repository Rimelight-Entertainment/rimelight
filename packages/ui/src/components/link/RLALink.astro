---
import type { LinkProps } from "./link"
import { linkTheme } from "./link.theme"
import RLAIcon from "../icon/RLAIcon.astro"
import { resolveLinkAttrs } from "./helpers"


const {
  label,
  leadingIcon,
  trailingIcon,
  href,
  external,
  externalIcon,
  noExternalIcon,
  target,
  rel,
  prefetch,
  active,
  disabled,
  raw,
  ariaLabel,
  ariaCurrentValue,
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as LinkProps

const attrs = resolveLinkAttrs(Astro.props)

const classes = raw
  ? { root: className || "", leadingIcon: "", label: "", trailingIcon: "" }
  : (linkTheme({
  theme,
        ...(active !== undefined ? { active } : {}),
        disabled: !!disabled,
  ui: uiProp,
  class: className
}) as Record<string, string>)
---

<a
  class={classes.root}
  data-slot="root"
  href={attrs.href}
  target={attrs.target}
  rel={attrs.rel}
  aria-label={ariaLabel}
  aria-current={attrs.ariaCurrent}
  aria-disabled={attrs.ariaDisabled}
  data-astro-prefetch={attrs.prefetchAttr}
  {...rest}
>
  <slot name="leading">
    {leadingIcon && (
      <span class={classes.leadingIcon} data-slot="leading-icon">
        <RLAIcon name={leadingIcon} size="sm" aria-hidden="true" />
      </span>
    )}
  </slot>

  {label !== undefined && label !== null ? (
    <span class={classes.label} data-slot="label">{label}</span>
  ) : (
    <slot />
  )}

  <slot name="trailing">
    {attrs.showTrailingIcon && (
      <span class={classes.trailingIcon} data-slot="trailing-icon">
        <RLAIcon
          name={attrs.showTrailingIcon}
          size="sm"
          aria-hidden="true"
        />
      </span>
    )}
  </slot>

  {attrs.isExternal && !ariaLabel && (
    <span class="sr-only" data-slot="external-hint">
      (opens in a new tab)
    </span>
  )}
</a>
