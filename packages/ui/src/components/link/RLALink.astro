---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { LinkProps } from "./link"
import linkTheme from "./link.theme"
import RLAIcon from "../icon/RLAIcon.astro"
import { resolveLinkAttrs } from "./helpers"

const link = scv(linkTheme)

const {
  label,
  leadingIcon,
  trailingIcon,
  href,
  external,
  externalIcon,
  noExternalIcon,
  target,
  rel,
  prefetch,
  active,
  disabled,
  raw,
  ariaLabel,
  ariaCurrentValue = "page",
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as LinkProps

const attrs = resolveLinkAttrs(Astro.props)

const classes = raw
  ? ({ root: className || "" } as Record<string, string>)
  : resolveClasses(
      link,
      {
        theme,
        ...(active !== undefined ? { active } : {}),
        disabled: !!disabled
      },
      useUi("link", uiProp),
      className
    )

const defaultSlotHtml = Astro.slots.has("default")
  ? await Astro.slots.render("default", [{ active: !!active }])
  : "";
---

<a
  class={classes.root}
  data-slot="root"
  href={disabled ? undefined : href}
  target={attrs.target}
  rel={attrs.rel}
  aria-label={ariaLabel}
  aria-current={attrs.ariaCurrent}
  aria-disabled={disabled ? "true" : undefined}
  data-astro-prefetch={prefetch ? (typeof prefetch === "string" ? prefetch : "viewport") : undefined}
  {...rest}
>
  <slot name="leading">
    {leadingIcon && (
      <span class={classes.leadingIcon} data-slot="leading-icon">
        <RLAIcon name={leadingIcon} size="sm" aria-hidden="true" />
      </span>
    )}
  </slot>

  {label !== undefined && label !== null ? (
    <span class={classes.label} data-slot="label">{label}</span>
  ) : (
    <Fragment set:html={defaultSlotHtml} />
  )}

  <slot name="trailing">
    {attrs.showTrailingIcon && (
      <span class={classes.trailingIcon} data-slot="trailing-icon">
        <RLAIcon
          name={attrs.showTrailingIcon}
          size="sm"
          aria-hidden="true"
        />
      </span>
    )}
  </slot>

  {attrs.isExternal && !ariaLabel && (
    <span class="sr-only" data-slot="external-hint">
      (opens in a new tab)
    </span>
  )}
</a>
