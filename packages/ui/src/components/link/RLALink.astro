---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { LinkProps } from "./link"
import linkTheme from "./link.theme"
import RLAIcon from "../icon/RLAIcon.astro"

const link = scv(linkTheme)

const {
  label,
  leadingIcon,
  trailingIcon,
  href,
  external,
  externalIcon,
  noExternalIcon,
  target,
  rel,
  prefetch,
  active,
  disabled,
  raw,
  ariaLabel,
  ariaCurrentValue = "page",
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as LinkProps

const isExternal = !!(external || (href && /^(?:https?:)?\/\//.test(href)))

const showTrailingIcon = isExternal && !noExternalIcon && !trailingIcon
  ? (externalIcon || "externalLink")
  : trailingIcon

const classes = raw
  ? ({ root: className || "" } as Record<string, string>)
  : resolveClasses(
      link,
      {
        theme,
        ...(active !== undefined ? { active } : {}),
        disabled: !!disabled
      },
      useUi("link", uiProp),
      className
    )
---

<a
  class={classes.root}
  data-slot="root"
  href={disabled ? undefined : href}
  target={target || (isExternal ? "_blank" : undefined)}
  rel={rel === null || rel === "" ? undefined : (rel ?? (isExternal || (target && target !== "_self") ? "noopener noreferrer" : undefined))}
  aria-label={ariaLabel}
  aria-current={active ? ariaCurrentValue : undefined}
  aria-disabled={disabled ? "true" : undefined}
  data-astro-prefetch={prefetch ? (typeof prefetch === "string" ? prefetch : "viewport") : undefined}
  {...rest}
>
  <slot name="leading">
    {leadingIcon && (
      <span class={classes.leadingIcon} data-slot="leading-icon">
        <RLAIcon name={leadingIcon} size="sm" class="!-translate-y-[1.5px]" aria-hidden="true" />
      </span>
    )}
  </slot>

  {label !== undefined && label !== null ? (
    <span class={classes.label} data-slot="label">{label}</span>
  ) : (
    <slot />
  )}

  <slot name="trailing">
    {showTrailingIcon && (
      <span class={classes.trailingIcon} data-slot="trailing-icon">
        <RLAIcon
          name={showTrailingIcon}
          size="sm"
          class="!-translate-y-[1.5px]"
          aria-hidden="true"
        />
      </span>
    )}
  </slot>

  {isExternal && !ariaLabel && (
    <span class="sr-only" data-slot="external-hint">
      (opens in a new tab)
    </span>
  )}
</a>
