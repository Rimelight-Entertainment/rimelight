---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { InputNumberProps } from "./input-number"
import { inputNumberTheme } from "./input-number.theme"


const inputNumber = scv(inputNumberTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as InputNumberProps

const classes = resolveClasses(inputNumber, {}, useUi("inputNumber", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>