---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { PricingTableProps } from "./pricing-table"
import pricingTableTheme from "./pricing-table.theme"


const pricingTable = scv(pricingTableTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PricingTableProps

const classes = resolveClasses(pricingTable, {}, useUi("pricingTable", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>