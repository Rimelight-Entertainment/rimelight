---
import type { MainProps } from "./main"
import { mainTheme } from "./main.theme"



const {
    as = "main",
    ui: uiProp,
    class: className,
    ...rest
} = Astro.props as MainProps;

const classes = mainTheme({
  hasContent: Astro.slots.has("default"),
  ui: uiProp,
  class: className
});

const Tag = as;
---

<Tag
        class:list={[classes.root, "rla-main-container"]}
        data-slot="main"
        {...rest}
    >
    <slot />
</Tag>

<style>
  .rla-main-container {
    padding-top: var(--rl-total-header-height, 4rem);
  }
</style>