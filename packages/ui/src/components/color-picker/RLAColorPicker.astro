---
import type { ColorPickerProps } from "./color-picker"
import { colorPickerTheme } from "./color-picker.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ColorPickerProps

const classes = colorPickerTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>