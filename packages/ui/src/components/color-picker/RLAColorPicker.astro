---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { ColorPickerProps } from "./color-picker"
import colorPickerThemeDefault, { createColorPickerTheme } from "./color-picker.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const colorPickerTheme = uiConfig.colors ? createColorPickerTheme() : colorPickerThemeDefault

const colorPicker = scv(colorPickerTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ColorPickerProps

const classes = resolveClasses(colorPicker, {}, useUi("colorPicker", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>