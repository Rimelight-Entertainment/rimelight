---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

export const alertTitle = cv({
  base: "font-heading mb-3xs flex items-center gap-3xs text-lg leading-none font-medium tracking-tight",
});

export interface AlertTitleProps extends HTMLAttributes<"h5"> {}
type Props = AlertTitleProps;

const { class: className, ...rest } = Astro.props;
---

<h5 class:list={[alertTitle(), className]} {...rest} data-slot="alert-title">
  <slot />
</h5>
