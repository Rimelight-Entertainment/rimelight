---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { GridProps } from "./grid"
import gridThemeDefault, { createGridTheme } from "./grid.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const gridTheme = uiConfig.colors ? createGridTheme() : gridThemeDefault

const grid = scv(gridTheme)

const {
  cols = 2,
  gap = "md",
  stagger = false,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as GridProps

const classes = resolveClasses(grid, {
  cols: cols as any,
  gap,
  stagger
}, useUi("grid", uiProp), className)
---

<div class={classes.root} {...rest}>
  <slot />
</div>
