---
import type { GridProps } from "./grid"
import { gridTheme } from "./grid.theme"



const {
  cols = 2,
  gap = "md",
  stagger = false,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as GridProps

const classes = gridTheme({
  cols: cols as any,
  gap,
  stagger,
  ui: uiProp,
  class: className
})
---

<div class={classes.root} {...rest}>
  <slot />
</div>
