---
import type { MeterProps } from "./meter"
import { meterTheme } from "./meter.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as MeterProps

const classes = meterTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>