---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { ListboxProps } from "./listbox"
import listboxThemeDefault, { createListboxTheme } from "./listbox.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const listboxTheme = uiConfig.colors ? createListboxTheme() : listboxThemeDefault

const listbox = scv(listboxTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ListboxProps

const classes = resolveClasses(listbox, {}, useUi("listbox", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>