---
import type { ListboxProps } from "./listbox"
import { listboxTheme } from "./listbox.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ListboxProps

const classes = listboxTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>