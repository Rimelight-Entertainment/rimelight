---
import type { PopoverProps } from "./popover"
import { popoverTheme } from "./popover.theme"


const {
  triggerLabel,
  placement = "bottom",
  mode = "both",
  ...rest
} = Astro.props as PopoverProps

const classes = popoverTheme(Astro.props)

const popoverId = `rla-popover-${Math.random().toString(36).substring(2, 9)}`
---
<div
  class={`rla-popover-host ${classes.root}`}
  data-slot="popover-container"
  data-placement={placement}
  data-mode={mode}
  {...rest}
>
  <div class={classes.trigger} data-slot="trigger">
    <slot name="trigger">
      {triggerLabel && (
        <button
          type="button"
          class="cursor-pointer"
          popovertarget={popoverId}
          popovertargetaction="toggle"
        >
          {triggerLabel}
        </button>
      )}
    </slot>
  </div>

  <div
    id={popoverId}
    class={classes.content}
    data-slot="content"
    popover="auto"
  >
    <slot />
  </div>
</div>

<style>
  /*
   * Popover API — native positioning fallback.
   * For browsers that support anchor positioning we layer it on top;
   * all others get the default centred viewport placement that the
   * Popover API provides out of the box.
   */
  .rla-popover-host {
    position: relative;
    display: inline-block;
  }

  /* Reset browser's default popover styles so our theme classes apply */
  [popover] {
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
    color: inherit;
  }

  /* Hide until open — the popover API toggles [popover] visibility,
     but we need to re-apply our own show/hide for the :popover-open state */
  [popover]:not(:popover-open) {
    display: none;
  }

  /*
   * CSS Anchor Positioning (progressive enhancement — Chrome 125+).
   * Browsers without anchor-name support ignore this entire block and
   * fall back to the Popover API's default viewport-centred placement.
   */
  @supports (anchor-name: --x) {
    .rla-popover-host [data-slot="trigger"] {
      anchor-name: --rla-popover-anchor;
    }

    [popover][data-slot="content"] {
      position: absolute;
      position-anchor: --rla-popover-anchor;
      /* The theme adds `top-full left-1/2 -translate-x-1/2` for non-popover
         dropdowns; that transform shifts a top-layer popover off its anchor,
         so neutralize it when we position via CSS anchor properties. */
      transform: none;
    }

    /* bottom (default) */
    [data-placement="bottom"] [popover][data-slot="content"],
    :not([data-placement]) [popover][data-slot="content"] {
      top: anchor(bottom);
      left: anchor(left);
      margin-top: 0.5rem;
      position-try-fallbacks: --flip-top;
    }

    /* bottom-end */
    [data-placement="bottom-end"] [popover][data-slot="content"] {
      top: anchor(bottom);
      right: anchor(right);
      left: auto;
      margin-top: 0.5rem;
      position-try-fallbacks: --flip-top-end;
    }

    /* bottom-start */
    [data-placement="bottom-start"] [popover][data-slot="content"] {
      top: anchor(bottom);
      left: anchor(left);
      margin-top: 0.5rem;
      position-try-fallbacks: --flip-top-start;
    }

    /* top */
    [data-placement="top"] [popover][data-slot="content"] {
      bottom: anchor(top);
      left: anchor(left);
      margin-bottom: 0.5rem;
      position-try-fallbacks: --flip-bottom;
    }

    /* left */
    [data-placement="left"] [popover][data-slot="content"] {
      right: anchor(left);
      top: anchor(top);
      margin-right: 0.5rem;
      position-try-fallbacks: --flip-right;
    }

    /* right */
    [data-placement="right"] [popover][data-slot="content"] {
      left: anchor(right);
      top: anchor(top);
      margin-left: 0.5rem;
      position-try-fallbacks: --flip-left;
    }

    /* Fallback try sets — browser picks the first one that fits in the viewport */
    @position-try --flip-top {
      bottom: anchor(top);
      top: auto;
      margin-bottom: 0.5rem;
      margin-top: 0;
    }
    @position-try --flip-bottom {
      top: anchor(bottom);
      bottom: auto;
      margin-top: 0.5rem;
      margin-bottom: 0;
    }
    @position-try --flip-top-end {
      bottom: anchor(top);
      right: anchor(right);
      left: auto;
      top: auto;
      margin-bottom: 0.5rem;
      margin-top: 0;
    }
    @position-try --flip-top-start {
      bottom: anchor(top);
      left: anchor(left);
      top: auto;
      margin-bottom: 0.5rem;
      margin-top: 0;
    }
    @position-try --flip-right {
      left: anchor(right);
      right: auto;
      margin-left: 0.5rem;
      margin-right: 0;
    }
    @position-try --flip-left {
      right: anchor(left);
      left: auto;
      margin-right: 0.5rem;
      margin-left: 0;
    }
  }
</style>

<script>
  /**
   * Minimal JS shim — only needed for:
   *  1. hover mode (no declarative HTML equivalent for hover-open yet)
   *  2. wiring slot-based custom triggers (not a <button popovertarget>)
   *     so they still open the popover on click
   *
   * Light-dismiss, Escape, top-layer stacking, and keyboard accessibility
   * are all handled natively by the Popover API.
   */
  function setupPopovers() {
    document.querySelectorAll<HTMLElement>('[data-slot="popover-container"]').forEach(container => {
      const mode = container.dataset["mode"] || 'both';
      const popoverId = container.querySelector<HTMLElement>('[data-slot="content"]')?.id;
      if (!popoverId) return;

      const panel = document.getElementById(popoverId) as HTMLElement & { hidePopover?: () => void; showPopover?: () => void } | null;
      if (!panel || typeof panel.showPopover !== 'function') return;

      // For slot-based triggers (not a <button popovertarget>), wire click manually
      const trigger = container.querySelector<HTMLElement>('[data-slot="trigger"]');
      if (trigger && !trigger.querySelector('[popovertarget]')) {
        trigger.addEventListener('click', () => {
          // @ts-ignore
          panel.togglePopover?.();
        });
      }

      // Hover support
      if (mode === 'hover' || mode === 'both') {
        let hoverTimer: ReturnType<typeof setTimeout> | null = null;

        const show = () => {
          if (hoverTimer) clearTimeout(hoverTimer);
          if (!container.matches(':has(:popover-open)')) {
            panel.showPopover?.();
          }
        };

        const hide = () => {
          hoverTimer = setTimeout(() => {
            panel.hidePopover?.();
          }, 150);
        };

        container.addEventListener('mouseenter', show);
        container.addEventListener('mouseleave', hide);
        panel.addEventListener('mouseenter', () => {
          if (hoverTimer) clearTimeout(hoverTimer);
        });
        panel.addEventListener('mouseleave', hide);
      }

      // Deterministic positioning: anchor positioning is a progressive
      // enhancement, but we always place the popover next to its trigger
      // via JS so it is reliably visible (no off-screen / scrollbar issues).
      const positionPopover = () => {
        if (!trigger) return;
        const pw = panel.offsetWidth;
        const ph = panel.offsetHeight;
        if (pw === 0 || ph === 0) return; // closed or not yet rendered

        const parts = (container.dataset["placement"] || 'bottom').split('-');
        const vert = parts[0];            // top | bottom
        const horiz = parts[1] || 'center'; // start | end | center
        const gap = 8;
        const r = trigger.getBoundingClientRect();

        let top = vert === 'top' ? r.top - ph - gap : r.bottom + gap;
        let left =
          horiz === 'end' ? r.right - pw :
          horiz === 'start' ? r.left :
          r.left + r.width / 2 - pw / 2;

        left = Math.max(8, Math.min(left, window.innerWidth - pw - 8));
        top = Math.max(8, Math.min(top, window.innerHeight - ph - 8));

        panel.style.position = 'fixed';
        panel.style.transform = 'none';
        panel.style.top = `${top}px`;
        panel.style.left = `${left}px`;
      };

      panel.addEventListener('toggle', () => positionPopover());
      const reposition = () => positionPopover();
      window.addEventListener('scroll', reposition, true);
      window.addEventListener('resize', reposition);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPopovers);
  } else {
    setupPopovers();
  }
  document.addEventListener('astro:page-load', setupPopovers);
</script>
