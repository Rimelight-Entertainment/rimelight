---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

export interface SidebarInsetProps extends HTMLAttributes<"main"> {}
type Props = SidebarInsetProps;

export const sidebarInset = cv({
  base: [
    "bg-background relative flex w-full flex-1 flex-col",
    "md:peer-data-[variant=inset]:m-2xl md:peer-data-[variant=inset]:ml-0",
    "md:peer-data-[variant=inset]:rounded-xl md:peer-data-[variant=inset]:shadow-sm",
    "md:peer-data-[variant=inset]:peer-data-[state=collapsed]:ml-2xl",
  ],
});

const { class: className, ...rest } = Astro.props;
---

<main class:list={[sidebarInset(), className]} {...rest} data-slot="sidebar-inset">
  <slot />
</main>
