---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

export interface SidebarGroupProps extends HTMLAttributes<"div"> {}
type Props = SidebarGroupProps;

export const sidebarGroup = cv({
  base: "relative flex w-full min-w-0 flex-col p-5xs",
});

const { class: className, ...rest } = Astro.props;
---

<div
  class:list={[sidebarGroup(), className]}
  data-sidebar="group"
  {...rest}
  data-slot="sidebar-group"
>
  <slot />
</div>
