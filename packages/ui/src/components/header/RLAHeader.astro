---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils/resolver"
import HeaderLayer from "./HeaderLayer.astro"
import type { HeaderProps } from "./header"
import { headerTheme } from "./header.theme"

const header = scv(headerTheme)

const {
  as = "header",
  contain = true,
  sticky = true,
  fixed = false,
  stackIndex = 0,
  hideOnScroll = false,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as HeaderProps

const classes = resolveClasses(
  header,
  {
    contain,
    sticky: fixed ? false : sticky,
    fixed
  },
  useUi("header", uiProp),
  className
)
---

<HeaderLayer
  as={as}
  layerType="header"
  componentName="header"
  theme={header}
  contain={contain}
  sticky={sticky}
  fixed={fixed}
  stackIndex={stackIndex}
  hideOnScroll={hideOnScroll}
  ui={uiProp}
  class={className}
  {...rest}
>
  <div class:list={[classes.left]} data-slot="left">
    <slot name="left" />
  </div>
  <div class:list={[classes.center]} data-slot="center">
    <slot name="center">
      <slot />
    </slot>
  </div>
  <div class:list={[classes.right]} data-slot="right">
    <slot name="right" />
  </div>
</HeaderLayer>
