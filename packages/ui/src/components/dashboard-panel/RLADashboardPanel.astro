---
import type { DashboardPanelProps } from "./dashboard-panel"
import { dashboardPanelTheme } from "./dashboard-panel.theme"


const {
  resizable = false,
  class: className,
  ...rest
} = Astro.props as DashboardPanelProps

const classes = dashboardPanelTheme({
  ...Astro.props,
  size: false
});
---
<div class={classes.root} data-slot="root" style="flex: 1 1 0%; min-width: 0;" {...rest}>
  <slot name="header" />

  <div data-slot="body" class={classes.body}>
    <slot name="body">
      <slot />
    </slot>
  </div>

  <slot name="footer" />
</div>

{resizable && (
  <slot name="resize-handle">
    <div
      data-slot="handle"
      class={classes.handle + " hidden lg:block touch-none select-none cursor-ew-resize relative before:absolute before:inset-y-0 before:-left-1.5 before:-right-1.5 before:z-1"}
    />
  </slot>
)}
