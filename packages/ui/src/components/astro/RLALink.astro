---
import RLAButton from "./RLAButton.astro"
import type { LinkProps } from "../../types"

const {
  to,
  href,
  variant = "link",
  color = "neutral",
  ...rest
} = Astro.props as LinkProps

const linkHref = href || (typeof to === 'string' ? to : undefined);
---
<RLAButton
  variant={variant as any}
  color={color as any}
  href={linkHref}
  {...rest}
>
  <slot />
</RLAButton>