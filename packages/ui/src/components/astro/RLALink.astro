---
import type { LinkProps } from "../../types"
import RLAIcon from "./RLAIcon.astro"

const {
  to,
  href,
  external,
  ariaLabel,
  externalIcon,
  target,
  rel,
  trailingIcon,
  noExternalIcon,
  class: className,
  ...rest
} = Astro.props as LinkProps & { noExternalIcon?: boolean }

const linkHref = href || (typeof to === 'string' ? to : undefined);

const isExternal = !!(external || (linkHref && (linkHref.startsWith('http://') || linkHref.startsWith('https://') || linkHref.startsWith('//'))));

const linkTarget = target || (isExternal ? "_blank" : undefined);
const linkRel = rel || (isExternal ? "noopener noreferrer" : undefined);

const showExternalIcon = isExternal && !noExternalIcon && !trailingIcon ? (externalIcon || "externalLink") : trailingIcon;
---
<a
  href={linkHref}
  target={linkTarget}
  rel={linkRel}
  aria-label={ariaLabel}
  class={className}
  {...rest}
>
  <slot />
  {showExternalIcon && (
    <RLAIcon name={showExternalIcon} aria-hidden="true" />
  )}
  {isExternal && !ariaLabel && (
    <span class="sr-only"> (opens in a new tab)</span>
  )}
</a>