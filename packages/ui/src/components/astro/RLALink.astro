---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { LinkProps } from "../../types"
import linkThemeDefault, { createLinkTheme } from "../../themes/link.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const linkTheme = uiConfig.colors ? createLinkTheme() : linkThemeDefault

const link = scv(linkTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as LinkProps

const classes = resolveClasses(link, {}, useUi("link", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>