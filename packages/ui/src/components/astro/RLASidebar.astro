---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { SidebarProps, SidebarItem } from "../../types"
import sidebarThemeDefault, { createSidebarTheme } from "../../themes/sidebar.theme"

const sidebarTheme = sidebarThemeDefault
const sidebar = scv(sidebarTheme)

const {
  items = [],
  side = "left",
  collapsible = "none",
  logo,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SidebarProps

const classes = resolveClasses(sidebar, {
  side,
  collapsible
}, useUi("sidebar", uiProp), className)

// Recursive helper to render sidebar items with children
const hasActiveChild = (item: SidebarItem): boolean => {
  if (item.active) return true
  return (item.children ?? []).some(c => hasActiveChild(c))
}
---

<aside class={classes.root} data-slot="root" data-sidebar {...rest}>
  {/* Header */}
  <div class={classes.header} data-slot="header">
    <slot name="header">
      {logo && (
        <span data-slot="sidebar-logo" class="flex items-center gap-2">
          <span class="i-lucide-layers size-5 text-primary" />
          <span class="truncate">{logo}</span>
        </span>
      )}
    </slot>
  </div>

  {/* Body */}
  <div class={classes.content} data-slot="content">
    <slot>
      {items.map((item) => {
        const hasChildren = item.children && item.children.length > 0
        const isActive = item.active || hasActiveChild(item)
        return (
          <div class={classes.item} data-slot="item">
            {hasChildren ? (
              <details open={isActive} class="group/details">
                <summary
                  class={classes.itemLink + (isActive ? " text-foreground bg-muted" : "") + " list-none cursor-pointer"}
                  data-slot="item-summary"
                >
                  {item.icon && (
                    <span
                      class={classes.itemIcon + " " + item.icon}
                      aria-hidden="true"
                    />
                  )}
                  <span data-slot="item-text" class="truncate flex-1">{item.label}</span>
                  {item.badge !== undefined && (
                    <span class={classes.itemBadge} data-slot="item-badge">{item.badge}</span>
                  )}
                  <span class="i-lucide-chevron-right size-3.5 ml-auto transition-transform group-open/details:rotate-90" />
                </summary>
                <div class="mt-0.5 ml-6 flex flex-col gap-0.5">
                  {item.children!.map(child => (
                    <a
                      href={child.href ?? "#"}
                      class={classes.itemLink + (child.active ? " text-foreground bg-muted" : "") + " text-xs pl-2"}
                    >
                      {child.icon && <span class={classes.itemIcon + " " + child.icon} aria-hidden="true" />}
                      <span data-slot="item-text" class="truncate flex-1">{child.label}</span>
                      {child.badge !== undefined && (
                        <span class={classes.itemBadge} data-slot="item-badge">{child.badge}</span>
                      )}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={item.href ?? "#"}
                class={classes.itemLink + (isActive ? " text-foreground bg-muted" : "")}
                aria-current={isActive ? "page" : undefined}
              >
                {item.icon && (
                  <span
                    class={classes.itemIcon + " " + item.icon}
                    aria-hidden="true"
                  />
                )}
                <span data-slot="item-text" class="truncate flex-1">{item.label}</span>
                {item.badge !== undefined && (
                  <span class={classes.itemBadge} data-slot="item-badge">{item.badge}</span>
                )}
              </a>
            )}
          </div>
        )
      })}
    </slot>
  </div>

  {/* Footer */}
  <div class={classes.footer} data-slot="footer">
    <slot name="footer" />
  </div>
</aside>

{collapsible === "offcanvas" && (
  <button
    type="button"
    data-sidebar-toggle
    class="fixed top-4 left-4 z-50 flex size-9 items-center justify-center rounded-md bg-background border border-border shadow-sm hover:bg-muted transition-colors"
    aria-label="Toggle sidebar"
  >
    <span class="i-lucide-panel-left size-4" />
  </button>
)}

<script>
  document.querySelectorAll("[data-sidebar-toggle]").forEach(toggle => {
    toggle.addEventListener("click", () => {
      const sidebar = document.querySelector("[data-sidebar]");
      if (!sidebar) return;
      sidebar.classList.toggle("-translate-x-full");
    });
  });
</script>
