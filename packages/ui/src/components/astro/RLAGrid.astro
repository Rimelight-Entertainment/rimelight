---
interface Props {
  stagger?: boolean
  class?: string
}

const { stagger = false, class: className = "", ...rest } = Astro.props
---

<div class:list={["rl-grid", { stagger }, className]} {...rest}>
  <slot />
</div>

<style>
  .rl-grid {
    display: grid;
    grid-template-columns: 100%;
    gap: 1rem;
  }

  .rl-grid > :global(*) {
    margin-top: 0 !important;
  }

  @media (min-width: 50rem) {
    .rl-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .stagger {
      --stagger-height: 5rem;
      padding-bottom: var(--stagger-height);
    }

    .stagger > :global(*):nth-child(2n) {
      transform: translateY(var(--stagger-height));
    }
  }
</style>
