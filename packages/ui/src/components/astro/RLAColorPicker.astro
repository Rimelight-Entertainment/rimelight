---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { ColorPickerProps } from "../../types"
import colorPickerThemeDefault from "../../themes/color-picker.theme"

const colorPicker = scv(colorPickerThemeDefault)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ColorPickerProps

const classes = resolveClasses(colorPicker, {}, useUi("colorPicker", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>