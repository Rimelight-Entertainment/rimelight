---
import { scv, cx } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { AvatarProps } from "../../types"
import avatarThemeDefault, { createAvatarTheme } from "../../themes/avatar.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const avatarTheme = uiConfig.colors ? createAvatarTheme(uiConfig.colors) : avatarThemeDefault

const avatar = scv(avatarTheme)

const {
  src,
  alt = "",
  fallback,
  size = "md",
  badge = false,
  badgeColor = "success",
  badgePosition = "bottom-right",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as AvatarProps

const classes = resolveClasses(avatar, {
  size,
  color: Astro.props.color || "neutral",
  badgePosition,
  hasBadge: !!badge
}, useUi("avatar", uiProp), className)
---
<span
  class={classes.root}
  data-slot="root"
  {...rest}
>
  <slot>
    {src ? (
      <img
        src={src}
        alt={alt}
        class={classes.image}
        data-slot="image"
      />
    ) : (
      <span class={classes.fallback} data-slot="fallback">
        <slot name="fallback">
          {fallback}
        </slot>
        {!fallback && !Astro.slots.has("fallback") && (
          <span class={cx(classes.icon, "i-lucide-user")} aria-hidden="true" />
        )}
      </span>
    )}
  </slot>

  <slot name="badge">
    {badge && (
      <span
        class={cx(classes.badge, badgeColor && (badgeColor.startsWith('bg-') ? badgeColor : `bg-${badgeColor}-500`))}
        data-slot="badge"
      >
        {typeof badge === 'string' || typeof badge === 'number' ? badge : null}
      </span>
    )}
  </slot>
</span>
