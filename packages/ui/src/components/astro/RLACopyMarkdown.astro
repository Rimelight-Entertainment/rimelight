---
import RLAButton from "./RLAButton.astro"
import type { ButtonProps } from "../../types"

interface Props extends Omit<ButtonProps, "href" | "label" | "leadingIcon" | "trailingIcon" | "loading" | "loadingAuto" | "square" | "active" | "activeColor" | "activeVariant"> {
  raw: string
}

const {
  raw,
  ...rest
} = Astro.props
---

<rla-copy-markdown {...rest}>
  <RLAButton
    class="rl-copy-markdown"
    color="neutral"
    variant="outline"
    size="sm"
    leadingIcon="copy"
    label="Copy Markdown"
    data-raw={raw}
  />
</rla-copy-markdown>

<script>
  class RLACopyMarkdown extends HTMLElement {
    private copyCleanup: (() => void) | null = null;

    connectedCallback() {
      this.style.display = 'contents';
      const copyBtn = this.querySelector(".rl-copy-markdown") as HTMLButtonElement | null;
      if (!copyBtn) return;

      const onClick = async () => {
        try {
          copyBtn.disabled = true;
          const markdown = copyBtn.getAttribute("data-raw");
          if (!markdown) {
            throw new Error("No raw markdown content provided to copy");
          }
          await navigator.clipboard.writeText(markdown);
          
          const labelEl = copyBtn.querySelector('[data-slot="label"]');
          if (labelEl) {
            const origText = labelEl.textContent;
            labelEl.textContent = "Copied!";
            setTimeout(() => {
              labelEl.textContent = origText;
            }, 2000);
          }
        } catch (err) {
          console.error("Failed to copy:", err);
        } finally {
          copyBtn.disabled = false;
        }
      };

      copyBtn.addEventListener("click", onClick);

      this.copyCleanup = () => {
        copyBtn.removeEventListener("click", onClick);
      };
    }

    disconnectedCallback() {
      if (this.copyCleanup) {
        this.copyCleanup();
        this.copyCleanup = null;
      }
    }
  }

  if (!customElements.get('rla-copy-markdown')) {
    customElements.define('rla-copy-markdown', RLACopyMarkdown);
  }
</script>
