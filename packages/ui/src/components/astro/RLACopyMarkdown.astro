---
import RLAButton from "./RLAButton.astro"
import type { ButtonProps } from "../../types"

interface Props extends Omit<ButtonProps, "href" | "label" | "leadingIcon" | "trailingIcon" | "loading" | "loadingAuto" | "square" | "active" | "activeColor" | "activeVariant"> {
  targetSelector?: string
}

const {
  targetSelector = ".markdown-content",
  ...rest
} = Astro.props
---

<RLAButton
  id="rl-copy-markdown"
  color="neutral"
  variant="outline"
  size="sm"
  leadingIcon="i-lucide-copy"
  label="Copy Markdown"
  data-target={targetSelector}
  {...rest}
/>

<script>
  import TurndownService from "turndown";
  import { gfm } from "turndown-plugin-gfm";

  const turndown = new TurndownService({
    headingStyle: "atx",
    codeBlockStyle: "fenced",
    bulletListMarker: "-",
  });
  turndown.use(gfm);

  function setupCopy() {
    const copyBtn = document.getElementById("rl-copy-markdown") as HTMLButtonElement | null;
    if (!copyBtn) return;

    if ((copyBtn as any)._rlCopyRegistered) return;
    (copyBtn as any)._rlCopyRegistered = true;

    copyBtn.addEventListener("click", async () => {
      try {
        copyBtn.disabled = true;
        const selector = copyBtn.getAttribute("data-target") || ".markdown-content";
        const contentEl = document.querySelector(selector);
        if (!contentEl) {
          throw new Error(`Content selector "${selector}" not found`);
        }
        const clone = contentEl.cloneNode(true) as Element;
        clone.querySelectorAll("script, style, noscript, .sl-anchor-link, [data-pagefind-ignore]").forEach((el: Element) => el.remove());
        const markdown = turndown.turndown(clone as HTMLElement);
        await navigator.clipboard.writeText(markdown);
        
        const labelEl = copyBtn.querySelector('[data-slot="label"]');
        if (labelEl) {
          const origText = labelEl.textContent;
          labelEl.textContent = "Copied!";
          setTimeout(() => {
            labelEl.textContent = origText;
          }, 2000);
        }
      } catch (err) {
        console.error("Failed to copy:", err);
      } finally {
        copyBtn.disabled = false;
      }
    });
  }

  setupCopy();
  document.addEventListener("astro:after-swap", setupCopy);
</script>
