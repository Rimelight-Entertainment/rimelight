---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { IconProps } from "../../types"
import iconThemeDefault, { createIconTheme } from "../../themes/icon.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const iconTheme = uiConfig.colors ? createIconTheme() : iconThemeDefault

const icon = scv(iconTheme)

const {
  name,
  size = "md",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as IconProps

const classes = resolveClasses(icon, { size }, useUi("icon", uiProp), className)
---

<span
  class={classes.root}
  data-slot="root"
  aria-hidden="true"
  {...rest}
>
  <span class={name} />
</span>
