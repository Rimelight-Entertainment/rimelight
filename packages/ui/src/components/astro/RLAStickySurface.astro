---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { StickySurfaceProps } from "../../types"
import stickySurfaceThemeDefault, { createStickySurfaceTheme } from "../../themes/sticky-surface.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const stickySurfaceTheme = uiConfig.colors ? createStickySurfaceTheme() : stickySurfaceThemeDefault

const stickySurface = scv(stickySurfaceTheme)

const {
  offsetTop = 0,
  zIndex = 10,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as StickySurfaceProps

const classes = resolveClasses(stickySurface, {}, useUi("stickySurface", uiProp), className)
const topOffset = `${offsetTop}px`
---
<div
  class:list={[classes.root, "rla-sticky-surface"]}
  data-slot="root"
  {...rest}
>
  <slot />
</div>

<style define:vars={{ topOffset, zIndex }}>
  .rla-sticky-surface {
    top: var(--topOffset);
    z-index: var(--zIndex);
  }
</style>
