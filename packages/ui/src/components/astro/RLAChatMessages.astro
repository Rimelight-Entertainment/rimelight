---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { ChatMessagesProps } from "../../types"
import chatMessagesThemeDefault from "../../themes/chat-messages.theme"

const chatMessages = scv(chatMessagesThemeDefault)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatMessagesProps

const classes = resolveClasses(chatMessages, {}, useUi("chatMessages", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>