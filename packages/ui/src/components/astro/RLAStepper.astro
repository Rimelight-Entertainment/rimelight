---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { StepperProps } from "../../types"
import stepperThemeDefault from "../../themes/stepper.theme"

const stepper = scv(stepperThemeDefault)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as StepperProps

const classes = resolveClasses(stepper, {}, useUi("stepper", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>