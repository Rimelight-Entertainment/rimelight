---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { DashboardSidebarToggleProps } from "../../types"
import dashboardSidebarToggleThemeDefault, { createDashboardSidebarToggleTheme } from "../../themes/dashboard-sidebar-toggle.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const dashboardSidebarToggleTheme = uiConfig.colors ? createDashboardSidebarToggleTheme() : dashboardSidebarToggleThemeDefault

const dashboardSidebarToggle = scv(dashboardSidebarToggleTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardSidebarToggleProps

const classes = resolveClasses(dashboardSidebarToggle, {}, useUi("dashboardSidebarToggle", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>