---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { GalleryProps } from "../../types"
import galleryThemeDefault, { createGalleryTheme } from "../../themes/gallery.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const galleryTheme = uiConfig.colors ? createGalleryTheme() : galleryThemeDefault

const gallery = scv(galleryTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as GalleryProps

const classes = resolveClasses(gallery, {}, useUi("gallery", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>