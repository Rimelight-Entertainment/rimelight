---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { BrowserMockupProps } from "../../types"
import browserMockupThemeDefault, { createBrowserMockupTheme } from "../../themes/browser-mockup.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const browserMockupTheme = uiConfig.colors ? createBrowserMockupTheme() : browserMockupThemeDefault

const browserMockup = scv(browserMockupTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as BrowserMockupProps

const classes = resolveClasses(browserMockup, {}, useUi("browserMockup", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>