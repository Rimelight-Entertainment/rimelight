---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { FormFieldProps } from "../../types"
import formFieldThemeDefault, { createFormFieldTheme } from "../../themes/form-field.theme"

const formFieldTheme = formFieldThemeDefault
const formField = scv(formFieldTheme)

const {
  label,
  description,
  error,
  required = false,
  size = "md",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as FormFieldProps

const classes = resolveClasses(formField, {
  size
}, useUi("formField", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  {label && (
    <label class={classes.label} data-slot="label">
      {label}
      {required && <span class="text-error-500 ml-0.5">*</span>}
    </label>
  )}
  <slot />
  {description && (
    <p class={classes.description} data-slot="description">
      {description}
    </p>
  )}
  {error && (
    <p class={classes.error} data-slot="error">
      {error}
    </p>
  )}
</div>
