---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { PhoneMockupProps } from "../../types"
import phoneMockupThemeDefault, { createPhoneMockupTheme } from "../../themes/phone-mockup.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const phoneMockupTheme = uiConfig.colors ? createPhoneMockupTheme() : phoneMockupThemeDefault

const phoneMockup = scv(phoneMockupTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PhoneMockupProps

const classes = resolveClasses(phoneMockup, {}, useUi("phoneMockup", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>