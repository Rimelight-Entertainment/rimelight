---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { InputNumberProps } from "../../types"
import inputNumberThemeDefault, { createInputNumberTheme } from "../../themes/input-number.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const inputNumberTheme = uiConfig.colors ? createInputNumberTheme() : inputNumberThemeDefault

const inputNumber = scv(inputNumberTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as InputNumberProps

const classes = resolveClasses(inputNumber, {}, useUi("inputNumber", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>