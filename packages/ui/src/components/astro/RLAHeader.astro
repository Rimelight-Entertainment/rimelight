---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { HeaderProps } from "../../types"
import headerThemeDefault, { createHeaderTheme } from "../../themes/header.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const headerTheme = uiConfig.colors ? createHeaderTheme() : headerThemeDefault

const header = scv(headerTheme)

const {
  contain = true,
  sticky = true,
  fixed = false,
  stackIndex = 0,
  hideOnScroll = false,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as HeaderProps;

const classes = resolveClasses(header, {
  contain,
  sticky: fixed ? false : sticky,
  fixed,
}, useUi("header", uiProp), className);

const headerId = `rla-header-${Math.random().toString(36).slice(2, 8)}`;
const zIndex = 100 - stackIndex;
---

<header
  id={headerId}
  data-slot="root"
  class:list={[classes.root]}
  data-rla-header={fixed ? "true" : undefined}
  data-stack-index={stackIndex}
  data-hide-on-scroll={String(hideOnScroll)}
  style={fixed ? `z-index: ${zIndex};` : undefined}
  {...rest}
>
  <div class:list={[classes.content]} data-header-content>
    <div class:list={[classes.container]}>
      <div class:list={[classes.left]} data-slot="left">
        <slot name="left" />
      </div>
      <div class:list={[classes.center]} data-slot="center">
        <slot name="center" />
      </div>
      <div class:list={[classes.right]} data-slot="right">
        <slot name="right" />
      </div>
    </div>
  </div>
</header>

{fixed && (
  <script>
    import { getHeaderStack } from "../../utils/headerStack";

    const stack = getHeaderStack();
    const headers = document.querySelectorAll("[data-rla-header='true']");

    headers.forEach(header => {
      if ((header as any).rlInitialized) return;
      (header as any).rlInitialized = true;

      const id = header.id;
      const stackIndex = parseInt(header.getAttribute("data-stack-index") || "0", 10);
      const hideOnScroll = header.getAttribute("data-hide-on-scroll") === "true";
      const contentEl = header.querySelector("[data-header-content]") as HTMLElement;

      let naturalHeight = contentEl ? contentEl.offsetHeight : 0;
      let isVisible = true;

      const updateStack = () => {
        stack.register(id, stackIndex, naturalHeight, isVisible, header as HTMLElement);
      };

      if (typeof ResizeObserver !== "undefined" && contentEl) {
        new ResizeObserver(entries => {
          const h = entries[0]?.contentRect.height;
          if (h && h > 0) {
            naturalHeight = h;
            updateStack();
          }
        }).observe(contentEl);
      }

      if (hideOnScroll) {
        let localLastScrollY = window.scrollY;
        window.addEventListener("scroll", () => {
          const current = window.scrollY;
          const diff = current - localLastScrollY;
          if (Math.abs(diff) >= 10) {
            const newVisible = current <= 50 ? true : diff <= 0;
            if (newVisible !== isVisible) {
              isVisible = newVisible;
              updateStack();
            }
            localLastScrollY = current;
          }
        }, { passive: true });
      }

      updateStack();
    });
  </script>
)}
