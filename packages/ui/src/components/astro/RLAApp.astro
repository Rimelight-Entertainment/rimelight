---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { AppProps } from "../../types"
import appThemeDefault, { createAppTheme } from "../../themes/app.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const appTheme = uiConfig.colors ? createAppTheme() : appThemeDefault

const app = scv(appTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as AppProps

const classes = resolveClasses(app, {}, useUi("app", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>