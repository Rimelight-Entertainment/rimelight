---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { ModalProps } from "../../types"
import modalThemeDefault, { createModalTheme } from "../../themes/modal.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const modalTheme = uiConfig.colors ? createModalTheme() : modalThemeDefault

const modal = scv(modalTheme)

const {
  open = false,
  triggerLabel,
  closeOnClickOutside = true,
  closeOnEscape = true,
  lockScroll = true,
  title,
  description,
  size = "md",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ModalProps & { size?: "sm" | "md" | "lg" | "xl" }

const classes = resolveClasses(modal, {
  size
}, useUi("modal", uiProp), className)

const modalId = `rla-modal-${Math.random().toString(36).substring(2, 9)}`
---
<div class={classes.root} data-slot="modal-container">
  {triggerLabel ? (
    <button
      class={classes.trigger}
      data-slot="trigger"
      type="button"
      data-dialog-show={modalId}
    >
      {triggerLabel}
    </button>
  ) : (
    <span data-dialog-show={modalId}>
      <slot name="trigger" />
    </span>
  )}

  <dialog
    id={modalId}
    class={classes.content}
    data-slot="content"
    data-lock-scroll={lockScroll ? "true" : "false"}
    data-close-on-escape={closeOnEscape ? "true" : "false"}
    data-close-on-click-outside={closeOnClickOutside ? "true" : "false"}
    {...rest}
  >
    <button
      class={classes.closeButton}
      data-slot="close-button"
      type="button"
      data-dialog-close={modalId}
      aria-label="Close modal"
    >
      <span class="i-lucide-x size-4" aria-hidden="true" />
    </button>

    <div class={classes.header} data-slot="header">
      {title && <h3 class={classes.title} data-slot="title">{title}</h3>}
      <slot name="title" />
      
      {description && <p class={classes.description} data-slot="description">{description}</p>}
      <slot name="description" />
    </div>

    <slot />

    <div class={classes.footer} data-slot="footer">
      <slot name="footer" />
    </div>
  </dialog>
</div>

<script>
  if (!(window as any).__rla_dialog_listener_active) {
    (window as any).__rla_dialog_listener_active = true;
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const showTrigger = target.closest('[data-dialog-show]');
      if (showTrigger) {
        const dialogId = showTrigger.getAttribute('data-dialog-show');
        if (dialogId) {
          const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
          if (dialog) {
            if (typeof dialog.showModal === 'function') {
              dialog.showModal();
            } else if (typeof (dialog as any).showmodal === 'function') {
              (dialog as any).showmodal();
            }
          }
        }
      }

      const closeTrigger = target.closest('[data-dialog-close]');
      if (closeTrigger) {
        const dialogId = closeTrigger.getAttribute('data-dialog-close');
        if (dialogId) {
          const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
          dialog?.close();
        }
      }

      if (target.tagName === 'DIALOG' && target.getAttribute('data-close-on-click-outside') === 'true') {
        const rect = target.getBoundingClientRect();
        const isInModal = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInModal) {
          (target as HTMLDialogElement).close();
        }
      }
    });
  }
</script>
