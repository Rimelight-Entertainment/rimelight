---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { ProgressProps } from "../../types"
import progressThemeDefault, { createProgressTheme } from "../../themes/progress.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const progressTheme = uiConfig.colors ? createProgressTheme(uiConfig.colors) : progressThemeDefault
const progress = scv(progressTheme)

const {
  value = 0,
  max = 100,
  color = "primary",
  size = "md",
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ProgressProps

const classes = resolveClasses(progress, {
  color,
  size,
  theme
}, useUi("progress", uiProp), className)

const percentage = Math.min(100, Math.max(0, (value / max) * 100))
---
<div
  class={classes.root}
  data-slot="progress-root"
  role="progressbar"
  aria-valuemin={0}
  aria-valuemax={max}
  aria-valuenow={value}
  {...rest}
>
  <div
    class:list={[classes.indicator, "rla-progress-indicator"]}
    data-slot="indicator"
  />
</div>

<style define:vars={{ translateX: `-${100 - percentage}%` }}>
  .rla-progress-indicator {
    transform: translateX(var(--translateX));
  }
</style>
