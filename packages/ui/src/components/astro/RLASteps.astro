---
interface Props {
  class?: string
}

const { class: className = "", ...rest } = Astro.props
---
<div class:list={["rl-steps-container", className]} {...rest}>
  <slot />
</div>

<style is:global>
  .rl-steps-container ol {
    list-style: none;
    counter-reset: steps-counter 0;
    padding-inline-start: 0;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .rl-steps-container ol > li {
    counter-increment: steps-counter;
    position: relative;
    padding-inline-start: 3rem;
    padding-bottom: 1.5rem;
    min-height: 2.5rem;
  }

  .rl-steps-container ol > li + li {
    margin-top: 0;
  }

  /* Custom bullet */
  .rl-steps-container ol > li::before {
    content: counter(steps-counter);
    position: absolute;
    top: 0.125rem;
    left: 0;
    width: 1.75rem;
    height: 1.75rem;
    line-height: 1.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-align: center;
    color: var(--primary-foreground, #fff);
    background-color: var(--primary, #3b82f6);
    border-radius: 9999px;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }

  /* Vertical guideline */
  .rl-steps-container ol > li::after {
    content: '';
    position: absolute;
    top: 2rem;
    bottom: 0.125rem;
    left: 0.875rem;
    width: 2px;
    background-color: var(--border, #e5e7eb);
  }

  /* Hide guideline on the last item */
  .rl-steps-container ol > li:last-child::after {
    display: none;
  }

  /* Style headings or paragraphs inside list items nicely */
  .rl-steps-container ol > li > :first-child {
    margin-top: 0;
  }
</style>
