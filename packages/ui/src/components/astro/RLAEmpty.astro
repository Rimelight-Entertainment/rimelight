---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { EmptyProps } from "../../types"
import emptyThemeDefault from "../../themes/empty.theme"

const empty = scv(emptyThemeDefault)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as EmptyProps

const classes = resolveClasses(empty, {}, useUi("empty", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>