---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { ChatReasoningProps } from "../../types"
import chatReasoningThemeDefault from "../../themes/chat-reasoning.theme"

const chatReasoning = scv(chatReasoningThemeDefault)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatReasoningProps

const classes = resolveClasses(chatReasoning, {}, useUi("chatReasoning", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>