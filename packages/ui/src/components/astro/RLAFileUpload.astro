---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { FileUploadProps } from "../../types"
import fileUploadThemeDefault, { createFileUploadTheme } from "../../themes/file-upload.theme"

import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const fileUploadTheme = uiConfig.colors ? createFileUploadTheme() : fileUploadThemeDefault
const fileUpload = scv(fileUploadTheme)

const {
  accept,
  multiple = false,
  disabled = false,
  title = "Drop files here or click to upload",
  description = "Supports any file type",
  icon = "i-lucide-upload-cloud",
  color = "primary",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as FileUploadProps

const classes = resolveClasses(fileUpload, {
  disabled
}, useUi("fileUpload", uiProp), className)

const inputId = `fileUpload-${Math.random().toString(36).slice(2, 9)}`
---

<div
  class={classes.root}
  data-slot="root"
  data-fileUpload
  data-disabled={disabled ? "true" : undefined}
  role="button"
  tabindex={disabled ? -1 : 0}
  aria-label={title}
  {...rest}
>
  <input
    id={inputId}
    type="file"
    class={classes.input}
    accept={accept}
    multiple={multiple}
    disabled={disabled}
    data-fileUpload-input
    aria-hidden="true"
    tabindex="-1"
  />

  <div class={classes.content} data-slot="content">
    <slot name="icon">
      <span class={classes.icon + " " + icon} aria-hidden="true" />
    </slot>

    <slot>
      <p class={classes.title} data-slot="title">{title}</p>
      {description && (
        <p class={classes.description} data-slot="description">{description}</p>
      )}
      {accept && (
        <p class="mt-1 text-[10px] text-muted-foreground/70">
          Accepted: <span class="font-mono">{accept}</span>
        </p>
      )}
    </slot>

    <div
      class="mt-3 hidden text-xs text-muted-foreground"
      data-fileUpload-filelist
      aria-live="polite"
    />
  </div>
</div>

<script>
  document.querySelectorAll("[data-fileUpload]").forEach(element => {
    const zone = element as HTMLElement;
    const input = zone.querySelector("[data-fileUpload-input]") as HTMLInputElement | null;
    const fileList = zone.querySelector("[data-fileUpload-filelist]") as HTMLElement | null;
    if (!input) return;

    const isDisabled = zone.dataset.disabled === "true";
    if (isDisabled) return;

    const showFiles = (files: FileList | null) => {
      if (!fileList || !files || files.length === 0) return;
      fileList.classList.remove("hidden");
      fileList.textContent =
        files.length === 1
          ? files[0]!.name
          : `${files.length} files selected`;
    };

    // Click anywhere on the zone to open file picker
    zone.addEventListener("click", () => input.click());
    zone.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
        e.preventDefault();
        input.click();
      }
    });

    input.addEventListener("change", () => showFiles(input.files));

    // Drag and drop
    zone.addEventListener("dragover", (e) => {
      e.preventDefault();
      zone.classList.add("border-primary", "bg-primary/5");
    });

    zone.addEventListener("dragleave", () => {
      zone.classList.remove("border-primary", "bg-primary/5");
    });

    zone.addEventListener("drop", (e) => {
      e.preventDefault();
      zone.classList.remove("border-primary", "bg-primary/5");
      const dt = (e as DragEvent).dataTransfer;
      if (!dt) return;

      // Transfer dropped files to the hidden input via DataTransfer trick
      try {
        const transfer = new DataTransfer();
        Array.from(dt.files).forEach(f => transfer.items.add(f));
        input.files = transfer.files;
      } catch {
        // Some browsers don't support assigning to input.files — graceful fallback
      }

      showFiles(dt.files);
    });
  });
</script>
