---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { PostsProps } from "../../types"
import postsThemeDefault, { createPostsTheme } from "../../themes/posts.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const postsTheme = uiConfig.colors ? createPostsTheme() : postsThemeDefault

const posts = scv(postsTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PostsProps

const classes = resolveClasses(posts, {}, useUi("posts", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>
