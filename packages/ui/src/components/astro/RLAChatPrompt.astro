---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { ChatPromptProps } from "../../types"
import chatPromptThemeDefault, { createChatPromptTheme } from "../../themes/chat-prompt.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const chatPromptTheme = uiConfig.colors ? createChatPromptTheme() : chatPromptThemeDefault

const chatPrompt = scv(chatPromptTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatPromptProps

const classes = resolveClasses(chatPrompt, {}, useUi("chatPrompt", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>