---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { MarqueeProps } from "../../types"
import marqueeThemeDefault, { createMarqueeTheme } from "../../themes/marquee.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const marqueeTheme = uiConfig.colors ? createMarqueeTheme() : marqueeThemeDefault

const marquee = scv(marqueeTheme)

const {
  direction = "left",
  speed = 40,
  pauseOnHover = true,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as MarqueeProps

const classes = resolveClasses(marquee, {
  direction,
  pauseOnHover
}, useUi("marquee", uiProp), className)

const duration = `${speed}s`
---
<div class={classes.root} data-slot="marquee-root" {...rest}>
  <div class:list={[classes.track, "rla-marquee-track"]} data-slot="track">
    <slot />
  </div>
  <div class:list={[classes.track, "rla-marquee-track"]} data-slot="track" aria-hidden="true">
    <slot />
  </div>
</div>

<style define:vars={{ duration }}>
  .rla-marquee-track {
    animation-duration: var(--duration);
  }
</style>
