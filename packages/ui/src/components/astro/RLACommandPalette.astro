---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { CommandPaletteProps } from "../../types"
import commandPaletteThemeDefault from "../../themes/command-palette.theme"

const commandPalette = scv(commandPaletteThemeDefault)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as CommandPaletteProps

const classes = resolveClasses(commandPalette, {}, useUi("commandPalette", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>