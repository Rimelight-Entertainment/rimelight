---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { LogoProps } from "../../types"
import logoThemeDefault, { createLogoTheme } from "../../themes/logo.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const logoTheme = uiConfig.colors ? createLogoTheme() : logoThemeDefault

const logo = scv(logoTheme)

const {
  variant = "logomark",
  mode,
  theme,
  href = "/",
  alt,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as LogoProps;

const classes = resolveClasses(logo, {}, useUi("logo", uiProp), className);

const globalConfig = getUIConfig();
const rcLogos = globalConfig.logos as Record<string, any>;

let logoSrc: string | null = null;
let darkSrc: string | null = null;
let lightSrc: string | null = null;

if (rcLogos && typeof rcLogos === "object") {
  let src = rcLogos[variant];
  if (src && typeof src === "object") {
    if (theme === "flat" && src.flat) {
      logoSrc = src.flat;
    } else if (mode) {
      logoSrc = src[mode] || src.color;
    } else {
      // No mode, no flat — auto-detect, use color as default
      logoSrc = src.color || src.black || src.white;
      darkSrc = src.white || src.color;
      lightSrc = src.black || src.color;
    }
  } else if (typeof src === "string") {
    logoSrc = src;
  }
}

const startsWithUrlPrefix = logoSrc && (logoSrc.startsWith("http") || logoSrc.startsWith("/") || logoSrc.startsWith("."));
const isIcon = logoSrc && !startsWithUrlPrefix && (logoSrc.includes(":") || logoSrc.startsWith("i-"));
const hasAutoMode = darkSrc && lightSrc && darkSrc !== lightSrc && !mode && theme !== "flat";
---

<a
  class={classes.root}
  href={href}
  aria-label={alt || variant}
  data-slot="root"
  {...rest}
>
  {logoSrc ? (
    isIcon ? (
      <span class:list={[logoSrc, "size-full block shrink-0"]} aria-hidden="true" />
    ) : hasAutoMode ? (
      <>
        <img
          src={lightSrc}
          alt={alt || ""}
          class="size-full block object-contain shrink-0 dark:hidden"
        />
        <img
          src={darkSrc}
          alt={alt || ""}
          class="size-full hidden object-contain shrink-0 dark:block"
        />
      </>
    ) : (
      <img
        src={logoSrc}
        alt={alt || ""}
        class="size-full block object-contain shrink-0"
      />
    )
  ) : (
    <slot />
  )}
</a>
