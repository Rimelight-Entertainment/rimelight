---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { CompareProps } from "../../types"
import compareThemeDefault, { createCompareTheme } from "../../themes/compare.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const compareTheme = uiConfig.colors ? createCompareTheme() : compareThemeDefault

const compare = scv(compareTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as CompareProps

const classes = resolveClasses(compare, {}, useUi("compare", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>