---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { PageBodyProps } from "../../types"
import pageBodyThemeDefault, { createPageBodyTheme } from "../../themes/page-body.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const pageBodyTheme = uiConfig.colors ? createPageBodyTheme() : pageBodyThemeDefault

const pageBody = scv(pageBodyTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PageBodyProps

const classes = resolveClasses(pageBody, {}, useUi("pageBody", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>