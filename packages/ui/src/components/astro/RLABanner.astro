---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { BannerProps } from "../../types"
import bannerThemeDefault, { createBannerTheme } from "../../themes/banner.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const bannerTheme = uiConfig.colors ? createBannerTheme() : bannerThemeDefault

const banner = scv(bannerTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as BannerProps

const classes = resolveClasses(banner, {}, useUi("banner", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>