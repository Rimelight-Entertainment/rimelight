---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { BannerProps } from "../../types"
import bannerThemeDefault, { createBannerTheme } from "../../themes/banner.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const bannerTheme = uiConfig.colors ? createBannerTheme() : bannerThemeDefault

const banner = scv(bannerTheme)

const {
  contain = true,
  sticky = false,
  fixed = true,
  stackIndex = 0,
  hideOnScroll = true,
  dismissable = false,
  dismissId,
  actions = [],
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as BannerProps

const classes = resolveClasses(banner, {
  contain,
  sticky: fixed ? false : sticky,
  fixed,
}, useUi("banner", uiProp), className);

const bannerId = `rla-banner-${Math.random().toString(36).slice(2, 8)}`;
const storageKey = dismissId || bannerId;
const zIndex = 200 - stackIndex;
---

<div
  id={bannerId}
  data-slot="root"
  class:list={[classes.root]}
  data-rla-banner="true"
  data-stack-index={stackIndex}
  data-hide-on-scroll={String(hideOnScroll)}
  data-header-layer-id={bannerId}
  data-layer-type="banner"
  data-dismiss-key={`rl-banner-dismiss-${storageKey}`}
  {...rest}
>
  <div class:list={[classes.content]} data-header-content>
    <div class:list={[classes.container]}>
      <div class:list={[classes.left]} data-slot="left">
        <slot name="left" />
      </div>
      <div class:list={[classes.center]} data-slot="center">
        <slot name="center">
          <slot />
        </slot>
      </div>
      <div class:list={[classes.side]}>
        <div data-slot="right">
          <slot name="right" />
        </div>
        {actions.length > 0 && (
          <div class:list={[classes.actions]}>
            {actions.map((action) => (
              <a
                href={action.href || "#"}
                class:list={[
                  "inline-flex items-center justify-center gap-1 px-3 py-1 rounded-md text-xs font-semibold transition-colors no-underline cursor-pointer shrink-0",
                  action.variant === "solid" || !action.variant
                    ? "bg-foreground text-background hover:opacity-90"
                    : "bg-white/20 text-white hover:bg-white/30",
                  action.class
                ]}
                data-banner-action
              >
                {action.label}
              </a>
            ))}
          </div>
        )}
        {dismissable && (
          <button
            class:list={[classes.dismiss]}
            data-banner-close
            aria-label="Close banner"
            type="button"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>
</div>

{fixed && (
  <style is:inline set:html={`
    #${bannerId} {
      z-index: ${zIndex} !important;
    }
  `} />
)}
