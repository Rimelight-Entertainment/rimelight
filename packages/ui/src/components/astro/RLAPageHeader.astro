---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { PageHeaderProps } from "../../types"
import pageHeaderThemeDefault, { createPageHeaderTheme } from "../../themes/page-header.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const pageHeaderTheme = uiConfig.colors ? createPageHeaderTheme() : pageHeaderThemeDefault

const pageHeader = scv(pageHeaderTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PageHeaderProps

const classes = resolveClasses(pageHeader, {}, useUi("pageHeader", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>