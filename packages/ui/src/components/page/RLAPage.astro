---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { PageProps } from "./page"
import pageThemeDefault, { createPageTheme } from "./page.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const pageTheme = uiConfig.colors ? createPageTheme() : pageThemeDefault

const page = scv(pageTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PageProps

const classes = resolveClasses(page, {}, useUi("page", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>