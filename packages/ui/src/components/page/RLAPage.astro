---
import type { PageProps } from "./page"
import { pageTheme } from "./page.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PageProps

const classes = pageTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>