---
import { resolveIcon } from "../../icons"
import type { IconProps } from "./icon"
import { iconTheme } from "./icon.theme"

const {
  name,
  ...rest
} = Astro.props as IconProps

const classes = iconTheme(Astro.props)
const resolved = resolveIcon(name)
---

<span
  class={classes.root}
  data-slot="icon"
  aria-hidden="true"
  {...rest}
>
  {resolved.isClass ? (
    <span class:list={[resolved.content, "block size-full"]} />  ) : (
    <Fragment set:html={resolved.content} />
  )}
</span>

