---
import type { ContextMenuProps } from "./context-menu"
import { contextMenuTheme } from "./context-menu.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ContextMenuProps

const classes = contextMenuTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>