---
import type { AvatarProps } from "./avatar"
import { avatarTheme } from "./avatar.theme"
import RLAIcon from "../icon/RLAIcon.astro"

const {
  src,
  alt = "",
  fallback,
  initials,
  title,
  subtitle,
  label,
  badge = false,
  badgeColor = "success",
  ...rest
} = Astro.props as AvatarProps

const classes = avatarTheme(Astro.props)
const avatarFallback = fallback || initials
const hasTextLayout = Boolean(title || subtitle)
const badgeClass = badgeColor?.startsWith("bg-") ? badgeColor : `bg-${badgeColor}-500`
---
{hasTextLayout ? (
  <div class="flex items-center gap-3" data-slot="profile-wrapper">
    <span
      class={classes.root}
      data-slot="root"
      aria-label={label || title}
      role={label || title ? "img" : undefined}
      {...rest}
    >
      <slot>
        {src ? (
          <img
            src={src}
            alt={alt}
            class={classes.image}
            data-slot="image"
          />
        ) : (
          <span class={classes.fallback} data-slot="fallback">
            <slot name="fallback">
              {avatarFallback}
            </slot>
            {!avatarFallback && !Astro.slots.has("fallback") && (
              <RLAIcon name="user" class={classes.icon} aria-hidden="true" />
            )}
          </span>
        )}
      </slot>

      <slot name="badge">
        {badge && (
          <span
            class:list={[classes.badge, badgeClass]}
            data-slot="badge"
          >
            {typeof badge === 'string' || typeof badge === 'number' ? badge : null}
          </span>
        )}
      </slot>
    </span>
    <div class="flex flex-col leading-tight">
      {title && (
        <span class="font-medium text-sm text-default" data-slot="title">
          {title}
        </span>
      )}
      {subtitle && (
        <span class="text-xs text-muted" data-slot="subtitle">
          {subtitle}
        </span>
      )}
    </div>
  </div>
) : (
  <span
    class={classes.root}
    data-slot="root"
    aria-label={label}
    role={label ? "img" : undefined}
    {...rest}
  >
    <slot>
      {src ? (
        <img
          src={src}
          alt={alt}
          class={classes.image}
          data-slot="image"
        />
      ) : (
        <span class={classes.fallback} data-slot="fallback">
          <slot name="fallback">
            {avatarFallback}
          </slot>
          {!avatarFallback && !Astro.slots.has("fallback") && (
            <RLAIcon name="user" class={classes.icon} aria-hidden="true" />
          )}
        </span>
      )}
    </slot>

    <slot name="badge">
      {badge && (
        <span
          class:list={[classes.badge, badgeClass]}
          data-slot="badge"
        >
          {typeof badge === 'string' || typeof badge === 'number' ? badge : null}
        </span>
      )}
    </slot>
  </span>
)}
