---
import type { BadgeProps } from "./badge"
import { badgeTheme } from "./badge.theme"


const {
  variant = "solid",
  color = "primary",
  size = "md",
  shape = "pill",
  label,
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as BadgeProps



const resolvedVariant = (variant === "ghost") ? "soft" : ((variant === "solid" || variant === "outline" || variant === "soft" || variant === "subtle") ? variant : "solid")

const classes = badgeTheme({
  variant: resolvedVariant as "solid",
  color: color as "neutral",
  size,
  shape,
  theme,
  ui: uiProp,
  class: className
})
---
<span class={classes.root} data-slot="root" {...rest}>
  <slot>{label}</slot>
</span>
