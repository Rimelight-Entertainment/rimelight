---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { BadgeProps } from "./badge"
import { badgeTheme } from "./badge.theme"

const badge = scv(badgeTheme)

const {
  variant = "solid",
  color = "primary",
  size = "md",
  shape = "pill",
  label,
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as BadgeProps & { label?: string }

const resolvedVariant = (variant === "ghost") ? "soft" : ((variant === "solid" || variant === "outline" || variant === "soft" || variant === "subtle") ? variant : "solid")

const classes = resolveClasses(badge, {
  variant: resolvedVariant as "solid",
  color: color as "neutral",
  size,
  shape,
  theme
}, useUi("badge", uiProp), className)
---
<span class={classes.root} data-slot="root" {...rest}>
  <slot>{label}</slot>
</span>
