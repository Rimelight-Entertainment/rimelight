---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { ChatMessagesProps } from "./chat-messages"
import chatMessagesThemeDefault, { createChatMessagesTheme } from "./chat-messages.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const chatMessagesTheme = uiConfig.colors ? createChatMessagesTheme() : chatMessagesThemeDefault

const chatMessages = scv(chatMessagesTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatMessagesProps

const classes = resolveClasses(chatMessages, {}, useUi("chatMessages", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>