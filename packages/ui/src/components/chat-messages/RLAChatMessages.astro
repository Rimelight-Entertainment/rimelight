---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { ChatMessagesProps } from "./chat-messages"
import chatMessagesTheme from "./chat-messages.theme"


const chatMessages = scv(chatMessagesTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatMessagesProps

const classes = resolveClasses(chatMessages, {}, useUi("chatMessages", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>