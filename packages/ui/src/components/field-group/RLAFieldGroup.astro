---
import type { FieldGroupProps } from "./field-group"
import { fieldGroupTheme } from "./field-group.theme"



const {
  prepend,
  append,
  size = "md",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as FieldGroupProps

const classes = fieldGroupTheme({
  size,
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  {prepend && (
    <div class={classes.prepend} data-slot="prepend">
      {prepend}
    </div>
  )}
  <slot />
  {append && (
    <div class={classes.append} data-slot="append">
      {append}
    </div>
  )}
</div>
