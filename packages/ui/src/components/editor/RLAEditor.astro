---
import type { EditorProps } from "./editor"
import { editorTheme } from "./editor.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as EditorProps

const classes = editorTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>