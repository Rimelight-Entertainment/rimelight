---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { EditorProps } from "./editor"
import editorThemeDefault, { createEditorTheme } from "./editor.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const editorTheme = uiConfig.colors ? createEditorTheme() : editorThemeDefault

const editor = scv(editorTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as EditorProps

const classes = resolveClasses(editor, {}, useUi("editor", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>