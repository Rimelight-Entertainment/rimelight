---
import type { AppProps } from "./app"
import { appTheme } from "./app.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as AppProps

const classes = appTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>