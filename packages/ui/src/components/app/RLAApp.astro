---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { AppProps } from "./app"
import appThemeDefault, { createAppTheme } from "./app.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const appTheme = uiConfig.colors ? createAppTheme() : appThemeDefault

const app = scv(appTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as AppProps

const classes = resolveClasses(app, {}, useUi("app", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>