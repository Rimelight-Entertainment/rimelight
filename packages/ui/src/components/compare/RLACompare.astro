---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { CompareProps } from "./compare"
import compareTheme from "./compare.theme"


const compare = scv(compareTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as CompareProps

const classes = resolveClasses(compare, {}, useUi("compare", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>