---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { ChatPromptProps } from "./chat-prompt"
import { chatPromptTheme } from "./chat-prompt.theme"


const chatPrompt = scv(chatPromptTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatPromptProps

const classes = resolveClasses(chatPrompt, {}, useUi("chatPrompt", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>