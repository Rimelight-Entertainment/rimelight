---
import type { ChatPromptProps } from "./chat-prompt"
import { chatPromptTheme } from "./chat-prompt.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatPromptProps

const classes = chatPromptTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>