---
export interface FormattedDateProps {
	date?: Date | undefined;
	locale?: string;
}
type Props = FormattedDateProps;

const { 
	date,
	locale = Astro.locals.astroI18n?.locale || "en-US"
} = Astro.props;
---

{
	date && (
		<time datetime={date.toISOString()}>
			{
				date.toLocaleDateString(locale, {
					year: 'numeric',
					month: 'short',
					day: 'numeric',
				})
			}
		</time>
	)
}
