---
import type { AudioProps } from "./audio"
import { audioTheme } from "./audio.theme"



const classes = audioTheme(Astro.props)
---
<div class={classes.root} data-slot="root" {...Astro.props}>
  <slot />
  {Astro.slots.has("transcript") && (
    <div class="mt-2 text-sm text-zinc-400" data-slot="transcript">
      <slot name="transcript" />
    </div>
  )}
</div>