---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { AudioProps } from "./audio"
import audioThemeDefault, { createAudioTheme } from "./audio.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const audioTheme = uiConfig.colors ? createAudioTheme() : audioThemeDefault

const audio = scv(audioTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as AudioProps

const classes = resolveClasses(audio, {}, useUi("audio", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
  {Astro.slots.has("transcript") && (
    <div class="mt-2 text-sm text-zinc-400" data-slot="transcript">
      <slot name="transcript" />
    </div>
  )}
</div>