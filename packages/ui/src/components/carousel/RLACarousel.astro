---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { CarouselProps } from "./carousel"
import { resolveTheme } from "../../utils/resolver"
import carouselThemeDefault, { createCarouselTheme } from "./carousel.theme"
const carouselTheme = resolveTheme(carouselThemeDefault, createCarouselTheme)
import RLAIcon from "../icon/RLAIcon.astro"


const carousel = scv(carouselTheme)

const {
  slides,
  autoplay = false,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as CarouselProps

const classes = resolveClasses(carousel, {}, useUi("carousel", uiProp), className)
const carouselId = `rla-carousel-${Math.random().toString(36).substring(2, 9)}`
---
<rla-carousel data-autoplay={autoplay ? "true" : "false"} {...rest}>
  <div id={carouselId} class={classes.root} data-slot="carousel-root">
    <div class={classes.viewport} data-slot="viewport">
      <div class={classes.container} data-slot="container">
        {slides ? (
          slides.map((slide) => (
            <div
              class={`${classes.slide} rla-carousel-slide`}
              data-slot="slide"
              style="container-type: scroll-state; container-name: rla-slide;"
            >
              <div class="relative w-full aspect-video">
                {slide.imageSrc && <img src={slide.imageSrc} alt={slide.title || ""} class="w-full h-full object-cover rounded-lg" draggable="false" />}
                {(slide.title || slide.description) && (
                  <div class="absolute bottom-4 left-4 right-4 p-4 rounded-lg bg-black/60 backdrop-blur-sm text-white">
                    {slide.title && <h4 class="text-sm font-semibold">{slide.title}</h4>}
                    {slide.description && <p class="text-xs opacity-95 mt-1">{slide.description}</p>}
                  </div>
                )}
              </div>
            </div>
          ))
        ) : (
          <slot />
        )}
      </div>
    </div>

    <button class={classes.buttonPrev} data-slot="prev-button" type="button" aria-label="Previous slide">
      <RLAIcon name="chevronLeft" class="size-5" aria-hidden="true" />
    </button>
    <button class={classes.buttonNext} data-slot="next-button" type="button" aria-label="Next slide">
      <RLAIcon name="chevronRight" class="size-5" aria-hidden="true" />
    </button>
  </div>
</rla-carousel>

<script>
  class RLACarousel extends HTMLElement {
    private cleanup: (() => void) | null = null;

    connectedCallback() {
      this.style.display = 'contents';
      const autoplay = this.getAttribute("data-autoplay") === "true";
      const viewport = this.querySelector('[data-slot="viewport"]') as HTMLElement;
      const container = this.querySelector('[data-slot="container"]') as HTMLElement;
      const prevBtn = this.querySelector('[data-slot="prev-button"]') as HTMLButtonElement;
      const nextBtn = this.querySelector('[data-slot="next-button"]') as HTMLButtonElement;

      if (!viewport || !container) return;

      const originalSlides = Array.from(container.children) as HTMLElement[];
      const N = originalSlides.length;
      if (N === 0) return;

      const firstSlide = originalSlides[0];
      const lastSlide = originalSlides[N - 1];
      if (!firstSlide || !lastSlide) return;

      // Clone first and last slides for seamless looping
      const firstClone = firstSlide.cloneNode(true) as HTMLElement;
      const lastClone = lastSlide.cloneNode(true) as HTMLElement;

      container.insertBefore(lastClone, firstSlide);
      container.appendChild(firstClone);

      // Add draggable="false" to all images inside clones as well
      container.querySelectorAll('img').forEach(img => {
        img.setAttribute('draggable', 'false');
      });

      let currentIndex = 1; // Start at the first actual slide
      let isTransitioning = false;
      let startX = 0;
      let startY = 0;
      let isDragging = false;
      let hasDragged = false;
      let autoplayIntervalId: any = null;

      const updateTransform = (withTransition: boolean, translatePercent?: number) => {
        if (withTransition) {
          container.style.transition = 'transform 500ms cubic-bezier(0.16, 1, 0.3, 1)';
        } else {
          container.style.transition = 'none';
        }
        const pct = translatePercent !== undefined ? translatePercent : -currentIndex * 100;
        container.style.transform = `translate3d(${pct}%, 0px, 0px)`;
      };

      // Set initial position
      updateTransform(false);

      const handleTransitionEnd = () => {
        isTransitioning = false;
        if (currentIndex === 0) {
          currentIndex = N;
          updateTransform(false);
        } else if (currentIndex === N + 1) {
          currentIndex = 1;
          updateTransform(false);
        }
      };

      const goToIndex = (index: number) => {
        if (isTransitioning) return;
        isTransitioning = true;
        currentIndex = index;
        updateTransform(true);
      };

      const scrollPrev = () => {
        goToIndex(currentIndex - 1);
      };

      const scrollNext = () => {
        goToIndex(currentIndex + 1);
      };

      // Autoplay
      const startAutoplay = () => {
        if (autoplay && !autoplayIntervalId) {
          autoplayIntervalId = setInterval(scrollNext, 5000);
        }
      };

      const stopAutoplay = () => {
        if (autoplayIntervalId) {
          clearInterval(autoplayIntervalId);
          autoplayIntervalId = null;
        }
      };

      startAutoplay();

      // Button event listeners with throttle
      let lastBtnClickTime = 0;
      const handleBtnClick = (action: () => void) => {
        const now = Date.now();
        if (now - lastBtnClickTime < 500) return;
        lastBtnClickTime = now;
        stopAutoplay();
        action();
        startAutoplay();
      };

      const onPrevClick = (e: MouseEvent) => {
        e.preventDefault();
        handleBtnClick(scrollPrev);
      };

      const onNextClick = (e: MouseEvent) => {
        e.preventDefault();
        handleBtnClick(scrollNext);
      };

      if (prevBtn) prevBtn.addEventListener("click", onPrevClick);
      if (nextBtn) nextBtn.addEventListener("click", onNextClick);

      // Pointer events for drag/swipe
      const onPointerDown = (e: PointerEvent) => {
        if (isTransitioning) return;
        stopAutoplay();
        startX = e.clientX;
        startY = e.clientY;
        isDragging = true;
        hasDragged = false;
        try {
          viewport.setPointerCapture(e.pointerId);
        } catch (err) {}
      };

      const onPointerMove = (e: PointerEvent) => {
        if (!isDragging) return;
        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;

        if (!hasDragged) {
          // If vertical movement is greater than horizontal early on, cancel drag to let page scroll
          if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > 5) {
            isDragging = false;
            try {
              viewport.releasePointerCapture(e.pointerId);
            } catch (err) {}
            return;
          }
          if (Math.abs(deltaX) > 5) {
            hasDragged = true;
            container.style.transition = 'none'; // Only disable transition when we actually start dragging
          }
        }

        if (hasDragged) {
          e.preventDefault();
          const width = viewport.clientWidth;
          const deltaPercent = (deltaX / width) * 100;
          const basePercent = -currentIndex * 100;
          updateTransform(false, basePercent + deltaPercent);
        }
      };

      const onPointerUp = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        try {
          viewport.releasePointerCapture(e.pointerId);
        } catch (err) {}

        if (hasDragged) {
          const deltaX = e.clientX - startX;
          const width = viewport.clientWidth;
          const threshold = width * 0.15;

          if (deltaX < -threshold) {
            scrollNext();
          } else if (deltaX > threshold) {
            scrollPrev();
          } else {
            // Snap back
            isTransitioning = true;
            updateTransform(true);
            setTimeout(() => {
              isTransitioning = false;
            }, 50);
          }
        } else {
          // If it was just a click, make sure transition settings are restored
          container.style.transition = 'transform 500ms cubic-bezier(0.16, 1, 0.3, 1)';
          isTransitioning = false;
        }
        startAutoplay();
      };

      viewport.addEventListener("pointerdown", onPointerDown);
      viewport.addEventListener("pointermove", onPointerMove, { passive: false });
      viewport.addEventListener("pointerup", onPointerUp);
      viewport.addEventListener("pointercancel", onPointerUp);
      container.addEventListener("transitionend", handleTransitionEnd);

      this.cleanup = () => {
        stopAutoplay();
        if (prevBtn) prevBtn.removeEventListener("click", onPrevClick);
        if (nextBtn) nextBtn.removeEventListener("click", onNextClick);
        viewport.removeEventListener("pointerdown", onPointerDown);
        viewport.removeEventListener("pointermove", onPointerMove);
        viewport.removeEventListener("pointerup", onPointerUp);
        viewport.removeEventListener("pointercancel", onPointerUp);
        container.removeEventListener("transitionend", handleTransitionEnd);
        
        if (container.contains(firstClone)) container.removeChild(firstClone);
        if (container.contains(lastClone)) container.removeChild(lastClone);
      };
    }

    disconnectedCallback() {
      if (this.cleanup) {
        this.cleanup();
        this.cleanup = null;
      }
    }
  }

  if (!customElements.get('rla-carousel')) {
    customElements.define('rla-carousel', RLACarousel);
  }
</script>

<style>
  /*
   * CSS scroll-state(snapped: x) — Chrome 133+
   *
   * Each slide is a scroll-state container. When the carousel uses
   * scroll-snap (or the JS engine snaps to a slide), the browser marks
   * the currently-snapped slide with snapped: x.
   *
   * Snapped slide  → full opacity + normal scale
   * Off-screen slides → dimmed + slightly scaled down
   *
   * This is purely additive progressive enhancement. The JS engine
   * (infinite-loop clones, pointer drag, autoplay) is unchanged.
   * Browsers without scroll-state() support see all slides at full
   * opacity, which matches the previous behaviour.
   */
  @container rla-slide scroll-state(snapped: x) {
    .rla-carousel-slide {
      opacity: 1;
      scale: 1;
    }
  }

  @container rla-slide not scroll-state(snapped: x) {
    .rla-carousel-slide {
      opacity: 0.7;
      scale: 0.97;
    }
  }

  /* Smooth transition between states */
  .rla-carousel-slide {
    transition: opacity 0.35s ease, scale 0.35s ease;
  }
</style>
