---
import type { ChatToolProps } from "./chat-tool"
import { chatToolTheme } from "./chat-tool.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatToolProps

const classes = chatToolTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>