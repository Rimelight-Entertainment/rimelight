---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { ChatReasoningProps } from "./chat-reasoning"
import chatReasoningTheme from "./chat-reasoning.theme"


const chatReasoning = scv(chatReasoningTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatReasoningProps

const classes = resolveClasses(chatReasoning, {}, useUi("chatReasoning", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>