---
import type { TreeProps } from "./tree"
import { treeTheme } from "./tree.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as TreeProps

const classes = treeTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>