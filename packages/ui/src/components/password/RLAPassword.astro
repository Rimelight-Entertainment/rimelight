---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { PasswordProps } from "./password"
import passwordThemeDefault, { createPasswordTheme } from "./password.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const passwordTheme = uiConfig.colors ? createPasswordTheme() : passwordThemeDefault

const password = scv(passwordTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PasswordProps

const classes = resolveClasses(password, {}, useUi("password", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>