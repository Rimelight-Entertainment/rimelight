---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { PasswordProps } from "./password"
import passwordTheme from "./password.theme"


const password = scv(passwordTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PasswordProps

const classes = resolveClasses(password, {}, useUi("password", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>