---
import type { QrCodeProps } from "./qr-code"
import { qrCodeTheme } from "./qr-code.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as QrCodeProps

const classes = qrCodeTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>