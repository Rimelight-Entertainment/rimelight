---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { ChatPaletteProps } from "./chat-palette"
import chatPaletteThemeDefault, { createChatPaletteTheme } from "./chat-palette.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const chatPaletteTheme = uiConfig.colors ? createChatPaletteTheme() : chatPaletteThemeDefault

const chatPalette = scv(chatPaletteTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatPaletteProps

const classes = resolveClasses(chatPalette, {}, useUi("chatPalette", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>