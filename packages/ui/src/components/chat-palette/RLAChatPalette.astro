---
import type { ChatPaletteProps } from "./chat-palette"
import { chatPaletteTheme } from "./chat-palette.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatPaletteProps

const classes = chatPaletteTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>