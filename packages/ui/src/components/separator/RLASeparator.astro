---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { SeparatorProps } from "./separator"
import { resolveTheme } from "../../utils/resolveTheme"
import separatorThemeDefault, { createSeparatorTheme } from "./separator.theme"
const separatorTheme = resolveTheme(separatorThemeDefault, createSeparatorTheme)
import RLAAvatar from "../avatar/RLAAvatar.astro"
import { cx } from "css-variants"


const separator = scv(separatorTheme)

const {
  orientation = "horizontal",
  color = "neutral",
  size = "xs",
  type = "solid",
  label,
  icon,
  avatar,
  position = "center",
  decorative = true,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SeparatorProps & {
  color?: string
  size?: "xs" | "sm" | "md" | "lg" | "xl"
  type?: "solid" | "dashed" | "dotted"
  position?: "start" | "center" | "end"
}

const classes = resolveClasses(separator, {
  orientation,
  color: color as "neutral",
  size: size as "xs",
  type: type as "solid",
  position: position as "center"
}, useUi("separator", uiProp), className)
---
<div
  class={classes.root}
  data-slot="root"
  role={decorative ? "none" : "separator"}
  aria-orientation={decorative ? undefined : orientation}
  {...rest}
>
  <div class={classes.border} />

  {(label || icon || avatar || Astro.slots.has("default")) && (
    <>
      <div class={classes.container} data-slot="container">
        <slot name="avatar">
          {avatar && (
            <RLAAvatar 
              {...(typeof avatar === 'string' ? { src: avatar } : avatar)} 
              size={classes.avatarSize as any} 
              class={classes.avatar} 
              data-slot="avatar" 
            />
          )}
        </slot>
        
        <slot name="icon">
          {icon && (
            <span class={classes.icon} data-slot="icon">
              <span class={cx(icon)} aria-hidden="true" />
            </span>
          )}
        </slot>

        <span class={classes.label} data-slot="label">
          {label}
          <slot />
        </span>
      </div>

      <div class={classes.border} />
    </>
  )}
</div>
