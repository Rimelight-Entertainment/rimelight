---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

export interface BreadcrumbItemProps extends HTMLAttributes<"li"> {}
type Props = BreadcrumbItemProps;

export const breadcrumbItem = cv({ base: "inline-flex items-center gap-1.5" });

const { class: className, ...rest } = Astro.props;
---

<li class:list={[breadcrumbItem(), className]} {...rest} data-slot="breadcrumb-item">
  <slot />
</li>
