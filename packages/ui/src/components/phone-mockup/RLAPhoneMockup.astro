---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { PhoneMockupProps } from "./phone-mockup"
import phoneMockupTheme from "./phone-mockup.theme"


const phoneMockup = scv(phoneMockupTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PhoneMockupProps

const classes = resolveClasses(phoneMockup, {}, useUi("phoneMockup", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>