---
import type { PhoneMockupProps } from "./phone-mockup"
import { phoneMockupTheme } from "./phone-mockup.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PhoneMockupProps

const classes = phoneMockupTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>