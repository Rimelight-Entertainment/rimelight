---
import type { HTMLAttributes } from "astro/types";


type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

import { button } from "../button/Button.astro";

type Props = HTMLAttributes<"a"> &
  Omit<VariantProps<typeof button>, "variant"> & {
    isActive?: boolean;
  };

export const paginationLink = button;

const { class: className, isActive, size = "icon", ...rest } = Astro.props;
---

<a
  aria-current={isActive ? "page" : undefined}
  class:list={[button({ variant: isActive ? "outline" : "ghost", size }), className]}
  {...rest}
  data-slot="pagination-link"
>
  <slot />
</a>

