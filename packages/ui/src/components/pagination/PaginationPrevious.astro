---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";
import IconChevronLeft from "~icons/lucide/chevron-left";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

import type { button } from "../button/Button.astro";

import PaginationLink from "./PaginationLink.astro";

type Props = HTMLAttributes<"a"> & {
  size?: VariantProps<typeof button>["size"];
};

export const paginationPrevious = cv({ base: "group gap-2xs" });

const { class: className, size = "md", ...rest } = Astro.props;
---

<PaginationLink
  aria-label="Go to previous page"
  size={size}
  class:list={[paginationPrevious(), className]}
  {...rest}
  data-slot="pagination-previous"
>
  <slot name="icon">
    <IconChevronLeft class="size-4 transition-transform group-hover:-translate-x-1" />
  </slot>
  <slot />
</PaginationLink>

