---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"ul"> & {
  children: any;
};

export const paginationContent = cv({ base: "flex flex-row items-center gap-2xs" });

const { class: className, ...rest } = Astro.props;
---

<ul class:list={[paginationContent(), className]} {...rest} data-slot="pagination-content">
  <slot />
</ul>
