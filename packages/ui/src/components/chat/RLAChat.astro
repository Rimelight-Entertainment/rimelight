---
import type { ChatProps } from "./chat"
import { chatTheme } from "./chat.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChatProps

const classes = chatTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>