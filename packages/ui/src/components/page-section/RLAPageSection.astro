---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { PageSectionProps } from "./page-section"
import pageSectionThemeDefault, { createPageSectionTheme } from "./page-section.theme"
import { getUIConfig } from "virtual:rimelight-ui"
import RLAIcon from "../icon/RLAIcon.astro"
import RLAButton from "../button/RLAButton.astro"

const uiConfig = getUIConfig()
const pageSectionTheme = uiConfig.colors ? createPageSectionTheme() : pageSectionThemeDefault

const pageSection = scv(pageSectionTheme)

const {
  as = "section",
  variant = "default",
  orientation = "vertical",
  reverse = false,
  ctaVariant = "solid",
  headline,
  title,
  description,
  icon,
  links,
  contentVisibility,
  containIntrinsicSize,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PageSectionProps;

const resolvedVariant = (variant === "default" || variant === "hero" || variant === "cta") ? variant : "default"

const classes = resolveClasses(pageSection, {
  variant: resolvedVariant,
  orientation,
  reverse,
  ...(resolvedVariant === "cta" && { ctaVariant }),
  headline: !!(Astro.slots.has("headline") || headline),
  title: !!(Astro.slots.has("title") || title),
  description: !!(Astro.slots.has("description") || description),
  body: Astro.slots.has("body")
}, useUi("pageSection", uiProp), className);

const hasDefaultSlot = Astro.slots.has("default");

const Tag = as;
const TitleTag = variant === "hero" ? "h1" : "h2";
---

<Tag
  data-orientation={orientation}
  class:list={[classes.root, contentVisibility === "auto" && "rla-visibility-aware"]}
  style={containIntrinsicSize ? `--rla-contain-intrinsic-size: ${containIntrinsicSize};` : undefined}
  {...rest}
>
  {Astro.slots.has("background") && (
    <div class:list={[classes.background]} data-slot="background">
      <slot name="background" />
    </div>
  )}

  <slot name="top" />

  <div
    class:list={[classes.container]}
  >
    {(Astro.slots.has("header") || icon || headline || title || description || Astro.slots.has("body") || Astro.slots.has("footer") || Astro.slots.has("links") || links?.length) && (
      <div
        class:list={[classes.wrapper]}
      >
        {(Astro.slots.has("header") || icon || headline || title || description) && (
          <div
            class:list={[classes.header]}
          >
            <slot name="header">
              {(icon || Astro.slots.has("leading")) && (
                <div
                  class:list={[classes.leading]}
                >
                  <slot name="leading" {...{ ui: classes }}>
                    {icon && (
                      <RLAIcon name={icon} size="md" ui={{ root: classes.leadingIcon }} />
                    )}
                  </slot>
                </div>
              )}

              {(headline || Astro.slots.has("headline")) && (
                <div
                  class:list={[classes.headline]}
                >
                  <slot name="headline">
                    {headline}
                  </slot>
                </div>
              )}

              {(title || Astro.slots.has("title")) && (
                <TitleTag
                  class:list={[classes.title]}
                >
                  <slot name="title">
                    {title}
                  </slot>
                </TitleTag>
              )}

              {(description || Astro.slots.has("description")) && (
                <div
                  class:list={[classes.description]}
                >
                  <slot name="description">
                    {description}
                  </slot>
                </div>
              )}
            </slot>
          </div>
        )}

        {Astro.slots.has("body") && (
          <div
            class:list={[classes.body]}
          >
            <slot name="body" />
          </div>
        )}

        {(Astro.slots.has("footer") || Astro.slots.has("links") || links?.length) && (
          <div
            class:list={[classes.footer]}
          >
            <slot name="footer">
              {(links?.length || Astro.slots.has("links")) && (
                <div
                  class:list={[classes.links]}
                >
                  {links?.map((link) => (
                    <RLAButton size="lg" {...link} />
                  ))}
                  <slot name="links" />
                </div>
              )}
            </slot>
          </div>
        )}
      </div>
    )}

    {hasDefaultSlot ? (
      <slot />
    ) : orientation === "horizontal" ? (
      <div class="hidden lg:block" />
    ) : null}
  </div>

  <slot name="bottom" />
</Tag>
