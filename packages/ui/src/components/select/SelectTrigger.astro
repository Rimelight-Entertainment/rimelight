---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";
import IconChevronDown from "~icons/lucide/chevron-down";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = Omit<HTMLAttributes<"button">, "role" | "type"> &
  VariantProps<typeof selectTrigger> & {
    /**
     * The content to be rendered inside the select trigger
     */
    children: any;
  };

export const selectTrigger = cv({
  base: [
    "starwind-select-trigger",
    "border-input dark:bg-input/30 text-foreground ring-offset-background flex items-center justify-between gap-2 rounded-md b bg-transparent shadow-xs",
    "focus-visible:border-outline focus-visible:ring-outline/50 transition-[color,box-shadow] outline-none focus-visible:ring-3",
    "disabled:cursor-not-allowed disabled:op-50 [&>span]:line-clamp-1",
    "aria-invalid:border-error aria-invalid:focus:ring-error/40 aria-invalid:focus:ring-3",
  ],
  variants: {
    size: {
      sm: "h-2xl px-3xs text-sm",
      md: "h-3xl px-xs text-base",
      lg: "h-3xl px-2xl text-lg",
    },
  },
  defaultVariants: {
    size: "md",
  },
});

const { class: className, size, ...rest } = Astro.props;
---

<button
  class:list={[selectTrigger({ size }), className]}
  type="button"
  role="combobox"
  aria-label="Select field"
  aria-controls=""
  aria-expanded="false"
  aria-haspopup="listbox"
  aria-autocomplete="none"
  data-state="closed"
  {...rest}
  data-slot="select-trigger"
>
  <slot />
  <slot name="icon">
    <IconChevronDown class="size-4 op-50" />
  </slot>
</button>
