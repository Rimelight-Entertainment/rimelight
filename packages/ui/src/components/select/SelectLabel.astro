---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

export const selectLabel = cv({ base: "text-muted-foreground py-5xs pr-2xl pl-3xs" });

const { class: className, ...rest } = Astro.props;
---

<div class:list={[selectLabel(), className]} {...rest} data-slot="select-label">
  <slot />
</div>
