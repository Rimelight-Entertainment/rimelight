---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { SelectProps } from "./select"
import selectTheme from "./select.theme"
import RLAIcon from "../icon/RLAIcon.astro"


const select = scv(selectTheme)

const {
  items = [],
  value = "",
  placeholder = "Select item...",
  disabled = false,
  name,
  label,
  size = "md",
  color = "primary",
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SelectProps

const classes = resolveClasses(select, {
  size
}, useUi("select", uiProp), className);

const normalizedItems = items.map(item => {
  if (typeof item === "string") {
    return { label: item, value: item }
  }
  return item
})

const selectedItem = normalizedItems.find(item => item.value === value)
const initialLabel = selectedItem ? selectedItem.label : ""
---



{label && <label class={classes.label} data-slot="label" for={`rla-sel-native-${name}`}>{label}</label>}

<!-- PATH A: Native customizable select -->
<div class="rla-select-native-wrapper" data-slot="root" aria-hidden="false">
  <select
    id={`rla-sel-native-${name}`}
    class={`rla-select-native ${classes.trigger}`}
    name={name}
    disabled={disabled}
    data-slot="trigger"
  >
    {placeholder && <option value="" disabled selected={!value}>{placeholder}</option>}
    {normalizedItems.map(item => (
      <option value={item.value} selected={item.value === value}>
        {item.label}
      </option>
    ))}
  </select>
</div>

<!-- PATH B: Custom element fallback -->
<rla-select {...rest}>
  <div class={classes.root} data-slot="root" data-disabled={disabled ? "" : undefined}>
    <div class="relative w-full" data-select-wrapper>
      <button
        type="button"
        class={classes.trigger}
        data-slot="trigger"
        disabled={disabled}
        data-select-trigger
      >
        <span data-select-value>{initialLabel || placeholder}</span>
        <RLAIcon name="chevronDown" class="ml-2 size-4 opacity-50" />
      </button>

      <div class={classes.content + " hidden"} data-select-dropdown data-slot="content">
        <div class="py-1" data-select-items>
          {normalizedItems.map(item => (
            <div
              class={classes.item}
              data-slot="item"
              data-value={item.value}
              data-label={item.label}
              data-select-item
            >
              <span class={classes.itemText}>{item.label}</span>
              <RLAIcon name="check" class={classes.itemIcon + " hidden"} data-check-icon />
            </div>
          ))}
        </div>
      </div>
    </div>
    <input type="hidden" name={name} value={value} data-select-hidden-input />
  </div>
</rla-select>

<style>
  /*
   * PATH A: Native customizable select — styled using appearance: base-select
   * which allows styling the button, picker, and options in modern browsers.
   */
  .rla-select-native-wrapper {
    display: block;
    position: relative;
    width: 100%;
  }

  rla-select {
    display: none !important;
  }

  .rla-select-native {
    appearance: base-select;
    width: 100%;
    cursor: pointer;
  }

  /* Style the dropdown picker container */
  .rla-select-native::picker(select) {
    border-radius: 0.5rem;
    border: 1px solid var(--color-border, #e2e8f0);
    background: var(--color-background, #fff);
    padding: 0.25rem;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06);
    margin-top: 0.25rem;
    max-height: 15rem;
    overflow-y: auto;
  }

  /* Style individual options */
  .rla-select-native option {
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    cursor: default;
    font-size: 0.875rem;
    color: var(--color-foreground, inherit);
  }

  .rla-select-native option:hover,
  .rla-select-native option:checked {
    background: var(--color-accent, #f1f5f9);
    color: var(--color-accent-foreground, inherit);
  }

  /* Disabled placeholder option */
  .rla-select-native option:disabled {
    opacity: 0.5;
  }
</style>

<script>
  class RLASelect extends HTMLElement {
    private selectCleanup: (() => void) | null = null;
    private initTimeout: any = null;

    connectedCallback() {
      this.style.display = 'contents';
      this.initTimeout = setTimeout(() => {
        const wrapper = this.querySelector("[data-select-wrapper]") as HTMLElement | null;
        if (!wrapper) return;

        const trigger = wrapper.querySelector("[data-select-trigger]") as HTMLButtonElement;
        const dropdown = wrapper.querySelector("[data-select-dropdown]") as HTMLDivElement;
        const items = wrapper.querySelectorAll<HTMLElement>("[data-select-item]");
        const valueSpan = wrapper.querySelector("[data-select-value]");
        const hiddenInput = this.querySelector("[data-select-hidden-input]") as HTMLInputElement | null;

        if (!trigger || !dropdown) return;

        const onTriggerClick = (e: MouseEvent) => {
          e.stopPropagation();
          dropdown.classList.toggle("hidden");
        };
        trigger.addEventListener("click", onTriggerClick);

        const itemCleanups: (() => void)[] = [];
        items.forEach(item => {
          const onItemClick = (e: MouseEvent) => {
            e.stopPropagation();
            const val = (item as HTMLElement).dataset.value || "";
            const label = (item as HTMLElement).dataset.label || "";
            if (hiddenInput) {
              hiddenInput.value = val;
              hiddenInput.dispatchEvent(new Event("change", { bubbles: true }));
            }
            if (valueSpan) valueSpan.textContent = label;
            
            items.forEach(i => i.querySelector("[data-check-icon]")?.classList.add("hidden"));
            item.querySelector("[data-check-icon]")?.classList.remove("hidden");
            
            dropdown.classList.add("hidden");
          };
          item.addEventListener("click", onItemClick);
          itemCleanups.push(() => item.removeEventListener("click", onItemClick));
        });

        const onDocumentClick = () => {
          dropdown.classList.add("hidden");
        };
        document.addEventListener("click", onDocumentClick);

        this.selectCleanup = () => {
          trigger.removeEventListener("click", onTriggerClick);
          itemCleanups.forEach(fn => fn());
          document.removeEventListener("click", onDocumentClick);
        };
      }, 0);
    }

    disconnectedCallback() {
      if (this.initTimeout) {
        clearTimeout(this.initTimeout);
      }
      if (this.selectCleanup) {
        this.selectCleanup();
        this.selectCleanup = null;
      }
    }
  }

  if (!customElements.get('rla-select')) {
    customElements.define('rla-select', RLASelect);
  }
</script>
