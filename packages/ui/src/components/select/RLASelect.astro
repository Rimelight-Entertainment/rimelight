---
import type { SelectProps, SelectItem } from "./select"
import { selectTheme } from "./select.theme"
import RLAButton from "../button/RLAButton.astro"
import RLAIcon from "../icon/RLAIcon.astro"

const {
  items = [],
  value,
  defaultValue,
  placeholder,
  disabled = false,
  required = false,
  name,
  size = "md",
  variant = "default",
  buttonVariant = "ghost",
  buttonColor = "neutral",
  multiple,
  leadingIcon,
  ui: _ui,
  class: classAttr,
  theme,
  ...rest
} = Astro.props as SelectProps

// Legacy prop values ("outline", "soft", "subtle", "ghost", "none") were never
// implemented by the theme; normalize them to the default look.
const resolvedVariant = variant === "default" || variant === "icon" ? variant : "default"

const classes = selectTheme({ size, variant: resolvedVariant, class: classAttr })

const hasLeading = !!(leadingIcon || Astro.slots.has("leading"))

const currentValue = value !== undefined ? value : defaultValue !== undefined ? defaultValue : undefined
const currentValues = Array.isArray(currentValue) ? currentValue.map(String) : undefined

const normalizedItems = (items || []).map((item: SelectItem) => {
  if (typeof item === "string" || typeof item === "number" || typeof item === "boolean") {
    return { label: String(item), value: String(item), disabled: false }
  }
  const i = item as {
    label?: string
    value?: any
    disabled?: boolean
    icon?: string
    avatar?: { src?: string; alt?: string; loading?: "lazy" | "eager" }
  }
  return {
    label: String(i.label ?? i.value ?? ""),
    value: String(i.value ?? ""),
    disabled: !!i.disabled,
    icon: i.icon,
    avatar: i.avatar
  }
})

const selectedItem =
  currentValue !== undefined && !Array.isArray(currentValue)
    ? normalizedItems.find((item) => String(item.value) === String(currentValue))
    : undefined
const currentLabel =
  placeholder && (currentValue === undefined || (Array.isArray(currentValue) && currentValues?.length === 0))
    ? placeholder
    : selectedItem?.label ?? ""
---

<div class={classes.root} data-slot="root" data-theme={theme}>
  {resolvedVariant === "icon" ? (
    <RLAButton
      variant={buttonVariant}
      color={buttonColor}
      size={size}
      theme={theme}
      square
      disabled={disabled}
      leadingIcon={leadingIcon}
      aria-hidden="true"
      tabindex={-1}
      type="button"
      data-slot="trigger"
    >
      <slot name="leading" />
    </RLAButton>
  ) : hasLeading ? (
    <span class={classes.leading} data-slot="leading">
      {leadingIcon ? <RLAIcon name={leadingIcon} class="size-4" /> : <slot name="leading" />}
    </span>
  ) : null}

  {resolvedVariant !== "icon" && (
    <span class={classes.label} data-slot="label" aria-hidden="true">
      {currentLabel}
    </span>
  )}

  <select
    class={classes.select}
    name={name}
    disabled={disabled}
    required={required}
    multiple={multiple}
    aria-label={currentLabel}
    data-slot="select"
    {...rest}
  >
    {placeholder && !multiple && (
      <option value="" disabled selected={currentValue === undefined}>{placeholder}</option>
    )}
    {normalizedItems.map((item) => (
      <option
        value={item.value}
        disabled={item.disabled}
        selected={currentValues ? currentValues.includes(item.value) : (currentValue !== undefined ? currentValue === item.value : undefined)}
      >
        {item.icon && <RLAIcon name={item.icon} class="rl-select-item-icon" />}
        {item.avatar && <img src={item.avatar.src} alt={item.avatar.alt} class="rl-select-item-icon" />}
        {item.label}
      </option>
    ))}
  </select>

  {resolvedVariant !== "icon" && (
    <span class={classes.icon} data-slot="icon">
      <RLAIcon name="i-lucide-chevron-down" class="size-4" />
    </span>
  )}
</div>

<style is:global>
  select.rl-select,
  select.rl-select::picker(select) { appearance: base-select; }
  select.rl-select::picker-icon { display: none; }
  select.rl-select::picker(select) {
    border: 1px solid var(--rl-neutral-200);
    border-radius: var(--radius-md, 0.375rem);
    background-color: var(--rl-neutral-100);
    color: var(--rl-neutral-950);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.25), 0 4px 6px -4px rgba(0, 0, 0, 0.15);
    padding: 0.25rem;
    margin-top: 0.25rem;
  }
  select.rl-select option {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border-radius: calc(var(--radius-md, 0.375rem) - 0.125rem);
    background-color: var(--rl-neutral-100);
    color: var(--rl-neutral-950);
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  select.rl-select .rl-select-item-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  select.rl-select option:hover,
  select.rl-select option:focus {
    background-color: var(--rl-neutral-200);
    color: var(--rl-neutral-950);
  }
  select.rl-select option:checked {
    background-color: var(--rl-primary-500);
    color: var(--rl-neutral-50);
    font-weight: 500;
  }
</style>

<script>
  document.addEventListener("change", (event) => {
    const target = event.target as HTMLSelectElement | null
    if (!target || target.dataset["slot"] !== "select") return
    const root = target.closest('[data-slot="root"]')
    const label = root?.querySelector('[data-slot="label"]')
    if (label) {
      label.textContent = target.options[target.selectedIndex]?.text ?? ""
    }
  })
</script>
