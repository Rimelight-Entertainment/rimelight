---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";
import IconSearch from "~icons/lucide/search";

type Props = Omit<HTMLAttributes<"input">, "type" | "autocomplete"> & {
  /**
   * The text to display when no results are found
   * @default "No results found."
   */
  emptyText?: string;
};

export const selectSearch = cv({
  base: [
    "placeholder:text-muted-foreground flex w-full border-0 bg-transparent px-0 py-2xl",
    "ring-0 outline-none disabled:cursor-not-allowed disabled:op-50",
  ],
});

const {
  class: className,
  placeholder = "Search...",
  emptyText = "No results found.",
  ...rest
} = Astro.props;
---

<div
  data-slot="select-search-wrapper"
  class="-mx-5xs -mt-5xs mb-5xs flex items-center gap-3xs border-b px-3xs"
>
  <slot name="icon">
    <IconSearch class="text-muted-foreground size-4.5 shrink-0" />
  </slot>
  <input
    type="text"
    class:list={[selectSearch(), className]}
    placeholder={placeholder}
    autocomplete="off"
    aria-label={placeholder}
    {...rest}
    data-slot="select-search"
  />
</div>

<div class="text-muted-foreground hidden py-6 text-center text-sm" data-slot="select-empty">
  <slot name="empty">{emptyText}</slot>
</div>
