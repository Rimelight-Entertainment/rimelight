---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

export const selectSeparator = cv({ base: "bg-muted -mx-5xs my-5xs h-6xs" });

const { class: className, ...rest } = Astro.props;
---

<div class:list={[selectSeparator(), className]} {...rest} data-slot="select-separator"></div>
