---
import type { ChipProps } from "./chip"
import { chipTheme } from "./chip.theme"



const {
  text,
  color = "primary",
  size = "md",
  position = "top-right",
  inset = false,
  standalone = false,
  show = true,
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChipProps



const classes = chipTheme({
  color: color as "neutral",
  size: size as "md",
  position: position as "top-right",
  inset,
  standalone,
  theme,
  ui: uiProp,
  class: className
})
---
{standalone ? (
  show && (
    <span class={classes.base} data-slot="base">
      <slot>{text}</slot>
    </span>
  )
) : (
  <div class={classes.root} data-slot="root" {...rest}>
    <slot />
    {show && (
      <span class={classes.base} data-slot="base">
        <slot name="content">{text}</slot>
      </span>
    )}
  </div>
)}