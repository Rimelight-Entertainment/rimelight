---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { ChipProps } from "./chip"
import chipThemeDefault, { createChipTheme } from "./chip.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const chipTheme = uiConfig.colors ? createChipTheme(uiConfig.colors) : chipThemeDefault

const chip = scv(chipTheme)

const {
  text,
  color = "primary",
  size = "md",
  position = "top-right",
  inset = false,
  standalone = false,
  show = true,
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ChipProps & {
  color?: string
  size?: "3xs" | "2xs" | "xs" | "sm" | "md" | "lg" | "xl" | "2xl" | "3xl"
  position?: "top-right" | "bottom-right" | "top-left" | "bottom-left"
  inset?: boolean
  standalone?: boolean
}

const classes = resolveClasses(chip, {
  color: color as "neutral",
  size: size as "md",
  position: position as "top-right",
  inset,
  standalone,
  theme
}, useUi("chip", uiProp), className)
---
{standalone ? (
  show && (
    <span class={classes.base} data-slot="base">
      <slot>{text}</slot>
    </span>
  )
) : (
  <div class={classes.root} data-slot="root" {...rest}>
    <slot />
    {show && (
      <span class={classes.base} data-slot="base">
        <slot name="content">{text}</slot>
      </span>
    )}
  </div>
)}