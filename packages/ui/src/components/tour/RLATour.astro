---
import type { TourProps } from "./tour"
import { tourTheme } from "./tour.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as TourProps

const classes = tourTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>