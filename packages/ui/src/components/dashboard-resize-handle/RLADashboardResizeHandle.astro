---
import type { HTMLTag } from "astro/types"
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { DashboardResizeHandleProps } from "./dashboard-resize-handle"
import dashboardResizeHandleTheme from "./dashboard-resize-handle.theme"

const dashboardResizeHandle = scv(dashboardResizeHandleTheme)

const {
  as: Tag = "div" as HTMLTag,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardResizeHandleProps & { as?: HTMLTag }

const classes = resolveClasses(dashboardResizeHandle, {}, useUi("dashboardResizeHandle", uiProp), className);
---
<Tag
  role="separator"
  data-slot="root"
  class={classes.root}
  {...rest}
>
  <slot />
</Tag>
