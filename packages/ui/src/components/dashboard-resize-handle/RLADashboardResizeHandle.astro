---
import type { HTMLTag } from "astro/types"
import type { DashboardResizeHandleProps } from "./dashboard-resize-handle"
import { dashboardResizeHandleTheme } from "./dashboard-resize-handle.theme"


const {
  as: Tag = "div" as HTMLTag,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardResizeHandleProps



const classes = dashboardResizeHandleTheme({
  ui: uiProp,
  class: className
});
---
<Tag
  role="separator"
  data-slot="root"
  class={classes.root}
  {...rest}
>
  <slot />
</Tag>
