---
import type { DashboardResizeHandleProps } from "./dashboard-resize-handle"
import { dashboardResizeHandleTheme } from "./dashboard-resize-handle.theme"


const {
  as: Tag = "div",
  ...rest
} = Astro.props as DashboardResizeHandleProps 



const classes = dashboardResizeHandleTheme(Astro.props);
---
<Tag
  data-slot="root"
  class={classes.root}
  {...({ role: "separator", ...rest } as any)}
>
  <slot />
</Tag>
