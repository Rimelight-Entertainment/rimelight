---
import type { PricingPlanProps } from "./pricing-plan"
import { pricingPlanTheme } from "./pricing-plan.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PricingPlanProps

const classes = pricingPlanTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>