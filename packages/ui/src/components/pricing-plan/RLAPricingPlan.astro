---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { PricingPlanProps } from "./pricing-plan"
import { pricingPlanTheme } from "./pricing-plan.theme"


const pricingPlan = scv(pricingPlanTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PricingPlanProps

const classes = resolveClasses(pricingPlan, {}, useUi("pricingPlan", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>