---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { AvatarGroupProps } from "./avatar-group"
import { resolveTheme } from "../../utils/resolveTheme"
import avatarGroupThemeDefault, { createAvatarGroupTheme } from "./avatar-group.theme"
const avatarGroupTheme = resolveTheme(avatarGroupThemeDefault, createAvatarGroupTheme)


const avatarGroup = scv(avatarGroupTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as AvatarGroupProps

const classes = resolveClasses(avatarGroup, {}, useUi("avatarGroup", uiProp), className)
---
<div class={classes.root} data-slot="avatar-group" {...rest}>
  <slot />
</div>
