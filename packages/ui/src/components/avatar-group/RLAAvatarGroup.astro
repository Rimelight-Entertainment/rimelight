---
import type { AvatarGroupProps } from "./avatar-group"
import { avatarGroupTheme } from "./avatar-group.theme"
import RLAAvatar from "../avatar/RLAAvatar.astro"

const {
  items,
  displayLimit = 5,
  size = "md",
  ...rest
} = Astro.props as AvatarGroupProps

const classes = avatarGroupTheme(Astro.props)

const sizeCls: Record<string, string> = {
  "3xs": "size-4 text-[7px]",
  "2xs": "size-5 text-[8px]",
  "xs": "size-6 text-[9px]",
  "sm": "size-7 text-[10px]",
  "md": "size-8 text-[11px]",
  "lg": "size-9 text-xs",
  "xl": "size-10 text-xs",
  "2xl": "size-11 text-sm",
  "3xl": "size-12 text-sm"
}

const normalizedItems = items ?? []
const renderedItems = normalizedItems.slice(0, displayLimit)
const hiddenCount = normalizedItems.length - displayLimit
---

{normalizedItems.length > 0 ? (
  <div class:list={[classes.root]} data-slot="avatar-group" {...rest}>
    {renderedItems.map((item) => (
      <span class="inline-flex shrink-0">
        <RLAAvatar
          src={item.src}
          alt={item.alt ?? ""}
          fallback={item.fallback}
          initials={item.initials}
          size={size}
          color={(item.color ?? "neutral") as any}
        />
      </span>
    ))}

    {hiddenCount > 0 && (
      <span
        class:list={[
          classes.more,
          sizeCls[size] ?? sizeCls["md"]
        ]}
        aria-hidden="true"
        data-slot="more"
      >
        +{hiddenCount}
      </span>
    )}
  </div>
) : (
  <div class={classes.root} data-slot="avatar-group" {...rest}>
    <slot />
  </div>
)}
