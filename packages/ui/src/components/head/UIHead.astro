---
import { ClientRouter } from 'astro:transitions';

export interface UIHeadProps {
  /** Whether to enable View Transitions (ClientRouter) */
  transitions?: boolean;
}

const {
  transitions = true
} = Astro.props as UIHeadProps;
---

<!-- Theme Mode Flash Prevention -->
<script>
  (function() {
    function getThemePreference() {
      var stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') return stored;
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function applyTheme(doc: any) {
      var pref = getThemePreference();
      doc.documentElement.setAttribute('data-theme', pref);
    }

    applyTheme(document);

    document.addEventListener('astro:before-swap', function(e: any) {
      applyTheme(e.newDocument);
    });

    document.addEventListener('astro:after-swap', function() {
      applyTheme(document);
    });
  })();
</script>

<!-- Header Stack Manager -->
<script>
  (function() {
    'use strict';

    const w = window as any;

    if (!w.RLHeaderStack) {
      w.RLHeaderStack = {
        layers: [] as any[],
        register: function(id: string, order: number, naturalHeight: number, isVisible: boolean, el: any, type?: string) {
          if (el && !el.isConnected) return;
          if (type === undefined) type = el && el.getAttribute ? (el.getAttribute('data-layer-type') || 'header') : 'header';
          let layer = this.layers.find(function(l: any) { return l.id === id; });
          if (!layer) {
            layer = { id: id, type: type, order: order, naturalHeight: naturalHeight, isVisible: isVisible, el: el };
            this.layers.push(layer);
            this.sortLayers();
          } else {
            layer.naturalHeight = naturalHeight;
            layer.isVisible = isVisible;
            layer.el = el;
          }
          if (el) {
            el.rlNaturalHeight = naturalHeight;
            el.rlIsVisible = isVisible;
          }
          this.update();
        },
        unregister: function(id: string) {
          const layer = this.layers.find(function(l: any) { return l.id === id; });
          if (layer && layer.el) {
            const el = layer.el as any;
            if (el.rlScrollListener) {
              window.removeEventListener('scroll', el.rlScrollListener);
            }
            if (el.rlResizeObserver) {
              el.rlResizeObserver.disconnect();
            }
          }
          this.layers = this.layers.filter(function(l: any) { return l.id !== id; });
          this.update();
        },
        sortLayers: function() {
          this.layers.sort(function(a: any, b: any) {
            if (a.type !== b.type) return a.type === 'banner' ? -1 : 1;
            return a.order - b.order;
          });
        },
        update: function() {
          let currentTop = 0;
          for (let i = 0; i < this.layers.length; i++) {
            const layer = this.layers[i];
            if (layer && layer.el) {
              const topPx = layer.isVisible ? currentTop + 'px' : '-' + layer.naturalHeight + 'px';
              layer.el.style.top = topPx;
              layer.el.dataset.topPx = topPx;
              if (layer.isVisible) {
                layer.el.classList.remove('opacity-0', '!pointer-events-none');
              } else {
                layer.el.classList.add('opacity-0', '!pointer-events-none');
              }
              document.documentElement.style.setProperty('--rl-header-bottom', 'calc(' + topPx + ' + ' + layer.naturalHeight + 'px)');
              if (layer.isVisible) currentTop += layer.naturalHeight;
            }
          }
          document.documentElement.style.setProperty('--rl-total-header-height', currentTop + 'px');
        }
      };
    }

    function getHeight(el: any): number {
      if (!el) return 64;
      const h = el.offsetHeight;
      return h > 0 ? h : 64;
    }

    function dismissBanner(banner: any) {
      var key = banner.getAttribute('data-dismiss-key');
      if (key) localStorage.setItem(key, 'true');
      banner.classList.add('hidden', '!pointer-events-none');
      banner.setAttribute('data-rla-banner', 'false');
      if (w.RLHeaderStack) w.RLHeaderStack.unregister(banner.id);
    }

    function checkDismissed() {
      var banners = document.querySelectorAll("[data-rla-banner='true']");
      for (var i = 0; i < banners.length; i++) {
        var b = banners[i];
        if (b) {
          var key = b.getAttribute('data-dismiss-key');
          if (key && localStorage.getItem(key) === 'true') {
            b.classList.add('hidden', '!pointer-events-none');
            b.setAttribute('data-rla-banner', 'false');
          }
        }
      }
    }

    function selector() {
      return "[data-rla-header='true'],[data-rla-banner='true']";
    }

    function initLayer(el: any) {
      const RL = w.RLHeaderStack;
      if (!RL) return;
      if (el.getAttribute('data-rla-banner') === 'false' || el.classList.contains('hidden')) {
        RL.unregister(el.id);
        return;
      }
      const id = el.id;
      const type = el.getAttribute('data-layer-type') || 'header';
      const stackIndex = parseInt(el.getAttribute('data-stack-index') || '0', 10);
      const hideOnScroll = el.getAttribute('data-hide-on-scroll') === 'true';
      const contentEl = el.querySelector('[data-header-content]');

      if (el.rlManaged) {
        const naturalHeight = el.rlNaturalHeight || getHeight(contentEl);
        const isVisible = el.rlIsVisible !== false;
        RL.register(id, stackIndex, naturalHeight, isVisible, el, type);
        return;
      }
      el.rlManaged = true;

      let naturalHeight = getHeight(contentEl);
      let isVisible = true;

      RL.register(id, stackIndex, naturalHeight, isVisible, el, type);

      if (typeof ResizeObserver !== 'undefined' && contentEl) {
        const ro = new ResizeObserver(function(entries) {
          if (!el.isConnected) {
            ro.disconnect();
            return;
          }
          const h = entries[0] && entries[0].contentRect.height;
          if (h && h > 0) {
            naturalHeight = h;
            RL.register(id, stackIndex, naturalHeight, isVisible, el, type);
          }
        });
        ro.observe(contentEl);
        el.rlResizeObserver = ro;
      }

      if (hideOnScroll) {
        let lastScrollY = window.scrollY;
        const scrollListener = function() {
          if (!el.isConnected) {
            window.removeEventListener('scroll', scrollListener);
            return;
          }
          const current = window.scrollY;
          const diff = current - lastScrollY;
          if (Math.abs(diff) >= 10) {
            const newVisible = current <= 50 ? true : diff <= 0;
            if (newVisible !== isVisible) {
              isVisible = newVisible;
              RL.register(id, stackIndex, naturalHeight, isVisible, el, type);
            }
            lastScrollY = current;
          }
        };
        el.rlScrollListener = scrollListener;
        window.addEventListener('scroll', scrollListener, { passive: true });
      }

      (function retry() {
        if (!el.isConnected) return;
        const h = getHeight(contentEl);
        if (h !== naturalHeight) {
          naturalHeight = h;
          RL.register(id, stackIndex, naturalHeight, isVisible, el, type);
        }
        if (h > 0 && h !== 64 && contentEl && contentEl.offsetHeight > 0) return;
        requestAnimationFrame(retry);
      })();
    }

    function startObserver() {
      if (document.body) {
        checkDismissed();
        const layers = document.querySelectorAll(selector());
        for (let i = 0; i < layers.length; i++) initLayer(layers[i]);

        w.rlHeaderObserver = new MutationObserver(function(mutations) {
          for (let i = 0; i < mutations.length; i++) {
            const added = mutations[i]?.addedNodes || [];
            for (let j = 0; j < added.length; j++) {
              const node = added[j] as any;
              if (!node || node.nodeType !== 1) continue;
              if (node.matches && node.matches(selector())) initLayer(node);
              if (node.querySelectorAll) {
                const nested = node.querySelectorAll(selector());
                for (let k = 0; k < nested.length; k++) initLayer(nested[k]);
              }
            }
            const removed = mutations[i]?.removedNodes || [];
            for (let j = 0; j < removed.length; j++) {
              const node = removed[j] as any;
              if (!node || node.nodeType !== 1) continue;
              if (node.matches && node.matches(selector()) && w.RLHeaderStack) w.RLHeaderStack.unregister(node.id);
              if (node.querySelectorAll) {
                const nested = node.querySelectorAll(selector());
                for (let k = 0; k < nested.length; k++) {
                  if (w.RLHeaderStack) w.RLHeaderStack.unregister(nested[k].id);
                }
              }
            }
          }
        });
        w.rlHeaderObserver.observe(document.body, { childList: true, subtree: true });
      } else {
        document.addEventListener('DOMContentLoaded', function() { startObserver(); });
      }
    }

    function setupStack() {
      if (w.rlHeaderObserver) {
        w.rlHeaderObserver.disconnect();
        w.rlHeaderObserver = null;
      }
      const RL = w.RLHeaderStack;
      if (RL) {
        RL.layers = [];
        RL.update();
      }
      startObserver();
    }

    if (!w.rlBannerInit) {
      w.rlBannerInit = true;
      document.addEventListener('click', function(e: any) {
        var btn = e.target?.closest?.('[data-banner-close]');
        if (!btn) return;
        var banner = btn.closest('[data-rla-banner]');
        if (!banner) return;
        dismissBanner(banner);
      });
    }

    document.addEventListener('astro:before-swap', function() {
      if (w.rlHeaderObserver) {
        w.rlHeaderObserver.disconnect();
        w.rlHeaderObserver = null;
      }
      if (w.RLHeaderStack) {
        w.RLHeaderStack.layers = [];
        w.RLHeaderStack.update();
      }
    });

    setupStack();
    document.addEventListener('astro:after-swap', setupStack);
  })();
</script>

{transitions && <ClientRouter />}
