---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { SpoilerProps } from "./spoiler"
import spoilerThemeDefault, { createSpoilerTheme } from "./spoiler.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const spoilerTheme = uiConfig.colors ? createSpoilerTheme() : spoilerThemeDefault

const spoiler = scv(spoilerTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SpoilerProps

const classes = resolveClasses(spoiler, {}, useUi("spoiler", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>