---
import type { SpoilerProps } from "./spoiler"
import { spoilerTheme } from "./spoiler.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SpoilerProps

const classes = spoilerTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>