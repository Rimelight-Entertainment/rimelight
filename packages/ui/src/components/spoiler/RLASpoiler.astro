---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { SpoilerProps } from "./spoiler"
import spoilerTheme from "./spoiler.theme"


const spoiler = scv(spoilerTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as SpoilerProps

const classes = resolveClasses(spoiler, {}, useUi("spoiler", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>