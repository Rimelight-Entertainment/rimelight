---
import type { DashboardToolbarProps } from "./dashboard-toolbar"
import { dashboardToolbarTheme } from "./dashboard-toolbar.theme"


const {
  as: Tag = "div",
  ...rest
} = Astro.props as DashboardToolbarProps 



const classes = dashboardToolbarTheme(Astro.props);
---
<Tag class={classes.root} data-slot="root" {...rest}>
  <slot>
    <div data-slot="left" class={classes.left}>
      <slot name="left" />
    </div>

    <div data-slot="right" class={classes.right}>
      <slot name="right" />
    </div>
  </slot>
</Tag>
