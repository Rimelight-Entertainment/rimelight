---
import type { HTMLTag } from "astro/types"
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { DashboardToolbarProps } from "./dashboard-toolbar"
import { dashboardToolbarTheme } from "./dashboard-toolbar.theme"

const dashboardToolbar = scv(dashboardToolbarTheme)

const {
  as: Tag = "div" as HTMLTag,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardToolbarProps & { as?: HTMLTag }

const classes = resolveClasses(dashboardToolbar, {}, useUi("dashboardToolbar", uiProp), className);
---
<Tag class={classes.root} data-slot="root" {...rest}>
  <slot>
    <div data-slot="left" class={classes.left}>
      <slot name="left" />
    </div>

    <div data-slot="right" class={classes.right}>
      <slot name="right" />
    </div>
  </slot>
</Tag>
