---
import type { CardProps } from "./card"
import { cardTheme } from "./card.theme"



const {
  title,
  description,
  mediaSrc,
  href,
  overlay = false,
  ...rest
} = Astro.props as CardProps

const classes = cardTheme({
  ...Astro.props,
  interactive: !!href
})

const Tag = href ? "a" : "div"
---
<Tag
  class={classes.root}
  data-slot="card-root"
  {...(Tag === "a" ? { href } : {})}
  {...(Tag === "a" ? { style: "text-decoration: none" } : {})}
  {...rest}
>
  <slot name="media">
    {mediaSrc && (
      <div class={classes.media} data-slot="media">
        <img src={mediaSrc} alt={title || ""} class="h-full w-full object-cover" />
      </div>
    )}
  </slot>

  {overlay ? (
    <div class={classes.overlay} data-slot="overlay">
      {title && <div class={classes.title} data-slot="title">{title}</div>}
      {description && <div class={classes.description} data-slot="description">{description}</div>}
      <slot />
    </div>
  ) : (
    <>
      <slot name="header">
        {(title || description || Astro.slots.has("title") || Astro.slots.has("description")) && (
          <div class={classes.header} data-slot="header">
            {title && <div class={classes.title} data-slot="title">{title}</div>}
            <slot name="title" />
            
            {description && <div class={classes.description} data-slot="description">{description}</div>}
            <slot name="description" />
          </div>
        )}
      </slot>

      {Astro.slots.has("default") && (
        <div class={classes.body} data-slot="body">
          <slot />
        </div>
      )}

      {Astro.slots.has("footer") && (
        <div class={classes.footer} data-slot="footer">
          <slot name="footer" />
        </div>
      )}
    </>
  )}
</Tag>
