---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

export const cardContent = cv({
  base: "px-xl group-data-[size=sm]/card:px-2xl",
});

const { class: className, ...rest } = Astro.props;
---

<div class:list={[cardContent(), className]} {...rest} data-slot="card-content">
  <slot />
</div>
