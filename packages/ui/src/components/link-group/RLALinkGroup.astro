---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { LinkGroupProps } from "./link-group"
import linkGroupTheme from "./link-group.theme"

import RLALink from "../link/RLALink.astro"


import RLAIcon from "../icon/RLAIcon.astro"


const linkGroup = scv(linkGroupTheme)

const {
  label: headingLabel,
  leadingIcon: headingLeadingIcon,
  trailingIcon: headingTrailingIcon,
  href: headingHref,
  links = [],
  theme,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as LinkGroupProps

const classes = resolveClasses(linkGroup, { theme }, useUi("linkGroup", uiProp), className);

const normalizedLinks = Array.isArray(links) ? links : [links];

const isPinnedDark = theme === "dark";
const overrideLinkClass = classes.link
    ? classes.link
        .split(" ")
        .map(cls => {
            if (!cls) return "";
            if (cls.includes(":")) {
                const parts = cls.split(":");
                const state = parts.slice(0, -1).join(":");
                const baseCls = parts[parts.length - 1];
                return `${state}:!${baseCls}`;
            }
            if (cls.startsWith("text-") && !isPinnedDark) {
                return cls;
            }
            return `!${cls}`;
        })
        .filter(Boolean)
        .join(" ")
    : "";
---
<div class={classes.root} data-slot="root" {...rest}>
  {headingLabel && (
    <h4 class={classes.title} data-slot="title">
      {headingHref ? (
        <a href={headingHref} class="hover:underline flex items-center gap-1.5">
          {headingLeadingIcon && <RLAIcon name={headingLeadingIcon} size="sm" />}
          <span>{headingLabel}</span>
          {headingTrailingIcon && <RLAIcon name={headingTrailingIcon} size="sm" />}
        </a>
      ) : (
        <span class="flex items-center gap-1.5">
          {headingLeadingIcon && <RLAIcon name={headingLeadingIcon} size="sm" />}
          <span>{headingLabel}</span>
          {headingTrailingIcon && <RLAIcon name={headingTrailingIcon} size="sm" />}
        </span>
      )}
    </h4>
  )}
  
  <ul class={classes.list} data-slot="list">
    <slot>
      {normalizedLinks.map((link) => (
        <li class={classes.item} data-slot="item">
          <RLALink
            theme={link.theme ?? theme}
            class:list={[overrideLinkClass, "w-full !justify-start"]}
            data-slot="link"
            {...link}
          />
        </li>
      ))}
    </slot>
  </ul>
</div>