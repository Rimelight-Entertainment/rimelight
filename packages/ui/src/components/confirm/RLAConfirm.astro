---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { ConfirmProps } from "./confirm"
import { confirmTheme } from "./confirm.theme"
import RLAButton from "../button/RLAButton.astro"

const alertDialog = scv(confirmTheme)

const {
  variant = "default",
  title,
  description,
  actionLabel = "Confirm",
  cancelLabel = "Cancel",
  triggerLabel,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ConfirmProps & { variant?: "default" | "destructive" }

const classes = resolveClasses(alertDialog, {
  variant
}, useUi("alertDialog", uiProp), className)

const dialogId = `rla-alert-dialog-${Math.random().toString(36).substring(2, 9)}`
const isDestructive = variant === "destructive"
---

<div class={classes.root} data-slot="alert-dialog-container">
  {triggerLabel ? (
    <RLAButton
      class={classes.trigger}
      data-slot="trigger"
      type="button"
      data-dialog-show={dialogId}
    >
      {triggerLabel}
    </RLAButton>
  ) : (
    <span data-dialog-show={dialogId}>
      <slot name="trigger" />
    </span>
  )}

  <dialog
    id={dialogId}
    class={classes.content}
    data-slot="content"
    data-lock-scroll="true"
    {...rest}
  >
    <div class={classes.header} data-slot="header">
      {title && <h3 class={classes.title} data-slot="title">{title}</h3>}
      <slot name="title" />
      
      {description && <p class={classes.description} data-slot="description">{description}</p>}
      <slot name="description" />
    </div>

    <slot />

    <div class={classes.footer} data-slot="footer">
      <slot name="footer">
        <RLAButton
          class={classes.cancelButton}
          data-slot="cancel"
          variant="outline"
          color={isDestructive ? "error" : "neutral"}
          type="button"
          data-dialog-close={dialogId}
        >
          {cancelLabel}
        </RLAButton>
        <RLAButton
          class={classes.actionButton}
          data-slot="action"
          color={isDestructive ? "error" : "primary"}
          variant={isDestructive ? "subtle" : "solid"}
          type="button"
          data-dialog-close={dialogId}
        >
          {actionLabel}
        </RLAButton>
      </slot>
    </div>
  </dialog>
</div>

<script>
(function() {
  const win = window as unknown as Window & { rlConfirm?: () => Promise<boolean> };
  if (win.rlConfirm) return;
  var pendingResolve: ((value: boolean) => void) | null = null;

  document.addEventListener("click", function(e) {
    const target = e.target as HTMLElement | null;
    var btn = target?.closest("[data-slot='cancel'], [data-slot='action']");
    if (!btn || !pendingResolve) return;
    pendingResolve(btn.getAttribute("data-slot") === "action");
    pendingResolve = null;
  }, true);

  win.rlConfirm = function() {
    return new Promise<boolean>(function(resolve) {
      var dialog = document.querySelector("[data-slot='alert-dialog-container'] dialog") as HTMLDialogElement | null;
      if (!dialog) { resolve(false); return; }
      pendingResolve = resolve;
      dialog.addEventListener("close", function() {
        if (pendingResolve) {
          pendingResolve(false);
          pendingResolve = null;
        }
      }, { once: true });
      dialog.showModal();
    });
  };
})();
</script>
