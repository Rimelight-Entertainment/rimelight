---
import { scv } from "css-variants"
import { useUi } from "../../utils/resolver"
import { resolveClasses } from "../../utils/resolver"
import type { ToastProps } from "./toast"
import { toastTheme } from "./toast.theme"

import RLAIcon from "../icon/RLAIcon.astro"

const toast = scv(toastTheme)

const {
  title,
  description,
  variant = "default",
  actionLabel,
  duration = 6000,
  color = "primary",
  ui: uiProp,
  class: className,
  dismissable = true,
  ...rest
} = Astro.props as ToastProps

const classes = resolveClasses(toast, {
  variant: ["success", "error", "warning", "info"].includes(variant ?? "") ? variant : "default"
}, useUi("toast", uiProp), className)

const variantIcons: Record<string, string> = {
  default: "bell",
  error: "circleX",
  success: "circleCheck",
  warning: "alertTriangle",
  info: "info",
}

const icon = variantIcons[variant] ?? variantIcons.default!
const isError = variant === "error"
---

<div
  class={classes.root}
  data-slot="root"
  data-toast
  data-duration={duration}
  data-dismissable={dismissable.toString()}
  role={isError ? "alert" : "status"}
  aria-live={isError ? "assertive" : "polite"}
  aria-atomic="true"
  tabindex="-1"
  {...rest}
>
  {/* Icon */}
  <RLAIcon name={icon} class="size-4 shrink-0 mt-0.5" aria-hidden="true" />

  {/* Text body */}
  <div class="flex flex-col gap-0.5 flex-1 min-w-0">
    {(title || Astro.slots.has("title")) && (
      <div class={classes.title} data-slot="title">
        <slot name="title">{title}</slot>
      </div>
    )}
    {(description || Astro.slots.has("description")) && (
      <div class={classes.description} data-slot="description">
        <slot name="description">{description}</slot>
      </div>
    )}
    <slot />
    {(Astro.slots.has("actions") || actionLabel) && (
      <div class="flex items-center justify-end gap-2 mt-3" data-slot="actions">
        <slot name="actions">
          {actionLabel && (
            <button
              type="button"
              class={classes.action}
              data-slot="action"
              data-toast-action
            >
              {actionLabel}
            </button>
          )}
        </slot>
      </div>
    )}
  </div>

  {/* Close button */}
  {dismissable !== false && (
    <button
      type="button"
      class={classes.close}
      data-slot="close"
      data-toast-close
      aria-label="Dismiss notification"
    >
      <RLAIcon name="close" class="size-3.5" aria-hidden="true" />
    </button>
  )}
</div>

<script>
  document.querySelectorAll("[data-toast]").forEach(toastEl => {
    const toast = toastEl as HTMLElement;
    const dismissable = toast.getAttribute("data-dismissable") !== "false";
    if (!dismissable) return;

    const close = toast.querySelector("[data-toast-close]");
    const duration = parseInt(toast.dataset.duration ?? "6000", 10);
    let timerId: ReturnType<typeof setTimeout> | null = null;
    let startTime = Date.now();
    let remaining = duration;

    const dismiss = () => {
      toast.classList.add("opacity-0", "translate-y-2", "pointer-events-none");
      toast.addEventListener("transitionend", () => toast.remove(), { once: true });
    };

    const startTimer = () => {
      if (duration > 0 && remaining > 0) {
        startTime = Date.now();
        timerId = setTimeout(dismiss, remaining);
      }
    };

    const pauseTimer = () => {
      if (timerId !== null) {
        clearTimeout(timerId);
        timerId = null;
        remaining -= Date.now() - startTime;
      }
    };

    // Auto-dismiss with pause on hover & focus
    if (duration > 0) {
      startTimer();
      toast.addEventListener("mouseenter", pauseTimer);
      toast.addEventListener("mouseleave", startTimer);
      toast.addEventListener("focusin", pauseTimer);
      toast.addEventListener("focusout", (e) => {
        if (!toast.contains(e.relatedTarget as Node)) {
          startTimer();
        }
      });
    }

    // Manual close
    close?.addEventListener("click", dismiss);
  });
</script>
