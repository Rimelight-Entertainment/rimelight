---
import type { DashboardNavbarProps } from "./dashboard-navbar"
import { dashboardNavbarTheme } from "./dashboard-navbar.theme"
import RLAIcon from "../icon/RLAIcon.astro"


const {
  as: Tag = "header",
  icon,
  title,
  toggle = true,
  toggleSide = "left",
  ...rest
} = Astro.props as DashboardNavbarProps 



const classes = dashboardNavbarTheme(Astro.props);
---

<Tag class={classes.root} data-slot="root" {...rest}>
  <div data-slot="left" class={classes.left}>
    {toggle && toggleSide === "left" && (
      <button type="button" data-dashboard-toggle="mobile" class={classes.toggle + " lg:hidden"} data-slot="toggle" aria-label="Toggle sidebar">
        <RLAIcon name="menu" class="size-5" />
      </button>
    )}

    <slot name="left">
      <slot name="leading">
        {icon && (
          <RLAIcon name={icon} class={classes.icon} data-slot="icon" />
        )}
      </slot>

      <h1 data-slot="title" class={classes.title}>
        <slot name="title">
          {title}
        </slot>
      </h1>

      <slot name="trailing" />
    </slot>
  </div>

  {Astro.slots.has("default") && (
    <div data-slot="center" class={classes.center}>
      <slot />
    </div>
  )}

  <div data-slot="right" class={classes.right}>
    <slot name="right" />

    {toggle && toggleSide === "right" && (
      <button type="button" data-dashboard-toggle="mobile" class={classes.toggle + " lg:hidden"} data-slot="toggle" aria-label="Toggle sidebar">
        <RLAIcon name="menu" class="size-5" />
      </button>
    )}
  </div>
</Tag>
