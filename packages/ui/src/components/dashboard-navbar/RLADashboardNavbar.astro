---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { DashboardNavbarProps } from "./dashboard-navbar"
import dashboardNavbarTheme from "./dashboard-navbar.theme"


const dashboardNavbar = scv(dashboardNavbarTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardNavbarProps

const classes = resolveClasses(dashboardNavbar, {}, useUi("dashboardNavbar", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>