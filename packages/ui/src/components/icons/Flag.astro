---
import IconGlobe from "~icons/lucide/globe"
import FlagUS from "~icons/flag/us-4x3"
import FlagDE from "~icons/flag/de-4x3"
import FlagES from "~icons/flag/es-4x3"
import FlagJP from "~icons/flag/jp-4x3"
import FlagBR from "~icons/flag/br-4x3"

import type { FlagCode } from '../../domain/i18n/flags'

const FLAG_COMPONENTS: Record<string, any> = {
  // Legacy short codes
  us: FlagUS,
  de: FlagDE,
  es: FlagES,
  jp: FlagJP,
  br: FlagBR,

  // Full library codes
  'us-4x3': FlagUS,
  'de-4x3': FlagDE,
  'es-4x3': FlagES,
  'jp-4x3': FlagJP,
  'br-4x3': FlagBR,
}

export interface FlagProps {
  code: FlagCode | string | null;
  size?: number;
  title?: string;
  class?: string;
  [key: string]: any;
}
type Props = FlagProps;

const { code, size = 16, title, class: className, ...rest } = Astro.props
const Svg = code ? FLAG_COMPONENTS[code] : undefined
---

{
  Svg ? (
    <Svg
      width={size}
      height={size}
      class={className}
      aria-hidden={title ? 'false' : 'true'}
      role={title ? 'img' : 'presentation'}
      {...rest}
    >
      {title && <title>{title}</title>}
    </Svg>
  ) : (
    <IconGlobe
      width={size}
      height={size}
      aria-hidden={title ? undefined : true}
      role={title ? 'img' : 'presentation'}
      class={className}
      {...rest}
    />
  )
}
