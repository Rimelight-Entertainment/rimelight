---
import { scv } from "css-variants"
import { useUi, resolveClasses } from "../../utils"
import type { UserProps } from "./user"
import userThemeDefault, { createUserTheme } from "./user.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const userTheme = uiConfig.colors ? createUserTheme() : userThemeDefault

const user = scv(userTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as UserProps

const classes = resolveClasses(user, {}, useUi("user", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>