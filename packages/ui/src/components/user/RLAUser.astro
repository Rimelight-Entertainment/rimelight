---
import type { UserProps } from "./user"
import { userTheme } from "./user.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as UserProps

const classes = userTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>