---
import type { ProseProps } from "./prose"
import { proseTheme } from "./prose.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as ProseProps

const classes = proseTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>