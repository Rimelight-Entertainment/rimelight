---
import type { HTMLTag } from "astro/types"
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { DashboardGroupProps } from "./dashboard-group"
import dashboardGroupTheme from "./dashboard-group.theme"

const dashboardGroup = scv(dashboardGroupTheme)

const {
  as: Tag = "div" as HTMLTag,
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as DashboardGroupProps & { as?: HTMLTag }

const classes = resolveClasses(dashboardGroup, {}, useUi("dashboardGroup", uiProp), className);
---
<Tag class={classes.root} data-slot="root" {...rest}>
  <slot />
</Tag>
