---
import type { PageAsideProps } from "./page-aside"
import { pageAsideTheme } from "./page-aside.theme"



const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PageAsideProps

const classes = pageAsideTheme({
  ui: uiProp,
  class: className
});
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>