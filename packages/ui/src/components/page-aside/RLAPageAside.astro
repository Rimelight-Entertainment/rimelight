---
import { scv } from "css-variants"
import { useUi } from "../../utils/useUi"
import { resolveClasses } from "../../utils/resolveClasses"
import type { PageAsideProps } from "./page-aside"
import pageAsideThemeDefault, { createPageAsideTheme } from "./page-aside.theme"
import { getUIConfig } from "virtual:rimelight-ui"

const uiConfig = getUIConfig()
const pageAsideTheme = uiConfig.colors ? createPageAsideTheme() : pageAsideThemeDefault

const pageAside = scv(pageAsideTheme)

const {
  ui: uiProp,
  class: className,
  ...rest
} = Astro.props as PageAsideProps

const classes = resolveClasses(pageAside, {}, useUi("pageAside", uiProp), className);
---
<div class={classes.root} data-slot="root" {...rest}>
  <slot />
</div>