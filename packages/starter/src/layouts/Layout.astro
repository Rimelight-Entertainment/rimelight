---
import RLAHead from "@rimelight/ui/components/astro/RLAHead.astro"
import RLAApp from "@rimelight/ui/components/astro/RLAApp.astro"
import RLAMain from "@rimelight/ui/components/astro/RLAMain.astro"

interface Props {
  title?: string
  description?: string
}

const { title = "Rimelight Project", description = "Scaffolded with Rimelight CLI" } = Astro.props

const siteConfig = {
  name: "Rimelight App",
  description: description,
  branding: {
    favicon: { svg: "/favicon.svg" }
  }
}
---

<!doctype html>
<html lang="en">
  <RLAHead title={title} description={description} config={siteConfig}>
    <slot name="head" slot="head" />
  </RLAHead>
  <body class="bg-gray-50 dark:bg-zinc-950 text-gray-900 dark:text-zinc-50 antialiased min-h-screen">
    <RLAApp>
      <RLAMain>
        <slot />
      </RLAMain>
    </RLAApp>
  </body>
</html>
