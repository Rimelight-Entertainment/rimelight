---
import RLAHeader from "@rimelight/ui/components/astro/RLAHeader.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLANavigationMenu from "@rimelight/ui/components/astro/RLANavigationMenu.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLASlideover from "@rimelight/ui/components/astro/RLASlideover.astro";
import type { NavigationMenuItem, ButtonProps, LinkGroupProps } from "@rimelight/ui/types";
import RLALinkGroup from "@rimelight/ui/components/astro/RLALinkGroup.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n } from "astro-nanostores-i18n:runtime";
import placeholderImage from "../../assets/placeholder.webp";

const activeLocale = Astro.currentLocale ?? "en";

const messages = useI18n("app_header", {
	"links_home_label": "Home",
  "links_features_label": "Features",
  "links_about_label": "About",
  "links_blog_label": "Blog",
	"links_docs_label": "Docs",
  "links_dashboard_label": "Dashboard",
  "links_github_label": "View on GitHub",
  "links_use-template_label": "Use Template",
  "link-groups_foundations_label": "Foundation",
  "link-groups_foundations_links_tokens": "Design Tokens",
  "link-groups_foundations_links_colors": "Color Palettes",
  "link-groups_foundations_links_typography": "Fluid Typography",
  "link-groups_components_label": "Components",
  "link-groups_components_links_astro": "Astro Elements",
  "link-groups_components_links_vue": "Vue Components",
  "link-groups_components_links_integrations": "Integrations",
  "link-groups_resources_label": "Resources",
  "link-groups_resources_links_docs": "Documentation",
  "link-groups_resources_links_github": "GitHub Repository"
});

const items: NavigationMenuItem[] = [
  {
    label: messages["links_features_label"],
    to: getRelativeLocaleUrl(activeLocale, '/features'),
    slot: "features" as const,
    children: [
      { label: "Foundation", description: "Design tokens, color palettes, fluid typography." },
      { label: "Components", description: "Astro and Vue library elements." },
      { label: "Integrations", description: "Vite hooks, PostCSS, Lunaria, Knip." }
    ]
  },
  {
    label: messages["links_about_label"],
    to: getRelativeLocaleUrl(activeLocale, '/about')
  },
  {
    label: messages["links_blog_label"],
    to: getRelativeLocaleUrl(activeLocale, '/blog')
  },
  {
    label: messages["links_docs_label"],
    to: getRelativeLocaleUrl(activeLocale, '/docs')
  },
  {
    label: messages["links_dashboard_label"],
    to: getRelativeLocaleUrl(activeLocale, '/dashboard')
  },
];

const actions: ButtonProps[] = [
  {
    color: "neutral",
    variant: "outline",
    leadingIcon: "i-logos-github-icon?mask text-[var(--rl-text)] group-hover:text-[var(--rl-text-hover)]",
    label: messages["links_github_label"],
    to: "https://github.com/Rimelight-Entertainment/rimelight"
  },
  {
    label: messages["links_use-template_label"],
    to: getRelativeLocaleUrl(activeLocale, '/docs/usage')
  }
];

const foundationGroup: LinkGroupProps = {
  label: messages["link-groups_foundations_label"],
  leadingIcon: "i-lucide-layout size-4",
  links: [
    { label: messages["link-groups_foundations_links_tokens"], href: "/features/tokens" },
    { label: messages["link-groups_foundations_links_colors"], href: "/features/colors" },
    { label: messages["link-groups_foundations_links_typography"], href: "/features/typography" }
  ]
};

const componentsGroup: LinkGroupProps = {
  label: messages["link-groups_components_label"],
  leadingIcon: "i-lucide-blocks size-4",
  links: [
    { label: messages["link-groups_components_links_astro"], href: "/features/astro" },
    { label: messages["link-groups_components_links_vue"], href: "/features/vue" },
    { label: messages["link-groups_components_links_integrations"], href: "/features/integrations" }
  ]
};

const resourcesGroup: LinkGroupProps = {
  label: messages["link-groups_resources_label"],
  leadingIcon: "i-lucide-library size-4",
  links: [
    { label: messages["link-groups_resources_links_docs"], href: "/docs", leadingIcon: "i-lucide-file-text size-4" },
    { label: messages["link-groups_resources_links_github"], href: "https://github.com/Rimelight-Entertainment/rimelight", leadingIcon: "i-logos-github-icon size-4" }
  ]
};
---

<RLAHeader
  contain={false}
  fixed={true}
  class="scroll-header bg-black left-1/2 -translate-x-1/2 duration-300">
  <div slot="left" class="flex items-center gap-md">
    <div class="hidden md:flex flex-row gap-md">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="white"
      />
    </div>

    <div class="block md:hidden">
      <RLASlideover side="left" title="Menu">
        <RLAButton
          slot="trigger"
          color="neutral"
          variant="ghost"
          rounded={true}
          leadingIcon="i-lucide-menu"
          aria-label="Open Menu"
        />

        <RLANavigationMenu
          items={items}
          orientation="vertical"
          variant="link"
          ui={{
            link: "text-black dark:text-white flex justify-start items-center w-full text-left py-2 text-lg transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400"
          }}
        >
          <!-- Features Mega Menu (Mobile/Vertical) -->
          <div slot="features-content" class="flex flex-col lg:flex-row gap-lg bg-white dark:bg-neutral-900 w-full text-black dark:text-white">
            <div class="flex flex-col lg:flex-row gap-lg p-lg flex-1">
              <img
                class="h-32 lg:h-full w-full lg:w-auto object-cover lg:max-w-80 shrink-0 rounded"
                src={placeholderImage.src}
              />

              <div class="flex flex-col gap-sm flex-2">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-xl gap-y-4">
                  <RLALinkGroup {...foundationGroup} ui={{ title: "!text-primary-500" }} />
                  <RLALinkGroup {...componentsGroup} ui={{ title: "!text-primary-500" }} />
                </div>
              </div>
            </div>

            <div class="p-lg bg-neutral-100 dark:bg-neutral-800 w-64 shrink-0">
              <RLALinkGroup {...resourcesGroup} ui={{ title: "!text-primary-500" }} />
            </div>
          </div>
        </RLANavigationMenu>
      </RLASlideover>
    </div>
  </div>

  <div slot="center" class="flex items-center gap-md">
    <div class="hidden md:block">
      <RLANavigationMenu
        items={items}
        variant="link"
        theme="flat"
        ui={{
          viewportWrapper: 'top-[var(--rl-total-header-height,64px)] flex justify-center fixed left-0 right-0 z-[150] mt-0 bg-transparent',
          viewport: 'w-full rounded-none border-none shadow-xl mt-0 pointer-events-auto overflow-hidden',
          link: "text-white transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400"
        }}
      >
        <!-- Features Mega Menu -->
        <div slot="features-content" class="flex flex-col lg:flex-row gap-lg bg-white dark:bg-neutral-900 w-full text-black dark:text-white">
          <div class="flex flex-col lg:flex-row gap-lg p-lg flex-1">
            <img
              class="h-32 lg:h-full w-full lg:w-auto object-cover lg:max-w-80 shrink-0 rounded"
              src={placeholderImage.src}
            />

            <div class="flex flex-col gap-sm flex-2">
              <RLALinkGroup {...foundationGroup} ui={{ title: "!text-primary-500" }} />
              <RLALinkGroup {...componentsGroup} ui={{ title: "!text-primary-500" }} />
            </div>
          </div>

          <div class="p-lg bg-neutral-100 dark:bg-neutral-800 w-64 shrink-0">
            <RLALinkGroup {...resourcesGroup} ui={{ title: "!text-primary-500" }} />
          </div>
        </div>
      </RLANavigationMenu>
    </div>

    <div class="block md:hidden">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="white"
      />
    </div>
  </div>

  <div slot="right" class="flex items-center gap-md">
    <div class="hidden md:flex flex-row gap-md">
      {actions.map((buttonProps) => (
        <RLAButton {...buttonProps} />
      ))}
    </div>

    <div class="block md:hidden">
      <RLASlideover side="right" title="Actions">
        <RLAButton
          slot="trigger"
          color="neutral"
          variant="ghost"
          rounded={true}
          leadingIcon="i-ellipsis-vertical"
          aria-label="Open Actions"
        />

        <div class="flex flex-col gap-md">
          {actions.map((buttonProps) => (
            <RLAButton {...buttonProps} block={true} />
          ))}
        </div>
      </RLASlideover>
    </div>
  </div>
</RLAHeader>

<style is:global>
  @property --viewport-margin {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  @property --viewport-radius {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  @keyframes shrinkHeader {
    from {
      margin-top: 0;
      width: 100%;
      max-width: 100%;
    }
    to {
      margin-top: 16px;
      width: calc(100% - 32px);
      border-radius: 9999px;
    }
  }

  @keyframes shrinkViewport {
    from {
      --viewport-margin: 0px;
      --viewport-radius: 0px;
      width: 100%;
      max-width: 100%;
    }
    to {
      --viewport-margin: 12px;
      --viewport-radius: 16px;
      width: calc(100% - 32px);
    }
  }

  .scroll-header {
    animation: shrinkHeader linear both;
    animation-timeline: scroll(root);
    animation-range: 0 90px;
  }

  /* Starter override: Mega menu transitions on scroll */
  html [data-nav-viewport] {
    margin-top: var(--viewport-margin, 0px) !important;
    border-radius: var(--viewport-radius, 0px) !important;
    animation: shrinkViewport linear both;
    animation-timeline: scroll(root);
    animation-range: 0 90px;
  }

  /* Vertical mega menu content static override */
  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] {
    position: static !important;
    width: 100% !important;
    max-width: 100% !important;
    transform: none !important;
    box-shadow: none !important;
    border: none !important;
    background: transparent !important;
    padding: 8px 0 0 0 !important;
    display: block !important;
  }

  html [data-nav-menu][data-orientation="vertical"] [data-nav-content].hidden {
    display: none !important;
  }

  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] [slot="features-content"] {
    background: transparent !important;
    padding: 0 !important;
    width: 100% !important;
  }

  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] .p-lg,
  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] .p-xl {
    padding: 12px 4px !important;
  }

  html [data-nav-menu][data-orientation="vertical"] [data-nav-content] .w-64 {
    width: 100% !important;
    background: transparent !important;
    padding: 12px 4px !important;
  }
</style>
