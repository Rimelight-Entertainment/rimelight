---
import AppLayout from "@/layouts/AppLayout.astro";
// import { siteConfig } from "@/site.config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";

const activeLocale = Astro.currentLocale ?? "en";
currentLocale.set(activeLocale);

const messages = useI18n("testsLogoPage", {
  title: "Logo Component Test",
  description: "Testing RLALogo auto mode detection and theme override",
  heading: "Logo Component Test"
});
---

<AppLayout title={messages.title} description={messages.description}>
  <div class="max-w-2xl mx-auto px-4 py-xl space-y-lg">
    <a href={getRelativeLocaleUrl(activeLocale, "/tests")} class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary-500 mb-4">
      <span class="i-lucide-arrow-left"></span>
      Back to Tests
    </a>
    <h1 class="text-3xl font-bold">{messages.heading}</h1>
    <p class="text-muted-foreground mb-4">{messages.description}</p>

    <div class="grid gap-md">
      <section class="border border-border rounded-xl p-6">
        <h2 class="text-lg font-semibold mb-2">Auto mode (no mode prop)</h2>
        <p class="text-sm text-muted-foreground mb-4">Should be black in light mode, white in dark mode</p>
        <div class="flex items-center justify-center p-8 border border-dashed border-border rounded-lg bg-neutral-100 dark:bg-neutral-900">
          <RLALogo variant="logomark" class="h-16 w-auto" />
        </div>
      </section>

      <section class="border border-border rounded-xl p-6">
        <h2 class="text-lg font-semibold mb-2">Forced white mode</h2>
        <p class="text-sm text-muted-foreground mb-4">Should always be white regardless of color scheme</p>
        <div class="flex items-center justify-center p-8 border border-dashed border-border rounded-lg bg-neutral-900">
          <RLALogo variant="logomark" class="h-16 w-auto" mode="white" />
        </div>
      </section>

      <section class="border border-border rounded-xl p-6">
        <h2 class="text-lg font-semibold mb-2">Forced black mode</h2>
        <p class="text-sm text-muted-foreground mb-4">Should always be black regardless of color scheme</p>
        <div class="flex items-center justify-center p-8 border border-dashed border-border rounded-lg bg-neutral-100">
          <RLALogo variant="logomark" class="h-16 w-auto" mode="black" />
        </div>
      </section>

      <section class="border border-border rounded-xl p-6 bg-black">
        <h2 class="text-lg font-semibold mb-2 text-white">Flat theme on dark bg</h2>
        <p class="text-sm text-muted-foreground mb-4">theme="flat" — should stay at configured flat (or color/default) regardless of mode</p>
        <div class="flex items-center justify-center p-8 border border-dashed border-white/20 rounded-lg bg-black/50">
          <RLALogo variant="logomark" class="h-16 w-auto" theme="flat" />
        </div>
      </section>
    </div>
  </div>
</AppLayout>
