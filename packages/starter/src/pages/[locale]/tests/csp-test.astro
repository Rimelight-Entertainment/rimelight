---
import AppLayout from "@/layouts/AppLayout.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { currentLocale } from "astro-nanostores-i18n:runtime";
import { Code } from "astro-expressive-code/components";

const activeLocale = Astro.currentLocale ?? "en";
currentLocale.set(activeLocale);

const title = "Expressive Code CSP Verification Suite";
const description = "Verify Shiki + Expressive Code CSP compliance in Rimelight playground";

const jsCode = `// This sample verifies frame creation, line highlight, and variable highlighting
function calculateTotal(subtotal, tax) {
  const total = subtotal * (1 + tax);
  return total;
}
console.log(calculateTotal(100, 0.08));`;

const cssCode = `@media (prefers-color-scheme: dark) {
  body {
    background-color: var(--shiki-background);
    color: var(--shiki-foreground);
  }
}`;
---

<AppLayout title={title} description={description}>
  <div class="max-w-2xl mx-auto px-4 py-xl space-y-lg">
    <a href={getRelativeLocaleUrl(activeLocale, "/tests")} class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary-500 mb-4">
      <span class="i-lucide-arrow-left"></span>
      Back to Tests
    </a>

    <h1 class="text-3xl font-bold">Expressive Code + Shiki CSP Diagnostic Page</h1>
    <p class="text-muted-foreground">Use this page to verify compliance with strict <code>style-src 'self'</code> layers.</p>

    <h2 class="text-xl font-semibold mt-6 mb-2">Test Block 1: Basic JavaScript Code Block</h2>
    <div class="not-prose">
      <Code code={jsCode} lang="javascript" title="src/utils/math.js" mark={[{ range: '3' }]} />
    </div>

    <h2 class="text-xl font-semibold mt-6 mb-2">Test Block 2: CSS Token Diagnostics</h2>
    <div class="not-prose">
      <Code code={cssCode} lang="css" title="src/styles/theme.css" />
    </div>

    <div class="mt-8 p-6 border border-border rounded-xl bg-dimmed">
      <h3 class="text-lg font-semibold mb-2">Automated Integration Check List</h3>
      <ul class="list-disc pl-5 space-y-2 text-sm text-muted-foreground">
        <li><strong>Terminal Chrome Check:</strong> Does the code block render wrapped inside a terminal chrome display containing a tab called <code>src/utils/math.js</code>? If missing, layout styles are being blocked.</li>
        <li><strong>Syntax Highlighting Check:</strong> Are keywords like <code>function</code> and strings colored? If they render default white/black, the CSS tokens or attributes are failing validation.</li>
        <li><strong>Line Highlighting Check:</strong> Is line 3 of the JavaScript sample distinctively highlighted?</li>
        <li><strong>Browser Console Audit:</strong> Open DevTools (F12) and inspect the <strong>Console</strong>. Confirm there are exactly <strong>zero</strong> exceptions originating from <code>Content Security Policy directive: "style-src..."</code>.</li>
      </ul>
    </div>
  </div>
</AppLayout>
