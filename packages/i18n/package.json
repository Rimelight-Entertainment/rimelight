{
  "name": "@rimelight/i18n",
  "version": "0.0.10",
  "private": false,
  "description": "Rimelight Entertainment's Internationalization Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./hono": {
      "types": "./dist/hono.d.mts",
      "import": "./dist/hono.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "import": "./dist/utils.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm run build",
    "check": "vp check --fix"
  },
  "dependencies": {
    "@nanostores/i18n": "1.3.3",
    "nanostores": "1.5.3"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26.8.2"
  },
  "packageManager": "pnpm@12.4.1"
}
