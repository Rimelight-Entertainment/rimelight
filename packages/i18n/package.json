{
  "name": "@rimelight/i18n",
  "version": "0.0.4",
  "private": false,
  "description": "Rimelight Entertainment's Internationalization Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./integration": "./src/integration.ts",
    "./middleware": "./src/middleware.ts",
    "./runtime": "./src/runtime.ts",
    "./types": "./src/types.ts",
    "./utils": "./src/utils.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "pnpm audit --audit-level=moderate && vp check --fix"
  },
  "dependencies": {
    "@nanostores/i18n": "1.3.3",
    "nanostores": "1.5.1"
  },
  "devDependencies": {
    "astro": "7.2.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.7.0"
  }
}
