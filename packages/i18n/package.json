{
  "name": "@rimelight/i18n",
  "version": "0.0.7",
  "private": false,
  "description": "Rimelight Entertainment's Internationalization Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./integration": {
      "types": "./dist/integration.d.mts",
      "import": "./dist/integration.mjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.mts",
      "import": "./dist/middleware.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    },
    "./utils": {
      "types": "./dist/utils.d.mts",
      "import": "./dist/utils.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm run build",
    "check": "vp check --fix"
  },
  "dependencies": {
    "@nanostores/i18n": "1.3.3",
    "nanostores": "1.5.3"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*",
    "astro": "7.3.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "packageManager": "pnpm@12.3.4"
