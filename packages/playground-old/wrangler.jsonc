{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playground-dot-rimelight-dot-com",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  //  "routes": [
  //    {
  //      "pattern": "playground.rimelight.com",
  //      "custom_domain": true
  //    },
  //    {
  //      "pattern": "www.playground.rimelight.com",
  //      "custom_domain": true
  //    }
  //  ],
  "browser": {
    "binding": "BROWSER"
  },
  "ratelimits": [
    {
      "namespace_id": "1001",
      "name": "RATE_LIMITER",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
