---
import Head from '@rimelight/ui/components/Head.astro';
import AppHeader from '../components/app/AppHeader.astro';
import { astroI18n } from 'astro-i18n';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang={astroI18n.locale}>
  <head>
    <Head />
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #ffffff;
        --surface: #f9fafb;
        --border: #e5e7eb;
        --text: #111827;
        --muted: #6b7280;
        --accent: #3b82f6;
      }
      .dark {
        --bg: #030712;
        --surface: #111827;
        --border: #1f2937;
        --text: #f9fafb;
        --muted: #9ca3af;
        --accent: #3b82f6;
      }
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--text);
        margin: 0;
        line-height: 1.5;
        font-feature-settings: "cv02", "cv05", "cv11";
      }
      .playground-container {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
      }
      a {
        color: var(--accent);
        text-decoration: none;
      }
      h1 { 
        margin-bottom: 0.25rem;
        font-size: 2.25rem;
        font-weight: 800;
        letter-spacing: -0.025em;
      }
      .subtitle { color: var(--muted); margin-bottom: 2rem; }
      h2 {
        color: var(--text);
        border-bottom: 1px solid var(--border);
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
        margin-top: 2rem;
        font-size: 1.5rem;
        font-weight: 700;
      }
      h3 {
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
        font-size: 1rem;
        color: var(--muted);
        font-weight: 600;
      }
      section { margin-bottom: 3rem; }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }
      .item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
        background: var(--surface);
        padding: 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .item:hover {
        border-color: var(--accent);
        background: var(--border);
        transform: translateY(-2px);
      }
      .item code {
        font-size: 0.75rem;
        color: var(--accent);
        background: rgba(59, 130, 246, 0.1);
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
      }
      .matrix-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0.5rem;
      }
      .matrix-table th,
      .matrix-table td {
        padding: 1rem;
        text-align: center;
        border: 1px solid var(--border);
      }
      .matrix-table th {
        background: var(--surface);
        font-size: 0.8rem;
        text-transform: capitalize;
        color: var(--muted);
      }
      .matrix-table td {
        min-width: 160px;
      }
      .matrix-table th:first-child {
        text-align: left;
        min-width: 100px;
        color: var(--text);
      }
      .side-by-side {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }
      .side-by-side > div h3 {
        color: var(--text);
        font-size: 1.125rem;
        margin-bottom: 1rem;
      }
      @media (max-width: 768px) {
        .side-by-side { grid-template-columns: 1fr; }
        .matrix-table { font-size: 0.85rem; }
      }
    </style>
  </head>
  <body>
    <AppHeader />
    
    <main class="playground-container">
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>
