---
import AppLayout from '../../layouts/AppLayout.astro';

import RLAButton from '@rimelight/ui/components/astro/RLAButton.astro';
import RLVButton from '@rimelight/ui/components/vue/RLVButton.vue';

const variants = ["solid", "outlined", "subtle", "ghost", "link"] as const;
const colors = ["primary", "secondary", "info", "success", "warning", "error", "commentary", "ideation", "source"] as const;
const sizes = ["xs", "sm", "md", "lg", "xl"] as const;
---

<AppLayout title="Button Showcase — Rimelight UI">
  <p class="subtitle"><code>RLAButton</code> (Astro) vs <code>RLVButton</code> (Vue) — same props, same output.</p>

  <div class="tabs" id="btn-tabs">
    <button class="tab active" data-tab="astro" onclick="switchTab('btn-tabs','astro')">Astro</button>
    <button class="tab" data-tab="vue" onclick="switchTab('btn-tabs','vue')">Vue</button>
  </div>

  <!-- Astro Tab -->
  <div class="tab-panel active" id="btn-tabs-astro">
    <div class="column">
      <h3>Variants × Colors</h3>
      <div class="variant-grid">
        <div class="variant-header">
          <span class="variant-label"></span>
          {colors.map(c => <span class="variant-header-label">{c}</span>)}
        </div>
        {variants.map(v => (
          <div class="variant-row">
            <span class="variant-label">{v}</span>
            {colors.map(c => (
              <div class="variant-cell">
                <RLAButton variant={v} color={c}>{c}</RLAButton>
              </div>
            ))}
          </div>
        ))}
      </div>

      <h3>Sizes</h3>
      <div class="sizes-row">
        {sizes.map(s => (
          <RLAButton size={s}>{s}</RLAButton>
        ))}
      </div>

      <h3>Props & Overrides</h3>
      <div class="props-grid">
        <span class="prop-label">href</span>
        <div><RLAButton href="#">Link</RLAButton></div>
        <span class="prop-label">class="rounded-full"</span>
        <div><RLAButton class="rounded-full">Round</RLAButton></div>
        <span class="prop-label">ui override</span>
        <div><RLAButton ui={{ base: 'bg-orange-500 hover:bg-orange-600' }}>Custom</RLAButton></div>
        <span class="prop-label">disabled</span>
        <div><RLAButton disabled>Disabled</RLAButton></div>
      </div>
    </div>
  </div>

  <!-- Vue Tab -->
  <div class="tab-panel" id="btn-tabs-vue">
    <div class="column">
      <h3>Variants × Colors</h3>
      <div class="variant-grid">
        <div class="variant-header">
          <span class="variant-label"></span>
          {colors.map(c => <span class="variant-header-label">{c}</span>)}
        </div>
        {variants.map(v => (
          <div class="variant-row">
            <span class="variant-label">{v}</span>
            {colors.map(c => (
              <div class="variant-cell">
                <RLVButton client:visible variant={v} color={c}>{c}</RLVButton>
              </div>
            ))}
          </div>
        ))}
      </div>

      <h3>Sizes</h3>
      <div class="sizes-row">
        {sizes.map(s => (
          <RLVButton client:visible size={s}>{s}</RLVButton>
        ))}
      </div>

      <h3>Props & Overrides</h3>
      <div class="props-grid">
        <span class="prop-label">href</span>
        <div><RLVButton client:visible href="#">Link</RLVButton></div>
        <span class="prop-label">class="rounded-full"</span>
        <div><RLVButton client:visible class="rounded-full">Round</RLVButton></div>
        <span class="prop-label">ui override</span>
        <div><RLVButton client:visible ui={{ base: 'bg-purple-500 hover:bg-purple-600' }}>Custom</RLVButton></div>
        <span class="prop-label">disabled</span>
        <div><RLVButton client:visible disabled>Disabled</RLVButton></div>
      </div>
    </div>
  </div>
</AppLayout>

<style>
  .tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0;
  }
  .tab {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .tab:hover { color: var(--text); }
  .tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  .column {
    background: var(--surface, #1e293b);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    overflow-x: auto;
  }
  .column h3 {
    color: #e2e8f0;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  /* Variant grid — table-like with equal columns */
  .variant-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .variant-header,
  .variant-row {
    display: grid;
    grid-template-columns: 80px repeat(9, 1fr);
    align-items: center;
    gap: 0.5rem;
  }
  .variant-header {
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
    margin-bottom: 0.25rem;
  }
  .variant-header-label {
    font-size: 0.7rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }
  .variant-label {
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: capitalize;
    font-weight: 600;
  }
  .variant-cell {
    display: flex;
    justify-content: center;
    padding: 0.25rem 0;
  }

  /* Sizes row */
  .sizes-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Props grid — fixed label column, buttons at natural width */
  .props-grid {
    display: grid;
    grid-template-columns: 140px 1fr;
    align-items: center;
    gap: 0.5rem;
  }
  .prop-label {
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: capitalize;
    font-weight: 600;
  }
</style>

<script is:inline>
  function switchTab(groupId, tabId) {
    const group = document.getElementById(groupId);
    if (!group) return;
    const container = group.closest('body > *') || group.parentElement;
    group.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    group.querySelector(`[data-tab="${tabId}"]`).classList.add('active');
    document.querySelectorAll(`[id^="${groupId}-"]`).forEach(p => {
      p.classList.remove('active');
    });
    document.getElementById(`${groupId}-${tabId}`).classList.add('active');
  }
</script>
