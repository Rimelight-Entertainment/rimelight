---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = HTMLAttributes<"tbody"> & VariantProps<typeof tableBody>;

export const tableBody = cv({
  base: "[&_tr:last-child]:border-0",
});

const { class: className, ...rest } = Astro.props;
---

<tbody class:list={[tableBody(), className]} {...rest} data-slot="table-body">
  <slot />
</tbody>
