---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = HTMLAttributes<"thead"> & VariantProps<typeof tableHeader>;

export const tableHeader = cv({
  base: "[&_tr]:border-b",
});

const { class: className, ...rest } = Astro.props;
---

<thead class:list={[tableHeader(), className]} {...rest} data-slot="table-header">
  <slot />
</thead>
