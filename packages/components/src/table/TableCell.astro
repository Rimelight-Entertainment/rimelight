---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = HTMLAttributes<"td"> & VariantProps<typeof tableCell>;

export const tableCell = cv({
  base: "p-5xs align-middle ws-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-6xs",
});

const { class: className, ...rest } = Astro.props;
---

<td class:list={[tableCell(), className]} {...rest} data-slot="table-cell">
  <slot />
</td>
