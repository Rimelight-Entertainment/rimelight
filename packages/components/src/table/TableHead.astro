---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = HTMLAttributes<"th"> & VariantProps<typeof tableHead>;

export const tableHead = cv({
  base: "text-muted-foreground h-2xs px-5xs text-left align-middle font-medium ws-nowrap [&:has([role=checkbox])]:pr-0 [&>[role=checkbox]]:translate-y-6xs",
});

const { class: className, ...rest } = Astro.props;
---

<th class:list={[tableHead(), className]} {...rest} data-slot="table-head">
  <slot />
</th>
