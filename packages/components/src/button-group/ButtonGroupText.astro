---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

export const buttonGroupText = cv({
  base: [
    "bg-muted flex items-center gap-md rounded-md b px-4 text-sm font-medium shadow-xs",
    "[&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4",
  ],
});

const { class: className, ...rest } = Astro.props;
---

<div class:list={[buttonGroupText(), className]} {...rest} data-slot="button-group-text">
  <slot />
</div>
