---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

export const alertDialogHeader = cv({ base: "flex flex-col gap-3xs text-center sm:text-left" });

const { class: className, ...rest } = Astro.props;
---

<div class:list={[alertDialogHeader(), className]} {...rest} data-slot="alert-dialog-header">
  <slot />
</div>
