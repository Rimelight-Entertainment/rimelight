---
import type { ComponentProps } from "astro/types";
import { cv } from "css-variants";

// eslint-disable-next-line typescript/consistent-type-imports
import Separator from "@/separator/Separator.astro";

type Props = ComponentProps<typeof Separator>;

export const itemSeparator = cv({
  base: "my-0",
});

const { class: className, orientation = "horizontal", ...rest } = Astro.props;
---

<Separator
  orientation={orientation}
  class:list={[itemSeparator(), className]}
  {...rest}
  data-slot="item-separator"
/>

