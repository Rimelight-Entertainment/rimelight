---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

export const itemTitle = cv({
  base: "flex w-fit items-center gap-md leading-snug font-medium",
});

const { class: className, ...rest } = Astro.props;
---

<div class:list={[itemTitle(), className]} {...rest} data-slot="item-title">
  <slot />
</div>
