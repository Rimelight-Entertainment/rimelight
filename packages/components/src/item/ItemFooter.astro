---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

export const itemFooter = cv({
  base: "flex basis-full items-center justify-between gap-3xs",
});

const { class: className, ...rest } = Astro.props;
---

<div class:list={[itemFooter(), className]} {...rest} data-slot="item-footer">
  <slot />
</div>
