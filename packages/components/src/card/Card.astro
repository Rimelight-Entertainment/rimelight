---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = HTMLAttributes<"div"> & VariantProps<typeof card>;

export const card = cv({
  base: [
    "bg-card text-card-foreground group/card ring-border flex flex-col rounded-xl ring-1",
    "has-data-[slot=card-footer]:pb-0 has-[>img:first-child]:pt-0",
    "*:[img:first-child]:rounded-t-xl *:[img:last-child]:rounded-b-xl",
  ],
  variants: {
    size: {
      default: "gap-xl py-xl",
      sm: "gap-2xl py-2xl text-sm",
    },
  },
  defaultVariants: {
    size: "default",
  },
});

const { class: className, size, ...rest } = Astro.props;
---

<div
  class:list={[card({ size }), className]}
  data-size={size ?? "default"}
  {...rest}
  data-slot="card"
>
  <slot />
</div>
