---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = HTMLAttributes<"input"> & VariantProps<typeof input>;

export const input = cv({
  base: [
    "border-input dark:bg-input/30 text-foreground w-full rounded-md b bg-transparent shadow-xs",
    "focus-visible:border-outline focus-visible:ring-outline/50 transition-[color,box-shadow] focus-visible:ring-3",
    "file:text-foreground file:my-auto file:mr-3xs file:h-full file:border-0 file:bg-transparent file:text-sm file:font-medium",
    "disabled:cursor-not-allowed disabled:op-50",
    "aria-invalid:border-error aria-invalid:focus-visible:ring-error/40",
    "peer placeholder:text-muted-foreground",
  ],
  variants: {
    size: { sm: "h-2xl px-3xs text-sm", md: "h-3xl px-xs text-base", lg: "h-3xl px-2xl text-lg" },
  },
  defaultVariants: { size: "md" },
});

const { size, class: className, ...rest } = Astro.props;
---

<input class:list={[input({ size }), className]} {...rest} data-slot="input" />
