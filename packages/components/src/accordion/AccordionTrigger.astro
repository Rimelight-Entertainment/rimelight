---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";
import IconChevronDown from "~icons/lucide/chevron-down";

export interface AccordionTriggerProps extends HTMLAttributes<"button"> {}
type Props = AccordionTriggerProps;

export const accordionTrigger = cv({
  base: [
    "starwind-accordion-trigger",
    "flex w-full items-center justify-between gap-2xl rounded-md py-2xl",
    "hover:text-muted-foreground text-left font-medium transition-all",
    "[&[data-state=open]>svg]:rotate-180",
    "focus-visible:border-outline focus-visible:ring-outline/50 outline-none focus-visible:ring-3",
  ],
});

const { class: className, ...rest } = Astro.props;
---

<button
  type="button"
  class:list={[accordionTrigger(), className]}
  aria-expanded="false"
  {...rest}
  data-slot="accordion-trigger"
>
  <slot />
  <slot name="icon">
    <IconChevronDown class="size-5 shrink-0 transition-transform duration-200" />
  </slot>
</button>
