---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

export interface SidebarGroupLabelProps extends HTMLAttributes<"div"> {
  /**
   * Render as a child element wrapper instead of a div
   */
  asChild?: boolean;
}


export const sidebarGroupLabel = cv({
  base: [
    "text-sidebar-foreground/70 ring-sidebar-outline",
    "flex h-3xl shrink-0 items-center rounded-md px-2 text-sm font-medium",
    "outline-hidden transition-[margin,opacity] duration-200 ease-linear",
    "focus-visible:ring-2",
    "[&>svg]:size-4.5 [&>svg]:shrink-0",
    "group-data-[collapsible=icon]:-mt-10 group-data-[collapsible=icon]:op-0",
  ],
});

const { asChild = false, class: className, ...rest } = Astro.props;

let hasChildren = false;
if (Astro.slots.has("default")) {
  hasChildren = true;
}
---

{
  asChild && hasChildren ? (
    <div
      class:list={[sidebarGroupLabel(), className]}
      data-sidebar="group-label"
      data-as-child
      {...rest}
      data-slot="sidebar-group-label"
    >
      <slot />
    </div>
  ) : (
    <div
      class:list={[sidebarGroupLabel(), className]}
      data-sidebar="group-label"
      {...rest}
      data-slot="sidebar-group-label"
    >
      <slot />
    </div>
  )
}
