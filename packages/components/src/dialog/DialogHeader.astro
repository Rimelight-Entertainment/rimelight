---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

export const dialogHeader = cv({ base: "flex flex-col space-y-2 text-center sm:text-left" });

const { class: className, ...rest } = Astro.props;
---

<div class:list={[dialogHeader(), className]} {...rest} data-slot="dialog-header">
  <slot />
</div>
