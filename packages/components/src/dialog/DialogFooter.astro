---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

export const dialogFooter = cv({ base: "flex flex-col-reverse gap-3xs sm:flex-row sm:justify-end" });

const { class: className, ...rest } = Astro.props;
---

<div class:list={[dialogFooter(), className]} {...rest} data-slot="dialog-footer">
  <slot />
</div>
