---
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";
import Prose from "@rimelight/components/prose/Prose.astro";
import TableOfContents from "@rimelight/components/TableOfContents.astro";

export interface BlogProps extends HTMLAttributes<"article"> {
  /** Blog post title */
  title: string;
  /** Brief description or abstract */
  description?: string | undefined;
  /** Publication date string */
  publishedDate?: string | undefined;
  /** Last updated date string */
  updatedDate?: string | undefined;
  /** Hero image metadata */
  heroImage?: any | undefined;
  /** Label for published date */
  publishedLabel?: string;
  /** Label for updated date */
  updatedLabel?: string;
  /** Page headings for TOC */
  headings?: any[] | undefined;
}

type Props = BlogProps;

const sectionStyles = cv({
  base: "@container mx-auto w-full max-w-5xl px-4 py-24",
});

const { title, description, publishedDate, updatedDate, heroImage, headings, publishedLabel = "Published", updatedLabel = "Last Updated", class: className, ...rest } = Astro.props;
---

<article class:list={[sectionStyles(), className]} {...rest}>
  <!-- Hero Image -->
  {
    heroImage && (
      <div class="mb-4xl overflow-hidden rounded-3xl ring-1 ring-border shadow-2xl">
        <Image
          width={1020}
          height={510}
          src={heroImage}
          alt={title}
          class="aspect-video w-full object-cover"
        />
      </div>
    )
  }

  <!-- Header -->
  <header class="mx-auto max-w-2xl text-center">
    <h1 class="font-heading text-4xl font-bold tracking-tight @xl:text-5xl @3xl:text-6xl text-pretty">
      {title}
    </h1>

    <p class="text-muted-foreground mt-2xl text-xl text-pretty">
      {description}
    </p>

    {
      publishedDate && (
        <div class="text-muted-foreground mt-2xl flex items-center justify-center gap-3xs text-sm">
          <span>{publishedLabel}</span>
          <time datetime={publishedDate}>{publishedDate}</time>
          {
            updatedDate && (
              <>
                <span class="text-border">&middot;</span>
                <span>
                  {updatedLabel} <time datetime={updatedDate}>{updatedDate}</time>
                </span>
              </>
            )
          }
        </div>
      )
    }
  </header>

  <!-- Content & TOC -->
  <div class="mt-5xl flex flex-col lg:flex-row gap-4xl items-start">
    <div class="flex-1 min-w-0 w-full">
      <Prose class="max-w-none markdown-content">
        <slot />
      </Prose>
    </div>

    {
      headings && headings.length > 0 && (
        <aside class="hidden lg:block w-72 h-fit shrink-0 sticky top-6xl">
          <TableOfContents headings={headings} levels={3} />
        </aside>
      )
    }
  </div>
</article>

