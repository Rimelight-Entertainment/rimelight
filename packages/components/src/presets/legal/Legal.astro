---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

import Prose from "@rimelight/components/prose/Prose.astro";
import TableOfContents from "@rimelight/components/TableOfContents.astro";

export interface LegalProps extends HTMLAttributes<"article"> {
  /** Legal page title */
  title: string;
  /** Brief description or subtitle */
  description?: string | undefined;
  /** Publication date string */
  publishedDate?: string | undefined;
  /** Last updated date string */
  updatedDate?: string | undefined;
  /** Page headings for TOC */
  headings?: any[] | undefined;
}

type Props = LegalProps;

const sectionStyles = cv({
  base: "@container mx-auto w-full max-w-5xl px-4 py-24",
});

const { title, description, publishedDate, updatedDate, headings, class: className, ...rest } = Astro.props;
---

<article class:list={[sectionStyles(), className]} {...rest}>
  <!-- Header -->
  <header class="mx-auto max-w-2xl text-center">
    <h1 class="font-heading text-3xl font-bold tracking-tight @xl:text-4xl @3xl:text-5xl">
      {title}
    </h1>

    <p class="text-muted-foreground mt-4 text-lg text-pretty">
      {description}
    </p>

    {
      publishedDate && (
        <div class="text-muted-foreground mt-4 flex items-center justify-center gap-1.5 text-sm">
          <span>Published</span>
          <time datetime={publishedDate}>{publishedDate}</time>
          {
            updatedDate && (
              <>
                <span>&middot;</span>
                <span>
                  Last Updated <time datetime={updatedDate}>{updatedDate}</time>
                </span>
              </>
            )
          }
        </div>
      )
    }
  </header>

  <!-- Content & TOC -->
  <div class="mt-12 flex flex-col lg:flex-row gap-12 items-start">
    <div class="flex-1 min-w-0 w-full">
      <Prose class="max-w-none markdown-content">
        <slot />
      </Prose>
    </div>

    {
      headings && headings.length > 0 && (
        <aside class="hidden lg:block w-72 h-fit shrink-0 sticky top-24">
          <TableOfContents headings={headings} levels={3} />
        </aside>
      )
    }
  </div>
</article>

