---
import type { HTMLAttributes } from "astro/types";
import { scv } from "css-variants";
import Card from "@/card/Card.astro";
import CardContent from "@/card/CardContent.astro";
import Avatar from "@/avatar/Avatar.astro";
import AvatarFallback from "@/avatar/AvatarFallback.astro";
import AvatarImage from "@/avatar/AvatarImage.astro";

import type { ImageMetadata } from "astro";

export interface Testimonial {
  quote: string;
  avatar: string | ImageMetadata;
  name: string;
  badge: string;
}

export interface TestimonialsProps extends HTMLAttributes<"div">, NonNullable<Parameters<typeof testimonialsVariants>[0]> {
  items: Testimonial[];
}

type Props = TestimonialsProps;

const testimonialsVariants = scv({
  slots: ["root", "grid", "card", "content", "quote", "person", "meta"],
  base: {
    root: "w-full",
    grid: "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4xl",
    card: "flex flex-col bg-card/50 backdrop-blur-sm transition-colors hover:bg-card",
    content: "flex flex-col flex-1 gap-4xl p-4xl",
    quote: "text-muted-foreground leading-relaxed flex-1 italic text-pretty",
    person: "flex gap-2xl",
    meta: "flex flex-col min-w-0",
  },
  variants: {
    alignment: {
      left: {
        quote: "text-left",
        person: "flex-row items-center justify-start",
        meta: "text-left items-start",
      },
      center: {
        quote: "text-center",
        person: "flex-col items-center justify-center text-center",
        meta: "items-center",
      },
      right: {
        quote: "text-right",
        person: "flex-row-reverse items-center justify-end",
        meta: "text-right items-end",
      },
    },
  },
  defaultVariants: {
    alignment: "center",
  },
});

const { items, alignment, class: className, ...rest } = Astro.props;
const styles = testimonialsVariants({ alignment });
---

<div class:list={[styles.root, className]} {...rest}>
  <div class={styles.grid}>
    {
      items.map(({ quote, avatar, name, badge }) => (
        <Card class={styles.card}>
          <CardContent class={styles.content}>
            <blockquote class={styles.quote}>"{quote}"</blockquote>

            <div class={styles.person}>
              <Avatar class="w-3xl h-3xl border">
                {typeof avatar === "string" ? (
                  <AvatarImage src={avatar} alt={name} />
                ) : (
                  <AvatarImage image={avatar} alt={name} />
                )}
                <AvatarFallback class="bg-primary/10 text-primary">
                  {name[0]}
                </AvatarFallback>
              </Avatar>
              <div class={styles.meta}>
                <span class="font-medium truncate text-foreground">{name}</span>
                <span class="text-xs text-muted-foreground truncate uppercase tracking-wider">
                  {badge}
                </span>
              </div>
            </div>
          </CardContent>
        </Card>
      ))
    }
  </div>
</div>

