---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

interface Props extends Omit<HTMLAttributes<"div">, "id" | "role" | "tabindex" | "hidden"> {
  value: string;
}

export const tabsContent = cv({
  base: "mt-3xs focus-visible:outline-2 focus-visible:outline-offset-2",
});

const { value, class: className, ...rest } = Astro.props;
---

<div
  class:list={[tabsContent(), className]}
  data-tabs-content
  data-value={value}
  data-state="inactive"
  role="tabpanel"
  tabindex="0"
  hidden
  {...rest}
  data-slot="tabs-content"
>
  <slot />
</div>
