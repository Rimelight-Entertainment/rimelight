---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = HTMLAttributes<"tfoot"> & VariantProps<typeof tableFoot>;

export const tableFoot = cv({
  base: "bg-muted/50 border-t font-medium [&>tr]:last:border-b-0",
});

const { class: className, ...rest } = Astro.props;
---

<tfoot class:list={[tableFoot(), className]} {...rest} data-slot="table-foot">
  <slot />
</tfoot>
