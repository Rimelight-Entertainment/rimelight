---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = HTMLAttributes<"caption"> & VariantProps<typeof tableCaption>;

export const tableCaption = cv({
  base: "text-muted-foreground mt-2xl text-sm",
});

const { class: className, ...rest } = Astro.props;
---

<caption class:list={[tableCaption(), className]} {...rest} data-slot="table-caption">
  <slot />
</caption>
