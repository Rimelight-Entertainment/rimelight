---
import type { ComponentProps } from "astro/types";
import { cv } from "css-variants";

// eslint-disable-next-line typescript/consistent-type-imports
import Button from "@rimelight/components/button/Button.astro";

export interface SidebarMenuActionProps extends ComponentProps<typeof Button> {
  /**
   * When true, shows the action only when the menu item is hovered
   * @default false
   */
  showOnHover?: boolean;
}

type Props = SidebarMenuActionProps;

export const sidebarMenuAction = cv({
  base: [
    "text-sidebar-foreground ring-sidebar-outline",
    "absolute top-xs right-2xs flex aspect-square w-2xs items-center justify-center rounded-md p-0",
    "outline-hidden transition-transform",
    "hover:bg-sidebar-accent hover:text-sidebar-accent-foreground",
    "peer-hover/menu-button:text-sidebar-accent-foreground",
    "[&>svg]:size-4 [&>svg]:shrink-0",
    "after:absolute after:-inset-2 md:after:hidden",
    "peer-data-[size=sm]/menu-button:top-2xs",
    "peer-data-[size=default]/menu-button:top-xs",
    "peer-data-[size=lg]/menu-button:top-sm",
    "group-data-[collapsible=icon]:hidden",
  ],
  variants: {
    showOnHover: {
      true: [
        "peer-data-[active=true]/menu-button:text-sidebar-accent-foreground",
        "group-focus-within/menu-item:op-100 group-hover/menu-item:op-100",
        "data-[state=open]:op-100",
        "md:op-0",
      ],
    },
  },
});

const {
  showOnHover = false,
  variant = "ghost",
  size = "icon-sm",
  class: className,
  ...rest
} = Astro.props;
---

<Button
  variant={variant}
  size={size}
  class:list={[sidebarMenuAction({ showOnHover }), className]}
  data-sidebar="menu-action"
  {...rest}
  data-slot="sidebar-menu-action"
>
  <slot />
</Button>

