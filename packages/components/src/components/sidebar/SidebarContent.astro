---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

export interface SidebarContentProps extends HTMLAttributes<"div"> {}
type Props = SidebarContentProps;

export const sidebarContent = cv({
  base: [
    "flex min-h-0 flex-1 flex-col gap-5xs overflow-auto",
    "group-data-[collapsible=icon]:overflow-hidden",
  ],
});

const { class: className, ...rest } = Astro.props;
---

<div
  class:list={[sidebarContent(), className]}
  data-sidebar="content"
  {...rest}
  data-slot="sidebar-content"
>
  <slot />
</div>
