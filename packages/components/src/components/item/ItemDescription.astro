---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"p">;

export const itemDescription = cv({
  base: [
    "text-muted-foreground line-clamp-2 leading-snug font-normal text-balance",
    "[&>a:hover]:text-primary [&>a]:underline [&>a]:underline-offset-4",
  ],
});

const { class: className, ...rest } = Astro.props;
---

<p class:list={[itemDescription(), className]} {...rest} data-slot="item-description">
  <slot />
</p>
