---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div"> & {
  /**
   * The orientation of the separator.
   * @default "vertical"
   */
  orientation?: "horizontal" | "vertical";
};

export const buttonGroupSeparator = cv({
  base: ["bg-input relative m-0! self-stretch data-[orientation=vertical]:h-auto"],
});

const { class: className, orientation = "vertical", ...rest } = Astro.props;
---

<div class:list={[buttonGroupSeparator(), className]} {...rest} data-slot="button-group-separator"></div>
