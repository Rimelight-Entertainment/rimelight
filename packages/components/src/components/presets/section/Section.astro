---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

import type { button } from "@rimelight/components/button/Button.astro";
import Button from "@rimelight/components/button/Button.astro";



export interface SectionAction {
  text: string;
  href: string;
  variant?: NonNullable<Parameters<typeof button>[0]>["variant"];
  icon?: any;
}

export interface SectionProps extends HTMLAttributes<"section">, NonNullable<Parameters<typeof sectionVariants>[0]> {
  /** Main title text */
  title?: string;
  /** Description text */
  description?: string;
  /** Action buttons */
  actions?: SectionAction[];
}

type Props = SectionProps;

const sectionVariants = cv({
  base: "container py-5xl",

  variants: {
    orientation: {
      vertical: "flex flex-col gap-4xl",
      horizontal: "flex flex-col gap-3xl items-center lg:grid lg:grid-cols-2 lg:items-center lg:gap-5xl",
    },
    alignment: {
      left: "text-start items-start",
      center: "text-center items-center",
      right: "text-end items-end",
    },
    inverted: {
      true: "",
      false: "",
    },
  },
  compoundVariants: [
    {
      orientation: "vertical",
      inverted: true,
      className: "flex-col-reverse",
    },
    {
      orientation: "vertical",
      inverted: false,
      className: "flex-col",
    },
    {
      orientation: "horizontal",
      inverted: false,
      className: "lg:[&_.section-content]:order-1 lg:[&_.section-image]:order-2",
    },
    {
      orientation: "horizontal",
      inverted: true,
      className: "lg:[&_.section-image]:order-1 lg:[&_.section-content]:order-2",
    },
    {
      orientation: "horizontal",
      className: "[&_.section-content]:text-start [&_.section-content]:items-start lg:text-start lg:items-start",
    },
  ],
  defaultVariants: {
    orientation: "vertical",
    alignment: "center",
    inverted: false,
  },
});

const {
  title,
  description,
  actions = [],
  orientation = "vertical",
  alignment = "center",
  inverted = false,
  class: className,
  ...rest
} = Astro.props;

const effectiveAlignment = orientation === "horizontal" ? "left" : alignment;
---

<section class="relative w-full overflow-hidden" {...rest}>
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <slot name="bg" />
  </div>

  <div class:list={[sectionVariants({ orientation, alignment, inverted }), className]}>
    <div
      class:list={[
        "section-content flex flex-col w-full",
        orientation === "vertical" && [
          effectiveAlignment === "center" && "mx-auto",
          effectiveAlignment === "left" && "mr-auto",
          effectiveAlignment === "right" && "ml-auto",
        ],
        effectiveAlignment === "center" && "text-center items-center",
        effectiveAlignment === "left" && "text-start items-start",
        effectiveAlignment === "right" && "text-end items-end",
      ]}
      data-slot="content"
    >
      {
        title && (
          <h2 class="font-heading text-4xl font-bold tracking-tight text-pretty lg:text-5xl xl:text-6xl">
            {title}
          </h2>
        )
      }
      {
        description && (
          <p class="text-muted-foreground mt-2xl text-pretty lg:text-lg">
            {description}
          </p>
        )
      }
      {
        actions.length > 0 && (
          <div
            class:list={[
              "mt-3xl flex w-full flex-wrap gap-3xs md:w-fit",
              effectiveAlignment === "center" && "justify-center mx-auto",
              effectiveAlignment === "left" && "justify-start",
              effectiveAlignment === "right" && "justify-end md:ml-auto",
            ]}
          >
            {actions.map(({ text, href, variant, icon: Icon }) => (
              <Button variant={variant} class="group w-full md:w-auto" href={href}>
                {text}
                {Icon && (
                  <Icon class="transition-transform group-hover:translate-x-5xs" />
                )}
              </Button>
            ))}
          </div>
        )
      }
    </div>

    <div class="section-image w-full">
      <slot />
    </div>

    {Astro.slots.has("image") && (
      <div 
        class:list={[
          "section-image w-full flex",
          effectiveAlignment === "center" && "justify-center",
          effectiveAlignment === "left" && "justify-start",
          effectiveAlignment === "right" && "justify-end",
        ]} 
        data-slot="image"
      >
        <slot name="image" />
      </div>
    )}
  </div>
</section>

