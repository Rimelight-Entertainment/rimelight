---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import Button from "@rimelight/components/button/Button.astro";
import Progress from "@rimelight/components/progress/Progress.astro";
import Separator from "@rimelight/components/separator/Separator.astro";
import Prose from "@rimelight/components/prose/Prose.astro";

import avatarAsset from "@rimelight/components/assets/team/Daniel-Marchi_0000_00.webp";
import Image from "@rimelight/components/image/Image.astro";

import MdiInstagram from "~icons/mdi/instagram";
import MdiLinkedin from "~icons/mdi/linkedin";
import MdiGithub from "~icons/mdi/github";
import IconMapPin from "~icons/lucide/map-pin";
import IconUser from "~icons/lucide/user";
import IconLanguages from "~icons/lucide/languages";
import IconDownload from "~icons/lucide/download";

const iconMap: Record<string, any> = {
  instagram: MdiInstagram,
  linkedin: MdiLinkedin,
  github: MdiGithub,
};

export interface ResumeProps {
  resume: CollectionEntry<"resume">;
}

type Props = ResumeProps;

const { resume } = Astro.props;
const { data } = resume;
const { uiLocale: currentLocale } = Astro.locals;
const socialLinks = await getCollection("socialLinks");

const { sidebar, hero, sections } = data;
const t = sidebar.labels;

const getLanguageLevel = (progress: number) => {
  if (progress >= 75) return t.native;
  if (progress >= 50) return t.professional;
  if (progress >= 25) return t.basic;
  return t.learning;
};

const calculateAge = (dobString?: string) => {
  if (!dobString) return 0;
  const dob = new Date(dobString);
  const today = new Date();
  let age = today.getFullYear() - dob.getFullYear();
  const m = today.getMonth() - dob.getMonth();
  if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) {
    age--;
  }
  return age;
};

const age = calculateAge(sidebar.dateOfBirth);
---

<div class="container py-5xl sm:py-6xl lg:py-6xl">
  <div class="grid grid-cols-1 gap-3xl lg:grid-cols-10">
    <!-- Sidebar -->
    <aside class="order-first lg:col-span-3">
      <div class="flex flex-col gap-4xl">
        <div class="flex flex-col items-center gap-xl text-center">
          <Image
            src={avatarAsset}
            alt="Daniel Marchi"
            class="rounded-full ring-4 ring-primary ring-offset-4 ring-offset-background h-6xl w-6xl object-cover"
          />

          <div class="flex flex-col gap-2xs">
            <h2 class="text-2xl font-bold">{hero.title || "Daniel Marchi"}</h2>
            <div class="flex items-center justify-center gap-3xs">
              {socialLinks.map(({ data }: any) => {
                const Icon = iconMap[data.icon];
                if (!Icon) return null;
                return (
                  <Button
                    href={data.url}
                    variant="ghost"
                    size="sm"
                    aria-label={data.label}
                    class="h-9 w-9"
                  >
                    <Icon class="h-5 w-5" />
                  </Button>
                );
              })}
            </div>
          </div>

          <div class="flex flex-col w-full gap-3xs">
            {sidebar.location && (
              <Button
                href={sidebar.locationLink || "#"}
                variant="ghost"
                class="w-full h-auto py-2 whitespace-normal"
              >
                <IconMapPin class="mr-2 h-4 w-4 shrink-0" />
                <span class="text-sm">{sidebar.location}</span>
              </Button>
            )}

            {sidebar.availability && (
              <Button
                href={`/${currentLocale}/contact`}
                variant="ghost"
                class="w-full h-auto py-2 text-success hover:bg-success/10 hover:text-success whitespace-normal"
              >
                <span class="relative mr-2 flex h-2 w-2">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-75"></span>
                  <span class="relative inline-flex h-2 w-2 rounded-full bg-success"></span>
                </span>
                <span class="text-sm font-medium">{sidebar.availability}</span>
              </Button>
            )}
          </div>
        </div>

        {sidebar.about && (
          <div class="flex flex-col gap-2xs">
            <div class="flex items-center gap-2xs text-primary">
              <IconUser class="h-4 w-4" />
              <h3 class="text-sm font-semibold uppercase tracking-wider">{t.about}</h3>
            </div>
            <Separator />
            <dl class="flex flex-col gap-2xs">
              {sidebar.about.fields.map((field: any) => (
                <div class="flex justify-between text-sm">
                  <dt class="font-medium text-muted-foreground">{field.label}</dt>
                  <dd>{field.value}</dd>
                </div>
              ))}
              <div class="flex justify-between text-sm">
                <dt class="font-medium text-muted-foreground">{t.age}:</dt>
                <dd>{age}</dd>
              </div>
            </dl>
          </div>
        )}

        {sidebar.languages && (
          <div class="flex flex-col gap-2xs">
            <div class="flex items-center gap-2xs text-primary">
              <IconLanguages class="h-4 w-4" />
              <h3 class="text-sm font-semibold uppercase tracking-wider">{t.languages}</h3>
            </div>
            <Separator />
            <div class="flex flex-col gap-2xs">
              {sidebar.languages.map((lang: any) => (
                <div class="flex flex-col gap-2xs">
                  <div class="flex items-center justify-between text-sm">
                    <span class="font-medium">{lang.name}</span>
                    <span class="text-muted-foreground text-xs">{getLanguageLevel(lang.progress)}</span>
                  </div>
                  <Progress value={lang.progress} class="h-1" variant="primary" />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </aside>

    <!-- Main Content -->
    <main class="lg:col-span-7 lg:order-last flex flex-col gap-4xl">
      <!-- Hero -->
      <section class="flex flex-col gap-2xs">
        <h1 class="text-4xl font-bold tracking-tight lg:text-5xl">{hero.title}</h1>
        <p class="text-lg text-muted-foreground max-w-2xl">{hero.description}</p>

        <div class="flex flex-wrap gap-3xs">
          {hero.links?.map((link: any) => (
            <Button
              href={link.to}
              variant={(link.variant === "outline" ? "outline" : link.color === "primary" ? "primary" : link.variant) as any || "outline"}
              target={link.target}
            >
              {link.icon === "lucide:download" && <IconDownload class="mr-2 h-4 w-4" />}
              {link.label}
            </Button>
          ))}
        </div>
      </section>

      <!-- Main body (Skills etc.) -->
      <section class="flex flex-col gap-3xs">
        <h2 class="text-2xl font-bold">{sections.skills.title}</h2>
        <Prose>
            <slot />
        </Prose>
      </section>

      <!-- Tech Stack -->
      {sections.tech && (
        <section class="flex flex-col gap-4xl">
          <h2 class="text-2xl font-bold">{sections.tech.title}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3xl">
            {sections.tech.items.map((category: any) => (
              <div class="flex flex-col gap-3xs">
                <h3 class="font-semibold text-muted-foreground">{category.title}</h3>
                <div class="flex flex-wrap gap-3xs">
                  {category.items.map((item: any) => (
                    <Button
                      href={item.to || "#"}
                      variant="ghost"
                      class="justify-start group"
                    >
                      {item.label}
                    </Button>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Experience -->
      {sections.experience && (
        <section class="flex flex-col gap-3xl">
          <h2 class="text-2xl font-bold">{sections.experience.title}</h2>
          <div class="flex flex-col gap-5xl">
            {sections.experience.items.map((exp: any) => (
              <div class="flex flex-col gap-2">
                <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
                  <h3 class="text-xl font-bold">{exp.role}</h3>
                  <span class="text-sm font-medium text-muted-foreground">{exp.period}</span>
                </div>
                <p class="text-muted-foreground font-medium">{exp.company}</p>
                {exp.bullets && (
                  <ul class="mt-2 list-disc list-inside flex flex-col gap-1 text-muted-foreground text-sm">
                    {exp.bullets.map((bullet: any) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Education -->
      {sections.education && (
        <section class="flex flex-col gap-3xl">
          <h2 class="text-2xl font-bold">{sections.education.title}</h2>
          <div class="flex flex-col gap-6">
            {sections.education.items.map((edu: any) => (
              <div class="flex flex-col gap-1">
                <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
                  <h3 class="text-lg font-bold">{edu.degree}</h3>
                  <span class="text-sm font-medium text-muted-foreground">{edu.period}</span>
                </div>
                <p class="text-muted-foreground">{edu.school}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Certifications -->
      {sections.certifications && (
        <section class="flex flex-col gap-3xl">
          <h2 class="text-2xl font-bold">{sections.certifications.title}</h2>
          <div class="flex flex-col gap-6">
            {sections.certifications.items.map((cert: any) => (
              <div class="flex flex-col gap-1">
                <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
                  <h3 class="text-lg font-bold">{cert.name}</h3>
                  <span class="text-sm font-medium text-muted-foreground">{cert.date}</span>
                </div>
                <p class="text-muted-foreground">{cert.issuer}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Volunteering -->
      {sections.volunteering && (
        <section class="flex flex-col gap-3xl">
          <h2 class="text-2xl font-bold">{sections.volunteering.title}</h2>
          <div class="flex flex-col gap-6">
            {sections.volunteering.items.map((v: any) => (
              <div class="flex flex-col gap-1">
                <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1">
                  <h3 class="text-lg font-bold">{v.role}</h3>
                  <span class="text-sm font-medium text-muted-foreground">{v.period}</span>
                </div>
                <p class="text-muted-foreground">{v.organization}</p>
                {v.field && <p class="text-xs italic text-muted-foreground">{v.field}</p>}
              </div>
            ))}
          </div>
        </section>
      )}
    </main>
  </div>
</div>

