---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";
import IconMoreHorizontal from "~icons/lucide/more-horizontal";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = HTMLAttributes<"span"> & VariantProps<typeof paginationEllipsis>;

export const paginationEllipsis = cv({
  base: "flex items-center justify-center",
  variants: {
    size: {
      "icon-sm": "size-9",
      icon: "size-11",
      "icon-lg": "size-12",
    },
  },
  defaultVariants: { size: "icon" },
});

const { class: className, size, ...rest } = Astro.props;
---

<span
  aria-hidden
  class:list={[paginationEllipsis({ size }), className]}
  {...rest}
  data-slot="pagination-ellipsis"
>
  <slot name="icon">
    <IconMoreHorizontal class="size-4" />
  </slot>
  <slot>
    <span class="sr-only">More pages</span>
  </slot>
</span>
