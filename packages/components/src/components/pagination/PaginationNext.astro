---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";
import IconChevronRight from "~icons/lucide/chevron-right";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

import type { button } from "@rimelight/components/button/Button.astro";

import PaginationLink from "./PaginationLink.astro";

type Props = HTMLAttributes<"a"> & {
  size?: VariantProps<typeof button>["size"];
};

export const paginationNext = cv({ base: "group gap-2xs" });

const { class: className, size = "md", ...rest } = Astro.props;
---

<PaginationLink
  aria-label="Go to next page"
  size={size}
  class:list={[paginationNext(), className]}
  {...rest}
  data-slot="pagination-next"
>
  <slot />
  <slot name="icon">
    <IconChevronRight class="size-4 transition-transform group-hover:translate-x-1" />
  </slot>
</PaginationLink>

