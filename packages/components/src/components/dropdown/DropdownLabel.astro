---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div"> & {
  /**
   * Whether the label is inset (has left padding)
   */
  inset?: boolean;
};

export const dropdownLabel = cv({
  base: ["text-muted-foreground px-3xs py-5xs text-sm font-medium"],
  variants: {
    inset: {
      true: "pl-3xl",
    },
  },
  defaultVariants: {
    inset: false,
  },
});

const { class: className, inset = false, ...rest } = Astro.props;
---

<div class:list={[dropdownLabel({ inset }), className]} {...rest} data-slot="dropdown-label">
  <slot />
</div>
