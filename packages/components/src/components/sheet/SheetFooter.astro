---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

type Props = HTMLAttributes<"div">;

const { class: className, ...rest } = Astro.props;

export const sheetFooter = cv({
  base: ["mt-auto flex flex-col gap-3xs p-2xl"],
});
---

<div class:list={[sheetFooter(), className]} {...rest} data-slot="sheet-footer">
  <slot />
</div>
