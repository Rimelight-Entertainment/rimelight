---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";
import IconChevronDown from "~icons/lucide/chevron-down";

type VariantProps<T extends (...args: any) => any> = NonNullable<Parameters<T>[0]>;

type Props = Omit<HTMLAttributes<"select">, "size"> & VariantProps<typeof nativeSelect>;

export const nativeSelectWrapper = cv({
  base: [
    "starwind-native-select-wrapper",
    "group/native-select relative w-fit has-[select:disabled]:op-50",
  ],
});

export const nativeSelect = cv({
  base: [
    "starwind-native-select",
    "border-input dark:bg-input/30 text-foreground ring-offset-background w-full rounded-md b bg-transparent shadow-xs",
    "placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground appearance-none bg-none select-none",
    "focus-visible:border-outline focus-visible:ring-outline/50 transition-[color,box-shadow] outline-none focus-visible:ring-3",
    "disabled:pointer-events-none disabled:cursor-not-allowed",
    "aria-invalid:border-error aria-invalid:focus-visible:ring-error/40 aria-invalid:focus-visible:ring-3",
  ],
  variants: {
    size: {
      sm: "h-2xl pr-2xl pl-3xs text-sm",
      md: "h-3xl pr-3xl pl-xs text-base",
      lg: "h-3xl pr-3xl px-2xl text-lg",
    },
  },
  defaultVariants: {
    size: "md",
  },
});

export const nativeSelectIcon = cv({
  base: ["text-foreground pointer-events-none absolute top-1/2 -translate-y-1/2 op-50"],
  variants: {
    size: {
      sm: "right-3xs size-3.5",
      md: "right-xs size-4",
      lg: "right-2xl size-5",
    },
  },
  defaultVariants: {
    size: "md",
  },
});

const { class: className, size, ...rest } = Astro.props;
---

<div class={nativeSelectWrapper()} data-size={size} data-slot="native-select-wrapper">
  <select class:list={[nativeSelect({ size }), className]} {...rest} data-slot="native-select">
    <slot />
  </select>
  <slot name="icon">
    <span
      class={nativeSelectIcon({ size })}
      aria-hidden="true"
      data-slot="native-select-icon"
    >
      <IconChevronDown />
    </span>
  </slot>
</div>
