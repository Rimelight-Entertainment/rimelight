---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

interface Props extends HTMLAttributes<"div">, NonNullable<Parameters<typeof avatar>[0]> {}

export const avatar = cv({
  base: "text-foreground bg-muted relative overflow-hidden rounded-full border-2",
  variants: {
    variant: {
      default: "border-border",
      primary: "border-primary",
      secondary: "border-secondary",
      info: "border-info",
      success: "border-success",
      warning: "border-warning",
      error: "border-error",
    },
    size: { sm: "h-2xl w-2xl text-xs", md: "h-3xl w-3xl text-sm", lg: "h-3xl w-3xl text-base" },
  },
  defaultVariants: { variant: "default", size: "md" },
});

const { variant, size, class: className, ...rest } = Astro.props;
---

<figure class:list={[avatar({ variant, size }), className]} {...rest} data-slot="avatar">
  <slot />
</figure>
