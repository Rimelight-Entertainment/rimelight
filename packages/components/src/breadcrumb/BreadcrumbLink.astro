---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";

export interface BreadcrumbLinkProps extends HTMLAttributes<"a"> {
  asChild?: boolean;
}

type Props = BreadcrumbLinkProps;

export const breadcrumbLink = cv({ base: "hover:text-foreground transition-colors" });

const { class: className, asChild = false, ...rest } = Astro.props;
---

{
  asChild ? (
    <slot />
  ) : (
    <a class:list={[breadcrumbLink(), className]} {...rest} data-slot="breadcrumb-link">
      <slot />
    </a>
  )
}
