---
import type { HTMLAttributes } from "astro/types";
import { cv } from "css-variants";
import IconMoreHorizontal from "~icons/lucide/more-horizontal";

export interface BreadcrumbEllipsisProps extends HTMLAttributes<"span"> {}
type Props = BreadcrumbEllipsisProps;

export const breadcrumbEllipsis = cv({
  base: "flex size-6 items-center justify-center [&>svg]:size-4",
});

const { class: className, ...rest } = Astro.props;
---

<span
  role="presentation"
  aria-hidden="true"
  class:list={[breadcrumbEllipsis(), className]}
  {...rest}
  data-slot="breadcrumb-ellipsis"
>
  <slot name="icon">
    <IconMoreHorizontal />
  </slot>
  <slot>
    <span class="sr-only">More</span>
  </slot>
</span>
