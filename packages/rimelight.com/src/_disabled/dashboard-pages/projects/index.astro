---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import CreateBoardModal from '@/components/dashboard/projects/CreateBoardModal.vue';
import { getRelativeLocaleUrl } from 'astro:i18n';

const activeLocale = Astro.currentLocale ?? 'en';
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(getRelativeLocaleUrl(activeLocale, '/auth/sign-in'));
}

// Fetch boards on server
let boards = [];
try {
	const res = await fetch(new URL('/api/projects/boards', Astro.url.origin).toString(), {
		headers: Astro.request.headers
	});
	if (res.ok) {
		boards = await res.json() as any[];
	}
} catch (e) {
	console.error('Failed to fetch boards on server:', e);
}
---

<DashboardLayout title="Projects" description="Manage your project boards, lists, and tasks.">
	<div class="p-6 flex flex-col h-full overflow-y-auto">
		<div class="flex justify-between items-center mb-6">
			<div>
				<h1 class="text-2xl font-bold text-neutral-900 dark:text-white flex items-center gap-2">
					<span class="i-lucide-square-kanban text-primary-500" />
					Projects
				</h1>
				<p class="text-sm text-neutral-500 dark:text-neutral-400">Collaborate on task boards and track status.</p>
			</div>

			<button
				id="open-create-board-btn"
				class="bg-primary-600 hover:bg-primary-700 text-white font-bold text-sm px-4 py-2 rounded-xl transition-all shadow-md flex items-center gap-1.5"
			>
				<span class="i-lucide-plus size-4"></span>
				Create Board
			</button>
		</div>

		{boards.length === 0 ? (
			<div class="flex-1 flex flex-col items-center justify-center py-20 text-center border-2 border-dashed border-neutral-200 dark:border-neutral-800 rounded-3xl">
				<span class="i-lucide-clipboard-list text-neutral-400 size-16 mb-4" />
				<h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-1">No boards yet</h3>
				<p class="text-sm text-neutral-500 max-w-xs mb-6">Get organized by creating your first project board today.</p>
				<button
					id="open-create-board-btn-empty"
					class="bg-primary-600 hover:bg-primary-700 text-white font-bold text-sm px-4 py-2 rounded-xl transition-all shadow-md"
				>
					Create First Board
				</button>
			</div>
		) : (
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
				{boards.map((board) => (
					<a
						href={getRelativeLocaleUrl(activeLocale, `/dashboard/projects/${board.id}`)}
						class="block p-5 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-2xl shadow-sm hover:shadow-md hover:ring-2 hover:ring-primary-500/20 transition-all group"
					>
						<div class="flex items-center gap-2 mb-3">
							<div class="w-1.5 h-5 bg-primary-500 rounded-full group-hover:h-7 transition-all" />
							<h3 class="font-bold text-md text-neutral-900 dark:text-white line-clamp-1">{board.title}</h3>
						</div>
						<p class="text-xs text-neutral-500 dark:text-neutral-400 line-clamp-2 min-h-[2.5rem] mb-4">
							{board.description || 'No description provided for this board.'}
						</p>
						<div class="flex justify-between items-center text-[10px] font-bold text-neutral-400 uppercase tracking-wider border-t border-neutral-100 dark:border-neutral-800 pt-3">
							<span class="flex items-center gap-1">
								<span class="i-lucide-calendar size-3" />
								{new Date(board.createdAt).toLocaleDateString()}
							</span>
							{board.lists && (
								<span class="flex items-center gap-1">
									<span class="i-lucide-list size-3" />
									{board.lists.length} Lists
								</span>
							)}
						</div>
					</a>
				))}
			</div>
		)}

		<!-- Vue Modal Island for board creation -->
		<CreateBoardModal id="create-board-modal" client:only="vue" />
	</div>

	<script>
		// Handle opening Create Board modal client-side
		const btns = [
			document.getElementById('open-create-board-btn'),
			document.getElementById('open-create-board-btn-empty')
		];

		btns.forEach(btn => {
			if (btn) {
				btn.addEventListener('click', () => {
					// We can trigger model value open on the Vue instance
					// Since it is client:only, we set the 'open' attribute or notify
					window.dispatchEvent(new CustomEvent('open-create-board'));
				});
			}
		});

		// Listen inside Vue component (will implement this hook in CreateBoardModal)
	</script>
</DashboardLayout>
