---
import BlankLayout from "@/layouts/BlankLayout.astro"

const links = [
  ["verification", "Verify Email"],
  ["password-reset", "Password Reset"],
  ["signup-notification", "Sign-up Notification"]
]
const locale = Astro.currentLocale ?? Astro.params.locale ?? "en"
---

<BlankLayout title="Email Templates Preview" description="Preview Rimelight email templates">
    <main class="email-preview-index">
      <h1>Email Templates Preview</h1>
      {links.map(([path, title]) => (
        <article><h2>{title}</h2><a href={`/${locale}/dev/email/${path}`}>Open Preview</a></article>
      ))}
    </main>
</BlankLayout>

<style>
  :global(body) { background: #eef0f4; color: #1f2937; }
  :global(.rla-main-container) { min-height: auto; padding-top: 0; }
  .email-preview-index { max-width: 600px; margin: auto; padding: 40px; }
  h1 { color: #111827; }
  article { background: #ffffff; border: 1px solid #d1d5db; border-radius: 8px; padding: 24px; margin: 16px 0; box-shadow: 0 2px 8px #11182718; }
  h2 { color: #1f2937; margin: 0 0 16px; font-size: 18px; }
  a { display: inline-block; padding: 10px 20px; background: #4c1d95; color: #ffffff; text-decoration: none; border-radius: 6px; }
  a:hover { background: #3b0764; }
</style>
