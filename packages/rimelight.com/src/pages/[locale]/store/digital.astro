---
import AppLayout from "@/layouts/AppLayout.astro";
import { useI18n, getRelativeLocaleUrl } from "@rimelight/i18n";




const messages = useI18n(Astro, "store_digital", {
  title: 'Digital Goods',
  description: 'Browse digital downloads, keys, and soundtrack keys.'
});
---

<AppLayout title={messages.title} description={messages.description}>
    <h1>{messages.title}</h1>
    <p>{messages.description}</p>
</AppLayout>
