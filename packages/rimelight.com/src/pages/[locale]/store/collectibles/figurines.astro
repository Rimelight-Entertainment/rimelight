---
import AppLayout from "@/layouts/AppLayout.astro";
import { useI18n } from "@rimelight/i18n";




const messages = useI18n(Astro, "store_collectibles_figurines", {
  title: 'Figurines',
  description: 'Browse collectible character figurines and statues.'
});
---

<AppLayout title={messages.title} description={messages.description}>
    <h1>{messages.title}</h1>
    <p>{messages.description}</p>
</AppLayout>
