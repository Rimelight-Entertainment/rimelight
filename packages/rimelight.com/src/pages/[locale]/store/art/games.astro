---
import StoreLayout from "@/layouts/StoreLayout.astro";
import { useI18n } from "@rimelight/i18n";




const messages = useI18n(Astro, "store_art_games", {
  title: 'Games',
  description: 'Browse physical games and board games.'
});
---

<StoreLayout title={messages.title} description={messages.description}>
    <h1>{messages.title}</h1>
    <p>{messages.description}</p>
</StoreLayout>
