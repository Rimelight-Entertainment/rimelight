---
import AppLayout from "@/layouts/AppLayout.astro";
import { siteConfig } from "@/config/site.config";
import { getRelativeLocaleUrl, useI18n } from "@rimelight/i18n";
import { getCollection } from "astro:content";
import RLAPageSection from "@rimelight/ui/components/astro/RLAPageSection.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLAVideo from "@rimelight/ui/components/astro/RLAVideo.astro";
import RLAGrid from "@rimelight/ui/components/astro/RLAGrid.astro";
import RLAPost from "@rimelight/ui/components/astro/RLAPost.astro";
import { Image } from "astro:assets";

const messages = useI18n(Astro, "home", {
  home_heroTitle: "We are Rimelight Entertainment",
  home_heroDescription: "We are creators of Grand Tale.",
  home_heroJoinUs: "Join Us",
  home_heroLearnMore: "Learn More",
  home_companyTitle: "Pushing the boundaries of {interactive}",
  home_companyDescription: "Founded in 2023, Rimelight Entertainment is independent and player-focused. We don't just create games; we create living, breathing worlds that respect your time and intelligence.",
  home_companyStatsTitles: "Titles in Development",
  home_companyStatsCreators: "Global Creators",
  home_projectsTitle: "Our Projects",
  home_projectsTagsFranchise: "Franchise",
  home_projectsTagsFantasy: "Fantasy",
  home_projectsTagsSocial: "Social",
  home_projectsContentGrandTaleDescription: "A high-fantasy social life-sim game which hosts sub-games of multiple genres.",
  home_projectsActionsDiscover: "Discover",
  home_newsTitle: "Latest News",
  home_newsDescription: "Read our latest news, posts, and project updates.",
  home_newsActionsViewAll: "View All News",
  home_ctaTitle: "Ready to play?",
  home_ctaDescription: "Join us and let's tell our story together.",
  home_ctaActionsCreateAccount: "Create Account",
  home_ctaActionsExploreCareers: "Explore Careers"
});

// Import assets from the project
import HeroBg from "@/assets/images/placeholder_home_hero_background.png";
import CompanyBg from "@/assets/images/placeholder_home_company_background.jpg";
import ProjectsBg from "@/assets/images/placeholder_home_projects_background.jpg";
import GrandTaleImg from "@/assets/images/placeholder_home_projects_grand-tale.png";
import NewsBg from "@/assets/images/placeholder_home_news_background.jpg";
import CtaBg from "@/assets/images/placeholder_home_cta_background.jpg";

// Fetch the 3 latest blog posts
const activeLocale = Astro.currentLocale ?? "en";
const latestPosts = (await getCollection("blog"))
    .filter((post) => post.id.startsWith(`${activeLocale}/`))
    .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

// Button configurations using exact UI properties
const heroLinks = [
  {
    label: messages.home_heroJoinUs,
    href: getRelativeLocaleUrl("/auth/sign-up"),
    color: "blurple" as const,
    variant: "solid" as const,
    class: "px-8 py-3 rounded-md font-bold transition-all duration-300 transform hover:scale-[1.03]"
  },
  {
    label: messages.home_heroLearnMore,
    href: getRelativeLocaleUrl("/company/about"),
    color: "neutral" as const,
    variant: "outline" as const,
    trailingIcon: "i-lucide-arrow-right",
    class: "text-white ring-white bg-transparent hover:bg-white hover:text-black px-8 py-3 rounded-md font-bold transition-all duration-300 transform hover:scale-[1.03]"
  }
];

const ctaLinks = [
  {
    label: messages.home_ctaActionsCreateAccount,
    href: getRelativeLocaleUrl("/auth/sign-up"),
    color: "blurple" as const,
    variant: "solid" as const,
    class: "px-8 py-3 rounded-md font-bold transition-all duration-300 transform hover:scale-[1.03]"
  },
  {
    label: messages.home_ctaActionsExploreCareers,
    href: getRelativeLocaleUrl("/company/careers"),
    color: "neutral" as const,
    variant: "outline" as const,
    class: "text-white ring-white bg-transparent hover:bg-white hover:text-black px-8 py-3 rounded-md font-bold transition-all duration-300 transform hover:scale-[1.03]"
  }
];
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
  <RLAPageSection
        variant="hero"
        reverse={true}
        title={messages.home_heroTitle}
        description={messages.home_heroDescription}
        links={heroLinks}
        ui={{
          title: "text-white",
          description: "text-neutral-300"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={HeroBg}
            alt="Hero Background"
            class="h-full w-full object-cover"
            loading="eager"
        />
        <div class="absolute inset-0 bg-black/45" />
      </div>

      <RLALogo class="pointer-events-none h-64 w-auto text-white" variant="logomark" mode="white" />
    </RLAPageSection>

    <RLAPageSection
        orientation="horizontal"
        title={messages.home_companyTitle.replace("{interactive}", "interactive media")}
        description={messages.home_companyDescription}
        ui={{
          title: "text-white",
          description: "text-neutral-300"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={CompanyBg}
            alt="Company Background"
            class="h-full w-full object-cover opacity-10"
        />
        <div class="absolute inset-0 bg-black/90" />
      </div>

      <div slot="body" class="grid grid-cols-2 gap-lg mt-8 border-t border-neutral-800/50 pt-8 max-w-xl">
        <div>
          <div class="text-4xl lg:text-5xl font-black text-white tracking-tight">3+</div>
          <div class="text-xs text-neutral-500 font-bold uppercase tracking-widest mt-1">
            {messages.home_companyStatsTitles}
          </div>
        </div>
        <div>
          <div class="text-4xl lg:text-5xl font-black text-white tracking-tight">50+</div>
          <div class="text-xs text-neutral-500 font-bold uppercase tracking-widest mt-1">
            {messages.home_companyStatsCreators}
          </div>
        </div>
      </div>

      <div class="flex items-center justify-center lg:pl-12 w-full mt-10 lg:mt-0">
        <RLAVideo
            src="https://www.youtube.com/watch?v=uH1Hw6SDI1M"
            title="We are Rimelight Entertainment"
            class="aspect-video w-full max-w-2xl overflow-hidden rounded-2xl shadow-2xl border border-neutral-800"
        />
      </div>
    </RLAPageSection>

    <RLAPageSection
        orientation="vertical"
        title={messages.home_projectsTitle}
        class="w-full relative z-10 py-24 bg-black border-t border-neutral-900"
        ui={{
          title: "text-white text-4xl lg:text-5xl font-extrabold uppercase tracking-tight text-center",
          description: "hidden"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={ProjectsBg}
            alt="Projects Background"
            class="h-full w-full object-cover opacity-15"
        />
        <div class="absolute inset-0 bg-neutral-950/80" />
      </div>

      <div slot="body" class="flex flex-wrap justify-center gap-lg mt-12 w-full max-w-7xl mx-auto px-4">
        <a
            href={getRelativeLocaleUrl("/franchises/grand-tale")}
            class="block relative h-128 w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] group rounded-2xl overflow-hidden shadow-2xl border border-neutral-800 transition-all duration-300"
        >
          <div class="relative h-full w-full overflow-hidden isolate transition-transform duration-700 ease-out group-hover:scale-[1.02] rounded-[inherit] will-change-transform bg-neutral-900">
            <div class="absolute inset-0 z-0 overflow-hidden rounded-[inherit]">
              <Image
                  alt="Grand Tale"
                  src={GrandTaleImg}
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 will-change-transform opacity-75"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/40 to-transparent" />
            </div>

            <div class="absolute inset-0 p-lg flex flex-col gap-sm justify-end z-10">
              <div class="flex gap-sm">
                <span class="text-white text-xs font-bold uppercase tracking-wider bg-primary-500 px-3 py-1 rounded-full shadow-md">
                  {messages.home_projectsTagsFranchise}
                </span>
                <span class="text-white text-xs font-bold uppercase tracking-wider bg-primary-500 px-3 py-1 rounded-full shadow-md">
                  {messages.home_projectsTagsFantasy}
                </span>
                <span class="text-white text-xs font-bold uppercase tracking-wider bg-primary-500 px-3 py-1 rounded-full shadow-md">
                  {messages.home_projectsTagsSocial}
                </span>
              </div>

              <h3 class="text-3xl font-extrabold uppercase text-white mt-2 tracking-tight">
                Grand Tale
              </h3>

              <p class="text-neutral-300 text-sm mt-1 leading-relaxed">
                {messages.home_projectsContentGrandTaleDescription}
              </p>

              <div class="flex items-center text-primary-400 font-bold uppercase tracking-widest text-xs mt-4 group-hover:text-primary-300 transition-colors">
                <span>{messages.home_projectsActionsDiscover}</span>
                <svg class="h-4 w-4 ml-1 transition-transform group-hover:translate-x-1.5 duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </div>
        </a>
      </div>
    </RLAPageSection>

    <RLAPageSection
        orientation="vertical"
        title={messages.home_newsTitle}
        description={messages.home_newsDescription}
        class="w-full relative z-10 py-24 bg-neutral-950 border-t border-neutral-900"
        ui={{
          title: "text-white text-4xl lg:text-5xl font-extrabold uppercase tracking-tight text-center",
          description: "text-neutral-400 text-center max-w-2xl mx-auto mt-4"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={NewsBg}
            alt="News Background"
            class="h-full w-full object-cover opacity-15"
        />
        <div class="absolute inset-0 bg-black/85" />
      </div>

      <div slot="body" class="w-full mt-12 max-w-7xl mx-auto px-4">
        <RLAGrid>
          {
            latestPosts.map((post) => (
                <RLAPost
                    title={post.data.title}
                    description={post.data.description}
                    date={post.data.pubDate}
                    image={post.data.heroImage}
                    to={getRelativeLocaleUrl(`/company/blog/${post.id.replace(`${activeLocale}/`, "")}/`)}
                    variant="ghost"
                />
            ))
          }
        </RLAGrid>

        {latestPosts.length > 0 && (
            <div class="flex justify-center mt-14">
              <RLAButton
                  label={messages.home_newsActionsViewAll}
                  href={getRelativeLocaleUrl("/blog")}
                  color="primary"
                  variant="link"
                  trailingIcon="i-lucide-arrow-right"
                  class="font-bold uppercase tracking-widest text-primary-500 hover:text-primary-400 transition-colors flex items-center gap-xs"
              />
            </div>
        )}
      </div>
    </RLAPageSection>

    <RLAPageSection
        variant="cta"
        ctaVariant="solid"
        title={messages.home_ctaTitle}
        description={messages.home_ctaDescription}
        links={ctaLinks}
        class="w-full relative z-10 py-24 bg-black border-t border-neutral-900 rounded-none overflow-hidden"
        ui={{
          title: "text-white text-5xl lg:text-6xl font-black uppercase tracking-tight text-center leading-none",
          description: "text-neutral-300 text-lg md:text-xl text-center max-w-xl mx-auto mt-4"
        }}
    >
      <div slot="background" class="w-full h-full">
        <Image
            src={CtaBg}
            alt="CTA Background"
            class="h-full w-full object-cover opacity-20"
        />
        <div class="absolute inset-0 bg-neutral-950/80" />
      </div>
    </RLAPageSection>
</AppLayout>
