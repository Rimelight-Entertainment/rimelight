---
import AppLayout from "@/layouts/AppLayout.astro";
import { useI18n } from "@rimelight/i18n";




const messages = useI18n(Astro, "report_issue", {
  title: 'Report Issue',
  description: 'Report an issue or bug on Rimelight platform.'
});
---

<AppLayout title={messages.title} description={messages.description}>
    <h1>{messages.title}</h1>
    <p>{messages.description}</p>
</AppLayout>
