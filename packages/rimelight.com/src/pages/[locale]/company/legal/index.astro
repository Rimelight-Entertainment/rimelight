---
import AppLayout from '@/layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config/site.config';

import { useI18nAsync, getRelativeLocaleUrl } from "@rimelight/i18n";

const activeLocale = Astro.currentLocale ?? "en";

const legalDocs = (await getCollection('legal'))
	.filter((doc) => doc.id.startsWith(`${activeLocale}/`))
	.toSorted(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);



const messages = await useI18nAsync(Astro, "legal", {
    title: "Legal",
    heading: "Legal",
    lastUpdated: "Last updated:",
});
---

<AppLayout title={messages.title} description={siteConfig.description}>
		<section class="legal-section py-24 max-w-4xl mx-auto px-4 text-white">
			<h1 class="text-4xl md:text-5xl font-black uppercase tracking-tight mb-12">{messages.heading}</h1>
			<ul class="space-y-8">
				{legalDocs.map((doc) => (
					<li class="bg-neutral-900 border border-neutral-850 rounded-2xl p-6 shadow-md">
						<h3><a class="text-xl font-bold text-white hover:text-primary-400 transition-colors uppercase" href={getRelativeLocaleUrl(`/company/legal/${doc.id.replace(`${activeLocale}/`, "")}/`)}>{doc.data.title}</a></h3>
						<p class="text-neutral-400 text-sm mt-2 leading-relaxed">{doc.data.description}</p>
						<span class="text-neutral-500 text-xs mt-4 block">{messages.lastUpdated} {doc.data.pubDate.toLocaleDateString()}</span>
					</li>
				))}
			</ul>
		</section>
</AppLayout>
