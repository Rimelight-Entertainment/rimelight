---
import AppLayout from "@/layouts/AppLayout.astro";
import { useI18n } from "@rimelight/i18n";




const messages = useI18n(Astro, "contact", {
  title: 'Contact Us',
  description: 'Get in touch with Rimelight Entertainment.'
});
---

<AppLayout title={messages.title} description={messages.description}>
    <h1>{messages.title}</h1>
    <p>{messages.description}</p>
</AppLayout>
