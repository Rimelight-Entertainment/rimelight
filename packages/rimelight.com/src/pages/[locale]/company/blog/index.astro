---
import AppLayout from '@/layouts/AppLayout.astro';
import { getCollection } from 'astro:content';

import { siteConfig } from '@/site.config';
import { useI18nAsync, getRelativeLocaleUrl } from "@rimelight/i18n";
import RLAPageSection from "@rimelight/ui/components/astro/RLAPageSection.astro"
import RLAGrid from "@rimelight/ui/components/astro/RLAGrid.astro"
import RLAPost from "@rimelight/ui/components/astro/RLAPost.astro"

const activeLocale = Astro.currentLocale ?? "en";

const posts = (await getCollection('blog'))
	.filter((post) => post.id.startsWith(`${activeLocale}/`))
	.toSorted(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);

const groupedPosts = posts.reduce<Record<string, typeof posts>>((acc, post) => {
	const type = post.data.type;
	if (!acc[type]) acc[type] = [];
	acc[type].push(post);
	return acc;
}, {});

const categoryOrder = ["company-news", "development-log", "other"] as const;



const messages = await useI18nAsync(Astro, "blog", {
	categories: {
  "company-news": "Company News",
  "development-log": "Development Log",
  "other": "Other"
} as any
});
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
		{categoryOrder.map((category) => {
			const categoryPosts = groupedPosts[category];
			if (!categoryPosts || categoryPosts.length === 0) return null;
			return (
				<RLAPageSection title={(messages.categories as unknown as Record<string, string>)[category]}>
					<RLAGrid>
						{
							categoryPosts.map((post) => (
								<RLAPost
									variant="ghost"
									image={post.data.heroImage}
									date={post.data.pubDate}
									title={post.data.title}
									description={post.data.description}
									to={getRelativeLocaleUrl(`/company/blog/${post.id.replace(`${activeLocale}/`, "")}/`)}
								/>
							))
						}
					</RLAGrid>
				</RLAPageSection>
			);
		})}
</AppLayout>
