---
import { getEntry, render } from "astro:content";
import DocsLayout from "@/layouts/DocsLayout.astro";
import { currentLocale } from "@rimelight/i18n";




const entry = await getEntry("docs", `${activeLocale}/overview/getting-started`);

if (!entry) {
  return Astro.redirect(getRelativeLocaleUrl('/404'));
}

const { Content, headings } = await render(entry);
const { title, description, tableOfContents, editUrl } = entry.data;
---

<DocsLayout
  title={title}
  description={description}
  headings={headings}
  tableOfContents={tableOfContents}
  editUrl={editUrl}
>
  <Content />
</DocsLayout>
