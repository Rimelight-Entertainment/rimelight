---
import WikiLayout from '@/layouts/WikiLayout.astro';
import PageReviewView from '@/components/article/views/PageReviewView.vue';
import { pageDefinitions } from '@/types/pageDefinitions';

const { slug } = Astro.params;
const lookupSlug = `franchises/grand-tale/wiki/${slug}`;
const versionId = Astro.url.searchParams.get('version') || '';
const user = Astro.locals.user;
const isAdmin = user?.role === 'owner' || user?.role === 'admin';
---

<WikiLayout title="Review Wiki Version | Grand Tale Wiki">
	<PageReviewView
		client:only="vue"
		lookupPath={lookupSlug}
		versionId={versionId}
		pageDefinitions={pageDefinitions}
		baseUrl="/franchises/grand-tale/wiki"
		isAdmin={isAdmin}
	/>
</WikiLayout>
