---
import AppLayout from "@/layouts/AppLayout.astro";
import { useI18n } from "@rimelight/i18n";




const messages = useI18n(Astro, "grand_tale_download", {
  title: 'Download Grand Tale',
  description: 'Download the client for Grand Tale.'
});
---

<AppLayout title={messages.title} description={messages.description}>
    <h1>{messages.title}</h1>
    <p>{messages.description}</p>
</AppLayout>
