---
import AppLayout from "@/layouts/AppLayout.astro";
import { useI18n } from "@rimelight/i18n";




const messages = useI18n(Astro, "grand_tale_leaderboards", {
  title: "Grand Tale Leaderboards",
  description: "View top adventurers, power levels, speedruns, and active guilds in Grand Tale.",
  heading: "Global Standings",
  subheading: "The top adventurers across all realms."
});

const leaders = [
  { rank: 1, name: "IllidanStormrage", soul: "Voidweaver", level: 99, power: 12500 },
  { rank: 2, name: "SylvanasWind", soul: "Banshee", level: 98, power: 12200 },
  { rank: 3, name: "ArthasMenethil", soul: "Deathknight", level: 97, power: 12100 },
  { rank: 4, name: "JainaProud", soul: "Archmage", level: 96, power: 11900 },
  { rank: 5, name: "ThrallWarchief", soul: "Shaman", level: 95, power: 11800 },
];
---

<AppLayout title={messages.title} description={messages.description}>
  <div class="py-24 bg-neutral-950 min-h-[80vh]">
    <div class="max-w-4xl mx-auto px-4 space-y-12">
      <div class="flex flex-col md:flex-row justify-between items-end gap-6 border-b border-neutral-900 pb-8">
        <div class="space-y-4">
          <h1 class="text-4xl md:text-5xl font-black uppercase tracking-tight text-white">
            {messages.heading}
          </h1>
          <p class="text-neutral-400">{messages.subheading}</p>
        </div>
      </div>

      <div class="bg-neutral-900/50 border border-neutral-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-neutral-800 bg-neutral-900/80 text-xs font-bold uppercase tracking-widest text-neutral-400">
                <th class="p-6">Rank</th>
                <th class="p-6">Player</th>
                <th class="p-6">Soul Path</th>
                <th class="p-6">Level</th>
                <th class="p-6">Power Score</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-800">
              {leaders.map((player) => (
                <tr class="hover:bg-neutral-900/30 transition-colors group">
                  <td class="p-6">
                    <span class={`font-black text-xl italic ${
                      player.rank === 1
                        ? 'text-yellow-500'
                        : player.rank === 2
                          ? 'text-gray-400'
                          : player.rank === 3
                            ? 'text-amber-600'
                            : 'text-neutral-600'
                    }`}>
                      #{player.rank}
                    </span>
                  </td>
                  <td class="p-6">
                    <div class="flex items-center gap-3">
                      <div class="h-8 w-8 rounded-full bg-neutral-800 border border-neutral-700 flex items-center justify-center text-xs font-bold text-white uppercase select-none">
                        {player.name.substring(0, 2)}
                      </div>
                      <span class="font-bold text-white group-hover:text-primary-400 transition-colors">
                        {player.name}
                      </span>
                    </div>
                  </td>
                  <td class="p-6 text-neutral-400">{player.soul}</td>
                  <td class="p-6 text-white font-mono">{player.level}</td>
                  <td class="p-6">
                    <span class="text-primary-400 font-bold tabular-nums">
                      {player.power.toLocaleString()}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</AppLayout>
