---
import GrandTaleLayout from "@/layouts/GrandTaleLayout.astro";
import { useI18n } from "@rimelight/i18n";




const messages = useI18n(Astro, "grand_tale_forums", {
  title: 'Grand Tale Forums',
  description: 'Discuss Grand Tale with the community.'
});
---

<GrandTaleLayout title={messages.title} description={messages.description}>
    <h1>{messages.title}</h1>
    <p>{messages.description}</p>
</GrandTaleLayout>
