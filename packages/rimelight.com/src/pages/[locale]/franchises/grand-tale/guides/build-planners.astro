---
import GuidesLayout from "@/layouts/GuidesLayout.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import { useI18n } from "@rimelight/i18n";




const messages = useI18n(Astro, "grand_tale_build_planners", {
  title: "Build Planners",
  description: "Optimize your hero's potential. Experiment with ability points, gear synergy, and resonance.",
  heading: "Build Planners",
  subheading: "Optimize your hero's potential. Experiment with ability points, gear synergy, and resonance effects before committing your resources in-game.",
  new_draft_title: "New Draft",
  new_draft_desc: "Start from scratch with a Level 1 hero and map out their entire progression path to Level 100.",
  new_draft_btn: "Create New Build",
  library_title: "My Library",
  library_desc: "Access and edit your previously saved builds or share them with the community.",
  library_btn: "View Saved Builds",
  status_title: "Interactive Planner - Coming Soon",
  status_desc: "We are currently integrating the real-time hero data API. Soon you'll be able to drag-and-drop gear items directly into your builds."
});
---

<GuidesLayout title={messages.title} description={messages.description}>
  <div class="py-24 bg-neutral-950 text-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 space-y-16">
      <section class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary-500/10 border border-primary-500/20 text-primary-400 text-xs font-bold uppercase tracking-widest rounded-full">
          Tools
        </div>
        <h1 class="text-5xl font-black uppercase tracking-tight leading-none">
          Build <br />
          <span class="text-primary-500">{messages.heading}</span>
        </h1>
        <p class="text-xl text-neutral-400 leading-relaxed font-light">
          {messages.subheading}
        </p>
      </section>

      <hr class="border-neutral-900" />

      <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- New Draft -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 flex flex-col justify-between shadow-lg">
          <div class="space-y-4 mb-6">
            <div class="flex items-center gap-3">
              <span class="i-lucide-user-plus text-primary-500 text-2xl"></span>
              <h3 class="text-lg font-bold text-white uppercase">{messages.new_draft_title}</h3>
            </div>
            <p class="text-neutral-400 text-sm leading-relaxed">
              {messages.new_draft_desc}
            </p>
          </div>
          <RLAButton label={messages.new_draft_btn} color="primary" variant="solid" class="w-full justify-center font-bold" />
        </div>

        <!-- My Library -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 flex flex-col justify-between shadow-lg">
          <div class="space-y-4 mb-6">
            <div class="flex items-center gap-3">
              <span class="i-lucide-library text-primary-500 text-2xl"></span>
              <h3 class="text-lg font-bold text-white uppercase">{messages.library_title}</h3>
            </div>
            <p class="text-neutral-400 text-sm leading-relaxed">
              {messages.library_desc}
            </p>
          </div>
          <RLAButton label={messages.library_btn} color="neutral" variant="outline" class="w-full justify-center font-bold text-white ring-white hover:bg-white hover:text-black" />
        </div>
      </section>

      <!-- Coming Soon Status banner -->
      <section class="p-8 bg-neutral-900/50 border border-neutral-800 rounded-2xl text-center space-y-4 shadow-md max-w-2xl mx-auto">
        <span class="i-lucide-construction text-4xl text-primary-500/50 block mx-auto"></span>
        <h3 class="text-xl font-bold text-white uppercase">
          {messages.status_title}
        </h3>
        <p class="text-neutral-500 text-sm leading-relaxed max-w-md mx-auto">
          {messages.status_desc}
        </p>
      </section>
    </div>
  </div>
</GuidesLayout>
