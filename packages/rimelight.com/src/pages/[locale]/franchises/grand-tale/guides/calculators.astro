---
import GuidesLayout from "@/layouts/GuidesLayout.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import { t } from "@rimelight/i18n";

const calculators = [
  {
    title: t("page_grand-tale_guides_calculators.calc1_title"),
    icon: "i-lucide-swords",
    description: t("page_grand-tale_guides_calculators.calc1_desc")
  },
  {
    title: t("page_grand-tale_guides_calculators.calc2_title"),
    icon: "i-lucide-shield",
    description: t("page_grand-tale_guides_calculators.calc2_desc")
  },
  {
    title: t("page_grand-tale_guides_calculators.calc3_title"),
    icon: "i-lucide-sparkles",
    description: t("page_grand-tale_guides_calculators.calc3_desc")
  },
  {
    title: t("page_grand-tale_guides_calculators.calc4_title"),
    icon: "i-lucide-pickaxe",
    description: t("page_grand-tale_guides_calculators.calc4_desc")
  }
];
---

<GuidesLayout title={t("page_grand-tale_guides_calculators.title")} description={t("page_grand-tale_guides_calculators.description")}>
  <div class="py-24 bg-neutral-950 text-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 space-y-16">
      <section class="space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary-500/10 border border-primary-500/20 text-primary-400 text-xs font-bold uppercase tracking-widest rounded-full">
          Tools
        </div>
        <h1 class="text-5xl font-black uppercase tracking-tight leading-none">
          Game <br />
          <span class="text-primary-500">{t("page_grand-tale_guides_calculators.heading")}</span>
        </h1>
        <p class="text-xl text-neutral-400 leading-relaxed font-light">
          {t("page_grand-tale_guides_calculators.subheading")}
        </p>
      </section>

      <hr class="border-neutral-900" />

      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {calculators.map((calc) => (
          <div class="group p-6 bg-neutral-900 border border-neutral-800 hover:border-primary-500/50 rounded-2xl transition-all cursor-pointer shadow-md">
            <div class="flex items-start gap-4">
              <div class="p-3 bg-primary-500/10 border border-primary-500/20 group-hover:bg-primary-500/25 transition-colors rounded-xl">
                <span class={`${calc.icon} text-primary-500 text-2xl`}></span>
              </div>
              <div class="space-y-1">
                <h3 class="text-lg font-bold text-white group-hover:text-primary-400 transition-colors uppercase tracking-tight">
                  {calc.title}
                </h3>
                <p class="text-sm text-neutral-400 leading-relaxed">
                  {calc.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </section>

      <!-- Formula suggestion card -->
      <div class="bg-neutral-900/50 border-2 border-dashed border-neutral-800 rounded-2xl p-8 text-center shadow-lg max-w-2xl mx-auto">
        <p class="text-neutral-500 text-sm mb-2">{t("page_grand-tale_guides_calculators.suggest_title")}</p>
        <RLAButton label={t("page_grand-tale_guides_calculators.suggest_btn")} color="primary" variant="link" class="font-bold text-primary-500 hover:text-primary-400 transition-colors" />
      </div>
    </div>
  </div>
</GuidesLayout>
