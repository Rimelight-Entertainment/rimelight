---
import AppLayout from "@/layouts/AppLayout.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";

import { useI18n, getRelativeLocaleUrl } from "@rimelight/i18n";




const messages = useI18n(Astro, "grand_tale_guides", {
  title: "Grand Tale Guides",
  description: "Browse player guides, build planners, stat calculators, and beginner tips for Grand Tale.",
  heading: "Master the Soulstream",
  subheading: "Welcome to the ultimate guide hub for Grand Tale. Whether you're a new traveler or a seasoned hero, our community-curated guides will help you navigate the mysteries of Aethelgard.",
  category_basics_title: "New Player Experience",
  category_basics_desc: "Master the basics of combat, exploration, and the Soulstone system.",
  category_basics_btn: "Explore Basics",
  category_builds_title: "Hero Builds",
  category_builds_desc: "In-depth analysis of hero abilities and optimal equipment synergies.",
  category_builds_btn: "View Builds",
  category_endgame_title: "Endgame Strategies",
  category_endgame_desc: "Advanced tactics for raids, world bosses, and high-level competitive play.",
  category_endgame_btn: "Master Endgame",
  latest_title: "Latest Community Guides"
});
---

<AppLayout title={messages.title} description={messages.description}>
  <div class="py-24 bg-neutral-950 text-white min-h-screen">
    <div class="max-w-6xl mx-auto px-4 space-y-16">
      <!-- Header -->
      <section class="space-y-6 max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary-500/10 border border-primary-500/20 text-primary-400 text-xs font-bold uppercase tracking-widest rounded-full">
          Game Guides
        </div>
        <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tight leading-none">
          {messages.heading}
        </h1>
        <p class="text-xl md:text-2xl text-neutral-400 font-light leading-relaxed">
          {messages.subheading}
        </p>
      </section>

      <hr class="border-neutral-900" />

      <!-- Categories -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- New Player -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 hover:border-primary-500/30 transition-all flex flex-col justify-between shadow-lg">
          <div class="space-y-6">
            <div class="h-14 w-14 bg-primary-500/10 border border-primary-500/20 flex items-center justify-center rounded-xl">
              <span class="i-lucide-graduation-cap text-primary-500 text-2xl"></span>
            </div>
            <div class="space-y-2">
              <h2 class="text-2xl font-bold uppercase tracking-tight">{messages.category_basics_title}</h2>
              <p class="text-neutral-400 text-sm leading-relaxed">{messages.category_basics_desc}</p>
            </div>
          </div>
          <RLAButton label={messages.category_basics_btn} color="primary" variant="link" leadingIcon="i-lucide-arrow-right" class="px-0 font-bold uppercase tracking-wider text-xs flex items-center gap-xs mt-6 text-primary-500 hover:text-primary-400" />
        </div>

        <!-- Hero Builds -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 hover:border-primary-500/30 transition-all flex flex-col justify-between shadow-lg">
          <div class="space-y-6">
            <div class="h-14 w-14 bg-primary-500/10 border border-primary-500/20 flex items-center justify-center rounded-xl">
              <span class="i-lucide-swords text-primary-500 text-2xl"></span>
            </div>
            <div class="space-y-2">
              <h2 class="text-2xl font-bold uppercase tracking-tight">{messages.category_builds_title}</h2>
              <p class="text-neutral-400 text-sm leading-relaxed">{messages.category_builds_desc}</p>
            </div>
          </div>
          <RLAButton label={messages.category_builds_btn} href={getRelativeLocaleUrl("/franchises/grand-tale/guides/build-planners")} color="primary" variant="link" leadingIcon="i-lucide-arrow-right" class="px-0 font-bold uppercase tracking-wider text-xs flex items-center gap-xs mt-6 text-primary-500 hover:text-primary-400" />
        </div>

        <!-- Endgame -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 hover:border-primary-500/30 transition-all flex flex-col justify-between shadow-lg">
          <div class="space-y-6">
            <div class="h-14 w-14 bg-primary-500/10 border border-primary-500/20 flex items-center justify-center rounded-xl">
              <span class="i-lucide-crown text-primary-500 text-2xl"></span>
            </div>
            <div class="space-y-2">
              <h2 class="text-2xl font-bold uppercase tracking-tight">{messages.category_endgame_title}</h2>
              <p class="text-neutral-400 text-sm leading-relaxed">{messages.category_endgame_desc}</p>
            </div>
          </div>
          <RLAButton label={messages.category_endgame_btn} color="primary" variant="link" leadingIcon="i-lucide-arrow-right" class="px-0 font-bold uppercase tracking-wider text-xs flex items-center gap-xs mt-6 text-primary-500 hover:text-primary-400" />
        </div>
      </div>

      <!-- Featured Guides -->
      <section class="space-y-8">
        <h3 class="text-3xl font-black uppercase tracking-tight">{messages.latest_title}</h3>
        <div class="space-y-4">
          {[1, 2, 3].map((i) => (
            <div class="p-6 bg-neutral-900 border border-neutral-800 rounded-2xl flex items-center justify-between group hover:border-primary-500/50 transition-colors shadow-md">
              <div class="flex items-center gap-6">
                <div class="text-primary-500/50 font-black text-2xl tabular-nums">0{i}</div>
                <div>
                  <h4 class="text-xl font-bold text-white group-hover:text-primary-400 uppercase transition-colors">
                    Advanced Elemental Syncing in Void Raids
                  </h4>
                  <p class="text-xs text-neutral-500 mt-1">
                    Posted by SoulScribe • 2 hours ago
                  </p>
                </div>
              </div>
              <span class="i-lucide-chevron-right text-2xl text-neutral-600 group-hover:text-primary-500 transition-colors"></span>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</AppLayout>
