---
import GuidesLayout from "@/layouts/GuidesLayout.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import { t, getRelativeLocaleUrl } from "@rimelight/i18n";
---

<GuidesLayout title={t("page_grand-tale_guides.title")} description={t("page_grand-tale_guides.description")}>
  <div class="py-24 bg-neutral-950 text-white min-h-screen">
    <div class="max-w-6xl mx-auto px-4 space-y-16">
      <!-- Header -->
      <section class="space-y-6 max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary-500/10 border border-primary-500/20 text-primary-400 text-xs font-bold uppercase tracking-widest rounded-full">
          Game Guides
        </div>
        <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tight leading-none">
          {t("page_grand-tale_guides.heading")}
        </h1>
        <p class="text-xl md:text-2xl text-neutral-400 font-light leading-relaxed">
          {t("page_grand-tale_guides.subheading")}
        </p>
      </section>

      <hr class="border-neutral-900" />

      <!-- Categories -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- New Player -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 hover:border-primary-500/30 transition-all flex flex-col justify-between shadow-lg">
          <div class="space-y-6">
            <div class="h-14 w-14 bg-primary-500/10 border border-primary-500/20 flex items-center justify-center rounded-xl">
              <span class="i-lucide-graduation-cap text-primary-500 text-2xl"></span>
            </div>
            <div class="space-y-2">
              <h2 class="text-2xl font-bold uppercase tracking-tight">{t("page_grand-tale_guides.category_basics_title")}</h2>
              <p class="text-neutral-400 text-sm leading-relaxed">{t("page_grand-tale_guides.category_basics_desc")}</p>
            </div>
          </div>
          <RLAButton label={t("page_grand-tale_guides.category_basics_btn")} color="primary" variant="link" leadingIcon="i-lucide-arrow-right" class="px-0 font-bold uppercase tracking-wider text-xs flex items-center gap-xs mt-6 text-primary-500 hover:text-primary-400" />
        </div>

        <!-- Hero Builds -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 hover:border-primary-500/30 transition-all flex flex-col justify-between shadow-lg">
          <div class="space-y-6">
            <div class="h-14 w-14 bg-primary-500/10 border border-primary-500/20 flex items-center justify-center rounded-xl">
              <span class="i-lucide-swords text-primary-500 text-2xl"></span>
            </div>
            <div class="space-y-2">
              <h2 class="text-2xl font-bold uppercase tracking-tight">{t("page_grand-tale_guides.category_builds_title")}</h2>
              <p class="text-neutral-400 text-sm leading-relaxed">{t("page_grand-tale_guides.category_builds_desc")}</p>
            </div>
          </div>
          <RLAButton label={t("page_grand-tale_guides.category_builds_btn")} href={getRelativeLocaleUrl("/franchises/grand-tale/guides/build-planners")} color="primary" variant="link" leadingIcon="i-lucide-arrow-right" class="px-0 font-bold uppercase tracking-wider text-xs flex items-center gap-xs mt-6 text-primary-500 hover:text-primary-400" />
        </div>

        <!-- Endgame -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-2xl p-8 hover:border-primary-500/30 transition-all flex flex-col justify-between shadow-lg">
          <div class="space-y-6">
            <div class="h-14 w-14 bg-primary-500/10 border border-primary-500/20 flex items-center justify-center rounded-xl">
              <span class="i-lucide-crown text-primary-500 text-2xl"></span>
            </div>
            <div class="space-y-2">
              <h2 class="text-2xl font-bold uppercase tracking-tight">{t("page_grand-tale_guides.category_endgame_title")}</h2>
              <p class="text-neutral-400 text-sm leading-relaxed">{t("page_grand-tale_guides.category_endgame_desc")}</p>
            </div>
          </div>
          <RLAButton label={t("page_grand-tale_guides.category_endgame_btn")} color="primary" variant="link" leadingIcon="i-lucide-arrow-right" class="px-0 font-bold uppercase tracking-wider text-xs flex items-center gap-xs mt-6 text-primary-500 hover:text-primary-400" />
        </div>
      </div>

      <!-- Featured Guides -->
      <section class="space-y-8">
        <h3 class="text-3xl font-black uppercase tracking-tight">{t("page_grand-tale_guides.latest_title")}</h3>
        <div class="space-y-4">
          {[1, 2, 3].map((i) => (
            <div class="p-6 bg-neutral-900 border border-neutral-800 rounded-2xl flex items-center justify-between group hover:border-primary-500/50 transition-colors shadow-md">
              <div class="flex items-center gap-6">
                <div class="text-primary-500/50 font-black text-2xl tabular-nums">0{i}</div>
                <div>
                  <h4 class="text-xl font-bold text-white group-hover:text-primary-400 uppercase transition-colors">
                    Advanced Elemental Syncing in Void Raids
                  </h4>
                  <p class="text-xs text-neutral-500 mt-1">
                    Posted by SoulScribe • 2 hours ago
                  </p>
                </div>
              </div>
              <span class="i-lucide-chevron-right text-2xl text-neutral-600 group-hover:text-primary-500 transition-colors"></span>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</GuidesLayout>
