---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import ProjectDetailsContainer from '@/components/dashboard/projects/ProjectDetailsContainer.vue';
import { auth } from "@/auth/auth";

const sessionData = await auth.api.getSession({ headers: Astro.request.headers });
const user = sessionData?.user;

if (!user) {
	return Astro.redirect(`/${Astro.currentLocale ?? 'en'}/auth/sign-in`);
}

const { id } = Astro.params;
---

<DashboardLayout title="Project Board">
	<div class="h-[calc(100vh-var(--rl-total-header-height,80px))] flex flex-col">
		<ProjectDetailsContainer client:only="vue" boardId={id!} />
	</div>
</DashboardLayout>
