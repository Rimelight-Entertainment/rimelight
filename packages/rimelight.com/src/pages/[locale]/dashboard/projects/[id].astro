---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import BoardDetails from '@/components/dashboard/projects/BoardDetails.vue';
import { getRelativeLocaleUrl } from 'astro:i18n';

const activeLocale = Astro.currentLocale ?? 'en';
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(getRelativeLocaleUrl(activeLocale, '/auth/sign-in'));
}

const { id } = Astro.params;
---

<DashboardLayout title="Project Board">
	<div class="h-[calc(100vh-var(--total-header-offset,80px))] flex flex-col">
		<BoardDetails client:only="vue" boardId={id} />
	</div>
</DashboardLayout>
