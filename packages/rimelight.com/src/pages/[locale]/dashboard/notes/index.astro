---
import NotesLayout from '@/layouts/NotesLayout.astro';
import NotesIndexContainer from '@/_disabled/dashboard/notes/NotesIndexContainer.vue';

const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(`/${Astro.currentLocale ?? 'en'}/auth/sign-in`);
}
---

<NotesLayout activeTab="notes" title="Notes">
	<NotesIndexContainer client:load />
</NotesLayout>
