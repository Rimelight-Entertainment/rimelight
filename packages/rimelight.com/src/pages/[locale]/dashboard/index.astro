---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { t } from "@rimelight/i18n";
import { auth } from "@/auth/auth";

const sessionData = await auth.api.getSession({ headers: Astro.request.headers });
const user = sessionData?.user;
if (!user) {
	return Astro.redirect('/auth/sign-in');
}
---

<DashboardLayout title={t("dashboard.meta_title")} description={t("dashboard.meta_description")}>
	<div class="p-6 flex flex-col gap-4">
		<div class="flex flex-col gap-2">
			<h2 class="text-2xl font-bold text-neutral-900 dark:text-white">
				Welcome back, {user.name}
			</h2>
			<p class="text-neutral-500 dark:text-neutral-400">
				{t("dashboard.meta_description")}
			</p>
		</div>
	</div>
</DashboardLayout>
