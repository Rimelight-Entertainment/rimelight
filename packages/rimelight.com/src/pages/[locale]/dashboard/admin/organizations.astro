---
import AdminLayout from '@/layouts/AdminLayout.astro';
import OrganizationsManagement from '@/components/dashboard/admin/OrganizationsManagement.vue';
import { auth } from "@/auth/auth";

const sessionData = await auth.api.getSession({ headers: Astro.request.headers });
const user = sessionData?.user;

if (!user) {
	return Astro.redirect(`/${Astro.currentLocale ?? 'en'}/auth/sign-in`);
}
---

<AdminLayout activeTab="organizations" title="Manage Organizations">
	<OrganizationsManagement client:load />
</AdminLayout>
