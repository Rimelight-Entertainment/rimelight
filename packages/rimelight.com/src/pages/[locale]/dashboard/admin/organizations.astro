---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminOrganizations from '@/components/dashboard/admin/AdminOrganizations.vue';
import { getRelativeLocaleUrl } from 'astro:i18n';

const activeLocale = Astro.currentLocale ?? 'en';
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(getRelativeLocaleUrl(activeLocale, '/auth/sign-in'));
}
---

<AdminLayout activeTab="organizations" title="Manage Organizations">
	<AdminOrganizations client:load />
</AdminLayout>
