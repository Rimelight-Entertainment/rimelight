---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminOverview from '@/components/dashboard/admin/AdminOverview.vue';
import { getRelativeLocaleUrl } from 'astro:i18n';

const activeLocale = Astro.currentLocale ?? 'en';
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(getRelativeLocaleUrl(activeLocale, '/auth/sign-in'));
}
---

<AdminLayout activeTab="overview" title="Admin Overview">
	<AdminOverview client:load />
</AdminLayout>
