---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminTeams from '@/components/dashboard/admin/AdminTeams.vue';
import { getRelativeLocaleUrl } from 'astro:i18n';

const activeLocale = Astro.currentLocale ?? 'en';
const user = Astro.locals.user;

if (!user) {
	return Astro.redirect(getRelativeLocaleUrl(activeLocale, '/auth/sign-in'));
}
---

<AdminLayout activeTab="teams" title="Manage Teams">
	<AdminTeams client:load />
</AdminLayout>
