---
import AdminLayout from '@/layouts/AdminLayout.astro';
import AdminUsers from '@/components/dashboard/admin/AdminUsers.vue';
import { auth } from "@/auth/auth";

const sessionData = await auth.api.getSession({ headers: Astro.request.headers });
const user = sessionData?.user;

if (!user) {
	return Astro.redirect(`/${Astro.currentLocale ?? 'en'}/auth/sign-in`);
}
---

<AdminLayout activeTab="users" title="Manage Users">
	<AdminUsers client:load />
</AdminLayout>
