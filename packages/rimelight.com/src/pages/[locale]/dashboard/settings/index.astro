---
import SettingsLayout from '@/layouts/SettingsLayout.astro';
import ProfileSettingsContainer from '@/components/dashboard/settings/ProfileSettingsContainer.vue';
import { auth } from "@/auth/auth";

const sessionData = await auth.api.getSession({ headers: Astro.request.headers });
const user = sessionData?.user;

if (!user) {
	return Astro.redirect(`/${Astro.currentLocale ?? 'en'}/auth/sign-in`);
}
---

<SettingsLayout activeTab="general" title="General Settings">
	<ProfileSettingsContainer client:load />
</SettingsLayout>
