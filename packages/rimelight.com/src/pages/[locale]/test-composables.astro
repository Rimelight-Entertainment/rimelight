---
import AppLayout from "@/layouts/AppLayout.astro";
import TestControls from "@/components/TestControls.vue";
import RLVToaster from "@rimelight/ui/components/vue/RLVToaster.vue";
import RLVScrollToTop from "@rimelight/ui/components/vue/RLVScrollToTop.vue";
import { useI18n } from "@rimelight/i18n";

const messages = useI18n(Astro, "test_composables", {
  title: 'Test Composables/Utils',
  description: 'Test page for verifying the refactored framework-agnostic utilities.'
});
---

<AppLayout title={messages.title} description={messages.description}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-4">{messages.title}</h1>
    <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">{messages.description}</p>
    
    <TestControls client:load />
    
    <!-- Render the Toaster component which subscribes to the framework-agnostic toastsStore -->
    <RLVToaster client:load />

    <!-- Create some tall scrollable space to test the ScrollToTop button -->
    <div class="my-12 p-8 border border-dashed border-neutral-300 dark:border-neutral-700 rounded-lg">
      <h2 class="text-xl font-bold mb-4">Scroll Down to Test ScrollToTop</h2>
      <p class="mb-4">This section contains placeholder space so that you can scroll down and see the progress bar/button show up.</p>
      
      <div style="height: 1200px;" class="flex items-center justify-center bg-gradient-to-b from-neutral-100 to-neutral-200 dark:from-neutral-900 dark:to-neutral-950 rounded">
        <span class="text-muted">Scrolling test area... keep going down!</span>
      </div>
    </div>
    
    <!-- Render the ScrollToTop button which uses the framework-agnostic scroll utility -->
    <RLVScrollToTop client:load showProgress={true} />
  </div>
</AppLayout>
