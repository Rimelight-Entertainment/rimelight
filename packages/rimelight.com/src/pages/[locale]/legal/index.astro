---
import AppLayout from '@/layouts/AppLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/config/site.config';

import { t, getRelativeLocaleUrl } from "@rimelight/i18n";

const activeLocale = Astro.currentLocale ?? "en";

const legalDocs = (await getCollection('legal'))
	.filter((doc) => doc.id.startsWith(`${activeLocale}/`))
	.toSorted(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
---

<AppLayout title={t("page_legal.meta_title")} description={siteConfig.description}>
		<section class="legal-section">
			<h1>{t("page_legal.meta_title")}</h1>
			<ul class="legal-list">
				{legalDocs.map((doc) => (
					<li class="legal-item">
						<h3><a href={getRelativeLocaleUrl(`/legal/${doc.id.replace(`${activeLocale}/`, "")}/`)}>{doc.data.title}</a></h3>
						<p>{doc.data.description}</p>
						<span class="date">{t("legal.lastUpdated")} {doc.data.pubDate.toLocaleDateString()}</span>
					</li>
				))}
			</ul>
		</section>
</AppLayout>