---
import BlankLayout from "@/layouts/BlankLayout.astro"

interface Props {
  title: string
  notes?: string[]
}

const { title, notes = [] } = Astro.props
const locale = Astro.currentLocale ?? "en"
---

<BlankLayout title={`${title} - Email Preview`} description={`Preview of the ${title} email template`}>
    <style slot="head" is:global>
      *, *::before, *::after { box-sizing: border-box; }
      html body { background: #eef0f4; color: #1f2937; font-family: system-ui, sans-serif; margin: 0; padding: 40px 20px; }
      .rla-main-container { min-height: auto; padding-top: 0; }
      .email-preview-container { display: block; width: 100%; max-width: 680px; margin: 0 auto; }
      .email-preview-container header { background: linear-gradient(135deg, #6d4aff, #8a6dff); color: white; padding: 24px; text-align: center; border-radius: 12px 12px 0 0; }
      .email-preview-container header h1 { margin: 0; font-size: 20px; }
      .email-preview-frame { background: #fafafa; border: 2px solid #d1d5db; padding: 24px; position: relative; }
      .email-preview-label, .email-preview-boundary-label { position: absolute; padding: 4px 10px; border-radius: 4px; font-size: 10px; font-weight: 600; letter-spacing: .5px; }
      .email-preview-label { top: -12px; left: 16px; background: #d1d5db; color: #374151; }
      .email-preview-content { width: 100%; max-width: 600px; margin: 0 auto; background: white; border: 2px dashed #6d4aff; border-radius: 6px; padding: 0; position: relative; }
      .email-preview-boundary-label { top: -13px; right: 16px; background: #6d4aff; color: white; }
      .email-preview-notes { margin-top: 24px; padding: 16px; background: #fffbeb; border-left: 4px solid #d97706; border-radius: 4px; color: #451a03; }
      .email-preview-notes h2 { margin: 0 0 8px; font-size: 1rem; color: #78350f; }
      .email-preview-notes ul { margin: 0; padding-left: 20px; }
      .email-preview-back-link { display: block; text-align: center; margin-top: 24px; color: #374151; }
    </style>
    <main class="email-preview-container">
      <header><h1>{title}</h1></header>
      <div class="email-preview-frame">
        <span class="email-preview-label">PREVIEW MODE</span>
        <div class="email-preview-content">
          <span class="email-preview-boundary-label">EMAIL CONTENT</span>
          <slot />
        </div>
      </div>
      {notes.length > 0 && (
        <div class="email-preview-notes">
          <h2>Notes</h2>
          <ul>{notes.map((note) => <li>{note}</li>)}</ul>
        </div>
      )}
      <a href={`/${locale}/dev/email`} class="email-preview-back-link">← Back to preview index</a>
    </main>
</BlankLayout>
