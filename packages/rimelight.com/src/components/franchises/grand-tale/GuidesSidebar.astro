---
import { getRelativeLocaleUrl } from 'astro:i18n';

const activeLocale = Astro.currentLocale ?? 'en';

const sections = [
	{
		label: 'Guides Explorer',
		items: [
			{ label: 'Featured Guides', to: '/franchises/grand-tale/guides' }
		]
	},
	{
		label: 'Categories',
		items: [
			{ label: 'New Players', to: '/franchises/grand-tale/guides/getting-started' },
			{ label: 'Hero Builds', to: '/franchises/grand-tale/guides/builds' },
			{ label: 'Endgame Content', to: '/franchises/grand-tale/guides/endgame' },
			{ label: 'Resources & Crafting', to: '/franchises/grand-tale/guides/crafting' }
		]
	},
	{
		label: 'Media',
		items: [
			{ label: 'Video Guides', to: '/franchises/grand-tale/guides/videos' }
		]
	},
	{
		label: 'Tools',
		items: [
			{ label: 'Build Planners', to: '/franchises/grand-tale/guides/build-planners' },
			{ label: 'Calculators', to: '/franchises/grand-tale/guides/calculators' }
		]
	}
];
---

<div class="flex flex-col gap-6 px-4 py-6 bg-indigo-950/20 rounded-2xl border border-indigo-900/30">
	{sections.map((section) => (
		<div class="flex flex-col gap-2">
			<span class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest opacity-60 px-2">
				{section.label}
			</span>
			<nav class="flex flex-col gap-1">
				{section.items.map((item) => (
					<a
						href={getRelativeLocaleUrl(activeLocale, item.to)}
						class="text-sm font-medium text-indigo-300 hover:text-white transition-colors px-2 py-1.5 rounded-lg hover:bg-indigo-900/20"
					>
						{item.label}
					</a>
				))}
			</nav>
		</div>
	))}
</div>
