---
import RLASelect from "@rimelight/ui/components/astro/RLASelect.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLAPopover from "@rimelight/ui/components/astro/RLAPopover.astro";
import { scv } from "css-variants";

interface Props {
  component?: string;
  componentName?: string;
  slots?: string[];
  props?: Record<string, any>;
  class?: string;
  title?: string;
  description?: string;
  playground?: string;
  propsConfig?: Record<string, string[]>;
  defaultProps?: Record<string, string>;
  togglingPattern?: "icon" | "select-option" | "tab-segmented" | "pill-toggle";
  theme?: any;
}

const {
  class: className,
  title,
  description,
  playground,
  component,
  componentName,
  propsConfig,
  defaultProps,
  togglingPattern = "tab-segmented",
  theme
} = Astro.props;

let resolvedComponentName = componentName || component || "";
if (!resolvedComponentName) {
  const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
  const lastSegment = pathSegments[pathSegments.length - 1];
  if (lastSegment) {
    resolvedComponentName = 'RLA' + lastSegment.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join('');
  }
}
const isDynamic = !!propsConfig;
const propKeys = propsConfig ? Object.keys(propsConfig) : [];

// If select-option pattern is used, we inject the special compare option to each config
let resolvedPropsConfig = { ...propsConfig };
if (isDynamic && togglingPattern === "select-option") {
  resolvedPropsConfig = {};
  for (const key of propKeys) {
    resolvedPropsConfig[key] = [...propsConfig[key], "— Compare All —"];
  }
}

// Load theme and pre-calculate all variant classes at build-time (server-side)
let resolvedTheme = theme;
const componentKey = resolvedComponentName.replace(/^RL[AV]/, '').toLowerCase(); // e.g. "button"
let combinationClasses = {};
let initialThemeClasses = {};

if (componentKey) {
  if (!resolvedTheme) {
    try {
      const module = await import(`../../../ui/src/themes/${componentKey}.theme.ts`);
      resolvedTheme = module.default;
    } catch (e) {
      console.warn(`Could not load theme for component: ${resolvedComponentName}`);
    }
  }

  if (resolvedTheme) {
    try {
      const resolver = scv(resolvedTheme);
      
      // Calculate baseline classes for initial/default variants
      const initialVariants = {
        ...resolvedTheme.defaultVariants,
        ...defaultProps
      };
      initialThemeClasses = resolver(initialVariants);

      if (isDynamic) {
        // Generate classes for all combinations of configured props
        const keys = Object.keys(propsConfig || {});
        const getCombinations = (index, current) => {
          if (index === keys.length) {
            const activeVariants = {
              ...resolvedTheme.defaultVariants,
              ...defaultProps,
              ...current
            };
            const resolved = resolver(activeVariants);
            const keyStr = keys.map(k => `${k}:${current[k]}`).join('|');
            combinationClasses[keyStr] = resolved;
            return;
          }
          
          const key = keys[index];
          const vals = propsConfig[key] || [];
          vals.forEach(val => {
            current[key] = val;
            getCombinations(index + 1, { ...current });
          });
        };
        
        getCombinations(0, {});
      }
    } catch (err) {
      console.error(`Failed to pre-resolve classes for: ${resolvedComponentName}`, err);
    }
  }
}
---

<div class={`component-showcase border border-border rounded-xl overflow-visible bg-background text-foreground my-6 ${isDynamic ? "dynamic-showcase" : ""} ${className}`} data-component={resolvedComponentName} data-props={JSON.stringify(propKeys)} data-config={JSON.stringify(propsConfig || {})} data-pattern={togglingPattern} data-combinations={JSON.stringify(combinationClasses)} data-initial-theme={JSON.stringify(initialThemeClasses)} data-theme-slots={JSON.stringify(resolvedTheme?.slots || [])}>
  {(title || description) && (
    <div class="px-4 py-3 border-b border-border bg-muted/10">
      {title && <h4 class="text-sm font-semibold m-0 text-foreground">{title}</h4>}
      {description && <p class="text-xs text-muted-foreground mt-1 mb-0">{description}</p>}
    </div>
  )}

  <!-- Dynamic Props Configuration Area -->
  {isDynamic && (
    <div class="flex flex-wrap items-center gap-6 px-4 py-3 bg-muted/20 border-b border-border justify-between w-full">
      <div class="flex flex-wrap items-center gap-6">
        {propKeys.map((prop) => (
          <div class="flex items-center gap-2 prop-control-group" data-prop={prop}>
            <label class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">{prop}:</label>
            <div class="flex items-center gap-1.5">
              <RLASelect
                items={resolvedPropsConfig[prop]}
                value={defaultProps ? defaultProps[prop] : ""}
                name={prop}
                size="sm"
              />
              {togglingPattern === "icon" && propsConfig[prop].length > 1 && (
                <RLAButton class="compare-prop-btn" size="sm" variant="ghost" color="neutral" title={`Compare all ${prop}s`} square>
                  <span class="i-lucide-layout-grid size-3.5"></span>
                </RLAButton>
              )}
              {togglingPattern === "pill-toggle" && propsConfig[prop].length > 1 && (
                <RLAButton class="compare-prop-btn" size="xs" variant="outline" color="neutral" rounded title={`Compare all ${prop}s`}>
                  Compare
                </RLAButton>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Segmented Control for Layout Mode -->
      {togglingPattern === "tab-segmented" && (
        <div class="flex items-center gap-1 bg-muted/40 p-0.5 rounded-lg border border-border/40 mode-segmented-control ml-auto">
          <RLAButton class="mode-tab active bg-background text-foreground shadow-xs border border-border/40" size="xs" variant="ghost" color="neutral" data-mode="single">Single Preview</RLAButton>
          <RLAButton class="mode-tab text-muted-foreground" size="xs" variant="ghost" color="neutral" data-mode="compare">Compare All</RLAButton>
        </div>
      )}
    </div>
  )}

  <!-- Tabs & Actions Controls Area -->
  <div class="controls-area px-4 py-2 bg-muted/30 border-b border-border flex items-center justify-between gap-4">
    <div class="flex flex-wrap items-center gap-4">
      <div class="flex items-center gap-2">
         <RLAButton class="showcase-tab active bg-background text-foreground shadow-sm border border-border" size="sm" variant="ghost" color="neutral" data-lang="astro">Astro</RLAButton>
         <RLAButton class="showcase-tab text-muted-foreground" size="sm" variant="ghost" color="neutral" data-lang="vue">Vue</RLAButton>
      </div>
    </div>

    <div class="flex items-center gap-1.5">
         <RLAPopover class="highlight-slots-wrapper" placement="bottom" ui={{ content: "right-0 w-80 text-xs flex flex-col gap-3" }}>
            <RLAButton slot="trigger" class="highlight-slots" size="sm" variant="ghost" color="neutral" title="Highlight component slots" square>
               <span class="i-lucide-boxes size-4"></span>
            </RLAButton>
            <div class="flex items-center justify-between border-b border-border pb-2">
              <span class="font-semibold text-sm text-foreground">Theme slots</span>
              <span class="text-[10px] text-muted-foreground bg-muted px-1.5 py-0.5 rounded">Visualizer</span>
            </div>
            <div class="slots-list flex flex-col gap-3 max-h-60 overflow-y-auto pr-1">
              <!-- Slots populated by JS -->
            </div>
         </RLAPopover>
         <RLAButton href={playground || "#"} target={playground ? "_blank" : undefined} rel="noopener noreferrer" class="open-playground" size="sm" variant="ghost" color="neutral" title="Open in Playground" square>
            <span class="i-lucide-flask-conical size-4"></span>
         </RLAButton>
    </div>
  </div>

  <!-- Preview Area -->
  <div class="preview-area p-4 sm:p-6 flex items-center justify-center min-h-[120px] border-b border-border relative">
    <div class="absolute top-2 right-2">
        <div class="text-xs bg-muted text-muted-foreground px-2 py-1 rounded border border-border">Preview</div>
    </div>
    <div class="preview-slot-wrapper flex items-center justify-center w-full">
      <slot />
    </div>
  </div>

  <!-- Code Block Area -->
  <div class="code-area bg-gray-950 relative">
    <div class="absolute top-[6px] right-2 z-10">
      <RLAButton class="copy-code" size="sm" variant="ghost" color="neutral" title="Copy code" square>
        <span class="i-lucide-copy size-4"></span>
      </RLAButton>
    </div>

    {isDynamic ? (
      <Fragment>
        <div class="code-block" data-lang="astro">
          <pre class="shiki language-astro !bg-transparent !m-0 !p-4"><code class="dynamic-code-astro text-sm text-gray-300 font-mono"></code></pre>
        </div>
        <div class="code-block hidden" data-lang="vue">
          <pre class="shiki language-vue !bg-transparent !m-0 !p-4"><code class="dynamic-code-vue text-sm text-gray-300 font-mono"></code></pre>
        </div>
      </Fragment>
    ) : (
      <Fragment>
        <div class="code-block" data-lang="astro">
            <slot name="code-astro" />
        </div>
        <div class="code-block hidden" data-lang="vue">
            <slot name="code-vue" />
        </div>
      </Fragment>
    )}
  </div>
</div>

<style>
  .component-showcase {
    margin-block: 1.5rem;
    overflow: visible;
  }

  .component-showcase > :first-child {
    border-top-left-radius: 0.75rem;
    border-top-right-radius: 0.75rem;
  }

  .component-showcase > :last-child,
  .component-showcase > :last-child pre,
  .component-showcase > :last-child code {
    border-bottom-left-radius: 0.75rem;
    border-bottom-right-radius: 0.75rem;
  }

  .showcase-tab.active {
    color: var(--color-primary-500);
  }

  .code-area :global(pre),
  .code-area :global(code) {
    background-color: transparent !important;
    background: transparent !important;
    margin: 0 !important;
    border-radius: 0 !important;
    border-width: 0 !important;
  }

  .code-area :global(pre) {
    padding: 1rem !important;
  }

  /* Slot Visualizer */
  .highlight-slots.active {
    background-color: var(--color-primary-500, #ef4444);
    color: white;
  }
</style>

<script>
  // Slot visualizer: refresh after dynamic content swaps
  function refreshSlotVisualizer(showcase) {
    const s = showcase.slotVis;
    if (!s) return;
    
    const slotsList = showcase.querySelector('.slots-list');
    if (!slotsList) return;

    slotsList.innerHTML = '';

    let themeSlots = JSON.parse(showcase.getAttribute('data-theme-slots') || '[]');
    const previewWrapper = showcase.querySelector('.preview-slot-wrapper');
    const previewArea = showcase.querySelector('.preview-area');

    if (themeSlots.length === 0 && previewWrapper) {
      const DOMSlots = new Set();
      Array.from(previewWrapper.querySelectorAll('[data-slot]')).forEach(el => {
        DOMSlots.add(el.getAttribute('data-slot'));
      });
      const firstChild = previewWrapper.firstElementChild;
      if (firstChild) {
        DOMSlots.add(firstChild.getAttribute('data-slot') || 'root');
      }
      themeSlots = Array.from(DOMSlots).filter(Boolean);
    }

    if (themeSlots.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'text-muted-foreground text-center py-4 font-sans';
      empty.textContent = 'No theme slots defined';
      slotsList.appendChild(empty);
      return;
    }
    
    // Get currently active classes for each slot
    let resolvedSlots = {};
    if (showcase.classList.contains('dynamic-showcase')) {
      const propKeys = JSON.parse(showcase.getAttribute('data-props') || '[]');
      const currentProps = {};
      propKeys.forEach((prop) => {
        const input = showcase.querySelector(`input[name="${prop}"]`);
        if (input) currentProps[prop] = input.value;
      });
      const combinationClasses = JSON.parse(showcase.getAttribute('data-combinations') || '{}');
      const keyStr = propKeys.map(k => `${k}:${currentProps[k]}`).join('|');
      resolvedSlots = combinationClasses[keyStr] || {};
    }
    
    const initialThemeClasses = JSON.parse(showcase.getAttribute('data-initial-theme') || '{}');
    
    // Determine which slot is the default slot for this component
    let defaultSlotName = '';
    if (themeSlots.includes('default')) {
      defaultSlotName = 'default';
    } else if (themeSlots.includes('content')) {
      defaultSlotName = 'content';
    } else if (themeSlots.includes('label')) {
      defaultSlotName = 'label';
    }
    
    themeSlots.forEach(slot => {
      let targets = [];
      if (previewWrapper) {
        if (slot === 'root') {
          const roots = Array.from(previewWrapper.querySelectorAll('[data-slot="root"]'));
          if (roots.length > 0) {
            targets = roots;
          } else {
            const children = Array.from(previewWrapper.children);
            if (children.length === 1 && (children[0].classList.contains('flex') || children[0].classList.contains('grid'))) {
              targets = Array.from(children[0].children);
            } else {
              targets = children;
            }
          }
        } else {
          const kebabSlot = slot.replace(/([A-Z])/g, "-$1").toLowerCase();
          targets = Array.from(previewWrapper.querySelectorAll(`[data-slot="${slot}"], [data-slot="${kebabSlot}"]`));
          
          if (targets.length === 0 && (slot === 'label' || slot === 'content' || slot === 'default')) {
            const roots = Array.from(previewWrapper.querySelectorAll('[data-slot="root"]'));
            const actualRoots = roots.length > 0 ? roots : Array.from(previewWrapper.children);
            
            // Build a list of all other slot names in kebab-case and camelCase to exclude
            const otherSlotsKebab = themeSlots
              .filter(s => s !== slot)
              .map(s => s.replace(/([A-Z])/g, "-$1").toLowerCase());
            const otherSlotsSet = new Set(otherSlotsKebab);
            themeSlots.filter(s => s !== slot).forEach(s => otherSlotsSet.add(s));

            actualRoots.forEach(rootEl => {
              Array.from(rootEl.children).forEach(child => {
                const childSlot = child.getAttribute('data-slot');
                if (!childSlot || childSlot === slot || childSlot === 'default') {
                  const childSlotKebab = childSlot ? childSlot.replace(/([A-Z])/g, "-$1").toLowerCase() : '';
                  if (!otherSlotsSet.has(childSlotKebab) && !otherSlotsSet.has(childSlot || '')) {
                    targets.push(child);
                  }
                }
              });
            });
          }
        }
      }

      const isRendered = targets.length > 0;
      
      let classes = '';
      if (isRendered) {
        classes = targets[0].className;
      } else {
        const camelSlot = slot.replace(/-([a-z])/g, g => g[1].toUpperCase());
        classes = resolvedSlots[camelSlot] || resolvedSlots[slot] || initialThemeClasses[camelSlot] || initialThemeClasses[slot] || '';
      }

      classes = classes.split(/\s+/).filter(Boolean).join(' ');

      const item = document.createElement('div');
      item.className = 'slot-item p-2 rounded-lg hover:bg-muted/50 border border-transparent hover:border-border transition-all cursor-pointer text-left';
      item.innerHTML = `
        <div class="flex items-center justify-between gap-2 mb-1">
          <span class="font-mono font-medium text-foreground text-xs">${slot}${slot === defaultSlotName ? ' <span class="text-[10px] text-muted-foreground/80 font-sans font-normal lowercase">(default)</span>' : ''}</span>
          ${isRendered ? '' : '<span class="text-[10px] text-destructive font-sans font-medium px-1.5 py-0.5 bg-destructive/10 rounded-full">not rendered</span>'}
        </div>
        <div class="classes-container font-mono text-[10px] text-muted-foreground break-all whitespace-normal line-clamp-2 transition-all">
          ${classes || '(no classes)'}
        </div>
        ${classes ? '<div class="expand-hint text-[9px] text-muted-foreground/60 mt-1 select-none font-sans">Click to expand</div>' : ''}
      `;

      if (classes) {
        item.addEventListener('click', (e) => {
          e.stopPropagation();
          const container = item.querySelector('.classes-container');
          const hint = item.querySelector('.expand-hint');
          if (container && hint) {
            const isExpanded = container.classList.contains('line-clamp-none');
            if (isExpanded) {
              container.classList.remove('line-clamp-none');
              container.classList.add('line-clamp-2');
              hint.textContent = 'Click to expand';
            } else {
              container.classList.remove('line-clamp-2');
              container.classList.add('line-clamp-none');
              hint.textContent = 'Click to collapse';
            }
          }
        });
      }

      if (isRendered) {
        item.addEventListener('mouseenter', () => {
          if (!previewArea) return;
          
          if (s.overlays) {
            s.overlays.forEach(o => o.remove());
          }
          s.overlays = [];

          const areaRect = previewArea.getBoundingClientRect();

          targets.forEach(targetEl => {
            const rect = targetEl.getBoundingClientRect();
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:absolute;pointer-events:none;z-index:10;transition:all 150ms ease;border:2px dashed #ef4444;border-radius:4px;';
            const label = document.createElement('span');
            label.style.cssText = 'position:absolute;top:-20px;left:-2px;font-size:11px;font-weight:600;background:#ef4444;color:white;padding:1px 6px;border-radius:3px;white-space:nowrap;font-family:monospace;line-height:1.4;';
            label.textContent = slot;
            overlay.appendChild(label);
            
            overlay.style.top = (rect.top - areaRect.top - 2) + 'px';
            overlay.style.left = (rect.left - areaRect.left - 2) + 'px';
            overlay.style.width = (rect.width + 4) + 'px';
            overlay.style.height = (rect.height + 4) + 'px';
            
            previewArea.appendChild(overlay);
            s.overlays.push(overlay);
          });
        });

        item.addEventListener('mouseleave', () => {
          if (s.overlays) {
            s.overlays.forEach(o => o.remove());
            s.overlays = null;
          }
        });
      }

      slotsList.appendChild(item);

      // Check if text is actually cropped/clamped, otherwise hide the expand hint
      const container = item.querySelector('.classes-container');
      const hint = item.querySelector('.expand-hint');
      if (container && hint) {
        if (container.scrollHeight <= container.clientHeight) {
          hint.remove();
        }
      }
    });
  }

  // Helper to get static/custom classes of an element (classes not managed by theme defaults)
  function getCustomClasses(element, initialClassesForSlot) {
    if (!element) return [];
    const currentClasses = element.className.split(/\s+/).filter(Boolean);
    const initialSet = new Set(initialClassesForSlot.split(/\s+/).filter(Boolean));
    return currentClasses.filter(c => !initialSet.has(c));
  }

  function initShowcases() {
    document.querySelectorAll('.component-showcase').forEach(showcase => {
      const tabs = showcase.querySelectorAll('.showcase-tab');
      const codeBlocks = showcase.querySelectorAll('.code-block');
      const copyBtn = showcase.querySelector('.copy-code');

      // Tabbing behavior
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const lang = tab.getAttribute('data-lang');

          tabs.forEach(t => {
            t.classList.remove('active', 'bg-background', 'text-foreground', 'shadow-sm', 'border', 'border-border');
            t.classList.add('text-muted-foreground');
          });

          tab.classList.add('active', 'bg-background', 'text-foreground', 'shadow-sm', 'border', 'border-border');
          tab.classList.remove('text-muted-foreground');

          codeBlocks.forEach(block => {
            if (block.getAttribute('data-lang') === lang) {
              block.classList.remove('hidden');
            } else {
              block.classList.add('hidden');
            }
          });
        });
      });

      // Copy code behavior
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const visibleCode = showcase.querySelector('.code-block:not(.hidden) code, .code-block:not(.hidden) pre');
          if (visibleCode) {
            navigator.clipboard.writeText(visibleCode.textContent || '');
            const icon = copyBtn.querySelector('span');
            if (icon) {
              icon.className = 'i-lucide-check size-4 text-green-500';
              setTimeout(() => {
                icon.className = 'i-lucide-copy size-4';
              }, 2000);
            }
          }
        });
      }

      // === Slot Visualizer ===
      const highlightBtn = showcase.querySelector('.highlight-slots');
      const popoverContent = showcase.querySelector('.popover-content');
      const svState = showcase.slotVis = { active: false, overlays: null };

      function svDeactivate() {
        svState.active = false;
        highlightBtn?.classList.remove('active');
        if (svState.overlays) {
          svState.overlays.forEach(o => o.remove());
          svState.overlays = null;
        }
      }

      function svActivate() {
        svState.active = true;
        highlightBtn?.classList.add('active');
        refreshSlotVisualizer(showcase);
      }

      svState.activate = svActivate;
      svState.deactivate = svDeactivate;

      if (popoverContent) {
        popoverContent.addEventListener('popover-toggle', (e) => {
          const isOpen = e.detail && e.detail.open;
          if (isOpen) {
            svActivate();
          } else {
            svDeactivate();
          }
        });
      }
    });

    // Apply pre-resolved theme classes dynamically while preserving custom static classes
    function applyStylesToClone(clone, originalTemplate, resolvedSlots, initialThemeClasses) {
      if (!resolvedSlots) return;
      
      const elementsToUpdate = [];
      if (clone.getAttribute('data-slot')) {
        elementsToUpdate.push({ el: clone, orig: originalTemplate, slot: clone.getAttribute('data-slot') });
      } else {
        elementsToUpdate.push({ el: clone, orig: originalTemplate, slot: 'root' });
      }
      
      clone.querySelectorAll('[data-slot]').forEach(el => {
        const slotName = el.getAttribute('data-slot');
        const origEl = originalTemplate.querySelector(`[data-slot="${slotName}"]`);
        elementsToUpdate.push({ el, orig: origEl, slot: slotName });
      });
      
      elementsToUpdate.forEach(({ el, orig, slot }) => {
        if (!el) return;
        const camelSlot = slot.replace(/-([a-z])/g, g => g[1].toUpperCase());
        const themeClasses = resolvedSlots[camelSlot] || resolvedSlots[slot] || '';
        const initialClasses = initialThemeClasses[camelSlot] || initialThemeClasses[slot] || '';
        
        const customClasses = getCustomClasses(orig, initialClasses);
        
        const finalClasses = [...themeClasses.split(/\s+/), ...customClasses]
          .filter(Boolean)
          .join(' ')
          .replace(/\s+/g, ' ')
          .trim();
          
        el.className = finalClasses;
      });
    }

    // Initialize Dynamic Showcases
    document.querySelectorAll('.dynamic-showcase').forEach(node => {
      const showcase = node;
      const componentName = showcase.getAttribute('data-component');
      const propKeys = JSON.parse(showcase.getAttribute('data-props') || '[]');
      const propsConfig = JSON.parse(showcase.getAttribute('data-config') || '{}');
      const togglingPattern = showcase.getAttribute('data-pattern') || 'icon';
      
      const combinationClasses = JSON.parse(showcase.getAttribute('data-combinations') || '{}');
      const initialThemeClasses = JSON.parse(showcase.getAttribute('data-initial-theme') || '{}');
      
      const codeAstroElement = showcase.querySelector('.dynamic-code-astro');
      const codeVueElement = showcase.querySelector('.dynamic-code-vue');
      const previewWrapper = showcase.querySelector('.preview-slot-wrapper');
      
      const compareButtons = showcase.querySelectorAll('.compare-prop-btn');
      const modeTabs = showcase.querySelectorAll('.mode-tab');
      
      let comparedProp = null;

      const originalTemplate = previewWrapper?.firstElementChild?.cloneNode(true);

      function updateComponent() {
        if (!originalTemplate || !previewWrapper) return;

        const currentProps = {};
        
        propKeys.forEach((prop) => {
          const input = showcase.querySelector(`input[name="${prop}"]`);
          if (input) {
            currentProps[prop] = input.value;
          }
        });

        if (togglingPattern === "select-option") {
          comparedProp = null;
          propKeys.forEach((prop) => {
            if (currentProps[prop] === "— Compare All —") {
              comparedProp = prop;
            }
          });

          propKeys.forEach((prop) => {
            const selectWrapper = showcase.querySelector(`.prop-control-group[data-prop="${prop}"] rla-select`);
            if (selectWrapper) {
              if (comparedProp && prop !== comparedProp) {
                selectWrapper.setAttribute('disabled', 'true');
                selectWrapper.classList.add('opacity-50', 'pointer-events-none');
              } else {
                selectWrapper.removeAttribute('disabled');
                selectWrapper.classList.remove('opacity-50', 'pointer-events-none');
              }
            }
          });
        }

        if (comparedProp && propsConfig[comparedProp]) {
          previewWrapper.innerHTML = '';
          const grid = document.createElement('div');
          grid.className = "flex flex-wrap gap-4 items-center justify-center w-full";
          
          propsConfig[comparedProp].forEach(val => {
            const clone = originalTemplate.cloneNode(true);
            
            const activeVariants = { ...currentProps };
            activeVariants[comparedProp] = val;
            
            const keyStr = propKeys.map(k => `${k}:${activeVariants[k]}`).join('|');
            const resolvedSlots = combinationClasses[keyStr];
            
            if (resolvedSlots) {
              applyStylesToClone(clone, originalTemplate, resolvedSlots, initialThemeClasses);
            }
            
            const labelEl = clone.querySelector('[data-slot="label"]') || (clone.getAttribute('data-slot') === 'label' ? clone : null);
            if (labelEl) {
              labelEl.textContent = val;
            }
            
            grid.appendChild(clone);
          });
          previewWrapper.appendChild(grid);
        } else {
          previewWrapper.innerHTML = '';
          const clone = originalTemplate.cloneNode(true);
          
          const keyStr = propKeys.map(k => `${k}:${currentProps[k]}`).join('|');
          const resolvedSlots = combinationClasses[keyStr];

          if (resolvedSlots) {
            applyStylesToClone(clone, originalTemplate, resolvedSlots, initialThemeClasses);
          }
          
          previewWrapper.appendChild(clone);
        }

        let astroCode = '';
        let vueCode = '';
        const vueComponentName = componentName.replace(/^RLA/, 'RLV');

        if (comparedProp && propsConfig[comparedProp]) {
          let astroBody = '';
          let vueBody = '';
          propsConfig[comparedProp].forEach(val => {
            let propString = '';
            propKeys.forEach((key) => {
              const pVal = key === comparedProp ? val : currentProps[key];
              if (pVal) propString += ` ${key}="${pVal}"`;
            });
            
            astroBody += `  \x3c${componentName}${propString} \x3e${val}\x3c/${componentName}\x3e\n`;
            vueBody += `    \x3c${vueComponentName}${propString} \x3e${val}\x3c/${vueComponentName}\x3e\n`;
          });

          astroCode = `---\nimport ${componentName} from "@rimelight/ui/components/astro/${componentName}.astro";\n---\n\n\x3cdiv class="flex gap-4"\x3e\n${astroBody}\x3c/div\x3e`;

          vueCode = `\x3cscript setup\x3e\nimport ${vueComponentName} from "@rimelight/ui/components/vue/${vueComponentName}.vue";\n\x3c/script\x3e\n\n\x3ctemplate\x3e\n  \x3cdiv class="flex gap-4"\x3e\n${vueBody}  \x3c/div\x3e\n\x3c/template\x3e`;
        } else {
          let propString = '';
          propKeys.forEach((key) => {
            const val = currentProps[key];
            if (val) propString += ` ${key}="${val}"`;
          });

          astroCode = `---\nimport ${componentName} from "@rimelight/ui/components/astro/${componentName}.astro";\n---\n\n\x3c${componentName}${propString} /\x3e`;

          vueCode = `\x3cscript setup\x3e\nimport ${vueComponentName} from "@rimelight/ui/components/vue/${vueComponentName}.vue";\n\x3c/script\x3e\n\n\x3ctemplate\x3e\n  \x3c${vueComponentName}${propString} /\x3e\n\x3c/template\x3e`;
        }

        if (codeAstroElement) codeAstroElement.textContent = astroCode;
        if (codeVueElement) codeVueElement.textContent = vueCode;

        refreshSlotVisualizer(showcase);
      }

      if (togglingPattern === "icon" || togglingPattern === "pill-toggle") {
        compareButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            const propGroup = btn.closest('.prop-control-group');
            const propName = propGroup?.getAttribute('data-prop');
            
            if (!propName) return;

            if (comparedProp === propName) {
              comparedProp = null;
              if (togglingPattern === "icon") {
                btn.classList.remove('bg-accent', 'text-foreground');
              } else {
                btn.classList.remove('bg-primary-500', 'text-white', 'border-primary-500');
                btn.classList.add('text-muted-foreground', 'border-border/60');
              }
              showcase.querySelectorAll('.prop-control-group rla-select').forEach(sel => {
                sel.removeAttribute('disabled');
                sel.classList.remove('opacity-50', 'pointer-events-none');
              });
            } else {
              comparedProp = propName;
              if (togglingPattern === "icon") {
                compareButtons.forEach(b => b.classList.remove('bg-accent', 'text-foreground'));
                btn.classList.add('bg-accent', 'text-foreground');
              } else {
                compareButtons.forEach(b => {
                  b.classList.remove('bg-primary-500', 'text-white', 'border-primary-500');
                  b.classList.add('text-muted-foreground', 'border-border/60');
                });
                btn.classList.remove('text-muted-foreground', 'border-border/60');
                btn.classList.add('bg-primary-500', 'text-white', 'border-primary-500');
              }
              
              showcase.querySelectorAll('.prop-control-group').forEach(group => {
                const name = group.getAttribute('data-prop');
                const selectWrapper = group.querySelector('rla-select');
                if (name !== comparedProp && selectWrapper) {
                  selectWrapper.setAttribute('disabled', 'true');
                  selectWrapper.classList.add('opacity-50', 'pointer-events-none');
                } else if (selectWrapper) {
                  selectWrapper.removeAttribute('disabled');
                  selectWrapper.classList.remove('opacity-50', 'pointer-events-none');
                }
              });
            }
            
            updateComponent();
          });
        });
      }

      if (togglingPattern === "tab-segmented") {
        modeTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const mode = tab.getAttribute('data-mode');

            modeTabs.forEach(t => {
              t.classList.remove('active', 'bg-background', 'text-foreground', 'shadow-xs', 'border', 'border-border/40');
              t.classList.add('text-muted-foreground');
            });

            tab.classList.add('active', 'bg-background', 'text-foreground', 'shadow-xs', 'border', 'border-border/40');
            tab.classList.remove('text-muted-foreground');

            if (mode === 'compare') {
              comparedProp = propKeys[0];
              showcase.querySelectorAll('.prop-control-group rla-select').forEach(sel => {
                sel.setAttribute('disabled', 'true');
                sel.classList.add('opacity-50', 'pointer-events-none');
              });
            } else {
              comparedProp = null;
              showcase.querySelectorAll('.prop-control-group rla-select').forEach(sel => {
                sel.removeAttribute('disabled');
                sel.classList.remove('opacity-50', 'pointer-events-none');
              });
            }

            updateComponent();
          });
        });
      }

      showcase.addEventListener('change', updateComponent);
      updateComponent();
    });
  }

  document.addEventListener('astro:page-load', initShowcases);
  initShowcases();
</script>
