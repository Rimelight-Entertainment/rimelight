<RLAHeader
	contain={false}
	fixed={true}
	class="bg-black"
>
  <div slot="left" class="flex items-center gap-md">
    <div class="hidden md:flex flex-row gap-md">
      <RLALogo
        variant="logomark"
        class="h-10 w-auto"
        mode="color"
      />
      <RLANavigationMenu
        items={leftLinks}
        variant="link"
        theme="flat"
        ui={{
          viewportWrapper: 'top-[var(--rl-total-header-height,64px)] flex fixed w-screen left-0 right-0 z-[150] mt-0 bg-transparent pointer-events-none',
          viewport: 'w-screen rounded-none border-none shadow-xl mt-0 pointer-events-auto overflow-hidden',
          link: 'text-white transition-colors duration-200 hover:text-primary-400 data-[state=open]:text-primary-400 aria-[current]:text-primary-400'
        }}
      >
