---
import DashboardLayout from './DashboardLayout.astro';
import { getRelativeLocaleUrl } from "@rimelight/i18n";

interface Props {
	title?: string;
	activeTab: 'overview' | 'organizations' | 'teams' | 'users';
}

const { title = 'Admin Panel', activeTab } = Astro.props;


// Auth / permission check
const user = Astro.locals.user;
if (!user || !['admin', 'owner'].includes((user as { role?: string }).role || '')) {
	return Astro.redirect(getRelativeLocaleUrl('/dashboard'));
}

const links = [
	{
		label: 'Overview',
		icon: 'i-lucide-layout-dashboard',
		href: getRelativeLocaleUrl('/dashboard/admin'),
		active: activeTab === 'overview'
	},
	{
		label: 'Organizations',
		icon: 'i-lucide-building-2',
		href: getRelativeLocaleUrl('/dashboard/admin/organizations'),
		active: activeTab === 'organizations'
	},
	{
		label: 'Teams',
		icon: 'i-lucide-users-2',
		href: getRelativeLocaleUrl('/dashboard/admin/teams'),
		active: activeTab === 'teams'
	},
	{
		label: 'Users',
		icon: 'i-lucide-user',
		href: getRelativeLocaleUrl('/dashboard/admin/users'),
		active: activeTab === 'users'
	}
];
---

<DashboardLayout title={title}>
	<div class="p-6 flex flex-col h-full overflow-y-auto">
		<div class="mb-6 flex flex-col gap-1">
			<h1 class="text-2xl font-bold text-neutral-900 dark:text-white flex items-center gap-2">
				<span class="i-lucide-shield-check text-primary-500" />
				Admin Panel
			</h1>
			<p class="text-sm text-neutral-500 dark:text-neutral-400">Manage workspace, teams, users, and global settings.</p>
		</div>

		<div class="border-b border-neutral-200 dark:border-neutral-800 mb-6">
			<nav class="flex gap-4">
				{links.map((link) => (
					<a
						href={link.href}
						class:list={[
							'flex items-center gap-2 px-1 py-3 border-b-2 text-sm font-medium transition-colors',
							link.active
								? 'border-primary-500 text-primary-600 dark:text-primary-400'
								: 'border-transparent text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white'
						]}
					>
						<span class:list={[link.icon, 'size-4']} />
						<span>{link.label}</span>
					</a>
				))}
			</nav>
		</div>

		<div class="flex-1">
			<slot />
		</div>
	</div>
</DashboardLayout>
