---
import RLAHead from '@rimelight/ui/components/astro/RLAHead.astro';
import AppHeader from '@/components/app/AppHeader.astro';
import RLAMain from "@rimelight/ui/components/astro/RLAMain.astro"
import AppFooter from '@/components/app/AppFooter.astro';
import RLAScrollToTop from "@rimelight/ui/components/astro/RLAScrollToTop.astro"
import RLAShortcuts from "@rimelight/ui/components/astro/RLAShortcuts.astro"
import { siteConfig } from '@/config/site.config';
import _css from '@/styles/global.css';
import { Font } from 'astro:assets';
import { currentLocale } from '@rimelight/i18n';

currentLocale.set(Astro.currentLocale ?? 'en');

interface AppLayoutProps {
	title: string;
	description: string;
	ogImageSrc?: string;
	ogImageAlt?: string;
}

const { title, description, ogImageSrc, ogImageAlt } = Astro.props as AppLayoutProps;

const localeMap: Record<string, string> = {
	en: 'en_US',
	pt: 'pt_BR',
	es: 'es_ES',
};
const ogLocale = localeMap[Astro.currentLocale || 'en'] || 'en_US';
---

<!doctype html>
<html lang={Astro.currentLocale || 'en'}>
	<RLAHead title={title} description={description} config={siteConfig} ogLocale={ogLocale} rssFeed={{ href: '/rss.xml', title: siteConfig.name }} ogImage={ogImageSrc ? { src: ogImageSrc, alt: ogImageAlt || '' } : undefined}>
		<slot name="head" slot="head" />
		<Font cssVariable="--font-sans" preload={true} slot="head" />
		<Font cssVariable="--font-serif" preload={true} slot="head" />
		<Font cssVariable="--font-mono" preload={true} slot="head" />
	</RLAHead>
	<meta property="og:image" content={new URL(ogImageSrc || '/og/placeholder.webp', Astro.site).toString()} />
	<body class="isolate">
		<AppHeader />
		<RLAMain>
			<slot />
		</RLAMain>
		<AppFooter />
		<RLAScrollToTop showProgress={true} />
		<RLAShortcuts />
		<script is:inline data-astro-rerun>
			(function() {
				'use strict';
				// Disconnect previous observer on re-run (client-side nav)
				if (window.rlHeaderObserver) window.rlHeaderObserver.disconnect();

				// Initialize global stack singleton (only once)
				if (!window.RLHeaderStack) {
					window.RLHeaderStack = {
						layers: [],
						register: function(id, order, naturalHeight, isVisible, el, type) {
							if (type === undefined) type = el && el.getAttribute ? (el.getAttribute('data-layer-type') || 'header') : 'header';
							let layer = this.layers.find(function(l) { return l.id === id; });
							if (!layer) {
								layer = { id: id, type: type, order: order, naturalHeight: naturalHeight, isVisible: isVisible, el: el };
								this.layers.push(layer);
								this.sortLayers();
							} else {
								layer.naturalHeight = naturalHeight;
								layer.isVisible = isVisible;
								layer.el = el;
							}
							this.update();
						},
						unregister: function(id) {
							this.layers = this.layers.filter(function(l) { return l.id !== id; });
							this.update();
						},
						sortLayers: function() {
							this.layers.sort(function(a, b) {
								if (a.type !== b.type) return a.type === 'banner' ? -1 : 1;
								return a.order - b.order;
							});
						},
						update: function() {
							let currentTop = 0;
							for (let i = 0; i < this.layers.length; i++) {
								const layer = this.layers[i];
								if (layer.el) {
									const topPx = layer.isVisible ? currentTop + 'px' : '-' + layer.naturalHeight + 'px';
									layer.el.style.top = topPx;
									layer.el.style.opacity = layer.isVisible ? '1' : '0';
									layer.el.style.pointerEvents = layer.isVisible ? 'auto' : 'none';
									layer.el.style.setProperty('--rl-header-bottom', 'calc(' + topPx + ' + ' + layer.naturalHeight + 'px)');
								}
								if (layer.isVisible) currentTop += layer.naturalHeight;
							}
							if (currentTop > 0) {
								document.documentElement.style.setProperty('--rl-total-header-height', currentTop + 'px');
							}
						}
					};
				}
				const RL = window.RLHeaderStack;
				// Clear stale layers from previous navigation
				RL.layers = [];

				function getHeight(el) {
					if (!el) return 64;
					const h = el.offsetHeight;
					return h > 0 ? h : 64;
				}

				function initLayer(el) {
					if (el.rlManaged) return;
					el.rlManaged = true;

					const id = el.id;
					const type = el.getAttribute('data-layer-type') || 'header';
					const stackIndex = parseInt(el.getAttribute('data-stack-index') || '0', 10);
					const hideOnScroll = el.getAttribute('data-hide-on-scroll') === 'true';
					const contentEl = el.querySelector('[data-header-content]');
					let naturalHeight = getHeight(contentEl);
					let isVisible = true;

					RL.register(id, stackIndex, naturalHeight, isVisible, el, type);

					if (typeof ResizeObserver !== 'undefined' && contentEl) {
						new ResizeObserver(function(entries) {
							const h = entries[0] && entries[0].contentRect.height;
							if (h && h > 0) {
								naturalHeight = h;
								RL.update();
							}
						}).observe(contentEl);
					}

					if (hideOnScroll) {
						let lastScrollY = window.scrollY;
						window.addEventListener('scroll', function() {
							const current = window.scrollY;
							const diff = current - lastScrollY;
							if (Math.abs(diff) >= 10) {
								const newVisible = current <= 50 ? true : diff <= 0;
								if (newVisible !== isVisible) {
									isVisible = newVisible;
									RL.register(id, stackIndex, naturalHeight, isVisible, el, type);
								}
								lastScrollY = current;
							}
						}, { passive: true });
					}

					(function retry() {
						const h = getHeight(contentEl);
						if (h !== naturalHeight) {
							naturalHeight = h;
							RL.update();
						}
						if (h > 0 && h !== 64 && contentEl && contentEl.offsetHeight > 0) return;
						requestAnimationFrame(retry);
					})();
				}

				function layerSelector() {
					return "[data-rla-header='true'],[data-rla-banner='true']";
				}

				// Init all existing layers
				const layers = document.querySelectorAll(layerSelector());
				for (let i = 0; i < layers.length; i++) initLayer(layers[i]);

				// Watch for new layers (client-side nav) and removals
				window.rlHeaderObserver = new MutationObserver(function(mutations) {
					for (let i = 0; i < mutations.length; i++) {
						const added = mutations[i].addedNodes;
						for (let j = 0; j < added.length; j++) {
							const node = added[j];
							if (node.nodeType !== 1) continue;
							if (node.matches && node.matches(layerSelector())) initLayer(node);
							if (node.querySelectorAll) {
								const nested = node.querySelectorAll(layerSelector());
								for (let k = 0; k < nested.length; k++) initLayer(nested[k]);
							}
						}
						const removed = mutations[i].removedNodes;
						for (let j = 0; j < removed.length; j++) {
							const node = removed[j];
							if (node.nodeType !== 1) continue;
							if (node.matches && node.matches(layerSelector())) RL.unregister(node.id);
							if (node.querySelectorAll) {
								const nested = node.querySelectorAll(layerSelector());
								for (let k = 0; k < nested.length; k++) RL.unregister(nested[k].id);
							}
						}
					}
				});
				window.rlHeaderObserver.observe(document.body, { childList: true, subtree: true });
			})();
		</script>
	</body>
</html>
