---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

export interface Props {
  src: string | ImageMetadata
  alt?: string
  height?: string | number
  width?: string | number
  loading?: "lazy" | "eager"
  fit?: "cover" | "contain" | "fill" | "inside" | "outside"
  class?: string
}

const {
  src,
  alt = "",
  height,
  width,
  loading = "lazy",
  fit = "cover",
  class: className,
} = Astro.props as Props

const isMetadata = typeof src !== "string"
const imgWidth = width ?? (isMetadata ? src.width : undefined)
const imgHeight = height ?? (isMetadata ? src.height : undefined)
const imgFormat = isMetadata ? src.format : undefined
const rawName = typeof src === "string" ? src.split("/").pop() || "image" : src.src.split("/").pop() || "image"
const fileName = rawName.split("?")[0]
const fileExtension = imgFormat?.toUpperCase() || (fileName.includes(".") ? fileName.split(".").pop()?.toUpperCase() : "IMG")
---

<div class:list={["relative inline-block group/image", className]}>
  <button
    type="button"
    class="cursor-pointer overflow-hidden rounded-lg block hover:scale-[1.02] active:scale-95 transition-transform duration-300"
    data-image-trigger
  >
    <Image src={src} alt={alt} width={imgWidth ?? 800} height={imgHeight ?? 400} loading={loading} />
  </button>

  <dialog
    class="backdrop:bg-black/60 max-w-[98vw] sm:max-w-[95vw] w-fit rounded-xl p-0 overflow-hidden border-0 m-auto"
    data-image-dialog
  >
    <div class="flex flex-col gap-md bg-background text-foreground">
      <div class="flex-1 min-h-0 w-full flex items-center justify-center p-4">
        <Image src={src} alt={alt} width={imgWidth ?? 800} height={imgHeight ?? 400} class="object-contain max-w-full max-h-[80vh] rounded-lg" />
      </div>

      <hr class="border-border mx-4" />

      <div class="flex items-center justify-between gap-xl px-4 pb-4">
        <div class="flex flex-col gap-xs text-sm">
          <div class="flex flex-row gap-xs items-center">
            <span class="i-lucide-image size-4 shrink-0 text-muted-foreground" />
            <span class="text-muted-foreground">Source:</span>
            <span class="text-dimmed truncate max-w-[40vw]">{fileName}</span>
          </div>
          <div class="flex flex-row gap-xs items-center">
            <span class="i-lucide-file-question-mark size-4 shrink-0 text-muted-foreground" />
            <span class="text-muted-foreground">Format:</span>
            <span class="text-dimmed">{fileExtension || "IMG"}</span>
          </div>
          <div class="flex flex-row gap-xs items-center">
            <span class="i-lucide-image-upscale size-4 shrink-0 text-muted-foreground" />
            <span class="text-muted-foreground">Dimensions:</span>
            <span class="text-dimmed">{(imgWidth || "?")} x {(imgHeight || "?")}</span>
          </div>
          <div class="flex flex-row gap-xs items-center">
            <span class="i-lucide-align-left size-4 shrink-0 text-muted-foreground" />
            <span class="text-muted-foreground">Alt:</span>
            <span class="text-dimmed truncate max-w-[30vw]" class:list={{ "italic opacity-50": !alt }}>{alt || "none"}</span>
          </div>
        </div>

        <button
          type="button"
          class="inline-flex items-center justify-center rounded-md font-medium transition-colors outline-none h-9 px-4 py-2 text-sm gap-2 text-primary-500 hover:bg-primary-500/10 active:bg-primary-500/10"
          data-image-download
        >
          <span class="i-lucide-download size-4 shrink-0" />
          Download Original
        </button>
      </div>

      <form method="dialog" class="absolute top-2 right-2">
        <button
          type="submit"
          class="inline-flex items-center justify-center size-8 rounded-full bg-background/80 hover:bg-accent text-muted-foreground hover:text-foreground transition-colors"
          aria-label="Close"
        >
          <span class="i-lucide-x size-4" />
        </button>
      </form>
    </div>
  </dialog>
</div>

<script>
  const triggers = document.querySelectorAll("[data-image-trigger]")
  for (const trigger of triggers) {
    const parent = trigger.closest(".group\\/image") || trigger.parentElement
    const dialog = parent?.querySelector("[data-image-dialog]")
    if (!dialog) continue

    trigger.addEventListener("click", () => { dialog.showModal() })

    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close()
    })

    const downloadBtn = dialog.querySelector("[data-image-download]")
    if (downloadBtn) {
      const img = dialog.querySelector("img")
      downloadBtn.addEventListener("click", async () => {
        const imgSrc = img?.getAttribute("src")
        if (!imgSrc) return
        try {
          const response = await fetch(imgSrc)
          const blob = await response.blob()
          const url = URL.createObjectURL(blob)
          const link = document.createElement("a")
          link.href = url
          const srcAttr = trigger.querySelector("img")?.getAttribute("src") || ""
          const name = (srcAttr.split("/").pop() || "").split("?")[0] || `image-${Date.now()}`
          link.download = name
          document.body.appendChild(link)
          link.click()
          document.body.removeChild(link)
          URL.revokeObjectURL(url)
        } catch (err) {
          console.error("Download failed", err)
        }
      })
    }
  }
</script>
