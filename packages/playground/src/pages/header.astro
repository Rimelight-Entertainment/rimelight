---
import Layout from '../layouts/Layout.astro';
import RLAHeader from '@rimelight/ui/components/astro/RLAHeader.astro';
import RLVHeader from '@rimelight/ui/components/vue/RLVHeader.vue';
---

<Layout title="Header Showcase — Rimelight UI">
  <p class="subtitle"><code>RLAHeader</code> (Astro) vs <code>RLVHeader</code> (Vue) — slot-based structural component.</p>

  <div class="tabs" id="hdr-tabs">
    <button class="tab active" data-tab="astro" onclick="switchTabHeader('hdr-tabs','astro')">Astro</button>
    <button class="tab" data-tab="vue" onclick="switchTabHeader('hdr-tabs','vue')">Vue</button>
  </div>

  <!-- Astro Tab -->
  <div class="tab-panel active" id="hdr-tabs-astro">
    <div class="column">
      <h3>Basic Usage</h3>
      <div class="header-list">
        <div class="header-cell">
          <RLAHeader class="showcase-header">
            <span slot="left" class="header-slot-content">Logo</span>
            <span slot="center" class="header-slot-content">Nav</span>
            <span slot="right" class="header-slot-content">Actions</span>
          </RLAHeader>
        </div>
      </div>

      <h3>Props & Overrides</h3>
      <div class="props-grid">
        <span class="prop-label">contain=false</span>
        <div><RLAHeader contain={false} class="showcase-header">
          <span slot="left" class="header-slot-content">Logo</span>
          <span slot="center" class="header-slot-content">Nav</span>
          <span slot="right" class="header-slot-content">Actions</span>
        </RLAHeader></div>
        <span class="prop-label">ui override</span>
        <div><RLAHeader ui={{ root: 'bg-slate-800 shadow-lg' }} class="showcase-header">
          <span slot="left" class="header-slot-content">Brand</span>
          <span slot="center" class="header-slot-content">Menu</span>
          <span slot="right" class="header-slot-content">Profile</span>
        </RLAHeader></div>
      </div>
    </div>
  </div>

  <!-- Vue Tab -->
  <div class="tab-panel" id="hdr-tabs-vue">
    <div class="column">
      <h3>Basic Usage</h3>
      <div class="header-list">
        <div class="header-cell">
          <RLVHeader client:load class="showcase-header">
            <span slot="left" class="header-slot-content">Logo</span>
            <span slot="center" class="header-slot-content">Nav</span>
            <span slot="right" class="header-slot-content">Actions</span>
          </RLVHeader>
        </div>
      </div>

      <h3>Props & Overrides</h3>
      <div class="props-grid">
        <span class="prop-label">contain=false</span>
        <div><RLVHeader client:load contain={false} class="showcase-header">
          <span slot="left" class="header-slot-content">Logo</span>
          <span slot="center" class="header-slot-content">Nav</span>
          <span slot="right" class="header-slot-content">Actions</span>
        </RLVHeader></div>
        <span class="prop-label">ui override</span>
        <div><RLVHeader client:load ui={{ root: 'bg-slate-800 shadow-lg' }} class="showcase-header">
          <span slot="left" class="header-slot-content">Brand</span>
          <span slot="center" class="header-slot-content">Menu</span>
          <span slot="right" class="header-slot-content">Profile</span>
        </RLVHeader></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .tab {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .tab:hover { color: var(--text); }
  .tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .tab-panel { display: none !important; }
  .tab-panel.active { display: block !important; }

  .column {
    background: var(--surface, #1e293b);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    overflow-x: auto;
  }
  .column h3 {
    color: #e2e8f0;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .header-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .header-cell {
    display: flex;
    justify-content: center;
  }

  .showcase-header {
    width: 100%;
    border-radius: 0.375rem;
  }
  .header-slot-content {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    white-space: nowrap;
  }

  .props-grid {
    display: grid;
    grid-template-columns: 140px 1fr;
    align-items: center;
    gap: 0.5rem;
  }
  .prop-label {
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: capitalize;
    font-weight: 600;
  }
</style>

<script is:inline>
  function switchTabHeader(groupId, tabId) {
    const group = document.getElementById(groupId);
    if (!group) return;
    group.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    group.querySelector(`[data-tab="${tabId}"]`).classList.add('active');
    document.querySelectorAll(`[id^="${groupId}-"]`).forEach(p => {
      p.classList.remove('active');
    });
    document.getElementById(`${groupId}-${tabId}`).classList.add('active');
  }
</script>
