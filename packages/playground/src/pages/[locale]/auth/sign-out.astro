---
import { currentLocale } from 'astro-nanostores-i18n:runtime'

const activeLocale = Astro.currentLocale ?? 'en'
currentLocale.set(activeLocale)

try {
  const { auth } = await import("@/auth/auth")
  const response = await auth.api.signOut({
    headers: Astro.request.headers,
    asResponse: true
  })

  for (const cookie of response.headers.getSetCookie()) {
    Astro.response.headers.append('Set-Cookie', cookie)
  }
} catch (error) {
  console.error("Sign out error:", error)
}

return Astro.redirect(`/${activeLocale}`)
---