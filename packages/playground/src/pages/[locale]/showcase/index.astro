---
import AppLayout from '@/layouts/AppLayout.astro';
---

<AppLayout title="Showcase" description="Component Showcase">
  <main class="max-w-6xl mx-auto p-8">
    <h1 class="text-3xl font-bold mb-4">Showcase</h1>
    <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
      The full component showcase has moved to the <a href="/components" class="text-primary-500 hover:underline">Components</a> page.
    </p>

    <div class="p-6 border border-yellow-200 dark:border-yellow-800 bg-yellow-50 dark:bg-yellow-900/20 rounded-lg">
      <p class="text-yellow-800 dark:text-yellow-200">
        <strong>Note:</strong> This page is deprecated. Please visit the <a href="/components" class="underline font-medium">Components</a> page to see all available components with full Astro and Vue examples.
      </p>
    </div>
  </main>
</AppLayout>
