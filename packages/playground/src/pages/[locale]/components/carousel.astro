---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLACarousel from "@rimelight/ui/components/astro/RLACarousel.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("carouselPage", {
    title: "Carousel Component",
    description: "Carousel Component Showcase",
    heading: "Carousel",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black">
          <RLACarousel items={[
            { id: "1", title: "Slide 1", content: "Beautiful premium gradient 1", class: "bg-gradient-to-r from-blue-500 to-indigo-600 text-white flex items-center justify-center h-48 rounded-lg" },
            { id: "2", title: "Slide 2", content: "Beautiful premium gradient 2", class: "bg-gradient-to-r from-purple-500 to-pink-600 text-white flex items-center justify-center h-48 rounded-lg" },
            { id: "3", title: "Slide 3", content: "Beautiful premium gradient 3", class: "bg-gradient-to-r from-green-500 to-teal-600 text-white flex items-center justify-center h-48 rounded-lg" }
          ]} />
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLACarousel items={[
  { id: "1", title: "Slide 1", class: "bg-blue-500 text-white flex items-center justify-center h-48" }
]} />`}</code></pre>
      </section>
    </div>
</AppLayout>
