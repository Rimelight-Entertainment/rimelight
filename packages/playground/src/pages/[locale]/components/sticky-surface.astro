---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAStickySurface from "@rimelight/ui/components/astro/RLAStickySurface.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("stickysurfacePage", {
    title: "StickySurface Component",
    description: "StickySurface Component Showcase",
    heading: "StickySurface",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black relative h-48 overflow-y-auto">
          <RLAStickySurface class="bg-primary-500 text-white p-2 text-center font-bold sticky top-0 z-10">
            Sticky Surface Banner
          </RLAStickySurface>
          <div class="p-4 space-y-4">
            <p>Scroll down to see the sticky surface overlay mechanism in action...</p>
            <p>Astro sticky layouts lock onto context constraints during layout scroll sequences.</p>
            <p>The premium style blends effortlessly into dark/light mode configurations.</p>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAStickySurface class="sticky top-0">
  Sticky Surface Content
</RLAStickySurface>`}</code></pre>
      </section>
    </div>
</AppLayout>
