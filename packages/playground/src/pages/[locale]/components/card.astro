---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLACard from "@rimelight/ui/components/astro/RLACard.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("cardPage", {
    title: "Card Component",
    description: "Card Component Showcase",
    heading: "Card",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black max-w-md">
          <RLACard title="Create project" description="Deploy your new project in one-click.">
            <div class="space-y-4 py-4">
              <p class="text-sm text-gray-600 dark:text-gray-400">Your project will be deployed instantly across our global premium server network.</p>
            </div>
            <div slot="footer" class="flex justify-between w-full">
              <RLAButton variant="outline">Cancel</RLAButton>
              <RLAButton variant="solid">Deploy</RLAButton>
            </div>
          </RLACard>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLACard title="Create project" description="Deploy your new project in one-click.">
  <p>Your project will be deployed instantly.</p>
  <div slot="footer">
    <RLAButton variant="outline">Cancel</RLAButton>
  </div>
</RLACard>`}</code></pre>
      </section>
    </div>
</AppLayout>
