---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLADrawer from "@rimelight/ui/components/astro/RLADrawer.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("drawerPage", {
    title: "Drawer Component",
    description: "Drawer Component Showcase",
    heading: "Drawer",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black">
          <div class="flex flex-wrap gap-4">
            <RLADrawer title="Drawer" description="Slide out from the bottom." direction="bottom">
              <RLAButton slot="trigger" variant="solid">Open Bottom</RLAButton>
              <div class="py-6">
                <p class="text-sm text-gray-600 dark:text-gray-400">This content is loaded directly inside a bottom drawer overlay.</p>
              </div>
            </RLADrawer>
            <RLADrawer title="Drawer" description="Slide out from the top." direction="top">
              <RLAButton slot="trigger" variant="outline">Open Top</RLAButton>
              <div class="py-6">
                <p class="text-sm text-gray-600 dark:text-gray-400">Top drawer panel variant.</p>
              </div>
            </RLADrawer>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLADrawer title="Drawer Title" description="..." direction="bottom">
  <RLAButton slot="trigger" variant="solid">Open Drawer</RLAButton>
  <div>Drawer Content</div>
</RLADrawer>`}</code></pre>
      </section>
    </div>
</AppLayout>
