---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAInput from "@rimelight/ui/components/astro/RLAInput.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("inputPage", {
    title: "Input Component",
    description: "Input Component Showcase",
    heading: "Input",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black max-w-sm space-y-4">
          <RLAInput type="text" placeholder="Standard input..." />
          <RLAInput type="email" placeholder="you@example.com" />
          <RLAInput type="password" placeholder="••••••••" />
          <RLAInput type="text" placeholder="Disabled input..." disabled />
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAInput type="text" placeholder="Standard input..." />
<RLAInput type="email" placeholder="you@example.com" />`}</code></pre>
      </section>
    </div>
</AppLayout>
