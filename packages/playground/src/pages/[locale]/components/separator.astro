---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLASeparator from "@rimelight/ui/components/astro/RLASeparator.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("separatorPage", {
    title: "Separator Component",
    description: "Separator Component Showcase",
    heading: "Separator",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black max-w-md">
          <div class="space-y-1">
            <h4 class="text-sm font-medium leading-none">Rimelight UI</h4>
            <p class="text-sm text-gray-500">An open-source Astro component library.</p>
          </div>
          <RLASeparator class="my-4" />
          <div class="flex h-5 items-center space-x-4 text-sm font-medium">
            <div>Docs</div>
            <RLASeparator orientation="vertical" />
            <div>Source</div>
            <RLASeparator orientation="vertical" />
            <div>Changelog</div>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLASeparator class="my-4" />
<RLASeparator orientation="vertical" />`}</code></pre>
      </section>
    </div>
</AppLayout>
