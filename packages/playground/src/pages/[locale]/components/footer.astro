---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAFooter from "@rimelight/ui/components/astro/RLAFooter.astro";
import RLVFooter from "@rimelight/ui/components/vue/RLVFooter.vue";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLVButton from "@rimelight/ui/components/vue/RLVButton.vue";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("footerPage", {
    title: "Footer Component",
    description: "Footer Component Showcase",
    heading: "Footer",
    tabAstro: "Astro (RLAFooter)",
    tabVue: "Vue (RLVFooter)",
    default: "Default",
    withContainer: "With Container",
    simpleFooter: "Simple Footer",
    defaultDesc: "A footer with left, center, and right slots.",
    containerDesc: "Footer with contain=true for centered content.",
    simpleDesc: "A simple footer with centered content only.",
    builtWith: "Built with Rimelight UI",
    contact: "Contact",
    allRightsReserved: "© 2026 Rimelight UI. All rights reserved.",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="tab-astro" class="tab-btn px-4 py-2 font-medium border-b-2 border-primary-500 text-primary-500" data-tab="astro">
        {messages.tabAstro}
      </button>
      <button id="tab-vue" class="tab-btn px-4 py-2 font-medium border-b-2 border-transparent hover:text-primary-500" data-tab="vue">
        {messages.tabVue}
      </button>
    </div>

    <!-- Astro Tab Content -->
    <div id="content-astro" class="tab-content space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultDesc}</p>
        <div class="border border-black p-md">
          <RLAFooter>
            <div slot="left">
              <span class="font-bold text-lg">© 2026 Rimelight</span>
            </div>
            <div slot="center">
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">Privacy</a>
                <a href="#" class="hover:text-primary-500">Terms</a>
                <a href="#" class="hover:text-primary-500">Support</a>
              </nav>
            </div>
            <div slot="right">
              <div class="flex gap-2">
                <RLAButton size="sm" square leadingIcon="i-lucide-twitter" variant="ghost" aria-label="Twitter" />
                <RLAButton size="sm" square leadingIcon="i-lucide-github" variant="ghost" aria-label="GitHub" />
              </div>
            </div>
          </RLAFooter>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAFooter>
  <div slot="left">
    <span class="font-bold text-lg">© 2026 Rimelight</span>
  </div>
  <div slot="center">
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Privacy</a>
      <a href="#" class="hover:text-primary-500">Terms</a>
      <a href="#" class="hover:text-primary-500">Support</a>
    </nav>
  </div>
  <div slot="right">
    <div class="flex gap-2">
      <RLAButton size="sm" square leadingIcon="i-lucide-twitter" variant="ghost" aria-label="Twitter" />
      <RLAButton size="sm" square leadingIcon="i-lucide-github" variant="ghost" aria-label="GitHub" />
    </div>
  </div>
</RLAFooter>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withContainer}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.containerDesc}</p>
        <div class="border border-black p-md">
          <RLAFooter contain>
            <div slot="left">
              <span class="font-bold">© 2026 Rimelight</span>
            </div>
            <div slot="center">
              <span class="text-sm text-gray-500">{messages.builtWith}</span>
            </div>
            <div slot="right">
              <RLAButton size="sm" variant="outline">{messages.contact}</RLAButton>
            </div>
          </RLAFooter>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAFooter contain>
  <div slot="left">
    <span class="font-bold">© 2026 Rimelight</span>
  </div>
  <div slot="center">
    <span class="text-sm text-gray-500">Built with Rimelight UI</span>
  </div>
  <div slot="right">
    <RLAButton size="sm" variant="outline">Contact</RLAButton>
  </div>
</RLAFooter>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.simpleFooter}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.simpleDesc}</p>
        <div class="border border-black p-md">
          <RLAFooter>
            <div slot="center">
              <p class="text-sm text-gray-500">{messages.allRightsReserved}</p>
            </div>
          </RLAFooter>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAFooter>
  <div slot="center">
    <p class="text-sm text-gray-500">© 2026 Rimelight UI. All rights reserved.</p>
  </div>
</RLAFooter>`}</code></pre>
      </section>
    </div>

    <!-- Vue Tab Content -->
    <div id="content-vue" class="tab-content space-y-12 hidden">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultDesc}</p>
        <div class="border border-black p-md">
          <RLVFooter client:load>
            <template #left>
              <span class="font-bold text-lg">© 2026 Rimelight</span>
            </template>
            <template #center>
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">Privacy</a>
                <a href="#" class="hover:text-primary-500">Terms</a>
                <a href="#" class="hover:text-primary-500">Support</a>
              </nav>
            </template>
            <template #right>
              <div class="flex gap-2">
                <RLVButton client:load size="sm" square leadingIcon="i-lucide-twitter" variant="ghost" aria-label="Twitter" />
                <RLVButton client:load size="sm" square leadingIcon="i-lucide-github" variant="ghost" aria-label="GitHub" />
              </div>
            </template>
          </RLVFooter>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVFooter client:load>
  <template #left>
    <span class="font-bold text-lg">© 2026 Rimelight</span>
  </template>
  <template #center>
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Privacy</a>
      <a href="#" class="hover:text-primary-500">Terms</a>
      <a href="#" class="hover:text-primary-500">Support</a>
    </nav>
  </template>
  <template #right>
    <div class="flex gap-2">
      <RLVButton size="sm" square leadingIcon="i-lucide-twitter" variant="ghost" aria-label="Twitter" />
      <RLVButton size="sm" square leadingIcon="i-lucide-github" variant="ghost" aria-label="GitHub" />
    </div>
  </template>
</RLVFooter>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withContainer}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.containerDesc}</p>
        <div class="border border-black p-md">
          <RLVFooter client:load contain>
            <template #left>
              <span class="font-bold">© 2026 Rimelight</span>
            </template>
            <template #center>
              <span class="text-sm text-gray-500">{messages.builtWith}</span>
            </template>
            <template #right>
              <RLVButton client:load size="sm" variant="outline">{messages.contact}</RLVButton>
            </template>
          </RLVFooter>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVFooter client:load contain>
  <template #left>
    <span class="font-bold">© 2026 Rimelight</span>
  </template>
  <template #center>
    <span class="text-sm text-gray-500">Built with Rimelight UI</span>
  </template>
  <template #right>
    <RLVButton size="sm" variant="outline">Contact</RLVButton>
  </template>
</RLVFooter>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.simpleFooter}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.simpleDesc}</p>
        <div class="border border-black p-md">
          <RLVFooter client:load>
            <template #center>
              <p class="text-sm text-gray-500">{messages.allRightsReserved}</p>
            </template>
          </RLVFooter>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVFooter client:load>
  <template #center>
    <p class="text-sm text-gray-500">© 2026 Rimelight UI. All rights reserved.</p>
  </template>
</RLVFooter>`}</code></pre>
      </section>
    </div>
</AppLayout>

<script>
  function initTabs() {
    var tabBtns = document.querySelectorAll('.tab-btn');
    var tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tab = btn.getAttribute('data-tab');

        tabBtns.forEach(function(b) {
          b.classList.remove('border-primary-500', 'text-primary-500');
          b.classList.add('border-transparent');
        });
        btn.classList.add('border-primary-500', 'text-primary-500');
        btn.classList.remove('border-transparent');

        tabContents.forEach(function(content) {
          content.classList.add('hidden');
        });
        var contentEl = document.getElementById('content-' + tab);
        if (contentEl) contentEl.classList.remove('hidden');
      });
    });
  }
  initTabs();
</script>