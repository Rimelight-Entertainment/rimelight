---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAPlaceholder from "@rimelight/ui/components/astro/RLAPlaceholder.astro";
import RLVPlaceholder from "@rimelight/ui/components/vue/RLVPlaceholder.vue";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLVButton from "@rimelight/ui/components/vue/RLVButton.vue";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("placeholderPage", {
    title: "Placeholder Component",
    description: "Placeholder Component Showcase",
    heading: "Placeholder",
    tabAstro: "Astro (RLAPlaceholder)",
    tabVue: "Vue (RLVPlaceholder)",
    default: "Default",
    withCustomContent: "With Custom Content",
    sizes: "Sizes",
    defaultDesc: "A placeholder with decorative SVG pattern for empty states.",
    customContentDesc: "Placeholder with custom message and icon.",
    sizesDesc: "Placeholders at different sizes.",
    noContentAvailable: "No content available",
    addContent: "Add Content",
    inboxEmpty: "Your inbox is empty",
    messagesWillAppear: "Messages will appear here",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="tab-astro" class="tab-btn px-4 py-2 font-medium border-b-2 border-primary-500 text-primary-500" data-tab="astro">
        {messages.tabAstro}
      </button>
      <button id="tab-vue" class="tab-btn px-4 py-2 font-medium border-b-2 border-transparent hover:text-primary-500" data-tab="vue">
        {messages.tabVue}
      </button>
    </div>

    <!-- Astro Tab Content -->
    <div id="content-astro" class="tab-content space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultDesc}</p>
        <div class="border border-black p-md">
          <RLAPlaceholder class="h-64">
            <div class="flex items-center justify-center h-full">
              <div class="text-center">
                <p class="text-gray-500 mb-4">{messages.noContentAvailable}</p>
                <RLAButton variant="outline">{messages.addContent}</RLAButton>
              </div>
            </div>
          </RLAPlaceholder>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPlaceholder class="h-64">
  <div class="flex items-center justify-center h-full">
    <div class="text-center">
      <p class="text-gray-500 mb-4">No content available</p>
      <RLAButton variant="outline">Add Content</RLAButton>
    </div>
  </div>
</RLAPlaceholder>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withCustomContent}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.customContentDesc}</p>
        <div class="border border-black p-md">
          <RLAPlaceholder class="h-64">
            <div class="flex items-center justify-center h-full">
              <div class="text-center">
                <span class="i-lucide-inbox text-4xl text-gray-400 mb-4 block"></span>
                <p class="text-gray-500 mb-2">{messages.inboxEmpty}</p>
                <p class="text-sm text-gray-400">{messages.messagesWillAppear}</p>
              </div>
            </div>
          </RLAPlaceholder>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPlaceholder class="h-64">
  <div class="flex items-center justify-center h-full">
    <div class="text-center">
      <span class="i-lucide-inbox text-4xl text-gray-400 mb-4 block"></span>
      <p class="text-gray-500 mb-2">Your inbox is empty</p>
      <p class="text-sm text-gray-400">Messages will appear here</p>
    </div>
  </div>
</RLAPlaceholder>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.sizes}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.sizesDesc}</p>
        <div class="space-y-6">
          <div>
            <div class="border border-black p-md">
              <RLAPlaceholder class="h-32" />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPlaceholder class="h-32" />`}</code></pre>
          </div>
          <div>
            <div class="border border-black p-md">
              <RLAPlaceholder class="h-48" />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPlaceholder class="h-48" />`}</code></pre>
          </div>
          <div>
            <div class="border border-black p-md">
              <RLAPlaceholder class="h-64" />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPlaceholder class="h-64" />`}</code></pre>
          </div>
        </div>
      </section>
    </div>

    <!-- Vue Tab Content -->
    <div id="content-vue" class="tab-content space-y-12 hidden">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultDesc}</p>
        <div class="border border-black p-md">
          <RLVPlaceholder client:load class="h-64">
            <div class="flex items-center justify-center h-full">
              <div class="text-center">
                <p class="text-gray-500 mb-4">{messages.noContentAvailable}</p>
                <RLVButton client:load variant="outline">{messages.addContent}</RLVButton>
              </div>
            </div>
          </RLVPlaceholder>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVPlaceholder client:load class="h-64">
  <div class="flex items-center justify-center h-full">
    <div class="text-center">
      <p class="text-gray-500 mb-4">No content available</p>
      <RLVButton client:load variant="outline">Add Content</RLVButton>
    </div>
  </div>
</RLVPlaceholder>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withCustomContent}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.customContentDesc}</p>
        <div class="border border-black p-md">
          <RLVPlaceholder client:load class="h-64">
            <div class="flex items-center justify-center h-full">
              <div class="text-center">
                <span class="i-lucide-inbox text-4xl text-gray-400 mb-4 block"></span>
                <p class="text-gray-500 mb-2">{messages.inboxEmpty}</p>
                <p class="text-sm text-gray-400">{messages.messagesWillAppear}</p>
              </div>
            </div>
          </RLVPlaceholder>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVPlaceholder client:load class="h-64">
  <div class="flex items-center justify-center h-full">
    <div class="text-center">
      <span class="i-lucide-inbox text-4xl text-gray-400 mb-4 block"></span>
      <p class="text-gray-500 mb-2">Your inbox is empty</p>
      <p class="text-sm text-gray-400">Messages will appear here</p>
    </div>
  </div>
</RLVPlaceholder>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.sizes}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.sizesDesc}</p>
        <div class="space-y-6">
          <div>
            <div class="border border-black p-md">
              <RLVPlaceholder client:load class="h-32" />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVPlaceholder client:load class="h-32" />`}</code></pre>
          </div>
          <div>
            <div class="border border-black p-md">
              <RLVPlaceholder client:load class="h-48" />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVPlaceholder client:load class="h-48" />`}</code></pre>
          </div>
          <div>
            <div class="border border-black p-md">
              <RLVPlaceholder client:load class="h-64" />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVPlaceholder client:load class="h-64" />`}</code></pre>
          </div>
        </div>
      </section>
    </div>
</AppLayout>

<script>
  function initTabs() {
    var tabBtns = document.querySelectorAll('.tab-btn');
    var tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tab = btn.getAttribute('data-tab');

        tabBtns.forEach(function(b) {
          b.classList.remove('border-primary-500', 'text-primary-500');
          b.classList.add('border-transparent');
        });
        btn.classList.add('border-primary-500', 'text-primary-500');
        btn.classList.remove('border-transparent');

        tabContents.forEach(function(content) {
          content.classList.add('hidden');
        });
        var contentEl = document.getElementById('content-' + tab);
        if (contentEl) contentEl.classList.remove('hidden');
      });
    });
  }
  initTabs();
</script>