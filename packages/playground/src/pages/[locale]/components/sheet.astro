---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLASlideover from "@rimelight/ui/components/astro/RLASlideover.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("sheetPage", {
    title: "Sheet Component",
    description: "Sheet Component Showcase",
    heading: "Sheet",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black">
          <div class="flex flex-wrap gap-4">
            <RLASlideover title="Edit Project" description="Modify project settings here." side="right">
              <RLAButton slot="trigger" variant="solid">Open Right</RLAButton>
              <div class="py-6 space-y-4">
                <p class="text-sm text-gray-600 dark:text-gray-400">Sheet contents are perfect for large collapsing panel side-navigation structures.</p>
              </div>
            </RLASlideover>
            <RLASlideover title="Edit Project" description="Modify project settings here." side="left">
              <RLAButton slot="trigger" variant="outline">Open Left</RLAButton>
              <div class="py-6 space-y-4">
                <p class="text-sm text-gray-600 dark:text-gray-400">Left-aligned sheet panel.</p>
              </div>
            </RLASlideover>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLASlideover title="Edit Project" description="..." side="right">
  <RLAButton slot="trigger" variant="solid">Open Sheet</RLAButton>
  <div>Content</div>
</RLASlideover>`}</code></pre>
      </section>
    </div>
</AppLayout>
