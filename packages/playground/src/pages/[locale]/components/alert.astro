---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAAlert from "@rimelight/ui/components/astro/RLAAlert.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("alertPage", {
    title: "Alert Component",
    description: "Alert Component Showcase",
    heading: "Alert",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black space-y-4">
          <RLAAlert title="Heads up!" description="You can add components to your app using the cli." icon="i-lucide-terminal" />
          <RLAAlert title="Success!" description="Your changes have been saved." color="success" icon="i-lucide-check-circle" />
          <RLAAlert title="Danger!" description="Your subscription is about to expire." variant="destructive" icon="i-lucide-alert-triangle" />
          <RLAAlert title="Outline alert!" description="This is an outline variant." variant="outline" icon="i-lucide-info" />
          <RLAAlert title="Solid primary alert!" description="This is a solid primary variant." variant="solid" icon="i-lucide-info" />
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAAlert title="Heads up!" description="..." icon="i-lucide-terminal" />
<RLAAlert title="Success!" description="..." color="success" icon="i-lucide-check-circle" />
<RLAAlert title="Danger!" variant="destructive" icon="i-lucide-alert-triangle" />`}</code></pre>
      </section>
    </div>
</AppLayout>
