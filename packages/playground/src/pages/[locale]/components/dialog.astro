---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAModal from "@rimelight/ui/components/astro/RLAModal.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("dialogPage", {
    title: "Dialog Component",
    description: "Dialog Component Showcase",
    heading: "Dialog",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black">
          <RLAModal title="Edit Profile" description="Make changes to your profile here. Click save when you're done.">
            <RLAButton slot="trigger" variant="solid">Open Dialog</RLAButton>
            <div class="py-4 space-y-4">
              <p class="text-sm text-gray-600 dark:text-gray-400">Configure your user information, avatars, settings, and profile details inside this slot.</p>
            </div>
            <div slot="footer" class="flex justify-end gap-2 w-full">
              <RLAButton variant="solid">Save Changes</RLAButton>
            </div>
          </RLAModal>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAModal title="Edit Profile" description="...">
  <RLAButton slot="trigger" variant="solid">Open Dialog</RLAButton>
  <div class="py-4">Dialog Content</div>
  <div slot="footer">
    <RLAButton variant="solid">Save Changes</RLAButton>
  </div>
</RLAModal>`}</code></pre>
      </section>
    </div>
</AppLayout>
