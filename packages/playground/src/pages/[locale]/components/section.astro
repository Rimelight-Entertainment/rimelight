---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAPageSection from "@rimelight/ui/components/astro/RLAPageSection.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLVSection from "@rimelight/ui/components/vue/RLVSection.vue";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("sectionPage", {
    title: "Section Component",
    description: "Section Component Showcase",
    heading: "Section",
    tabAstro: "Astro (RLAPageSection)",
    tabVue: "Vue (RLVSection)",
    defaultVariant: "Default Variant",
    heroVariant: "Hero Variant",
    withIcon: "With Icon",
    ctaVariant: "CTA Variant",
    horizontalOrientation: "Horizontal Orientation",
    reversedOrder: "Reversed Order",
    withBackgroundSlot: "With Background Slot",
    namedSlots: "Named Slots",
    defaultVariantDesc: "Standard page section with title and description.",
    heroVariantDesc: "Larger text for page heroes with more padding. Renders as h1.",
    withIconDesc: "Display an icon above the title using the icon prop.",
    ctaVariantDesc: "Call-to-action sections with style variants.",
    horizontalOrientationDesc: "Side-by-side layout with content and default slot.",
    reversedOrderDesc: "Reverse the order of the default slot content.",
    withBackgroundSlotDesc: "Add background content like gradients behind your content.",
    namedSlotsDesc: "Use named slots for full control over content.",
    solidDefault: "Solid (default)",
    outline: "Outline",
    soft: "Soft",
    heroVariantDescVue: "Larger text for page heroes with more padding.",
    defaultSectionTitle: "Default Section",
    defaultSectionDesc: "This is a default section with a title and description.",
    getStarted: "Get Started",
    learnMore: "Learn More",
    introducingRimelight: "Introducing Rimelight",
    heroSectionTitle: "Build Faster with Our Component Library",
    heroSectionDesc: "A modern, accessible component library built for performance and developer experience.",
    startBuilding: "Start Building",
    documentation: "Documentation",
    launchYourProject: "Launch Your Project",
    launchDesc: "Get started quickly with our pre-built components and templates.",
    readyToGetStarted: "Ready to Get Started?",
    joinThousands: "Join thousands of developers building with Rimelight.",
    signUpFree: "Sign Up Free",
    tryItOut: "Try It Out",
    exploreLibrary: "Explore our component library with no commitment.",
    explore: "Explore",
    twoColumnLayout: "Two Column Layout",
    horizontalDesc: "Use horizontal orientation for side-by-side content.",
    defaultSlotContent: "Default slot content",
    reversedLayout: "Reversed Layout",
    reversedDesc: "The default slot appears before the header content.",
    defaultSlotContentReversed: "Default slot content (now first)",
    beautifulBackgrounds: "Beautiful Backgrounds",
    backgroundDesc: "Use the background slot to add gradients or other effects.",
    customHeader: "Custom Header",
    fullControl: "Full Control",
    namedSlotsDesc2: "Use individual slots directly for a cleaner, automated layout.",
    bodySlotContent: "This content goes in the body slot.",
    action: "Action",
});
---

<AppLayout title={messages.title} description={messages.description}>
  <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="tab-astro" class="tab-btn px-4 py-2 font-medium border-b-2 border-primary-500 text-primary-500" data-tab="astro">
        {messages.tabAstro}
      </button>
      <button id="tab-vue" class="tab-btn px-4 py-2 font-medium border-b-2 border-transparent hover:text-primary-500" data-tab="vue">
        {messages.tabVue}
      </button>
    </div>

    <!-- Astro Tab Content -->
    <div id="content-astro" class="tab-content space-y-12">

      <!-- Default Variant -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.defaultVariant}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultVariantDesc}</p>
        <div class="border border-black p-md">
          <RLAPageSection
              title={messages.defaultSectionTitle}
              description={messages.defaultSectionDesc}
              links={[
                { label: messages.getStarted, variant: "solid", color: "primary" },
                { label: messages.learnMore, variant: "outline", color: "primary" }
              ]}
          />
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection
  title="Default Section"
  description="This is a default section with a title and description."
  links={[
    { label: "Get Started", variant: "solid", color: "primary" },
    { label: "Learn More", variant: "outline", color: "primary" }
  ]}
/>`}</code></pre>
      </section>

      <!-- Hero Variant -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.heroVariant}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.heroVariantDesc}</p>
        <div class="border border-black p-md">
          <RLAPageSection
              variant="hero"
              headline={messages.introducingRimelight}
              title={messages.heroSectionTitle}
              description={messages.heroSectionDesc}
              links={[
                { label: messages.startBuilding, variant: "solid", color: "primary", size: "lg" },
                { label: messages.documentation, variant: "outline", color: "primary", size: "lg" }
              ]}
          />
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection
  variant="hero"
  headline="Introducing Rimelight"
  title="Build Faster with Our Component Library"
  description="A modern, accessible component library built for performance and developer experience."
  links={[
    { label: "Start Building", variant: "solid", color: "primary", size: "lg" },
    { label: "Documentation", variant: "outline", color: "primary", size: "lg" }
  ]}
/>`}</code></pre>
      </section>

      <!-- With Icon -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withIcon}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.withIconDesc}</p>
        <div class="border border-black p-md">
          <RLAPageSection
              icon="i-lucide-rocket"
              title={messages.launchYourProject}
              description={messages.launchDesc}
              links={[
                { label: messages.getStarted, variant: "solid", color: "primary" }
              ]}
          />
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection
  icon="i-lucide-rocket"
  title="Launch Your Project"
  description="Get started quickly with our pre-built components and templates."
  links={[
    { label: "Get Started", variant: "solid", color: "primary" }
  ]}
/>`}</code></pre>
      </section>

      <!-- CTA Variant -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.ctaVariant}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.ctaVariantDesc}</p>

        <div class="space-y-8">
          <div>
            <h3 class="text-lg font-medium mb-2">{messages.solidDefault}</h3>
            <div class="border border-black p-md mb-2">
              <RLAPageSection
                  variant="cta"
                  title={messages.readyToGetStarted}
                  description={messages.joinThousands}
                  links={[
                    { label: messages.signUpFree, variant: "solid", color: "primary" }
                  ]}
              />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection
  variant="cta"
  title="Ready to Get Started?"
  description="Join thousands of developers building with Rimelight."
  links={[
    { label: "Sign Up Free", variant: "solid", color: "primary" }
  ]}
/>`}</code></pre>
          </div>

          <div>
            <h3 class="text-lg font-medium mb-2">{messages.outline}</h3>
            <div class="border border-black p-md mb-2">
              <RLAPageSection
                  variant="cta"
                  ctaVariant="outline"
                  title={messages.readyToGetStarted}
                  description={messages.joinThousands}
                  links={[
                    { label: messages.signUpFree, variant: "outline", color: "primary" }
                  ]}
              />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection
  variant="cta"
  ctaVariant="outline"
  title="Ready to Get Started?"
  description="Join thousands of developers building with Rimelight."
  links={[
    { label: "Sign Up Free", variant: "outline", color: "primary" }
  ]}
/>`}</code></pre>
          </div>

          <div>
            <h3 class="text-lg font-medium mb-2">{messages.soft}</h3>
            <div class="border border-black p-md mb-2">
              <RLAPageSection
                  variant="cta"
                  ctaVariant="soft"
                  title={messages.tryItOut}
                  description={messages.exploreLibrary}
                  links={[
                    { label: messages.explore, variant: "soft", color: "primary" }
                  ]}
              />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection
  variant="cta"
  ctaVariant="soft"
  title="Try It Out"
  description="Explore our component library with no commitment."
  links={[
    { label: "Explore", variant: "soft", color: "primary" }
  ]}
/>`}</code></pre>
          </div>
        </div>
      </section>

      <!-- Horizontal Orientation -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.horizontalOrientation}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.horizontalOrientationDesc}</p>
        <div class="border border-black p-md">
          <RLAPageSection
              orientation="horizontal"
              title={messages.twoColumnLayout}
              description={messages.horizontalDesc}
          >
            <div class="bg-elevated rounded-lg p-8 flex items-center justify-center">
              <span class="text-muted text-sm">{messages.defaultSlotContent}</span>
            </div>
          </RLAPageSection>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection
  orientation="horizontal"
  title="Two Column Layout"
  description="Use horizontal orientation for side-by-side content."
>
  <div class="bg-elevated rounded-lg p-8 flex items-center justify-center">
    <span class="text-muted text-sm">Default slot content</span>
  </div>
</RLAPageSection>`}</code></pre>
      </section>

      <!-- Reversed -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.reversedOrder}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.reversedOrderDesc}</p>
        <div class="border border-black p-md">
          <RLAPageSection
              orientation="horizontal"
              reverse
              title={messages.reversedLayout}
              description={messages.reversedDesc}
          >
            <div class="bg-elevated rounded-lg p-8 flex items-center justify-center">
              <span class="text-muted text-sm">{messages.defaultSlotContentReversed}</span>
            </div>
          </RLAPageSection>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection
  orientation="horizontal"
  reverse
  title="Reversed Layout"
  description="The default slot appears before the header content."
>
  <div class="bg-elevated rounded-lg p-8 flex items-center justify-center">
    <span class="text-muted text-sm">Default slot content (now first)</span>
  </div>
</RLAPageSection>`}</code></pre>
      </section>

      <!-- With Background Slot -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withBackgroundSlot}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.withBackgroundSlotDesc}</p>
        <div class="border border-black p-md">
          <RLAPageSection
              title={messages.beautifulBackgrounds}
              description={messages.backgroundDesc}
              links={[
                { label: messages.learnMore, variant: "solid", color: "primary" }
              ]}
          >
            <div slot="background" class="absolute inset-0 bg-gradient-to-br from-primary-500/20 to-purple-500/20 -z-10" />
          </RLAPageSection>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection
  title="Beautiful Backgrounds"
  description="Use the background slot to add gradients or other effects."
  links={[
    { label: "Learn More", variant: "solid", color: "primary" }
  ]}
>
  <div slot="background" class="absolute inset-0 bg-gradient-to-br from-primary-500/20 to-purple-500/20 -z-10" />
</RLAPageSection>`}</code></pre>
      </section>

      <!-- Slots Demo -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.namedSlots}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.namedSlotsDesc}</p>
        <div class="border border-black p-md">
          <RLAPageSection>
            <div slot="leading" class="flex items-center">
              <span class="i-lucide-sparkles size-10 shrink-0 text-primary" />
            </div>
            <Fragment slot="headline">
              {messages.customHeader}
            </Fragment>
            <Fragment slot="title">
              {messages.fullControl}
            </Fragment>
            <Fragment slot="description">
              {messages.namedSlotsDesc2}
            </Fragment>
            <p slot="body" class="text-muted">{messages.bodySlotContent}</p>
            <RLAButton slot="links" label={messages.action} variant="solid" color="primary" />
          </RLAPageSection>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPageSection>
  <div slot="leading" class="flex items-center">
    <span class="i-lucide-sparkles size-10 shrink-0 text-primary" />
  </div>
  <Fragment slot="headline">
    Custom Header
  </Fragment>
  <Fragment slot="title">
    Full Control
  </Fragment>
  <Fragment slot="description">
    Use individual slots directly for a cleaner, automated layout.
  </Fragment>
  <p slot="body" class="text-muted">This content goes in the body slot.</p>
  <RLAButton slot="links" label="Action" variant="solid" color="primary" />
</RLAPageSection>`}</code></pre>
      </section>

    </div>

    <!-- Vue Tab Content -->
    <div id="content-vue" class="tab-content hidden space-y-12">

      <!-- Default Variant -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.defaultVariant}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultVariantDesc}</p>
        <div class="border border-black p-md">
          <RLVSection client:load
                      title={messages.defaultSectionTitle}
                      description={messages.defaultSectionDesc}
                      links={[
                        { label: messages.getStarted, variant: "solid", color: "primary" },
                        { label: messages.learnMore, variant: "outline", color: "primary" }
                      ]}
          />
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVSection client:load
  title="Default Section"
  description="This is a default section with a title and description."
  links={[
    { label: "Get Started", variant: "solid", color: "primary" },
    { label: "Learn More", variant: "outline", color: "primary" }
  ]}
/>`}</code></pre>
      </section>

      <!-- Hero Variant -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.heroVariant}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.heroVariantDescVue}</p>
        <div class="border border-black p-md">
          <RLVSection client:load
                      variant="hero"
                      headline={messages.introducingRimelight}
                      title={messages.heroSectionTitle}
                      description={messages.heroSectionDesc}
                      links={[
                        { label: messages.startBuilding, variant: "solid", color: "primary", size: "lg" },
                        { label: messages.documentation, variant: "outline", color: "primary", size: "lg" }
                      ]}
          />
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVSection client:load
  variant="hero"
  headline="Introducing Rimelight"
  title="Build Faster with Our Component Library"
  description="A modern, accessible component library built for performance and developer experience."
  links={[
    { label: "Start Building", variant: "solid", color: "primary", size: "lg" },
    { label: "Documentation", variant: "outline", color: "primary", size: "lg" }
  ]}
/>`}</code></pre>
      </section>

      <!-- With Icon -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withIcon}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.withIconDesc}</p>
        <div class="border border-black p-md">
          <RLVSection client:load
                      icon="i-lucide-rocket"
                      title={messages.launchYourProject}
                      description={messages.launchDesc}
                      links={[
                        { label: messages.getStarted, variant: "solid", color: "primary" }
                      ]}
          />
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVSection client:load
  icon="i-lucide-rocket"
  title="Launch Your Project"
  description="Get started quickly with our pre-built components and templates."
  links={[
    { label: "Get Started", variant: "solid", color: "primary" }
  ]}
/>`}</code></pre>
      </section>

      <!-- CTA Variant -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.ctaVariant}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.ctaVariantDesc}</p>

        <div class="space-y-8">
          <div>
            <h3 class="text-lg font-medium mb-2">{messages.solidDefault}</h3>
            <div class="border border-black p-md mb-2">
              <RLVSection client:load
                          variant="cta"
                          title={messages.readyToGetStarted}
                          description={messages.joinThousands}
                          links={[
                            { label: messages.signUpFree, variant: "solid", color: "primary" }
                          ]}
              />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVSection client:load
  variant="cta"
  title="Ready to Get Started?"
  description="Join thousands of developers building with Rimelight."
  links={[
    { label: "Sign Up Free", variant: "solid", color: "primary" }
  ]}
/>`}</code></pre>
          </div>

          <div>
            <h3 class="text-lg font-medium mb-2">{messages.outline}</h3>
            <div class="border border-black p-md mb-2">
              <RLVSection client:load
                          variant="cta"
                          ctaVariant="outline"
                          title={messages.readyToGetStarted}
                          description={messages.joinThousands}
                          links={[
                            { label: messages.signUpFree, variant: "outline", color: "primary" }
                          ]}
              />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVSection client:load
  variant="cta"
  ctaVariant="outline"
  title="Ready to Get Started?"
  description="Join thousands of developers building with Rimelight."
  links={[
    { label: "Sign Up Free", variant: "outline", color: "primary" }
  ]}
/>`}</code></pre>
          </div>

          <div>
            <h3 class="text-lg font-medium mb-2">{messages.soft}</h3>
            <div class="border border-black p-md mb-2">
              <RLVSection client:load
                          variant="cta"
                          ctaVariant="soft"
                          title={messages.tryItOut}
                          description={messages.exploreLibrary}
                          links={[
                            { label: messages.explore, variant: "soft", color: "primary" }
                          ]}
              />
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVSection client:load
  variant="cta"
  ctaVariant="soft"
  title="Try It Out"
  description="Explore our component library with no commitment."
  links={[
    { label: "Explore", variant: "soft", color: "primary" }
  ]}
/>`}</code></pre>
          </div>
        </div>
      </section>

      <!-- Horizontal Orientation -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.horizontalOrientation}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.horizontalOrientationDesc}</p>
        <div class="border border-black p-md">
          <RLVSection client:load
                      orientation="horizontal"
                      title={messages.twoColumnLayout}
                      description={messages.horizontalDesc}
          >
            <div class="bg-elevated rounded-lg p-8 flex items-center justify-center">
              <span class="text-muted text-sm">{messages.defaultSlotContent}</span>
            </div>
          </RLVSection>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVSection client:load
  orientation="horizontal"
  title="Two Column Layout"
  description="Use horizontal orientation for side-by-side content."
>
  <div class="bg-elevated rounded-lg p-8 flex items-center justify-center">
    <span class="text-muted text-sm">Default slot content</span>
  </div>
</RLVSection>`}</code></pre>
      </section>

      <!-- With Background Slot -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withBackgroundSlot}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.withBackgroundSlotDesc}</p>
        <div class="border border-black p-md">
          <RLVSection client:load
                      title={messages.beautifulBackgrounds}
                      description={messages.backgroundDesc}
                      links={[
                        { label: messages.learnMore, variant: "solid", color: "primary" }
                      ]}
          >
            <template #background>
              <div class="absolute inset-0 bg-gradient-to-br from-primary-500/20 to-purple-500/20 -z-10"></div>
            </template>
          </RLVSection>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVSection client:load
  title="Beautiful Backgrounds"
  description="Use the background slot to add gradients or other effects."
  links={[
    { label: "Learn More", variant: "solid", color: "primary" }
  ]}
>
  <template #background>
    <div class="absolute inset-0 bg-gradient-to-br from-primary-500/20 to-purple-500/20 -z-10"></div>
  </template>
</RLVSection>`}</code></pre>
      </section>

    </div>
</AppLayout>


<script>
  function initTabs() {
    var tabBtns = document.querySelectorAll('.tab-btn');
    var tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tab = btn.getAttribute('data-tab');

        tabBtns.forEach(function(b) {
          b.classList.remove('border-primary-500', 'text-primary-500');
          b.classList.add('border-transparent');
        });
        btn.classList.add('border-primary-500', 'text-primary-500');
        btn.classList.remove('border-transparent');

        tabContents.forEach(function(content) {
          content.classList.add('hidden');
        });
        var contentEl = document.getElementById('content-' + tab);
        if (contentEl) contentEl.classList.remove('hidden');
      });
    });
  }
  initTabs();
</script>