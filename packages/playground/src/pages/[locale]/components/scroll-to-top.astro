---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAScrollToTop from "@rimelight/ui/components/astro/RLAScrollToTop.astro";
import RLVScrollToTop from "@rimelight/ui/components/vue/RLVScrollToTop.vue";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("scrollToTopPage", {
    title: "Scroll to Top Component",
    description: "Scroll to Top Component Showcase",
    heading: "Scroll to Top",
    tabAstro: "Astro (RLAScrollToTop)",
    tabVue: "Vue (RLVScrollToTop)",
    default: "Default",
    withProgressIndicator: "With Progress Indicator",
    colors: "Colors",
    customThreshold: "Custom Threshold",
    defaultDesc: "A button that appears when scrolling down and scrolls back to top when clicked.",
    progressDesc: "Shows scroll progress in the circle.",
    colorsDesc: "Different color options.",
    thresholdDesc: "Button appears after scrolling 500px.",
    primaryDefault: "Primary (Default)",
    secondary: "Secondary",
    success: "Success",
    scrollToSeeButton: "Scroll down to see the button appear, then click it to scroll back to top",
    scrollToSeeProgress: "Scroll down to see the progress circle fill up",
    scrollPast500px: "Scroll past 500px to see the button appear",
});
---

<AppLayout title={messages.title} description={messages.description}>
  <main class="max-w-6xl mx-auto p-8">
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="tab-astro" class="tab-btn px-4 py-2 font-medium border-b-2 border-primary-500 text-primary-500" data-tab="astro">
        {messages.tabAstro}
      </button>
      <button id="tab-vue" class="tab-btn px-4 py-2 font-medium border-b-2 border-transparent hover:text-primary-500" data-tab="vue">
        {messages.tabVue}
      </button>
    </div>

    <!-- Astro Tab Content -->
    <div id="content-astro" class="tab-content space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultDesc}</p>
        <div class="border border-black p-md">
          <RLAScrollToTop />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">{messages.scrollToSeeButton}</p>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAScrollToTop />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withProgressIndicator}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.progressDesc}</p>
        <div class="border border-black p-md">
          <RLAScrollToTop showProgress />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">{messages.scrollToSeeProgress}</p>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAScrollToTop showProgress />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.colors}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.colorsDesc}</p>
        <div class="space-y-6">
          <div>
            <div class="border border-black p-md">
              <RLAScrollToTop color="primary" />
              <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
                <p class="text-gray-400">{messages.primaryDefault}</p>
              </div>
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAScrollToTop color="primary" />`}</code></pre>
          </div>
          <div>
            <div class="border border-black p-md">
              <RLAScrollToTop color="secondary" />
              <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
                <p class="text-gray-400">{messages.secondary}</p>
              </div>
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAScrollToTop color="secondary" />`}</code></pre>
          </div>
          <div>
            <div class="border border-black p-md">
              <RLAScrollToTop color="success" />
              <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
                <p class="text-gray-400">{messages.success}</p>
              </div>
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAScrollToTop color="success" />`}</code></pre>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.customThreshold}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.thresholdDesc}</p>
        <div class="border border-black p-md">
          <RLAScrollToTop threshold={500} />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">{messages.scrollPast500px}</p>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAScrollToTop threshold={500} />`}</code></pre>
      </section>
    </div>

    <!-- Vue Tab Content -->
    <div id="content-vue" class="tab-content space-y-12 hidden">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultDesc}</p>
        <div class="border border-black p-md">
          <RLVScrollToTop client:load />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">{messages.scrollToSeeButton}</p>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVScrollToTop client:load />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withProgressIndicator}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.progressDesc}</p>
        <div class="border border-black p-md">
          <RLVScrollToTop client:load showProgress />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">{messages.scrollToSeeProgress}</p>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVScrollToTop client:load showProgress />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.colors}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.colorsDesc}</p>
        <div class="space-y-6">
          <div>
            <div class="border border-black p-md">
              <RLVScrollToTop client:load color="primary" />
              <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
                <p class="text-gray-400">{messages.primaryDefault}</p>
              </div>
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVScrollToTop client:load color="primary" />`}</code></pre>
          </div>
          <div>
            <div class="border border-black p-md">
              <RLVScrollToTop client:load color="secondary" />
              <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
                <p class="text-gray-400">{messages.secondary}</p>
              </div>
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVScrollToTop client:load color="secondary" />`}</code></pre>
          </div>
          <div>
            <div class="border border-black p-md">
              <RLVScrollToTop client:load color="primary" />
              <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
                <p class="text-gray-400">{messages.success}</p>
              </div>
            </div>
            <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVScrollToTop client:load color="success" />`}</code></pre>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.customThreshold}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.thresholdDesc}</p>
        <div class="border border-black p-md">
          <RLVScrollToTop client:load threshold={500} />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">{messages.scrollPast500px}</p>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVScrollToTop client:load threshold={500} />`}</code></pre>
      </section>
    </div>
  </main>

  <script>
    function initTabs() {
      var tabBtns = document.querySelectorAll('.tab-btn');
      var tabContents = document.querySelectorAll('.tab-content');

      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var tab = btn.getAttribute('data-tab');

          tabBtns.forEach(function(b) {
            b.classList.remove('border-primary-500', 'text-primary-500');
            b.classList.add('border-transparent');
          });
          btn.classList.add('border-primary-500', 'text-primary-500');
          btn.classList.remove('border-transparent');

          tabContents.forEach(function(content) {
            content.classList.add('hidden');
          });
          var contentEl = document.getElementById('content-' + tab);
          if (contentEl) contentEl.classList.remove('hidden');
        });
      });
    }
    initTabs();
  </script>
</AppLayout>
