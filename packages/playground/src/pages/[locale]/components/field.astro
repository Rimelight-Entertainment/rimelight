---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAFormField from "@rimelight/ui/components/astro/RLAFormField.astro";
import RLAInput from "@rimelight/ui/components/astro/RLAInput.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("fieldPage", {
    title: "Field Component",
    description: "Field Component Showcase",
    heading: "Field",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black max-w-sm space-y-6">
          <RLAFormField label="Email address" description="We'll never share your email.">
            <RLAInput id="email" type="email" placeholder="you@example.com" />
          </RLAFormField>
          
          <RLAFormField label="Password" error="Password must be at least 8 characters.">
            <RLAInput id="password" type="password" placeholder="••••••••" />
          </RLAFormField>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAFormField label="Email" description="...">
  <RLAInput type="email" placeholder="..." />
</RLAFormField>`}</code></pre>
      </section>
    </div>
</AppLayout>
