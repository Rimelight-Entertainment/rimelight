---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLVButton from "@rimelight/ui/components/vue/RLVButton.vue";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("buttonPage", {
    title: "Button Component",
    description: "Button Component Showcase",
    heading: "Button",
    tabAstro: "Astro (RLAButton)",
    tabVue: "Vue (RLVButton)",
    variants: "Variants",
    default: "Default",
    colors: "Colors",
    sizes: "Sizes",
    withIcons: "With Icons",
    leadingIcon: "Leading Icon",
    trailingIcon: "Trailing Icon",
    bothIcons: "Both Icons",
    states: "States",
    loading: "Loading",
    disabled: "Disabled",
    squareIconOnly: "Square (Icon Only)",
    blockFullWidth: "Block (Full Width)",
    extraSmall: "Extra Small",
    small: "Small",
    medium: "Medium",
    large: "Large",
    extraLarge: "Extra Large",
    loadingLabel: "Loading",
    saving: "Saving...",
    processing: "Processing",
    blockButton: "Block Button",
    blockOutline: "Block Outline",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <div class="max-w-7xl mx-auto px-4">
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="tab-astro" class="tab-btn px-4 py-2 font-medium border-b-2 border-primary-500 text-primary-500" data-tab="astro">
        {messages.tabAstro}
      </button>
      <button id="tab-vue" class="tab-btn px-4 py-2 font-medium border-b-2 border-transparent hover:text-primary-500" data-tab="vue">
        {messages.tabVue}
      </button>
    </div>

    <!-- Astro Tab Content -->
    <div id="content-astro" class="tab-content space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.variants}</h2>
        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.default}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLAButton variant="solid">Solid</RLAButton>
              <RLAButton variant="outline">Outline</RLAButton>
              <RLAButton variant="soft">Soft</RLAButton>
              <RLAButton variant="subtle">Subtle</RLAButton>
              <RLAButton variant="ghost">Ghost</RLAButton>
              <RLAButton variant="link">Link</RLAButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton variant="solid">Solid</RLAButton>
<RLAButton variant="outline">Outline</RLAButton>
<RLAButton variant="soft">Soft</RLAButton>
<RLAButton variant="subtle">Subtle</RLAButton>
<RLAButton variant="ghost">Ghost</RLAButton>
<RLAButton variant="link">Link</RLAButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.colors}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLAButton color="primary">Primary</RLAButton>
              <RLAButton color="secondary">Secondary</RLAButton>
              <RLAButton color="info">Info</RLAButton>
              <RLAButton color="success">Success</RLAButton>
              <RLAButton color="warning">Warning</RLAButton>
              <RLAButton color="error">Error</RLAButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton color="primary">Primary</RLAButton>
<RLAButton color="secondary">Secondary</RLAButton>
<RLAButton color="info">Info</RLAButton>
<RLAButton color="success">Success</RLAButton>
<RLAButton color="warning">Warning</RLAButton>
<RLAButton color="error">Error</RLAButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.sizes}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap items-center gap-4">
              <RLAButton size="xs">{messages.extraSmall}</RLAButton>
              <RLAButton size="sm">{messages.small}</RLAButton>
              <RLAButton size="md">{messages.medium}</RLAButton>
              <RLAButton size="lg">{messages.large}</RLAButton>
              <RLAButton size="xl">{messages.extraLarge}</RLAButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton size="xs">Extra Small</RLAButton>
<RLAButton size="sm">Small</RLAButton>
<RLAButton size="md">Medium</RLAButton>
<RLAButton size="lg">Large</RLAButton>
<RLAButton size="xl">Extra Large</RLAButton>`}</code></pre>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withIcons}</h2>
        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.leadingIcon}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLAButton leadingIcon="i-lucide-home">Home</RLAButton>
              <RLAButton leadingIcon="i-lucide-mail" variant="outline">Mail</RLAButton>
              <RLAButton leadingIcon="i-lucide-user" variant="soft">Profile</RLAButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton leadingIcon="i-lucide-home">Home</RLAButton>
<RLAButton leadingIcon="i-lucide-mail" variant="outline">Mail</RLAButton>
<RLAButton leadingIcon="i-lucide-user" variant="soft">Profile</RLAButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.trailingIcon}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLAButton trailingIcon="i-lucide-arrow-right">Next</RLAButton>
              <RLAButton trailingIcon="i-lucide-external-link" variant="outline">Open</RLAButton>
              <RLAButton trailingIcon="i-lucide-download" variant="soft">Download</RLAButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton trailingIcon="i-lucide-arrow-right">Next</RLAButton>
<RLAButton trailingIcon="i-lucide-external-link" variant="outline">Open</RLAButton>
<RLAButton trailingIcon="i-lucide-download" variant="soft">Download</RLAButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.bothIcons}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLAButton leadingIcon="i-lucide-mail" trailingIcon="i-lucide-send">Send</RLAButton>
              <RLAButton leadingIcon="i-lucide-shopping-cart" trailingIcon="i-lucide-arrow-right" variant="outline">Checkout</RLAButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton leadingIcon="i-lucide-mail" trailingIcon="i-lucide-send">Send</RLAButton>
<RLAButton leadingIcon="i-lucide-shopping-cart" trailingIcon="i-lucide-arrow-right" variant="outline">Checkout</RLAButton>`}</code></pre>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.states}</h2>
        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.loading}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLAButton loading>{messages.loadingLabel}</RLAButton>
              <RLAButton loading variant="outline">{messages.saving}</RLAButton>
              <RLAButton loading variant="soft">{messages.processing}</RLAButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton loading>Loading</RLAButton>
<RLAButton loading variant="outline">Saving...</RLAButton>
<RLAButton loading variant="soft">Processing</RLAButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.disabled}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLAButton disabled>{messages.disabled}</RLAButton>
              <RLAButton disabled variant="outline">{messages.disabled}</RLAButton>
              <RLAButton disabled variant="soft">{messages.disabled}</RLAButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton disabled>Disabled</RLAButton>
<RLAButton disabled variant="outline">Disabled</RLAButton>
<RLAButton disabled variant="soft">Disabled</RLAButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.squareIconOnly}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap items-center gap-4">
              <RLAButton square leadingIcon="i-lucide-home" aria-label="Home" />
              <RLAButton square leadingIcon="i-lucide-settings" variant="outline" aria-label="Settings" />
              <RLAButton square leadingIcon="i-lucide-user" variant="soft" aria-label="Profile" />
              <RLAButton square leadingIcon="i-lucide-search" variant="ghost" aria-label="Search" />
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton square leadingIcon="i-lucide-home" aria-label="Home" />
<RLAButton square leadingIcon="i-lucide-settings" variant="outline" aria-label="Settings" />
<RLAButton square leadingIcon="i-lucide-user" variant="soft" aria-label="Profile" />
<RLAButton square leadingIcon="i-lucide-search" variant="ghost" aria-label="Search" />`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.blockFullWidth}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-col gap-4 max-w-md">
              <RLAButton block>{messages.blockButton}</RLAButton>
              <RLAButton block variant="outline">{messages.blockOutline}</RLAButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAButton block>Block Button</RLAButton>
<RLAButton block variant="outline">Block Outline</RLAButton>`}</code></pre>
        </div>
      </section>
    </div>

    <!-- Vue Tab Content -->
    <div id="content-vue" class="tab-content hidden space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.variants}</h2>
        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.default}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLVButton client:load variant="solid">Solid</RLVButton>
              <RLVButton client:load variant="outline">Outline</RLVButton>
              <RLVButton client:load variant="soft">Soft</RLVButton>
              <RLVButton client:load variant="subtle">Subtle</RLVButton>
              <RLVButton client:load variant="ghost">Ghost</RLVButton>
              <RLVButton client:load variant="link">Link</RLVButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load variant="solid">Solid</RLVButton>
<RLVButton client:load variant="outline">Outline</RLVButton>
<RLVButton client:load variant="soft">Soft</RLVButton>
<RLVButton client:load variant="subtle">Subtle</RLVButton>
<RLVButton client:load variant="ghost">Ghost</RLVButton>
<RLVButton client:load variant="link">Link</RLVButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.colors}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLVButton client:load color="primary">Primary</RLVButton>
              <RLVButton client:load color="secondary">Secondary</RLVButton>
              <RLVButton client:load color="info">Info</RLVButton>
              <RLVButton client:load color="success">Success</RLVButton>
              <RLVButton client:load color="warning">Warning</RLVButton>
              <RLVButton client:load color="error">Error</RLVButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load color="primary">Primary</RLVButton>
<RLVButton client:load color="secondary">Secondary</RLVButton>
<RLVButton client:load color="info">Info</RLVButton>
<RLVButton client:load color="success">Success</RLVButton>
<RLVButton client:load color="warning">Warning</RLVButton>
<RLVButton client:load color="error">Error</RLVButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.sizes}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap items-center gap-4">
              <RLVButton client:load size="xs">{messages.extraSmall}</RLVButton>
              <RLVButton client:load size="sm">{messages.small}</RLVButton>
              <RLVButton client:load size="md">{messages.medium}</RLVButton>
              <RLVButton client:load size="lg">{messages.large}</RLVButton>
              <RLVButton client:load size="xl">{messages.extraLarge}</RLVButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load size="xs">Extra Small</RLVButton>
<RLVButton client:load size="sm">Small</RLVButton>
<RLVButton client:load size="md">Medium</RLVButton>
<RLVButton client:load size="lg">Large</RLVButton>
<RLVButton client:load size="xl">Extra Large</RLVButton>`}</code></pre>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withIcons}</h2>
        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.leadingIcon}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLVButton client:load leadingIcon="i-lucide-home">Home</RLVButton>
              <RLVButton client:load leadingIcon="i-lucide-mail" variant="outline">Mail</RLVButton>
              <RLVButton client:load leadingIcon="i-lucide-user" variant="soft">Profile</RLVButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load leadingIcon="i-lucide-home">Home</RLVButton>
<RLVButton client:load leadingIcon="i-lucide-mail" variant="outline">Mail</RLVButton>
<RLVButton client:load leadingIcon="i-lucide-user" variant="soft">Profile</RLVButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.trailingIcon}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLVButton client:load trailingIcon="i-lucide-arrow-right">Next</RLVButton>
              <RLVButton client:load trailingIcon="i-lucide-external-link" variant="outline">Open</RLVButton>
              <RLVButton client:load trailingIcon="i-lucide-download" variant="soft">Download</RLVButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load trailingIcon="i-lucide-arrow-right">Next</RLVButton>
<RLVButton client:load trailingIcon="i-lucide-external-link" variant="outline">Open</RLVButton>
<RLVButton client:load trailingIcon="i-lucide-download" variant="soft">Download</RLVButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.bothIcons}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLVButton client:load leadingIcon="i-lucide-mail" trailingIcon="i-lucide-send">Send</RLVButton>
              <RLVButton client:load leadingIcon="i-lucide-shopping-cart" trailingIcon="i-lucide-arrow-right" variant="outline">Checkout</RLVButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load leadingIcon="i-lucide-mail" trailingIcon="i-lucide-send">Send</RLVButton>
<RLVButton client:load leadingIcon="i-lucide-shopping-cart" trailingIcon="i-lucide-arrow-right" variant="outline">Checkout</RLVButton>`}</code></pre>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.states}</h2>
        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.loading}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLVButton client:load loading>{messages.loadingLabel}</RLVButton>
              <RLVButton client:load loading variant="outline">{messages.saving}</RLVButton>
              <RLVButton client:load loading variant="soft">{messages.processing}</RLVButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load loading>Loading</RLVButton>
<RLVButton client:load loading variant="outline">Saving...</RLVButton>
<RLVButton client:load loading variant="soft">Processing</RLVButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.disabled}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap gap-4">
              <RLVButton client:load disabled>{messages.disabled}</RLVButton>
              <RLVButton client:load disabled variant="outline">{messages.disabled}</RLVButton>
              <RLVButton client:load disabled variant="soft">{messages.disabled}</RLVButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load disabled>Disabled</RLVButton>
<RLVButton client:load disabled variant="outline">Disabled</RLVButton>
<RLVButton client:load disabled variant="soft">Disabled</RLVButton>`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.squareIconOnly}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-wrap items-center gap-4">
              <RLVButton client:load square leadingIcon="i-lucide-home" aria-label="Home" />
              <RLVButton client:load square leadingIcon="i-lucide-settings" variant="outline" aria-label="Settings" />
              <RLVButton client:load square leadingIcon="i-lucide-user" variant="soft" aria-label="Profile" />
              <RLVButton client:load square leadingIcon="i-lucide-search" variant="ghost" aria-label="Search" />
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load square leadingIcon="i-lucide-home" aria-label="Home" />
<RLVButton client:load square leadingIcon="i-lucide-settings" variant="outline" aria-label="Settings" />
<RLVButton client:load square leadingIcon="i-lucide-user" variant="soft" aria-label="Profile" />
<RLVButton client:load square leadingIcon="i-lucide-search" variant="ghost" aria-label="Search" />`}</code></pre>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-medium">{messages.blockFullWidth}</h3>
          <div class="border border-black p-md">
            <div class="flex flex-col gap-4 max-w-md">
              <RLVButton client:load block>{messages.blockButton}</RLVButton>
              <RLVButton client:load block variant="outline">{messages.blockOutline}</RLVButton>
            </div>
          </div>
          <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVButton client:load block>Block Button</RLVButton>
<RLVButton client:load block variant="outline">Block Outline</RLVButton>`}</code></pre>
        </div>
      </section>
    </div>
</div>
</AppLayout>

<script>
  function initTabs() {
    var tabBtns = document.querySelectorAll('.tab-btn');
    var tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tab = btn.getAttribute('data-tab');

        tabBtns.forEach(function(b) {
          b.classList.remove('border-primary-500', 'text-primary-500');
          b.classList.add('border-transparent');
        });
        btn.classList.add('border-primary-500', 'text-primary-500');
        btn.classList.remove('border-transparent');

        tabContents.forEach(function(content) {
          content.classList.add('hidden');
        });
        var contentEl = document.getElementById('content-' + tab);
        if (contentEl) contentEl.classList.remove('hidden');
      });
    });
  }
  initTabs();
</script>