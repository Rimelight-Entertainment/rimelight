---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAHoverCard from "@rimelight/ui/components/astro/RLAHoverCard.astro";
import RLAAvatar from "@rimelight/ui/components/astro/RLAAvatar.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("hovercardPage", {
    title: "HoverCard Component",
    description: "HoverCard Component Showcase",
    heading: "HoverCard",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black flex items-center justify-center">
          <RLAHoverCard>
            <a slot="trigger" href="#" class="font-semibold text-primary-500 hover:underline">@astrodotbuild</a>
            <div class="flex gap-4">
              <RLAAvatar fallback="A" />
              <div>
                <h4 class="text-sm font-bold">Astro</h4>
                <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">The web framework for content-driven websites.</p>
              </div>
            </div>
          </RLAHoverCard>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAHoverCard>
  <a slot="trigger" href="#">@astrodotbuild</a>
  <div class="flex gap-4">
    <RLAAvatar fallback="A" />
    <p>The web framework for content-driven websites.</p>
  </div>
</RLAHoverCard>`}</code></pre>
      </section>
    </div>
</AppLayout>
