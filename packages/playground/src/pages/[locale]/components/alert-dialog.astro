---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAAlertDialog from "@rimelight/ui/components/astro/RLAAlertDialog.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("alertdialogPage", {
    title: "AlertDialog Component",
    description: "AlertDialog Component Showcase",
    heading: "AlertDialog",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black">
          <div class="flex flex-wrap gap-4">
            <RLAAlertDialog
              title="Are you absolutely sure?"
              description="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
              actionLabel="Continue"
              cancelLabel="Cancel"
            >
              <RLAButton slot="trigger" variant="solid" color="error">Delete Account</RLAButton>
            </RLAAlertDialog>
            <RLAAlertDialog
              title="Discard changes?"
              description="All unsaved changes will be lost."
              actionLabel="Discard"
              cancelLabel="Keep editing"
            >
              <RLAButton slot="trigger" variant="outline">Discard Changes</RLAButton>
            </RLAAlertDialog>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAAlertDialog
  title="Are you absolutely sure?"
  description="This action cannot be undone."
  actionLabel="Continue"
  cancelLabel="Cancel"
>
  <RLAButton slot="trigger" color="error">Delete Account</RLAButton>
</RLAAlertDialog>`}</code></pre>
      </section>
    </div>
</AppLayout>
