---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAScrollArea from "@rimelight/ui/components/astro/RLAScrollArea.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("scrollareaPage", {
    title: "ScrollArea Component",
    description: "ScrollArea Component Showcase",
    heading: "ScrollArea",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black">
          <RLAScrollArea class="h-48 w-64 rounded-md border p-4 border-gray-200 dark:border-gray-800">
            <div class="space-y-4">
              <h4 class="text-sm font-semibold text-primary-500">Premium Typography</h4>
              <p class="text-xs leading-relaxed text-gray-500">Rimelight design systems leverage curated harmony colors and sleek typography defaults like Inter or Outfit to deliver unparalleled visual experiences. No browser defaults are left unstyled.</p>
              <p class="text-xs leading-relaxed text-gray-500">This custom scroll-area provides standard elegant hardware-accelerated momentum scroll behavior across all devices and browsers.</p>
            </div>
          </RLAScrollArea>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAScrollArea class="h-48 w-64 border p-4">
  <p>Overflowing content goes here...</p>
</RLAScrollArea>`}</code></pre>
      </section>
    </div>
</AppLayout>
