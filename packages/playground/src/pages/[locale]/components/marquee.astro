---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAMarquee from "@rimelight/ui/components/astro/RLAMarquee.astro";
import RLABadge from "@rimelight/ui/components/astro/RLABadge.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("marqueePage", {
    title: "Marquee Component",
    description: "Marquee Component Showcase",
    heading: "Marquee",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black overflow-hidden">
          <RLAMarquee speed={30} pauseOnHover>
            <div class="flex gap-8 py-2">
              <RLABadge variant="solid">Vibrant Designs</RLABadge>
              <RLABadge variant="outline">Uncompromising Speed</RLABadge>
              <RLABadge variant="soft">Responsive Layouts</RLABadge>
              <RLABadge variant="subtle">Modern Aesthetics</RLABadge>
              <RLABadge variant="solid" color="success">SEO Optimized</RLABadge>
            </div>
          </RLAMarquee>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAMarquee speed={30} pauseOnHover>
  <div class="flex gap-8">
    <span>Item 1</span>
    <span>Item 2</span>
  </div>
</RLAMarquee>`}</code></pre>
      </section>
    </div>
</AppLayout>
