---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLVLogo from "@rimelight/ui/components/vue/RLVLogo.vue";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("logoPage", {
    title: "Logo Component",
    description: "Logo Component Showcase",
    heading: "Logo",
    tabAstro: "Astro (RLALogo)",
    tabVue: "Vue (RLVLogo)",
    logomark: "Logomark",
    logotype: "Logotype",
    asALink: "As a Link",
    sizes: "Sizes",
    logomarkDesc: "The default logo variant (icon only).",
    logotypeDesc: "Full logo with text.",
    asALinkDesc: "Logos can be wrapped in a link.",
    sizesDesc: "Logos at different sizes.",
    defaultColor: "Default (color)",
    white: "White",
    black: "Black",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="tab-astro" class="tab-btn px-4 py-2 font-medium border-b-2 border-primary-500 text-primary-500" data-tab="astro">
        {messages.tabAstro}
      </button>
      <button id="tab-vue" class="tab-btn px-4 py-2 font-medium border-b-2 border-transparent hover:text-primary-500" data-tab="vue">
        {messages.tabVue}
      </button>
    </div>

    <!-- Astro Tab Content -->
    <div id="content-astro" class="tab-content space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.logomark}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.logomarkDesc}</p>
        <div class="border border-black p-md">
          <div class="flex flex-wrap gap-8 items-center">
            <div class="flex flex-col items-center gap-2">
              <RLALogo variant="logomark" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">{messages.defaultColor}</span>
            </div>
            <div class="flex flex-col items-center gap-2 dark:bg-gray-900 p-4 rounded">
              <RLALogo variant="logomark" mode="white" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">{messages.white}</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-gray-900 p-4 rounded">
              <RLALogo variant="logomark" mode="black" class="h-12 w-auto" />
              <span class="text-xs text-gray-500 text-white">{messages.black}</span>
            </div>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLALogo variant="logomark" class="h-12 w-auto" />
<RLALogo variant="logomark" mode="white" class="h-12 w-auto" />
<RLALogo variant="logomark" mode="black" class="h-12 w-auto" />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.logotype}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.logotypeDesc}</p>
        <div class="border border-black p-md">
          <div class="flex flex-wrap gap-8 items-center">
            <div class="flex flex-col items-center gap-2">
              <RLALogo variant="logotype" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">{messages.defaultColor}</span>
            </div>
            <div class="flex flex-col items-center gap-2 dark:bg-gray-900 p-4 rounded">
              <RLALogo variant="logotype" mode="white" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">{messages.white}</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-gray-900 p-4 rounded">
              <RLALogo variant="logotype" mode="black" class="h-12 w-auto" />
              <span class="text-xs text-gray-500 text-white">{messages.black}</span>
            </div>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLALogo variant="logotype" class="h-12 w-auto" />
<RLALogo variant="logotype" mode="white" class="h-12 w-auto" />
<RLALogo variant="logotype" mode="black" class="h-12 w-auto" />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.asALink}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.asALinkDesc}</p>
        <div class="border border-black p-md">
          <div class="flex flex-wrap gap-8 items-center">
            <RLALogo href="/" variant="logomark" class="h-10 w-auto" />
            <RLALogo href="/" variant="logotype" class="h-10 w-auto" />
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLALogo href="/" variant="logomark" class="h-10 w-auto" />
<RLALogo href="/" variant="logotype" class="h-10 w-auto" />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.sizes}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.sizesDesc}</p>
        <div class="border border-black p-md">
          <div class="flex flex-wrap items-end gap-8">
            <div class="flex flex-col items-center gap-2">
              <RLALogo variant="logomark" class="h-6 w-auto" />
              <span class="text-xs text-gray-500">24px</span>
            </div>
            <div class="flex flex-col items-center gap-2">
              <RLALogo variant="logomark" class="h-8 w-auto" />
              <span class="text-xs text-gray-500">32px</span>
            </div>
            <div class="flex flex-col items-center gap-2">
              <RLALogo variant="logomark" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">48px</span>
            </div>
            <div class="flex flex-col items-center gap-2">
              <RLALogo variant="logomark" class="h-16 w-auto" />
              <span class="text-xs text-gray-500">64px</span>
            </div>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLALogo variant="logomark" class="h-6 w-auto" />
<RLALogo variant="logomark" class="h-8 w-auto" />
<RLALogo variant="logomark" class="h-12 w-auto" />
<RLALogo variant="logomark" class="h-16 w-auto" />`}</code></pre>
      </section>
    </div>

    <!-- Vue Tab Content -->
    <div id="content-vue" class="tab-content hidden space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.logomark}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.logomarkDesc}</p>
        <div class="border border-black p-md">
          <div class="flex flex-wrap gap-8 items-center">
            <div class="flex flex-col items-center gap-2">
              <RLVLogo client:load variant="logomark" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">{messages.defaultColor}</span>
            </div>
            <div class="flex flex-col items-center gap-2 dark:bg-gray-900 p-4 rounded">
              <RLVLogo client:load variant="logomark" mode="white" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">{messages.white}</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-gray-900 p-4 rounded">
              <RLVLogo client:load variant="logomark" mode="black" class="h-12 w-auto" />
              <span class="text-xs text-gray-500 text-white">{messages.black}</span>
            </div>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVLogo client:load variant="logomark" class="h-12 w-auto" />
<RLVLogo client:load variant="logomark" mode="white" class="h-12 w-auto" />
<RLVLogo client:load variant="logomark" mode="black" class="h-12 w-auto" />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.logotype}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.logotypeDesc}</p>
        <div class="border border-black p-md">
          <div class="flex flex-wrap gap-8 items-center">
            <div class="flex flex-col items-center gap-2">
              <RLVLogo client:load variant="logotype" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">{messages.defaultColor}</span>
            </div>
            <div class="flex flex-col items-center gap-2 dark:bg-gray-900 p-4 rounded">
              <RLVLogo client:load variant="logotype" mode="white" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">{messages.white}</span>
            </div>
            <div class="flex flex-col items-center gap-2 bg-gray-900 p-4 rounded">
              <RLVLogo client:load variant="logotype" mode="black" class="h-12 w-auto" />
              <span class="text-xs text-gray-500 text-white">{messages.black}</span>
            </div>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVLogo client:load variant="logotype" class="h-12 w-auto" />
<RLVLogo client:load variant="logotype" mode="white" class="h-12 w-auto" />
<RLVLogo client:load variant="logotype" mode="black" class="h-12 w-auto" />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.asALink}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.asALinkDesc}</p>
        <div class="border border-black p-md">
          <div class="flex flex-wrap gap-8 items-center">
            <RLVLogo client:load href="/" variant="logomark" class="h-10 w-auto" />
            <RLVLogo client:load href="/" variant="logotype" class="h-10 w-auto" />
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVLogo client:load href="/" variant="logomark" class="h-10 w-auto" />
<RLVLogo client:load href="/" variant="logotype" class="h-10 w-auto" />`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.sizes}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.sizesDesc}</p>
        <div class="border border-black p-md">
          <div class="flex flex-wrap items-end gap-8">
            <div class="flex flex-col items-center gap-2">
              <RLVLogo client:load variant="logomark" class="h-6 w-auto" />
              <span class="text-xs text-gray-500">24px</span>
            </div>
            <div class="flex flex-col items-center gap-2">
              <RLVLogo client:load variant="logomark" class="h-8 w-auto" />
              <span class="text-xs text-gray-500">32px</span>
            </div>
            <div class="flex flex-col items-center gap-2">
              <RLVLogo client:load variant="logomark" class="h-12 w-auto" />
              <span class="text-xs text-gray-500">48px</span>
            </div>
            <div class="flex flex-col items-center gap-2">
              <RLVLogo client:load variant="logomark" class="h-16 w-auto" />
              <span class="text-xs text-gray-500">64px</span>
            </div>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVLogo client:load variant="logomark" class="h-6 w-auto" />
<RLVLogo client:load variant="logomark" class="h-8 w-auto" />
<RLVLogo client:load variant="logomark" class="h-12 w-auto" />
<RLVLogo client:load variant="logomark" class="h-16 w-auto" />`}</code></pre>
      </section>
    </div>
</AppLayout>

<script>
  function initTabs() {
    var tabBtns = document.querySelectorAll('.tab-btn');
    var tabContents = document.querySelectorAll('.tab-content');

    tabBtns.forEach(function(btn) {
      btn.addEventListener("click", function() {
        var tab = btn.getAttribute('data-tab');

        tabBtns.forEach(function(b) {
          b.classList.remove('border-primary-500', 'text-primary-500');
          b.classList.add('border-transparent');
        });
        btn.classList.add('border-primary-500', 'text-primary-500');
        btn.classList.remove('border-transparent');

        tabContents.forEach(function(content) {
          content.classList.add('hidden');
        });
        var contentEl = document.getElementById('content-' + tab);
        if (contentEl) contentEl.classList.remove('hidden');
      });
    });
  }
  initTabs();
</script>
