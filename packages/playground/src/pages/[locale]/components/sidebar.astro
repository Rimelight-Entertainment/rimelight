---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLASidebar from "@rimelight/ui/components/astro/RLASidebar.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("sidebarPage", {
    title: "Sidebar Component",
    description: "Sidebar Component Showcase",
    heading: "Sidebar",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black">
          <div class="flex h-64 border border-gray-200 dark:border-gray-800 rounded-lg overflow-hidden">
            <RLASidebar class="w-64 bg-gray-50 dark:bg-gray-900 border-r border-gray-200 dark:border-gray-800 p-4">
              <ul class="space-y-2 text-sm font-medium">
                <li><a href="#" class="block p-2 rounded bg-primary-500/10 text-primary-500">Dashboard</a></li>
                <li><a href="#" class="block p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-300">Analytics</a></li>
                <li><a href="#" class="block p-2 rounded hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-300">Settings</a></li>
              </ul>
            </RLASidebar>
            <div class="flex-1 bg-white dark:bg-black p-6">
              <p class="text-sm text-gray-500">Content workspace next to structural layout sidebar.</p>
            </div>
          </div>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLASidebar class="w-64">
  <!-- Navigation items -->
</RLASidebar>`}</code></pre>
      </section>
    </div>
</AppLayout>
