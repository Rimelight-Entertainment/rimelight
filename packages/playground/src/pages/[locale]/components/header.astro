---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAHeader from "@rimelight/ui/components/astro/RLAHeader.astro";
import RLVHeader from "@rimelight/ui/components/vue/RLVHeader.vue";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLVButton from "@rimelight/ui/components/vue/RLVButton.vue";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("headerPage", {
    title: "Header Component",
    description: "Header Component Showcase",
    heading: "Header",
    tabAstro: "Astro (RLAHeader)",
    tabVue: "Vue (RLVHeader)",
    defaultSticky: "Default (Sticky)",
    fixedHideOnScroll: "Fixed with hideOnScroll",
    withoutContainer: "Without Container",
    defaultStickyDesc: "A sticky header with left, center, and right slots.",
    fixedHideOnScrollDesc: "A fixed header that hides on scroll down and shows on scroll up.",
    withoutContainerDesc: "Header with contain=false for full-width content.",
    home: "Home",
    about: "About",
    contact: "Contact",
    signIn: "Sign In",
});
---

<AppLayout title={messages.title} description={messages.description}>
  <main class="max-w-6xl mx-auto p-8">
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="tab-astro" class="tab-btn px-4 py-2 font-medium border-b-2 border-primary-500 text-primary-500" data-tab="astro">
        {messages.tabAstro}
      </button>
      <button id="tab-vue" class="tab-btn px-4 py-2 font-medium border-b-2 border-transparent hover:text-primary-500" data-tab="vue">
        {messages.tabVue}
      </button>
    </div>

    <!-- Astro Tab Content -->
    <div id="content-astro" class="tab-content space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.defaultSticky}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultStickyDesc}</p>
        <div class="border border-black p-md">
          <RLAHeader>
            <div slot="left">
              <span class="font-bold text-lg">Logo</span>
            </div>
            <div slot="center">
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">{messages.home}</a>
                <a href="#" class="hover:text-primary-500">{messages.about}</a>
                <a href="#" class="hover:text-primary-500">{messages.contact}</a>
              </nav>
            </div>
            <div slot="right">
              <RLAButton size="sm" variant="outline">{messages.signIn}</RLAButton>
            </div>
          </RLAHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAHeader>
  <div slot="left">
    <span class="font-bold text-lg">Logo</span>
  </div>
  <div slot="center">
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </div>
  <div slot="right">
    <RLAButton size="sm" variant="outline">Sign In</RLAButton>
  </div>
</RLAHeader>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.fixedHideOnScroll}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.fixedHideOnScrollDesc}</p>
        <div class="border border-black p-md">
          <RLAHeader fixed hideOnScroll>
            <div slot="left">
              <span class="font-bold text-lg">Logo</span>
            </div>
            <div slot="center">
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">{messages.home}</a>
                <a href="#" class="hover:text-primary-500">{messages.about}</a>
                <a href="#" class="hover:text-primary-500">{messages.contact}</a>
              </nav>
            </div>
            <div slot="right">
              <RLAButton size="sm" variant="outline">{messages.signIn}</RLAButton>
            </div>
          </RLAHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAHeader fixed hideOnScroll>
  <div slot="left">
    <span class="font-bold text-lg">Logo</span>
  </div>
  <div slot="center">
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </div>
  <div slot="right">
    <RLAButton size="sm" variant="outline">Sign In</RLAButton>
  </div>
</RLAHeader>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withoutContainer}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.withoutContainerDesc}</p>
        <div class="border border-black p-md">
          <RLAHeader contain={false}>
            <div slot="left">
              <span class="font-bold text-lg">Logo</span>
            </div>
            <div slot="center">
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">{messages.home}</a>
                <a href="#" class="hover:text-primary-500">{messages.about}</a>
                <a href="#" class="hover:text-primary-500">{messages.contact}</a>
              </nav>
            </div>
            <div slot="right">
              <RLAButton size="sm" variant="outline">{messages.signIn}</RLAButton>
            </div>
          </RLAHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAHeader contain={false}>
  <div slot="left">
    <span class="font-bold text-lg">Logo</span>
  </div>
  <div slot="center">
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </div>
  <div slot="right">
    <RLAButton size="sm" variant="outline">Sign In</RLAButton>
  </div>
</RLAHeader>`}</code></pre>
      </section>
    </div>

    <!-- Vue Tab Content -->
    <div id="content-vue" class="tab-content space-y-12 hidden">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.defaultSticky}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.defaultStickyDesc}</p>
        <div class="border border-black p-md">
          <RLVHeader client:load>
            <template #left>
              <span class="font-bold text-lg">Logo</span>
            </template>
            <template #center>
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">{messages.home}</a>
                <a href="#" class="hover:text-primary-500">{messages.about}</a>
                <a href="#" class="hover:text-primary-500">{messages.contact}</a>
              </nav>
            </template>
            <template #right>
              <RLVButton client:load size="sm" variant="outline">{messages.signIn}</RLVButton>
            </template>
          </RLVHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVHeader client:load>
  <template #left>
    <span class="font-bold text-lg">Logo</span>
  </template>
  <template #center>
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </template>
  <template #right>
    <RLVButton client:load size="sm" variant="outline">Sign In</RLVButton>
  </template>
</RLVHeader>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.fixedHideOnScroll}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.fixedHideOnScrollDesc}</p>
        <div class="border border-black p-md">
          <RLVHeader client:load fixed hideOnScroll>
            <template #left>
              <span class="font-bold text-lg">Logo</span>
            </template>
            <template #center>
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">{messages.home}</a>
                <a href="#" class="hover:text-primary-500">{messages.about}</a>
                <a href="#" class="hover:text-primary-500">{messages.contact}</a>
              </nav>
            </template>
            <template #right>
              <RLVButton client:load size="sm" variant="outline">{messages.signIn}</RLVButton>
            </template>
          </RLVHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVHeader client:load fixed hideOnScroll>
  <template #left>
    <span class="font-bold text-lg">Logo</span>
  </template>
  <template #center>
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </template>
  <template #right>
    <RLVButton client:load size="sm" variant="outline">Sign In</RLVButton>
  </template>
</RLVHeader>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.withoutContainer}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">{messages.withoutContainerDesc}</p>
        <div class="border border-black p-md">
          <RLVHeader client:load contain={false}>
            <template #left>
              <span class="font-bold text-lg">Logo</span>
            </template>
            <template #center>
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">{messages.home}</a>
                <a href="#" class="hover:text-primary-500">{messages.about}</a>
                <a href="#" class="hover:text-primary-500">{messages.contact}</a>
              </nav>
            </template>
            <template #right>
              <RLVButton client:load size="sm" variant="outline">{messages.signIn}</RLVButton>
            </template>
          </RLVHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVHeader client:load contain={false}>
  <template #left>
    <span class="font-bold text-lg">Logo</span>
  </template>
  <template #center>
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </template>
  <template #right>
    <RLVButton client:load size="sm" variant="outline">Sign In</RLVButton>
  </template>
</RLVHeader>`}</code></pre>
      </section>
    </div>
  </main>

  <script>
    function initTabs() {
      var tabBtns = document.querySelectorAll('.tab-btn');
      var tabContents = document.querySelectorAll('.tab-content');

      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var tab = btn.getAttribute('data-tab');

          tabBtns.forEach(function(b) {
            b.classList.remove('border-primary-500', 'text-primary-500');
            b.classList.add('border-transparent');
          });
          btn.classList.add('border-primary-500', 'text-primary-500');
          btn.classList.remove('border-transparent');

          tabContents.forEach(function(content) {
            content.classList.add('hidden');
          });
          var contentEl = document.getElementById('content-' + tab);
          if (contentEl) contentEl.classList.remove('hidden');
        });
      });
    }
    initTabs();
  </script>
</AppLayout>
