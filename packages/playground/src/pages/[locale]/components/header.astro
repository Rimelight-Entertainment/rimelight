---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import RLAHeader from "@rimelight/ui/components/astro/RLAHeader.astro";
import RLVHeader from "@rimelight/ui/components/vue/RLVHeader.vue";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import RLVButton from "@rimelight/ui/components/vue/RLVButton.vue";

const locale = Astro.currentLocale ?? 'en';
---

<AppLayout title="Header Component" description="Header Component Showcase">
  <main class="max-w-6xl mx-auto p-8">
    <a href={getRelativeLocaleUrl(locale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      Back to Components
    </a>

    <h1 class="text-3xl font-bold mb-8">Header</h1>

    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="tab-astro" class="tab-btn px-4 py-2 font-medium border-b-2 border-primary-500 text-primary-500" data-tab="astro">
        Astro (RLAHeader)
      </button>
      <button id="tab-vue" class="tab-btn px-4 py-2 font-medium border-b-2 border-transparent hover:text-primary-500" data-tab="vue">
        Vue (RLVHeader)
      </button>
    </div>

    <!-- Astro Tab Content -->
    <div id="content-astro" class="tab-content space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Default (Sticky)</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">A sticky header with left, center, and right slots.</p>
        <div class="border border-black p-md">
          <RLAHeader>
            <div slot="left">
              <span class="font-bold text-lg">Logo</span>
            </div>
            <div slot="center">
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">Home</a>
                <a href="#" class="hover:text-primary-500">About</a>
                <a href="#" class="hover:text-primary-500">Contact</a>
              </nav>
            </div>
            <div slot="right">
              <RLAButton size="sm" variant="outline">Sign In</RLAButton>
            </div>
          </RLAHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAHeader>
  <div slot="left">
    <span class="font-bold text-lg">Logo</span>
  </div>
  <div slot="center">
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </div>
  <div slot="right">
    <RLAButton size="sm" variant="outline">Sign In</RLAButton>
  </div>
</RLAHeader>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Fixed with hideOnScroll</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">A fixed header that hides on scroll down and shows on scroll up.</p>
        <div class="border border-black p-md">
          <RLAHeader fixed hideOnScroll>
            <div slot="left">
              <span class="font-bold text-lg">Logo</span>
            </div>
            <div slot="center">
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">Home</a>
                <a href="#" class="hover:text-primary-500">About</a>
                <a href="#" class="hover:text-primary-500">Contact</a>
              </nav>
            </div>
            <div slot="right">
              <RLAButton size="sm" variant="outline">Sign In</RLAButton>
            </div>
          </RLAHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAHeader fixed hideOnScroll>
  <div slot="left">
    <span class="font-bold text-lg">Logo</span>
  </div>
  <div slot="center">
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </div>
  <div slot="right">
    <RLAButton size="sm" variant="outline">Sign In</RLAButton>
  </div>
</RLAHeader>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Without Container</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">Header with contain=false for full-width content.</p>
        <div class="border border-black p-md">
          <RLAHeader contain={false}>
            <div slot="left">
              <span class="font-bold text-lg">Logo</span>
            </div>
            <div slot="center">
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">Home</a>
                <a href="#" class="hover:text-primary-500">About</a>
                <a href="#" class="hover:text-primary-500">Contact</a>
              </nav>
            </div>
            <div slot="right">
              <RLAButton size="sm" variant="outline">Sign In</RLAButton>
            </div>
          </RLAHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAHeader contain={false}>
  <div slot="left">
    <span class="font-bold text-lg">Logo</span>
  </div>
  <div slot="center">
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </div>
  <div slot="right">
    <RLAButton size="sm" variant="outline">Sign In</RLAButton>
  </div>
</RLAHeader>`}</code></pre>
      </section>
    </div>

    <!-- Vue Tab Content -->
    <div id="content-vue" class="tab-content space-y-12 hidden">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Default (Sticky)</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">A sticky header with left, center, and right slots.</p>
        <div class="border border-black p-md">
          <RLVHeader client:load>
            <template #left>
              <span class="font-bold text-lg">Logo</span>
            </template>
            <template #center>
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">Home</a>
                <a href="#" class="hover:text-primary-500">About</a>
                <a href="#" class="hover:text-primary-500">Contact</a>
              </nav>
            </template>
            <template #right>
              <RLVButton client:load size="sm" variant="outline">Sign In</RLVButton>
            </template>
          </RLVHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVHeader client:load>
  <template #left>
    <span class="font-bold text-lg">Logo</span>
  </template>
  <template #center>
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </template>
  <template #right>
    <RLVButton client:load size="sm" variant="outline">Sign In</RLVButton>
  </template>
</RLVHeader>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Fixed with hideOnScroll</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">A fixed header that hides on scroll down and shows on scroll up.</p>
        <div class="border border-black p-md">
          <RLVHeader client:load fixed hideOnScroll>
            <template #left>
              <span class="font-bold text-lg">Logo</span>
            </template>
            <template #center>
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">Home</a>
                <a href="#" class="hover:text-primary-500">About</a>
                <a href="#" class="hover:text-primary-500">Contact</a>
              </nav>
            </template>
            <template #right>
              <RLVButton client:load size="sm" variant="outline">Sign In</RLVButton>
            </template>
          </RLVHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVHeader client:load fixed hideOnScroll>
  <template #left>
    <span class="font-bold text-lg">Logo</span>
  </template>
  <template #center>
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </template>
  <template #right>
    <RLVButton client:load size="sm" variant="outline">Sign In</RLVButton>
  </template>
</RLVHeader>`}</code></pre>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Without Container</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">Header with contain=false for full-width content.</p>
        <div class="border border-black p-md">
          <RLVHeader client:load contain={false}>
            <template #left>
              <span class="font-bold text-lg">Logo</span>
            </template>
            <template #center>
              <nav class="flex gap-4">
                <a href="#" class="hover:text-primary-500">Home</a>
                <a href="#" class="hover:text-primary-500">About</a>
                <a href="#" class="hover:text-primary-500">Contact</a>
              </nav>
            </template>
            <template #right>
              <RLVButton client:load size="sm" variant="outline">Sign In</RLVButton>
            </template>
          </RLVHeader>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLVHeader client:load contain={false}>
  <template #left>
    <span class="font-bold text-lg">Logo</span>
  </template>
  <template #center>
    <nav class="flex gap-4">
      <a href="#" class="hover:text-primary-500">Home</a>
      <a href="#" class="hover:text-primary-500">About</a>
      <a href="#" class="hover:text-primary-500">Contact</a>
    </nav>
  </template>
  <template #right>
    <RLVButton client:load size="sm" variant="outline">Sign In</RLVButton>
  </template>
</RLVHeader>`}</code></pre>
      </section>
    </div>
  </main>

  <script>
    function initTabs() {
      var tabBtns = document.querySelectorAll('.tab-btn');
      var tabContents = document.querySelectorAll('.tab-content');

      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var tab = btn.getAttribute('data-tab');

          tabBtns.forEach(function(b) {
            b.classList.remove('border-primary-500', 'text-primary-500');
            b.classList.add('border-transparent');
          });
          btn.classList.add('border-primary-500', 'text-primary-500');
          btn.classList.remove('border-transparent');

          tabContents.forEach(function(content) {
            content.classList.add('hidden');
          });
          document.getElementById('content-' + tab).classList.remove('hidden');
        });
      });
    }
    initTabs();
  </script>
</AppLayout>
