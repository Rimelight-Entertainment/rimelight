---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAResizable from "@rimelight/ui/components/astro/RLAResizable.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("resizablePage", {
    title: "Resizable Component",
    description: "Resizable Component Showcase",
    heading: "Resizable",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black">
          <RLAResizable>
            <div class="flex h-48 border border-gray-200 dark:border-gray-800 rounded-lg overflow-hidden">
              <div class="w-1/3 bg-gray-100 dark:bg-gray-900 flex items-center justify-center p-4 border-r border-gray-200 dark:border-gray-800">
                <span class="text-sm font-semibold">Sidebar (Resizable)</span>
              </div>
              <div class="w-2/3 bg-white dark:bg-black flex items-center justify-center p-4">
                <span class="text-sm font-semibold">Main Dashboard Panel</span>
              </div>
            </div>
          </RLAResizable>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAResizable>
  <!-- Content with resize layout controls -->
</RLAResizable>`}</code></pre>
      </section>
    </div>
</AppLayout>
