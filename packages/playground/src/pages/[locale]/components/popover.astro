---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAPopover from "@rimelight/ui/components/astro/RLAPopover.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";

const activeLocale = Astro.currentLocale ?? 'en';
currentLocale.set(activeLocale);

const nav = useI18n("components", {
    backToComponents: "Back to Components",
});

const messages = useI18n("popoverPage", {
    title: "Popover Component",
    description: "Popover Component Showcase",
    heading: "Popover",
    default: "Default",
});
---

<AppLayout title={messages.title} description={messages.description}>
    <a href={getRelativeLocaleUrl(activeLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      {nav.backToComponents}
    </a>

    <h1 class="text-3xl font-bold mb-8">{messages.heading}</h1>

    <div class="space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">{messages.default}</h2>
        <div class="border border-gray-200 dark:border-gray-800 p-6 rounded-xl bg-white dark:bg-black flex justify-center">
          <RLAPopover>
            <RLAButton slot="trigger" variant="solid">Open Popover</RLAButton>
            <div class="space-y-2 py-1">
              <p class="text-sm font-semibold">Configure Settings</p>
              <p class="text-xs text-gray-600 dark:text-gray-400">Settings and customization details are nested inside standard overlay slots.</p>
            </div>
          </RLAPopover>
        </div>
        <pre class="bg-gray-950 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono border border-gray-800 my-4"><code>{`<RLAPopover>
  <RLAButton slot="trigger" variant="solid">Open Popover</RLAButton>
  <div>Content</div>
</RLAPopover>`}</code></pre>
      </section>
    </div>
</AppLayout>
