---
import AppLayout from '@/layouts/AppLayout.astro';
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
    error: unknown;
}

const activeLocale = Astro.currentLocale ?? "en";
currentLocale.set(activeLocale);

const messages = useI18n("errors", {
    serverError: "Server Error",
    unknownError: "Unknown error",
    goHome: "Go Home",
});

const { error } = Astro.props;
const errorMessage = error instanceof Error ? error.message : messages.unknownError;
---

<AppLayout title={messages.serverError} description={messages.serverError}>
    <main class="flex flex-col items-center justify-center py-24">
        <h1>{messages.serverError}</h1>
        <p>{errorMessage}</p>
        <a href={getRelativeLocaleUrl(activeLocale, "/")}>{messages.goHome}</a>
    </main>
</AppLayout>