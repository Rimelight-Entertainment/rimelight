---
import AppLayout from "@/layouts/AppLayout.astro";
// import { siteConfig } from "@/site.config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import RLAHeader from "@rimelight/ui/components/astro/RLAHeader.astro";

const activeLocale = Astro.currentLocale ?? "en";
currentLocale.set(activeLocale);

const messages = useI18n("testsHeaderPage", {
  title: "Header Layer Test",
  description: "Testing RLAHeader stacking with multiple fixed layers",
  heading: "Header Layer Test"
});
---

<AppLayout title={messages.title} description={messages.description}>
  <div class="max-w-4xl mx-auto px-4 py-xl space-y-lg">
    <a href={getRelativeLocaleUrl(activeLocale, "/tests")} class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary-500 mb-4">
      <span class="i-lucide-arrow-left"></span>
      Back to Tests
    </a>
    <h1 class="text-3xl font-bold">{messages.heading}</h1>
    <ul class="text-sm text-muted-foreground space-y-1 list-disc list-inside">
      <li>Three fixed headers stack at top: black (main), teal (secondary), amber (tertiary)</li>
      <li>Secondary (teal) always visible</li>
      <li>Tertiary (amber) hides on scroll down past 50px, reveals on scroll up</li>
      <li>Scroll down to see hide behavior, scroll back up to reveal</li>
    </ul>
  </div>

  <!-- 20 spacer sections for scroll testing -->
  <div class="max-w-4xl mx-auto px-4 space-y-lg pb-xl">
    {Array.from({ length: 20 }, (_, i) => (
      <section class="h-48 border border-dashed border-border rounded-xl flex items-center justify-center text-muted-foreground">
        Spacer Section {i + 1}
      </section>
    ))}
  </div>

  <!-- Extra header layers -->
  <RLAHeader contain={false} fixed={true} stackIndex={1} class="bg-teal-800 text-white">
    <div slot="left" class="px-4 text-sm font-medium">Secondary Header (stackIndex=1, always visible)</div>
  </RLAHeader>
  <RLAHeader contain={false} fixed={true} stackIndex={2} hideOnScroll={true} class="bg-amber-800 text-white">
    <div slot="left" class="px-4 text-sm font-medium">Tertiary Header (stackIndex=2, hideOnScroll)</div>
  </RLAHeader>
</AppLayout>
