---
import AppLayout from "@/layouts/AppLayout.astro";
import { siteConfig } from "@/site.config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import { getCollection } from "astro:content";
import RLAPageSection from "@rimelight/ui/components/astro/RLAPageSection.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import { BlogPosts, BlogPost } from "@rimelight/ui/nuxt";

const activeLocale = Astro.currentLocale ?? "en";
currentLocale.set(activeLocale);

const messages = useI18n("playground", {
    heroTitle: "Welcome to the Rimelight Entertainment Playground",
    heroDesc: "Look around, test, and play with some of our internal tooling.",
    heroLink: "Learn More",
    postsTitle: "Latest Posts",
    postsDesc: "Read the latest updates to our libraries.",
    viewAllPosts: "View All Posts",
    ctaTitle: "Wish to contribute?",
    ctaDesc: "Contribute to our open-source project today.",
    ctaStart: "Get Started",
    ctaContribute: "Contribute",
});

const latestPosts = (await getCollection("blog"))
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroLinks = [
    {
        label: messages.heroLink,
        href: "https://rimelight.com/en/docs/packages/overview/introduction/",
        color: "primary",
        variant: "solid",
    }
];

const ctaLinks = [
    {
        label: messages.ctaStart,
        href: "https://rimelight.com/en/docs/packages/overview/introduction/",
        color: "primary",
        variant: "solid"
    },
    {
        label: messages.ctaContribute,
        href: "https://rimelight.com/en/docs/overview/contributing/",
        color: "primary",
        variant: "outline",
        trailingIcon: "i-lucide-arrow-right"
    }
];
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
    <RLAPageSection
            variant="hero"
            reverse={true}
            title={messages.heroTitle}
            description={messages.heroDesc}
            links={heroLinks}
    >
        <RLALogo class="pointer-events-none h-64 w-auto text-white" variant="logomark" mode="white" />
    </RLAPageSection>

    <RLAPageSection
            orientation="vertical"
            title={messages.postsTitle}
            description={messages.postsDesc}
    >
        <div slot="body" class="flex flex-col gap-xl">
            <BlogPosts client:load class="grid md:grid-cols-2 lg:grid-cols-3 gap-md">
                {
                    latestPosts.map((post) => (
                            <BlogPost
                                    client:load
                                    variant="ghost"
                                    image={post.data.heroImage}
                                    badge={
                                        {
                                            label: post.data.type,
                                            variant: "solid",
                                            color: "primary"
                                        }
                                    }
                                    date={post.data.pubDate}
                                    title={post.data.title}
                                    description={post.data.description}
                                    to={getRelativeLocaleUrl(activeLocale, `/blog/${post.id}/`)}
                            />
                    ))
                }
            </BlogPosts>

            {latestPosts.length > 0 && (
                    <RLAButton
                            label={messages.viewAllPosts}
                            href={getRelativeLocaleUrl(activeLocale, "/blog")}
                            color="primary"
                            variant="link"
                            trailingIcon="i-lucide-arrow-right"
                    />
            )}
        </div>
    </RLAPageSection>

    <RLAPageSection
            variant="cta"
            ctaVariant="solid"
            title={messages.ctaTitle}
            description={messages.ctaDesc}
            links={ctaLinks}
    />
</AppLayout>