---
import AppLayout from "@/layouts/AppLayout.astro";
import { siteConfig } from "@/site.config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useI18n, currentLocale } from "astro-nanostores-i18n:runtime";
import { getCollection } from "astro:content";
import RLAPageSection from "@rimelight/ui/components/astro/RLAPageSection.astro";
import RLALogo from "@rimelight/ui/components/astro/RLALogo.astro";
import RLAButton from "@rimelight/ui/components/astro/RLAButton.astro";
import { BlogPosts, BlogPost } from "@rimelight/ui/nuxt";

const activeLocale = Astro.currentLocale ?? "en";
currentLocale.set(activeLocale);

const messages = useI18n("playground", {
    heroTitle: "Welcome to the Rimelight Entertainment Playground",
    heroDesc: "Look around, test, and play with some of our internal tooling.",
    heroLink: "Learn More",
    postsTitle: "Latest Posts",
    postsDesc: "Read the latest updates to our libraries.",
    viewAllPosts: "View All Posts",
    ctaTitle: "Wish to contribute?",
    ctaDesc: "Contribute to our open-source project today.",
    ctaStart: "Get Started",
    ctaContribute: "Contribute",
});

const latestPosts = (await getCollection("blog"))
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const heroLinks = [
    {
        label: messages.heroLink,
        href: "https://rimelight.com/en/docs/packages/overview/introduction/",
        color: "primary",
        variant: "solid",
    }
];

const ctaLinks = [
    {
        label: messages.ctaStart,
        href: "https://rimelight.com/en/docs/packages/overview/introduction/",
        color: "primary",
        variant: "solid"
    },
    {
        label: messages.ctaContribute,
        href: "https://rimelight.com/en/docs/overview/contributing/",
        color: "primary",
        variant: "outline",
        trailingIcon: "i-lucide-arrow-right"
    }
];
---

<AppLayout title={siteConfig.name} description={siteConfig.description}>
    <RLAPageSection
            variant="hero"
            reverse={true}
            title={messages.heroTitle}
            description={messages.heroDesc}
            links={heroLinks}
    >
        <RLALogo class="pointer-events-none h-64 w-auto text-white" variant="logomark" mode="white" />
    </RLAPageSection>

    <RLAPageSection
            orientation="vertical"
            title={messages.postsTitle}
            description={messages.postsDesc}
    >
        <div slot="body" class="flex flex-col gap-xl">
            <BlogPosts client:load class="grid md:grid-cols-2 lg:grid-cols-3 gap-md">
                {
                    latestPosts.map((post) => (
                            <BlogPost
                                    client:load
                                    variant="ghost"
                                    image={post.data.heroImage}
                                    badge={
                                        {
                                            label: post.data.type,
                                            variant: "solid",
                                            color: "primary"
                                        }
                                    }
                                    date={post.data.pubDate}
                                    title={post.data.title}
                                    description={post.data.description}
                                    to={getRelativeLocaleUrl(activeLocale, `/blog/${post.id}/`)}
                            />
                    ))
                }
            </BlogPosts>

            {latestPosts.length > 0 && (
                    <RLAButton
                            label={messages.viewAllPosts}
                            href={getRelativeLocaleUrl(activeLocale, "/blog")}
                            color="primary"
                            variant="link"
                            trailingIcon="i-lucide-arrow-right"
                    />
            )}
        </div>
    </RLAPageSection>

    <RLAPageSection
            variant="cta"
            ctaVariant="solid"
            title={messages.ctaTitle}
            description={messages.ctaDesc}
            links={ctaLinks}
    />

    <div class="flex justify-center py-xl">
        <div class="flex flex-wrap gap-md items-center justify-center">
            <span class="text-sm font-bold w-full text-center opacity-60">Phase 3 — Color Registration</span>

            <!-- blurple (mode-aware: different in light vs dark) -->
            <RLAButton label="Blurple" color="blurple" variant="solid" />

            <!-- grand-tale-primary (mode-aware with dark values) -->
            <RLAButton label="Grand Tale Primary" color="grand-tale-primary" variant="solid" />

            <!-- blagenta-374 (single arbitrary shade) -->
            <button class="bg-blagenta-374 text-white px-4 py-2 rounded-md font-medium h-9 text-sm inline-flex items-center justify-center gap-4xs">
                Blagenta 374
            </button>

            <!-- nonexistent (not registered — expect blank/broken) -->
            <RLAButton label="Nonexistent" color="nonexistent" variant="solid" />
        </div>
    </div>

    <div class="flex justify-center py-xl">
        <div class="flex flex-wrap gap-md items-center justify-center">
            <span class="text-sm font-bold w-full text-center opacity-60">Phase 4 — Theme Awareness</span>

            <!-- mode-aware: light + dark defined, adapts natively -->
            <RLAButton label="Mode Aware" color="mode-aware" variant="solid" />
            <RLAButton label="MA light" color="mode-aware" variant="solid" theme="light" />
            <RLAButton label="MA dark" color="mode-aware" variant="solid" theme="dark" />
            <RLAButton label="MA flat" color="mode-aware" variant="solid" theme="flat" />

            <!-- mode-pinned: has explicit flat bucket -->
            <RLAButton label="Mode Pinned" color="mode-pinned" variant="solid" />
            <RLAButton label="MP light" color="mode-pinned" variant="solid" theme="light" />
            <RLAButton label="MP dark" color="mode-pinned" variant="solid" theme="dark" />
            <RLAButton label="MP flat" color="mode-pinned" variant="solid" theme="flat" />

            <!-- flat-test: flat format, same everywhere -->
            <RLAButton label="Flat Test" color="flat-test" variant="solid" />
            <RLAButton label="FT light" color="flat-test" variant="solid" theme="light" />
            <RLAButton label="FT dark" color="flat-test" variant="solid" theme="dark" />
            <RLAButton label="FT flat" color="flat-test" variant="solid" theme="flat" />

            <!-- no-dark: only light defined -->
            <RLAButton label="No Dark" color="no-dark" variant="solid" />
            <RLAButton label="ND light" color="no-dark" variant="solid" theme="light" />
            <RLAButton label="ND dark" color="no-dark" variant="solid" theme="dark" />

            <!-- no-light: only dark defined -->
            <RLAButton label="No Light" color="no-light" variant="solid" />
            <RLAButton label="NL dark" color="no-light" variant="solid" theme="dark" />
        </div>
    </div>
</AppLayout>