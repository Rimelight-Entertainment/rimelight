---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rimelight UI Playground">
  <p class="subtitle">Testing <code>@rimelight/ui</code> components — Astro and Vue versions side by side.</p>

  <section>
    <h2>Available Showcases</h2>
    <div class="grid">
      <a href="/button" class="item" style="text-decoration:none; color:inherit;">
        <strong>Button</strong>
        <code>RLAButton / RLVButton</code>
        <code style="color: var(--muted);">Variants × Colors matrix</code>
      </a>
      <a href="/header" class="item" style="text-decoration:none; color:inherit;">
        <strong>Header</strong>
        <code>RLAHeader / RLVHeader</code>
        <code style="color: var(--muted);">Variants × Colors + slot layouts</code>
      </a>
    </div>
  </section>
</Layout>
