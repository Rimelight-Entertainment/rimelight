---
import AppLayout from '@/layouts/AppLayout.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import RLAScrollToTop from "@rimelight/ui/components/astro/RLAScrollToTop.astro";
import RLVScrollToTop from "@rimelight/ui/components/vue/RLVScrollToTop.vue";
---

<AppLayout title="Scroll to Top Component" description="Scroll to Top Component Showcase">
  <main class="max-w-6xl mx-auto p-8">
    <a href={getRelativeLocaleUrl(Astro.currentLocale, 'components')} class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 hover:text-primary-500 mb-8">
      <span class="i-lucide-arrow-left"></span>
      Back to Components
    </a>

    <h1 class="text-3xl font-bold mb-8">Scroll to Top</h1>

    <!-- Tab Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-200 dark:border-gray-700">
      <button id="tab-astro" class="tab-btn px-4 py-2 font-medium border-b-2 border-primary-500 text-primary-500" data-tab="astro">
        Astro (RLAScrollToTop)
      </button>
      <button id="tab-vue" class="tab-btn px-4 py-2 font-medium border-b-2 border-transparent hover:text-primary-500" data-tab="vue">
        Vue (RLVScrollToTop)
      </button>
    </div>

    <!-- Astro Tab Content -->
    <div id="content-astro" class="tab-content space-y-12">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Default</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">A button that appears when scrolling down and scrolls back to top when clicked.</p>
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
          <RLAScrollToTop />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">Scroll down to see the button appear, then click it to scroll back to top</p>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">With Progress Indicator</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">Shows scroll progress in the circle.</p>
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
          <RLAScrollToTop showProgress />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">Scroll down to see the progress circle fill up</p>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Colors</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">Different color options.</p>
        <div class="space-y-4">
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
            <p class="px-4 py-2 text-sm text-gray-500 border-b">Primary (Default)</p>
            <RLAScrollToTop color="primary" />
            <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900"></div>
          </div>
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
            <p class="px-4 py-2 text-sm text-gray-500 border-b">Secondary</p>
            <RLAScrollToTop color="secondary" />
            <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900"></div>
          </div>
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
            <p class="px-4 py-2 text-sm text-gray-500 border-b">Success</p>
            <RLAScrollToTop color="success" />
            <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900"></div>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Custom Threshold</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">Button appears after scrolling 500px.</p>
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
          <RLAScrollToTop threshold={500} />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">Scroll past 500px to see the button appear</p>
          </div>
        </div>
      </section>
    </div>

    <!-- Vue Tab Content -->
    <div id="content-vue" class="tab-content space-y-12 hidden">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Default</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">A button that appears when scrolling down and scrolls back to top when clicked.</p>
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
          <RLVScrollToTop client:load />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">Scroll down to see the button appear, then click it to scroll back to top</p>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">With Progress Indicator</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">Shows scroll progress in the circle.</p>
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
          <RLVScrollToTop client:load showProgress />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">Scroll down to see the progress circle fill up</p>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Colors</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">Different color options.</p>
        <div class="space-y-4">
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
            <p class="px-4 py-2 text-sm text-gray-500 border-b">Primary (Default)</p>
            <RLVScrollToTop client:load color="primary" />
            <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900"></div>
          </div>
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
            <p class="px-4 py-2 text-sm text-gray-500 border-b">Secondary</p>
            <RLVScrollToTop client:load color="secondary" />
            <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900"></div>
          </div>
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
            <p class="px-4 py-2 text-sm text-gray-500 border-b">Success</p>
            <RLVScrollToTop client:load color="success" />
            <div class="p-8 h-48 bg-gray-50 dark:bg-gray-900"></div>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Custom Threshold</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">Button appears after scrolling 500px.</p>
        <div class="border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
          <RLVScrollToTop client:load threshold={500} />
          <div class="p-8 h-96 bg-gray-50 dark:bg-gray-900 flex items-center justify-center">
            <p class="text-gray-400">Scroll past 500px to see the button appear</p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    function initTabs() {
      var tabBtns = document.querySelectorAll('.tab-btn');
      var tabContents = document.querySelectorAll('.tab-content');

      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var tab = btn.getAttribute('data-tab');

          tabBtns.forEach(function(b) {
            b.classList.remove('border-primary-500', 'text-primary-500');
            b.classList.add('border-transparent');
          });
          btn.classList.add('border-primary-500', 'text-primary-500');
          btn.classList.remove('border-transparent');

          tabContents.forEach(function(content) {
            content.classList.add('hidden');
          });
          document.getElementById('content-' + tab).classList.remove('hidden');
        });
      });
    }
    initTabs();
  </script>
</AppLayout>
