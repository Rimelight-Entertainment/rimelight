{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts",
    // "auto-imports.d.ts",  /* removed — stale nuxt-ui auto-imports */    "components.d.ts",
    "src/env.d.ts"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "preserve"
  }
}
