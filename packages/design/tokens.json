  "ramp": {
    "neutral": {
      "$type": "rimelight.ramp",
      "$value": {
        "chroma": 0.012,
        "hue": 255
      },
      "$description": "Was achromatic (chroma 0). Small cool tint so shades sit near Space's cool neutrals (owner Q2). 950 light pinned to Space ink #101014 (Q22).",
      "$extensions": {
        "rimelight": {
          "pin": {
            "950": {
              "light": "#101014"
            }
          }
        }
      }
    },
    "primary": {
      "$type": "rimelight.ramp",
      "$value": {
        "chroma": 0.21,
        "hue": 258
      },
      "$description": "Hue moved from 260 to 258 toward Space's accent blue. 500 pinned to Space accent #0D7FFF light and #4DA0FF dark (Q25), so the accent fills match Space.",
      "$extensions": {
        "rimelight": {
          "pin": {
            "500": {
              "light": "#0D7FFF",
              "dark": "#4DA0FF"
            },
            "600": {
              "light": "#1659C4",
              "dark": "#4DA0FF"
            },
            "700": {
              "light": "#164FA8",
              "dark": "#8DBBFF"
            }
          }
        }
      }
    },
    "secondary": {
      "$type": "rimelight.ramp",
      "$value": {
        "chroma": 0.18,
        "hue": 70
      },
      "$description": "Kept as a colour (owner Q1). Ochre, unchanged from the web palette. Space's secondary button maps to outline and neutral (D5), not to this ramp."
    },
    "info": {
      "$type": "rimelight.ramp",
      "$value": {
        "chroma": 0.13,
        "hue": 268
      },
      "$description": "Retuned toward Space's indigo-grey info #3B5BA9 (owner Q4): hue 268 and chroma 0.13 instead of the web's 260 and 0.24."
    },
    "success": {
      "$type": "rimelight.ramp",
      "$value": {
        "chroma": 0.2,
        "hue": 175
      },
      "$description": "Retuned toward Space's teal success #0A7563 (owner Q3): hue 175 instead of the web's green 150. Chroma kept at 0.2."
    },
    "warning": {
      "$type": "rimelight.ramp",
      "$value": {
        "chroma": 0.17,
        "hue": 86
      },
      "$description": "Web palette unchanged. Space's amber #8A5800 light and #FFC14D dark are close to the web hue 86 family."
    },
    "error": {
      "$type": "rimelight.ramp",
      "$value": {
        "chroma": 0.24,
        "hue": 25
      },
      "$description": "Web palette unchanged. Space's danger role is named error in D5. Space's red #B3261E light is a different red from the web 500, so the danger roles below use Space hex values."
    },
    "commentary": {
      "$type": "rimelight.ramp",
      "$value": {
        "chroma": 0.29,
        "hue": 322
      },
      "$description": "Web palette unchanged. Commentary has no Space role yet (D5). Anchor shades 500 solid, 600 hover and text, 100 tint are accepted (owner Q21) and must pass the generator's contrast checks."
    },
    "ideation": {
