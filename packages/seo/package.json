{
  "name": "@rimelight/seo",
  "version": "0.0.1",
  "private": false,
  "description": "Generic SEO utilities for Astro sites — sitemap, robots.txt builders, and SEOHead component",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./sitemap": "./src/sitemap.ts",
    "./robots": "./src/robots.ts",
    "./components/*": "./src/components/*",
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "astro": "7.1.6",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "astro": ">=7.0.1"
  },
  "packageManager": "pnpm@11.18.0"
}
