{
  "name": "@rimelight/seo",
  "version": "0.0.5",
  "private": false,
  "description": "Rimelight Entertainment's SEO Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "import": "./dist/types.mjs"
    },
    "./sitemap": {
      "types": "./dist/sitemap.d.mts",
      "import": "./dist/sitemap.mjs"
    },
    "./robots": {
      "types": "./dist/robots.d.mts",
      "import": "./dist/robots.mjs"
    },
    "./integration": {
      "types": "./dist/integration.d.mts",
      "import": "./dist/integration.mjs"
    },
    "./rss": {
      "types": "./dist/rss.d.mts",
      "import": "./dist/rss.mjs"
    },
    "./og": {
      "types": "./dist/og.d.mts",
      "import": "./dist/og.mjs"
    },
    "./components/*": "./src/components/*",
    "./routes/*": "./src/routes/*",
    "./*": "./src/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm run build",
    "check": "vp check --fix && astro check"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*",
    "astro": "7.3.2",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "astro": ">=7.0.0",
    "takumi-js": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "takumi-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.8.2"
  },
  "packageManager": "pnpm@12.4.1"
}
