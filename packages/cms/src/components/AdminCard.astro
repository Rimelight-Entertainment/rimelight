---
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card.vue";

const {
  title,
  description,
  compact = false,
  class: className = "",
} = Astro.props as {
  title: string;
  description?: string | undefined;
  compact?: boolean | undefined;
  class?: string | undefined;
};
---

<Card className={className}>
  <CardHeader className={compact ? "px-3 py-3" : "border-b"}>
    <CardTitle className={compact ? "text-sm" : undefined}>{title}</CardTitle>
    {description && <CardDescription>{description}</CardDescription>}
  </CardHeader>
  <CardContent className={compact ? "px-3 pb-3" : undefined}>
    <slot />
  </CardContent>
</Card>


