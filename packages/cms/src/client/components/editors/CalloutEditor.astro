---
export interface Props {
  variant?: string
  children?: any[]
}

const VARIANTS = {
  info: { icon: "○", color: "blue", label: "Info" },
  success: { icon: "✓", color: "green", label: "Success" },
  warning: { icon: "⚠", color: "amber", label: "Warning" },
  error: { icon: "✕", color: "red", label: "Error" },
  commentary: { icon: "💬", color: "gray", label: "Commentary" },
  ideation: { icon: "💡", color: "purple", label: "Ideation" },
  source: { icon: "<>", color: "teal", label: "Source" }
}
---

<div class="rimelight-callout-editor flex items-start gap-3 p-4 rounded-lg border my-1 relative transition-colors w-full border-blue-700 bg-blue-950/20">
  <div class="callout-icon-btn text-xl cursor-pointer select-none leading-none text-blue-400">○</div>

  <div class="callout-dropdown absolute left-0 top-10 z-50 w-52 bg-gray-900 border border-gray-700 rounded-lg shadow-xl p-1 hidden flex-col gap-1">
    {Object.entries(VARIANTS).map(([key, config]) => (
      <div data-variant={key} class="variant-item flex items-center gap-2 w-full px-3 py-2 rounded text-sm hover:bg-gray-800 cursor-pointer text-gray-300">
        <span class="text-lg w-6 text-center">{config.icon}</span>
        <span>{config.label}</span>
      </div>
    ))}
  </div>

  <div class="flex-1 min-w-0 flex flex-col gap-2">
    <div class="children-container flex flex-col gap-2"></div>
  </div>
</div>

<script>
  import type Sortable from "sortablejs"
  import { initBlockSortable } from "../../utils/sortable"

  interface BaseBlock {
    id: string
    type: string
    isTemplated?: boolean
    templatedProps?: boolean | string[]
    allowedRoles?: string[]
    requiredPermission?: string
    props: Record<string, any>
    children?: BaseBlock[]
  }

  const VARIANTS: Record<string, { icon: string; color: string; label: string }> = {
    info: { icon: "○", color: "blue", label: "Info" },
    success: { icon: "✓", color: "green", label: "Success" },
    warning: { icon: "⚠", color: "amber", label: "Warning" },
    error: { icon: "✕", color: "red", label: "Error" },
    commentary: { icon: "💬", color: "gray", label: "Commentary" },
    ideation: { icon: "💡", color: "purple", label: "Ideation" },
    source: { icon: "<>", color: "teal", label: "Source" }
  }

  export class RimelightCalloutEditor extends HTMLElement {
    private iconButton!: HTMLElement
    private dropdown!: HTMLElement
    private childrenContainer!: HTMLElement
    private containerEl!: HTMLElement
    private sortableInstance?: Sortable

    private currentProps: { variant: string; children: BaseBlock[] } = {
      variant: "info",
      children: []
    }
    private sectionDepth: number = 0

    connectedCallback() {
      if (this.children.length === 0) {
        let dropdownItems = ""
        Object.entries(VARIANTS).forEach(([key, config]) => {
          dropdownItems += `<div data-variant="${key}" class="variant-item flex items-center gap-2 w-full px-3 py-2 rounded text-sm hover:bg-gray-800 cursor-pointer text-gray-300"><span class="text-lg w-6 text-center">${config.icon}</span><span>${config.label}</span></div>`
        })
        this.innerHTML = `
          <div class="rimelight-callout-editor flex items-start gap-3 p-4 rounded-lg border my-1 relative transition-colors w-full border-blue-700 bg-blue-950/20">
            <div class="callout-icon-btn text-xl cursor-pointer select-none leading-none text-blue-400">○</div>
            <div class="callout-dropdown absolute left-0 top-10 z-50 w-52 bg-gray-900 border border-gray-700 rounded-lg shadow-xl p-1 hidden flex-col gap-1">
              ${dropdownItems}
            </div>
            <div class="flex-1 min-w-0 flex flex-col gap-2">
              <div class="children-container flex flex-col gap-2"></div>
            </div>
          </div>
        `
      }

      this.containerEl = this.querySelector('.rimelight-callout-editor') as HTMLElement
      this.iconButton = this.querySelector('.callout-icon-btn') as HTMLElement
      this.dropdown = this.querySelector('.callout-dropdown') as HTMLElement
      this.childrenContainer = this.querySelector('.children-container') as HTMLElement

      if (!this.iconButton) return

      this.iconButton.addEventListener("click", (e) => {
        e.stopPropagation()
        this.toggleDropdown()
      })

      const variantItems = this.querySelectorAll('.variant-item')
      variantItems.forEach((item) => {
        item.addEventListener('click', (e) => {
          e.stopPropagation()
          const key = (item as HTMLElement).dataset.variant || "info"
          this.currentProps.variant = key
          this.closeDropdown()
          this.renderVariant()
          this.dispatchPropsChange()
        })
      })

      document.addEventListener("click", () => this.closeDropdown())

      this.setupChildrenListeners()
      this.render()
    }

    setProps(props: { variant: string; children: BaseBlock[] }, sectionDepth: number = 0): void {
      this.currentProps = { ...this.currentProps, ...props }
      this.sectionDepth = sectionDepth
      if (!this.iconButton) return
      this.render()
    }

    private toggleDropdown() {
      this.dropdown.classList.toggle("hidden")
      this.dropdown.classList.toggle("flex")
    }

    private closeDropdown() {
      this.dropdown.classList.add("hidden")
      this.dropdown.classList.remove("flex")
    }

    private render() {
      this.renderVariant()
      this.renderChildren()
    }

    private renderVariant() {
      const variant = this.currentProps.variant as string
      const config = VARIANTS[variant] || VARIANTS.info!

      this.iconButton.textContent = config.icon
      this.containerEl.className = "rimelight-callout-editor flex items-start gap-3 p-4 rounded-lg border my-1 relative transition-colors w-full"
      this.iconButton.className = "callout-icon-btn text-xl cursor-pointer select-none leading-none"

      switch (variant) {
        case "info":
          this.containerEl.classList.add("border-blue-700", "bg-blue-950/20")
          this.iconButton.classList.add("text-blue-400")
          break
        case "success":
          this.containerEl.classList.add("border-green-700", "bg-green-950/20")
          this.iconButton.classList.add("text-green-400")
          break
        case "warning":
          this.containerEl.classList.add("border-amber-700", "bg-amber-950/20")
          this.iconButton.classList.add("text-amber-400")
          break
        case "error":
          this.containerEl.classList.add("border-red-700", "bg-red-950/20")
          this.iconButton.classList.add("text-red-400")
          break
        case "commentary":
          this.containerEl.classList.add("border-gray-700", "bg-gray-900/20")
          this.iconButton.classList.add("text-gray-400")
          break
        case "ideation":
          this.containerEl.classList.add("border-purple-700", "bg-purple-950/20")
          this.iconButton.classList.add("text-purple-400")
          break
        case "source":
          this.containerEl.classList.add("border-teal-700", "bg-teal-950/20")
          this.iconButton.classList.add("text-teal-400")
          break
        default:
          this.containerEl.classList.add("border-blue-700", "bg-blue-950/20")
          this.iconButton.classList.add("text-blue-400")
          break
      }
    }

    private renderChildren(): void {
      if (!this.childrenContainer) return
      this.childrenContainer.innerHTML = ""

      const childrenBlocks = this.currentProps.children || []

      if (childrenBlocks.length === 0) {
        const empty = document.createElement("div")
        empty.className =
          "cms-empty-placeholder text-gray-600 text-xs italic py-2 border border-dashed border-gray-800/80 rounded my-1 select-none pointer-events-none"
        empty.textContent = "Empty callout — drag blocks here"
        this.childrenContainer.appendChild(empty)
      } else {
        childrenBlocks.forEach((block) => {
          const el = document.createElement("rimelight-block") as any
          el.dataset.id = block.id
          this.childrenContainer.appendChild(el)
          if (typeof el.setBlock === "function") {
            el.setBlock(block, this.sectionDepth)
          }
        })
      }

      if (this.sortableInstance) this.sortableInstance.destroy()
      this.sortableInstance = initBlockSortable(this.childrenContainer, {
        filter: ".cms-empty-placeholder, .locked",
        onReorder: (oldIdx: number, newIdx: number) => {
          const item = childrenBlocks.splice(oldIdx, 1)[0]
          if (item) childrenBlocks.splice(newIdx, 0, item)
          this.currentProps.children = childrenBlocks
          this.dispatchPropsChange()
        },
        onAdd: () => {
          const placeholder = this.childrenContainer.querySelector(".cms-empty-placeholder")
          if (placeholder) placeholder.remove()
          this.syncChildrenFromDom()
        },
        onRemove: () => {
          this.syncChildrenFromDom()
          if ((this.currentProps.children || []).length === 0) {
            this.renderChildren()
          }
        }
      })
    }

    private syncChildrenFromDom(): void {
      const blockElements = Array.from(
        this.childrenContainer.querySelectorAll(":scope > rimelight-block")
      ) as any[]
      const newChildren: BaseBlock[] = []
      blockElements.forEach((el) => {
        if (el.blockData) {
          newChildren.push(el.blockData)
        }
      })
      this.currentProps.children = newChildren
      this.dispatchPropsChange()
    }

    private setupChildrenListeners(): void {
      this.childrenContainer.addEventListener("block-change", (e: Event) => {
        e.stopPropagation()
        if (e instanceof CustomEvent && e.detail?.block) {
          const block: BaseBlock = e.detail.block
          const childrenBlocks = this.currentProps.children || []
          const idx = childrenBlocks.findIndex((b) => b.id === block.id)
          if (idx !== -1) {
            childrenBlocks[idx] = block
            this.currentProps.children = childrenBlocks
            this.dispatchPropsChange()
          }
        }
      })

      this.childrenContainer.addEventListener("block-delete", (e: Event) => {
        e.stopPropagation()
        if (e instanceof CustomEvent && e.detail?.id) {
          const childrenBlocks = this.currentProps.children || []
          this.currentProps.children = childrenBlocks.filter((b) => b.id !== e.detail.id)
          this.renderChildren()
          this.dispatchPropsChange()
        }
      })

      this.childrenContainer.addEventListener("block-move", (e: Event) => {
        e.stopPropagation()
        if (e instanceof CustomEvent && e.detail) {
          const { id, direction } = e.detail
          const childrenBlocks = this.currentProps.children || []
          const idx = childrenBlocks.findIndex((b) => b.id === id)
          const newIdx = idx + direction
          if (idx !== -1 && newIdx >= 0 && newIdx < childrenBlocks.length) {
            const item = childrenBlocks.splice(idx, 1)[0]!
            childrenBlocks.splice(newIdx, 0, item)
            this.currentProps.children = childrenBlocks
            this.renderChildren()
            this.dispatchPropsChange()
          }
        }
      })

      this.childrenContainer.addEventListener("block-duplicate", (e: Event) => {
        e.stopPropagation()
        if (e instanceof CustomEvent && e.detail?.id) {
          const childrenBlocks = this.currentProps.children || []
          const idx = childrenBlocks.findIndex((b) => b.id === e.detail.id)
          if (idx !== -1) {
            const clone: BaseBlock = JSON.parse(JSON.stringify(childrenBlocks[idx]))
            clone.id = crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2)
            childrenBlocks.splice(idx + 1, 0, clone)
            this.currentProps.children = childrenBlocks
            this.renderChildren()
            this.dispatchPropsChange()
          }
        }
      })

      this.childrenContainer.addEventListener("block-add-adjacent", (e: Event) => {
        e.stopPropagation()
        if (e instanceof CustomEvent && e.detail) {
          const { id, position } = e.detail
          this.dispatchEvent(
            new CustomEvent("block-picker-request", {
              bubbles: true,
              detail: { targetId: id, position, containerId: this.dataset.blockId }
            })
          )
        }
      })
    }

    private dispatchPropsChange() {
      this.dispatchEvent(
        new CustomEvent("props-change", {
          bubbles: false,
          detail: { props: { ...this.currentProps } }
        })
      )
    }
  }

  if (!customElements.get("rimelight-callout-editor")) {
    customElements.define("rimelight-callout-editor", RimelightCalloutEditor)
  }
</script>
