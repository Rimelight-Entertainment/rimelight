---
import CMSDashboardLayout from "../layouts/CMSDashboardLayout.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLATable from "@rimelight/ui/components/table/RLATable.astro";
import type { TableColumn } from "@rimelight/ui/components/table/table";
import { dropdownMenuTheme } from "@rimelight/ui/components/dropdown-menu/dropdown-menu.theme";
import { db } from "virtual:rimelight-cms/db";
import { pageTemplates } from "../../schema/page_templates.ts";
import { desc } from "drizzle-orm";
import { getRelativeLocaleUrl } from "@rimelight/i18n";
import { ensureDefaultTemplates } from "../../services/template-seeder.ts";

export const prerender = false;

const currentLocale = Astro.currentLocale ?? "en";
const dropdownClasses = dropdownMenuTheme({ size: "xs" });

let templates: any[] = [];
if (db) {
  try {
    // Auto-seed default starter templates if table is empty
    await ensureDefaultTemplates(db, pageTemplates);

    templates = await db
      .select()
      .from(pageTemplates)
      .orderBy(desc(pageTemplates.createdAt));
  } catch (err) {
    console.warn("Failed to fetch templates:", err);
  }
}

// Format template rows
const formattedTemplates = templates.map((tmpl) => {
  let titleStr = "";
  if (typeof tmpl.title === "object" && tmpl.title !== null) {
    titleStr = (tmpl.title as Record<string, string>)[currentLocale] || (tmpl.title as Record<string, string>)["en"] || Object.values(tmpl.title)[0] || "";
  } else {
    titleStr = String(tmpl.title || "Untitled Template");
  }

  let descStr = "";
  if (typeof tmpl.description === "object" && tmpl.description !== null) {
    descStr = (tmpl.description as Record<string, string>)[currentLocale] || (tmpl.description as Record<string, string>)["en"] || "";
  } else if (tmpl.description) {
    descStr = String(tmpl.description);
  }

  const pageType = String(tmpl.pageType || "page").toLowerCase();
  const initialBlocksCount = Array.isArray(tmpl.initialBlocks) ? tmpl.initialBlocks.length : 0;
  const propertiesCount = tmpl.defaultProperties ? Object.keys(tmpl.defaultProperties).length : 0;

  return {
    id: tmpl.id,
    slug: tmpl.slug || "",
    title: titleStr,
    description: descStr,
    pageType,
    version: tmpl.version || 1,
    initialBlocksCount,
    propertiesCount,
    createdAt: tmpl.createdAt ? new Date(tmpl.createdAt) : new Date(),
    updatedAt: tmpl.updatedAt ? new Date(tmpl.updatedAt) : new Date()
  };
});

const totalCount = formattedTemplates.length;
const typeCounts: Record<string, number> = {};
for (const t of formattedTemplates) {
  typeCounts[t.pageType] = (typeCounts[t.pageType] || 0) + 1;
}

function getTypeBadgeColor(type: string): "primary" | "secondary" | "success" | "warning" | "error" | "neutral" {
  switch (type) {
    case "blog":
      return "primary";
    case "doc":
    case "documentation":
      return "secondary";
    case "legal":
    case "policy":
      return "warning";
    case "wiki":
    case "species":
      return "success";
    case "character":
    case "hero":
      return "primary";
    case "series":
      return "secondary";
    case "item":
    case "location":
      return "warning";
    case "patchnote":
    case "announcement":
      return "error";
    default:
      return "neutral";
  }
}

function getTypeIcon(type: string): string {
  switch (type) {
    case "blog":
      return "i-lucide-newspaper";
    case "doc":
    case "documentation":
      return "i-lucide-book-open";
    case "character":
    case "hero":
      return "i-lucide-user";
    case "series":
      return "i-lucide-clapperboard";
    case "location":
      return "i-lucide-map-pin";
    case "item":
      return "i-lucide-package";
    case "species":
      return "i-lucide-dna";
    case "skill":
      return "i-lucide-sparkles";
    case "patchnote":
      return "i-lucide-file-code";
    default:
      return "i-lucide-layout-template";
  }
}

const templateColumns: TableColumn<any>[] = [
  {
    accessorKey: "title",
    header: "Template & Slug",
    cell: ({ row }) => {
      const tmpl = row.original;
      return `<div class="flex items-start gap-3 py-1">
        <div class="mt-0.5 size-8 rounded-lg bg-elevated border border-default text-muted flex items-center justify-center shrink-0">
          <span class="${getTypeIcon(tmpl.pageType)} size-4"></span>
        </div>
        <div class="min-w-0 flex-1">
          <a href="${getRelativeLocaleUrl(currentLocale, `/cms/templates/${tmpl.id}/edit`)}" class="font-semibold text-highlighted hover:text-primary transition-colors text-sm truncate block" title="${tmpl.title}">
            ${tmpl.title}
          </a>
          <div class="flex items-center gap-2 mt-1">
            <span class="font-mono text-xs text-muted bg-elevated px-1.5 py-0.5 rounded border border-default/60 truncate max-w-xs">
              ${tmpl.slug}
            </span>
          </div>
          ${tmpl.description ? `<p class="text-xs text-muted/80 mt-1 line-clamp-1 max-w-md">${tmpl.description}</p>` : ''}
        </div>
      </div>`;
    }
  },
  {
    accessorKey: "pageType",
    header: "Page Type",
    size: 140,
    cell: ({ row }) => {
      const tmpl = row.original;
      const color = getTypeBadgeColor(tmpl.pageType);
      return `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wider bg-${color}-500/10 text-${color}-500 border border-${color}-500/20">${tmpl.pageType}</span>`;
    }
  },
  {
    id: "specs",
    header: "Schema Specs",
    size: 160,
    cell: ({ row }) => {
      const tmpl = row.original;
      return `<div class="flex items-center gap-2 text-xs text-muted font-mono">
        <span>${tmpl.initialBlocksCount} ${tmpl.initialBlocksCount === 1 ? "block" : "blocks"}</span>
        <span class="opacity-40">•</span>
        <span>${tmpl.propertiesCount} ${tmpl.propertiesCount === 1 ? "prop" : "props"}</span>
      </div>`;
    }
  },
  {
    accessorKey: "version",
    header: "Version",
    size: 100,
    cell: ({ row }) => `<span class="px-2 py-0.5 rounded bg-elevated border border-default text-highlighted font-semibold text-xs font-mono">v${row.getValue("version")}</span>`
  },
  {
    id: "actions",
    header: "",
    size: 70,
    enableSorting: false,
    enableHiding: false,
    meta: {
      class: {
        th: "text-center",
        td: "text-center"
      }
    },
    cell: ({ row }) => {
      const tmpl = row.original;
      return `<div class="${dropdownClasses.root}" data-astro-actions="${tmpl.id}">
        <button type="button" class="size-8 rounded-lg border border-default bg-elevated/70 text-muted hover:text-highlighted hover:border-accented flex items-center justify-center transition-colors cursor-pointer mx-auto" data-astro-action-trigger aria-label="Actions">
          <span class="i-lucide-ellipsis-vertical size-4 pointer-events-none"></span>
        </button>
        <div class="fixed hidden z-[99999] min-w-44 rounded-md border border-default bg-elevated p-1 text-highlighted shadow-md flex flex-col gap-0.5 text-xs text-left" data-astro-action-menu>
          <a href="${getRelativeLocaleUrl(currentLocale, `/cms/pages/new?templateId=${tmpl.id}`)}" class="${dropdownClasses.item}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-plus"></span>
            <span class="${dropdownClasses.itemLabel}">Create Page</span>
          </a>
          <a href="${getRelativeLocaleUrl(currentLocale, `/cms/templates/${tmpl.id}/edit`)}" class="${dropdownClasses.item}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-pencil"></span>
            <span class="${dropdownClasses.itemLabel}">Edit Template</span>
          </a>
          <div class="h-px bg-default/60 my-1 -mx-1"></div>
          <button type="button" class="${dropdownClasses.item} text-destructive hover:bg-destructive/10" data-delete-tmpl-id="${tmpl.id}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-trash-2 text-destructive"></span>
            <span class="${dropdownClasses.itemLabel}">Delete Template</span>
          </button>
        </div>
      </div>`;
    }
  }
];
---

<CMSDashboardLayout title="Templates" description="Manage page templates, property schemas, and starter blocks" activeSection="templates">
  <Fragment slot="toolbar-right">
    <div class="flex items-center gap-2">
      <RLAButton
        href={getRelativeLocaleUrl(currentLocale, "/cms/pages")}
        variant="outline"
        color="neutral"
        size="sm"
        leadingIcon="i-lucide-files"
      >
        Pages
      </RLAButton>
      <RLAButton
        href={getRelativeLocaleUrl(currentLocale, "/cms/templates/new")}
        variant="solid"
        color="primary"
        size="sm"
        leadingIcon="i-lucide-plus"
      >
        Create Template
      </RLAButton>
    </div>
  </Fragment>

  <div class="space-y-6">
    <RLATable
      data={formattedTemplates}
      columns={templateColumns}
      bordered
      striped
      hoverable
      searchable
      showColumnsToggle
      exportable
      exportFilename="rimelight-templates-export"
    />
  </div>

  <script>
    // ─── Actions Popover interactive script ───────────────────────────────────
    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLButtonElement>("[data-astro-action-trigger]");
      const allMenus = document.querySelectorAll<HTMLElement>("[data-astro-action-menu]");

      // Handle delete button click inside menu
      const deleteBtn = target.closest<HTMLElement>("[data-delete-tmpl-id]");
      if (deleteBtn) {
        allMenus.forEach((m) => m.classList.add("hidden"));
        const templateId = deleteBtn.getAttribute("data-delete-tmpl-id") || "";
        if (!templateId) return;
        if (!confirm("Are you sure you want to delete this template? This will not delete existing pages created with this template.")) return;
        try {
          const res = await fetch(`/api/cms/templates/${templateId}`, { method: "DELETE" });
          if (res.ok) {
            window.location.reload();
          } else {
            alert("Failed to delete template");
          }
        } catch {
          alert("Network error deleting template");
        }
        return;
      }

      if (trigger) {
        e.stopPropagation();
        const wrapper = trigger.closest("[data-astro-actions]");
        const rowId = wrapper?.getAttribute("data-astro-actions") || "";
        const menu = wrapper?.querySelector<HTMLElement>("[data-astro-action-menu]")
          || document.querySelector<HTMLElement>(`[data-astro-action-menu][data-menu-for="${rowId}"]`);
        if (!menu) return;

        const isHidden = menu.classList.contains("hidden");
        allMenus.forEach((m) => m.classList.add("hidden"));

        if (isHidden) {
          menu.setAttribute("data-menu-for", rowId);
          if (menu.parentElement !== document.body) {
            document.body.appendChild(menu);
          }
          const rect = trigger.getBoundingClientRect();
          menu.style.position = "fixed";
          menu.style.zIndex = "99999";
          menu.style.top = `${rect.bottom + 4}px`;
          menu.style.right = `${window.innerWidth - rect.right}px`;
          menu.style.left = "auto";
          menu.classList.remove("hidden");
        }
      } else {
        allMenus.forEach((m) => m.classList.add("hidden"));
      }
    });

    // Close menus on scroll/resize
    window.addEventListener("scroll", () => {
      document.querySelectorAll<HTMLElement>("[data-astro-action-menu]").forEach((m) => m.classList.add("hidden"));
    }, true);
    window.addEventListener("resize", () => {
      document.querySelectorAll<HTMLElement>("[data-astro-action-menu]").forEach((m) => m.classList.add("hidden"));
    });
  </script>
</CMSDashboardLayout>
