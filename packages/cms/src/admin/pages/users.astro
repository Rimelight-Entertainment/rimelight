---
import CMSDashboardLayout from "../layouts/CMSDashboardLayout.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLATable from "@rimelight/ui/components/table/RLATable.astro";
import type { TableColumn } from "@rimelight/ui/components/table/table";
import { dropdownMenuTheme } from "@rimelight/ui/components/dropdown-menu/dropdown-menu.theme";

export const prerender = false;

const dropdownClasses = dropdownMenuTheme({ size: "xs" });

const users = [
  { id: "usr_1", name: "Idan T.", email: "idan@rimelight.com", role: "Super Admin", status: "active", lastActive: "Just now" },
  { id: "usr_2", name: "Sarah Connor", email: "sarah@rimelight.com", role: "Editor", status: "active", lastActive: "2 hours ago" },
  { id: "usr_3", name: "Alex Rivers", email: "alex@rimelight.com", role: "Author", status: "active", lastActive: "Yesterday" },
  { id: "usr_4", name: "Elena Vance", email: "elena@rimelight.com", role: "Reviewer", status: "invited", lastActive: "Never" },
];

const userColumns: TableColumn<any>[] = [
  {
    accessorKey: "name",
    header: "User",
    cell: ({ row }) => {
      const user = row.original;
      return `<div class="flex items-center gap-3 py-1">
        <div class="size-8 rounded-full bg-primary/10 text-primary font-bold text-xs flex items-center justify-center border border-primary/20 shrink-0">
          ${user.name.slice(0, 2).toUpperCase()}
        </div>
        <div class="flex flex-col min-w-0">
          <span class="font-medium text-highlighted text-sm truncate">${user.name}</span>
          <span class="text-xs text-muted font-normal truncate">${user.email}</span>
        </div>
      </div>`;
    }
  },
  {
    accessorKey: "role",
    header: "Role",
    size: 150,
    cell: ({ row }) => {
      const user = row.original;
      const roleColor = user.role === "Super Admin" ? "primary" : user.role === "Editor" ? "secondary" : "neutral";
      return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border ${
        roleColor === 'primary' ? 'bg-primary/10 text-primary border-primary/20' :
        roleColor === 'secondary' ? 'bg-secondary/10 text-secondary border-secondary/20' :
        'bg-muted/10 text-muted border-default'
      }">${user.role}</span>`;
    }
  },
  {
    accessorKey: "status",
    header: "Status",
    size: 130,
    cell: ({ row }) => {
      const user = row.original;
      if (user.status === "active") {
        return `<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
          <span class="size-1.5 rounded-full bg-emerald-500"></span>
          <span>Active</span>
        </div>`;
      }
      return `<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20">
        <span class="size-1.5 rounded-full bg-amber-500"></span>
        <span>Invited</span>
      </div>`;
    }
  },
  {
    accessorKey: "lastActive",
    header: "Last Active",
    size: 140,
    cell: ({ row }) => {
      const user = row.original;
      return `<span class="text-xs text-muted">${user.lastActive}</span>`;
    }
  },
  {
    id: "actions",
    header: "Actions",
    size: 90,
    cell: ({ row }) => {
      const user = row.original;
      return `<div class="relative flex items-center justify-end" data-astro-actions="user-${user.id}">
        <button
          type="button"
          class="size-8 rounded-lg border border-default bg-elevated/70 text-muted hover:text-highlighted hover:border-accented hover:bg-elevated flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Actions"
          data-astro-action-trigger
        >
          <span class="i-lucide-ellipsis-vertical size-4 pointer-events-none"></span>
        </button>
        <div class="fixed hidden z-[99999] min-w-44 rounded-md border border-default bg-elevated p-1 text-highlighted shadow-md flex flex-col gap-0.5 text-xs text-left" data-astro-action-menu>
          <button type="button" class="${dropdownClasses.item}" data-edit-role="${user.id}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-shield-check"></span>
            <span class="${dropdownClasses.itemLabel}">Edit Role & Permissions</span>
          </button>
          <button type="button" class="${dropdownClasses.item}" data-view-activity="${user.id}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-activity"></span>
            <span class="${dropdownClasses.itemLabel}">View Activity Log</span>
          </button>
          <div class="h-px bg-default/60 my-1 -mx-1"></div>
          <button type="button" class="${dropdownClasses.item} text-destructive hover:bg-destructive/10" data-remove-user="${user.id}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-trash-2 text-destructive"></span>
            <span class="${dropdownClasses.itemLabel}">Remove Member</span>
          </button>
        </div>
      </div>`;
    }
  }
];
---

<CMSDashboardLayout title="CMS Users" description="Manage team permissions, editor roles, and workspace access" activeSection="users">
  <Fragment slot="toolbar-right">
    <RLAButton variant="solid" color="primary" size="sm" leadingIcon="i-lucide-user-plus">
      Invite Member
    </RLAButton>
  </Fragment>

  <div class="space-y-6">
    <RLATable
      data={users}
      columns={userColumns}
      bordered
      striped
      hoverable
      searchable
      showColumnsToggle
      exportable
      exportFilename="rimelight-users-export"
    />
  </div>

  <script>
    // ─── Actions Popover interactive script ───────────────────────────────────
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLButtonElement>("[data-astro-action-trigger]");
      const allMenus = document.querySelectorAll<HTMLElement>("[data-astro-action-menu]");

      if (trigger) {
        e.stopPropagation();
        const wrapper = trigger.closest("[data-astro-actions]");
        const rowId = wrapper?.getAttribute("data-astro-actions") || "";
        const menu = wrapper?.querySelector<HTMLElement>("[data-astro-action-menu]")
          || document.querySelector<HTMLElement>(`[data-astro-action-menu][data-menu-for="${rowId}"]`);
        if (!menu) return;

        const isHidden = menu.classList.contains("hidden");
        allMenus.forEach((m) => m.classList.add("hidden"));

        if (isHidden) {
          menu.setAttribute("data-menu-for", rowId);
          if (menu.parentElement !== document.body) {
            document.body.appendChild(menu);
          }
          const rect = trigger.getBoundingClientRect();
          menu.style.position = "fixed";
          menu.style.zIndex = "99999";
          menu.style.top = `${rect.bottom + 4}px`;
          menu.style.right = `${window.innerWidth - rect.right}px`;
          menu.style.left = "auto";
          menu.classList.remove("hidden");
        }
      } else {
        allMenus.forEach((m) => m.classList.add("hidden"));
      }
    });

    // Close menus on scroll/resize
    window.addEventListener("scroll", () => {
      document.querySelectorAll<HTMLElement>("[data-astro-action-menu]").forEach((m) => m.classList.add("hidden"));
    }, true);
    window.addEventListener("resize", () => {
      document.querySelectorAll<HTMLElement>("[data-astro-action-menu]").forEach((m) => m.classList.add("hidden"));
    });
  </script>
</CMSDashboardLayout>
