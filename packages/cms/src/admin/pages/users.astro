---
import CMSDashboardLayout from "../layouts/CMSDashboardLayout.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLABadge from "@rimelight/ui/components/badge/RLABadge.astro";
import RLAAvatar from "@rimelight/ui/components/avatar/RLAAvatar.astro";
import RLAIcon from "@rimelight/ui/components/icon/RLAIcon.astro";
import RLADropdownMenu from "@rimelight/ui/components/dropdown-menu/RLADropdownMenu.astro";

export const prerender = false;

const users = [
  { id: "usr_1", name: "Idan T.", email: "idan@rimelight.com", role: "Super Admin", status: "active", lastActive: "Just now" },
  { id: "usr_2", name: "Sarah Connor", email: "sarah@rimelight.com", role: "Editor", status: "active", lastActive: "2 hours ago" },
  { id: "usr_3", name: "Alex Rivers", email: "alex@rimelight.com", role: "Author", status: "active", lastActive: "Yesterday" },
  { id: "usr_4", name: "Elena Vance", email: "elena@rimelight.com", role: "Reviewer", status: "invited", lastActive: "Never" },
];
---

<CMSDashboardLayout title="CMS Users" description="Manage team permissions, editor roles, and workspace access" activeSection="users">
  <Fragment slot="toolbar-right">
    <RLAButton variant="solid" color="primary" size="sm" leadingIcon="i-lucide-user-plus">
      Invite Member
    </RLAButton>
  </Fragment>

  <div class="space-y-6">
    <div class="bg-elevated/40 border border-default rounded-xl shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead class="bg-elevated/80 border-b border-default text-xs font-semibold text-muted uppercase tracking-wider">
            <tr>
              <th scope="col" class="px-5 py-3.5">User</th>
              <th scope="col" class="px-4 py-3.5">Role</th>
              <th scope="col" class="px-4 py-3.5">Status</th>
              <th scope="col" class="px-4 py-3.5">Last Active</th>
              <th scope="col" class="px-5 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-default/50">
            {users.map((user) => {
              const actionItems = [
                [
                  {
                    label: "Edit Role & Permissions",
                    icon: "i-lucide-shield-check",
                    id: `edit-role-${user.id}`
                  },
                  {
                    label: "View Activity Log",
                    icon: "i-lucide-activity",
                    id: `activity-${user.id}`
                  }
                ],
                [
                  {
                    label: "Remove Member",
                    icon: "i-lucide-trash-2",
                    id: `remove-${user.id}`,
                    color: "error" as const,
                    class: "remove-user-item"
                  }
                ]
              ];

              return (
                <tr class="hover:bg-elevated/60 transition group">
                  <td class="px-5 py-4">
                    <div class="flex items-center gap-3">
                      <RLAAvatar name={user.name} size="sm" />
                      <div class="flex flex-col">
                        <span class="font-medium text-highlighted text-sm">{user.name}</span>
                        <span class="text-xs text-muted font-normal">{user.email}</span>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    <RLABadge variant="soft" color={user.role === "Super Admin" ? "primary" : user.role === "Editor" ? "secondary" : "neutral"} size="sm">
                      {user.role}
                    </RLABadge>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap">
                    {user.status === "active" ? (
                      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span>Active</span>
                      </div>
                    ) : (
                      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        <span>Invited</span>
                      </div>
                    )}
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-xs text-muted">
                    {user.lastActive}
                  </td>
                  <td class="px-5 py-4 whitespace-nowrap text-right">
                    <div class="flex items-center justify-end">
                      <RLADropdownMenu
                        items={actionItems as any}
                        content={{ align: "end", side: "bottom" }}
                        size="xs"
                        color="neutral"
                      >
                        <button
                          slot="trigger"
                          type="button"
                          class="size-8 rounded-lg border border-default bg-elevated/70 text-muted hover:text-highlighted hover:border-accented hover:bg-elevated flex items-center justify-center transition-colors cursor-pointer"
                          aria-label="Actions"
                        >
                          <RLAIcon name="i-lucide-ellipsis-vertical" class="size-4 pointer-events-none" />
                        </button>
                      </RLADropdownMenu>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</CMSDashboardLayout>
