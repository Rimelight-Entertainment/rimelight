---
import CMSDashboardLayout from "../layouts/CMSDashboardLayout.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLABadge from "@rimelight/ui/components/badge/RLABadge.astro";
import RLAIcon from "@rimelight/ui/components/icon/RLAIcon.astro";
import RLAInput from "@rimelight/ui/components/input/RLAInput.astro";
import RLADropdownMenu from "@rimelight/ui/components/dropdown-menu/RLADropdownMenu.astro";
import { db } from "virtual:rimelight-cms/db";
import { pages } from "../../schema/pages.ts";
import { pageTemplates } from "../../schema/page_templates.ts";
import { desc, isNull } from "drizzle-orm";
import { getRelativeLocaleUrl } from "@rimelight/i18n";

export const prerender = false;

const currentLocale = Astro.currentLocale ?? "en";

let rawPages: any[] = [];
let templatesCount = 0;

if (db) {
  try {
    rawPages = await db
      .select()
      .from(pages)
      .where(isNull(pages.deletedAt))
      .orderBy(desc(pages.updatedAt), desc(pages.createdAt));
  } catch (err) {
    console.warn("Failed to fetch pages:", err);
  }

  try {
    const tmpls = await db.select({ id: pageTemplates.id }).from(pageTemplates);
    templatesCount = tmpls.length;
  } catch {
    // optional templates count
  }
}

// Format page data with resilient localized string parsing
const pagesList = rawPages.map((page) => {
  let titleStr = "";
  if (typeof page.title === "object" && page.title !== null) {
    titleStr = (page.title as Record<string, string>)[currentLocale] || (page.title as Record<string, string>)["en"] || Object.values(page.title)[0] || "";
  } else {
    titleStr = String(page.title || "Untitled");
  }

  let descStr = "";
  if (typeof page.description === "object" && page.description !== null) {
    descStr = (page.description as Record<string, string>)[currentLocale] || (page.description as Record<string, string>)["en"] || "";
  } else if (page.description) {
    descStr = String(page.description);
  }

  const isPublished = Boolean(page.publishedVersionId);
  const type = String(page.type || "page").toLowerCase();
  
  return {
    id: page.id,
    slug: page.slug || "",
    title: titleStr,
    description: descStr,
    type,
    status: isPublished ? "published" : "draft",
    isPublished,
    publishedVersionId: page.publishedVersionId,
    postedAt: page.postedAt ? new Date(page.postedAt) : null,
    createdAt: page.createdAt ? new Date(page.createdAt) : new Date(),
    updatedAt: page.updatedAt ? new Date(page.updatedAt) : (page.createdAt ? new Date(page.createdAt) : new Date())
  };
});

const totalCount = pagesList.length;
const publishedCount = pagesList.filter((p) => p.isPublished).length;
const draftCount = totalCount - publishedCount;

// Calculate unique types and their counts
const typeCounts: Record<string, number> = {};
for (const p of pagesList) {
  typeCounts[p.type] = (typeCounts[p.type] || 0) + 1;
}
const availableTypes = Object.keys(typeCounts).sort();

function formatDate(date: Date): string {
  try {
    return new Intl.DateTimeFormat("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    }).format(date);
  } catch {
    return date.toISOString().slice(0, 10);
  }
}

function timeAgo(date: Date): string {
  const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
  if (seconds < 60) return "Just now";
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d ago`;
  return formatDate(date);
}

function getTypeBadgeColor(type: string): "primary" | "secondary" | "success" | "warning" | "error" | "neutral" {
  switch (type) {
    case "blog":
      return "primary";
    case "doc":
    case "documentation":
      return "secondary";
    case "legal":
    case "policy":
      return "warning";
    case "wiki":
      return "success";
    case "announcement":
      return "error";
    default:
      return "neutral";
  }
}

function getTypeIcon(type: string): string {
  switch (type) {
    case "blog":
      return "i-lucide-newspaper";
    case "doc":
    case "documentation":
      return "i-lucide-book-open";
    case "legal":
    case "policy":
      return "i-lucide-shield-alert";
    case "wiki":
      return "i-lucide-library";
    case "announcement":
      return "i-lucide-megaphone";
    default:
      return "i-lucide-file-text";
  }
}
---

<CMSDashboardLayout title="Pages" description="Manage, edit, and publish dynamic site content" activeSection="pages">
  <Fragment slot="toolbar-right">
    <div class="flex items-center gap-2">
      <RLAButton
        href={getRelativeLocaleUrl(currentLocale, "/cms/templates")}
        variant="outline"
        color="neutral"
        size="sm"
        leadingIcon="i-lucide-layout-template"
      >
        Templates
      </RLAButton>
      <RLAButton
        href={getRelativeLocaleUrl(currentLocale, "/cms/pages/new")}
        variant="solid"
        color="primary"
        size="sm"
        leadingIcon="i-lucide-plus"
      >
        Create Page
      </RLAButton>
    </div>
  </Fragment>

  <div class="space-y-6">
    <!-- Top KPI / Overview Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="bg-elevated/40 border border-default p-4 rounded-xl shadow-xs transition hover:border-accented flex items-center gap-3">
        <div class="size-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
          <RLAIcon name="i-lucide-files" class="size-5" />
        </div>
        <div>
          <div class="text-2xl font-bold text-highlighted leading-tight">{totalCount}</div>
          <div class="text-xs text-muted font-medium">Total Pages</div>
        </div>
      </div>

      <div class="bg-elevated/40 border border-default p-4 rounded-xl shadow-xs transition hover:border-accented flex items-center gap-3">
        <div class="size-10 rounded-lg bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
          <RLAIcon name="i-lucide-check-circle-2" class="size-5" />
        </div>
        <div>
          <div class="text-2xl font-bold text-highlighted leading-tight">{publishedCount}</div>
          <div class="text-xs text-muted font-medium">Published Live</div>
        </div>
      </div>

      <div class="bg-elevated/40 border border-default p-4 rounded-xl shadow-xs transition hover:border-accented flex items-center gap-3">
        <div class="size-10 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
          <RLAIcon name="i-lucide-file-clock" class="size-5" />
        </div>
        <div>
          <div class="text-2xl font-bold text-highlighted leading-tight">{draftCount}</div>
          <div class="text-xs text-muted font-medium">Drafts / In Progress</div>
        </div>
      </div>

      <div class="bg-elevated/40 border border-default p-4 rounded-xl shadow-xs transition hover:border-accented flex items-center gap-3">
        <div class="size-10 rounded-lg bg-indigo-500/10 text-indigo-500 flex items-center justify-center shrink-0">
          <RLAIcon name="i-lucide-layout-grid" class="size-5" />
        </div>
        <div>
          <div class="text-2xl font-bold text-highlighted leading-tight">{availableTypes.length}</div>
          <div class="text-xs text-muted font-medium">Content Types</div>
        </div>
      </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="bg-elevated/30 border border-default rounded-xl p-4 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 max-w-md">
        <RLAInput
          id="pages-search-input"
          type="search"
          placeholder="Search by title, slug, or content type..."
          leadingIcon="i-lucide-search"
          size="sm"
          class="w-full"
        />
      </div>

      <!-- Type & Status Filter Buttons -->
      <div class="flex items-center flex-wrap gap-2">
        <!-- Status Tabs -->
        <div class="inline-flex bg-elevated border border-default rounded-lg p-0.5 text-xs font-medium" role="tablist" id="status-filter-tabs">
          <button
            type="button"
            class="filter-status-btn px-3 py-1 rounded-md text-highlighted bg-elevated/80 shadow-xs transition cursor-pointer"
            data-status="all"
          >
            All ({totalCount})
          </button>
          <button
            type="button"
            class="filter-status-btn px-3 py-1 rounded-md text-muted hover:text-highlighted transition cursor-pointer"
            data-status="published"
          >
            Published ({publishedCount})
          </button>
          <button
            type="button"
            class="filter-status-btn px-3 py-1 rounded-md text-muted hover:text-highlighted transition cursor-pointer"
            data-status="draft"
          >
            Drafts ({draftCount})
          </button>
        </div>

        <!-- Type Filter Select -->
        {availableTypes.length > 0 && (
          <select
            id="type-filter-select"
            class="bg-elevated border border-default text-highlighted text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer"
          >
            <option value="all">All Types</option>
            {availableTypes.map((t) => (
              <option value={t}>{t.charAt(0).toUpperCase() + t.slice(1)} ({typeCounts[t]})</option>
            ))}
          </select>
        )}
      </div>
    </div>

    <!-- Main Table Container -->
    <div class="bg-elevated/40 border border-default rounded-xl shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse" id="pages-table">
          <thead class="bg-elevated/80 border-b border-default text-xs font-semibold text-muted uppercase tracking-wider">
            <tr>
              <th scope="col" class="px-5 py-3.5 w-5/12">Page & Slug</th>
              <th scope="col" class="px-4 py-3.5 w-2/12">Type</th>
              <th scope="col" class="px-4 py-3.5 w-2/12">Status</th>
              <th scope="col" class="px-4 py-3.5 w-2/12">Last Updated</th>
              <th scope="col" class="px-5 py-3.5 w-1/12 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-default/50" id="pages-table-body">
            {pagesList.map((page) => {
              const actionItems = [
                [
                  {
                    label: "Edit Page",
                    icon: "i-lucide-pencil",
                    to: getRelativeLocaleUrl(currentLocale, `/cms/pages/${page.id}/edit`)
                  },
                  {
                    label: "Live Preview",
                    icon: "i-lucide-eye",
                    to: getRelativeLocaleUrl(currentLocale, `/cms/pages/${page.id}/preview`)
                  },
                  {
                    label: "Version History & Diffs",
                    icon: "i-lucide-git-compare",
                    to: getRelativeLocaleUrl(currentLocale, `/cms/pages/${page.id}/review`)
                  },
                  ...(page.isPublished ? [{
                    label: "View on Live Site",
                    icon: "i-lucide-external-link",
                    to: `/${currentLocale}/${page.slug}`,
                    target: "_blank"
                  }] : [])
                ],
                [
                  ...(page.isPublished ? [{
                    label: "Unpublish to Draft",
                    icon: "i-lucide-archive",
                    id: `unpublish-${page.id}`,
                    class: "unpublish-page-item text-amber-500 hover:bg-amber-500/10"
                  }] : []),
                  {
                    label: "Delete Page",
                    icon: "i-lucide-trash-2",
                    id: `delete-${page.id}`,
                    color: "error" as const,
                    class: "delete-page-item"
                  }
                ]
              ];

              return (
                <tr
                  class="hover:bg-elevated/60 transition group page-row"
                  data-page-id={page.id}
                  data-title={page.title.toLowerCase()}
                  data-slug={page.slug.toLowerCase()}
                  data-type={page.type}
                  data-status={page.status}
                  data-description={page.description.toLowerCase()}
                >
                  <!-- Page & Slug Column -->
                  <td class="px-5 py-4">
                    <div class="flex items-start gap-3">
                      <div class="mt-0.5 size-8 rounded-lg bg-elevated border border-default text-muted flex items-center justify-center shrink-0 group-hover:border-primary/40 group-hover:text-primary transition-colors">
                        <RLAIcon name={getTypeIcon(page.type)} class="size-4" />
                      </div>
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                          <a
                            href={getRelativeLocaleUrl(currentLocale, `/cms/pages/${page.id}/edit`)}
                            class="font-semibold text-highlighted hover:text-primary transition-colors text-sm truncate"
                            title={page.title}
                          >
                            {page.title}
                          </a>
                        </div>
                        
                        <div class="flex items-center gap-2 mt-1">
                          <span class="font-mono text-xs text-muted bg-elevated px-1.5 py-0.5 rounded border border-default/60 truncate max-w-xs">
                            /{page.slug}
                          </span>
                          
                          <!-- Copy Slug Button -->
                          <button
                            type="button"
                            class="copy-slug-btn text-muted hover:text-highlighted p-0.5 rounded transition cursor-pointer"
                            data-slug={page.slug}
                            title="Copy Slug"
                          >
                            <RLAIcon name="i-lucide-copy" class="size-3.5 copy-icon" />
                            <RLAIcon name="i-lucide-check" class="size-3.5 check-icon text-emerald-500 hidden" />
                          </button>

                          {page.isPublished && (
                            <a
                              href={`/${currentLocale}/${page.slug}`}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-muted hover:text-primary p-0.5 rounded transition cursor-pointer"
                              title="View published page on site"
                            >
                              <RLAIcon name="i-lucide-external-link" class="size-3.5" />
                            </a>
                          )}
                        </div>

                        {page.description && (
                          <p class="text-xs text-muted/80 mt-1 line-clamp-1 max-w-md">
                            {page.description}
                          </p>
                        )}
                      </div>
                    </div>
                  </td>

                  <!-- Type Column -->
                  <td class="px-4 py-4 whitespace-nowrap">
                    <RLABadge variant="soft" color={getTypeBadgeColor(page.type)} size="sm">
                      {page.type.toUpperCase()}
                    </RLABadge>
                  </td>

                  <!-- Status Column -->
                  <td class="px-4 py-4 whitespace-nowrap">
                    {page.isPublished ? (
                      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                        <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>Published</span>
                      </div>
                    ) : (
                      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        <span>Draft</span>
                      </div>
                    )}
                  </td>

                  <!-- Updated Column -->
                  <td class="px-4 py-4 whitespace-nowrap">
                    <div class="text-xs font-medium text-highlighted" title={formatDate(page.updatedAt)}>
                      {timeAgo(page.updatedAt)}
                    </div>
                    <div class="text-[11px] text-muted font-mono mt-0.5">
                      {page.updatedAt.toISOString().slice(0, 10)}
                    </div>
                  </td>

                  <!-- Actions Column: Vertical ... Popover Dropdown Menu -->
                  <td class="px-5 py-4 whitespace-nowrap text-right">
                    <div class="flex items-center justify-end">
                      <RLADropdownMenu
                        items={actionItems as any}
                        content={{ align: "end", side: "bottom" }}
                        size="xs"
                        color="neutral"
                      >
                        <button
                          slot="trigger"
                          type="button"
                          class="size-8 rounded-lg border border-default bg-elevated/70 text-muted hover:text-highlighted hover:border-accented hover:bg-elevated flex items-center justify-center transition-colors cursor-pointer"
                          aria-label="Actions"
                        >
                          <RLAIcon name="i-lucide-ellipsis-vertical" class="size-4 pointer-events-none" />
                        </button>
                      </RLADropdownMenu>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- No Results / Filter Empty State -->
      <div id="no-search-results" class="hidden py-16 px-4 text-center">
        <div class="size-12 rounded-full bg-elevated border border-default mx-auto flex items-center justify-center text-muted mb-3">
          <RLAIcon name="i-lucide-search-x" class="size-6" />
        </div>
        <h3 class="text-base font-semibold text-highlighted">No matching pages found</h3>
        <p class="text-xs text-muted max-w-sm mx-auto mt-1">
          Try adjusting your search keywords or clearing type/status filters.
        </p>
        <button
          type="button"
          id="clear-filters-btn"
          class="mt-4 px-3.5 py-1.5 text-xs font-medium text-primary bg-primary/10 border border-primary/20 rounded-md hover:bg-primary/20 transition cursor-pointer"
        >
          Reset Filters
        </button>
      </div>

      <!-- Overall Empty State (when zero pages exist in DB) -->
      {totalCount === 0 && (
        <div class="py-20 px-4 text-center">
          <div class="size-16 rounded-2xl bg-primary/10 border border-primary/20 mx-auto flex items-center justify-center text-primary mb-4 shadow-sm">
            <RLAIcon name="i-lucide-file-plus" class="size-8" />
          </div>
          <h3 class="text-lg font-bold text-highlighted">No pages created yet</h3>
          <p class="text-sm text-muted max-w-md mx-auto mt-1.5">
            Get started by creating your first landing page, blog post, or documentation article.
          </p>
          <div class="mt-6 flex items-center justify-center gap-3">
            <RLAButton
              href={getRelativeLocaleUrl(currentLocale, "/cms/pages/new")}
              variant="solid"
              color="primary"
              size="md"
              leadingIcon="i-lucide-plus"
            >
              Create First Page
            </RLAButton>
            <RLAButton
              href={getRelativeLocaleUrl(currentLocale, "/cms/templates")}
              variant="outline"
              color="neutral"
              size="md"
              leadingIcon="i-lucide-layout-template"
            >
              Browse Templates
            </RLAButton>
          </div>
        </div>
      )}
    </div>
  </div>

  <script>
    // ─── Filter and Search State ───────────────────────────────────────────────
    let currentSearch = "";
    let currentStatusFilter = "all";
    let currentTypeFilter = "all";

    const searchInput = document.getElementById("pages-search-input") as HTMLInputElement | null;
    const typeSelect = document.getElementById("type-filter-select") as HTMLSelectElement | null;
    const statusTabs = document.querySelectorAll(".filter-status-btn");
    const tableRows = document.querySelectorAll<HTMLTableRowElement>(".page-row");
    const noResults = document.getElementById("no-search-results");
    const clearFiltersBtn = document.getElementById("clear-filters-btn");

    function applyFilters() {
      let visibleCount = 0;

      tableRows.forEach((row) => {
        const title = row.dataset["title"] || "";
        const slug = row.dataset["slug"] || "";
        const desc = row.dataset["description"] || "";
        const type = row.dataset["type"] || "";
        const status = row.dataset["status"] || "";

        const matchesSearch =
          !currentSearch ||
          title.includes(currentSearch) ||
          slug.includes(currentSearch) ||
          desc.includes(currentSearch) ||
          type.includes(currentSearch);

        const matchesStatus =
          currentStatusFilter === "all" || status === currentStatusFilter;

        const matchesType =
          currentTypeFilter === "all" || type === currentTypeFilter;

        if (matchesSearch && matchesStatus && matchesType) {
          row.style.display = "";
          visibleCount++;
        } else {
          row.style.display = "none";
        }
      });

      if (noResults) {
        if (visibleCount === 0 && tableRows.length > 0) {
          noResults.classList.remove("hidden");
        } else {
          noResults.classList.add("hidden");
        }
      }
    }

    searchInput?.addEventListener("input", () => {
      currentSearch = searchInput.value.toLowerCase().trim();
      applyFilters();
    });

    typeSelect?.addEventListener("change", () => {
      currentTypeFilter = typeSelect.value;
      applyFilters();
    });

    statusTabs.forEach((btn) => {
      btn.addEventListener("click", () => {
        statusTabs.forEach((b) => {
          b.classList.remove("text-highlighted", "bg-elevated/80", "shadow-xs");
          b.classList.add("text-muted");
        });
        btn.classList.remove("text-muted");
        btn.classList.add("text-highlighted", "bg-elevated/80", "shadow-xs");

        currentStatusFilter = (btn as HTMLElement).dataset["status"] || "all";
        applyFilters();
      });
    });

    clearFiltersBtn?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      currentSearch = "";
      currentTypeFilter = "all";
      if (typeSelect) typeSelect.value = "all";
      currentStatusFilter = "all";
      statusTabs.forEach((b, idx) => {
        if (idx === 0) {
          b.classList.add("text-highlighted", "bg-elevated/80", "shadow-xs");
          b.classList.remove("text-muted");
        } else {
          b.classList.remove("text-highlighted", "bg-elevated/80", "shadow-xs");
          b.classList.add("text-muted");
        }
      });
      applyFilters();
    });

    // ─── Copy Slug to Clipboard ───────────────────────────────────────────────
    document.querySelectorAll(".copy-slug-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const slug = (btn as HTMLElement).dataset["slug"];
        if (!slug) return;

        try {
          await navigator.clipboard.writeText(slug);
          const copyIcon = btn.querySelector(".copy-icon");
          const checkIcon = btn.querySelector(".check-icon");
          if (copyIcon && checkIcon) {
            copyIcon.classList.add("hidden");
            checkIcon.classList.remove("hidden");
            setTimeout(() => {
              copyIcon.classList.remove("hidden");
              checkIcon.classList.add("hidden");
            }, 2000);
          }
        } catch {
          // fallback
        }
      });
    });

    // ─── Global Click Handler for Dropdown Items (Unpublish & Delete) ─────────
    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;

      // Handle Unpublish
      const unpublishItem = target.closest<HTMLElement>(".unpublish-page-item");
      if (unpublishItem) {
        const rawId = unpublishItem.getAttribute("data-item-id") || "";
        const pageId = rawId.replace("unpublish-", "");
        if (!pageId) return;

        if (!confirm("Are you sure you want to unpublish this page? It will no longer be visible on the public site.")) {
          return;
        }

        try {
          const res = await fetch(`/api/cms/pages/${pageId}/unpublish`, {
            method: "POST"
          });
          if (res.ok) {
            window.location.reload();
          } else {
            const err = await res.json().catch(() => ({}));
            alert(err.error || "Failed to unpublish page");
          }
        } catch {
          alert("Network error unpublishing page");
        }
        return;
      }

      // Handle Delete
      const deleteItem = target.closest<HTMLElement>(".delete-page-item");
      if (deleteItem) {
        const rawId = deleteItem.getAttribute("data-item-id") || "";
        const pageId = rawId.replace("delete-", "");
        if (!pageId) return;

        if (!confirm("Are you sure you want to delete this page? This action cannot be undone.")) {
          return;
        }

        try {
          const res = await fetch(`/api/cms/pages/${pageId}`, {
            method: "DELETE"
          });
          if (res.ok) {
            window.location.reload();
          } else {
            const err = await res.json().catch(() => ({}));
            alert(err.error || "Failed to delete page");
          }
        } catch {
          alert("Network error deleting page");
        }
        return;
      }
    });
  </script>
</CMSDashboardLayout>
