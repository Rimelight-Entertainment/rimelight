---
import CMSDashboardLayout from "../layouts/CMSDashboardLayout.astro";
import RLAButton from "@rimelight/ui/components/button/RLAButton.astro";
import RLATable from "@rimelight/ui/components/table/RLATable.astro";
import type { TableColumn } from "@rimelight/ui/components/table/table";
import { dropdownMenuTheme } from "@rimelight/ui/components/dropdown-menu/dropdown-menu.theme";
import { db } from "virtual:rimelight-cms/db";
import { pages } from "../../schema/pages.ts";
import { desc, isNull } from "drizzle-orm";
import { getRelativeLocaleUrl } from "@rimelight/i18n";

export const prerender = false;

const currentLocale = Astro.currentLocale ?? "en";
const dropdownClasses = dropdownMenuTheme({ size: "xs" });

let rawPages: any[] = [];

if (db) {
  try {
    rawPages = await db
      .select()
      .from(pages)
      .where(isNull(pages.deletedAt))
      .orderBy(desc(pages.updatedAt), desc(pages.createdAt));
  } catch (err) {
    console.warn("Failed to fetch pages:", err);
  }
}

// Format page data with resilient localized string parsing
const pagesList = rawPages.map((page) => {
  let titleStr = "";
  if (typeof page.title === "object" && page.title !== null) {
    titleStr = (page.title as Record<string, string>)[currentLocale] || (page.title as Record<string, string>)["en"] || Object.values(page.title)[0] || "";
  } else {
    titleStr = String(page.title || "Untitled");
  }

  let descStr = "";
  if (typeof page.description === "object" && page.description !== null) {
    descStr = (page.description as Record<string, string>)[currentLocale] || (page.description as Record<string, string>)["en"] || "";
  } else if (page.description) {
    descStr = String(page.description);
  }

  const isPublished = Boolean(page.publishedVersionId);
  const type = String(page.type || "page").toLowerCase();
  
  return {
    id: page.id,
    slug: page.slug || "",
    title: titleStr,
    description: descStr,
    type,
    status: isPublished ? "published" : "draft",
    isPublished,
    publishedVersionId: page.publishedVersionId,
    postedAt: page.postedAt ? new Date(page.postedAt) : null,
    createdAt: page.createdAt ? new Date(page.createdAt) : new Date(),
    updatedAt: page.updatedAt ? new Date(page.updatedAt) : (page.createdAt ? new Date(page.createdAt) : new Date())
  };
});

function formatDate(date: Date): string {
  try {
    return new Intl.DateTimeFormat("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    }).format(date);
  } catch {
    return date.toISOString().slice(0, 10);
  }
}

function timeAgo(date: Date): string {
  const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
  if (seconds < 60) return "Just now";
  const minutes = Math.floor(seconds / 60);
  if (minutes < 60) return `${minutes}m ago`;
  const hours = Math.floor(minutes / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d ago`;
  return formatDate(date);
}

function getTypeBadgeColor(type: string): "primary" | "secondary" | "success" | "warning" | "error" | "neutral" {
  switch (type) {
    case "blog":
      return "primary";
    case "doc":
    case "documentation":
      return "secondary";
    case "legal":
    case "policy":
      return "warning";
    case "wiki":
      return "success";
    case "announcement":
      return "error";
    default:
      return "neutral";
  }
}

function getTypeIcon(type: string): string {
  switch (type) {
    case "blog":
      return "i-lucide-newspaper";
    case "doc":
    case "documentation":
      return "i-lucide-book-open";
    case "legal":
    case "policy":
      return "i-lucide-shield-alert";
    case "wiki":
      return "i-lucide-library";
    case "announcement":
      return "i-lucide-megaphone";
    default:
      return "i-lucide-file-text";
  }
}

const pageColumns: TableColumn<any>[] = [
  {
    accessorKey: "title",
    header: "Page & Slug",
    cell: ({ row }) => {
      const page = row.original;
      return `<div class="flex items-start gap-3 py-1">
        <div class="mt-0.5 size-8 rounded-lg bg-elevated border border-default text-muted flex items-center justify-center shrink-0">
          <span class="${getTypeIcon(page.type)} size-4"></span>
        </div>
        <div class="min-w-0 flex-1">
          <a href="${getRelativeLocaleUrl(currentLocale, `/cms/pages/${page.id}/edit`)}" class="font-semibold text-highlighted hover:text-primary transition-colors text-sm truncate block" title="${page.title}">
            ${page.title}
          </a>
          <div class="flex items-center gap-2 mt-1">
            <span class="font-mono text-xs text-muted bg-elevated px-1.5 py-0.5 rounded border border-default/60 truncate max-w-xs">
              /${page.slug}
            </span>
            ${page.isPublished ? `<a href="/${currentLocale}/${page.slug}" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-primary p-0.5 rounded transition cursor-pointer" title="View on site"><span class="i-lucide-external-link size-3.5 inline-block"></span></a>` : ''}
          </div>
          ${page.description ? `<p class="text-xs text-muted/80 mt-1 line-clamp-1 max-w-md">${page.description}</p>` : ''}
        </div>
      </div>`;
    }
  },
  {
    accessorKey: "type",
    header: "Type",
    size: 130,
    cell: ({ row }) => {
      const page = row.original;
      const color = getTypeBadgeColor(page.type);
      return `<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wider bg-${color}-500/10 text-${color}-500 border border-${color}-500/20">${page.type}</span>`;
    }
  },
  {
    accessorKey: "status",
    header: "Status",
    size: 130,
    cell: ({ row }) => {
      const page = row.original;
      return page.isPublished
        ? `<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-500 border border-emerald-500/20"><span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span><span>Published</span></div>`
        : `<div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-amber-500/10 text-amber-500 border border-amber-500/20"><span class="size-1.5 rounded-full bg-amber-500"></span><span>Draft</span></div>`;
    }
  },
  {
    accessorKey: "updatedAt",
    header: "Last Updated",
    size: 160,
    cell: ({ row }) => {
      const page = row.original;
      return `<div class="text-xs font-medium text-highlighted" title="${formatDate(page.updatedAt)}">${timeAgo(page.updatedAt)}</div><div class="text-[11px] text-muted font-mono mt-0.5">${page.updatedAt.toISOString().slice(0, 10)}</div>`;
    }
  },
  {
    id: "actions",
    header: "",
    size: 70,
    enableSorting: false,
    enableHiding: false,
    meta: {
      class: {
        th: "text-center",
        td: "text-center"
      }
    },
    cell: ({ row }) => {
      const page = row.original;
      return `<div class="${dropdownClasses.root}" data-astro-actions="${page.id}">
        <button type="button" class="size-8 rounded-lg border border-default bg-elevated/70 text-muted hover:text-highlighted hover:border-accented flex items-center justify-center transition-colors cursor-pointer mx-auto" data-astro-action-trigger aria-label="Actions">
          <span class="i-lucide-ellipsis-vertical size-4 pointer-events-none"></span>
        </button>
        <div class="fixed hidden z-[99999] min-w-44 rounded-md border border-default bg-elevated p-1 text-highlighted shadow-md flex flex-col gap-0.5 text-xs text-left" data-astro-action-menu>
          <a href="${getRelativeLocaleUrl(currentLocale, `/cms/pages/${page.id}/edit`)}" class="${dropdownClasses.item}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-pencil"></span>
            <span class="${dropdownClasses.itemLabel}">Edit Page</span>
          </a>
          <a href="${getRelativeLocaleUrl(currentLocale, `/cms/pages/${page.id}/preview`)}" class="${dropdownClasses.item}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-eye"></span>
            <span class="${dropdownClasses.itemLabel}">Live Preview</span>
          </a>
          <a href="${getRelativeLocaleUrl(currentLocale, `/cms/pages/${page.id}/review`)}" class="${dropdownClasses.item}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-git-compare"></span>
            <span class="${dropdownClasses.itemLabel}">Version History</span>
          </a>
          ${page.isPublished ? `
            <a href="/${currentLocale}/${page.slug}" target="_blank" rel="noopener noreferrer" class="${dropdownClasses.item}">
              <span class="${dropdownClasses.itemLeadingIcon} i-lucide-external-link"></span>
              <span class="${dropdownClasses.itemLabel}">View on Live Site</span>
            </a>
          ` : ''}
          <div class="h-px bg-default/60 my-1 -mx-1"></div>
          ${page.isPublished ? `
            <button type="button" class="${dropdownClasses.item} text-amber-500 hover:bg-amber-500/10" data-unpublish-page-id="${page.id}">
              <span class="${dropdownClasses.itemLeadingIcon} i-lucide-archive text-amber-500"></span>
              <span class="${dropdownClasses.itemLabel}">Unpublish to Draft</span>
            </button>
          ` : ''}
          <button type="button" class="${dropdownClasses.item} text-destructive hover:bg-destructive/10" data-delete-page-id="${page.id}">
            <span class="${dropdownClasses.itemLeadingIcon} i-lucide-trash-2 text-destructive"></span>
            <span class="${dropdownClasses.itemLabel}">Delete Page</span>
          </button>
        </div>
      </div>`;
    }
  }
];
---

<CMSDashboardLayout title="Pages" description="Manage, edit, and publish dynamic site content" activeSection="pages">
  <Fragment slot="toolbar-right">
    <div class="flex items-center gap-2">
      <RLAButton
        href={getRelativeLocaleUrl(currentLocale, "/cms/templates")}
        variant="outline"
        color="neutral"
        size="sm"
        leadingIcon="i-lucide-layout-template"
      >
        Templates
      </RLAButton>
      <RLAButton
        href={getRelativeLocaleUrl(currentLocale, "/cms/pages/new")}
        variant="solid"
        color="primary"
        size="sm"
        leadingIcon="i-lucide-plus"
      >
        Create Page
      </RLAButton>
    </div>
  </Fragment>

  <div class="space-y-6">
    <RLATable
      data={pagesList}
      columns={pageColumns}
      bordered
      striped
      hoverable
      searchable
      showColumnsToggle
      exportable
      exportFilename="rimelight-pages-export"
    />
  </div>

  <script>
    // ─── Actions Popover interactive script ───────────────────────────────────
    document.addEventListener("click", async (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLButtonElement>("[data-astro-action-trigger]");
      const allMenus = document.querySelectorAll<HTMLElement>("[data-astro-action-menu]");

      // Handle unpublish
      const unpublishBtn = target.closest<HTMLElement>("[data-unpublish-page-id]");
      if (unpublishBtn) {
        allMenus.forEach((m) => m.classList.add("hidden"));
        const pageId = unpublishBtn.getAttribute("data-unpublish-page-id") || "";
        if (!pageId) return;
        if (!confirm("Are you sure you want to unpublish this page?")) return;
        try {
          const res = await fetch(`/api/cms/pages/${pageId}/unpublish`, { method: "POST" });
          if (res.ok) window.location.reload();
          else alert("Failed to unpublish page");
        } catch {
          alert("Network error unpublishing page");
        }
        return;
      }

      // Handle delete
      const deleteBtn = target.closest<HTMLElement>("[data-delete-page-id]");
      if (deleteBtn) {
        allMenus.forEach((m) => m.classList.add("hidden"));
        const pageId = deleteBtn.getAttribute("data-delete-page-id") || "";
        if (!pageId) return;
        if (!confirm("Are you sure you want to delete this page? This action cannot be undone.")) return;
        try {
          const res = await fetch(`/api/cms/pages/${pageId}`, { method: "DELETE" });
          if (res.ok) window.location.reload();
          else alert("Failed to delete page");
        } catch {
          alert("Network error deleting page");
        }
        return;
      }

      if (trigger) {
        e.stopPropagation();
        const wrapper = trigger.closest("[data-astro-actions]");
        const rowId = wrapper?.getAttribute("data-astro-actions") || "";
        const menu = wrapper?.querySelector<HTMLElement>("[data-astro-action-menu]")
          || document.querySelector<HTMLElement>(`[data-astro-action-menu][data-menu-for="${rowId}"]`);
        if (!menu) return;

        const isHidden = menu.classList.contains("hidden");
        allMenus.forEach((m) => m.classList.add("hidden"));

        if (isHidden) {
          menu.setAttribute("data-menu-for", rowId);
          if (menu.parentElement !== document.body) {
            document.body.appendChild(menu);
          }
          const rect = trigger.getBoundingClientRect();
          menu.style.position = "fixed";
          menu.style.zIndex = "99999";
          menu.style.top = `${rect.bottom + 4}px`;
          menu.style.right = `${window.innerWidth - rect.right}px`;
          menu.style.left = "auto";
          menu.classList.remove("hidden");
        }
      } else {
        allMenus.forEach((m) => m.classList.add("hidden"));
      }
    });

    // Close menus on scroll/resize
    window.addEventListener("scroll", () => {
      document.querySelectorAll<HTMLElement>("[data-astro-action-menu]").forEach((m) => m.classList.add("hidden"));
    }, true);
    window.addEventListener("resize", () => {
      document.querySelectorAll<HTMLElement>("[data-astro-action-menu]").forEach((m) => m.classList.add("hidden"));
    });
  </script>
</CMSDashboardLayout>
