---
import type { BaseBlock } from "../../core/types/blocks"

interface Props {
  block: BaseBlock
  locale?: string
  index?: number
}

const { block, index = 0 } = Astro.props
const { title = "", description = "" } = block.props || {}
---

<div class="cms-step-item relative" data-block-id={block.id}>
  <div class="absolute -left-[35px] top-0 flex size-6 items-center justify-center rounded-full bg-inverted text-xs font-bold ring-4 ring-neutral-50">
    {index + 1}
  </div>
  <div class="space-y-2">
    {title && <h3 class="text-base font-semibold text-neutral-900 mt-0">{title}</h3>}
    {description && <p class="text-sm text-neutral-600 mt-1">{description}</p>}
    <div class="mt-3">
      <slot />
    </div>
  </div>
</div>
