---
import type { BaseBlock, CalloutVariant } from "../../core/types/blocks"

interface Props {
  block: BaseBlock
  locale?: string
}

const { block } = Astro.props
const { variant = "info", to, target } = block.props || {}

const variantConfigs: Record<
  string,
  {
    icon: string
    classes: string
    label: string
  }
> = {
  info: {
    icon: "i-lucide-info",
    classes:
      "bg-info-50/50 border-info-200 text-info-800",
    label: "Info"
  },
  success: {
    icon: "i-lucide-check-circle",
    classes:
      "bg-success-50/50 border-success-200 text-success-800",
    label: "Success"
  },
  warning: {
    icon: "i-lucide-alert-triangle",
    classes:
      "bg-warning-50/50 border-warning-200 text-warning-800",
    label: "Warning"
  },
  error: {
    icon: "i-lucide-alert-octagon",
    classes:
      "bg-error-50/50 border-error-200 text-error-800",
    label: "Error"
  },
  commentary: {
    icon: "i-lucide-message-square",
    classes:
      "bg-ideation-50/50 border-ideation-200 text-ideation-800",
    label: "Commentary"
  },
  ideation: {
    icon: "i-lucide-lightbulb",
    classes:
      "bg-warning-50/50 border-warning-200 text-warning-800",
    label: "Ideation"
  },
  source: {
    icon: "i-lucide-code",
    classes:
      "bg-info-50/50 border-info-200 text-info-800",
    label: "Source"
  }
}

const config = (variantConfigs[variant as CalloutVariant] || variantConfigs["info"])!
const Tag = to ? "a" : "div"
---

<Tag
  href={to}
  target={target}
  class={`cms-callout border rounded-xl p-4 my-4 flex items-start gap-3 text-sm no-underline ${config.classes}`}
  data-block-id={block.id}
>
  <span class={`${config.icon} size-5 shrink-0 mt-0.5`} aria-hidden="true" />
  <div class="flex-1 min-w-0 text-sm">
    <slot />
  </div>
</Tag>
