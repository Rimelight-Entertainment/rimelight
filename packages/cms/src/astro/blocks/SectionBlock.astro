---
import { type BaseBlock, type HeadingLevel, calculateHeadingLevel } from "../../core/types/blocks"

interface Props {
  block: BaseBlock
  locale?: string
  sectionDepth?: number
}

const { block, sectionDepth = 0 } = Astro.props
const { title = "", description = "" } = block.props || {}

function slugify(text: string): string {
  return text
    .toString()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\s+/g, "-")
    .replace(/[^\w-]+/g, "")
    .replace(/-{2,}/g, "-")
    .replace(/^-+/, "")
    .replace(/-+$/, "")
}

const safeLevel = calculateHeadingLevel(sectionDepth)
const headingId = title ? slugify(title) : undefined

const headingClasses: Record<HeadingLevel, string> = {
  2: "text-3xl font-bold text-neutral-900 mt-6 mb-3 border-b border-neutral-200 pb-2",
  3: "text-2xl font-semibold text-neutral-900 mt-5 mb-2.5",
  4: "text-xl font-medium text-neutral-900 mt-4 mb-2",
  5: "text-lg font-medium text-neutral-800 mt-3 mb-1.5",
  6: "text-base font-normal text-neutral-700 mt-2 mb-1"
}

const Tag = `h${safeLevel}` as any
---

<section id={headingId} class="cms-section my-6 scroll-mt-20" data-block-id={block.id}>
  {title && <Tag class={headingClasses[safeLevel] || headingClasses[2]}>{title}</Tag>}
  {description && <p class="text-sm text-neutral-500 mt-1 mb-4 italic">{description}</p>}
  <div class="mt-4">
    <slot />
  </div>
</section>
