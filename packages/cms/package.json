{
  "name": "@rimelight/cms",
  "version": "0.0.33",
  "private": false,
  "description": "Rimelight Entertainment's Content Management System Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "imports": {
    "#rimelight/cms/*": {
      "types": "./node_modules/.rimelight/cms/*.d.ts",
      "default": "./node_modules/.rimelight/cms/*.js"
    },
    "#rimelight/auth/*": {
      "types": "./node_modules/.rimelight/auth/*.d.ts",
      "default": "./node_modules/.rimelight/auth/*.js"
    },
    "#rimelight/*/client": {
      "types": "./node_modules/.rimelight/*/client.d.ts",
      "default": "./node_modules/.rimelight/*/client.js"
    },
    "#rimelight/*/server": {
      "types": "./node_modules/.rimelight/*/server.d.ts",
      "default": "./node_modules/.rimelight/*/server.js"
    },
    "#rimelight/*": {
      "types": "./node_modules/.rimelight/*/config.d.ts",
      "default": "./node_modules/.rimelight/*/config.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.mts",
      "import": "./dist/schema/index.mjs",
      "default": "./dist/schema/index.mjs"
    },
    "./schema/sqlite": {
      "types": "./dist/schema/sqlite.d.mts",
      "import": "./dist/schema/sqlite.mjs",
      "default": "./dist/schema/sqlite.mjs"
    },
    "./schema/*": "./src/schema/*",
    "./storage": {
      "types": "./dist/storage/index.d.mts",
      "import": "./dist/storage/index.mjs",
      "default": "./dist/storage/index.mjs"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "import": "./src/mcp/index.ts",
      "default": "./src/mcp/index.ts"
    },
    "./core/*": "./src/core/*",
    "./solid/*": "./src/solid/*",
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs",
      "default": "./dist/plugin.mjs"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.mts",
      "import": "./dist/middleware/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs"
    },
    "./client/styles/*": "./src/client/styles/*",
    "./client/components": "./src/client/components/index.ts",
    "./client/components/*.tsx": "./src/client/components/*.tsx",
    "./client/components/*.ts": "./src/client/components/*.ts",
    "./client/components/*": "./src/client/components/*.tsx",
    "./client/loader": "./src/client/loader.ts",
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs"
    },
    "./server/*": "./src/server/*",
    "./cron/scheduled": {
      "types": "./src/cron/scheduled.ts",
      "import": "./src/cron/scheduled.ts"
    },
    "./cron/*": "./src/cron/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check --fix",
    "test": "vp test",
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "dependencies": {
    "@rimelight/auth": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "@solidjs/web": "2.0.0-rc.13",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.13",
    "solid-js": "2.0.0-rc.13",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@types/sortablejs": "1.15.9",
    "unocss": "66.10.5"
  },
  "peerDependencies": {
    "solid-js": ">=2.0.0-rc.11",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.10.1"
}
