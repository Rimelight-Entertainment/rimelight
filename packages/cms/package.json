  },
  "dependencies": {
    "@rimelight/i18n": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "drizzle-orm": "0.45.2",
    "sortablejs": "1.15.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.1.2",
    "@types/sortablejs": "1.15.9",
    "astro": "7.2.0",
    "better-auth": "1.6.26",
    "typescript": "6.0.3",
    "unocss": "66.7.5",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "astro": ">=7.0.0",
    "better-auth": ">=1.0.0"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "packageManager": "pnpm@11.20.0"
