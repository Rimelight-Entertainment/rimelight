{
  "name": "@rimelight/cms",
  "version": "0.0.37",
  "private": false,
  "description": "Rimelight Entertainment's Content Management System Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "bin": {
    "rimelight-cms": "./dist/migrator/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts"
    },
    "./schema/sqlite": {
      "types": "./src/schema/sqlite.ts",
      "import": "./src/schema/sqlite.ts"
    },
    "./services": {
      "types": "./src/services/index.ts",
      "import": "./src/services/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./middleware": {
      "types": "./src/middleware/index.ts",
      "import": "./src/middleware/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "import": "./src/plugin.ts"
    },
    "./migrator": {
      "types": "./src/migrator/index.ts",
      "import": "./src/migrator/index.ts"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "import": "./src/storage/index.ts"
    },
    "./mcp": {
      "types": "./src/mcp/index.ts",
      "import": "./src/mcp/index.ts"
    },
    "./cron": {
      "types": "./src/cron/scheduled.ts",
      "import": "./src/cron/scheduled.ts"
    },
    "./cron/scheduled": {
      "types": "./src/cron/scheduled.ts",
      "import": "./src/cron/scheduled.ts"
    },
    "./docs": {
      "types": "./src/docs/index.ts",
      "import": "./src/docs/index.ts"
    },
    "./solid": {
      "types": "./src/solid/index.ts",
      "import": "./src/solid/index.ts"
    },
    "./dashboard": {
      "types": "./src/dashboard/index.ts",
      "import": "./src/dashboard/index.ts"
    },
    "./virtual": {
      "types": "./src/client.d.ts"
    },
    "./client/types": {
      "types": "./src/client.d.ts"
    },
    "./dashboard/route": {
      "types": "./src/dashboard/route.tsx",
      "import": "./src/dashboard/route.tsx"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check --fix",
    "test": "vp test",
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@rimelight/auth": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "@solidjs/web": "2.0.0-rc.15",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "5.0.0-rc.1",
    "solid-js": "2.0.0-rc.15",
    "sortablejs": "1.15.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*",
    "@solidjs/router": "2.0.0-next.40",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@types/sortablejs": "1.15.9",
    "unocss": "66.11.0"
  },
  "peerDependencies": {
    "@solidjs/router": ">=2.0.0-next.40",
    "solid-js": ">=2.0.0-rc.15",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.14.0"
}
