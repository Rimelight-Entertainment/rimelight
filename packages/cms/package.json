{
  "name": "@rimelight/cms",
  "version": "0.0.54",
  "private": false,
  "description": "Rimelight Entertainment's Content Management System Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "bin": {
    "rimelight-cms": "./dist/migrator/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.mts",
      "import": "./dist/schema/index.mjs"
    },
    "./schema/sqlite": {
      "types": "./dist/schema/sqlite.d.mts",
      "import": "./dist/schema/sqlite.mjs"
    },
    "./services": {
      "types": "./dist/services/index.d.mts",
      "import": "./dist/services/index.mjs"
    },
    "./server": {
      "types": "./dist/server/index.d.mts",
      "import": "./dist/server/index.mjs"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.mts",
      "import": "./dist/middleware/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.mts",
      "import": "./dist/plugin.mjs"
    },
    "./migrator": {
      "types": "./dist/migrator/index.d.mts",
      "import": "./dist/migrator/index.mjs"
    },
    "./cron": {
      "types": "./dist/cron/scheduled.d.mts",
      "import": "./dist/cron/scheduled.mjs"
    },
    "./cron/scheduled": {
      "types": "./dist/cron/scheduled.d.mts",
      "import": "./dist/cron/scheduled.mjs"
    },
    "./docs": {
      "types": "./dist/docs/index.d.mts",
      "import": "./dist/docs/index.mjs"
    },
    "./solid": {
      "types": "./src/solid/index.tsx",
      "import": "./src/solid/index.tsx"
    },
    "./blocks": {
      "types": "./src/blocks.ts",
      "import": "./src/blocks.ts"
    },
    "./virtual": {
      "types": "./src/client.d.ts"
    },
    "./client/types": {
      "types": "./src/client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check --fix",
    "test": "vp test",
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@solidjs/web": "2.0.3",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "5.0.0-rc.1",
    "postgres": "4.1.1",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@rimelight/config": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "@solidjs/vite-plugin": "3.0.1",
    "happy-dom": "21.0.4",
    "unocss": "66.13.0"
  },
  "peerDependencies": {
    "@rimelight/i18n": "^0.1.20",
    "@rimelight/ui": "^0.0.96 || ^0.0.97",
    "solid-js": ">=2.0.0-rc.18",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.21.0"
}
