{
  "name": "@rimelight/config",
  "version": "0.0.35",
  "private": false,
  "description": "Rimelight Entertainment's Shared Configuration Package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist",
    "tsconfig"
  ],
  "imports": {
    "#rimelight/config/*": {
      "types": "./node_modules/.rimelight/config/*.d.ts",
      "default": "./node_modules/.rimelight/config/*.js"
    },
    "#rimelight/*/client": {
      "types": "./node_modules/.rimelight/*/client.d.ts",
      "default": "./node_modules/.rimelight/*/client.js"
    },
    "#rimelight/*/server": {
      "types": "./node_modules/.rimelight/*/server.d.ts",
      "default": "./node_modules/.rimelight/*/server.js"
    },
    "#rimelight/*": {
      "types": "./node_modules/.rimelight/*/config.d.ts",
      "default": "./node_modules/.rimelight/*/config.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./generator": {
      "types": "./dist/generator.d.mts",
      "import": "./dist/generator.mjs"
    },
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/solid": "./tsconfig/solid.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check --fix",
    "test": "vp test",
    "build": "vp pack",
    "prepack": "vp pack"
  },
  "peerDependencies": {
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.10.1"
}
