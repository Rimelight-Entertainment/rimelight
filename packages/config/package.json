{
  "name": "@rimelight/config",
  "version": "0.0.31",
  "private": false,
  "description": "Rimelight Entertainment's shared configuration package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "tsconfig",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/solid": "./tsconfig/solid.json",
    "./vite-plus/base": {
      "types": "./dist/base.d.mts",
      "default": "./dist/base.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm run build",
    "check": "vp check --fix",
    "test": "vp test"
  },
  "peerDependencies": {
    "vite-plus": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.6.0"
  },
  "packageManager": "pnpm@12.6.0"
}
