{
  "name": "@rimelight/config",
  "version": "0.0.35",
  "private": false,
  "description": "Rimelight Entertainment's shared configuration package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "dist",
    "tsconfig"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./generator": {
      "types": "./dist/generator.d.mts",
      "import": "./dist/generator.mjs"
    },
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/solid": "./tsconfig/solid.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack",
    "check": "vp check --fix",
    "test": "vp test"
  },
  "peerDependencies": {
    "vite-plus": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.10.1"
}
