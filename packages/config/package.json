{
  "name": "@rimelight/config",
  "version": "0.0.31",
  "private": false,
  "description": "Rimelight Entertainment's shared configuration package",
  "homepage": "https://rimelight.com/docs",
  "bugs": {
    "url": "https://github.com/Rimelight-Entertainment/rimelight/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Rimelight Entertainment"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rimelight-Entertainment/rimelight.git"
  },
  "files": [
    "tsconfig",
    "vite-plus",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/solid": "./tsconfig/solid.json",
    "./vite-plus/base": {
      "types": "./vite-plus/base.ts",
      "default": "./vite-plus/base.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.mts",
      "import": "./dist/drizzle/index.mjs",
      "default": "./dist/drizzle/index.mjs"
    },
    "./solid": {
      "types": "./dist/solid/index.d.mts",
      "import": "./dist/solid/index.mjs",
      "default": "./dist/solid/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "pnpm run build",
    "check": "vp check --fix",
    "test": "vp test"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  },
  "peerDependencies": {
    "@rimelight/auth": "workspace:*",
    "@rimelight/cms": "workspace:*",
    "@rimelight/i18n": "workspace:*",
    "@rimelight/security": "workspace:*",
    "@rimelight/seo": "workspace:*",
    "@rimelight/ui": "workspace:*",
    "drizzle-kit": ">=0.30.0"
  },
  "peerDependenciesMeta": {
    "@rimelight/auth": {
      "optional": true
    },
    "@rimelight/cms": {
      "optional": true
    },
    "@rimelight/i18n": {
      "optional": true
    },
    "@rimelight/security": {
      "optional": true
    },
    "@rimelight/seo": {
      "optional": true
    },
    "@rimelight/ui": {
      "optional": true
    },
    "drizzle-kit": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.6.0"
  },
  "packageManager": "pnpm@12.6.0"
}
